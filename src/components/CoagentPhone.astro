---
// An animated WhatsApp phone that plays real CoAgent exchanges, one scene at a
// time. Every exchange is taken from what /coagent/ says CoAgent does today.
// Without JavaScript, or with reduced motion, the first scene shows complete.
//
// CoAgent replies in English, Spanish, German, French, Portuguese, Bulgarian and
// Greek. Swedish and Russian are not among them, so those pages show the English
// conversation with the phone's own labels and the scene tabs translated, rather
// than a Swedish or Russian chat CoAgent would not actually produce.
interface Props {
	lang?: 'en' | 'es' | 'de' | 'fr' | 'sv' | 'ru';
}
const { lang = 'en' } = Astro.props;

type Row = [string, string];
type Msg = {
	me?: boolean;
	voice?: string;
	sign?: boolean;
	text?: string;
	card?: { title: string; rows: Row[]; foot?: string };
	time: string;
};
type Scene = { label: string; msgs: Msg[] };

const UI: Record<string, { typing: string; online: string; today: string; message: string; aria: string }> = {
	en: { typing: 'typing...', online: 'online', today: 'Today', message: 'Message', aria: 'Example conversations with CoAgent' },
	es: { typing: 'escribiendo...', online: 'en línea', today: 'Hoy', message: 'Mensaje', aria: 'Conversaciones de ejemplo con CoAgent' },
	de: { typing: 'schreibt...', online: 'online', today: 'Heute', message: 'Nachricht', aria: 'Beispielgespräche mit CoAgent' },
	fr: { typing: "en train d'écrire...", online: 'en ligne', today: "Aujourd'hui", message: 'Message', aria: 'Exemples de conversations avec CoAgent' },
	sv: { typing: 'skriver...', online: 'online', today: 'Idag', message: 'Meddelande', aria: 'Exempel på samtal med CoAgent' },
	ru: { typing: 'печатает...', online: 'в сети', today: 'Сегодня', message: 'Сообщение', aria: 'Примеры разговоров с CoAgent' },
};
const ui = UI[lang] || UI.en;

// The approval word CoAgent is confirmed to use: SÍ in Spanish, YES everywhere else.
