const TAB_LABELS: Record<string, string[]> = {
	sv: ['Efter visningen', 'Vid en säljskylt', 'I bilen', 'En annan byrås objekt'],
	ru: ['После показа', 'Табличка «Продаётся»', 'В машине', 'Объект другого агентства'],
};

const base = SCENES[lang] || SCENES.en;
const scenes: Scene[] = TAB_LABELS[lang] ? base.map((s, i) => ({ ...s, label: TAB_LABELS[lang][i] })) : base;

const bars = [6, 11, 16, 9, 14, 19, 12, 7, 15, 18, 10, 6, 13, 17, 9, 12, 16, 8, 11, 7, 14, 10];
---

<div class="cph" data-cph data-typing={ui.typing} data-online={ui.online} aria-label={ui.aria}>
	<div class="cphTabs" role="tablist">
		{scenes.map((s, i) => (
			<button type="button" class={i === 0 ? 'cphTab on' : 'cphTab'} data-cph-tab={i} data-track="coagent-phone-tab" data-track-label={String(i + 1)} role="tab" id={`cph-${lang}-tab-${i}`} aria-controls={`cph-${lang}-scene-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>
				{s.label}
			</button>
		))}
	</div>

	<div class="cphGlow" aria-hidden="true"></div>
	<div class="cphPhone">
		<div class="cphScreen">
			<div class="cphTop" aria-hidden="true">
				<span class="cphBack">&#8249;</span>
				<span class="cphAv">PL</span>
				<span class="cphWho">
					<b>PropertyList CoAgent</b>
					<i data-cph-status>{ui.online}</i>
				</span>
			</div>

			<div class="cphChat">
				<div class="cphDay">{ui.today}</div>
				{scenes.map((s, si) => (
					<div class="cphScene" data-cph-scene={si} hidden={si !== 0} role="tabpanel" id={`cph-${lang}-scene-${si}`} aria-labelledby={`cph-${lang}-tab-${si}`}>
						{s.msgs.map((m) => (
							<div class={`cphMsg ${m.me ? 'me' : 'bot'} on`}>
								<div class={`cphBub${m.sign ? ' photo' : ''}${m.card ? ' wide' : ''}`}>
									{m.voice && (
										<span class="cphVoice">
											<span class="cphPlay">
												<svg viewBox="0 0 12 12" width="11" height="11"><path d="M3 1.5v9l7.5-4.5z" fill="currentColor" /></svg>
											</span>
											<span class="cphWave">
												<span class="cphBars">{bars.map((h) => <i style={`height:${h}px`}></i>)}</span>
												<span class="cphBars top">{bars.map((h) => <i style={`height:${h}px`}></i>)}</span>
											</span>
											<span class="cphDur">{m.voice}</span>
										</span>
									)}
									{m.sign && (
										<span class="cphSign">
											<span class="cphBoard">
												<b>SE VENDE</b>
												<em>6XX XXX XXX</em>
											</span>
										</span>
									)}
									{m.card && (
										<span class="cphCard">
											<b class="cphCardT">{m.card.title}</b>
											{m.card.rows.map(([k, v]) => (
												<span class="cphRow">
													<span>{k}</span>
													<span set:html={v} />
												</span>
											))}
											{m.card.foot && <span class="cphFoot">{m.card.foot}</span>}
										</span>
									)}
									{m.text && <span class="cphText" set:html={m.text} />}
									<span class="cphTime">
										{m.time}
										{m.me && <span class="cphTicks">&#10003;&#10003;</span>}
									</span>
								</div>
							</div>
						))}
					</div>
				))}
				<div class="cphMsg bot cphTyping" aria-hidden="true">
					<div class="cphBub"><span class="cphDots"><i></i><i></i><i></i></span></div>
				</div>
			</div>

			<div class="cphBar" aria-hidden="true">
				<span class="cphInput">{ui.message}</span>
				<span class="cphMic">
					<svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-3.1A7 7 0 0 0 19 11z" /></svg>
				</span>
			</div>
		</div>
	</div>
</div>

<script>
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-cph]').forEach((root) => {
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cph-tab]'));
		const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-cph-scene]'));
		const typing = root.querySelector<HTMLElement>('.cphTyping');
		const status = root.querySelector<HTMLElement>('[data-cph-status]');
		const online = root.dataset.online || 'online';
		const typingLabel = root.dataset.typing || 'typing...';
		let visible = false;
		let started = false;
		let run = 0;

		const select = (i: number) => {
			tabs.forEach((t, j) => {
				t.classList.toggle('on', i === j);
				t.setAttribute('aria-selected', i === j ? 'true' : 'false');
			});
			scenes.forEach((s, j) => (s.hidden = i !== j));
		};

		if (reduce) {
			tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
			return;
		}

		// Waits only count down while the phone is on screen and the tab is visible,
		// so a visitor who scrolls back up finds the conversation where they left it.
		const wait = (ms: number, id: number) =>
			new Promise<boolean>((resolve) => {
				let left = ms;
				const tick = () => {
					if (id !== run) return resolve(false);
					if (visible && !document.hidden) left -= 100;
					if (left <= 0) resolve(true);
					else setTimeout(tick, 100);
				};
				setTimeout(tick, 100);
			});

		const play = async (i: number) => {
			const id = ++run;
			select(i);
			const msgs = Array.from(scenes[i].querySelectorAll<HTMLElement>('.cphMsg'));
			msgs.forEach((m) => m.classList.remove('on', 'playing'));
			if (!(await wait(150, id))) return;

			for (const m of msgs) {
				const bot = m.classList.contains('bot');
				if (bot && typing) {
					typing.classList.add('on');
					if (status) status.textContent = typingLabel;
					if (!(await wait(m.querySelector('.cphCard') ? 1100 : 800, id))) return;
					typing.classList.remove('on');
					if (status) status.textContent = online;
				}
				m.classList.add('on');
				if (m.querySelector('.cphVoice')) m.classList.add('playing');
				const hold = m.querySelector('.cphVoice') ? 1900 : m.querySelector('.cphCard') ? 2400 : bot ? 1700 : 700;
				if (!(await wait(hold, id))) return;
			}
			if (!(await wait(3600, id))) return;
			play((i + 1) % scenes.length);
		};

		tabs.forEach((t, i) =>
			t.addEventListener('click', () => {
				if (typing) typing.classList.remove('on');
				if (status) status.textContent = online;
				play(i);
			}),
		);

		// Start from an empty chat, so the conversation builds as the phone scrolls in
		// instead of showing the finished thread and then wiping it.
		scenes[0]?.querySelectorAll<HTMLElement>('.cphMsg').forEach((m) => m.classList.remove('on'));

		// Begin as soon as half the phone is on screen; keep counting down while any of it is.
		const phone = root.querySelector<HTMLElement>('.cphPhone') || root;
		const io = new IntersectionObserver(
			(entries) => {
				const e = entries[entries.length - 1];
				visible = e.isIntersecting;
				if (!started && e.intersectionRatio >= 0.5) {
					started = true;
					play(0);
				}
			},
			{ threshold: [0, 0.25, 0.5, 0.75, 1] },
		);
		io.observe(phone);
	});
</script>

<style>
	.cph { position: relative; width: 100%; max-width: 360px; margin: 0 auto; }
	.cphTabs { position: relative; z-index: 2; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 0 0 16px; }
	.cphTab { font: inherit; font-size: 12px; font-weight: 800; color: #0a6d61; background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(0, 174, 154, 0.3); border-radius: 999px; padding: 6px 11px; cursor: pointer; transition: background 0.2s, color 0.2s; }
