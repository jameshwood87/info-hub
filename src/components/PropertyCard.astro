---
/**
 * PropertyCard — shows a property listing card linking to propertylist.es
 * 
 * Usage:
 * <PropertyCard
 *   title="3-bed villa in Marbella"
 *   price="€485,000"
 *   location="Marbella, Málaga"
 *   beds={3}
 *   baths={2}
 *   area="145 m²"
 *   image="/blog/hero-marbella-property.png"
 *   url="https://propertylist.es/properties/123"
 * />
 */

interface Props {
  title: string;
  price: string;
  location: string;
  beds?: number;
  baths?: number;
  area?: string;
  image?: string;
  url: string;
}

const { title, price, location, beds, baths, area, image, url } = Astro.props;
---

<article class="propertyCard">
  <a class="propertyCard__link" href={url} target="_blank" rel="noopener">
    {image && (
      <div class="propertyCard__image">
        <img
          src={image}
          alt={title}
          width="600"
          height="400"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
    <div class="propertyCard__body">
      <p class="propertyCard__price">{price}</p>
      <h3 class="propertyCard__title">{title}</h3>
      <p class="propertyCard__location">📍 {location}</p>
      {(beds || baths || area) && (
        <div class="propertyCard__specs">
          {beds !== undefined && <span class="propertyCard__spec">🛏 {beds} bed{beds !== 1 ? 's' : ''}</span>}
          {baths !== undefined && <span class="propertyCard__spec">🚿 {baths} bath{baths !== 1 ? 's' : ''}</span>}
          {area && <span class="propertyCard__spec">📐 {area}</span>}
        </div>
      )}
      <span class="propertyCard__cta">View on PropertyList →</span>
    </div>
  </a>
</article>

<style>
  .propertyCard {
    border: 1px solid rgba(16, 24, 40, 0.1);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .propertyCard:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(16, 24, 40, 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .propertyCard { transition: none; }
    .propertyCard:hover { transform: none; }
  }

  .propertyCard__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .propertyCard__link:focus-visible {
    outline: 3px solid rgba(var(--accent-rgb, 0 174 154), 0.35);
    outline-offset: 2px;
  }

  .propertyCard__image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .propertyCard__body {
    padding: 14px 16px 16px;
    display: grid;
    gap: 6px;
  }

  .propertyCard__price {
    margin: 0;
    font-size: 20px;
    font-weight: 900;
    color: var(--accent, #00ae9a);
  }

  .propertyCard__title {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.3;
    color: rgba(16, 24, 40, 0.92);
  }

  .propertyCard__location {
    margin: 0;
    font-size: 13px;
    color: rgba(16, 24, 40, 0.65);
    font-weight: 600;
  }

  .propertyCard__specs {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .propertyCard__spec {
    font-size: 13px;
    color: rgba(16, 24, 40, 0.75);
    font-weight: 700;
  }

  .propertyCard__cta {
    display: inline-block;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 900;
    color: var(--accent, #00ae9a);
  }
</style>
