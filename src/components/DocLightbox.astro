---
/**
 * Click-to-enlarge for images inside a rendered doc body.
 *
 * Doc bodies arrive from Directus through set:html, so the images cannot be
 * given handlers at build time. This wires a single delegated listener on
 * .docContent instead and opens a full-size overlay. Manual pages carry
 * screenshots of the MLS at 1279px wide, which are unreadable at column width.
 */
interface Props {
	lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const t = lang === 'es'
	? { open: 'Ampliar imagen', close: 'Cerrar', prev: 'Imagen anterior', next: 'Imagen siguiente', label: 'Imagen ampliada' }
	: { open: 'Enlarge image', close: 'Close', prev: 'Previous image', next: 'Next image', label: 'Enlarged image' };
---

<div class="docLb" id="docLb" hidden role="dialog" aria-modal="true" aria-label={t.label}>
	<button class="docLbClose" type="button" aria-label={t.close}>&#215;</button>
	<button class="docLbNav docLbPrev" type="button" aria-label={t.prev}>&#8249;</button>
	<button class="docLbNav docLbNext" type="button" aria-label={t.next}>&#8250;</button>
	<figure class="docLbFig">
		<img class="docLbImg" src="" alt="" />
		<figcaption class="docLbCap"></figcaption>
	</figure>
</div>

<style is:global>
	.docContent img[data-lb] { cursor: zoom-in; }
	.docContent img[data-lb]:focus-visible { outline: 2px solid #00ae9a; outline-offset: 3px; }

	.docLb { position: fixed; inset: 0; z-index: 1000000001;  /* above the Tidio chat widget, which sits at 999999999 */ display: flex; align-items: center; justify-content: center; padding: 32px 16px; background: rgba(9, 18, 26, 0.88); }
	.docLb[hidden] { display: none; }
	.docLbFig { margin: 0; max-width: 100%; max-height: 100%; display: flex; flex-direction: column; align-items: center; gap: 10px; }
	.docLbImg { max-width: 100%; max-height: calc(100vh - 118px); width: auto; height: auto; border-radius: 8px; background: #fff; box-shadow: 0 18px 60px rgba(0, 0, 0, 0.45); }
	.docLbCap { max-width: 900px; margin: 0; font-size: 14px; line-height: 1.5; color: rgba(255, 255, 255, 0.82); text-align: center; }
	.docLbCap:empty { display: none; }

	.docLbClose { position: absolute; top: 14px; right: 16px; width: 42px; height: 42px; font-size: 27px; line-height: 1; color: #fff; background: rgba(255, 255, 255, 0.14); border: 0; border-radius: 50%; cursor: pointer; }
	.docLbNav { position: absolute; top: 50%; transform: translateY(-50%); width: 46px; height: 46px; font-size: 30px; line-height: 1; color: #fff; background: rgba(255, 255, 255, 0.14); border: 0; border-radius: 50%; cursor: pointer; }
	.docLbPrev { left: 14px; }
	.docLbNext { right: 14px; }
	.docLbClose:hover, .docLbNav:hover { background: rgba(255, 255, 255, 0.28); }
	.docLbClose:focus-visible, .docLbNav:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
	.docLb.isSingle .docLbNav { display: none; }

	body.docLbOpen { overflow: hidden; }

	@media (max-width: 640px) {
		.docLb { padding: 16px 8px; }
		.docLbNav { width: 38px; height: 38px; font-size: 24px; }
		.docLbPrev { left: 4px; }
		.docLbNext { right: 4px; }
	}
</style>

<script is:inline define:vars={{ openLabel: t.open }}>
	(() => {
		const content = document.querySelector('.docContent');
		const box = document.getElementById('docLb');
		if (!content || !box) return;

		const img = box.querySelector('.docLbImg');
		const cap = box.querySelector('.docLbCap');
		const btnClose = box.querySelector('.docLbClose');
		const btnPrev = box.querySelector('.docLbPrev');
		const btnNext = box.querySelector('.docLbNext');

		// Only enlarge content images. Icons, spacers and anything already
		// wrapped in a link keep their existing behaviour.
		const eligible = (el) => {
			if (el.closest('a[href]')) return false;
			const w = el.naturalWidth || parseInt(el.getAttribute('width') || '0', 10) || el.clientWidth;
			return w >= 320 || Boolean(el.closest('figure'));
		};

		let shots = [];
		const collect = () => {
			shots = Array.from(content.querySelectorAll('img')).filter(eligible);
			shots.forEach((el) => {
				if (el.dataset.lb) return;
				el.dataset.lb = '1';
				el.setAttribute('role', 'button');
				el.setAttribute('tabindex', '0');
				if (!el.getAttribute('title')) el.setAttribute('title', openLabel);
			});
		};
		collect();
		// Some images report naturalWidth only once decoded.
		window.addEventListener('load', collect, { once: true });
		if (!shots.length) return;

		let at = 0;
		let opener = null;

		const captionOf = (el) => {
			const fc = el.closest('figure')?.querySelector('figcaption');
			return (fc?.textContent || el.getAttribute('alt') || '').trim();
		};

		const show = (i) => {
			at = (i + shots.length) % shots.length;
			const el = shots[at];
			img.src = el.currentSrc || el.src;
			img.alt = el.getAttribute('alt') || '';
			cap.textContent = captionOf(el);
			box.classList.toggle('isSingle', shots.length < 2);
		};

		const open = (el) => {
			const i = shots.indexOf(el);
			if (i < 0) return;
			opener = el;
			show(i);
			box.hidden = false;
			document.body.classList.add('docLbOpen');
			btnClose.focus();
		};

		const close = () => {
			box.hidden = true;
			document.body.classList.remove('docLbOpen');
			img.src = '';
			if (opener) { opener.focus(); opener = null; }
		};

		content.addEventListener('click', (e) => {
			const el = e.target.closest('img[data-lb]');
			if (el) { e.preventDefault(); open(el); }
		});
		content.addEventListener('keydown', (e) => {
			if (e.key !== 'Enter' && e.key !== ' ') return;
			const el = e.target.closest('img[data-lb]');
			if (el) { e.preventDefault(); open(el); }
		});

		btnClose.addEventListener('click', close);
		btnPrev.addEventListener('click', () => show(at - 1));
		btnNext.addEventListener('click', () => show(at + 1));
		box.addEventListener('click', (e) => { if (e.target === box || e.target.classList.contains('docLbFig')) close(); });

		document.addEventListener('keydown', (e) => {
			if (box.hidden) return;
			if (e.key === 'Escape') { e.preventDefault(); close(); }
			else if (e.key === 'ArrowLeft' && shots.length > 1) show(at - 1);
			else if (e.key === 'ArrowRight' && shots.length > 1) show(at + 1);
			else if (e.key === 'Tab') {
				// Keep focus inside the overlay while it is open.
				const stops = [btnClose, btnPrev, btnNext].filter((b) => b.offsetParent !== null);
				const i = stops.indexOf(document.activeElement);
				e.preventDefault();
				stops[(i + (e.shiftKey ? -1 : 1) + stops.length) % stops.length].focus();
			}
		});
	})();
</script>
