---
// The language control for pages that offer more than the EN/ES pair.
//
// Six pills in a row do not fit a phone header, so this is a flag plus a
// dropdown instead. It is a <details> element, which means it opens and closes
// with no JavaScript, works with a keyboard, and cannot break if a script fails
// to load. The same component serves the desktop header and the mobile menu.
//
// Flags are inline SVG rather than emoji on purpose: Windows has no flag glyphs,
// so emoji flags render as two grey letters there, and a large share of this
// site's readers are on Windows.
type L = { code: string; href: string };
interface Props {
	lang: string;
	langs: L[];
	variant?: 'desktop' | 'mobile';
}
const { lang, langs, variant = 'desktop' } = Astro.props;

const NATIVE: Record<string, string> = {
	en: 'English',
	es: 'Español',
	de: 'Deutsch',
	fr: 'Français',
	sv: 'Svenska',
	ru: 'Русский',
};

// 60x40 viewBox throughout so every flag is exactly the same size.
const FLAG: Record<string, string> = {
	en:
		'<rect width="60" height="40" fill="#012169"/>' +
		'<path d="M0 0 60 40M60 0 0 40" stroke="#fff" stroke-width="9"/>' +
		'<path d="M0 0 60 40M60 0 0 40" stroke="#C8102E" stroke-width="5"/>' +
		'<path d="M30 0V40M0 20H60" stroke="#fff" stroke-width="14"/>' +
		'<path d="M30 0V40M0 20H60" stroke="#C8102E" stroke-width="8"/>',
	es:
		'<rect width="60" height="40" fill="#c60b1e"/><rect y="10" width="60" height="20" fill="#ffc400"/>',
	de:
		'<rect width="60" height="40" fill="#000"/><rect y="13.33" width="60" height="13.34" fill="#dd0000"/>' +
		'<rect y="26.67" width="60" height="13.33" fill="#ffce00"/>',
	fr:
		'<rect width="60" height="40" fill="#fff"/><rect width="20" height="40" fill="#002395"/>' +
		'<rect x="40" width="20" height="40" fill="#ed2939"/>',
	sv:
		'<rect width="60" height="40" fill="#006aa7"/><rect y="16" width="60" height="8" fill="#fecc00"/>' +
		'<rect x="17" width="8" height="40" fill="#fecc00"/>',
	ru:
		'<rect width="60" height="40" fill="#fff"/><rect y="13.33" width="60" height="13.34" fill="#0039a6"/>' +
		'<rect y="26.67" width="60" height="13.33" fill="#d52b1e"/>',
};

const flag = (c: string) =>
	`<svg class="lpFlag" viewBox="0 0 60 40" width="21" height="14" aria-hidden="true" preserveAspectRatio="xMidYMid slice">${FLAG[c] || ''}</svg>`;

const label = lang === 'es' ? 'Idioma' : lang === 'de' ? 'Sprache' : lang === 'fr' ? 'Langue' : lang === 'sv' ? 'Språk' : lang === 'ru' ? 'Язык' : 'Language';
const current = langs.find((l) => l.code === lang) || langs[0];
---

<details class:list={['langPick', variant === 'mobile' ? 'isMobile' : null]}>
	<summary aria-label={label} title={label}>
		<Fragment set:html={flag(current.code)} />
		<span class="lpCode">{current.code.toUpperCase()}</span>
		<svg class="lpChev" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
	</summary>
	<ul class="lpMenu">
		{langs.map((l) => (
			<li>
				<a href={l.href} hreflang={l.code} lang={l.code} class:list={['lpItem', l.code === lang ? 'isActive' : null]} aria-current={l.code === lang ? 'true' : undefined}>
					<Fragment set:html={flag(l.code)} />
					<span>{NATIVE[l.code] || l.code.toUpperCase()}</span>
				</a>
			</li>
		))}
	</ul>
</details>

<style is:global>
	.langPick { position: relative; }
	.langPick > summary {
		display: inline-flex; align-items: center; gap: 7px;
		padding: 6px 9px; border: 1px solid #e5ecec; border-radius: 999px;
		cursor: pointer; list-style: none; font-size: 13px; font-weight: 700;
		color: #0d2b2e; background: #fff; line-height: 1; user-select: none;
	}
	.langPick > summary::-webkit-details-marker { display: none; }
	.langPick > summary:hover { border-color: #00ae9a; color: #00ae9a; }
	.langPick[open] > summary { border-color: #00ae9a; }
	.lpFlag { border-radius: 2px; display: block; flex: none; box-shadow: 0 0 0 1px rgba(13, 43, 46, 0.12); }
	.lpChev { opacity: 0.55; transition: transform 0.15s; }
	.langPick[open] .lpChev { transform: rotate(180deg); }
	.lpMenu {
		position: absolute; right: 0; top: calc(100% + 8px); z-index: 200;
		margin: 0; padding: 6px; list-style: none; min-width: 178px;
		background: #fff; border: 1px solid #e5ecec; border-radius: 14px;
		box-shadow: 0 18px 40px rgba(13, 43, 46, 0.16);
	}
	.lpItem {
		display: flex; align-items: center; gap: 10px;
		padding: 9px 11px; border-radius: 9px; font-size: 14px;
		color: #0d2b2e; text-decoration: none; font-weight: 600; white-space: nowrap;
	}
	.lpItem:hover { background: #f2f8f7; color: #00ae9a; text-decoration: none; }
	.lpItem.isActive { background: #e5f5f3; color: #00ae9a; }
	/* In the mobile menu the dropdown opens downward in normal flow, because a
	   floating panel inside an already-scrolling drawer is a trap on a phone. */
	.langPick.isMobile { width: 100%; }
	.langPick.isMobile > summary { width: 100%; justify-content: flex-start; border-radius: 12px; padding: 11px 13px; }
	.langPick.isMobile .lpMenu { position: static; margin-top: 8px; min-width: 0; box-shadow: none; }
</style>
