---
// WhatsApp groups landing page, EN and ES from one component. The finder is server-rendered for every area
// and the small script at the bottom only switches what is visible, so the page still works without it.
// Every figure comes from src/data (socialProof.ts, whatsappGroups.ts, reviews.json, spainMap.ts); nothing
// is typed in by hand here. The docs page (kb 1609 / 1612) stays the reference list with the full rules.
import { AREAS, INFO_GROUP, INVITE, KIND_LABEL, fmtNum, type Lang } from '../data/whatsappGroups';
import { SOCIAL_PROOF } from '../data/socialProof';
import reviewsData from '../data/reviews.json';
import { SPAIN_MAP, projectSpain, projectInset } from '../data/spainMap';
import { COAGENT_NUMBER, coagentWaLink, CRM_STAFF_URL } from '../data/coagent';

export interface Props {
	lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const origin = 'https://info.propertylist.es';
const pageUrl = `${origin}${es ? '/es/grupos-whatsapp/' : '/whatsapp-groups/'}`;
const signup = `https://agents.propertylist.es/new_agency/new?locale=${lang}`;
const docsPath = SOCIAL_PROOF.whatsapp.docsPath[lang];
const termsPath = es ? '/es/docs/propertylist-mls-manual-de-usuario/legal/terms-conditions/' : '/docs/propertylist-mls-user-manual/legal/terms-conditions/';
const reviewsPath = es ? '/es/opiniones/' : '/reviews/';
const coagentPath = es ? '/es/coagent/' : '/coagent/';
const num = (n: number) => fmtNum(n, lang);

const members = SOCIAL_PROOF.whatsapp.members;
const groupCount = AREAS.reduce((n, a) => n + a.groups.length, 0) + 1; // plus the info group
const areaCount = AREAS.filter((a) => a.id !== 'specialist').length;
const fb = SOCIAL_PROOF.facebookGroups.groups;
const fbTotal = Math.floor(fb.reduce((n, g) => n + g.members, 0) / 100) * 100;

type Review = { platform: string; author: string; agency?: string; rating: number; lang: string; text: string; hold?: boolean };
const waReviews = (reviewsData.reviews as Review[]).filter((r) => /whatsapp/i.test(r.text) && !r.hold);

const T = {
	en: {
		eyebrow: 'Free WhatsApp groups for estate agents in Spain',
		h1: 'Pick your area. Join the agents already there.',
		sub: `Free WhatsApp groups where ${num(members)}+ estate agents in Spain share listings and client requests, by area and by type. One tap joins a whole community.`,
		where: 'Where do you work?',
		allAreas: 'All areas',
		members: 'members',
		groupsWord: 'groups',
		areasWord: 'areas',
		freeWith: 'Free with a PropertyList account',
		mapAria: 'Map of Spain with the PropertyList WhatsApp communities',
		mapNote: 'Tap a dot on the map, or pick an area above.',
		costa: 'Costa del Sol',
		insetLabel: { estepona: ['Estepona', 'Sotogrande'], marbella: ['Marbella'], malaga: ['Málaga'] } as Record<string, string[]>,
		allTitle: 'Every community and group, by area',
		nGroups: (n: number) => `${n} ${n === 1 ? 'group' : 'groups'}`,
		nGroupsOneLink: (n: number) => `${n} groups, one link`,
		seeGroups: 'See the groups',
		joinCommunity: 'Join the community',
		join: 'Join',
		waitlist: 'Waiting list',
		full: 'Full',
		showOnly: 'Show only',
		all: 'All',
		ofGroups: (n: number) => `{n} of ${n} groups`,
		fullNote: 'Full groups: the link puts you on the waiting list. Priority goes to agencies that add their properties to the network: connect your XML feed, or send the feed link to',
		fullNoteEnd: 'on WhatsApp.',
		stepsTitle: 'How it works',
		steps: [
			{ h: 'Create your free PropertyList account', p: 'The groups are for registered agents. No card, about two minutes.' },
			{ h: 'Join your area', p: 'The community link puts you in every group in it at once. Or pick single groups from the list.' },
			{ h: 'Share your listings', p: 'The PropertyList link for your listing, or your own post for it. Up to five properties a day, the same property once a week.' },
		],
		rulesTitle: 'The rules, in short',
		rules: ['Your own listings, or your clients\' requests in the requests groups.', 'Up to five properties a day, the same property once a week.', 'No spam, no promotions, nothing unrelated to property.', 'No direct messages to other members unless they have asked you to.'],
		rulesLink: 'Full rules and every group, on the docs page',
		terms: 'By joining a group you accept the WhatsApp group policy, section 5.6 of our',
		termsLink: 'Terms and Conditions',
		coEyebrow: 'CoAgent · your CRM on WhatsApp',
		coH2: 'Already on WhatsApp all day? So is your CRM.',
		coP: 'CoAgent is the PropertyList CRM assistant inside WhatsApp. Talk to it like a colleague: it shows you what it heard, and nothing is saved until you reply YES. Nothing to install, and your voice is never kept.',
		coExamples: [
			{ q: '“Is PL99999 still available?”', a: 'Handy after a group post. If the listing is another agency\'s, CoAgent asks them for you through the MLS when you reply YES, and their answer comes back to you.' },
			{ q: '“What have we got in Marbella, three beds, up to two million?”', a: 'Listings from the shared MLS with prices and links.' },
			{ q: '“Add a note to Marta: she wants to see it again Saturday”', a: 'It reads the note back in your own words and saves it to her file when you reply YES.' },
			{ q: '“Let\'s list a property”', a: 'Send the photos, then the price, where it is and the bedrooms, typed or as a voice note. No commands to learn.' },
		],
		coAria: 'Examples of what you can ask CoAgent',
		coBtn: 'Message CoAgent on WhatsApp',
		coMore: 'How CoAgent works',
		coPrice: 'Every agent gets 20 free messages a month, every month; replying YES never counts. Unlimited is 50 credits a month per agent.',
		coSetup: 'Your mobile number needs to be on your CRM profile, so CoAgent knows you are an agent and not a client.',
		reviewsTitle: 'What agents say about the groups',
		reviewsNote: 'Shown as written. No wording has been changed.',
		reviewsAll: 'All reviews',
		platform: { google: 'Google review', trustpilot: 'Trustpilot review', facebook: 'Facebook recommendation' } as Record<string, string>,
		fbTitle: 'Also on Facebook',
		fbSub: `${fb.length} groups, ${num(fbTotal)}+ members`,
		open: 'Open',
		membersShort: 'members',
		shareTitle: 'Know an agent who should be in these groups?',
		shareSub: 'Send them this page. It opens WhatsApp with the link ready to go.',
		shareBtn: 'Share on WhatsApp',
		copyBtn: 'Copy the link',
		copied: 'Link copied',
		shareText: `PropertyList WhatsApp groups for estate agents in Spain. Pick your area and join in one tap: ${pageUrl}`,
		qrAlt: 'QR code for this page',
		qrCaption: 'Print the QR code for the office wall.',
		ctaTitle: 'Not on PropertyList yet?',
		ctaSub: 'You need a free PropertyList account to join the groups.',
		cta: 'Create your free account',
		ctaMicro: 'No card. About two minutes.',
	},
	es: {
		eyebrow: 'Grupos de WhatsApp gratis para agentes inmobiliarios en España',
		h1: 'Elige tu zona. Únete a los agentes que ya están dentro.',
		sub: `Grupos de WhatsApp gratis donde más de ${num(members)} agentes inmobiliarios en España comparten inmuebles y demandas de clientes, por zona y por tipo. Con un toque entras en toda una comunidad.`,
		where: '¿Dónde trabajas?',
		allAreas: 'Todas las zonas',
		members: 'miembros',
		groupsWord: 'grupos',
		areasWord: 'zonas',
		freeWith: 'Gratis con una cuenta de PropertyList',
		mapAria: 'Mapa de España con las comunidades de WhatsApp de PropertyList',
		mapNote: 'Toca un punto del mapa o elige tu zona arriba.',
		costa: 'Costa del Sol',
		insetLabel: { estepona: ['Estepona', 'y Sotogrande'], marbella: ['Marbella'], malaga: ['Málaga'] } as Record<string, string[]>,
		allTitle: 'Todas las comunidades y grupos, por zona',
		nGroups: (n: number) => `${n} ${n === 1 ? 'grupo' : 'grupos'}`,
		nGroupsOneLink: (n: number) => `${n} grupos, un solo enlace`,
		seeGroups: 'Ver los grupos',
		joinCommunity: 'Unirme a la comunidad',
		join: 'Unirme',
		waitlist: 'Lista de espera',
		full: 'Lleno',
		showOnly: 'Mostrar solo',
		all: 'Todos',
		ofGroups: (n: number) => `{n} de ${n} grupos`,
		fullNote: 'Grupos llenos: el enlace te apunta a la lista de espera. La prioridad es para las agencias que añaden sus inmuebles a la red: conecta tu feed XML o envía el enlace del feed a',
		fullNoteEnd: 'por WhatsApp.',
		stepsTitle: 'Cómo funciona',
		steps: [
			{ h: 'Crea tu cuenta gratis en PropertyList', p: 'Los grupos son para agentes registrados. Sin tarjeta, unos dos minutos.' },
			{ h: 'Únete a tu zona', p: 'El enlace de la comunidad te mete en todos sus grupos de una vez. O elige grupos sueltos de la lista.' },
			{ h: 'Comparte tus inmuebles', p: 'El enlace de PropertyList de tu inmueble, o tu propia publicación. Hasta cinco inmuebles al día, el mismo inmueble una vez por semana.' },
		],
		rulesTitle: 'Las normas, en corto',
		rules: ['Tus propios inmuebles, o las demandas de tus clientes en los grupos de demandas.', 'Hasta cinco inmuebles al día, el mismo inmueble una vez por semana.', 'Sin spam ni promociones, nada ajeno al sector inmobiliario.', 'Sin mensajes directos a otros miembros salvo que te lo hayan pedido.'],
		rulesLink: 'Todas las normas y todos los grupos, en la documentación',
		terms: 'Al unirte a un grupo aceptas la política de grupos de WhatsApp, apartado 5.6 de nuestros',
		termsLink: 'Términos y Condiciones',
		coEyebrow: 'CoAgent · tu CRM en WhatsApp',
		coH2: '¿Todo el día en WhatsApp? Tu CRM también.',
		coP: 'CoAgent es el asistente del CRM de PropertyList dentro de WhatsApp. Háblale como a un compañero: te enseña lo que ha entendido y no se guarda nada hasta que respondes SÍ. Nada que instalar, y tu voz nunca se guarda.',
		coExamples: [
			{ q: '“¿PL99999 sigue disponible?”', a: 'Útil después de una publicación en un grupo. Si el inmueble es de otra agencia, CoAgent les pregunta por ti a través del MLS cuando respondes SÍ, y su respuesta te llega a ti.' },
			{ q: '“¿Qué tenemos en Marbella, tres dormitorios, hasta dos millones?”', a: 'Inmuebles del MLS compartido con precios y enlaces.' },
			{ q: '“Añade una nota a Marta: quiere verla otra vez el sábado”', a: 'Te lee la nota con tus palabras y la guarda en su ficha cuando respondes SÍ.' },
			{ q: '“Vamos a publicar un inmueble”', a: 'Envía las fotos y luego el precio, dónde está y los dormitorios, escrito o en nota de voz. Sin comandos que aprender.' },
		],
		coAria: 'Ejemplos de lo que puedes pedirle a CoAgent',
		coBtn: 'Escribe a CoAgent por WhatsApp',
		coMore: 'Cómo funciona CoAgent',
		coPrice: 'Cada agente tiene 20 mensajes gratis al mes, todos los meses; responder SÍ nunca cuenta. El ilimitado son 50 créditos al mes por agente.',
		coSetup: 'Tu móvil tiene que estar en tu perfil del CRM para que CoAgent sepa que eres agente y no cliente.',
		reviewsTitle: 'Lo que dicen los agentes de los grupos',
		reviewsNote: 'Tal como se escribieron, en inglés. No se ha cambiado ninguna palabra.',
		reviewsAll: 'Todas las opiniones',
		platform: { google: 'Reseña en Google', trustpilot: 'Reseña en Trustpilot', facebook: 'Recomendación en Facebook' } as Record<string, string>,
		fbTitle: 'También en Facebook',
		fbSub: `${fb.length} grupos, más de ${num(fbTotal)} miembros`,
		open: 'Abrir',
		membersShort: 'miembros',
		shareTitle: '¿Conoces a un agente que debería estar en estos grupos?',
		shareSub: 'Envíale esta página. Se abre WhatsApp con el enlace listo.',
		shareBtn: 'Compartir por WhatsApp',
		copyBtn: 'Copiar el enlace',
		copied: 'Enlace copiado',
		shareText: `Grupos de WhatsApp de PropertyList para agentes inmobiliarios en España. Elige tu zona y únete con un toque: ${pageUrl}`,
		qrAlt: 'Código QR de esta página',
		qrCaption: 'Imprime el código QR para la pared de la oficina.',
		ctaTitle: '¿Aún no estás en PropertyList?',
		ctaSub: 'Necesitas una cuenta gratis de PropertyList para entrar en los grupos.',
		cta: 'Crea tu cuenta gratis',
		ctaMicro: 'Sin tarjeta. Unos dos minutos.',
	},
}[lang];

// map geometry: the shared projection from spainMap.ts, an inset circle in the sea south-east of Murcia
const VIEW = '0 0 500 428';
const IX = 395;
const IY = 345;
const R = SPAIN_MAP.inset.r;
const costa = projectSpain(-4.885, 36.51);
const mainDots = AREAS.filter((a) => a.map?.layer === 'main').map((a) => ({ a, p: projectSpain(a.map!.lon, a.map!.lat) }));
const insetDots = AREAS.filter((a) => a.map?.layer === 'inset').map((a) => ({ a, p: projectInset(a.map!.lon, a.map!.lat) }));
const mainLabel: Record<string, { dx: number; dy: number; anchor: string }> = {
	madrid: { dx: 11, dy: 4, anchor: 'start' },
	barcelona: { dx: 11, dy: -5, anchor: 'start' },
	mallorca: { dx: 0, dy: 21, anchor: 'middle' },
	ibiza: { dx: -11, dy: 4, anchor: 'end' },
};
const insetLabel: Record<string, { dx: number; dy: number; anchor: string }> = {
	estepona: { dx: 2, dy: 26, anchor: 'middle' },
	marbella: { dx: 9, dy: 4, anchor: 'start' },
	malaga: { dx: -9, dy: -3, anchor: 'end' },
};
const shareHref = `https://wa.me/?text=${encodeURIComponent(T.shareText)}`;
const subtitle = (a: (typeof AREAS)[number]) => (a.groups.length && a.community ? T.nGroupsOneLink(a.groups.length) : a.groups.length ? T.nGroups(a.groups.length) : a.community?.desc[lang] || '');
---

<div class="wg" data-wg>
	<section class="wgHero">
		<div class="wgHeroInner">
			<div class="wgCopy">
				<div class="wgEyebrow">{T.eyebrow}</div>
				<h1>{T.h1}</h1>
				<p class="wgSub">{T.sub}</p>
				<div class="wgPick" role="group" aria-label={T.where}>
					<span class="wgPickLabel">{T.where}</span>
					<div class="wgChips">
						<button type="button" class="wgChip on" data-area="all" aria-pressed="true" data-track="wa-landing-area" data-track-label="all">{T.allAreas}</button>
						{AREAS.map((a) => (
							<button type="button" class="wgChip" data-area={a.id} aria-pressed="false" data-track="wa-landing-area" data-track-label={a.id}>{a.short[lang]}</button>
						))}
					</div>
				</div>
				<ul class="wgProof" aria-label={es ? 'Cifras' : 'Figures'}>
					<li><strong>{num(members)}+</strong> {T.members}</li>
					<li><strong>{groupCount}</strong> {T.groupsWord}</li>
					<li><strong>{areaCount}</strong> {T.areasWord}</li>
					<li>{T.freeWith}</li>
				</ul>
			</div>
			<div class="wgMapWrap">
				<svg class="wgMap" viewBox={VIEW} role="img" aria-label={T.mapAria}>
					<path class="land" d={SPAIN_MAP.main} />
					<line class="leader" x1={costa[0] + 10} y1={costa[1] + 1} x2={IX - R} y2={IY} />
					<a href="#marbella" class="wgDot costaDot" data-area="marbella" data-track="wa-landing-map" data-track-label="costa" aria-label={T.costa}>
						<circle class="hit" cx={costa[0]} cy={costa[1]} r="16" />
						<circle class="halo" cx={costa[0]} cy={costa[1]} r="9" />
						<circle class="pt" cx={costa[0]} cy={costa[1]} r="4.2" />
						<text x={costa[0] - 14} y={costa[1] + 4.5} text-anchor="end">{T.costa}</text>
					</a>
					{mainDots.map(({ a, p }, i) => (
						<a href={`#${a.id}`} class="wgDot" data-area={a.id} data-track="wa-landing-map" data-track-label={a.id} aria-label={a.short[lang]} style={`--i:${i}`}>
							<circle class="hit" cx={p[0]} cy={p[1]} r="16" />
							<circle class="ring" cx={p[0]} cy={p[1]} r="6" />
							<circle class="pt" cx={p[0]} cy={p[1]} r="5" />
							<text x={p[0] + mainLabel[a.id].dx} y={p[1] + mainLabel[a.id].dy} text-anchor={mainLabel[a.id].anchor}>{a.short[lang]}</text>
						</a>
					))}
					<g class="inset" transform={`translate(${IX} ${IY})`}>
						<clipPath id={`wgClip-${lang}`}><circle r={R} /></clipPath>
						<circle class="sea" r={R} />
						<path class="land" d={SPAIN_MAP.inset.d} clip-path={`url(#wgClip-${lang})`} />
						<circle class="rim" r={R} />
						{insetDots.map(({ a, p }, i) => (
							<a href={`#${a.id}`} class="wgDot" data-area={a.id} data-track="wa-landing-map" data-track-label={a.name[lang]} aria-label={a.name[lang]} style={`--i:${i + 4}`}>
								<circle class="hit" cx={p[0]} cy={p[1]} r="14" />
								<circle class="ring" cx={p[0]} cy={p[1]} r="6" />
								<circle class="pt" cx={p[0]} cy={p[1]} r="5" />
								<text class="small" x={p[0] + insetLabel[a.id].dx} y={p[1] + insetLabel[a.id].dy} text-anchor={insetLabel[a.id].anchor}>
									{T.insetLabel[a.id].map((line, li) => (
										<tspan x={p[0] + insetLabel[a.id].dx} dy={li === 0 ? 0 : 12}>{line}</tspan>
									))}
								</text>
							</a>
						))}
					</g>
				</svg>
				<p class="wgMapNote">{T.mapNote}</p>
			</div>
		</div>
	</section>

	<section class="wgFinder" id="groups">
		<div class="wgInfo">
			<span class="wgText"><span class="wgName">{INFO_GROUP.name[lang]}</span><span class="wgDesc">{INFO_GROUP.desc[lang]}</span></span>
			<a class="wgJoin" href={INVITE(INFO_GROUP.code)} target="_blank" rel="noopener" data-track="wa-landing-join" data-track-label={INFO_GROUP.code}>{T.join} &rarr;</a>
		</div>

		<div class="wgAll on" data-area-card="all">
			<h2>{T.allTitle}</h2>
			<div class="wgTiles">
				{AREAS.map((a) => (
					<article class="wgTile">
						<h3>{a.name[lang]}</h3>
						<p>{subtitle(a)}</p>
						<div class="wgTileActs">
							{a.community ? (
								<a class="wgBtn" href={INVITE(a.community.code)} target="_blank" rel="noopener" data-track="wa-landing-community" data-track-label={a.id}>{T.joinCommunity} &rarr;</a>
							) : null}
							{a.groups.length ? (
								<button type="button" class="wgLinkBtn" data-area={a.id} data-track="wa-landing-area" data-track-label={a.id}>{T.seeGroups} &rarr;</button>
							) : null}
						</div>
					</article>
				))}
			</div>
		</div>

		{AREAS.map((a) => (
			<article class="wgArea" data-area-card={a.id} id={`area-${a.id}`}>
				<header class="wgAreaHead">
					<div>
						<button type="button" class="wgBack" data-area="all" data-track="wa-landing-area" data-track-label="all">&larr; {T.allAreas}</button>
						<h2>{a.name[lang]}</h2>
						<p>{subtitle(a)}</p>
					</div>
					{a.community ? (
						<a class="wgBtn" href={INVITE(a.community.code)} target="_blank" rel="noopener" data-track="wa-landing-community" data-track-label={a.id}>{T.joinCommunity} &rarr;</a>
					) : null}
				</header>
				{a.groups.length > 1 ? (
					<div class="wgKinds" role="group" aria-label={T.showOnly}>
						<span class="wgKindsLabel">{T.showOnly}</span>
						<button type="button" class="wgKind on" data-kind-pick="all" aria-pressed="true">{T.all}</button>
						{a.groups.map((g) => (
							<button type="button" class="wgKind" data-kind-pick={g.kind} aria-pressed="false">{KIND_LABEL[g.kind][lang]}</button>
						))}
						<span class="wgCount" data-count data-all={T.nGroups(a.groups.length)} data-of={T.ofGroups(a.groups.length)}>{T.nGroups(a.groups.length)}</span>
					</div>
				) : null}
				{a.groups.length ? (
					<ul class="wgList">
						{a.groups.map((g) => (
							<li data-kind={g.kind} class:list={[{ isFull: !!g.full }]}>
								<span class="wgText"><span class="wgName">{g.name[lang]}</span><span class="wgDesc">{g.desc[lang]}</span></span>
								<span class="wgAct">
									{g.full ? <span class="wgTag">{T.full}</span> : null}
									<a class:list={['wgJoin', { wgWait: !!g.full }]} href={INVITE(g.code)} target="_blank" rel="noopener" data-track="wa-landing-join" data-track-label={g.code}>{g.full ? T.waitlist : T.join} &rarr;</a>
								</span>
							</li>
						))}
					</ul>
				) : null}
				{a.groups.some((g) => g.full) ? (
					<p class="wgFullNote">{T.fullNote} <a href={coagentPath}>CoAgent</a> {T.fullNoteEnd}</p>
				) : null}
			</article>
		))}
	</section>

	<section class="wgSteps">
		<h2>{T.stepsTitle}</h2>
		<ol>
			{T.steps.map((s, i) => (
				<li>
					<span class="wgNum">{i + 1}</span>
					<div>
						<h3>{i === 0 ? <a href={signup} target="_blank" rel="noopener">{s.h}</a> : s.h}</h3>
						<p>{s.p}</p>
					</div>
				</li>
			))}
		</ol>
		<div class="wgRules">
			<h3>{T.rulesTitle}</h3>
			<ul>{T.rules.map((r) => <li>{r}</li>)}</ul>
			<p class="wgRulesLinks">
				<a href={docsPath}>{T.rulesLink} &rarr;</a>
			</p>
			<p class="wgTerms">{T.terms} <a href={termsPath}>{T.termsLink}</a>.</p>
		</div>
	</section>

	<section class="wgCo">
		<div class="wgCoInner">
			<div class="wgCoCopy">
				<div class="wgEyebrow">{T.coEyebrow}</div>
				<h2>{T.coH2}</h2>
				<p class="wgCoP">{T.coP}</p>
				<div class="wgCoActs">
					<a class="wgBtn" href={coagentWaLink(es ? 'Hola' : 'Hi')} target="_blank" rel="noopener" data-track="wa-landing-coagent" data-track-label="message">{T.coBtn} &rarr;</a>
					<a class="wgCoMore" href={coagentPath} data-track="wa-landing-coagent" data-track-label="page">{T.coMore} &rarr;</a>
				</div>
				<p class="wgCoMeta"><strong>WhatsApp: {COAGENT_NUMBER}</strong></p>
				<p class="wgCoMeta">{T.coPrice}</p>
				<p class="wgCoMeta">{T.coSetup} <a href={CRM_STAFF_URL} target="_blank" rel="noopener">{es ? 'Añádelo en el CRM' : 'Add it in the CRM'} &rarr;</a></p>
			</div>
