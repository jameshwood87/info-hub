<script>
	const root = document.querySelector('[data-wg]');
	if (root) {
		root.classList.add('js');
		const cards = Array.from(root.querySelectorAll('[data-area-card]'));
		const ids = cards.map((c) => c.getAttribute('data-area-card'));
		const controls = Array.from(root.querySelectorAll('[data-area]'));
		const finder = root.querySelector('#groups');
		const select = (wanted, scroll) => {
			const id = ids.includes(wanted) ? wanted : 'all';
			cards.forEach((c) => c.classList.toggle('on', c.getAttribute('data-area-card') === id));
			controls.forEach((b) => {
				const on = b.getAttribute('data-area') === id;
				b.classList.toggle('on', on);
				if (b.tagName === 'BUTTON') b.setAttribute('aria-pressed', String(on));
			});
			const h = id === 'all' ? '' : '#' + id;
			if (location.hash !== h) history.replaceState(null, '', location.pathname + location.search + h);
			if (scroll && finder) {
				const r = finder.getBoundingClientRect();
				if (r.top < 0 || r.top > window.innerHeight * 0.6) finder.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		};
		controls.forEach((b) =>
			b.addEventListener('click', (ev) => {
				ev.preventDefault();
				select(b.getAttribute('data-area') || 'all', true);
			})
		);
		window.addEventListener('hashchange', () => select(location.hash.slice(1) || 'all', true));
		select(location.hash.slice(1) || 'all', false);
		if (location.hash && finder) setTimeout(() => finder.scrollIntoView({ block: 'start' }), 60);

		// "Show only" chips inside an area card
		cards.forEach((card) => {
			const picks = Array.from(card.querySelectorAll('[data-kind-pick]'));
			const rows = Array.from(card.querySelectorAll('li[data-kind]'));
			const count = card.querySelector('[data-count]');
			picks.forEach((k) =>
				k.addEventListener('click', () => {
					const v = k.getAttribute('data-kind-pick');
					picks.forEach((x) => {
						const on = x === k;
						x.classList.toggle('on', on);
						x.setAttribute('aria-pressed', String(on));
					});
					let shown = 0;
					rows.forEach((r) => {
						const show = v === 'all' || r.getAttribute('data-kind') === v;
						r.hidden = !show;
						if (show) shown++;
					});
					if (count) count.textContent = v === 'all' ? count.getAttribute('data-all') || '' : (count.getAttribute('data-of') || '').replace('{n}', String(shown));
				})
			);
		});

		// copy the page link
		const copy = root.querySelector('[data-copy]');
		if (copy) {
			copy.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(copy.getAttribute('data-copy') || location.href);
					copy.textContent = copy.getAttribute('data-done') || '';
					setTimeout(() => {
						copy.textContent = copy.getAttribute('data-label') || '';
					}, 1800);
				} catch (e) {
					/* clipboard blocked: the share button still works */
				}
			});
		}
	}
</script>

