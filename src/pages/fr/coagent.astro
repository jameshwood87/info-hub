---
import Layout from '../../layouts/Layout.astro';
import CoagentPhone from '../../components/CoagentPhone.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
import { COAGENT_NUMBER, coagentWaLink, CRM_STAFF_URL } from '../../data/coagent';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/fr/coagent/`;
const title = 'PropertyList CoAgent - votre CRM sur WhatsApp | PropertyList';
const description =
	'CoAgent, votre CRM sur WhatsApp : une note vocale après la visite, et la mise à jour vous attend pour validation. Votre voix n’est jamais conservée, rien sans votre YES.';

const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'fr');
const plAgencies = statPlus(__ps.agencies, 'fr');
const plListings = statPlus(__ps.listings, 'fr');

const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=fr';
const WA = coagentWaLink();
// A reminder for 9am Madrid time (07:00 UTC) on launch day, until the number exists.
const CAL = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent('Écrire à PropertyList CoAgent')}&dates=20260915T070000Z/20260915T071500Z&details=${encodeURIComponent('Le numéro de CoAgent est sur https://info.propertylist.es/fr/coagent/ à partir de 9 h. Avant de lui écrire, inscrivez-vous et ajoutez votre numéro WhatsApp à votre utilisateur. Les 10 premiers agents ont un mois gratuit.')}`;

// Everything CoAgent does today, as the question an agent would actually send.
// Tap a question to see what comes back. Answers are the verified descriptions.
const moments = [
	{
		label: 'En voiture',
		asks: [
			{ q: 'Où est ma prochaine visite ?', a: 'Votre agenda, en commençant par l’adresse et le numéro de téléphone du client, parce que vous le lisez en voiture.' },
			{ q: 'Qu’est-ce que j’ai demain ?', a: 'Toute la journée, dans l’ordre, avec le bien et la personne que vous rencontrez.' },
			{ q: 'Quel est le numéro de Marta Ruiz ?', a: 'Son téléphone et son e-mail en premier, pour que votre doigt soit déjà sur le bouton d’appel.' },
			{ q: 'Faites-moi le point sur les Berg', a: 'Où ils en sont, ce qu’ils recherchent, et la dernière chose qui s’est passée, avant votre appel.' },
		],
	},
	{
		label: 'Avec un client à côté de vous',
		asks: [
			{ q: 'Qu’est-ce qu’on a à Marbella, trois chambres, jusqu’à deux millions ?', a: 'Cinq biens du MLS partagé avec les prix et les liens. Pas besoin de nommer un client, donc ça marche avec quelqu’un assis à côté de vous.' },
			{ q: 'Parlez-moi de PL22234', a: 'Le prix, les chambres, la surface, l’emplacement et le lien de ce bien, qu’il soit à vous ou à une autre agence.' },
			{ q: 'Quel est le meilleur rapport qualité-prix, PL5001, PL5002 ou PL5003 ?', a: 'Il les compare à des biens similaires en vente à proximité, avec le prix au mètre carré, pour que vous puissiez dire à un client lequel est bien placé et lequel demande trop. Posez la question juste après une recherche et il compare ces résultats.' },
			{ photo: true, q: 'Une photo d’une pièce fatiguée : "rénover"', a: 'En pleine visite, envoyez la cuisine telle quelle et récupérez-la rénovée une minute plus tard, pour montrer à votre acheteur ce qu’elle pourrait devenir. Cela coûte le même nombre de crédits que dans le CRM, et seul un rendu réussi est facturé.' },
			{ q: 'Combien d’appartements sont en vente à San Pedro ?', a: 'Le vrai chiffre du marché là-bas, les meilleures correspondances, et un lien vers la liste complète dans votre CRM.' },
			{ q: 'PL22234 est-il toujours disponible ?', a: 'Si le bien appartient à une autre agence, CoAgent propose de leur demander pour vous. Répondez YES et la demande leur parvient via le MLS, et leur réponse vous revient.' },
		],
	},
	{
		label: 'Après la visite',
		asks: [
			{ q: 'Ajoutez une note à Marta : elle veut le revoir samedi', a: 'Il vous relit la note avec vos propres mots et l’enregistre dans sa fiche quand vous répondez YES.' },
			{ q: 'Marta a fait une offre', a: 'CoAgent déplace sa fiche à la bonne étape de votre pipeline quand vous répondez YES, comme si vous la glissiez dans le CRM. Marquer un client comme gagné ou perdu reste dans le CRM, où il vous demande les détails.' },
			{ q: 'Ajoutez Maria Lopez 6XX XXX XXX maria@example.com', a: 'Ou partagez sa carte de contact directement depuis votre téléphone. CoAgent vous relit le nom, le numéro et l’e-mail, et l’ajoute à votre CRM quand vous répondez YES. Si elle y est déjà, il relie sa fiche au lieu d’en créer un doublon.' },
			{ photo: true, q: 'La photo de la carte d’identité d’un client', a: 'Seuls le prénom, les noms de famille et la date de naissance sont lus, et ajoutés comme nouveau contact quand vous répondez YES. Le numéro du document n’est jamais conservé, ni la photo.' },
		],
	},
	{
		label: 'Décrocher le mandat',
		asks: [
			{ q: 'On met un bien en vente', a: 'CoAgent vous dit quoi envoyer : les photos, puis le prix, l’emplacement et les chambres, avec vos propres mots. Aucune commande à apprendre.' },
			{ photo: true, q: 'Des photos d’un nouveau bien', a: 'Envoyez-les directement depuis votre pellicule, puis décrivez le bien à CoAgent, par écrit ou en note vocale. Il demande ce qui manque, comme le prix, vous relit l’annonce, et sur YES rédige le titre, la description et les caractéristiques. Répondez PUBLISH et l’annonce part en validation, comme depuis le CRM. Rien ne passe en ligne sans cela.' },
			{ photo: true, q: 'La photo d’un panneau Se Vende', a: 'CoAgent lit le numéro de téléphone sur le panneau, avec le nom ou le prix s’ils y figurent. Répondez YES et le propriétaire est enregistré comme contact dans votre CRM, avec une note sur le panneau et un rappel pour l’appeler.' },
			{ q: 'Combien vaut Nueva Andalucía ?', a: 'Le prix médian affiché et la fourchette de ce qui est réellement sur le marché là-bas. Si nous n’avons pas assez de biens dans une zone, il vous le dit plutôt que de deviner.' },
			{ q: 'Combien vaut PL22234 ?', a: 'Une valeur basée sur des ventes actées devant notaire dans cette commune, avec une fourchette et un lien vers la preuve publique. Ou décrivez plutôt le bien : "un appartement de 120 m² à Estepona". Il vous dit toujours sur quoi se base le chiffre.' },
			{ q: 'REPORT', a: 'Après une estimation, répondez REPORT pour recevoir le Property Intelligence Report complet, sous forme de lien à envoyer au vendeur. Le premier est gratuit. Ensuite, cela coûte des crédits, et il vous précise combien et demande avant de dépenser quoi que ce soit.' },
			{ q: 'BROCHURE PL22234', a: 'Une brochure du bien à votre propre marque : une page que votre client peut ouvrir, avec le prix du jour et un moyen de vous contacter, plus le PDF. Il vous indique d’abord le prix en crédits, et une brochure déjà créée est renvoyée gratuitement.' },
		],
	},
	{
		label: 'Nouveaux leads',
		asks: [
			{ q: 'Quels sont mes derniers leads ?', a: 'Vos cinq plus récents, avec qui a fait la demande, sur quel bien et quand : les vôtres, ou ceux de toute l’agence si vous êtes administrateur, comme dans le CRM. Répondez REPLY pour répondre au plus récent par e-mail.' },
			{ q: 'REPLY', a: 'CoAgent rédige un e-mail à votre dernier lead dans sa propre langue, à partir de sa demande. Répondez YES et il part en votre nom via le CRM, et sa réponse arrive dans votre boîte mail. Ou répondez simplement à l’alerte de nouveau lead.' },
		],
	},
];

const faqs = [
	{ q: 'Qu’est-ce que je dois installer ?', a: 'Rien. CoAgent fonctionne dans WhatsApp, que vous utilisez déjà toute la journée. Enregistrez le numéro de PropertyList, vérifiez que votre mobile figure sur votre profil CRM pour qu’il sache que vous êtes agent et non client, et envoyez-lui une note vocale.' },
	{ q: 'Va-t-il modifier mon CRM automatiquement ?', a: 'Non. CoAgent propose et attend. Il vous montre le client qu’il a identifié et les changements qu’il veut faire, champ par champ, et rien n’est écrit tant que vous n’avez pas répondu YES. S’il comprend mal, cela vous coûte un mot, pas un budget erroné qui dort dans une fiche partagée.' },
	{ q: 'Mes notes vocales sont-elles enregistrées ?', a: 'Non. L’audio est transcrit puis supprimé. La transcription est conservée sur la fiche du client, où vous pouvez relire exactement ce qui a été dit au CRM.' },
	{ q: 'Fonctionne-t-il en espagnol ?', a: 'Oui, ainsi qu’en allemand, anglais, portugais, bulgare et grec. Il répond dans votre langue et gère une note qui change de langue en cours de route, ce qui sur cette côte concerne la plupart d’entre elles.' },
	{ q: 'Dois-je toujours nommer un client ?', a: 'Non. Nommer un client transforme une note vocale en mises à jour du CRM. Sans cela, vous pouvez toujours demander des biens, votre agenda, une annonce par référence ou la valeur d’une zone, ce qui est utile quand un client de passage est juste à côté de vous.' },
	{ q: 'Peut-il parler à d’autres agences pour moi ?', a: 'Oui. Demandez si un bien d’une autre agence est toujours disponible et CoAgent propose d’envoyer la demande. Répondez YES et elle passe par le MLS, de la même façon qu’une demande envoyée depuis l’écran du CRM, et arrive donc dans leur circuit habituel.' },
	{ q: 'Et si CoAgent ne reconnaît pas mon numéro ?', a: 'Il répond, en espagnol et en anglais, avec un lien pour créer votre compte gratuit et un lien vers la page Staff de votre CRM, où vous ajoutez votre mobile à votre profil. Ajoutez l’indicatif du pays devant si votre numéro n’est pas espagnol, puis écrivez-lui à nouveau.' },
	{ q: 'Qu’est-ce qui coûte des crédits ?', a: 'Les messages sont couverts par votre forfait. Une brochure, le rapport de marché après le premier gratuit, et une pièce rénovée sont payés en crédits PropertyList, au même prix que dans le CRM. CoAgent vous indique toujours le prix et attend votre YES avant de dépenser quoi que ce soit, et une brochure ou un rendu qui échoue n’est jamais facturé.' },
	{ q: 'Combien ça coûte ?', a: 'Les 10 premiers agents qui écrivent à CoAgent reçoivent un mois gratuit et illimité, dès leur premier message. Chaque agent a 5 messages gratuits par jour, et répondre YES ne compte jamais. L’illimité coûte 50 crédits par mois et par agent, payés avec vos crédits PropertyList, et vous pouvez arrêter le renouvellement quand vous voulez. Plus de 3 agents ? Parlez-nous d’un forfait. Le MLS et le cœur du CRM restent gratuits, et créer votre compte ne coûte rien.' },
	{ q: 'Qu’est-ce qui n’est pas encore disponible ?', a: 'Connecter votre propre numéro WhatsApp pour que les conversations avec vos clients se classent toutes seules, une ligne de travail dédiée dans l’application PropertyList, et la fiche du client qui apparaît d’elle-même sur votre écran d’appel. Tout le reste sur cette page fonctionne déjà.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Fonctionnalités', item: `${origin}/features/` },
		{ '@type': 'ListItem', position: 3, name: 'CoAgent', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList CoAgent',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android', url: canonical,
	description: 'Un assistant pour les agents immobiliers qui fonctionne via WhatsApp : les notes vocales deviennent des mises à jour du CRM que l’agent approuve, et les questions sur les clients, les biens, l’agenda et les prix par zone trouvent leur réponse dans le CRM de l’agence et le MLS partagé. L’audio n’est jamais conservé.',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};
---

<Layout
	lang="fr"
	title={title}
	description={description}
	canonical={canonical}
	ogImage="https://info.propertylist.es/og/og-coagent-fr.jpg"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/coagent/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/coagent/' },
		{ hreflang: 'de', href: 'https://info.propertylist.es/de/coagent/' },
		{ hreflang: 'fr', href: 'https://info.propertylist.es/fr/coagent/' },
		{ hreflang: 'sv', href: 'https://info.propertylist.es/sv/coagent/' },
		{ hreflang: 'ru', href: 'https://info.propertylist.es/ru/coagent/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/coagent/' },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="cx heroGrid">
			<div>
				<div class="eyebrow"><span class="dot"></span> CoAgent &middot; votre CRM sur WhatsApp</div>
				<h1>Arrêtez de tout retaper dans le CRM.<br /><span>Parlez-lui.</span></h1>
				<p class="heroLead">
					Envoyez une note vocale après la visite. Répondez YES. <strong>L’administratif est fait, et votre soirée est à vous.</strong>
				</p>
				<div class="ctaRow">
					{WA ? (
						<a class="btnPrimary" href={WA} target="_blank" rel="noopener">Écrivez à CoAgent sur WhatsApp</a>
					) : (
						<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Inscrivez-vous gratuitement</a>
					)}
					<a class="btnGhost" href="#how">Voyez comment ça marche</a>
				</div>
				<p class="micro">5 messages gratuits par jour &middot; Rien à installer &middot; Votre voix n’est jamais conservée</p>
				{WA ? (
					<p class="member">Déjà sur PropertyList ? <a href={CRM_STAFF_URL} target="_blank" rel="noopener">Ajoutez votre numéro WhatsApp à votre utilisateur</a> pour que CoAgent sache que c’est vous.</p>
				) : (
					<p class="member">
						<b>Le numéro est disponible mardi 15 septembre, à partir de 9 h.</b> Avant de lui écrire, assurez-vous d’être
						<a href={SIGNUP} target="_blank" rel="noopener">inscrit</a> et que votre
						<a href={CRM_STAFF_URL} target="_blank" rel="noopener">numéro WhatsApp est ajouté à votre utilisateur</a>.
						<a class="calBtn" href={CAL} target="_blank" rel="noopener" style="display:table;margin-top:10px;padding:8px 14px;border-radius:10px;background:#0b1220;color:#fff;text-decoration:none;font-weight:800">Me le rappeler mardi à 9 h</a>
					</p>
				)}
			</div>
			<CoagentPhone lang="fr" />
		</div>
	</section>

	<div class="strip">
		<div class="cx stripInner">
			<span>Derrière : <b>{plAgencies}</b> agences</span>
			<span><b>{plAgents}</b> agents</span>
			<span><b>{plListings}</b> biens actifs</span>
			<span>Répond en <b>7</b> langues</span>
		</div>
	</div>

	<section class="band dark">
		<div class="cx">
			<div class="head center">
				<h2>Deux façons de finir la soirée.</h2>
				<p>Personne n’oublie exprès. La journée va juste plus vite que l’administratif.</p>
			</div>
			<div class="versus">
				<div class="vCol without">
					<div class="vHead">Sans CoAgent</div>
					<ol>
						<li><b>18:40</b><span>Dernière visite. Trois promesses, toutes dans votre tête.</span></li>
						<li><b>21:30</b><span>Ordinateur portable ouvert, vous retapez la journée de mémoire.</span></li>
						<li><b>Le jeudi</b><span>« Vous m’avez finalement envoyé cette annonce ? »</span></li>
					</ol>
				</div>
				<div class="vCol with">
					<div class="vHead">Avec CoAgent</div>
					<ol>
						<li><b>18:41</b><span>Une note vocale depuis le parking.</span></li>
						<li><b>18:42</b><span>Vous répondez YES. Note, critère et rappel enregistrés.</span></li>
						<li><b>21:30</b><span>Vous n’êtes pas devant l’ordinateur.</span></li>
					</ol>
				</div>
			</div>
			<p class="punch">Votre mémoire est excellente. <span>Jusqu’à jeudi.</span></p>
		</div>
	</section>

	<section class="band soft" id="how">
		<div class="cx">
			<div class="head center">
				<div class="label">Comment ça marche</div>
				<h2>Parlez. Vérifiez. Dites YES.</h2>
			</div>
			<div class="grid3">
				<div class="demo">
					<span class="num">1</span>
					<h3>Parlez</h3>
					<p>Comme vous le feriez avec un collègue.</p>
					<div class="mini">
						<div class="mb me">"Ça a plu à Marta. Elle est ouverte à trois chambres maintenant, jusqu’à huit cent cinquante. Je lui ai dit que je lui envoyais celui de Cerquilla samedi."</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">2</span>
					<h3>Vérifiez</h3>
					<p>Voyez exactement ce qu’il a entendu.</p>
					<div class="mini">
						<div class="mb">
							<b>Marta Ruiz · acheteuse</b>
							<span class="kv"><i>Budget</i><em>800 000 € à 850 000 €</em></span>
							<span class="kv"><i>Chambres</i><em>3</em></span>
							<span class="kv"><i>Rappel</i><em>Cerquilla, samedi</em></span>
						</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">3</span>
					<h3>Dites YES</h3>
					<p>Rien ne change avant ça.</p>
					<div class="mini">
						<div class="mb">Répondez <b>YES</b> pour l’enregistrer.</div>
						<div class="mb me short">YES</div>
						<div class="mb done">Enregistré. Samedi est dans votre agenda.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band" id="ask">
		<div class="cx">
			<div class="head center">
				<div class="label">Ce que vous pouvez demander</div>
				<h2>Demandez-lui comme à un collègue.</h2>
				<p>Touchez un message pour voir ce qu’il répond.</p>
			</div>
			<div class="moments">
				{moments.map((m) => (
					<div class="moment">
						<div class="momentLabel">{m.label}</div>
						<div class="chips">
							{m.asks.map((item) => (
								<details class="chip">
									<summary>
										{item.photo && <span class="tag">Photo</span>}
										{item.photo ? item.q : `"${item.q}"`}
									</summary>
									<p>{item.a}</p>
								</details>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="band soft" id="matching">
		<div class="cx">
			<div class="matchBox">
				<div class="matchCopy">
					<div class="label">Construit sur le MLS partagé</div>
					<h2>Ne vous contentez pas de vous souvenir du client. <span>Trouvez-lui son prochain bien.</span></h2>
					<p>Il cherche dans le stock de {plAgencies} agences, pas seulement le vôtre. Si le bien idéal appartient à une autre agence, il leur demande pour vous.</p>
					<ul class="checks">
						<li>Tout le MLS partagé, pas seulement vos annonces</li>
						<li>Meilleur rapport qualité-prix, classé au prix au m²</li>
						<li>Valeurs issues de ventes actées devant notaire, avec la preuve</li>
					</ul>
				</div>
				<div class="matchVisual" aria-hidden="true">
					<div class="resCard">
						<div class="resHead">
							<span>Du MLS partagé</span>
							<em>3 chambres &middot; Nueva Andalucía &middot; jusqu’à 850 000 €</em>
						</div>
						<div class="res">
							<span class="resPh a"></span>
							<span class="resTxt"><b>PL5001 &middot; Appartement</b><i>3 ch. &middot; Nueva Andalucía</i></span>
							<span class="resP">845 000 €<small class="own">Votre bien</small></span>
						</div>
						<div class="res">
							<span class="resPh b"></span>
							<span class="resTxt"><b>PL5002 &middot; Penthouse</b><i>3 ch. &middot; Nueva Andalucía</i></span>
							<span class="resP">830 000 €<small>Une autre agence</small></span>
						</div>
						<div class="res">
							<span class="resPh c"></span>
							<span class="resTxt"><b>PL5003 &middot; Maison de ville</b><i>3 ch. &middot; Aloha</i></span>
							<span class="resP">799 000 €<small>Une autre agence</small></span>
						</div>
						<div class="resAsk">PL5002 appartient à une autre agence. Répondez <b>YES</b> et je leur demande si elle est toujours disponible.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="cx">
			<div class="head center">
				<div class="label">Trois promesses</div>
				<h2>Ne travaillez pas pour votre CRM. <span>Laissez le CRM travailler pour vous.</span></h2>
			</div>
			<div class="grid3">
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-3.1A7 7 0 0 0 19 11z" /></svg>
					</span>
					<h3>Votre voix n’est jamais conservée</h3>
					<p>Transcrite, puis supprimée. Seul le texte reste, sur la fiche du client.</p>
				</div>
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M9.5 16.2 5.3 12l-1.4 1.4 5.6 5.6L21 7.5l-1.4-1.4z" /></svg>
					</span>
					<h3>Rien n’est enregistré avant YES</h3>
					<p>Ne dites rien et rien ne se passe. Aucune fiche modifiée, aucune demande envoyée.</p>
				</div>
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3z" /></svg>
					</span>
					<h3>Jamais de réponse inventée</h3>
					<p>Tout provient de votre CRM et du MLS partagé. S’il ne sait pas, il le dit.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="band soft" id="pricing">
		<div class="cx">
			<div class="head center">
