---
/* GENERATED FILE - do not edit by hand.
   Source: src/pages/website-builder.astro (English).
   Rebuild: node scripts/gen-wb-langs.mjs --only=fr
   Hand edits are lost on the next run; change the English page instead. */
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'fr');
const plAgencies = statPlus(__ps.agencies, 'fr');
const plListings = statPlus(__ps.listings, 'fr');

const title = 'Website Builder pour les agents immobiliers | PropertyList.es';
const description =
	'Choisissez l\'un des quinze modèles de sites d\'agence prêts, personnalisez-le, et toutes les propriétés du réseau PropertyList y figurent, filtrées comme vous le souhaitez, avec les demandes arrivant dans votre CRM. Création et prévisualisation gratuites, à partir de 50 credits par mois une fois que vous publiez.';
const BUILD = 'https://agents.propertylist.es/website-builder';
const DOCS = 'https://info.propertylist.es/docs/propertylist-mls-user-manual/website-builder/';
const REFERRALS = 'https://agents.propertylist.es/referrals';
const DASHBOARD = 'https://agents.propertylist.es';

// The fifteen templates, as captured from the real files (public/wb). Order is
// the order shown; the style filter hides the rest.
const templates = [
	{ id: '14-solaz', name: 'Solaz', style: 'Vitrine', line: 'S\'ouvre sur un film. Des cyprès et la côte au crépuscule, le titre placé bas sur l\'image.' },
	{ id: '01-marina', name: 'Marina', style: 'Moderne', line: 'Un en-tête bleu sarcelle et blanc, une barre de recherche en direct en haut, et vos dernières annonces dans une grille en dessous.' },
	{ id: '03-onyx', name: 'Onyx', style: 'Luxe', line: 'Une photo nocturne d\'une villa éclairée, un titre en serif en blanc, un seul bouton.' },
	{ id: '13-horizon', name: 'Horizon', style: 'Vitrine', line: 'Écran partagé : un titre en gras d\'un côté, une photo intérieure pleine hauteur de l\'autre.' },
	{ id: '02-blanca', name: 'Blanca', style: 'Minimaliste', line: 'Une photo pleine largeur d\'une villa et de sa piscine, une petite barre de navigation, pas de titre sur l\'image.' },
	{ id: '05-puerto', name: 'Puerto', style: 'Moderne', line: 'Une photo du crépuscule en pleine largeur avec une carte flottante dessus affichant le prix et les détails.' },
	{ id: '07-noir', name: 'Noir', style: 'Luxe', line: 'S\'ouvre sur un film. Un paysage cinématographique sombre avec un grand titre en gras par-dessus, navigation minimale.' },
	{ id: '04-sierra', name: 'Sierra', style: 'Classique', line: 'Fond crème, espace pour votre photographie à côté de votre nom et un paragraphe éditorial.' },
	{ id: '09-continental', name: 'Continental', style: 'Moderne', line: 'Une photo crépusculaire bleu marine, un titre blanc en gras, et une carte de prix superposée sur l\'image.' },
	{ id: '06-atrium', name: 'Atrium', style: 'Minimaliste', line: 'Gris clair et blanc, une couleur d\'accent dans le titre, une barre de recherche et une bande des dernières propriétés.' },
	{ id: '11-imperial', name: 'Imperial', style: 'Luxe', line: 'Fond crème, un titre avec empattement en gras, deux photographies en dessous dans une galerie simple.' },
	{ id: '08-cortijo', name: 'Cortijo', style: 'Classique', line: 'Fond parchemin chaud, un cadre photo en arc à côté de votre nom et une introduction.' },
	{ id: '10-meridian', name: 'Meridian', style: 'Minimaliste', line: 'Fond pâle, un titre italique avec empattement, une barre de recherche simple, rien ne vient détourner l\'attention.' },
	{ id: '12-heritage', name: 'Heritage', style: 'Classique', line: 'Fond blanc, votre nom et un paragraphe d\'introduction, boutons d\'appel à l\'action verts.' },
	{ id: '15-faro', name: 'Faro', style: 'Vitrine', line: 'S\'ouvre sur un film. Une silhouette sombre de montagne et de mer, un grand titre avec empattement, navigation minimale.' },
];
const styles = ['Moderne', 'Minimaliste', 'Luxe', 'Classique', 'Vitrine'];

const addons = [
	{ name: 'Page supplémentaire', what: 'Une page supplémentaire au-delà de l\'ensemble inclus', price: '10 credits par mois' },
	{ name: 'Instant Content', what: 'Guides de quartier et un blog, rédigés pour vous, illimités', price: '30 credits par mois' },
	{ name: 'Votre propre domaine', what: 'Votre domaine au lieu de your-agency.estate-agency.co', price: '20 credits par mois' },
	{ name: 'Retirer la marque PropertyList', what: 'Retire la marque PropertyList de votre site', price: '50 credits par mois' },
	{ name: 'Pop-up de capture de leads', what: 'Un pop-up qui capture des leads sur votre site', price: '8 credits par mois' },
	{ name: 'Réponses IA sur les annonces', what: 'Génère une FAQ à partir des questions réelles des acheteurs', price: '8 credits par mois' },
	{ name: 'SEO et GEO automatiques', what: 'Vérifie votre site chaque semaine et corrige ce qui peut l\'être', price: '5 credits par mois' },
	{ name: 'Rapport mensuel par e-mail', what: 'Un résumé des performances envoyé par e-mail le 1er du mois', price: '5 credits par mois' },
];

const faqs = [
	{ q: 'Est-ce vraiment gratuit de créer votre site ?', a: 'Oui. Créer et prévisualiser votre site ne coûte rien. Vous n\'êtes facturé que lorsque vous le publiez : 50 credits par mois à partir de ce moment, plus tous les modules complémentaires que vous activez.' },
	{ q: 'Que se passe-t-il lorsque vous publiez ?', a: 'Votre site est mis en ligne immédiatement avec toutes les propriétés du réseau que vous avez choisi d\'afficher, ainsi que vos propres annonces. À partir de ce moment, vous êtes facturé 50 credits par mois pour le site, plus tous les modules complémentaires que vous avez activés, facturés chaque mois.' },
	{ q: 'Puis-je changer de modèle plus tard?', a: 'Oui. Passez à un autre des quinze modèles quand vous le souhaitez, et vous conservez vos textes, vos pages et vos réglages.' },
	{ q: 'Dois-je importer mes annonces?', a: 'Non. Chaque bien du réseau est déjà là, filtré comme vous le souhaitez, avec vos propres annonces à côté, et tout se met à jour lorsqu\'une annonce change dans le CRM. Rien n\'est saisi deux fois.' },
	{ q: 'Où arrivent les demandes?', a: 'Directement dans votre PropertyList CRM, et vous recevez un e-mail pour chaque demande. Les pipelines Lead, Seller et Property sont gratuits et sans limite. Déplacer un lead qualifié vers le pipeline Buyer coûte 1 credit.' },
	{ q: 'Puis-je utiliser mon propre domaine?', a: 'Oui, pour 20 credits par mois. Jusqu\'alors votre site est hébergé à your-agency-name.estate-agency.co : votre nom dans l\'adresse, pas le nôtre.' },
	{ q: 'Que se passe-t-il si j\'annule?', a: 'Votre site revient au microsite d\'agence gratuit à la fin de la période de facturation. Vous conservez votre domaine.' },
	{ q: 'Le SEO est-il efficace?', a: 'Bon dès le premier jour : chaque page est livrée avec une structure propre, des titres et des descriptions. Activez Auto SEO et GEO (5 credits par mois) et un agent dédié à votre site travaille dessus chaque semaine : il vérifie chaque page, actualise les mots-clés selon les recherches actuelles des acheteurs, et corrige ce qu\'il trouve. Nous ne promettons toujours pas de positions dans les résultats ; aucune plateforme honnête ne le peut.' },
	{ q: 'Avez-vous besoin d\'être technique ?', a: 'Non. Vous choisissez un modèle, l\'éditez dans un éditeur qui affiche votre site réel pendant que vous travaillez, et vous publiez quand vous êtes prêt. L\'édition via l\'IA vous permet aussi de décrire une modification en anglais simple.' },
	{ q: 'Qui l\'héberge, et est-il sécurisé ?', a: 'Nous le faisons. L\'hébergement et la protection Cloudflare sont inclus : votre site est servi rapidement depuis le réseau Cloudflare et protégé contre les attaques, sans rien à gérer ni à renouveler de votre part.' },
	{ q: 'Les pages légales sont-elles incluses ?', a: 'Oui. Chaque modèle inclut aviso legal, les pages de confidentialité et de cookies, ainsi qu\'une bannière de cookies. Tout cela est inclus et jamais facturé séparément.' },
];

const ldWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'PropertyList Website Builder',
	url: 'https://info.propertylist.es/fr/createur-de-site-immobilier/',
	description,
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es', logo: { '@type': 'ImageObject', url: 'https://info.propertylist.es/og/logo-default.png' } },
};
const ldBreadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://info.propertylist.es/' },
		{ '@type': 'ListItem', position: 2, name: 'Website Builder' },
	],
};
const ldVideo = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: 'PropertyList Website Builder: pick a design, edit it, publish',
	description: 'A 33 second recording of the PropertyList Website Builder with a sample agency: the fifteen designs, one chosen, the headline selected, the hero rearranged, then Review and publish. No sound.',
	thumbnailUrl: ['https://info.propertylist.es/hero/wb-hero-poster.jpg'],
	contentUrl: 'https://info.propertylist.es/hero/wb-hero.mp4',
	uploadDate: '2026-09-05',
	duration: 'PT33S',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es' },
};
const ldFaq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
	lang="fr"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/fr/createur-de-site-immobilier/"
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/website-builder/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/constructor-de-webs/' },
		{ hreflang: 'de', href: 'https://info.propertylist.es/de/website-baukasten/' },
		{ hreflang: 'fr', href: 'https://info.propertylist.es/fr/createur-de-site-immobilier/' },
		{ hreflang: 'sv', href: 'https://info.propertylist.es/sv/webbplatsbyggare/' },
		{ hreflang: 'ru', href: 'https://info.propertylist.es/ru/konstruktor-saytov/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/website-builder/' },
	]}
>
	<script type="application/ld+json" set:html={JSON.stringify(ldWebsite)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldVideo)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />

	<!-- HERO -->
	<header class="wb-hero">
		<div class="wrap">
			<div class="wb-hero-grid">
				<div class="wb-hero-text">
					<div class="wb-hero-eyebrow"><img src="https://info.propertylist.es/og/icon-default.png" alt="" width="18" height="18" /><span>Website Builder &middot; toutes les annonces du réseau &middot; contacts envoyés vers votre CRM</span></div>
					<h1 class="wb-hero-h1">Choisissez un design.<br />Vos annonces <em>le remplissent.</em></h1>
					<p class="wb-hero-sub">Quinze sites d'agence prêts, avec chaque bien du réseau et filtrés selon vos critères. Les demandes arrivent dans votre CRM et vos pipelines, et vos propres annonces sont en ligne le jour où vous publiez.</p>
					<div class="wb-hero-ctas">
						<a class="btn btn-primary btn-large" href={BUILD}>Créez gratuitement</a>
						<a class="btn btn-secondary on-dark" href="#xml">Vous avez déjà un site web</a>
					</div>
					<p class="wb-hero-trust">Gratuit pour créer et prévisualiser. À partir de 50 credits par mois (environ 50 EUR) une fois que vous publiez. Vous pouvez annuler à la fin de n'importe quel mois.</p>
				</div>
				<div class="wb-hero-visual">
					<figure class="film wb-film">
						<div class="wb-frame wb-frame-dark">
							<div class="wb-frame-bar"><span></span><span></span><span></span><i>Website Builder</i></div>
							<video class="filmVid" autoplay muted loop playsinline preload="auto" poster="/hero/wb-hero-poster.jpg" width="1440" height="900" aria-label="Le Website Builder : les quinze modèles, Solaz choisi, l'éditeur avec le titre sélectionné, le hero réorganisé, puis Vérifier et publier">
								<source src="/hero/wb-hero.mp4" type="video/mp4" />
							</video>
						</div>
						<figcaption class="filmCap">Enregistré depuis le nouveau Website Builder : les quinze designs, Solaz choisi, le titre sélectionné, le hero réorganisé, puis Vérifier et publier. 33 secondes. Les modules complémentaires et les totaux affichés sont ceux du site de démonstration et peuvent être modifiés.</figcaption>
					</figure>
				</div>
			</div>
		</div>
	</header>

	<!-- PROOF -->
	<section class="wb-trust">
		<div class="wrap">
			<div class="wb-trust-grid">
				<div><div class="wb-trust-num">{plAgents}</div><div class="wb-trust-label">agents inscrits sur PropertyList</div></div>
				<div><div class="wb-trust-num">{plAgencies}</div><div class="wb-trust-label">agences qui y gèrent leur activité</div></div>
				<div><div class="wb-trust-num">{plListings}</div><div class="wb-trust-label">annonces sur le réseau</div></div>
			</div>
			<p class="wb-trust-line">Votre site utilise le même réseau que votre MLS et CRM. Chaque bien présent sur ce réseau peut figurer sur votre site le jour où vous publiez, filtré comme vous le souhaitez, et il se met à jour dès qu'une annonce change.</p>
		</div>
	</section>

	<!-- THE FIFTEEN -->
	<section class="wb-section wb-fifteen" id="templates">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Les quinze</p>
				<h2 class="wb-section-h2">Quinze designs, <em>une plateforme.</em></h2>
				<p class="wb-lead">Chaque modèle est un site complet d'agence : les mêmes pages, les mêmes blocs dont une agence a besoin, présenté différemment. Choisissez celui qui correspond à votre façon de travailler, pas l'inverse.</p>
			</div>
			<div class="wb-chips" role="tablist" aria-label="Filtrer les modèles par style">
				<button class="wb-chip on" type="button" data-style="all" aria-pressed="true">Les quinze</button>
				{styles.map((s) => <button class="wb-chip" type="button" data-style={s} aria-pressed="false">{s}</button>)}
			</div>
		</div>
		<div class="wb-rail-wrap">
			<button class="wb-rail-btn prev" type="button" aria-label="Modèles précédents">&lsaquo;</button>
			<div class="wb-rail" id="wbRail">
				{templates.map((t, i) => (
					<article class="wb-tpl" data-style={t.style}>
						<div class="wb-tpl-shots">
							<div class="wb-frame">
								<div class="wb-frame-bar"><span></span><span></span><span></span><i>yourbrand.estate-agency.co</i></div>
								<img src={`/wb/${t.id}-desktop.webp`} width="1440" height="900" alt={`${t.name} template, home page on a desktop screen`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							</div>
							<img class="wb-phone" src={`/wb/${t.id}-phone.webp`} width="390" height="844" alt={`${t.name} template on a phone`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
						</div>
						<div class="wb-tpl-meta">
							<span class="wb-tpl-style">{t.style}</span>
							<h3>{t.name}</h3>
							<p>{t.line}</p>
						</div>
					</article>
				))}
			</div>
			<button class="wb-rail-btn next" type="button" aria-label="Modèles suivants">&rsaquo;</button>
		</div>
		<div class="wrap"><p class="wb-fifteen-note">Vous pouvez changer d'avis plus tard : changez de modèle tout en conservant vos textes, vos pages et vos paramètres. Trois des quinze (Solaz, Noir, Faro) s'ouvrent sur un film.</p></div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="wb-section wb-steps">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Comment cela fonctionne</p>
				<h2 class="wb-section-h2">Choisissez. Faites-le vôtre. <em>Publiez.</em></h2>
			</div>
			<div class="wb-steps-grid">
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Choisissez un modèle</i></div><img src="/wb/step-1-pick.webp" width="1440" height="900" alt="Le sélecteur de modèles avec Solaz sélectionné et son aperçu à côté" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">1</div>
					<h3>Sélectionnez un modèle</h3>
					<p>Choisissez parmi quinze modèles de sites d'agence prêts. Chacun comprend déjà les pages dont une agence a besoin.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Modifiez votre site web</i></div><img src="/wb/step-2-edit.webp" width="1440" height="900" alt="L'éditeur avec les paramètres du bloc héros ouverts, montrant trois agencements" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">2</div>
					<h3>Faites-le vôtre</h3>
					<p>Ajoutez la couleur de votre marque, vos textes et vos photos dans un éditeur qui affiche le vrai site pendant que vous travaillez. Chaque bloc propose plusieurs agencements ; choisissez-en un.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Vérifiez et publiez</i></div><img src="/wb/step-3-publish.webp" width="1440" height="900" alt="La boîte de dialogue Vérifiez et publiez listant les credits mensuels avant la mise en ligne du site" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">3</div>
					<h3>Publier</h3>
					<p>Les propriétés du réseau et les vôtres sont déjà présentes, donc publier ne signifie pas que vous deviez téléverser quoi que ce soit. Les demandes arrivent immédiatement dans votre CRM.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- BUILT FOR AN AGENCY -->
	<section class="wb-section wb-agency">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Conçu pour une agence, pas pour un café</p>
				<h2 class="wb-section-h2">Les blocs dont un agent immobilier <em>a réellement besoin.</em></h2>
				<p class="wb-lead">Grille de biens, bien mis en avant, recherche, formulaire d'estimation, guides de secteur, équipe, avis, chiffres, ce que coûte l'achat, nouveaux programmes. Chaque élément lit les informations de votre compte au lieu de vous demander de les saisir.</p>
			</div>
			<div class="wb-cards">
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9 21v-6h6v6" /></svg><strong>Chaque annonce sur le réseau, prête à être montrée.</strong><p>Vos propres annonces sont sur votre site le jour de leur publication. Le stock du réseau y est aussi : filtrez-le et mettez en avant ce qui correspond à vos acheteurs, immédiatement.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h7M18 15l3 3-3 3" /></svg><strong>Les leads arrivent dans votre CRM.</strong><p>Chaque demande arrive comme un lead. Transférez celles que vous voulez dans vos pipelines : Lead, Seller and Property sont gratuits et sans limite, et déplacer un lead qualifié vers le pipeline Buyer coûte 1 credit.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg><strong>Une recherche qui fonctionne comme un portail.</strong><p>Les acheteurs filtrent le stock par secteur, type et prix sur la page Propriétés, et peuvent enregistrer une recherche.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10l8-6 8 6v10M9 20v-5h6v5" /><path d="M2 20h20" /></svg><strong>Un formulaire d'estimation gratuit qui fait plus.</strong><p>Chaque demande de vendeur arrive sous forme de lead avec un Property Intelligence Report déjà rempli, prêt à l'achat pour 5 credits si vous le souhaitez.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6z" /><path d="M9 12h6M9 16h6M15 3v4h4" /></svg><strong>Coûts d'achat, toujours à jour.</strong><p>Coûts d'achat en Espagne avec la loi citée. Nous vérifions les nouveaux tarifs et les mises à jour et actualisons le bloc, pour que votre site reste correct sans que vous n'ayez à y toucher. Votre avocat confirme le chiffre final.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19h16M6 16V9M11 16V5M16 16v-7" /></svg><strong>Des chiffres qui se calculent automatiquement.</strong><p>Le bloc de chiffres lit vos annonces en ligne. Personne ne les saisit.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-5-6.3" /></svg><strong>Avis et équipe, à partir de ce que vous avez déjà.</strong><p>Connectez votre Google Business Profile et vos avis apparaissent sur le site, ou saisissez-les vous-même. Rien n'est inventé. Votre équipe provient du personnel déjà présent dans votre compte d'agence.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg><strong>Toutes les langues parlées par vos acheteurs.</strong><p>L'anglais et l'espagnol sont fournis par défaut. Ajoutez les autres langues que parlent vos acheteurs sur le même site.</p></article>
			</div>
		</div>
	</section>

	<!-- INCLUDED: HOSTING, SSL, SECURITY -->
	<section class="wb-section wb-incl">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Inclus avec chaque site</p>
				<h2 class="wb-section-h2">Hébergement, SSL et sécurité Cloudflare, <em>tout inclus.</em></h2>
				<p class="wb-lead">Rien à louer, installer ou renouveler. Votre site est rapide et protégé dès le jour de sa publication, et le reste.</p>
			</div>
			<div class="wb-incl-grid">
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" /><path d="M7 7h.01M7 17h.01" /></svg><strong>Hébergement</strong><p>Servi depuis le réseau Cloudflare, donc les pages se chargent rapidement où que soit votre acheteur. Pas de facture d'hébergement, pas de serveur à gérer.</p></article>
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 15v2" /></svg><strong>Certificat SSL</strong><p>Chaque site fonctionne en https avec un certificat qui se renouvelle automatiquement. Le cadenas attendu par les acheteurs, sans que vous n'ayez rien à faire.</p></article>
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg><strong>Sécurité Cloudflare</strong><p>La protection DDoS et la sécurité en périphérie de Cloudflare se placent devant votre site. Les attaques sont absorbées avant de l'atteindre.</p></article>
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg><strong>Votre adresse</strong><p>your-agency-name.estate-agency.co dès le premier jour. Ajoutez votre propre domaine pour 20 credits par mois.</p></article>
			</div>
		</div>
	</section>

	<!-- EDIT WITH AI -->
	<section class="wb-section wb-ai">
		<div class="wrap">
			<div class="wb-ai-grid">
				<div class="wb-ai-text">
					<p class="eyebrow" style="color:#6fe5d3">Éditez avec l'IA</p>
					<h2 class="wb-section-h2 on-dark">Cliquez sur n'importe quoi. <em>Dites ce qu'il faut changer.</em></h2>
					<p class="wb-lead" style="color:#b8c9cb">Décrivez une modification en anglais simple et la page se met à jour. Chaque modification est un brouillon tant que vous ne la publiez pas, et Annuler est toujours disponible.</p>
				</div>
				<figure class="wb-ai-shot">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Modifiez votre site web</i></div><img src="/wb/ai-bubble.webp" width="1440" height="900" alt="Le titre sélectionné dans l'éditeur, avec les modifications que vous pouvez demander" loading="lazy" decoding="async" /></div>
					<figcaption>Le titre sélectionné dans l'éditeur. Plus court, au ton plus chaleureux, mentionnez la ville ou utilisez vos propres mots.</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- PRICING -->
	<section id="pricing" class="wb-pricing wb-section">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow" style="color:#6fe5d3">Tarifs</p>
				<h2 class="wb-section-h2 on-dark">Gratuit à configurer. <em>50 credits par mois une fois que vous publiez.</em></h2>
				<p class="wb-lead" style="color:#b8c9cb">Un plan de base, des compléments en credits, et vous pouvez arrêter n'importe lequel d'entre eux à la fin de n'importe quel mois.</p>
			</div>
			<div class="wb-price-grid">
				<div class="wb-pricing-card">
					<div class="wb-pricing-name">Website Builder</div>
					<div class="wb-pricing-price">50 credits <span class="unit">par mois</span></div>
					<p class="wb-pricing-tagline">Rien n'est facturé pendant que vous créez et prévisualisez; l'abonnement commence le jour où vous publiez.</p>
					<ul class="wb-pricing-features">
						<li>Accueil, Propriétés (recherche et résultats, avec filtres et une recherche enregistrée), une page par bien pour chaque annonce, À propos et Contact</li>
						<li>Pages légales (aviso legal, confidentialité, cookies) et une bannière de cookies, incluses et jamais facturées</li>
						<li>Hébergement et protection Cloudflare inclus : rapide et protégé, rien à gérer pour vous</li>
						<li>Anglais et espagnol par défaut, d'autres langues peuvent être ajoutées</li>
						<li>Les quinze modèles, changez à tout moment et conservez votre travail</li>
						<li>Les demandes arrivent directement dans votre CRM PropertyList</li>
						<li>Annulez à la fin de n'importe quel mois; le site revient au microsite d'agence gratuit et vous gardez votre domaine</li>
					</ul>
					<div class="wb-pricing-cta"><a class="btn btn-primary btn-large" href={BUILD}>Créez gratuitement</a></div>
					<p class="wb-pricing-note">Pages supplémentaires: <strong>10 credits par mois</strong> chacune.</p>
				</div>
				<div class="wb-pricing-aside">
					<div class="wb-addon-card">
						<h4>Modules complémentaires, <em>si vous le souhaitez</em></h4>
						<p class="wb-addon-intro">Chaque module est facturé mensuellement, activé depuis votre compte, et peut être arrêté à la fin de n'importe quel mois.</p>
						<ul class="wb-addon-list">
							{addons.map((a) => (
								<li><span class="wb-addon-name">{a.name}<small>{a.what}</small></span><span class="wb-addon-price">{a.price}</span></li>
							))}
						</ul>
						<div class="wb-addon-footer">Flux des nouveaux programmes : module séparé, tarif indiqué dans votre compte.</div>
					</div>
					<div class="wb-credit-info">
						<h4>Qu'est-ce qu'un credits</h4>
						<p>L'unité de PropertyList pour les fonctionnalités payantes, vendue en packs : 1 credit (environ 1 EUR) dans le plus petit pack, moins dans les packs plus importants. les credits n'expirent pas, donc tout ce que vous n'utilisez pas ce mois-ci est toujours disponible le mois suivant.</p>
						<p style="margin:0"><a href={REFERRALS}>Parrainez une autre agence</a> et vous recevez 20 credits (environ 20 EUR) une fois qu'elle a complété la vérification, pas à l'inscription. La nouvelle agence reçoit 10 credits.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ALREADY HAVE A WEBSITE -->
	<section id="xml" class="wb-xml wb-section">
		<div class="wrap">
			<div class="wb-xml-inner">
				<div>
					<p class="eyebrow">Vous avez déjà un site web ?</p>
					<h2 class="wb-section-h2">Conservez votre site. <em>Alimentez votre site avec tout le réseau.</em></h2>
					<p class="wb-lead">Alimentez chaque annonce du réseau dans le site que vous avez déjà, filtrées comme vous le souhaitez : seulement votre propre stock, ou une sélection du réseau en parallèle. XML ou l'API du site ; votre développeur la connecte une fois et, ensuite, le site lit depuis le même compte que votre MLS et CRM.</p>
				</div>
				<div class="wb-xml-card">
					<div class="wb-xml-price-row"><span class="wb-xml-price">35 credits</span><span class="wb-xml-price-unit">par mois</span></div>
					<p class="wb-xml-detail">Flux XML ou API du site. Annulez à tout moment.</p>
					<ul class="wb-pricing-features">
						<li>Toutes les annonces du réseau sur votre propre site, filtrées comme vous le souhaitez</li>
						<li>Flux XML ou API du site, au choix de votre développeur</li>
						<li>La documentation est publique ; rien à acheter pour les lire</li>
					</ul>
					<a class="btn btn-primary" href={DASHBOARD}>Configurer un flux</a>
					<p class="wb-xml-docs"><a href={DOCS}>Consultez la documentation du Website Builder et des flux</a></p>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="wb-faq wb-section">
		<div class="narrow">
			<div class="wb-section-head">
				<p class="eyebrow">Questions</p>
				<h2 class="wb-section-h2">Ce que les agents <em>demandent d'abord.</em></h2>
			</div>
			<div>
				{faqs.map((f) => (
					<div class="wb-faq-item"><details><summary>{f.q}</summary><p>{f.a}</p></details></div>
				))}
			</div>
		</div>
	</section>

	<!-- FINAL CTA -->
	<section class="wb-final wb-section">
		<div class="narrow">
			<p class="eyebrow" style="color:#6fe5d3">Basé sur la Costa del Sol &middot; utilisé dans toute l'Espagne</p>
			<h2 class="wb-section-h2 on-dark">Vos annonces sont prêtes.<br /><em>Votre site est-il prêt?</em></h2>
			<p class="wb-lead">Choisissez un design, faites-le vôtre et publiez quand vous le souhaitez.</p>
			<a class="btn btn-primary btn-large" href={BUILD}>Créez gratuitement</a>
			<p class="wb-final-note">Gratuit pour créer et prévisualiser. À partir de 50 credits par mois une fois que vous publiez. <a href={DOCS}>Consultez la documentation</a>.</p>
		</div>
	</section>

	<script is:inline>
		(function () {
			var rail = document.getElementById('wbRail');
			if (!rail) return;
			var chips = document.querySelectorAll('.wb-chip');
			var cards = rail.querySelectorAll('.wb-tpl');
			chips.forEach(function (c) {
				c.addEventListener('click', function () {
					var s = c.getAttribute('data-style');
					chips.forEach(function (x) { var on = x === c; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
					cards.forEach(function (k) { k.hidden = !(s === 'all' || k.getAttribute('data-style') === s); });
					rail.scrollTo({ left: 0, behavior: 'smooth' });
				});
			});
			function step(dir) {
				var first = rail.querySelector('.wb-tpl:not([hidden])');
				var w = first ? first.getBoundingClientRect().width + 24 : rail.clientWidth * 0.8;
				rail.scrollBy({ left: dir * w, behavior: 'smooth' });
			}
			document.querySelector('.wb-rail-btn.prev').addEventListener('click', function () { step(-1); });
			document.querySelector('.wb-rail-btn.next').addEventListener('click', function () { step(1); });
		})();
	</script>
</Layout>

<style is:global>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',system-ui,sans-serif;font-size:16px;line-height:1.6;color:#0d2b2e;background:#fff;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:#00ae9a;text-decoration:none}
a:hover{text-decoration:underline}
.wrap{max-width:1200px;margin:0 auto;padding:0 24px}
.narrow{max-width:880px;margin:0 auto;padding:0 24px}
.eyebrow{font-size:12px;font-weight:700;letter-spacing:2px;color:#00ae9a;text-transform:uppercase;margin-bottom:12px}
.btn{display:inline-block;padding:16px 28px;font-size:15px;font-weight:700;border-radius:10px;border:none;cursor:pointer;transition:transform .15s,box-shadow .15s,background .15s;text-decoration:none}
.btn-primary{background:#00ae9a;color:#fff;box-shadow:0 4px 14px rgba(0,174,154,.3)}
.btn-primary:hover{background:#008f7e;transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,174,154,.4);text-decoration:none}
.btn-secondary{background:transparent;color:#0d2b2e;border:1.5px solid #0d2b2e}
.btn-secondary.on-dark{color:#fff;border-color:rgba(255,255,255,.4)}
.btn-secondary:hover{background:#0d2b2e;color:#fff;text-decoration:none}
.btn-secondary.on-dark:hover{background:#fff;color:#0d2b2e}
.btn-large{padding:18px 36px;font-size:16px}
.wb-section{padding:100px 0}
.wb-section-head{text-align:center;margin-bottom:56px}
.wb-section-head p{max-width:680px;margin:0 auto}
.wb-section-head .eyebrow{margin-bottom:12px}
.wb-section-h2{font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:clamp(30px,4vw,44px);line-height:1.15;letter-spacing:-.01em;color:#0d2b2e;margin-bottom:18px;text-wrap:balance}
.wb-section-h2 em{color:#00ae9a;font-style:italic}
.wb-section-h2.on-dark{color:#fff}
.wb-lead{font-size:18px;line-height:1.6;color:#4a5b5d}

/* browser frame used for every real capture */
.wb-frame{background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e5ecec;box-shadow:0 20px 60px rgba(13,43,46,.12)}
.wb-frame-bar{background:#f3f5f5;padding:10px 14px;display:flex;align-items:center;gap:7px;border-bottom:1px solid #e5ecec}
.wb-frame-bar span{width:10px;height:10px;border-radius:50%;background:#d6dede}
.wb-frame-bar span:nth-child(1){background:#ff5f57}.wb-frame-bar span:nth-child(2){background:#febd2e}.wb-frame-bar span:nth-child(3){background:#28c941}
.wb-frame-bar i{flex:1;font-style:normal;background:#fff;padding:3px 12px;border-radius:6px;font-size:11px;color:#7a8a8c;margin-left:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wb-frame img{width:100%;aspect-ratio:1440/900;object-fit:cover;object-position:top}
.wb-frame-dark{border-color:rgba(255,255,255,.14);box-shadow:0 30px 80px rgba(0,0,0,.45)}
.wb-frame-dark .wb-frame-bar{background:#12373b;border-color:rgba(255,255,255,.08)}
.wb-frame-dark .wb-frame-bar i{background:rgba(255,255,255,.08);color:#b8c9cb}

/* hero */
.wb-hero{background:#0d2b2e;color:#fff;padding:80px 0 56px;position:relative;overflow:hidden}
.wb-hero::before{content:"";position:absolute;top:-200px;right:-200px;width:600px;height:600px;background:radial-gradient(circle,rgba(0,174,154,.15),transparent 70%);pointer-events:none}
.wb-hero-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center;position:relative;z-index:1}
.wb-hero-grid>*{min-width:0}
.wb-hero-eyebrow{display:inline-flex;align-items:center;gap:10px;background:rgba(0,174,154,.16);border:1px solid rgba(0,174,154,.35);padding:8px 14px;border-radius:18px;font-size:11.5px;line-height:1.5;font-weight:700;color:#00ae9a;letter-spacing:1.2px;text-transform:uppercase;margin-bottom:28px;text-align:left}
.wb-hero-eyebrow img{width:18px;height:18px}
.wb-hero-h1{font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:clamp(40px,5.4vw,62px);line-height:1.05;letter-spacing:-.02em;color:#fff}
.wb-hero-h1 em{color:#00ae9a;font-style:italic;white-space:nowrap}
.wb-hero-sub{font-size:19px;line-height:1.55;color:#b8c9cb;margin:24px 0 32px;max-width:520px}
.wb-hero-ctas{display:flex;flex-wrap:wrap;gap:14px;align-items:center}
.wb-hero-trust{margin-top:22px;font-size:13.5px;color:#8aa5a8;letter-spacing:.2px;max-width:480px}
.wb-hero-visual{transform:none}
.film{margin:0;padding:0}
.filmVid{display:block;width:100%;height:auto;aspect-ratio:1440/900;object-fit:cover;background:#0d2b2e}
.filmCap{margin:10px 4px 0;font-size:12.5px;line-height:1.55;color:rgba(255,255,255,.5)}
@media (prefers-reduced-motion: reduce){.filmVid{display:none}.wb-film .wb-frame-dark{aspect-ratio:1440/940;background:url('/hero/wb-hero-poster.jpg') center bottom/cover no-repeat}}

/* proof */
.wb-trust{background:#0d2b2e;padding:72px 0 64px;color:#fff}
.wb-trust-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;text-align:center}
.wb-trust-num{font-family:'Playfair Display',Georgia,serif;font-size:42px;line-height:1;color:#00ae9a;margin-bottom:8px}
.wb-trust-label{font-size:12px;color:#b8c9cb;letter-spacing:1px;text-transform:uppercase}
.wb-trust-line{text-align:center;max-width:720px;margin:40px auto 0;font-size:17px;line-height:1.6;color:#cfdedf}

/* the fifteen */
.wb-fifteen{background:#faf6ee;padding-bottom:70px}
.wb-chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:-24px 0 34px}
.wb-chip{background:#fff;border:1px solid #e5ecec;color:#0d2b2e;padding:9px 16px;border-radius:50px;font-size:13.5px;font-weight:600;cursor:pointer;transition:background .15s,color .15s,border-color .15s}
.wb-chip:hover{border-color:#00ae9a}
