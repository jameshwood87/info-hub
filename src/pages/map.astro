---
import Layout from '../layouts/Layout.astro';
import { readMapJson } from '../lib/mapData';

// Live network map. map-data.json (8 deep-coverage municipalities) is rebuilt nightly by
// scripts/build-map-data.py. cities.json holds every listing's town, geocoded once.
// Boundaries are OSM admin_level=8 relations, stitched and simplified.
const origin = 'https://info.propertylist.es';
const canonical = origin + '/map/';
const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=en';
const MAPTEXT = {
	thin: 'List them free, forever. Your properties reach every agent on the network.',
	cta: 'List for free',
	thinTitle: 'Room for another agency',
	verified: 'Notary-verified',
	paid: 'what buyers actually paid',
	sales: 'sales',
	whyPt: 'No verified price here: the notarial register we use covers Spain, not Portugal.',
	whyThin: 'Too few registered sales here to publish a verified price.',
	whyNone: 'No notarial figure for this place yet - the register publishes by municipality, and this is a smaller area within one.',
	loc: 'en-GB',
	layerSale: 'Colour shows how many homes are listed.',
	layerPsm: 'Colour shows the asking price per m\u00b2.',
	layerVerified: 'Colour shows the notary-verified price per m\u00b2.',
	layerGap: 'Homes listed per 10,000 residents. Red means a place is barely covered for its size. Grey means too few listings there to measure yet.',
	cov: 'listed per 10,000 residents',
	popLbl: 'Population',
	gapThin: 'Barely covered for a place this size.',
	forSale: 'homes for sale',
	listed1: 'home listed',
	listedN: 'homes listed',
	medianAsking: 'Median asking',
	askingPsm: 'Asking \u20ac/m\u00b2',
	longTerm: 'Long-term',
	holidayLbl: 'Holiday',
	agenciesHere: 'Agencies listing here',
	askPre: 'Do you list in ',
	askPost: '?',
};

const title = 'Property network map - every listing, in 3D | PropertyList';
const description =
	'A live 3D map of every home on the PropertyList network across Spain and Portugal. Spin the globe, drop into the Costa del Sol, and see listing counts, median asking prices, price per m2 and the notary-verified price buyers actually paid.';

// read per render, not via a process-lifetime ESM import - see src/lib/mapData.ts
const data: any = readMapJson('map-data.json');
const cities: any = readMapJson('cities.json');

const munis = data?.municipalities ?? {};
const rows = Object.entries(munis)
	.map(([name, m]: any) => ({
		name,
		ine: m.ine,
		sale: m.ops?.sale?.n ?? 0,
		rent: m.ops?.rent?.n ?? 0,
		holiday: m.ops?.holiday?.n ?? 0,
		median: m.ops?.sale?.median ?? null,
		psm: m.ops?.sale?.psm ?? null,
		verified: m.verified?.psm ?? null,
		vn: m.verified?.n ?? null,
		pop: m.pop ?? null,
		p10: m.p10 ?? null,
		agencies: m.agencies?.top ?? [],
	}))
	.sort((a, b) => b.sale - a.sale);

const feats = cities?.features ?? [];
const totalListings = feats.reduce((s: number, f: any) => s + (f.properties?.n ?? 0), 0);
const townCount = feats.length;
const regionMap: Record<string, number> = {};
feats.forEach((f: any) => {
	const r = f.properties?.region ?? '?';
	regionMap[r] = (regionMap[r] ?? 0) + (f.properties?.n ?? 0);
});
const regions = Object.entries(regionMap).sort((a, b) => b[1] - a[1]);

const generated = data?.generated ? new Date(data.generated) : null;
const fmtDate = generated
	? `${String(generated.getUTCDate()).padStart(2, '0')}-${String(generated.getUTCMonth() + 1).padStart(2, '0')}-${String(generated.getUTCFullYear()).slice(2)}`
	: null;
const eur = (n: number | null) => (n == null ? '-' : '€' + n.toLocaleString('en-GB'));
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	fullBleed
	ogImage="/og/map.png"
	hreflangs={[
		{ hreflang: 'en', href: origin + '/map/' },
		{ hreflang: 'es', href: origin + '/es/mapa/' },
		{ hreflang: 'x-default', href: origin + '/map/' },
	]}
>
	<section class="hero">
		<div class="wrap">
			<p class="eyebrow">Live network map</p>
			<h1>Where the network actually is</h1>
			<p class="lede">
				Every home on the PropertyList network, counted once however many agencies are marketing it, and placed in the
				town it sits in. Spin the globe, drop into the Costa del Sol, and the deeper a municipality&rsquo;s colour, the
				more homes it has listed. Asking prices come from the MLS. The verified figure underneath comes from the Spanish
				notarial register: what buyers actually paid.
			</p>
			<div class="counters">
				<div><strong>{totalListings.toLocaleString('en-GB')}</strong><span>unique homes on the network</span></div>
				<div><strong>{townCount}</strong><span>towns</span></div>
				<div><strong>{regions.length}</strong><span>regions, Spain &amp; Portugal</span></div>
			</div>
		</div>
	</section>

	<section class="mapsec">
		<div class="wrap">
			<div class="controls" role="group" aria-label="Map layer">
				<button class="chip on" data-layer="sale" type="button">Homes for sale</button>
				<button class="chip" data-layer="psm" type="button">Asking &euro;/m&sup2;</button>
				<button class="chip" data-layer="verified" type="button">Verified &euro;/m&sup2;</button>
				<button class="chip" data-layer="gap" type="button">Coverage gaps</button>
			</div>
			<div class="controls secondary" role="group" aria-label="Map view">
				<button class="ghost" id="spainbtn" type="button">Whole network</button>
				<button class="ghost" id="homebtn" type="button">Costa del Sol</button>
				<button class="ghost" id="flattoggle" type="button">Flat view</button>
			</div>

			<div class="maplayout">
				<button id="skipintro" type="button">Skip intro</button>
				<div id="map" role="application" aria-label="3D map of the PropertyList network">
					<noscript>
						<p class="nojs">The interactive map needs JavaScript. Every municipality and region is listed in the tables below.</p>
					</noscript>
				</div>
				<aside id="panel" aria-live="polite">
					<p class="panelhint">Select a municipality or a town on the map to see its numbers.</p>
				</aside>
			</div>

			<p class="legend"><span id="legendlabel">Colour shows how many homes are listed.</span>
				{fmtDate && <span class="stamp">Rebuilt {fmtDate}</span>}
			</p>
			<p class="credits">Satellite imagery Esri, Maxar, Earthstar Geographics &middot; boundaries and place names &copy; OpenStreetMap contributors &middot; elevation AWS Terrain Tiles &middot; market data PropertyList &middot; verified prices Consejo General del Notariado.</p>
		</div>
	</section>

	<section class="tablesec">
		<div class="wrap">
			<h2>Deep coverage: the Costa del Sol</h2>
			<p class="sub">
				These eight municipalities carry most of the network. Asking prices are what sellers advertise today. The verified
				price per m<sup>2</sup> is the notarial register figure for that municipality over the trailing twelve months,
				across all property types - read it as the floor a market sits on, not a valuation of any one home.
			</p>
			<div class="tablewrap">
				<table>
					<thead>
						<tr>
							<th>Municipality</th>
							<th class="n">For sale</th>
							<th class="n">Per 10k residents</th>
							<th class="n">Median asking</th>
							<th class="n">Asking &euro;/m&sup2;</th>
							<th class="n">Verified &euro;/m&sup2;</th>
							<th class="n">Long-term</th>
							<th class="n">Holiday</th>
						</tr>
					</thead>
					<tbody>
						{rows.map((r) => (
							<tr>
								<th scope="row">{r.name}</th>
								<td class="n">{r.sale.toLocaleString('en-GB')}</td>
								<td class="n">{r.p10 == null ? '-' : r.p10.toLocaleString('en-GB')}</td>
								<td class="n">{eur(r.median)}</td>
								<td class="n">{eur(r.psm)}</td>
								<td class="n v">{eur(r.verified)}{r.vn && <em> n={r.vn.toLocaleString('en-GB')}</em>}</td>
								<td class="n">{r.rent.toLocaleString('en-GB')}</td>
								<td class="n">{r.holiday.toLocaleString('en-GB')}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<h2 class="mt">Everywhere else the network reaches</h2>
			<p class="sub">
				Every region where the network has at least one home. Some have only a handful - if you list there, you would be
				among the first.
			</p>
			<div class="tablewrap narrow">
				<table>
					<thead><tr><th>Region</th><th class="n">Homes listed</th><th class="n">Share</th></tr></thead>
					<tbody>
						{regions.map(([r, n]) => (
							<tr>
								<th scope="row">{r}</th>
								<td class="n">{n.toLocaleString('en-GB')}</td>
								<td class="n">{totalListings ? ((n / totalListings) * 100).toFixed(1) + '%' : '-'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section class="ctasec">
		<div class="wrap">
			<h2>Your listings, on this map</h2>
			<p>
				Every home shown here belongs to an agency on the PropertyList network. Listing is free: your properties reach the
				other agents who can sell them, and you can sell from everything they list. No card, no contract.
			</p>
			<a class="btn" href={SIGNUP} data-umami-event="map-signup">Create your free agency account</a>
			<p class="fine">Free forever for the core platform. See <a href="/free/">what is free</a>.</p>
		</div>
	</section>

	<script is:inline define:vars={{ rows, SIGNUP, MAPTEXT }}>
		window.__PLMAP__ = rows;
		window.__PLSIGNUP__ = SIGNUP;
		window.__PLTEXT__ = MAPTEXT;
	</script>
	<link rel="stylesheet" href="/map/maplibre-gl.css" />
	<script is:inline src="/map/maplibre-gl.js"></script>
	<script is:inline src="/map/map.js"></script>
</Layout>

<style>
	.wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
	.hero { background: linear-gradient(160deg, #06302c 0%, #0b1b22 70%); color: #fff; padding: 62px 0 40px; }
	.eyebrow { text-transform: uppercase; letter-spacing: 1.4px; font-size: 12px; font-weight: 800; color: #5be3d0; margin: 0 0 10px; }
	.hero h1 { font-size: clamp(30px, 4.6vw, 50px); line-height: 1.06; letter-spacing: -1.2px; margin: 0 0 14px; }
	.lede { max-width: 800px; font-size: 17.5px; line-height: 1.62; color: rgba(255,255,255,0.82); margin: 0 0 26px; }
	.counters { display: flex; flex-wrap: wrap; gap: 34px; }
	.counters strong { display: block; font-size: 30px; font-weight: 800; letter-spacing: -0.8px; color: #5be3d0; }
	.counters span { font-size: 13px; color: rgba(255,255,255,0.62); }

	.mapsec { padding: 30px 0 10px; background: #f6fafb; }
	.controls { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
	.controls.secondary { margin-bottom: 14px; }
	.chip { border: 1.5px solid #d5e2e0; background: #fff; color: #5b6b73; border-radius: 999px; padding: 9px 17px; font-size: 14px; font-weight: 700; cursor: pointer; transition: background .14s, color .14s, border-color .14s; }
	.chip:hover { border-color: #00ae9a; color: #0b1b22; }
	.chip.on { background: #00ae9a; border-color: #00ae9a; color: #fff; }
	.ghost { border: 1.5px solid #d5e2e0; background: #fff; color: #5b6b73; border-radius: 999px; padding: 7px 15px; font-size: 13px; font-weight: 700; cursor: pointer; }
	.ghost:hover { border-color: #00ae9a; color: #0b1b22; }

	.maplayout { display: grid; grid-template-columns: 1fr 330px; gap: 16px; position: relative; }
	#map { height: 600px; border-radius: 14px; overflow: hidden; background: #0b1b22; border: 1px solid #e7eef1; }
	#skipintro { display: none; position: absolute; z-index: 5; top: 14px; left: 14px; align-items: center; background: rgba(11,27,34,.84); color: #fff; border: 0; border-radius: 999px; padding: 8px 17px; font-size: 13px; font-weight: 700; cursor: pointer; }
	#skipintro:hover { background: rgba(11,27,34,.95); }
	.nojs { padding: 20px; color: #cfe0e2; }
	#panel { background: #fff; border: 1px solid #e7eef1; border-radius: 14px; padding: 18px; overflow-y: auto; max-height: 600px; }
	.panelhint { color: #5b6b73; font-size: 14.5px; margin: 0; }
	.legend { display: flex; justify-content: space-between; align-items: center; gap: 14px; font-size: 13px; color: #5b6b73; margin: 12px 0 0; }
	.stamp { color: #8aa0a6; }

	.credits { font-size: 11.5px; color: #8aa0a6; line-height: 1.5; margin: 8px 0 0; max-width: 900px; }
	.maplibregl-ctrl-attrib.maplibregl-compact:not(.maplibregl-compact-show) .maplibregl-ctrl-attrib-inner { display: none; }
	.tablesec { padding: 46px 0; background: #fff; }
	.tablesec h2, .ctasec h2 { font-size: clamp(23px, 3vw, 32px); letter-spacing: -0.7px; margin: 0 0 10px; color: #0b1b22; }
	.mt, .tablesec h2.mt, .ctasec h2.mt { margin-top: 64px; }
	.sub { color: #5b6b73; max-width: 800px; line-height: 1.6; margin: 0 0 20px; font-size: 15.5px; }
	.tablewrap { overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 640px; }
	/* three columns do not need the wide table's minimum, and on a phone that
	   minimum was spreading them across a scrollable 640px. */
	.tablewrap.narrow table { min-width: 0; }
	.tablewrap.narrow th.n, .tablewrap.narrow td.n { width: 1%; white-space: nowrap; }
	th, td { padding: 11px 12px; border-bottom: 1px solid #eef3f4; text-align: left; }
	thead th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; color: #5b6b73; border-bottom: 2px solid #e7eef1; }
	td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
	tbody th { font-weight: 700; color: #0b1b22; }
	td.v { color: #00867a; font-weight: 700; }
	td.v em { display: block; font-style: normal; font-size: 11.5px; color: #8aa0a6; font-weight: 400; }

	.ctasec { padding: 52px 0 66px; background: #f6fafb; }
	.ctasec p { color: #45585f; max-width: 720px; line-height: 1.62; margin: 0 0 18px; }
	.btn { display: inline-block; background: #00ae9a; color: #fff; border-radius: 999px; padding: 14px 30px; font-weight: 800; text-decoration: none; }
	.btn:hover { background: #00998a; }
	.fine { font-size: 13.5px; color: #5b6b73; margin-top: 14px; }
	.fine a { color: #00867a; }

	@media (max-width: 640px) {
		.tablewrap.narrow th, .tablewrap.narrow td { padding: 10px 8px; font-size: 14px; }
		.tablewrap.narrow thead th { font-size: 11px; letter-spacing: 0.4px; }
	}

	@media (max-width: 380px) {
		.tablewrap.narrow th, .tablewrap.narrow td { padding: 9px 5px; font-size: 13px; }
		.tablewrap.narrow thead th { font-size: 10px; letter-spacing: 0.2px; }
	}

	@media (max-width: 900px) {
		.maplayout { grid-template-columns: 1fr; }
		/* Full-bleed. The 20px gutters cost a quarter of the map's width on a phone, which
		   was enough to make every municipality label collide away. body is overflow-x: clip
		   so breaking out of the container cannot cause side-scrolling. */
		#map {
			height: min(62vh, 600px);
			min-height: 450px;
			width: 100vw;
			margin-left: calc(50% - 50vw);
			margin-right: calc(50% - 50vw);
			border-radius: 0;
			border-left: 0;
			border-right: 0;
		}
		#skipintro { left: 12px; }
		#panel { max-height: none; }
		.counters { gap: 22px; }
	}
</style>
