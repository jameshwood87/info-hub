---
import Layout from '../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../lib/portalStats';
import AgentInterestCta from '../components/AgentInterestCta.astro';

const __ps = await getPortalStats();
const plListings = statPlus(__ps.listings, 'en');
const plAgents = statPlus(__ps.agents, 'en');
const plAgencies = statPlus(__ps.agencies, 'en');

const title = 'PropertyList Pricing: Free MLS + CRM, Pay Only for Upgrades';
const description =
	'The MLS and CRM are free forever for estate agents. Use optional pay-as-you-go credits for featured listings and add-ons, only when you need them.';

const sections: Array<{
	title: string;
	subtitle: string;
	items: Array<{ feature: string; price: string; note?: string }>;
}> = [
	{
		title: 'MLS',
		subtitle: 'Multi-Listing Service',
		items: [
			{ feature: 'Unlimited Listings', price: 'Free' },
			{ feature: 'List by Voice (Instant Listing)', price: 'Free' },
			{ feature: 'Users/Staff', price: 'Free' },
			{ feature: 'Branded MicroSite', price: 'Free' },
			{ feature: 'Photos on a listing', price: '25 free, then 1 credit each' },
			{ feature: 'Video on a listing', price: '5 credits each' },
			{ feature: 'Video tour by YouTube link', price: 'Free' },
			{ feature: 'Feature a Listing', price: 'from 10 credits' },
			{ feature: 'Property Alerts', price: 'Free' },
			{ feature: 'Private Listings (do not share)', price: '5 free, then 5 credits each' },
			{ feature: 'LeadBoard', price: 'Coming soon' },
			{ feature: 'XML Import', price: 'Free' },
			{ feature: 'XML push to other portals', price: 'Free' },
			{ feature: 'Feed to your own website (XML or API): every network listing from the MLS, resale and rentals. Your own listings are free', price: '35 credits / month' },
			{ feature: 'Feed to your own website: network new developments and off-plan (separate feed)', price: '25 credits / month' },
		],
	},
	{
		title: 'CRM',
		subtitle: 'Client Relationship Management',
		items: [
			{ feature: 'Unlimited Contacts', price: 'Free' },
			{ feature: 'Calendar Events', price: 'Free' },
			{ feature: 'Lead Pipeline', price: 'Free' },
			{ feature: 'Buyer pipeline (you choose who goes in)', price: '1 credit per lead you move into it' },
			{ feature: 'Seller pipeline', price: 'Free' },
			{ feature: 'Property pipeline', price: 'Free' },
			{ feature: 'Tenants pipeline (Rentals Module)', price: '50 credits / 30 days, free 30-day trial' },
			{ feature: 'Nurture pipeline (Automation & Nurture)', price: '20 credits/mo' },
			{ feature: 'Connected inbox (Gmail, Outlook or other)', price: 'Coming soon, 10 credits per mailbox/mo' },
			{ feature: 'Document Upload', price: 'Free' },
			{ feature: 'AI Funnels', price: 'Coming soon' },
			{ feature: 'AI Chatbot', price: 'Coming soon' },
			{ feature: 'Property Specific Market Analysis', price: '5 credits per analysis (limited time offer)' },
		],
	},
	{
		title: 'Public Portal',
		subtitle: 'We advertise for you',
		items: [
				{ feature: 'Feature a Listing', price: 'from 10 credits' },
			{ feature: 'AI Property Search (search by texting)', price: 'Free' },
			{ feature: 'Open a Direct Lead', price: 'Free for a limited time' },
			{ feature: 'Featured Estate Agents', price: 'Coming soon' },
			{ feature: 'AI Virtual Tours', price: 'Coming soon' },
			{ feature: 'Premium Homepage', price: 'Coming soon' },
		],
	},
	{
		title: 'Website Builder',
		subtitle: 'Your own agency website',
		items: [
			{ feature: 'Drag-and-drop builder', price: '50 credits/mo' },
			{ feature: 'AI SEO & meta', price: '5 credits/mo' },
			{ feature: 'Instant Content: unlimited AI blog & area guides', price: '30 credits/mo, requires the Website Builder' },
			{ feature: 'Popup lead capture', price: '8 credits/mo' },
			{ feature: 'Custom domain', price: '20 credits/mo' },
			{ feature: 'Remove PropertyList branding', price: '50 credits/mo' },
			{ feature: 'All MLS listings auto-loaded', price: 'Included' },
			{ feature: 'Free hosting & SSL', price: 'Included' },
		],
	},
];

const pricingFaqItems = [
	{
		q: 'Is PropertyList really free for estate agents?',
		a: 'The core is free with no limit: the MLS, unlimited listings, team accounts, contact management and the Lead, Seller and Property pipelines. The CRM is not 100% free, because moving a qualified buyer lead into the Buyer pipeline costs 1 credit. Your first 5 are free, then it is 1 credit each. Everything else paid is optional: featured listings (10 credits for 3 days), the Rentals Module (50 credits per 30 days, free 30-day trial), Automation & Nurture (20 credits a month) or the Website Builder (50 credits a month).',
	},
	{
		q: 'How do credits work?',
		a: 'Everything paid on PropertyList draws from a single balance of credits. You buy them in packs - from €20 for 20 credits (€1 each) down to €0.80 per credit on the 1,000 pack - and credits you have bought never expire. Monthly subscriptions (like the Website Builder) and pay-as-you-go features (like market reports) all come from the same balance.',
	},
	{
		q: 'What happens if I run out of credits?',
		a: 'Nothing is lost. If your balance cannot cover a renewal, your custom site pauses and visitors see the standard page while every page and setting is kept safe as a draft. Top up and republish in one click. Turn on Auto-Renew and your balance tops up automatically before each renewal, by the monthly cost of whatever you have switched on, so nothing pauses or expires.',
	},
	{
		q: 'Can I cancel my website builder subscription anytime?',
		a: 'Yes. There are no tied contracts and no cancellation fees. Switch a feature off and it simply will not renew next month; the current month stays active until your renewal date (no refunds for a part-month).',
	},
	{
		q: 'What do I get with the free plan?',
		a: 'Unlimited property listings, List by Voice (add a full listing from photos and a voice note with Instant Listing), AI property search, unlimited staff accounts, a branded MicroSite for your agency, CRM with contacts and leads management, calendar events, lead pipeline, document upload, WhatsApp Community access, and social distribution to Facebook - all free.',
	},
	{
		q: 'How do the CRM pipelines work?',
		a: 'PropertyList includes six CRM pipelines. Lead, Seller and Property are free. Buyer costs 1 credit for each qualified lead you decide to move into it, and the first 5 are free. After that the credits come from your credit balance. Tenants is part of the Rentals Module (Tenants pipeline, Tenancies and Maintenance): 50 credits per 30-day period, with a free 30-day trial and no charge until you renew. Nurture is part of Automation & Nurture at 20 credits/month - one product at one price - which also includes the automated emails, Hot-lead detection and the Daily Action Queue. New leads land in New Lead and new listings land in Active Listing. Lead and Seller are fixed boards; Buyer and Property you can edit. The legal phase sits inside the Buyer and Property pipelines: Reservation Paid, Deposit Paid, Mortgage in Progress, Notary Appointment and WON - Deed Signed.',
	},
	{
		q: 'How much does the Website Builder cost?',
		a: 'The base site is 50 credits a month and includes your results page, property pages and your first few pages; extra pages are 10 credits/mo each. Add optional power-ups: Instant Content (30 credits/mo, unlimited AI blogs and area guides), AI SEO meta (5 credits/mo), popup lead capture (8 credits/mo), custom domain (20 credits/mo), or remove PropertyList branding (50 credits/mo). Free hosting, SSL, and automatic MLS listing loading are always included.',
	},
	{
		q: 'Can Instant Content run automatically?',
		a: 'Yes. Switch on auto-publish and it writes and publishes unlimited SEO blog posts and area guides for your site by itself, grounded in your own listings and verified market data - or choose review-first and approve each piece before it goes live.',
	},
	{
		q: 'Is there a free trial for paid features?',
		a: 'Yes. Every paid feature comes with a free test, so you can try it before spending any credits: your first 5 buyer leads are free, the property market report gives you 3 free reports, the Rentals Module has a 30-day trial, and the Website Builder is free to build and preview until you publish it live. Verified Agencies also receive 20 free credits, and you earn another 20 credits for every agency that signs up through your referral link, while the new agency starts with 10.',
		link: { href: 'https://agents.propertylist.es/referrals', label: 'Get your referral link' },
	},
];

const pricingFaqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: pricingFaqItems.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const softwareAppLd = {
 "@context": "https://schema.org",
 "@type": "SoftwareApplication",
 "name": "PropertyList",
 "applicationCategory": "BusinessApplication",
 "applicationSubCategory": "Estate agency CRM, agent-to-agent MLS and property portal",
 "operatingSystem": "Web browser, Android",
 "url": "https://propertylist.es/",
 "sameAs": [
  "https://agents.propertylist.es/",
  "https://info.propertylist.es/"
 ],
 "inLanguage": [
  "en",
  "es"
 ],
 "areaServed": {
  "@type": "Country",
  "name": "Spain"
 },
 "provider": {
  "@type": "Organization",
  "name": "PropertyList"
 },
 "description": `Estate agency system for Spain combining a CRM, an agent-to-agent MLS shared by ${plAgents} agents across ${plAgencies} agencies, and a public property portal. Listings, the CRM and the Lead, Seller and Property pipelines are free with no limit. A buyer lead costs 1 credit, and only when the agent chooses to move it into the Buyer pipeline. Automation, rentals and the website builder are monthly credit subscriptions from one prepaid balance.`,
 "featureList": [
  "Six CRM pipelines: Leads, Buyers, Sellers, Property, Tenants, Nurture",
  `Agent-to-agent MLS with co-broking across ${plAgencies} agencies`,
  "Public property portal listing and direct buyer enquiries",
  "AI Property Match: plain-language search across own stock and the whole MLS",
  "Automated lead acknowledgement and a day 0, 1, 3, 7 follow-up cadence",
  "Nurture: automated past-client follow-up with intent detection",
  "Rentals Module: tenancies, renewals, annual rent review, deposit compliance, maintenance",
  "Free branded MicroSite for every agency",
  "AI website builder with automated SEO content",
  "Notary-verified register prices and per-property CMA reports",
  "XML feed import and export",
  "Android app",
  "MCP server for AI-native property queries"
 ],
 "offers": [
  {
   "@type": "Offer",
   "name": "Free plan",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "MLS and CRM, unlimited listings, unlimited staff accounts, the Lead, Seller and Property pipelines, a branded MicroSite and XML push to other portals. No card, no time limit."
  },
  {
   "@type": "Offer",
   "name": "Portal direct lead",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "Enquiries from the public property portal are free to open, taking no credits. Free for a limited time; expected to move to a pay-per-lead model in future, with notice."
  },
  {
   "@type": "Offer",
   "name": "Buyer lead",
   "price": "1",
   "priceCurrency": "EUR",
   "description": "Costs 1 credit, charged only when the agent chooses to move a qualified contact into the Buyer pipeline, and the first 5 are free. Everything up to that point is free and declining costs nothing. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  },
  {
   "@type": "Offer",
   "name": "Automation and Nurture",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "20",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "20 credits a month from the same prepaid credit balance as everything else. Includes the Nurture pipeline, all automated emails, Hot-lead detection and the Daily Action Queue. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  },
  {
   "@type": "Offer",
   "name": "Rentals Module",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits per 30-day period, taken from your prepaid credit balance, bought in advance at 1.00 EUR per credit and less in larger packs. Free 30-day trial with no charge until you renew. Includes the Tenants pipeline, Tenancies, Maintenance and renewal email reminders."
  },
  {
   "@type": "Offer",
   "name": "Website Builder",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits a month. Add-ons are separate monthly credit costs, for example pop-up lead capture at 8 and auto meta descriptions at 5. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  }
 ],
 "paymentAccepted": "Credits from a single prepaid balance",
 "termsOfService": "https://info.propertylist.es/docs/propertylist-mls-user-manual/credits/how-billing-works/"
};

---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/pricing/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/pricing/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/precios/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/pricing/' },
	]}
	schema={[pricingFaqLd, softwareAppLd]}
>
	<section class="hero">
		<div class="heroInner">
			<div class="badge">Transparent pricing</div>
			<h1>Free MLS + CRM. Pay only for upgrades.</h1>
			<p class="lead">
				PropertyList gives every estate agent and developer free access to list properties, collaborate with staff, and manage contacts - without
				subscriptions. When you want extra visibility or automation, use pay-as-you-go credits at your own pace.
			</p>
			<div class="ctaRow">
				<a class="btnPrimary" href="/docs/propertylist-mls-user-manual/">Start with the MLS manual</a>
				<a class="btnSecondary" href="/docs/">Browse documentation</a>
			</div>
			<div class="trustRow" aria-label="Key terms">
				<div class="trustPill">No tied contracts</div>
				<div class="trustPill">No setup fees</div>
				<div class="trustPill">No cancellation fees</div>
				<div class="trustPill">No hidden fees</div>
			</div>
		</div>
	</section>

	<section aria-label="Pricing by audience" style="max-width:1120px;margin:6px auto 0;padding:0 20px;">
		<div style="display:flex;gap:12px;flex-wrap:wrap;">
			<a href="#agents" style="flex:1 1 200px;display:block;background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:16px 18px;text-decoration:none;color:inherit;"><span style="font-size:20px;">🏠</span><span style="display:block;font-weight:800;font-size:15.5px;margin-top:6px;color:#0b1220;">Estate agents</span><span style="display:block;font-size:13px;color:rgba(16,24,40,0.62);margin-top:3px;line-height:1.45;">Free MLS + CRM forever. Credits only for optional upgrades.</span></a>
			<a href="#developers" style="flex:1 1 200px;display:block;background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:16px 18px;text-decoration:none;color:inherit;"><span style="font-size:20px;">🏗️</span><span style="display:block;font-weight:800;font-size:15.5px;margin-top:6px;color:#0b1220;">Developers</span><span style="display:block;font-size:13px;color:rgba(16,24,40,0.62);margin-top:3px;line-height:1.45;">No subscription. You set the commission, paid only on real sales.</span></a>
			<a href="#buyers" style="flex:1 1 200px;display:block;background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:16px 18px;text-decoration:none;color:inherit;"><span style="font-size:20px;">🔑</span><span style="display:block;font-weight:800;font-size:15.5px;margin-top:6px;color:#0b1220;">Buyers & sellers</span><span style="display:block;font-size:13px;color:rgba(16,24,40,0.62);margin-top:3px;line-height:1.45;">Searching, AI search and enquiries are free. No account needed.</span></a>
			<a href="#services" style="flex:1 1 200px;display:block;background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:16px 18px;text-decoration:none;color:inherit;"><span style="font-size:20px;">🧰</span><span style="display:block;font-weight:800;font-size:15.5px;margin-top:6px;color:#0b1220;">Property services</span><span style="display:block;font-size:13px;color:rgba(16,24,40,0.62);margin-top:3px;line-height:1.45;">Coming soon - one place for the trades around every move.</span></a>
		</div>
	</section>

	<section class="section" id="agents">
		<div class="twoCol">
			<div class="panel">
				<h2>Why the MLS is free</h2>
				<p>
					Every estate agent and developer can use the platform free. Agents list without upfront costs, and people searching see more of what is
					actually for sale.
				</p>
				<p>
					We keep the essentials free and make money only on optional tools you switch on yourself.
					<a href="/free/">Here is everything that is free</a>, in one list.
				</p>
				<figure class="panelMock">
					<img src="/img/mls-preview-en.jpg" alt="Live property listings on the PropertyList public portal - villas and apartments for sale in Marbella" loading="lazy" width="980" height="700" />
					<figcaption>The MLS as buyers see it - live listings on <a href="https://propertylist.es/en/portal/for-sale/marbella" target="_blank" rel="noopener">propertylist.es</a> right now.</figcaption>
				</figure>
				<figure class="panelMock">
					<img src="/img/crm-dashboard.jpg" alt="The PropertyList CRM dashboard: pipelines for leads, buyers, sellers and properties, AI Property Match, agenda and credit balance" loading="lazy" width="1600" height="792" />
					<figcaption>...and the CRM agents work in - pipelines, AI Property Match, agenda and leads.</figcaption>
				</figure>
			</div>
			<div class="panel">
				<h2>Credits: one balance for everything</h2>
				<p>
					Everything paid on PropertyList draws from a single balance of credits - monthly subscriptions like your website,
					and pay-as-you-go extras like market reports. Buy packs when you like; bigger packs are better value. Prices in
					euro, VAT added at checkout.
				</p>
				<div class="creditPacks">
					<div class="creditPackRow creditPackHead"><span>You pay</span><span>You get</span><span>Works out at</span></div>
					<div class="creditPackRow"><span>€20</span><span>20 credits</span><span>€1.00 / credit</span></div>
					<div class="creditPackRow"><span>€47</span><span>50 credits</span><span>€0.94 / credit</span></div>
					<div class="creditPackRow"><span>€90</span><span>100 credits</span><span>€0.90 / credit</span></div>
					<div class="creditPackRow"><span>€425</span><span>500 credits</span><span>€0.85 / credit</span></div>
					<div class="creditPackRow"><span>€800</span><span>1,000 credits</span><span>€0.80 / credit</span></div>
				</div>
				<div class="callout">
					<div class="calloutTitle">Credits you buy never expire</div>
					<div class="calloutBody">They stay in your balance until you use them. If a renewal ever catches you short, your site pauses safely as a draft - nothing is lost, and one click republishes it.</div>
				</div>
				<div class="callout muted">
					<div class="calloutTitle">Verified Agency bonus</div>
					<div class="calloutBody">Each Verified Agency receives 20 free credits.</div>
				</div>
				<div class="callout muted">
					<div class="calloutTitle">New: Auto-Renew</div>
					<div class="calloutBody">Save a card and we top your balance up automatically before each renewal, by the monthly cost of your active subscriptions, so nothing goes offline. It is a way to pay, not an extra charge.</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Paid extras (all features)</h2>
			<div class="sectionMeta">Pay-as-you-go, at your own pace.</div>
		</div>
		<div class="grid">
			{sections.map((s) => (
				<section class="pricingCard">
					<div class="pricingHead">
						<div class="pricingTitle">{s.title}</div>
						<div class="pricingSubtitle">{s.subtitle}</div>
					</div>
					<ul class="pricingList">
						{s.items.map((it) => (
							<li class="pricingRow">
								<span class="pricingFeature">{it.feature}</span>
								<span class={`pricingPrice ${it.price.toLowerCase().includes('free') ? 'isFree' : ''}`}>{it.price}</span>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Website Builder</h2>
			<div class="sectionMeta">50 credits/month · No tied contracts</div>
		</div>
		<div class="wbPricing">
			<div class="wbBase">
				<div class="wbBaseBadge">Base plan</div>
				<div class="wbBasePrice">50 credits<span>/mo</span></div>
				<div class="wbBaseNote">about €50 - cancel anytime</div>
				<ul class="wbBaseList">
					<li>Drag-and-drop page builder</li>
					<li>All MLS properties auto-loaded</li>
					<li>Your own agency branding</li>
					<li>Mobile-friendly layouts</li>
					<li>Contact forms &amp; lead capture</li>
					<li>Google Analytics integration</li>
					<li>Free hosting &amp; SSL</li>
					<li>Build &amp; preview before you pay</li>
				</ul>
				<a class="btnPrimary" href="/website-builder/">See how it works</a>
			</div>
			<div class="wbAddons">
				<div class="wbAddonsTitle">Power-ups - add as you grow</div>
				<div class="wbAddonsNote">Billed monthly. Cancel anytime.</div>
				<div class="wbAddonGrid">
					<div class="wbAddonCard">
						<div class="wbAddonName">Instant Content</div>
						<div class="wbAddonDesc">Unlimited AI blog posts and area guides - fully automated with auto-publish, or review each piece first</div>
						<div class="wbAddonPrice">30 credits<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">AI keyword &amp; meta</div>
						<div class="wbAddonDesc">Auto-writes SEO titles and descriptions for every listing</div>
						<div class="wbAddonPrice">5 credits<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">Monthly analytics digest</div>
						<div class="wbAddonDesc">A monthly email of your website analytics - page views, top-viewed properties and more</div>
						<div class="wbAddonPrice">5 credits<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">Popup lead capture</div>
						<div class="wbAddonDesc">Smart exit-intent and scroll popups on your site</div>
						<div class="wbAddonPrice">8 credits<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">AI FAQ auto-generator</div>
						<div class="wbAddonDesc">Generates buyer Q&amp;A for each listing automatically</div>
						<div class="wbAddonPrice">8 credits<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">Custom domain</div>
						<div class="wbAddonDesc">Connect your own domain (your-agency.com)</div>
						<div class="wbAddonPrice">20 credits<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">Extra pages</div>
						<div class="wbAddonDesc">Landings, area guides, promos - beyond the pages included in the base</div>
						<div class="wbAddonPrice">10 credits<span>/mo each</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">Remove PropertyList branding</div>
						<div class="wbAddonDesc">A clean site with no "Powered by" mark</div>
						<div class="wbAddonPrice">50 credits<span>/mo</span></div>
					</div>
				</div>
				<div class="wbAddonsFooter">More add-ons released regularly - AI tools, integrations, area pages</div>
			</div>
		</div>
	</section>

	<section class="section" id="developers">
		<div class="sectionHeader"><h2>For developers</h2></div>
		<div style="background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:16px;padding:22px 24px;">
