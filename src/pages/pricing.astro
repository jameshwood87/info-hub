---
import Layout from '../layouts/Layout.astro';

const title = 'Pricing • PropertyList Info Hub';
const description =
	'The MLS and CRM are free forever for estate agents. Use optional pay-as-you-go credits for featured listings and add-ons, only when you need them.';

const sections: Array<{
	title: string;
	subtitle: string;
	items: Array<{ feature: string; price: string; note?: string }>;
}> = [
	{
		title: 'MLS',
		subtitle: 'Multi-Listing Service',
		items: [
			{ feature: 'Unlimited Listings', price: 'Free' },
			{ feature: 'Users/Staff', price: 'Free' },
			{ feature: 'Branded MicroSite', price: 'Free' },
			{ feature: 'Feature a Listing', price: 'from €10' },
			{ feature: 'Property Alerts', price: 'Free' },
			{ feature: 'LeadBoard', price: 'Coming soon' },
			{ feature: 'XML Import', price: 'Free' },
			{ feature: 'XML Export', price: '35 credits / month or €350 per year' },
			{ feature: 'Private Listings', price: 'Coming soon' },
		],
	},
	{
		title: 'CRM',
		subtitle: 'Client Relationship Management',
		items: [
			{ feature: 'Unlimited Contacts', price: 'Free' },
			{ feature: 'Calendar Events', price: 'Free' },
			{ feature: 'Sales Pipeline', price: 'Free' },
			{ feature: 'Document Upload', price: 'Free' },
			{ feature: 'AI Utilities', price: 'Coming soon' },
			{ feature: 'AI Funnels', price: 'Coming soon' },
			{ feature: 'AI Chatbot', price: 'Coming soon' },
			{ feature: 'AI Market Analysis', price: '5 credits per analysis (limited time offer)' },
		],
	},
	{
		title: 'Public Portal',
		subtitle: 'We advertise for you',
		items: [
				{ feature: 'Feature a Listing', price: 'from €10' },
			{ feature: 'Open a Direct Lead', price: 'Free for limited time' },
			{ feature: 'Featured Estate Agents', price: 'Coming soon' },
			{ feature: 'AI Virtual Tours', price: 'Coming soon' },
			{ feature: 'Premium Homepage', price: 'Coming soon' },
			{ feature: 'Property Services', price: 'Coming soon' },
		],
	},
	{
		title: 'Website Builder',
		subtitle: 'Your own agency website',
		items: [
			{ feature: 'Drag-and-drop builder', price: 'from €50/mo' },
			{ feature: 'AI SEO & meta', price: '+€5/mo' },
			{ feature: 'Popup lead capture', price: '+€8/mo' },
			{ feature: 'Custom domain', price: '+€20/mo' },
			{ feature: 'All MLS listings auto-loaded', price: 'Included' },
			{ feature: 'Free hosting & SSL', price: 'Included' },
		],
	},
];

const pricingFaqItems = [
	{
		q: 'Is PropertyList really free for estate agents?',
		a: 'Yes. The MLS, CRM, unlimited listings, team accounts, and contact management are 100% free forever. You only pay for optional upgrades such as featured listings (from €10) or the Website Builder (from €50/mo).',
	},
	{
		q: 'How do credits work?',
		a: '1 credit = €1. Bulk purchases include discounts and credits never expire. Use credits to feature listings, run XML exports, access AI Market Analysis, or unlock other premium features.',
	},
	{
		q: 'Can I cancel my website builder subscription anytime?',
		a: 'Yes. There are no tied contracts and no cancellation fees. Cancel monthly or yearly at any time with no penalties.',
	},
	{
		q: 'What do I get with the free plan?',
		a: 'Unlimited property listings, unlimited staff accounts, a branded MicroSite for your agency, full CRM with contacts and leads management, calendar events, sales pipeline, document upload, WhatsApp Community access, and social distribution to Facebook — all free.',
	},
	{
		q: 'How much does the Website Builder cost?',
		a: 'From €50/month (or €450/year). Add optional power-ups: AI SEO meta (+€5/mo), popup lead capture (+€8/mo), custom domain (+€20/mo). All plans include free hosting, SSL, and automatic MLS listing loading.',
	},
	{
		q: 'Is there a free trial for paid features?',
		a: 'Open a Direct Lead is currently free for a limited time — no credits required. Featured listings start from €10 per listing. New Verified Agencies also receive 20 free credits on signup.',
	},
];

const pricingFaqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: pricingFaqItems.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/pricing/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/pricing/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/pricing/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/pricing/' },
	]}
	schema={pricingFaqLd}
>
	<section class="hero">
		<div class="heroInner">
			<div class="badge">Transparent pricing</div>
			<h1>Free MLS + CRM. Pay only for upgrades.</h1>
			<p class="lead">
				PropertyList gives every estate agent and developer free access to list properties, collaborate with staff, and manage contacts - without
				subscriptions. When you want extra visibility or automation, use pay-as-you-go credits at your own pace.
			</p>
			<div class="ctaRow">
				<a class="btnPrimary" href="/mls/">Start with the MLS manual</a>
				<a class="btnSecondary" href="/docs/">Browse documentation</a>
			</div>
			<div class="trustRow" aria-label="Key terms">
				<div class="trustPill">No tied contracts</div>
				<div class="trustPill">No setup fees</div>
				<div class="trustPill">No cancellation fees</div>
				<div class="trustPill">No hidden fees</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="twoCol">
			<div class="panel">
				<h2>Why the MLS is free</h2>
				<p>
					At PropertyList, we empower all real estate agents and developers by providing free access to our platform. This lets agents showcase their
					properties without any upfront costs, offering property seekers a wide range of choice.
				</p>
				<p>
					We believe in an inclusive marketplace where every agent and listing can shine - so we keep the essentials free and make money only on
					optional, value-added tools.
				</p>
			</div>
			<div class="panel">
				<h2>Credits &amp; pay-as-you-go</h2>
				<p>
					Our credit system gives maximum flexibility to feature properties and access additional services. It scales from solo
					agents to large agencies, so you only pay for what you use—when you actually need it.
				</p>
				<div class="callout">
					<div class="calloutTitle">1 credit = €1</div>
					<div class="calloutBody">Bulk purchases include discounts. Credits do not expire.</div>
				</div>
				<div class="callout muted">
					<div class="calloutTitle">Verified Agency bonus</div>
					<div class="calloutBody">Each new Verified Agency receives 20 free credits.</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Website Builder</h2>
			<div class="sectionMeta">From €50/month · No tied contracts</div>
		</div>
		<div class="wbPricing">
			<div class="wbBase">
				<div class="wbBaseBadge">Base plan</div>
				<div class="wbBasePrice">€50<span>/mo</span></div>
				<div class="wbBaseNote">or €450/year &mdash; cancel anytime</div>
				<ul class="wbBaseList">
					<li>Drag-and-drop page builder</li>
					<li>All MLS properties auto-loaded</li>
					<li>Your own agency branding</li>
					<li>Mobile-friendly layouts</li>
					<li>Contact forms &amp; lead capture</li>
					<li>Google Analytics integration</li>
					<li>Free hosting &amp; SSL</li>
					<li>Build &amp; preview before you pay</li>
				</ul>
				<a class="btnPrimary" href="/website-builder">See how it works</a>
			</div>
			<div class="wbAddons">
				<div class="wbAddonsTitle">Power-ups &mdash; add as you grow</div>
				<div class="wbAddonsNote">Billed monthly. Cancel anytime.</div>
				<div class="wbAddonGrid">
					<div class="wbAddonCard">
						<div class="wbAddonName">AI keyword &amp; meta</div>
						<div class="wbAddonDesc">Auto-writes SEO titles and descriptions for every listing</div>
						<div class="wbAddonPrice">€5<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">Monthly property digest</div>
						<div class="wbAddonDesc">AI-powered email of new listings to your database</div>
						<div class="wbAddonPrice">€5<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">Popup lead capture</div>
						<div class="wbAddonDesc">Smart exit-intent and scroll popups on your site</div>
						<div class="wbAddonPrice">€8<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">AI FAQ auto-generator</div>
						<div class="wbAddonDesc">Generates buyer Q&amp;A for each listing automatically</div>
						<div class="wbAddonPrice">€8<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">Custom domain</div>
						<div class="wbAddonDesc">Connect your own domain (your-agency.com)</div>
						<div class="wbAddonPrice">€20<span>/mo</span></div>
					</div>
					<div class="wbAddonCard">
						<div class="wbAddonName">Extra pages</div>
						<div class="wbAddonDesc">Landings, area guides, promos &mdash; pay per page</div>
						<div class="wbAddonPrice">from €2<span>/page</span></div>
					</div>
				</div>
				<div class="wbAddonsFooter">More add-ons released regularly &mdash; AI tools, integrations, area pages</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Paid extras (all features)</h2>
			<div class="sectionMeta">Pay-as-you-go, at your own pace.</div>
		</div>
		<div class="grid">
			{sections.map((s) => (
				<section class="pricingCard">
					<div class="pricingHead">
						<div class="pricingTitle">{s.title}</div>
						<div class="pricingSubtitle">{s.subtitle}</div>
					</div>
					<ul class="pricingList">
						{s.items.map((it) => (
							<li class="pricingRow">
								<span class="pricingFeature">{it.feature}</span>
								<span class={`pricingPrice ${it.price.toLowerCase().includes('free') ? 'isFree' : ''}`}>{it.price}</span>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Frequently asked questions</h2>
			<p class="faqSub">See every feature explained in detail — website builder, XML feeds, CRM pipelines, Rentals, Market Intelligence, and more — on the <a href="/features/">Features FAQ page</a>.</p>
		</div>
		<div class="faqGrid">
			{pricingFaqItems.map((f) => (
				<div class="faqCard">
					<div class="faqQ">{f.q}</div>
					<div class="faqA">{f.a}</div>
				</div>
			))}
		</div>
	</section>
</Layout>

<style>
	.hero {
		background: radial-gradient(1200px 600px at 30% -10%, rgba(0, 174, 154, 0.18), rgba(255, 255, 255, 0));
		border-radius: 22px;
		padding: 18px;
		margin-bottom: 14px;
		border: 1px solid rgba(16, 24, 40, 0.08);
	}

	.heroInner {
		background: rgba(255, 255, 255, 0.75);
		border-radius: 18px;
		padding: 18px;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 800;
		font-size: 12px;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	h1 {
		margin: 10px 0 10px;
		letter-spacing: -0.04em;
		line-height: 1.06;
	}

	h2 {
		margin: 0 0 10px;
		letter-spacing: -0.02em;
	}

	.lead {
		margin: 0;
		color: rgba(16, 24, 40, 0.78);
		font-size: 16px;
		line-height: 1.55;
	}

	.section {
		margin: 14px 0;
	}

	.sectionHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		margin: 0 0 10px;
		flex-wrap: wrap;
	}

	.sectionMeta {
		color: rgba(16, 24, 40, 0.7);
		font-size: 14px;
		white-space: nowrap;
	}

	.ctaRow {
		margin-top: 14px;
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.ctaRow.compact {
		margin-top: 10px;
	}

	.btnPrimary,
	.btnSecondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		border-radius: 999px;
		padding: 10px 14px;
		text-decoration: none;
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.btnPrimary {
		background: #00ae9a;
		color: #00100e;
		border: 1px solid rgba(0, 0, 0, 0.12);
	}

	.btnPrimary:hover {
		filter: brightness(0.98);
		text-decoration: none;
	}

	.btnSecondary {
		background: rgba(255, 255, 255, 0.85);
		color: rgba(16, 24, 40, 0.9);
		border: 1px solid rgba(16, 24, 40, 0.12);
	}

	.btnSecondary:hover {
		text-decoration: none;
		border-color: rgba(0, 174, 154, 0.35);
	}

	.trustRow {
		margin-top: 12px;
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.trustPill {
		font-size: 13px;
		color: rgba(16, 24, 40, 0.78);
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		padding: 6px 10px;
		border-radius: 999px;
	}

	.twoCol {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.panel {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.panel p {
		margin: 0 0 10px;
		color: rgba(16, 24, 40, 0.78);
		line-height: 1.55;
	}

	.panel p:last-child {
		margin-bottom: 0;
	}

	.callout {
		margin-top: 12px;
		border-radius: 14px;
		padding: 12px 12px;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.22);
	}

	.callout.muted {
		background: rgba(255, 255, 255, 0.75);
		border: 1px solid rgba(16, 24, 40, 0.12);
	}

	.calloutTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
	}

	.calloutBody {
		margin-top: 6px;
		color: rgba(16, 24, 40, 0.76);
		line-height: 1.5;
		font-size: 14px;
	}

	.card {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.cardLead {
		margin: 0 0 10px;
		color: rgba(16, 24, 40, 0.78);
		line-height: 1.55;
	}

	.cardLead:last-child {
		margin-bottom: 0;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.pricingCard {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.pricingHead {
		margin-bottom: 10px;
	}

	.pricingTitle {
		font-weight: 900;
		letter-spacing: -0.02em;
		font-size: 16px;
	}

	.pricingSubtitle {
		margin-top: 4px;
		color: rgba(16, 24, 40, 0.7);
		font-size: 13px;
	}

	.pricingList {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 10px;
	}

	.pricingRow {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: start;
		gap: 10px;
		padding: 10px 12px;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 14px;
	}

	.pricingFeature {
		color: rgba(16, 24, 40, 0.88);
		line-height: 1.35;
		min-width: 0;
	}

	.pricingPrice {
		font-weight: 900;
		letter-spacing: -0.01em;
		color: rgba(16, 24, 40, 0.86);
		text-align: right;
		white-space: normal;
		max-width: 22ch;
	}

	.pricingPrice.isFree {
		color: rgba(0, 142, 126, 1);
	}

	@media (max-width: 980px) {
		.grid {
			grid-template-columns: 1fr;
		}

		.twoCol {
			grid-template-columns: 1fr;
		}
	}

	.wbPricing {
		display: grid;
		grid-template-columns: 300px 1fr;
		gap: 14px;
		align-items: start;
		overflow: hidden;
	}

	.wbBase {
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(16, 24, 40, 0.1);
		border-radius: 20px;
		padding: 20px;
		display: flex;
		flex-direction: column;
	}

	.wbBaseBadge {
		display: inline-block;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.25);
		color: rgba(0, 142, 126, 1);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 4px 10px;
		border-radius: 999px;
		margin-bottom: 12px;
		align-self: flex-start;
	}

	.wbBasePrice {
		font-size: 32px;
		font-weight: 900;
		letter-spacing: -0.03em;
		color: #00100e;
		line-height: 1;
	}

	.wbBasePrice span {
		font-size: 18px;
		font-weight: 700;
		color: rgba(16, 24, 40, 0.6);
	}

	.wbBaseNote {
		font-size: 13px;
		color: rgba(16, 24, 40, 0.6);
		margin-top: 4px;
		margin-bottom: 16px;
	}

	.wbBaseList {
		list-style: none;
		padding: 0;
		margin: 0 0 18px;
		display: grid;
		gap: 8px;
	}

	.wbBaseList li {
		font-size: 14px;
		color: rgba(16, 24, 40, 0.82);
		padding: 6px 0;
		border-bottom: 1px solid rgba(16, 24, 40, 0.06);
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.wbBaseList li::before {
		content: "✓";
		color: #00ae9a;
		font-weight: 700;
		font-size: 12px;
		flex-shrink: 0;
	}

	.wbAddons {
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(16, 24, 40, 0.1);
		border-radius: 20px;
		padding: 20px;
	}

	.wbAddonsTitle {
		font-size: 15px;
		font-weight: 800;
		letter-spacing: -0.01em;
		color: rgba(16, 24, 40, 0.88);
		margin-bottom: 4px;
	}

	.wbAddonsNote {
		font-size: 12px;
		color: rgba(16, 24, 40, 0.55);
		margin-bottom: 16px;
	}

	.wbAddonGrid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 10px;
		margin-bottom: 14px;
	}

	.wbAddonCard {
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 14px;
		padding: 14px;
	}

	.wbAddonName {
		font-size: 13px;
		font-weight: 800;
		color: rgba(16, 24, 40, 0.88);
		margin-bottom: 4px;
	}

	.wbAddonDesc {
		font-size: 11px;
		color: rgba(16, 24, 40, 0.6);
		line-height: 1.45;
		margin-bottom: 10px;
	}

	.wbAddonPrice {
		font-size: 16px;
		font-weight: 900;
		letter-spacing: -0.02em;
		color: #00ae9a;
	}

	.wbAddonPrice span {
		font-size: 11px;
		font-weight: 700;
		color: rgba(16, 24, 40, 0.5);
	}

	.wbAddonsFooter {
		font-size: 12px;
		color: rgba(16, 24, 40, 0.5);
		text-align: center;
		padding-top: 10px;
		border-top: 1px solid rgba(16, 24, 40, 0.06);
	}

	.faqGrid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.faqCard {
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 16px;
	}

	.faqQ {
		font-weight: 900;
		color: rgba(16, 24, 40, 0.9);
		font-size: 14px;
		letter-spacing: -0.01em;
		margin-bottom: 8px;
		line-height: 1.35;
	}

	.faqA {
		font-size: 13px;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.55;
	}

	.faqSub {
		font-size: 13px;
		color: rgba(16, 24, 40, 0.6);
		margin: -6px 0 12px;
		line-height: 1.5;
	}

	.faqSub a {
		color: #00ae9a;
		text-decoration: underline;
	}

	@media (max-width: 900px) {
		.wbPricing {
			grid-template-columns: 1fr;
		}
		.wbAddonGrid {
			grid-template-columns: repeat(2, 1fr);
		}
		.faqGrid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 580px) {
		.wbAddonGrid {
			grid-template-columns: 1fr;
		}
		.wbBasePrice {
			font-size: 28px;
