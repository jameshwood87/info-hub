<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
--teal:#00ae9a;--teal-dark:#008f7f;--teal-light:#f0fdfa;--teal-border:#99f6e4;
--slate:#0d2b2e;--slate-mid:#1a3f43;
--grey-dark:#111827;--grey-mid:#374151;--grey-light:#6b7280;--grey-xlight:#9ca3af;
--grey-bg:#f5f6f8;--white:#ffffff;
--amber-bg:#fef3c7;--amber-border:#fde68a;--amber-text:#78350f;
--font-sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
--font-serif:'Playfair Display',Georgia,serif
}
html{scroll-behavior:smooth}
body{font-family:var(--font-sans);background:var(--grey-bg);color:var(--grey-dark);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:var(--teal);text-decoration:none}
a:hover{text-decoration:underline}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
.wrap--narrow{max-width:740px;margin:0 auto;padding:0 24px}
.eyebrow{font-size:11px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--teal);margin-bottom:10px}
.eyebrow--on-dark{color:rgba(255,255,255,0.65)}
h1,h2,h3{font-family:var(--font-serif);color:var(--slate);line-height:1.15}
.btn{display:inline-block;font-family:var(--font-sans);font-size:15px;font-weight:700;padding:14px 28px;border-radius:9px;border:none;cursor:pointer;transition:all .2s;text-decoration:none}
.btn-primary{background:var(--teal);color:var(--white);box-shadow:0 4px 14px rgba(0,174,154,.3)}
.btn-primary:hover{background:var(--teal-dark);box-shadow:0 6px 20px rgba(0,174,154,.4);text-decoration:none;transform:translateY(-1px)}
.btn-large{font-size:16px;padding:16px 36px;border-radius:10px}
.btn-on-dark{background:var(--white);color:var(--teal)}
.btn-on-dark:hover{background:#f0fffe;text-decoration:none}
.wb-nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.95);backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid #e5ecec}
.wb-nav-inner{max-width:1200px;margin:0 auto;width:100%;display:flex;align-items:center;justify-content:space-between;padding:0 24px}
.wb-nav-logo img{height:48px;width:auto}
.wb-nav-actions{display:flex;align-items:center;gap:10px}
.wb-nav-link{color:#0d2b2e;font-weight:600;font-size:14px;padding:6px 10px;border-radius:6px;transition:all .15s}
.wb-nav-link:hover{color:#00ae9a;text-decoration:none}
.wb-nav-cta{background:#00ae9a;color:#fff;padding:9px 18px;border-radius:8px;font-size:14px;font-weight:700;transition:all .15s}
.wb-nav-cta:hover{background:#008f7e;text-decoration:none}
.wb-nav-hamburger{display:none;background:none;border:none;cursor:pointer;padding:8px;flex-direction:column;gap:5px;z-index:200}
.wb-nav-hamburger span{display:block;width:22px;height:2px;background:#0d2b2e;border-radius:2px;transition:all .25s}
.wb-nav-hamburger.active span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.wb-nav-hamburger.active span:nth-child(2){opacity:0}
.wb-nav-hamburger.active span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.wb-nav-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(13,43,46,.97);z-index:99;flex-direction:column;align-items:center;justify-content:center;gap:20px;font-size:20px}
.wb-nav-overlay.open{display:flex}
.wb-nav-overlay a{color:#fff;opacity:.85;padding:8px 16px}
.wb-nav-overlay a:hover{opacity:1;text-decoration:none}
.wb-nav-logo-overlay{opacity:.9}
.hero{background:linear-gradient(135deg,var(--teal) 0%,#0fcab1 50%,var(--teal) 100%);padding:72px 0 80px}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.hero-badge{display:inline-block;padding:5px 14px;background:rgba(255,255,255,.18);color:var(--white);font-size:11px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;border-radius:999px;margin-bottom:20px}
.hero h1{font-size:42px;font-weight:700;color:var(--white);margin-bottom:16px;line-height:1.1;letter-spacing:-1px}
