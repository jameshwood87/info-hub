{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does the 30-day free trial work?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sign into PropertyList, go to Tenants in the left nav, and click Start free trial. No credit card is required. After 30 days you can activate the module for 50 credits (~EUR50) per 30-day period -- or stop using it and nothing changes. We never auto-charge." }
    },
    {
      "@type": "Question",
      "name": "Does this replace my property management software?",
      "acceptedAnswer": { "@type": "Answer", "text": "It is designed to replace the scattered WhatsApp-based workflow. It gives you a shared ledger, audit log, and maintenance workflow that any agent on your team can access -- replacing the sticky-note system and the shared WhatsApp thread with something defensible and searchable." }
    },
    {
      "@type": "Question",
      "name": "What happens to my deposit dispute evidence if I stop using PropertyList?",
      "acceptedAnswer": { "@type": "Answer", "text": "Everything you have logged stays in your account. The audit trail is yours -- timestamped entries, agent names, deposit return records. You can export it at any time. Even if you cancel the module, the underlying contact and property records remain." }
    },
    {
      "@type": "Question",
      "name": "Is the maintenance workflow required, or can I just track tenancies?",
      "acceptedAnswer": { "@type": "Answer", "text": "You choose what you use. Start with the tenancies ledger and renewal emails, add maintenance when you need it. There is no minimum feature set. The landlord portfolio view shows only the modules you have active." }
    },
    {
      "@type": "Question",
      "name": "Who gets the renewal emails -- the tenant or the agent?",
      "acceptedAnswer": { "@type": "Answer", "text": "The agent who owns the tenant contact receives the email. It is sent automatically 30 days before the lease ends, in the agent's language. The tenant does not receive an automated email unless you configure it separately. The system is designed to remind your team, not to contact tenants on your behalf." }
    },
    {
      "@type": "Question",
      "name": "Does this comply with Spanish rental law -- RDL 8/2024 and the LAU?",
      "acceptedAnswer": { "@type": "Answer", "text": "PropertyList stores the records you need to comply. The tenancy ledger holds start and end dates, rent amounts, and deposit status -- information you are required to maintain under the Ley de Arrendamientos Urbanos (LAU). The audit log supports the evidence requirements that come with deposit disputes and renewal notices. We do not provide legal advice; your agency remains responsible for compliance with applicable regulations." }
    }
  ]
}
</script>
