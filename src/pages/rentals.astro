---
import Layout from '../layouts/Layout.astro';

// /rentals/ rebuilt 09-10-26 (James: "should we fix the rental page also?" then "deploy"). Same substance as the live
// page, new shape: layer cake, detail behind taps, plan card. The law block and every FAQ answer are kept word for word
// from the page checked against the BOE on 08-10-26 (RDL 29/2026). Price: 50 credits per 30 days, 30 days free, and
// rental leads come with the module with no per-lead charge (James 09-10-26).
const origin = 'https://info.propertylist.es';
const canonical = `${origin}/rentals/`;
const title = 'Rentals Management Module for Estate Agents | PropertyList';
const description =
	'Long-term lettings inside your CRM: tenants pipeline, tenancies that update themselves, renewals, rent review, repairs and deposit tracking. 30 days free.';
const signup = 'https://agents.propertylist.es/new_agency/new?locale=en';

const waysIn = [
	['Import CSV.', 'A button at the top of the Tenancies screen, not a buried setting. Bring a whole rental book over in one go.'],
	['From the deal.', 'A rental deal that reaches Contract Signed writes its own tenancy: property, tenant, landlord, dates, rent and deposit. You fill the gaps.'],
	['By hand.', 'New Tenancy, for the agreements that live nowhere else yet.'],
];

const stages = ['Rental Lead', 'Qualified, criteria defined', 'Matching properties', 'Viewings booked', 'Viewings in progress', 'Negotiating', 'Reservation paid', 'Contract review', 'Contract signed', 'Deposit paid', 'Awaiting move-in', 'Active tenancy', 'Renewal pending'];
const keyStages = [9, 12];

const features = [
	{ name: 'Tenants pipeline', line: 'Thirteen stages, enquiry to active tenancy.', desc: 'Thirteen stages from first enquiry to active tenancy, on its own board, beside the sales pipeline you already run.' },
	{ name: 'Tenancies that keep themselves current', line: 'Draft, Active, Expiring, without you moving it.', desc: 'One record per lease. Draft, then Active when the start date passes, then Expiring when the renewal window opens. You do not move it.' },
	{ name: 'Your existing book, imported', line: 'CSV for the whole book, by hand for one-offs.', desc: 'CSV import for a whole rental book, a manual option for one-offs, and new deals create their own tenancy.' },
	{ name: 'Renewal alerts', line: 'Told before the lease ends, at 60, 90 or 120 days.', desc: 'The tenancy moves to Renewal Pending and tells you before the lease ends, on a window you set at 60, 90 or 120 days.' },
	{ name: 'Annual rent review', line: 'The permitted new rent, and the notice drafted.', desc: 'It knows the anniversary and the current rent, works out the permitted new rent against the official index, and drafts the notice.' },
	{ name: 'Deposit tracking and audit log', line: 'Every change timestamped against the agent responsible.', desc: 'Unpaid, Held, then Returned or partly withheld, every change timestamped against the agent responsible, with the lodging window watched where your region still requires it.' },
	{ name: 'Repairs the tenant starts', line: 'A magic link, photos, no login.', desc: 'Tenants raise their own tickets by magic link with photos, no login, already attached to their tenancy. You triage rather than transcribe.' },
	{ name: 'Landlord approval thresholds', line: 'Small jobs go ahead; big ones need one click.', desc: 'Small jobs go ahead. Anything above the threshold goes to the landlord with photos and quote, and they approve or decline in one click.' },
	{ name: 'Rentals dashboard', line: 'Rent roll, your income, deposits, actions needed.', desc: 'Live tenancies, expiring in 60 days, monthly rent roll, your monthly income as management commission at the rate set per tenancy, deposits and actions needed, plus your average days to resolve.' },
];

const lanes = [
	{ who: 'Tenant', steps: ['Opens the <b>magic link</b> sent at move-in and repeated in their emails. No login, no app.', 'Describes the problem and <b>adds photos</b>. A plumber quoting from two photos often saves a visit.', 'Confirms the repair at the end, which is what closes the ticket.'] },
	{ who: 'You', steps: ['The ticket arrives <b>already linked</b> to the tenancy, tenant and property. You triage it.', 'Record <b>who pays</b>: landlord, tenant, agency or split.'] },
	{ who: 'Landlord', steps: ['Nothing at all, if the cost is under the <b>approval threshold</b> you hold for them.', 'Above it, an email with the issue, the photos and the quote.', '<b>Approve or Decline</b> in one click, and the decision is on the record if it is ever disputed.'] },
];

const tiles = ['Live tenancies', 'Expiring in 60 days', 'Monthly rent roll', 'Your monthly income', 'Deposits', 'Actions needed'];

const included = [
	'The Tenants pipeline, thirteen stages',
	'Enquiries on your rental listings go straight into the Tenants pipeline, and you can add your own leads. No charge per lead',
	'Tenancies that update themselves',
	'CSV import of your existing book',
	'Renewal alerts and the annual rent review',
	'Deposit tracking with an audit log',
	'Repairs by magic link, with landlord approval thresholds',
	'The rentals dashboard',
];

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{ '@type': 'Question', name: 'Can I bring the tenancies I already manage into it?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Import CSV sits at the top of the Tenancies screen and brings an existing rental book over in one go. There is a manual option for one-off agreements, and any new rental deal creates its tenancy automatically when it reaches Contract Signed, pre-filled from the deal.' } },
		{ '@type': 'Question', name: 'What does the Rentals module include?', acceptedAnswer: { '@type': 'Answer', text: 'A Tenants pipeline of thirteen stages, tenancies that move through Draft, Active, Expiring and then Renewed, Periodic or Ended on their own, renewal alerts on a window you set, the annual rent review against the official index, deposit tracking with an audit log, maintenance tickets the tenant raises by magic link with landlord approval thresholds, and a dashboard of live tenancies, expiring contracts, rent roll, your monthly income, deposits and actions needed. It covers long-term lettings.' } },
		{ '@type': 'Question', name: 'How much does the Rentals module cost, and what happens after the trial?', acceptedAnswer: { '@type': 'Answer', text: 'The first 30 days are free and no card is needed. Nothing is charged when the trial ends. If you want to keep it you subscribe, and from then it is 50 credits per 30-day period taken from your prepaid credit balance. You can switch on auto top-up so a saved card refills the balance instead of the module pausing, and you can stop the subscription whenever you want.' } },
		{ '@type': 'Question', name: 'What happens to my tenancies if I stop paying for the module?', acceptedAnswer: { '@type': 'Answer', text: 'Nothing is deleted. The module is hidden until you subscribe again, and your tenancies, deposits and repair history are exactly where you left them when it comes back.' } },
		{ '@type': 'Question', name: 'Does it change anything on the sales side of my agency?', acceptedAnswer: { '@type': 'Answer', text: 'No. Same login, same contacts, same listings, same sales pipeline. The module adds a Rentals section with Tenancies and Maintenance, and the Tenants pipeline board.' } },
		{ '@type': 'Question', name: 'Do tenants and landlords need accounts?', acceptedAnswer: { '@type': 'Answer', text: 'No. Tenants report repairs through a magic link sent at move-in and repeated in their emails, with photos and no login. Landlords approve or decline a job above their threshold from an email, in one click.' } },
		{ '@type': 'Question', name: 'Does the Rentals module keep me compliant with Spanish rental law?', acceptedAnswer: { '@type': 'Answer', text: 'It gives you the evidence, not the compliance. The audit log timestamps every status and deposit change with the agent responsible, which is what a deposit dispute under LAU art. 36 turns on. It does not lodge deposits with a regional body or issue a rental registration number: those stay your obligation. It files nothing with the police either. Police guest registration (RD 933/2021) applies to lodging activities, and automatic guest registration is coming for holiday bookings only.' } },
		{ '@type': 'Question', name: 'Does it handle holiday lets?', acceptedAnswer: { '@type': 'Answer', text: 'Not today. Bookings, nightly rates, channel sync and guest registration with the police are on the roadmap, and the holiday page sets out what is coming and takes your name for it. If your book is holiday rather than long-term, this is not yet the tool for you. Seasonal contracts sit in between: talk to us before you move a temporada book across.' } },
	],
};
const breadcrumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
	{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
	{ '@type': 'ListItem', position: 2, name: 'Features', item: `${origin}/features/` },
	{ '@type': 'ListItem', position: 3, name: 'Rentals Module', item: canonical },
] };
---
<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	ogImage="https://info.propertylist.es/og/og-rentals.jpg"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/alquileres/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<section class="hero"><div class="cx">
		<p class="kicker">Rentals Module</p>
		<h1>Your rental book, <b>out of the spreadsheet.</b></h1>
		<p class="lead">Long-term lettings inside the CRM you already use for sales. <strong>One record per tenancy that chases its own renewals, and repairs the tenant reports, with the landlord approving anything above a threshold you set.</strong></p>
		<p class="ctaRow"><a class="btn" href={signup} target="_blank" rel="noopener">Start the free trial</a> <a class="btnLink" href="#pricing">What it costs</a></p>
		<p class="fric">Free for 30 days, no card, and nothing is charged when the trial ends. Already with PropertyList? Open the Rentals tab in your account.</p>
		<figure class="film">
			<video autoplay muted loop playsinline preload="auto" poster="/hero/rentals-anim-poster.jpg" aria-label="An illustration of a tenancy record raising its own tasks as its dates arrive">
				<source src="/hero/rentals-anim.mp4" type="video/mp4" />
			</video>
			<img class="still" src="/hero/rentals-anim-poster.jpg" alt="An illustration of a tenancy record with its rent update, notice window and fianza return dates" width="1280" height="640" loading="lazy" />
			<figcaption>An illustration of the tenancy record, not a recording of the CRM. The property is a real long-term let on the PropertyList MLS, and the dates are the real ones: the IRAV update, the four-month notice window under LAU art. 10 as it stood on 9 October 2026, and the month after the keys come back, after which an unreturned fianza earns interest under art. 36.</figcaption>
		</figure>
		<nav class="modes" aria-label="Which kind of letting">
			<a class="mode here" href="/rentals/" aria-current="page"><b>Long-term lettings</b><span>Live today. Free 30-day trial.</span></a>
			<a class="mode" href="/holiday-rentals/"><b>Holiday and short lets</b><span>Coming soon. The rules that already apply, and the waitlist.</span></a>
		</nav>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Start with the tenancies <b>you already manage.</b></h2>
		<p class="sub">Three ways in, and none of them is typing it all again.</p>
		<div class="steps">
			{waysIn.map(([h, p]) => (<div class="step"><h3>{h}</h3><p>{p}</p></div>))}
		</div>
		<p class="quiet">Nothing changes on the sales side. Same login, same contacts, same listings, same <a href="/pipelines/">sales pipeline</a>. The module adds a Rentals section with Tenancies and Maintenance, and the Tenants board.</p>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>From enquiry <b>to signed lease.</b></h2>
		<p class="sub">The Tenants pipeline, exactly as it ships. Thirteen stages, and two of them do work for you.</p>
		<ol class="stages" aria-label="The thirteen stages of the Tenants pipeline">
			{stages.map((s, i) => (<li class={keyStages.includes(i + 1) ? 'on' : ''}><span>{i + 1}</span>{s}</li>))}
		</ol>
		<div class="beats">
			<p><b>9. At Contract signed</b> the tenancy writes itself from the deal, and your listing is set to reserved. If the property belongs to another agency, they get an email asking them to update it, because PropertyList does not change another agency's listing. A lettings tool with no other agencies in it cannot do this at any price.</p>
			<p><b>12. At Active tenancy</b> you are asked for the dates, the tenant and landlord details and marketing consent, and both go into <a href="/nurture/">Nurture</a>.</p>
		</div>
	</div></section>

	<section class="band"><div class="cx">
		<h2>What is inside. <b>Open any line.</b></h2>
		<p class="sub">Nine things the module does, most of them without being asked. All of it is long-term lettings.</p>
		<div class="feats">
			{features.map((f) => (
				<details>
					<summary><span class="fName">{f.name}</span><span class="fLine">{f.line}</span></summary>
					<p>{f.desc}</p>
				</details>
			))}
		</div>
		<div class="states" aria-label="The life of a tenancy">
			<span>Draft</span><span>Active</span><span>Expiring</span><span class="end">Renewed, Periodic or Ended</span>
		</div>
		<p class="quiet">One record per lease, and its status follows the dates rather than waiting for someone to remember. A renewal chains to a new linked tenancy, so the history stays intact.</p>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>A repair, from the tenant's phone <b>to closed.</b></h2>
		<p class="sub">The part that eats a letting agent's week. Three parties, one thread.</p>
		<div class="lanes">
			{lanes.map((l) => (
				<div class="lane">
					<h3>{l.who}</h3>
					<ol>{l.steps.map((s) => <li set:html={s}></li>)}</ol>
				</div>
			))}
		</div>
		<p class="quiet">Urgent jobs, a leak or no water or anything electrical, go straight to the Daily Action Queue with an SLA timer. Anything sitting a week without an update surfaces like a stalled deal. The annual boiler revision and gas certificate raise their own ticket on the anniversary.</p>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Six numbers, <b>one screen.</b></h2>
		<p class="sub">The rentals dashboard, so you can answer a landlord without opening a spreadsheet.</p>
		<div class="tiles">
			{tiles.map((t) => <div>{t}</div>)}
		</div>
		<p class="quiet">Your monthly income is your management commission, at the rate set on each tenancy, so the rent roll and what it actually pays you sit side by side. Plus your average days to resolve a repair, and views for live, expiring, ended and all.</p>
	</div></section>

	<section class="band dark"><div class="cx">
		<h2>Built for Spanish <b>rental law.</b></h2>
		<p class="alt">The audit log timestamps every status and deposit change against the agent responsible, giving you defensible evidence for deposit disputes under LAU art. 36 and the deposit rules of your region.</p>
		<p class="alt">No more reconstructing who changed what, and when, after a dispute has already started.</p>
		<p class="lawNote">Two deadlines the module records but does not decide for you. To stop a contract renewing once its minimum term is over, LAU art. 10 gives the landlord four months and the tenant two; from 15 November 2026, if it is validated, RDL 28/2026 would raise the landlord's notice to six months and, in most cases, oblige the landlord to compensate the tenant for not renewing, with transitional rules for contracts already running (those with under six months left on that date keep four months). And since 24 January 2026 the Junta de Andaluc&iacute;a no longer takes in fianzas (Ley 5/2025, DA 6&ordf;), so an Andalusian landlord keeps the deposit. Lodging still applies in Catalonia, Madrid and Valencia. Deposits lodged in Andalusia before that date are returned by the Junta as those contracts end, on request. <a href="/docs/laws-procedures/renting-a-property/long-term/tenancy-agreements/">The rules in full</a>.</p>
	</div></section>

	<section class="band tint" id="pricing"><div class="cx costGrid">
		<div class="plan">
			<p class="planName">Rentals Module</p>
			<p class="planPrice">50 credits</p>
			<p class="planNote">per 30-day period, from your prepaid credit balance. The first 30 days are free and no card is needed.</p>
			<ul class="checks">
				{included.map((i) => <li>{i}</li>)}
			</ul>
			<a class="btn" href={signup} target="_blank" rel="noopener">Start the free trial</a>
		</div>
		<div>
			<h2>What it <b>costs.</b></h2>
			<p class="sub">Nothing is charged when the trial ends. If you keep it, switch on auto top-up and a saved card refills your balance rather than the module pausing.</p>
			<p class="sub">Stop whenever you want. Nothing is deleted: the module is hidden until you subscribe again, with your tenancies, deposits and repair history where you left them.</p>
		</div>
	</div></section>

	<section class="band"><div class="cx">
		<h2>What it does <b>not do.</b></h2>
		<p class="sub">Worth knowing before you start the trial rather than during it.</p>
		<div class="nots">
			<div>
				<h3>Not in the module</h3>
				<ul>
					<li><b>It does not lodge your deposits.</b> Where your region still requires lodging, the tenancy records it and warns you before the window closes. Filing it stays yours.</li>
					<li><b>It does not file with the police or issue registration numbers.</b> Police guest registration (RD 933/2021) applies to lodging activities. For holiday bookings, automatic guest registration is <a href="/holiday-rentals/">coming</a>. See <a href="/docs/laws-procedures/renting-a-property/short-term-holiday/guest-registration-police/">guest registration with the police</a> for the duty itself.</li>
					<li><b>Seasonal contracts.</b> The module is built around long-term lettings, and the annual rent review in particular assumes a long-term rent. Talk to us before you move a temporada book across.</li>
				</ul>
			</div>
			<div>
				<h3>On the roadmap</h3>
				<ul>
					<li><b>Holiday and short lets.</b> Bookings, nightly rates, channel sync and guest registration will come later. If your book is holiday rather than long-term, <a href="/holiday-rentals/">see what is being built and add your name</a>.</li>
					<li><b>Landlord statements.</b> A periodic report per landlord covering repairs done, what they cost, the invoices, deposit status and rent roll. Every ticket already records who pays, so the data will be there when it ships.</li>
				</ul>
			</div>
		</div>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>Questions.</h2>
		<div class="faqwrap">
			{faqLd.mainEntity.map((qa) => (<details class="faqItem"><summary>{qa.name}</summary><p>{qa.acceptedAnswer.text}</p></details>))}
		</div>
	</div></section>

	<section class="band close"><div class="cx">
		<h2>Run lettings the same place <b>you run sales.</b></h2>
		<p class="alt">One login, one contact database, one workflow for the whole agency. Already with PropertyList? The Rentals tab is in your account, with Tenancies and Maintenance inside it.</p>
		<p class="ctaRow"><a class="btn btnLight" href={signup} target="_blank" rel="noopener">Start the free trial</a> <a class="ghost" href="/docs/propertylist-mls-user-manual/pipeline-and-tasks/rentals-module/">Read the manual chapter</a></p>
	</div></section>
</Layout>

<style>
	.cx { width: min(1120px, 100% - 32px); margin: 0 auto; }
	.hero { padding: 28px 0 40px; }
	.kicker { font-size: 17px; font-weight: 700; color: #0a6d61; margin: 0 0 14px; }
	h1 { font-size: 44px; line-height: 1.04; letter-spacing: -0.03em; font-weight: 800; margin: 0; max-width: 19ch; }
	h1 b, h2 b { color: #008a7a; }
	.lead { font-size: 19px; line-height: 1.5; color: #28383f; margin: 18px 0 24px; max-width: 52ch; }
	.lead strong { color: #0b1b22; }
	.ctaRow { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
	.btn { display: inline-block; background: #0a6d61; color: #fff; font-weight: 800; font-size: 18px; padding: 16px 24px; border-radius: 14px; text-decoration: none; }
	.btn:hover { background: #08584e; }
	.btnLink { font-weight: 700; color: #0a6d61; text-decoration: underline; text-underline-offset: 3px; }
	.fric { font-size: 15px; color: #5b6b73; margin: 12px 0 0; max-width: 60ch; }
	.film { margin: 32px 0 0; }
	.film video, .film .still { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; border-radius: 16px; border: 1px solid #e2e5e3; box-shadow: 0 24px 50px rgba(11, 27, 34, 0.12); background: #f4f7f8; }
	.film .still { display: none; }
	@media (prefers-reduced-motion: reduce) { .film video { display: none; } .film .still { display: block; } }
	.film figcaption { margin-top: 10px; font-size: 13px; line-height: 1.55; color: #5b6b73; max-width: 80ch; }
	.modes { display: grid; gap: 10px; margin-top: 22px; }
	.mode { display: grid; gap: 2px; padding: 14px 16px; border-radius: 14px; border: 1px solid #dfe6e8; background: #fff; text-decoration: none; color: #0b1b22; }
	.mode b { font-size: 17px; }
	.mode span { font-size: 14px; color: #3d4a4f; }
	.mode.here { border: 2px solid #00ae9a; background: #e6f7f4; }
	.mode:hover { border-color: #00ae9a; }

	.band { padding: 44px 0; border-top: 1px solid #e7eef1; background: #fff; }
	.band[id] { scroll-margin-top: 72px; }
	.soft { background: #f4f7f8; }
	.tint { background: #e6f7f4; }
	h2 { font-size: 32px; line-height: 1.1; letter-spacing: -0.025em; font-weight: 800; margin: 0; max-width: 24ch; }
	.sub { font-size: 17px; line-height: 1.5; color: #28383f; margin: 10px 0 0; max-width: 60ch; }
	.quiet { color: #5b6b73; font-size: 15px; line-height: 1.55; margin: 18px 0 0; max-width: 70ch; }
	.quiet a, .beats a, .nots a, .lawNote a { color: #0a6d61; font-weight: 700; }
	.steps { display: grid; gap: 22px; margin-top: 26px; }
	.step { padding-top: 14px; border-top: 3px solid #00ae9a; }
	.step h3 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 0; }
	.step p { margin: 6px 0 0; color: #28383f; max-width: 40ch; }

	.stages { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
	.stages li { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px 8px 8px; border-radius: 999px; background: #fff; border: 1px solid #dfe6e8; font-size: 14px; font-weight: 700; color: #28383f; }
	.stages li span { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #e7eef1; color: #3d4a4f; font-size: 12px; font-weight: 800; }
	.stages li.on { background: #0a6d61; border-color: #0a6d61; color: #fff; }
	.stages li.on span { background: #fff; color: #0a6d61; }
	.beats { display: grid; gap: 12px; margin-top: 22px; }
	.beats p { margin: 0; padding: 14px 16px; background: #fff; border-left: 4px solid #0a6d61; border-radius: 10px; color: #28383f; line-height: 1.5; max-width: 80ch; }
	.beats b { color: #0b1b22; }

	.feats { margin-top: 22px; border-top: 1px solid #dfe6e8; }
	.feats details { border-bottom: 1px solid #dfe6e8; }
	.feats summary { display: grid; gap: 4px; padding: 14px 0; cursor: pointer; list-style: none; }
	.feats summary::-webkit-details-marker { display: none; }
	.fName { font-size: 19px; font-weight: 800; }
	.fName::after { content: ' +'; color: #008a7a; }
	.feats details[open] .fName::after { content: ' -'; }
	.fLine { font-size: 16px; color: #3d4a4f; }
	.feats p { margin: 0 0 16px; color: #28383f; max-width: 64ch; }
	.states { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
	.states span { padding: 8px 14px; border-radius: 10px; background: #f4f7f8; border: 1px solid #dfe6e8; font-weight: 800; font-size: 15px; }
	.states span.end { background: #e6f7f4; border-color: #00ae9a; color: #0a6d61; }

	.lanes { display: grid; gap: 14px; margin-top: 24px; }
	.lane { background: #fff; border: 1px solid #dfe6e8; border-radius: 16px; padding: 18px; }
	.lane h3 { margin: 0 0 10px; font-size: 20px; font-weight: 800; color: #0a6d61; }
	.lane ol { margin: 0; padding-left: 20px; display: grid; gap: 8px; }
	.lane li { font-size: 15px; line-height: 1.5; color: #28383f; }

	.tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 24px; }
	.tiles div { background: #e6f7f4; border-radius: 14px; padding: 18px 16px; font-weight: 800; font-size: 18px; color: #0a6d61; }

	.dark { background: #0b1b22; color: #fff; border-top: 0; }
