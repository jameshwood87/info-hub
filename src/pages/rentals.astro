.feature-card--wide{grid-column:span 2}
.feature-card-icon{font-size:28px;line-height:1;margin-bottom:12px}
.feature-card h4{font-size:16px;font-weight:800;color:var(--slate);margin-bottom:8px;font-family:var(--font-sans)}
.feature-card p{font-size:13.5px;color:var(--grey-mid);line-height:1.55}
.feature-card-label{font-size:10px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:var(--teal-dark);margin-bottom:8px}
.feature-card h4 strong{color:var(--teal)}
.callout{background:linear-gradient(135deg,var(--teal-light) 0%,#ecfeff 100%);border:1px solid var(--teal-border);border-radius:14px;padding:28px 32px;text-align:center;margin:40px 0}
.callout-num{font-family:var(--font-serif);font-size:56px;font-weight:700;color:var(--teal);letter-spacing:-2px;line-height:1;margin-bottom:6px}
.callout h3{font-size:20px;font-weight:700;color:var(--slate);margin-bottom:10px;font-family:var(--font-sans)}
.callout p{font-size:14px;color:var(--grey-mid);line-height:1.6;max-width:480px;margin:0 auto}
.pricing{background:var(--slate)}
.pricing .section-head h2{color:var(--white)}
.pricing .section-head .lead{color:rgba(255,255,255,.65)}
.price-card{background:var(--white);border-radius:16px;padding:40px 36px;text-align:center;max-width:480px;margin:0 auto;box-shadow:0 16px 48px rgba(0,0,0,.2)}
.price-badge{display:inline-block;padding:4px 12px;background:var(--teal-light);color:var(--teal);font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase;border-radius:999px;margin-bottom:20px}
.price-name{font-size:18px;font-weight:700;color:var(--slate);margin-bottom:6px}
.price-tagline{font-size:14px;color:var(--grey-light);margin-bottom:24px}
