---
import Layout from '../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../lib/portalStats';

// Nurture sales page, rebuilt 09-10-26 (James: "fix nurture page also.. make it look like its worth paying for").
// Same substance as the previous page, new shape: layer cake, a code-drawn contact card in the hero (the payoff frame of
// the old film, readable on a phone and in both languages), and a full plan card that lists everything included.
// Prices per the free-vs-paid ledger: Automation and Nurture free since 16-09-26 (say "free", never "free forever").
const origin = 'https://info.propertylist.es';
const canonical = `${origin}/nurture/`;
const title = 'Nurture: keep every past client, automatically | PropertyList';
const description =
	'Past clients and quiet buyers stay in touch on their own, and you hear the moment one is ready to move. Free, and nothing sends until you switch it on.';

const stats = await getPortalStats();
const plAgents = statPlus(stats.agents, 'en');
const plAgencies = statPlus(stats.agencies, 'en');
const signup = 'https://agents.propertylist.es/new_agency/new?locale=en';
const guide = '/docs/propertylist-mls-user-manual/pipeline-and-tasks/nurture/';

const owed = [
	['The client from four years ago.', 'They bought through you. When they sell, they call whoever they heard from most recently. Often that is the agency that sent a market update, not the one that handed them the keys.'],
	['The buyer who went quiet.', 'Financing fell through in March. By October they are a buyer again, with a deposit and a mortgage in principle, and they are somebody else’s client now.'],
	['The landlord you never called.', 'Landlords buy again, refer other landlords and eventually sell. Nothing is ever urgent with them, so they are the easiest to go quiet on.'],
];

const askNothing = [
	['Birthdays', 'Theirs and their partner’s.'],
	['The day they signed', 'A note on the anniversary.'],
	['Christmas', 'Under your name.'],
	['A referral ask', 'While the good experience is still fresh.'],
];

const nextDeal = [
	['Homeowners', 'An honest annual valuation of their own house.'],
	['Investors', 'What their portfolio is worth, and what similar units rent for now.'],
	['Landlords', 'Yield, rule changes and a renew, re-let or sell analysis at every renewal.'],
	['Long-term tenants', 'A quiet comparison between their rent and a mortgage.'],
];

const watches = ['A click on a valuation link.', 'A reply.', 'The same "thinking of selling?" email opened three times in a week.'];
const outcome = ['The automated emails for that person stop.', 'They are tagged Hot.', 'A call goes to the top of your Daily Action Queue, with the reason on the card.'];

const control = [
	'One email per contact per week, however many sequences they are in. If two fall in the same week, the personal one wins.',
	'Consent is recorded per contact and unsubscribes are honoured. A contact who opts out stays on the board and receives nothing.',
	'Every contact has a timeline of what has been sent and what is next. You can read, edit or skip anything on it.',
	'Switch it off for one person, or for one type of email, when you know something the system does not.',
	'Anyone detected as another agent is excluded from all of it, so a valuation never goes to a co-broker.',
	'Emails go out in the language the client chose when the deal was won.',
];

const included = [
	'The Nurture pipeline, filled by every deal you win',
	'Birthday, anniversary and Christmas emails under your name',
	'An annual valuation note for homeowners',
	'Portfolio and rent notes for investors, renewal notes for landlords',
	'Rent versus mortgage notes for long-term tenants',
	'Intent detection and Hot tagging',
	'The Daily Action Queue, with the reason on the card',
	'One email a week per contact, at most',
	'Consent and unsubscribe records per contact',
	'Other agents excluded automatically',
	'Emails in each client’s own language',
	'A counter of what would have gone out, before you switch it on',
];

const faqs = [
	['What does it cost?', 'Nothing. Nurture is part of Automation and Nurture, which is free. It covers the Nurture pipeline, every automated email, Hot-lead detection and the Daily Action Queue. It is one product, so there is nothing to configure or add on.'],
	['Will it send things I would be embarrassed by?', 'You can see every email before it goes. Each contact has a timeline of what has been sent and what is scheduled, and anything upcoming can be read, edited or skipped. Nobody gets more than one email a week, agent contacts are excluded entirely, and you can switch a person off completely without removing them from the board.'],
	['Where does the information come from?', 'From the moment a deal is won. The system asks for the sign date, birthdays, whether they are living there or investing, the language they prefer, and marketing consent. That is what makes the emails specific rather than generic. If something is missing it asks you for it rather than guessing.'],
	['What happens when someone shows interest?', 'The automated emails for that contact stop, they are tagged Hot, and a call goes to the top of your Daily Action Queue with the reason attached, for example that they opened a valuation email three times this week. A contact coming back to you out of Nurture never costs a credit.'],
	['What happens before I switch it on?', 'The board fills up either way. Every won deal puts the contact on it and the details are collected as normal, but nothing sends, and a counter shows what the month would have sent. When you switch it on it starts with everything it has been gathering rather than from an empty screen.'],
];

const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const breadcrumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
	{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
	{ '@type': 'ListItem', position: 2, name: 'Features', item: `${origin}/features/` },
	{ '@type': 'ListItem', position: 3, name: 'Nurture', item: canonical },
] };
---
<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	ogImage="https://info.propertylist.es/og/og-nurture.jpg"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/nurture/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<section class="hero"><div class="cx heroGrid">
		<div>
			<p class="kicker">Automation and Nurture</p>
			<h1>Your database is your <b>pension.</b></h1>
			<p class="lead">You already know hundreds of buyers, sellers and landlords. Some of them are moving this year. <strong>Nurture stays in touch with all of them without you, and tells you the moment one is ready.</strong></p>
			<p class="ctaRow"><a class="btn" href={signup} target="_blank" rel="noopener">Create your free agency account</a> <a class="btnLink" href="#what-it-costs">See everything included</a></p>
			<p class="fric">{plAgencies} agencies and {plAgents} agents are on the network. Nurture is free, and the board fills up before you switch anything on.</p>
		</div>
		<figure class="nFig">
			<div class="ncard" role="group" aria-label="Example Nurture contact">
				<div class="ncTop">
					<div><b>Past client, bought through you</b><span>Nueva Andalucía, deal won May 2022</span></div>
					<div class="tags"><span class="tg">Nurture</span><span class="tg hot">Hot</span></div>
				</div>
				<p class="ncLabel">Sent under your name, one a week at most</p>
				<ol class="tl">
					<li><b>Aug 2022</b>Birthday</li>
					<li><b>May 2023</b>A year since signing</li>
					<li><b>Dec 2024</b>Christmas</li>
					<li class="hotDot"><b>May 2026</b>Annual valuation</li>
				</ol>
				<p class="ncSent">4 emails in four years, all under your name.</p>
				<div class="paused">Automated emails paused for this contact.</div>
				<div class="queue"><span class="qTag">Top of the queue</span><b>Call them today</b><span>Opened the valuation email three times this week. Four years since you handed over the keys.</span></div>
			</div>
			<figcaption>An illustration of a Nurture contact, not a recording of the CRM.</figcaption>
		</figure>
	</div></section>

	<section class="band"><div class="cx">
		<h2>The deals you have <b>already earned.</b></h2>
		<p class="sub">Nobody loses these on purpose. They go quiet one week at a time, while you are busy with the deal in front of you.</p>
		<div class="steps">
			{owed.map(([h, p]) => (<div class="step"><h3>{h}</h3><p>{p}</p></div>))}
		</div>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>It runs on dates <b>you already have.</b></h2>
		<p class="sub">When a deal is won you are asked for the sign date, the birthdays, whether they live there or invest, and their language. Nothing else needs setting up. Tenancies that go live in the <a href="/rentals/">Rentals Module</a> land here too.</p>
		<h3 class="groupH">Emails that ask for nothing</h3>
		<div class="asks four">
			{askNothing.map(([h, p]) => (<div>{h}<span>{p}</span></div>))}
		</div>
		<h3 class="groupH">Emails that find the next deal</h3>
		<div class="asks four">
			{nextDeal.map(([h, p]) => (<div>{h}<span>{p}</span></div>))}
		</div>
	</div></section>

	<section class="band dark"><div class="cx">
		<h2>The part that earns: <b>it knows when to stop.</b></h2>
		<div class="intent">
			<div><h3>What it watches for</h3><ul>{watches.map((w) => <li>{w}</li>)}</ul></div>
			<div><h3>What happens next</h3><ul>{outcome.map((w) => <li>{w}</li>)}</ul></div>
		</div>
		<p class="alt"><b>A contact coming back out of Nurture never costs a credit.</b></p>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Watch it work <b>before you switch it on.</b></h2>
		<p class="sub">The board fills up anyway. Every won deal lands on it, the sign dates and birthdays are collected, and a counter shows what the month would have sent. Nothing goes out until you decide it should, and when you do, it starts with everything it has gathered.</p>
		<p class="pills"><span>Nothing sends until you say so</span><span>Starts already loaded</span></p>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>You stay in control <b>of every message.</b></h2>
		<p class="sub">Automation is only worth having if you would be happy for a client to read the whole thing back to you.</p>
		<ul class="auto">
			{control.map((c) => <li>{c}</li>)}
		</ul>
	</div></section>

	<section class="band tint" id="what-it-costs"><div class="cx costGrid">
		<div class="plan">
			<p class="planName">Automation and Nurture</p>
			<p class="planPrice">Free</p>
			<p class="planNote">One product, with nothing to add on.</p>
			<ul class="checks">
				{included.map((i) => <li>{i}</li>)}
			</ul>
			<p class="planFoot">A contact returning to you from Nurture is never charged.</p>
			<a class="btn" href={signup} target="_blank" rel="noopener">Create your free agency account</a>
		</div>
		<div>
			<h2>It only works because <b>the pipelines that feed it are free.</b></h2>
			<p class="sub">Nurture is fed by the pipelines, and the pipelines that fill it cost nothing. Leads, Sellers and Property run free with no limit, so every deal you close lands in Nurture whether or not you switch the follow-up on.</p>
			<p class="sub">The more you run your agency here, the more your database is worth, and it is yours either way.</p>
			<p class="links"><a href="/pipelines/">See the six pipelines</a> <a href="/pricing/">Full pricing</a> <a href={guide}>Setup guide</a></p>
		</div>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>Before you ask.</h2>
		<div class="faqwrap">
			{faqs.map(([q, a]) => (<details class="faqItem"><summary>{q}</summary><p>{a}</p></details>))}
		</div>
	</div></section>

	<section class="band close"><div class="cx">
		<h2>The clients you already have are the cheapest ones you will ever <b>win again.</b></h2>
		<p class="alt">Listing on the MLS, the Leads, Sellers and Property pipelines that feed Nurture, and Nurture itself are free. Switch the follow-up on whenever you are ready.</p>
		<a class="btn btnLight" href={signup} target="_blank" rel="noopener">Create your free agency account</a>
		<p class="dev">Want the detail first? <a href={guide}>Read the Nurture guide</a>.</p>
	</div></section>
</Layout>

<style>
	.cx { width: min(1120px, 100% - 32px); margin: 0 auto; }
	.hero { padding: 28px 0 44px; }
	.heroGrid { display: grid; gap: 32px; align-items: center; }
	.kicker { font-size: 17px; font-weight: 700; color: #0a6d61; margin: 0 0 14px; }
	h1 { font-size: 44px; line-height: 1.04; letter-spacing: -0.03em; font-weight: 800; margin: 0; }
	h1 b, h2 b { color: #008a7a; }
	.lead { font-size: 19px; line-height: 1.5; color: #28383f; margin: 18px 0 24px; max-width: 40ch; }
	.lead strong { color: #0b1b22; }
	.btn { display: inline-block; background: #0a6d61; color: #fff; font-weight: 800; font-size: 18px; padding: 16px 24px; border-radius: 14px; text-decoration: none; }
	.btn:hover { background: #08584e; }
	.btnLink { display: inline-block; margin: 0; font-weight: 700; color: #0a6d61; text-decoration: underline; text-underline-offset: 3px; }
	.ctaRow { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
	.band[id] { scroll-margin-top: 72px; }
	.fric { font-size: 15px; color: #5b6b73; margin: 12px 0 0; max-width: 52ch; }
	.nFig { margin: 0; }
	.nFig figcaption { font-size: 13px; color: #5b6b73; margin: 10px 0 0; text-align: center; }
	.ncard { background: #fff; border: 1px solid #f2b8b0; border-radius: 18px; padding: 18px; box-shadow: 0 24px 50px rgba(11, 27, 34, 0.12); max-width: 480px; margin: 0 auto; }
	.ncTop { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
	.ncTop b { display: block; font-size: 17px; }
	.ncTop span { font-size: 13px; color: #5b6b73; }
	.tags { display: flex; gap: 6px; flex-shrink: 0; }
	.tg { font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 999px; background: #e6f7f4; color: #0a6d61; }
	.tg.hot { background: #fde8e5; color: #b4232a; }
	.ncLabel { font-size: 12px; font-weight: 700; color: #5b6b73; margin: 16px 0 8px; }
	.tl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; position: relative; }
	.tl::before { content: ''; position: absolute; left: 6px; right: 6px; top: 6px; height: 2px; background: #00ae9a; }
	.tl li { position: relative; padding-top: 18px; font-size: 12px; color: #28383f; }
	.tl li::before { content: ''; position: absolute; left: 0; top: 0; width: 14px; height: 14px; border-radius: 50%; background: #00ae9a; border: 2px solid #fff; box-sizing: border-box; }
	.tl li.hotDot::before { background: #b4232a; }
	.tl li b { display: block; font-size: 12px; color: #0b1b22; }
	.ncSent { font-size: 13px; color: #5b6b73; margin: 12px 0 10px; }
	.paused { background: #fdecea; border: 1px solid #f2b8b0; color: #b4232a; font-size: 13px; font-weight: 700; padding: 9px 12px; border-radius: 10px; }
	.queue { margin-top: 10px; border-left: 4px solid #b4232a; background: #fbfbfa; border-radius: 10px; padding: 10px 12px; }
	.queue b { display: block; font-size: 16px; margin-top: 4px; }
	.queue span:last-child { font-size: 13px; color: #3d4a4f; }
	.qTag { font-size: 11px; font-weight: 800; color: #b4232a; }
	.band { padding: 44px 0; border-top: 1px solid #e7eef1; background: #fff; }
	.soft { background: #f4f7f8; }
	.tint { background: #e6f7f4; }
	h2 { font-size: 32px; line-height: 1.1; letter-spacing: -0.025em; font-weight: 800; margin: 0; max-width: 22ch; }
	.sub { font-size: 17px; line-height: 1.5; color: #28383f; margin: 10px 0 0; max-width: 56ch; }
	.sub a { color: #0a6d61; font-weight: 700; }
	.steps { display: grid; gap: 22px; margin-top: 26px; }
	.step { padding-top: 14px; border-top: 3px solid #00ae9a; }
	.step h3 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 0; }
	.step p { margin: 6px 0 0; color: #28383f; max-width: 38ch; }
	.groupH { font-size: 20px; font-weight: 800; margin: 28px 0 0; }
	.asks { display: grid; gap: 10px; margin-top: 14px; }
	.asks div { background: #fff; border: 1px solid #dfe6e8; border-radius: 14px; padding: 14px 16px; font-weight: 700; font-size: 17px; }
	.asks div span { display: block; font-weight: 500; color: #3d4a4f; font-size: 15px; margin-top: 4px; }
	.dark { background: #0b1b22; color: #fff; border-top: 0; }
	.dark h2 b { color: #7deede; }
	.intent { display: grid; gap: 22px; margin-top: 24px; }
	.intent h3 { font-size: 15px; font-weight: 800; color: #7deede; margin: 0 0 10px; }
	.intent ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
	.intent li { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 12px; padding: 12px 14px; font-size: 17px; line-height: 1.4; }
	.alt { margin: 22px 0 0; color: #c9d6da; font-size: 17px; max-width: 56ch; }
	.alt b { color: #fff; }
	.pills { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0 0; }
	.pills span { background: #e6f7f4; color: #0a6d61; font-weight: 800; font-size: 15px; padding: 8px 14px; border-radius: 999px; }
	.auto { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 12px; }
	.auto li { padding: 0 0 0 30px; position: relative; font-size: 17px; line-height: 1.45; color: #0b1b22; max-width: 60ch; }
	.auto li::before { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: #00ae9a; }
	.costGrid { display: grid; gap: 32px; align-items: start; }
	.plan { background: #fff; border: 2px solid #00ae9a; border-radius: 20px; padding: 24px; box-shadow: 0 24px 50px rgba(11, 27, 34, 0.1); }
	.planName { font-size: 15px; font-weight: 800; color: #0a6d61; margin: 0; }
	.planPrice { font-size: 52px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; margin: 8px 0 4px; }
	.planNote { font-size: 15px; color: #5b6b73; margin: 0 0 16px; }
	.checks { list-style: none; margin: 0 0 16px; padding: 16px 0 0; border-top: 1px solid #dfe6e8; display: grid; gap: 9px; }
	.checks li { position: relative; padding-left: 28px; font-size: 16px; line-height: 1.4; }
	.checks li::before { content: ''; position: absolute; left: 0; top: 2px; width: 18px; height: 18px; border-radius: 50%; background: #e6f7f4; }
	.checks li::after { content: ''; position: absolute; left: 6px; top: 5px; width: 5px; height: 9px; border: solid #0a6d61; border-width: 0 2px 2px 0; transform: rotate(45deg); }
	.planFoot { font-size: 15px; font-weight: 700; color: #0b1b22; margin: 0 0 18px; }
	.links { display: flex; flex-wrap: wrap; gap: 18px; margin: 18px 0 0; }
	.links a { color: #0a6d61; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
	.faqwrap { margin-top: 20px; }
	.faqItem { border-top: 1px solid #e7eef1; padding: 14px 0; }
	.faqItem:last-child { border-bottom: 1px solid #e7eef1; }
	.faqItem summary { font-weight: 800; font-size: 19px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
	.faqItem summary::-webkit-details-marker { display: none; }
	.faqItem summary::after { content: '+'; color: #008a7a; font-size: 26px; line-height: 1; }
	.faqItem[open] summary::after { content: '-'; }
	.faqItem p { margin: 10px 0 0; color: #28383f; max-width: 60ch; }
	.close { background: #0b1b22; color: #fff; border-top: 0; }
	.close h2 { max-width: 24ch; }
	.close h2 b { color: #7deede; }
	.btnLight { background: #00ae9a; color: #0b1b22; margin-top: 22px; }
	.btnLight:hover { background: #2fe3cb; }
	.dev { margin: 18px 0 0; font-size: 14px; color: #8fa0a6; }
	.dev a { color: #c9d6da; }
	@media (min-width: 900px) {
		h1 { font-size: 68px; }
		.lead { font-size: 22px; }
		.hero { padding: 48px 0 64px; }
		.heroGrid { grid-template-columns: 1.05fr 1fr; gap: 48px; }
		h2 { font-size: 44px; }
		.steps { grid-template-columns: repeat(3, 1fr); gap: 32px; }
		.asks.four { grid-template-columns: repeat(4, 1fr); }
		.intent { grid-template-columns: 1fr 1fr; gap: 32px; }
		.auto { grid-template-columns: repeat(2, 1fr); gap: 14px 32px; }
		.costGrid { grid-template-columns: 1fr 1.1fr; gap: 56px; }
		.band { padding: 64px 0; }
	}
</style>
