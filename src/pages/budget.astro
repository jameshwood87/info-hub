---
// "What does your budget actually buy?" - the consumer twin of /hours/.
// One budget, 14 Costa del Sol towns, bars show how far the money stretches.
// Every number is computed from every live for-sale listing on the MLS
// (scripts/budget-data.mjs, daily 04:50), so the counts always match what the
// portal deep link opens. Rows ship fully rendered in static HTML for search
// and AI crawlers; JS only retypes the numbers when the budget changes.
// Shares carry ?b=N so the OG preview in the group chat shows THEIR budget.
import { readFile } from 'node:fs/promises';
import Layout from '../layouts/Layout.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/budget/`;

type Town = {
	slug: string;
	name: string;
	n: number;
	m2eur: number;
	minPrice: number;
	counts: number[];
	oracle: { m2: number; n: number | null } | null;
};
type BudgetData = { updatedAt: string; grid: number[]; towns: Town[] };

let data: BudgetData | null = null;
for (const p of ['/opt/info-hub/var/admin/budget-data.json', 'var/admin/budget-data.json']) {
	try {
		data = JSON.parse(await readFile(p, 'utf8'));
		break;
	} catch {}
}
const grid: number[] = data?.grid ?? [];
const towns: Town[] = data?.towns ?? [];
const totalListings = towns.reduce((a, t) => a + t.n, 0);

// ---- budget from the URL (shares), clamped to the grid range ----
const MIN_B = 100000;
const MAX_B = 10000000;
const rawB = parseInt(Astro.url.searchParams.get('b') || '0', 10) || 0;
const shared = rawB >= MIN_B && rawB <= MAX_B;
const b = shared ? rawB : 500000;

const fmtEur = (v: number) => `€${v.toLocaleString('en-GB')}`;

// Homes at-or-under a budget: exact on grid points (the preset chips), linear
// interpolation between them for typed budgets, displayed with "~".
const countAt = (t: Town, budget: number): { n: number; exact: boolean } => {
	if (!grid.length) return { n: 0, exact: false };
	if (budget <= grid[0]) return { n: t.counts[0], exact: budget === grid[0] };
	for (let i = grid.length - 1; i >= 0; i--) {
		if (grid[i] === budget) return { n: t.counts[i], exact: true };
		if (grid[i] < budget) {
			if (i === grid.length - 1) return { n: t.counts[i], exact: true };
			const f = (budget - grid[i]) / (grid[i + 1] - grid[i]);
			return { n: Math.round(t.counts[i] + f * (t.counts[i + 1] - t.counts[i])), exact: false };
		}
	}
	return { n: 0, exact: false };
};

// What that much built space typically is. Deliberately rough, deliberately human.
const sizeLabel = (sqm: number): string => {
	if (sqm < 40) return 'a studio';
	if (sqm < 60) return 'a one-bed apartment';
	if (sqm < 80) return 'a small two-bed';
	if (sqm < 100) return 'a two-bed apartment';
	if (sqm < 130) return 'a three-bed apartment';
	if (sqm < 170) return 'a three-bed townhouse';
	if (sqm < 220) return 'a townhouse or small villa';
	if (sqm < 300) return 'a villa';
	if (sqm < 450) return 'a big villa';
	if (sqm < 700) return 'a very big villa';
	return 'an estate';
};

// Rows arrive sorted cheapest EUR/m2 first (most house first) from the script.
const rows = towns.map((t) => {
	const sqm = Math.round(b / t.m2eur);
	const c = countAt(t, b);
	return { ...t, sqm, count: c.n, exact: c.exact, none: b < t.minPrice };
});
const maxSqm = rows.length ? rows[0].sqm : 1;
const best = rows[0];
const worst = rows[rows.length - 1];
const ratio = best && worst ? (worst.m2eur / best.m2eur).toFixed(1) : '0';

const title = shared
	? `What ${fmtEur(b)} actually buys on the Costa del Sol`
	: 'What does your budget actually buy? 14 Costa del Sol towns compared';
const description = best
	? `${fmtEur(b)} is ${best.sqm}m2 in ${best.name} but ${worst.sqm}m2 in ${worst.name}. Live median asking prices from ${totalListings.toLocaleString('en-GB')} listings in 14 towns, updated daily, with every home under your budget one tap away.`
	: 'Live median asking prices across 14 Costa del Sol towns, updated daily.';
const ogImage = `${origin}/api/og-budget.png?b=${b}`;

const mIdx = grid.indexOf(500000);
const marbella = towns.find((t) => t.slug === 'marbella');
const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		best && worst
			? {
					'@type': 'Question',
					name: 'Where does a budget go furthest on the Costa del Sol?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: `Of the 14 towns compared, ${best.name} currently has the lowest median asking price at €${best.m2eur.toLocaleString('en-GB')} per m2 and ${worst.name} the highest at €${worst.m2eur.toLocaleString('en-GB')} per m2. The same budget buys about ${ratio} times more built space in ${best.name}, based on every live for-sale listing from registered agencies on the PropertyList MLS.`,
					},
				}
			: null,
		marbella && mIdx >= 0
			? {
					'@type': 'Question',
					name: 'What does €500,000 buy in Marbella?',
					acceptedAnswer: {
						'@type': 'Answer',
						text: `About ${Math.round(500000 / marbella.m2eur)}m2 of built space at Marbella's current median asking price of €${marbella.m2eur.toLocaleString('en-GB')} per m2. ${marbella.counts[mIdx]} of the ${marbella.n} homes currently listed for sale in Marbella are priced at or under €500,000.`,
					},
				}
			: null,
		{
			'@type': 'Question',
			name: 'Are these asking prices or sold prices?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Asking prices: the median price per m2 across every live for-sale listing from registered agencies, refreshed daily. Asking is not sold. Where the Spanish notarial registry covers a town, the verified sold price per m2 is shown alongside, and it usually sits well below asking.',
			},
		},
	].filter(Boolean),
};

const updated = data ? new Date(data.updatedAt) : null;
const updatedStr = updated
	? `${String(updated.getDate()).padStart(2, '0')}-${String(updated.getMonth() + 1).padStart(2, '0')}-${String(updated.getFullYear()).slice(2)}`
	: '';

const oracleRows = towns.filter((t) => t.oracle);
const payload = JSON.stringify({
	grid,
	towns: towns.map((t) => ({ slug: t.slug, name: t.name, n: t.n, m2eur: t.m2eur, minPrice: t.minPrice, counts: t.counts })),
});
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	ogImage={ogImage}
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/presupuesto/` },
		{ hreflang: 'x-default', href: canonical },
	]}
	schema={faqLd}
>
	<div class="bp" data-b={String(b)} data-lang="en">
		<section class="hero">
			<p class="eyebrow">Same money. Different postcode.</p>
			<h1>What does your budget <span class="und">actually</span> buy?</h1>
			<p class="sub">
				Median asking prices from <strong>{totalListings.toLocaleString('en-GB')} live listings</strong> in 14 Costa del Sol towns, updated daily. Pick a number and watch it stretch.
			</p>
			<div class="amount" role="group" aria-label="Your budget">
				<button class="step" data-step="-1" aria-label="Lower budget">&minus;</button>
				<label class="amtBox">
					<span class="cur">&euro;</span>
					<input id="amt" inputmode="numeric" autocomplete="off" spellcheck="false" value={b.toLocaleString('en-GB')} aria-label="Budget in euros" />
				</label>
				<button class="step" data-step="1" aria-label="Raise budget">+</button>
			</div>
			<div class="chips" role="group" aria-label="Quick budgets">
				{[250000, 350000, 500000, 750000, 1000000, 2000000].map((v) => (
					<button class:list={['chip', { on: v === b }]} data-chip={String(v)}>
						{v >= 1000000 ? `€${v / 1000000}M` : `€${v / 1000}k`}
					</button>
				))}
			</div>
		</section>

		<section class="board" aria-label="What your budget buys per town">
			{rows.map((r) => (
				<div class:list={['row', { none: r.none }]} data-town={r.slug}>
					<div class="rowTop">
						<span class="town">{r.name}</span>
						<span class="ppm">€{r.m2eur.toLocaleString('en-GB')}/m&sup2; asking</span>
					</div>
					<div class="barWrap">
						<div class="bar" style={`--w:${Math.max(4, Math.round((r.sqm / maxSqm) * 100))}%`}></div>
						<span class="sqm"><b data-sqm>{r.sqm}</b>m&sup2;</span>
					</div>
					<p class="meta">
						<span class="metaFit" data-fit hidden={r.none}>
							&asymp; <span data-desc>{sizeLabel(r.sqm)}</span> &middot;{' '}
							<a data-link href={`https://propertylist.es/en/portal/for-sale/${r.slug}?price_max=${b}`} rel="noopener" target="_blank" data-umami-event="budget-town" data-umami-event-town={r.slug}>
								<span data-count>{r.exact ? r.count.toLocaleString('en-GB') : `~${r.count.toLocaleString('en-GB')}`}</span> of {r.n.toLocaleString('en-GB')} homes fit your budget &rarr;
							</a>
						</span>
						<span class="metaNone" data-none hidden={!r.none}>
							Nothing at this price today &middot;{' '}
							<a data-minlink href={`https://propertylist.es/en/portal/for-sale/${r.slug}`} rel="noopener" target="_blank" data-umami-event="budget-town" data-umami-event-town={r.slug}>
								the door opens at <b data-min>{fmtEur(r.minPrice)}</b> &rarr;
							</a>
						</span>
					</p>
				</div>
			))}
		</section>

		{best && worst && (
			<section class="kicker">
				<p class="kickLine">
					<span data-kb>{fmtEur(b)}</span> goes <strong><span data-kr>{ratio}</span>&times; further</strong> in {best.name} than in {worst.name}.
				</p>
				<p class="kickSub">Know someone house-hunting with a number in their head? Send them theirs.</p>
				<div class="shareRow">
					<a class="shBtn wa" data-wa href="#" rel="noopener" target="_blank" data-umami-event="budget-share" data-umami-event-via="whatsapp">Share on WhatsApp</a>
					<button class="shBtn cp" data-copy data-umami-event="budget-share" data-umami-event-via="copy">Copy link</button>
				</div>
			</section>
		)}

		<section class="method">
			<h2>Where these numbers come from</h2>
			<p>
				Every live for-sale listing published by registered agencies on the PropertyList MLS, refetched daily (last: {updatedStr}). Each town's figure is the median asking price per built m&sup2; across all of its listings, so one &euro;30M villa cannot drag the number. Towns with fewer than 25 listings are left out rather than shown on a coin-flip median. No estimates, no scraping, no third-hand indices.
			</p>
			<p>
				<strong>Asking is not sold.</strong> Where Spain's notarial registry covers a town, here is what buyers actually paid per m&sup2;, next to what sellers are asking today. Different baskets (what is listed now vs what changed hands last period), but a gap this wide is worth knowing before you offer.
			</p>
			<div class="tblWrap">
				<table>
					<thead>
						<tr><th>Town</th><th>Asking &euro;/m&sup2;</th><th>Notary-verified &euro;/m&sup2;</th><th>Verified sales</th></tr>
					</thead>
					<tbody>
						{oracleRows.map((t) => (
							<tr>
								<td>{t.name}</td>
								<td>&euro;{t.m2eur.toLocaleString('en-GB')}</td>
								<td class="oc">&euro;{t.oracle!.m2.toLocaleString('en-GB')}</td>
								<td>{t.oracle!.n ? t.oracle!.n.toLocaleString('en-GB') : '-'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="srcNote">Verified prices: Spanish notarial registry via the PropertyList Oracle. Built m&sup2; only; plots excluded.</p>
		</section>

		<section class="next">
			<a class="nextCard" href="/property-finder/" data-umami-event="budget-finder">
				<span class="nextKick">Found your town?</span>
				<span class="nextLine">See every home that fits, straight from the agencies that listed them &rarr;</span>
			</a>
		</section>
	</div>

	<script type="application/json" id="bd" set:html={payload} />

	<style>
		.bp {
			--ink: #0d2b2e;
			--teal: #00ae9a;
			--mut: #5c7274;
			max-width: 880px;
			margin: 0 auto;
			color: var(--ink);
		}
		.hero { text-align: center; padding: 26px 0 8px; }
		.eyebrow { font-size: 13px; font-weight: 800; letter-spacing: 2.5px; text-transform: uppercase; color: var(--teal); margin: 0 0 14px; }
		h1 { font-size: clamp(30px, 5.4vw, 46px); line-height: 1.08; margin: 0 0 14px; font-weight: 800; letter-spacing: -0.5px; }
		.und { text-decoration: underline; text-decoration-color: var(--teal); text-decoration-thickness: 4px; text-underline-offset: 5px; }
		.sub { color: var(--mut); font-size: 16px; max-width: 560px; margin: 0 auto 26px; line-height: 1.55; }
		.sub strong { color: var(--ink); }

		.amount { display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 16px; }
		.step { width: 46px; height: 46px; border-radius: 50%; border: 2px solid #d5e2e0; background: #fff; font-size: 24px; font-weight: 700; color: var(--ink); cursor: pointer; flex-shrink: 0; transition: border-color 0.15s, transform 0.1s; }
		.step:hover { border-color: var(--teal); }
		.step:active { transform: scale(0.92); }
		.amtBox { display: inline-flex; align-items: baseline; gap: 2px; border-bottom: 4px solid var(--teal); padding: 0 6px 2px; cursor: text; min-width: 0; }
		.cur { font-size: clamp(26px, 5vw, 40px); font-weight: 800; color: var(--teal); }
		#amt { border: 0; outline: 0; background: transparent; font-family: inherit; font-size: clamp(42px, 8.4vw, 68px); font-weight: 800; letter-spacing: -2px; color: var(--ink); width: 5.6ch; min-width: 0; padding: 0; }
		.chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
		.chip { border: 1.5px solid #d5e2e0; background: #fff; border-radius: 999px; padding: 7px 15px; font-size: 14px; font-weight: 700; color: var(--mut); cursor: pointer; transition: all 0.15s; }
		.chip:hover { border-color: var(--teal); color: var(--ink); }
		.chip.on { background: var(--teal); border-color: var(--teal); color: #fff; }

		.board { margin: 30px 0 8px; display: flex; flex-direction: column; gap: 6px; }
		.row { padding: 13px 16px 11px; border-radius: 14px; transition: background 0.15s, opacity 0.3s; }
		.row:hover { background: #f2f7f6; }
		.rowTop { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; min-width: 0; }
		.town { font-weight: 800; font-size: 17px; }
		.ppm { font-size: 12.5px; color: var(--mut); white-space: nowrap; }
		.barWrap { display: flex; align-items: center; gap: 10px; margin: 7px 0 6px; min-width: 0; }
		.bar { height: 22px; width: var(--w); min-width: 8px; border-radius: 999px; background: linear-gradient(90deg, var(--teal), #6fd0c2); transform-origin: left center; animation: grow 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
		@keyframes grow { from { transform: scaleX(0); } }
		.row:nth-child(2) .bar { animation-delay: 0.04s; } .row:nth-child(3) .bar { animation-delay: 0.08s; }
		.row:nth-child(4) .bar { animation-delay: 0.12s; } .row:nth-child(5) .bar { animation-delay: 0.16s; }
		.row:nth-child(6) .bar { animation-delay: 0.2s; } .row:nth-child(7) .bar { animation-delay: 0.24s; }
		.row:nth-child(8) .bar { animation-delay: 0.28s; } .row:nth-child(9) .bar { animation-delay: 0.32s; }
		.row:nth-child(10) .bar { animation-delay: 0.36s; } .row:nth-child(11) .bar { animation-delay: 0.4s; }
		.row:nth-child(12) .bar { animation-delay: 0.44s; } .row:nth-child(13) .bar { animation-delay: 0.48s; }
		.row:nth-child(14) .bar { animation-delay: 0.52s; }
		.sqm { font-size: 19px; font-weight: 800; white-space: nowrap; color: var(--ink); }
		.sqm b { font-size: 24px; }
		.meta { margin: 0; font-size: 13.5px; color: var(--mut); line-height: 1.45; }
		.meta a { color: var(--teal); font-weight: 700; text-decoration: none; }
		.meta a:hover { text-decoration: underline; }
		.row.none .bar { background: #e3ebea; }
		.row.none .sqm { color: #b3c4c2; }
		.metaNone { color: #a8772a; }
		.metaNone a { color: #a8772a; }
		.metaNone b { font-weight: 800; }

		.kicker { background: var(--ink); color: #fff; border-radius: 18px; padding: 30px 26px; text-align: center; margin: 26px 0; }
		.kickLine { font-size: clamp(20px, 3.6vw, 27px); font-weight: 700; line-height: 1.3; margin: 0 0 6px; }
		.kickLine strong { color: #5be3d0; }
		.kickSub { color: rgba(255, 255, 255, 0.65); font-size: 14.5px; margin: 0 0 18px; }
		.shareRow { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
		.shBtn { border-radius: 999px; padding: 12px 22px; font-size: 15px; font-weight: 800; cursor: pointer; border: 0; text-decoration: none; display: inline-block; transition: transform 0.1s; }
		.shBtn:active { transform: scale(0.96); }
		.wa { background: #25d366; color: #fff; }
		.cp { background: rgba(255, 255, 255, 0.14); color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.35); }

		.method { padding: 10px 4px 6px; }
		.method h2 { font-size: 21px; margin: 0 0 10px; }
		.method p { font-size: 14.5px; color: var(--mut); line-height: 1.6; max-width: 720px; }
		.method p strong { color: var(--ink); }
		.tblWrap { overflow-x: auto; margin: 14px 0 6px; }
		table { border-collapse: collapse; font-size: 14px; min-width: 480px; }
		th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--mut); padding: 6px 18px 6px 0; border-bottom: 2px solid #e3ebea; }
		td { padding: 7px 18px 7px 0; border-bottom: 1px solid #eef3f2; }
		td.oc { color: var(--teal); font-weight: 800; }
		.srcNote { font-size: 12.5px !important; color: #8aa0a2 !important; }

		.next { margin: 22px 0 30px; }
		.nextCard { display: block; border: 2px solid #d5e2e0; border-radius: 16px; padding: 20px 22px; text-decoration: none; color: var(--ink); transition: border-color 0.15s; }
		.nextCard:hover { border-color: var(--teal); }
		.nextKick { display: block; font-size: 12.5px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: var(--teal); margin-bottom: 4px; }
		.nextLine { font-size: 17px; font-weight: 700; }

		@media (max-width: 560px) {
			.row { padding: 11px 10px 9px; }
			.bar { height: 18px; }
			.sqm b { font-size: 20px; }
			.kicker { padding: 24px 16px; }
		}
	</style>

	<script>
		const root = document.querySelector('.bp') as HTMLElement;
		const D = JSON.parse(document.getElementById('bd')!.textContent || '{}');
		const grid: number[] = D.grid || [];
		const towns: any[] = D.towns || [];
		const lang = root.dataset.lang === 'es' ? 'es' : 'en';
		const loc = lang === 'es' ? 'es-ES' : 'en-GB';
		const MIN = 100000, MAX = 10000000;
		let b = parseInt(root.dataset.b || '500000', 10);

		const nf = (v: number) => v.toLocaleString(loc);
		const eur = (v: number) => (lang === 'es' ? `${nf(v)} €` : `€${nf(v)}`);
		const sizeLabels: [number, string, string][] = [
			[40, 'a studio', 'un estudio'],
			[60, 'a one-bed apartment', 'un piso de 1 dormitorio'],
			[80, 'a small two-bed', 'un piso pequeño de 2 dormitorios'],
			[100, 'a two-bed apartment', 'un piso de 2 dormitorios'],
			[130, 'a three-bed apartment', 'un piso de 3 dormitorios'],
			[170, 'a three-bed townhouse', 'un adosado de 3 dormitorios'],
			[220, 'a townhouse or small villa', 'un adosado o una villa pequeña'],
			[300, 'a villa', 'una villa'],
			[450, 'a big villa', 'una villa grande'],
			[700, 'a very big villa', 'una villa muy grande'],
			[Infinity, 'an estate', 'una finca señorial'],
		];
		const sizeLabel = (sqm: number) => {
			for (const [lim, en, es] of sizeLabels) if (sqm < lim) return lang === 'es' ? es : en;
			return '';
		};
		const countAt = (t: any, budget: number) => {
			if (!grid.length) return { n: 0, exact: false };
			if (budget <= grid[0]) return { n: t.counts[0], exact: budget === grid[0] };
			for (let i = grid.length - 1; i >= 0; i--) {
				if (grid[i] === budget) return { n: t.counts[i], exact: true };
				if (grid[i] < budget) {
					if (i === grid.length - 1) return { n: t.counts[i], exact: true };
					const f = (budget - grid[i]) / (grid[i + 1] - grid[i]);
					return { n: Math.round(t.counts[i] + f * (t.counts[i + 1] - t.counts[i])), exact: false };
				}
			}
			return { n: 0, exact: false };
		};

		const amt = document.getElementById('amt') as HTMLInputElement;
		const tween = (el: HTMLElement, to: number, suffix = '') => {
			const from = parseInt(el.textContent!.replace(/[^\d]/g, ''), 10) || 0;
			if (from === to) { el.textContent = nf(to) + suffix; return; }
			const t0 = performance.now();
			const dur = 320;
			const step = (t: number) => {
				const k = Math.min(1, (t - t0) / dur);
				const e = 1 - Math.pow(1 - k, 3);
				el.textContent = nf(Math.round(from + (to - from) * e)) + suffix;
				if (k < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		};

		const render = () => {
			const best = towns[0], worst = towns[towns.length - 1];
			for (const t of towns) {
				const row = root.querySelector(`[data-town="${t.slug}"]`) as HTMLElement;
				if (!row) continue;
				const sqm = Math.round(b / t.m2eur);
				const none = b < t.minPrice;
				row.classList.toggle('none', none);
				tween(row.querySelector('[data-sqm]') as HTMLElement, sqm);
				(row.querySelector('[data-fit]') as HTMLElement).hidden = none;
				(row.querySelector('[data-none]') as HTMLElement).hidden = !none;
				if (!none) {
					(row.querySelector('[data-desc]') as HTMLElement).textContent = sizeLabel(sqm);
					const c = countAt(t, b);
					(row.querySelector('[data-count]') as HTMLElement).textContent = (c.exact ? '' : '~') + nf(c.n);
					(row.querySelector('[data-link]') as HTMLAnchorElement).href =
						`https://propertylist.es/${lang}/portal/for-sale/${t.slug}?price_max=${b}`;
				}
			}
			const kb = root.querySelector('[data-kb]') as HTMLElement | null;
			if (kb) kb.textContent = eur(b);
			amt.value = nf(b);
			amt.style.width = `${Math.max(4, amt.value.length) + 0.6}ch`;
			root.querySelectorAll('.chip').forEach((c) => c.classList.toggle('on', parseInt((c as HTMLElement).dataset.chip!, 10) === b));
			const u = new URL(location.href);
			u.searchParams.set('b', String(b));
			history.replaceState(null, '', u);
			const wa = root.querySelector('[data-wa]') as HTMLAnchorElement | null;
			if (wa && best && worst) {
				const msg =
					lang === 'es'
						? `${eur(b)} son ${Math.round(b / best.m2eur)}m2 en ${best.name} pero solo ${Math.round(b / worst.m2eur)}m2 en ${worst.name}. Mira lo que compra tu presupuesto: ${u.href}`
						: `${eur(b)} buys ${Math.round(b / best.m2eur)}m2 in ${best.name} but only ${Math.round(b / worst.m2eur)}m2 in ${worst.name}. See what your budget gets: ${u.href}`;
				wa.href = `https://wa.me/?text=${encodeURIComponent(msg)}`;
			}
		};

		let evT: ReturnType<typeof setTimeout> | undefined;
		const setB = (v: number) => {
			b = Math.min(MAX, Math.max(MIN, Math.round(v)));
			render();
			clearTimeout(evT);
			evT = setTimeout(() => (window as any).umami?.track?.('budget-set', { b }), 900);
		};

		const stepFor = (v: number) => (v < 500000 ? 25000 : v < 1000000 ? 50000 : v < 3000000 ? 100000 : 250000);
		root.querySelectorAll('.step').forEach((btn) =>
			btn.addEventListener('click', () => {
				const dir = parseInt((btn as HTMLElement).dataset.step!, 10);
				const s = stepFor(dir < 0 ? b - 1 : b);
				setB(Math.round((b + dir * s) / s) * s);
			}),
		);
		root.querySelectorAll('.chip').forEach((c) =>
			c.addEventListener('click', () => setB(parseInt((c as HTMLElement).dataset.chip!, 10))),
		);
		amt.addEventListener('input', () => {
			const v = parseInt(amt.value.replace(/[^\d]/g, ''), 10);
			amt.style.width = `${Math.max(4, amt.value.length) + 0.6}ch`;
			if (v >= MIN && v <= MAX) { b = v; render(); }
		});
		amt.addEventListener('blur', () => setB(parseInt(amt.value.replace(/[^\d]/g, ''), 10) || b));
		amt.addEventListener('keydown', (e) => { if (e.key === 'Enter') amt.blur(); });
		// tapping the field replaces the whole number: nobody wants to backspace
		// through "1,250,000" on a phone before typing theirs
		amt.addEventListener('focus', () => amt.select());

		const cp = root.querySelector('[data-copy]') as HTMLElement | null;
		cp?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(location.href);
				cp.textContent = lang === 'es' ? 'Copiado' : 'Copied';
				setTimeout(() => (cp.textContent = lang === 'es' ? 'Copiar enlace' : 'Copy link'), 1600);
			} catch {}
		});

		amt.style.width = `${Math.max(4, amt.value.length) + 0.6}ch`;
		render();
	</script>
</Layout>
