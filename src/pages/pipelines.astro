---
import Layout from '../layouts/Layout.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/pipelines/`;
const title = 'CRM Pipelines for Estate Agents | PropertyList';
const description =
	'Seven specialised CRM pipeline boards that move every deal forward - Leads, Buyers, Sellers, Tenants, Property Lifecycle, Transactions and Nurture. Four free forever, pay-per-conversion on the rest.';

const boards = [
	{ name: 'Leads', tag: 'Free', desc: 'New enquiry triage. Every incoming lead lands here for fast qualification before it goes anywhere else.' },
	{ name: 'Buyers', tag: 'Credit', desc: 'Qualified purchasers, tracked from first viewing through offer to a closed sale.' },
	{ name: 'Sellers', tag: 'Credit', desc: 'The full vendor journey, from valuation to signed mandate to completion.' },
	{ name: 'Tenants', tag: 'Credit', desc: 'The rental pipeline - applicants moving through to a signed lease.' },
	{ name: 'Property Lifecycle', tag: 'Free', desc: 'Live stock status for every listing you manage, at a glance.' },
	{ name: 'Transactions', tag: 'Free', desc: 'The legal phase of every deal, tracked cleanly to completion.' },
	{ name: 'Nurture', tag: 'Free', desc: 'Past clients and referral opportunities, kept warm automatically.' },
];

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'What pipeline boards does the PropertyList CRM include?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Seven specialised Kanban boards that work together automatically: Leads, Buyers, Sellers, Tenants, Property Lifecycle, Transactions and Nurture.',
			},
		},
		{
			'@type': 'Question',
			name: 'How does the pipeline pricing work?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'The Buyers, Sellers and Tenants boards give you your first 5 conversions free forever, then 1 credit per conversion - charged only when you tag a contact as a real opportunity. Leads, Property Lifecycle, Transactions and Nurture are free without limit.',
			},
		},
		{
			'@type': 'Question',
			name: 'Do I have to set up the pipeline boards manually?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'No. All boards are configured automatically and every existing contact and property is backfilled onto the correct board on day one.',
			},
		},
	],
};
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

	<section class="hero">
		<div class="heroInner">
			<div class="kicker">CRM Pipelines</div>
			<h1>Seven boards that move every deal forward.</h1>
			<p class="lead">
				PropertyList gives every agency a complete CRM pipeline system - seven specialised Kanban boards that work together automatically, from
				the first enquiry to a closed deal and beyond. Four are free forever. You only pay when a lead becomes a real opportunity.
			</p>
			<div class="ctaRow" aria-label="Get started">
				<a class="btnPrimary" href="https://agents.propertylist.es/new-agent-signup/new" target="_blank" rel="noopener">
					Get started free
				</a>
				<a class="btnSecondary" href="/pricing/">See full pricing</a>
			</div>
			<div class="note">No credit card required.</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Seven boards, one workflow</h2>
			<p>
				Each board is purpose-built for a stage of the agency workflow, and contacts flow between them automatically as a deal progresses. No
				spreadsheets, no duplicate data entry, no leads slipping through the cracks.
			</p>
		</div>
		<div class="grid3" aria-label="Pipeline boards">
			{
				boards.map((b) => (
					<div class="card">
						<div class="boardHead">
							<h3>{b.name}</h3>
							<span class={b.tag === 'Free' ? 'tag tagFree' : 'tag tagCredit'}>{b.tag === 'Free' ? 'Free forever' : 'Pay per conversion'}</span>
						</div>
						<p>{b.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="grid2">
			<div class="card">
				<h2>Nothing to set up</h2>
				<p>
					All seven boards are configured automatically. On day one, every existing contact and property is backfilled onto the right board -
					no manual setup, no data migration, no blank screens to fill.
				</p>
			</div>
			<div class="card accent">
				<h2>Pay-per-conversion, not per seat</h2>
				<p>
					The Leads, Property Lifecycle, Transactions and Nurture boards are free, with no limits, forever.
				</p>
				<p>
					The Buyers, Sellers and Tenants boards give you your first 5 conversions free forever. After that it is 1 credit per conversion - and
					you are only charged when you tag a contact as a real opportunity. Never for an unqualified lead. No subscription, no lock-in.
				</p>
				<div class="pillRow">
					<span class="pill">5 free conversions</span>
					<span class="pill">1 credit each after</span>
					<span class="pill">4 boards free forever</span>
				</div>
			</div>
		</div>
	</section>

	<section class="section cta">
		<div class="ctaInner">
			<h2>Run your whole agency in one place</h2>
			<p>
				The core MLS and CRM are free forever - unlimited listings, unlimited staff, no setup fee. Add the conversion boards only when a lead is
				worth it.
			</p>
			<div class="ctaRow" aria-label="Join PropertyList">
				<a class="btnPrimary" href="https://agents.propertylist.es/new-agent-signup/new" target="_blank" rel="noopener">
					Agents: Get Started FREE
				</a>
				<a class="btnSecondary" href="/features/">See all features</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	:global(:root) {
		--pl-accent: #00ae9a;
		--pl-accent-rgb: 0, 174, 154;
	}

	h1,
	h2,
	h3 {
		letter-spacing: -0.03em;
	}

	.hero {
		border-radius: 22px;
		padding: 16px;
		margin: 0 0 16px;
		border: 1px solid rgba(16, 24, 40, 0.08);
		background:
			radial-gradient(1200px 600px at 20% -10%, rgba(var(--pl-accent-rgb), 0.22), rgba(255, 255, 255, 0)),
			radial-gradient(900px 500px at 90% 10%, rgba(var(--pl-accent-rgb), 0.12), rgba(255, 255, 255, 0));
	}

	.heroInner {
		background: rgba(255, 255, 255, 0.78);
		border: 1px solid rgba(16, 24, 40, 0.06);
		border-radius: 18px;
		padding: 18px;
	}

	.kicker {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(var(--pl-accent-rgb), 0.12);
		border: 1px solid rgba(var(--pl-accent-rgb), 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 900;
		font-size: 12px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 10px 0 10px;
		line-height: 1.06;
	}

	.lead {
		margin: 0 0 14px;
		color: rgba(16, 24, 40, 0.75);
		max-width: 78ch;
		line-height: 1.6;
	}

	.note {
		color: rgba(16, 24, 40, 0.65);
		font-weight: 700;
		font-size: 13px;
	}

	.section {
		margin: 0 0 14px;
	}

	.sectionHead {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
		margin-bottom: 12px;
	}

	.sectionHead p {
		margin: 8px 0 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.6;
		max-width: 88ch;
	}

	.grid2 {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.grid3 {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.card {
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.card.accent {
		border-color: rgba(var(--pl-accent-rgb), 0.25);
		background:
			linear-gradient(180deg, rgba(var(--pl-accent-rgb), 0.08), rgba(255, 255, 255, 0.86)),
			rgba(255, 255, 255, 0.86);
	}

	.card h2 {
		margin: 0 0 10px;
	}

	.card h3 {
		margin: 0;
		font-size: 16px;
	}

	.card p {
		margin: 0 0 10px;
		color: rgba(16, 24, 40, 0.78);
		line-height: 1.6;
	}

	.boardHead {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 8px;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		padding: 4px 8px;
		border-radius: 999px;
		font-weight: 900;
		font-size: 11px;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.tagFree {
		border: 1px solid rgba(var(--pl-accent-rgb), 0.3);
		background: rgba(var(--pl-accent-rgb), 0.12);
		color: rgba(16, 24, 40, 0.82);
	}

	.tagCredit {
		border: 1px solid rgba(16, 24, 40, 0.16);
		background: rgba(247, 248, 250, 0.9);
		color: rgba(16, 24, 40, 0.66);
	}

	.pillRow {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 4px;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		padding: 8px 10px;
		border-radius: 999px;
		border: 1px solid rgba(var(--pl-accent-rgb), 0.22);
		background: rgba(var(--pl-accent-rgb), 0.1);
		font-weight: 900;
		color: rgba(16, 24, 40, 0.86);
		font-size: 13px;
	}

	.cta {
		border-radius: 22px;
		padding: 16px;
		border: 1px solid rgba(var(--pl-accent-rgb), 0.22);
		background: radial-gradient(1200px 600px at 30% 0%, rgba(var(--pl-accent-rgb), 0.18), rgba(255, 255, 255, 0));
	}

	.ctaInner {
		background: rgba(255, 255, 255, 0.82);
		border: 1px solid rgba(16, 24, 40, 0.06);
		border-radius: 18px;
		padding: 16px;
	}

	.ctaInner p {
		margin: 8px 0 0;
		color: rgba(16, 24, 40, 0.75);
		line-height: 1.6;
		max-width: 90ch;
	}

	.ctaRow {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 14px;
	}

	.btnPrimary,
	.btnSecondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 12px 14px;
		border-radius: 14px;
		border: 1px solid rgba(16, 24, 40, 0.14);
		background: rgba(255, 255, 255, 0.92);
		text-decoration: none;
		font-weight: 950;
		color: rgba(16, 24, 40, 0.88);
	}

	.btnPrimary {
		border-color: rgba(var(--pl-accent-rgb), 0.35);
		background: rgba(var(--pl-accent-rgb), 0.14);
	}

	.btnPrimary:hover,
	.btnSecondary:hover {
		border-color: rgba(var(--pl-accent-rgb), 0.45);
	}

	@media (max-width: 980px) {
		.grid3 {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 860px) {
		.grid2 {
			grid-template-columns: 1fr;
		}
	}
</style>
