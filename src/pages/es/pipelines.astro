---
import Layout from '../../layouts/Layout.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/pipelines/`;
const title = 'Pipelines de CRM para Inmobiliarias | PropertyList';
const description =
	'Siete tableros de pipeline de CRM especializados que hacen avanzar cada operación - Leads, Buyers, Sellers, Tenants, Property Lifecycle, Transactions y Nurture. Cuatro gratis para siempre, pago por conversión en el resto.';

const boards = [
	{ name: 'Leads', tag: 'Free', desc: 'Clasificación de nuevas consultas. Cada lead entrante llega aquí para una cualificación rápida antes de ir a cualquier otro sitio.' },
	{ name: 'Buyers', tag: 'Credit', desc: 'Compradores cualificados, seguidos desde la primera visita hasta la oferta y la venta cerrada.' },
	{ name: 'Sellers', tag: 'Credit', desc: 'El recorrido completo del vendedor, desde la valoración al mandato firmado y la firma final.' },
	{ name: 'Tenants', tag: 'Credit', desc: 'El pipeline de alquiler - candidatos avanzando hasta un contrato firmado.' },
	{ name: 'Property Lifecycle', tag: 'Free', desc: 'Estado del stock en directo para cada anuncio que gestionas, de un vistazo.' },
	{ name: 'Transactions', tag: 'Free', desc: 'La fase legal de cada operación, seguida limpiamente hasta la firma.' },
	{ name: 'Nurture', tag: 'Free', desc: 'Clientes pasados y oportunidades de referidos, mantenidos activos automáticamente.' },
];

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: '¿Qué tableros de pipeline incluye el CRM de PropertyList?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Siete tableros Kanban especializados que funcionan juntos automáticamente: Leads, Buyers, Sellers, Tenants, Property Lifecycle, Transactions y Nurture.',
			},
		},
		{
			'@type': 'Question',
			name: '¿Cómo funciona el precio de los pipelines?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Los tableros Buyers, Sellers y Tenants te dan tus primeras 5 conversiones gratis para siempre, después 1 crédito por conversión - solo se cobra cuando etiquetas a un contacto como una oportunidad real. Leads, Property Lifecycle, Transactions y Nurture son gratis sin límite.',
			},
		},
		{
			'@type': 'Question',
			name: '¿Tengo que configurar los tableros de pipeline manualmente?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'No. Todos los tableros se configuran automáticamente y cada contacto y propiedad existente se distribuye en el tablero correcto desde el primer día.',
			},
		},
	],
};
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	hreflangs={[
		{ hreflang: 'en', href: `${origin}/pipelines/` },
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'x-default', href: `${origin}/pipelines/` },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

	<section class="hero">
		<div class="heroInner">
			<div class="kicker">Pipelines de CRM</div>
			<h1>Siete tableros que hacen avanzar cada operación.</h1>
			<p class="lead">
				PropertyList da a cada agencia un sistema completo de pipelines de CRM - siete tableros Kanban especializados que funcionan juntos
				automáticamente, desde la primera consulta hasta el cierre y más allá. Cuatro son gratis para siempre. Solo pagas cuando un lead se convierte en una oportunidad real.
			</p>
			<div class="ctaRow" aria-label="Empezar">
				<a class="btnPrimary" href="https://agents.propertylist.es/new-agent-signup/new" target="_blank" rel="noopener">
					Empieza gratis
				</a>
				<a class="btnSecondary" href="/es/pricing/">Ver precios completos</a>
			</div>
			<div class="note">Sin tarjeta de crédito.</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Siete tableros, un solo flujo</h2>
			<p>
				Cada tablero está creado a medida para una etapa del flujo de la agencia, y los contactos fluyen entre ellos automáticamente a medida que
				avanza la operación. Sin hojas de cálculo, sin duplicar datos, sin leads que se escapan.
			</p>
		</div>
		<div class="grid3" aria-label="Tableros de pipeline">
			{
				boards.map((b) => (
					<div class="card">
						<div class="boardHead">
							<h3>{b.name}</h3>
							<span class={b.tag === 'Free' ? 'tag tagFree' : 'tag tagCredit'}>{b.tag === 'Free' ? 'Gratis para siempre' : 'Pago por conversión'}</span>
						</div>
						<p>{b.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="grid2">
			<div class="card">
				<h2>Nada que configurar</h2>
				<p>
					Los siete tableros se configuran automáticamente. Desde el primer día, cada contacto y propiedad existente se distribuye en el tablero
					correcto - sin configuración manual, sin migración de datos, sin pantallas en blanco que rellenar.
				</p>
			</div>
			<div class="card accent">
				<h2>Pago por conversión, no por usuario</h2>
				<p>
					Los tableros Leads, Property Lifecycle, Transactions y Nurture son gratis, sin límites, para siempre.
				</p>
				<p>
					Los tableros Buyers, Sellers y Tenants te dan tus primeras 5 conversiones gratis para siempre. Después son 1 crédito por conversión - y
					solo se te cobra cuando etiquetas a un contacto como una oportunidad real. Nunca por un lead no cualificado. Sin suscripción, sin permanencia.
				</p>
				<div class="pillRow">
					<span class="pill">5 conversiones gratis</span>
					<span class="pill">1 crédito cada una después</span>
					<span class="pill">4 tableros gratis para siempre</span>
				</div>
			</div>
		</div>
	</section>

	<section class="section cta">
		<div class="ctaInner">
			<h2>Gestiona toda tu agencia en un solo lugar</h2>
			<p>
				El MLS y el CRM core son gratis para siempre - anuncios ilimitados, personal ilimitado, sin cuota de alta. Añade los tableros de conversión
				solo cuando un lead lo merezca.
			</p>
			<div class="ctaRow" aria-label="Únete a PropertyList">
				<a class="btnPrimary" href="https://agents.propertylist.es/new-agent-signup/new" target="_blank" rel="noopener">
					Agentes: Empieza GRATIS
				</a>
				<a class="btnSecondary" href="/es/features/">Ver todas las funciones</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	:global(:root) {
		--pl-accent: #00ae9a;
		--pl-accent-rgb: 0, 174, 154;
	}

	h1,
	h2,
	h3 {
		letter-spacing: -0.03em;
	}

	.hero {
		border-radius: 22px;
		padding: 16px;
		margin: 0 0 16px;
		border: 1px solid rgba(16, 24, 40, 0.08);
		background:
			radial-gradient(1200px 600px at 20% -10%, rgba(var(--pl-accent-rgb), 0.22), rgba(255, 255, 255, 0)),
			radial-gradient(900px 500px at 90% 10%, rgba(var(--pl-accent-rgb), 0.12), rgba(255, 255, 255, 0));
	}

	.heroInner {
		background: rgba(255, 255, 255, 0.78);
		border: 1px solid rgba(16, 24, 40, 0.06);
		border-radius: 18px;
		padding: 18px;
	}

	.kicker {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(var(--pl-accent-rgb), 0.12);
		border: 1px solid rgba(var(--pl-accent-rgb), 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 900;
		font-size: 12px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 10px 0 10px;
		line-height: 1.06;
	}

	.lead {
		margin: 0 0 14px;
		color: rgba(16, 24, 40, 0.75);
		max-width: 78ch;
		line-height: 1.6;
	}

	.note {
		color: rgba(16, 24, 40, 0.65);
		font-weight: 700;
		font-size: 13px;
	}

	.section {
		margin: 0 0 14px;
	}

	.sectionHead {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
		margin-bottom: 12px;
	}

	.sectionHead p {
		margin: 8px 0 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.6;
		max-width: 88ch;
	}

	.grid2 {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.grid3 {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.card {
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.card.accent {
		border-color: rgba(var(--pl-accent-rgb), 0.25);
		background:
			linear-gradient(180deg, rgba(var(--pl-accent-rgb), 0.08), rgba(255, 255, 255, 0.86)),
			rgba(255, 255, 255, 0.86);
	}

	.card h2 {
		margin: 0 0 10px;
	}

	.card h3 {
		margin: 0;
		font-size: 16px;
	}

	.card p {
		margin: 0 0 10px;
		color: rgba(16, 24, 40, 0.78);
		line-height: 1.6;
	}

	.boardHead {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 8px;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		padding: 4px 8px;
		border-radius: 999px;
		font-weight: 900;
		font-size: 11px;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.tagFree {
		border: 1px solid rgba(var(--pl-accent-rgb), 0.3);
		background: rgba(var(--pl-accent-rgb), 0.12);
		color: rgba(16, 24, 40, 0.82);
	}

	.tagCredit {
		border: 1px solid rgba(16, 24, 40, 0.16);
		background: rgba(247, 248, 250, 0.9);
		color: rgba(16, 24, 40, 0.66);
	}

	.pillRow {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 4px;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		padding: 8px 10px;
		border-radius: 999px;
		border: 1px solid rgba(var(--pl-accent-rgb), 0.22);
		background: rgba(var(--pl-accent-rgb), 0.1);
		font-weight: 900;
		color: rgba(16, 24, 40, 0.86);
		font-size: 13px;
	}

	.cta {
		border-radius: 22px;
		padding: 16px;
		border: 1px solid rgba(var(--pl-accent-rgb), 0.22);
		background: radial-gradient(1200px 600px at 30% 0%, rgba(var(--pl-accent-rgb), 0.18), rgba(255, 255, 255, 0));
	}

	.ctaInner {
		background: rgba(255, 255, 255, 0.82);
		border: 1px solid rgba(16, 24, 40, 0.06);
		border-radius: 18px;
		padding: 16px;
	}

	.ctaInner p {
		margin: 8px 0 0;
		color: rgba(16, 24, 40, 0.75);
		line-height: 1.6;
		max-width: 90ch;
	}

	.ctaRow {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 14px;
	}

	.btnPrimary,
	.btnSecondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 12px 14px;
		border-radius: 14px;
		border: 1px solid rgba(16, 24, 40, 0.14);
		background: rgba(255, 255, 255, 0.92);
		text-decoration: none;
		font-weight: 950;
		color: rgba(16, 24, 40, 0.88);
	}

	.btnPrimary {
		border-color: rgba(var(--pl-accent-rgb), 0.35);
		background: rgba(var(--pl-accent-rgb), 0.14);
	}

	.btnPrimary:hover,
	.btnSecondary:hover {
		border-color: rgba(var(--pl-accent-rgb), 0.45);
	}

	@media (max-width: 980px) {
		.grid3 {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 860px) {
		.grid2 {
			grid-template-columns: 1fr;
		}
	}
</style>
