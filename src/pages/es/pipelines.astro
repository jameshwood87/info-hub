<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
--teal:#00ae9a;--teal-dark:#008f7f;--teal-light:#f0fdfa;--teal-border:#99f6e4;
--slate:#0d2b2e;--slate-mid:#1a3f43;
--grey-dark:#111827;--grey-mid:#374151;--grey-light:#6b7280;--grey-xlight:#9ca3af;
--grey-bg:#f5f6f8;--white:#ffffff;
--font-sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
--font-serif:'Playfair Display',Georgia,serif
}
html{scroll-behavior:smooth}
body{font-family:var(--font-sans);background:var(--grey-bg);color:var(--grey-dark);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:var(--teal);text-decoration:none}
a:hover{text-decoration:underline}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
.sticky-nav{background:var(--white);border-bottom:1px solid #e8eaed;padding:0 24px;height:64px;display:flex;align-items:center;position:sticky;top:0;z-index:100}
.sticky-nav nav{display:flex;align-items:center;justify-content:space-between;width:100%;max-width:1080px;margin:0 auto}
.logo{font-weight:800;font-size:17px;color:var(--slate);font-family:var(--font-sans)}
.nav-links{display:flex;align-items:center;gap:4px;list-style:none}
.nav-links a{font-size:14px;font-weight:500;color:var(--grey-mid);padding:6px 12px;border-radius:6px;transition:all .15s}
.nav-links a:hover{color:var(--teal);background:var(--teal-light);text-decoration:none}
.cta{font-size:13px;font-weight:700;background:var(--teal);color:var(--white);padding:8px 18px;border-radius:7px;transition:all .15s}
.cta:hover{background:var(--teal-dark);text-decoration:none}
.container{max-width:1080px;margin:0 auto;padding:0 24px}
.container.grid{display:grid}

/* HERO */
.hero{background:linear-gradient(135deg,var(--teal) 0%,#0fcab1 50%,var(--teal) 100%);padding:56px 0 60px;text-align:center}
.hero-label{display:inline-block;padding:5px 14px;background:rgba(255,255,255,0.18);color:rgba(255,255,255,0.95);font-size:11px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;border-radius:999px;margin-bottom:20px}
.hero h1{font-size:40px;font-weight:800;color:var(--white);margin-bottom:16px;line-height:1.1;letter-spacing:-1px;font-family:var(--font-serif)}
.hero p{font-size:17px;color:rgba(255,255,255,.9);line-height:1.65;max-width:560px;margin:0 auto 32px}
.btn{display:inline-block;font-family:var(--font-sans);font-size:15px;font-weight:700;padding:13px 28px;border-radius:9px;border:none;cursor:pointer;transition:all .2s;text-decoration:none}
.btn-primary{background:var(--teal);color:var(--white);box-shadow:0 4px 14px rgba(0,174,154,.3)}
.btn-primary:hover{background:var(--teal-dark);box-shadow:0 6px 20px rgba(0,174,154,.4);text-decoration:none;transform:translateY(-1px)}
.btn-white{background:var(--white);color:var(--slate);box-shadow:0 4px 14px rgba(0,0,0,.12)}
.btn-white:hover{background:#f0f0f0;text-decoration:none}

/* KEY VALUE */
.key-value{padding:52px 0;border-bottom:1px solid #e8eaed}
.key-value h2{font-size:26px;font-weight:800;color:var(--slate);margin-bottom:10px;letter-spacing:-0.5px;font-family:var(--font-serif)}
.key-value p{font-size:15.5px;color:var(--grey-mid);line-height:1.6;max-width:640px}

/* FEATURE GRID */
.features{padding:52px 0;border-bottom:1px solid #e8eaed}
.features h2{font-size:22px;font-weight:700;color:var(--slate);margin-bottom:28px;font-family:var(--font-serif)}
.boards-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.board{background:var(--teal-light);border:1px solid var(--teal-border);border-radius:12px;padding:20px 18px}
.board-icon{font-size:22px;margin-bottom:10px;display:block}
.board h3{font-size:14px;font-weight:800;color:var(--slate);margin-bottom:5px}
.board p{font-size:12.5px;color:var(--grey-mid);line-height:1.5}

.key-value p strong, .features p strong{color:var(--slate)}

.features > .container > p{max-width:600px;font-size:15px;color:var(--grey-mid);line-height:1.65;margin-bottom:32px}
.features > .container > p + p{margin-top:-16px}

/* PRICING */
.pricing-block{background:var(--slate);padding:56px 0;text-align:center}
.pricing-block .label-tag{display:inline-block;padding:4px 12px;background:rgba(255,255,255,0.12);color:rgba(255,255,255,0.8);font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;border-radius:999px;margin-bottom:16px}
.pricing-block h2{font-size:28px;font-weight:700;color:var(--white);margin-bottom:10px;font-family:var(--font-serif)}
.pricing-block > .container > p{font-size:15px;color:rgba(255,255,255,.65);max-width:480px;margin:0 auto 28px}
.pricing-tiles{display:flex;justify-content:center;gap:16px;margin-bottom:28px;flex-wrap:wrap}
.tile{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:12px;padding:20px 24px;text-align:center;min-width:160px}
.tile .tile-num{font-size:36px;font-weight:800;color:var(--teal);display:block;font-family:var(--font-serif)}
.tile .tile-label{font-size:13px;color:rgba(255,255,255,0.7);margin-top:4px}
.tile .tile-sub{font-size:12px;color:rgba(255,255,255,0.5);margin-top:4px}
.free-note{font-size:14px;color:rgba(255,255,255,.6);max-width:500px;margin:0 auto 28px;line-height:1.6}
.free-note strong{color:var(--teal)}

/* RENTALS */
.rentals{padding:56px 0;background:var(--grey-bg)}
.rentals-card{background:var(--white);border:1px solid #e8eaed;border-radius:14px;padding:36px 40px;max-width:680px;margin:0 auto;text-align:center}
.rentals-card h3{font-size:22px;font-weight:700;color:var(--slate);margin-bottom:10px;font-family:var(--font-serif)}
.rentals-card p{font-size:14.5px;color:var(--grey-mid);line-height:1.65;margin-bottom:24px}
.rentals-card .tile-row{display:flex;justify-content:center;gap:32px;margin-bottom:28px;flex-wrap:wrap}
.rentals-card .tile-item{text-align:center}
.rentals-card .tile-item span{display:block;font-size:13px;color:var(--grey-xlight);margin-top:4px}

/* CTA BOTTOM */
.cta-bottom{background:linear-gradient(135deg,var(--slate) 0%,var(--slate-mid) 100%);padding:56px 0;text-align:center}
.cta-bottom h2{font-size:30px;font-weight:700;color:var(--white);margin-bottom:14px;font-family:var(--font-serif)}
.cta-bottom p{font-size:16px;color:rgba(255,255,255,.65);max-width:480px;margin:0 auto 28px}
.cta-bottom .note{font-size:12px;color:rgba(255,255,255,.4);margin-top:16px}

/* FOOTER */
.site-footer{background:var(--white);border-top:1px solid #e8eaed;padding:32px 0;text-align:center}
.site-footer p{font-size:13px;color:var(--grey-xlight)}

@media(max-width:900px){
.boards-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:600px){
.hero h1{font-size:28px}
.boards-grid{grid-template-columns:1fr}
.pricing-tiles{flex-direction:column;align-items:center}
.tile{width:100%;max-width:260px}
.rentals-card{padding:28px 24px}
.rentals-card .tile-row{gap:20px}
.nav-links{display:none}
}
</style>
<body>
  <!-- Navigation -->
  <header class="sticky-nav">
    <nav class="container">
      <a href="/es/" class="logo">PropertyList</a>
      <ul class="nav-links">
        <li><a href="/es/mls/">MLS</a></li>
        <li><a href="/es/crm/">CRM</a></li>
        <li><a href="/es/pricing/">Precios</a></li>
        <li><a href="/es/blog/">Blog</a></li>
        <li><a href="/pipelines/" hreflang="en">EN</a></li>
        <li><a href="https://agents.propertylist.es/es/signup" class="cta">Prueba gratis</a></li>
      </ul>
    </nav>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-label">Nuevo &middot; 7 pipelines &middot; Nuevos precios</div>
      <h1>Siete formas nuevas<br>de gestionar tu agencia.</h1>
      <p>Hemos rediseñado el CRM en torno a como funciona una agencia inmobiliaria de verdad: siete tableros especializados, un flujo completo de alquileres y un modelo de precios mas justo. Todo ya disponible en tu cuenta.</p>
      <a href="https://agents.propertylist.es/es/signup" class="btn btn-white">Abrir PropertyList &rarr;</a>
    </div>
  </section>

  <!-- Key Value -->
  <section class="key-value">
    <div class="container">
      <h2>Un tablero para cada parte de tu negocio.</h2>
      <p>Cada tablero es un Kanban arrastra-y-suelta. Marca un contacto como Comprador y aparece automaticamente en el tablero de Compradores. Indica que una operacion ha pagado senal y pasa al tablero de Transacciones. <strong>Los tableros se comunican entre si: tu no tienes que hacerlo.</strong></p>
    </div>
  </section>

  <!-- Feature Grid: 7 boards + done row -->
  <section class="features">
    <div class="container">
      <div class="boards-grid">
        <div class="board">
          <span class="board-icon">&#128229;</span>
          <h3>Leads</h3>
          <p>Cada consulta nueva en una vista de triaje. Decide quien es serio y quien solo mira.</p>
        </div>
        <div class="board">
          <span class="board-icon">&#127968;</span>
          <h3>Compradores</h3>
          <p>Compradores cualificados, desde verificacion de finanzas hasta oferta, cierre y seguimiento post-venta.</p>
        </div>
        <div class="board">
          <span class="board-icon">&#127969;</span>
          <h3>Vendedores</h3>
          <p>Recorrido del vendedor: valoracion, contrato de mandato, marketing, visitas, ofertas, intercambio, cierre.</p>
        </div>
        <div class="board">
          <span class="board-icon">&#128273;</span>
          <h3>Inquilinos</h3>
          <p>Alquileres de larga y corta estancia: referencias, fianzas, contrato, renovaciones. <em>Modulo de alquileres.</em></p>
        </div>
        <div class="board">
          <span class="board-icon">&#127960;</span>
          <h3>Ciclo de vida del inmueble</h3>
          <p>Prospeccion de cartera, activos, destacados, reducidos, en oferta, vendidos. Identifica inmuebles parados de un vistazo.</p>
        </div>
        <div class="board">
          <span class="board-icon">&#128209;</span>
          <h3>Transacciones</h3>
          <p>La fase legal: minuta, abogados, hipoteca, intercambio, cierre. Se activa automaticamente cuando hay acuerdo.</p>
        </div>
        <div class="board">
          <span class="board-icon">&#128155;</span>
          <h3>Nurture</h3>
          <p>Clientes anteriores que quieres mantener activos: aniversarios, peticiones de recomendaciones, actualizaciones de mercado, oportunidades de volver a contratar.</p>
        </div>
        <div class="board">
          <span class="board-icon">&#10004;</span>
          <h3>Tus datos ya estan en los tableros</h3>
          <p>Cada contacto e inmueble se coloca automaticamente en el pipeline correcto. Sin configuracion.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-block">
    <div class="container">
      <div class="label-tag">Solo pagas cuando funciona</div>
      <h2>Las primeras 5 conversiones son gratis.</h2>
      <p>Hemos cambiado los precios de todo-o-nada por algo mas justo. Solo pagas cuando un lead se convierte en una oportunidad real: nunca por los que no lo hacen.</p>
      <div class="pricing-tiles">
        <div class="tile">
          <span class="tile-num">5 gratis</span>
          <span class="tile-label">conversiones</span>
          <span class="tile-sub">etiqueta tus primeros cinco Compradores / Vendedores / Inquilinos sin coste. Para siempre.</span>
        </div>
        <div class="tile">
          <span class="tile-num">1 credito</span>
          <span class="tile-label">por conversion a partir deahi</span>
          <span class="tile-sub">unos 1€, cargado solo cuando etiquetas, nunca por leads no cualificados.</span>
        </div>
      </div>
      <p class="free-note"><strong>Leads</strong>, <strong>Ciclo de vida del inmueble</strong>, <strong>Transacciones</strong> y <strong>Nurture</strong> son ilimitados y completamente gratis. Sin suscripcion, sin permanencia, sin gasto minimo.</p>
      <a href="https://agents.propertylist.es/es/signup" class="btn btn-primary">Prueba gratis</a>
    </div>
  </section>

  <!-- Rentals -->
  <section class="rentals">
    <div class="container">
      <div class="rentals-card">
        <h3>Gestionas alquileres? Prueba el nuevo modulo de Rentas: gratis durante 30 dias.</h3>
        <p>Desbloquea el tablero de Inquilinos, un libro de arrendamientos real (renta, fianza, fechas), seguimiento de peticiones de mantenimiento, recordatorios automaticos de renovacion y una vista de cartera por propietario. Despues de la prueba: 50 creditos por 30 dias, sin cobro automatico.</p>
        <a href="https://agents.propertylist.es/es/signup" class="btn btn-primary">Prueba gratis</a>
        <p class="note" style="margin-top:14px;font-size:12px;color:var(--grey-xlight)">Un tour interactivo de 60 segundos te guIa por los nuevos tableros en tu primera visita al panel.</p>
      </div>
    </div>
  </section>

  <!-- CTA bottom -->
  <section class="cta-bottom">
    <div class="container">
      <h2>Listo para optimizar tus ventas?</h2>
      <p>Registrate y tus datos existentes se colocaran en los tableros correctos automaticamente.</p>
      <a href="https://agents.propertylist.es/es/signup" class="btn btn-primary">Abrir PropertyList &rarr;</a>
      <p class="note">Preguntas? Responde a este email: un persona real las lee.</p>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; 2026 PropertyList. Todos los derechos reservados.</p>
    </div>
  </footer>
</body>
