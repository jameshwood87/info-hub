---
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/pipelines/`;
const title = 'Pipelines de CRM para Inmobiliarias | PropertyList';
const description =
	'Seis pipelines de CRM que hacen avanzar solos cada lead, cada anuncio y cada cliente antiguo. Tus anuncios y tus vendedores son gratis. Tú eliges cuál de ellos merece un crédito.';

const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'es');
const plAgencies = statPlus(__ps.agencies, 'es');

const leaks = [
	{
		h: 'La consulta que esperó una hora',
		p: 'Entra mientras estás en una visita. Cuando respondes, ya han hablado con tres agencias más. El primero que dice algo útil suele quedarse con el cliente.',
	},
	{
		h: 'El seguimiento que hiciste de memoria',
		p: 'El primer día llamas. El tercero piensas hacerlo. El séptimo ya se fue. Nadie decide abandonar un lead. Pasa en los huecos entre visitas.',
	},
	{
		h: 'El cliente que ya cerraste',
		p: 'Te compró hace cuatro años. Cuando venda, llamará a quien siguió en contacto. Muchas veces no es el agente que le vendió la casa.',
	},
];

const pipelines = [
	{
		name: 'Leads',
		tag: 'Gratis',
		desc: 'Cada consulta entra aquí y recibe respuesta antes de que cojas el teléfono. Las etapas son fijas, así que nada se desvía.',
	},
	{
		name: 'Buyers',
		tag: '5 créditos al meter uno',
		desc: 'Financiación confirmada, visitas, oferta, negociación, arras, notaría y escritura firmada. Todo hasta cualificarlo es gratis. El crédito solo se gasta si decides que ese contacto merece entrar. Si dices que no, no pasa nada: se queda en tus contactos, simplemente no entra en el pipeline de Buyer.',
	},
	{
		name: 'Sellers',
		tag: 'Gratis',
		desc: 'Valoración agendada, valoración hecha, contrato firmado, fotos y anuncio publicado. Gratis a propósito: los anuncios son lo que más queremos.',
	},
	{
		name: 'Property',
		tag: 'Gratis',
		desc: 'Tu stock, de fuera de mercado hasta completado, con los días en mercado en cada tarjeta y recuperación en un clic si una venta se cae.',
	},
	{
		name: 'Tenants',
		tag: 'Módulo de Alquileres',
		desc: 'El camino hasta el contrato firmado, y después una tenancy que se renueva sola, revisa su renta y mantiene la fianza en regla.',
	},
	{
		name: 'Nurture',
		tag: 'Automatización',
		desc: 'Todos los que ya cerraste, en contacto, y devueltos a ti en cuanto muestran interés por volver a moverse.',
	},
];

const automatic = [
	'Entra un lead y recibe acuse al momento por email y WhatsApp, mientras a ti te llega una notificación.',
	'Se escribe por ti un plan de seguimiento en forma de tareas: día 0, día 1, día 3 y día 7, entre llamadas, WhatsApp y email.',
	'Cualificas el lead y se mueve solo al pipeline correcto, con la alerta de propiedad del cliente ya configurada con lo que te contó.',
	'Un anuncio se queda quieto y el tablero crea una tarea de revisión de precio en el intervalo que tú marques.',
	'Una tenancy se acerca a su fin, pasa a Renewal Pending y hace al inquilino y al propietario la pregunta correcta en el momento correcto.',
	'Una renta de larga duración le toca actualización anual, así que se calcula la renta permitida y se redacta la notificación al inquilino.',
];

const queue = [
	{ h: 'Primero los contactos calientes', p: 'Alguien que acaba de pinchar un enlace de valoración o ha abierto el mismo email tres veces esta semana, con el motivo en la tarjeta.' },
	{ h: 'Leads nuevos todavía a tiempo', p: 'Aquellos en los que responder en los próximos minutos aún decide quién se queda al cliente.' },
	{ h: 'Operaciones que se enfrían', p: 'Un comprador que lleva diez días en Viewings Booked y necesita un empujón hoy.' },
	{ h: 'Las personales', p: 'Es el cumpleaños de un cliente antiguo. El email ya salió. Veinte segundos de WhatsApp valen más.' },
];

const prices = [
	{ what: 'Pipelines de Leads, Sellers y Property', cost: 'Gratis, sin límite' },
	{ what: 'Lead de comprador', cost: '1 crédito, solo al meterlo en el pipeline de Buyer' },
	{ what: 'Módulo de Alquileres: Tenants, Tenancies y Maintenance', cost: '50 créditos / 30 días, prueba gratis de 30 días' },
	{ what: 'Automation y Nurture, con la Daily Action Queue incluida', cost: '20 créditos al mes' },
	{ what: 'Una consulta que resulta ser de otro agente', cost: 'Nunca se cobra' },
];

const faqs = [
	{
		q: '¿Qué cuesta realmente?',
		a: 'Los pipelines de Leads, Sellers y Property son gratis y sin límite. Un lead de comprador cuesta 1 crédito, que solo se gastan cuando decides meter ese contacto en el pipeline de Buyer. Cualificar no cuesta nada, y una consulta sin cualificar tampocola. Dos suscripciones cubren lo que funciona solo: el Módulo de Alquileres por 50 créditos por período de 30 días, gratis los primeros 30 días, y Automation y Nurture por 20 créditos al mes. Todo sale del mismo saldo de créditos que ya usas para destacar anuncios o sacar informes.',
	},
	{
		q: '¿Tengo que configurar algo de esto?',
		a: 'No. Los seis pipelines se configuran por ti, y tus contactos y propiedades actuales se colocan en el correcto desde el primer día. Los leads nuevos entran en New Lead y los anuncios nuevos en Active Listing. Puedes editar las etapas de Buyers y Property. Leads y Sellers son fijos para que los datos sigan siendo comparables entre agencias.',
	},
	{
		q: '¿Va a escribir a mis clientes sin que yo lo sepa?',
		a: 'Enviará, y siempre podrás ver exactamente qué. Cada contacto tiene un historial con lo que ha salido y lo que está programado, y puedes verlo, editarlo o saltártelo. El consentimiento de marketing se registra por contacto, se respetan las bajas, y ningún contacto recibe más de un email por semana, esté en las secuencias que esté. También puedes desactivar Nurture para una sola persona, o para un tipo de email, si sabes algo que el sistema no sabe.',
	},
	{
		q: '¿Qué pasa cuando otro agente pregunta por mi anuncio?',
		a: 'Se detecta solo, se etiqueta en rojo y nunca te cuesta un crédito. Además queda fuera de todos los emails automáticos, así que no le mandamos una valoración de vivienda a un agente colaborador. La etiqueta es un aviso, no un borrado, y se quita en un clic si nos equivocamos.',
	},
	{
		q: '¿Y si no contrato la suscripción de Automatización?',
		a: 'El tablero de Nurture se llena igual. Cada operación cerrada sigue colocando al contacto en él y los datos se siguen recogiendo, pero no se envía nada, y un contador te dice lo que ese mes habría salido. Si te suscribes más adelante, la máquina arranca con todo lo que lleva recogido y no desde cero.',
	},
];

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	hreflangs={[
		{ hreflang: 'en', href: `${origin}/pipelines/` },
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'x-default', href: `${origin}/pipelines/` },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

	<section class="hero">
		<div class="heroInner">
			<div class="kicker">El CRM de PropertyList</div>
			<h1>Casi ninguna operación se pierde contra otra agencia. Se pierde porque nadie hizo el seguimiento.</h1>
			<p class="lead">
				Seis pipelines que llevan hacia adelante, por su cuenta, cada lead, cada anuncio y cada cliente antiguo. Tus anuncios y tus vendedores
				siguen gratis. Tú eliges cuál de ellos merece un crédito.
			</p>
			<div class="ctaRow" aria-label="Únete a PropertyList">
				<a class="btnPrimary" href="https://agents.propertylist.es/new_agency/new?locale=es" target="_blank" rel="noopener">
					Crea tu cuenta de agencia gratis
				</a>
				<a class="btnSecondary" href="#que-cuesta">Ver qué cuesta</a>
			</div>
			<div class="note">{plAgencies} agencias y {plAgents} agentes ya están en la red. Sin tarjeta y sin coste de alta.</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Por dónde se escapa el dinero</h2>
			<p>No por ser mal agente. Por la semana normal de uno que va lleno.</p>
		</div>
		<div class="grid3">
			{
				leaks.map((l) => (
					<div class="card leakCard">
						<h3>{l.h}</h3>
						<p>{l.p}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Seis pipelines, un solo flujo</h2>
			<p>Cada uno cubre una parte del trabajo, y los contactos pasan de uno a otro según avanza la operación. Sin hojas de cálculo y sin teclear dos veces.</p>
		</div>
		<figure class="panelMock">
			<img
				src="/img/pipelines-board.png"
				alt="El tablero de Lead Pipeline de PropertyList: pestañas de Leads, Buyers, Sellers, Tenants, Properties y Nurture con su etiqueta de gratis o de pago, y tarjetas de leads en las etapas New Lead, Attempted Contact y Contacted"
				loading="lazy"
				width="1618"
				height="700"
			/>
			<figcaption>
				El Lead Pipeline tal y como se ve. Las pestañas de arriba son los seis tableros, cada uno con lo que cuesta, y el cronómetro de cada
				tarjeta es el tiempo que lleva esperando ese lead.
			</figcaption>
		</figure>
		<div class="grid3" aria-label="Pipelines del CRM">
			{
				pipelines.map((b) => (
					<div class="card">
						<div class="boardHead">
							<h3>{b.name}</h3>
							<span class={b.tag === 'Gratis' ? 'tag tagFree' : 'tag tagCredit'}>{b.tag}</span>
						</div>
						<p>{b.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Lo que pasa mientras estás en una visita</h2>
			<p>No son ajustes que tengas que acordarte de activar. Es lo que hacen los pipelines.</p>
		</div>
		<ol class="flowList">
			{automatic.map((a) => <li>{a}</li>)}
		</ol>
	</section>

	<section class="section">
		<div class="grid2">
			<div class="card">
				<h2>La parte que casi nadie hace</h2>
				<p>
					Toda agencia sabe que debería mantener el contacto con sus clientes antiguos. Casi ninguna lo hace más allá del primer mes, porque
					siempre hay una operación viva que hoy importa más.
				</p>
				<p>
					Nurture los mantiene sin ti. Cumpleaños, el aniversario del día que firmaron, una nota honesta sobre cuánto vale ahora su casa. Cuando
					uno pincha un enlace de valoración o abre el mismo email tres veces en una semana, los emails automáticos se paran y se te avisa de
					que llames, con el motivo delante.
				</p>
				<p>Un lead que se apaga en marzo compra muchas veces en octubre, normalmente con quien siguió en contacto.</p>
			</div>
			<div class="card accent">
				<h2>Puedes verlo antes de pagarlo</h2>
				<p>
					Sin la suscripción, el tablero de Nurture se llena igual. Cada operación cerrada sigue entrando, los datos se siguen recogiendo, y un
					contador te dice lo que ese mes habría enviado.
				</p>
				<p>
					No sale nada hasta que tú decides que salga. Y cuando te suscribes, arranca con todo lo que lleva recogido en vez de con una pantalla
					vacía.
				</p>
				<div class="pillRow">
					<span class="pill">20 créditos al mes</span>
					<span class="pill">Un email por contacto y semana</span>
					<span class="pill">Interruptor por contacto</span>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Una pantalla que responde "qué hago hoy"</h2>
			<p>
				El email es la parte que se puede automatizar. Las llamadas y WhatsApp son las que cierran. Así que la automatización envía lo que puede
				enviar y después te dice las pocas cosas que solo puedes hacer tú, ordenadas por lo que más probablemente genere dinero.
			</p>
		</div>
		<div class="grid2">
			{
				queue.map((q, i) => (
					<div class="card queueCard">
						<div class="queueNum">{i + 1}</div>
						<div>
							<h3>{q.h}</h3>
							<p>{q.p}</p>
						</div>
					</div>
				))
			}
		</div>
		<p class="quiet">
			La lista se limita a unas diez acciones al día, a propósito. Una cola corta que terminas es mejor que una completa que aprendes a ignorar.
			Cada tarjeta llama o abre WhatsApp con el mensaje ya escrito, y un toque registra cómo fue.
		</p>
	</section>

	<section class="section">
		<div class="grid2">
			<div class="card">
				<h2>Otros agentes nunca te cuestan un crédito</h2>
				<p>
					Agentes de otras agencias preguntan por tus anuncios todo el día, que es justo para lo que existe una red compartida. Cada lead que entra se comprueba contra el registro de agentes de la red, por
					email, por teléfono y por dominio de agencia.
				</p>
				<p>
					Una coincidencia se etiqueta en rojo, nunca cuesta un crédito y queda fuera de todos los emails automáticos, así que nadie manda una
					valoración de vivienda a un agente colaborador. Si nos equivocamos, un clic quita la etiqueta, y tu corrección se queda en tu cuenta en lugar de seguir a esa
					persona por toda la red.
				</p>
			</div>
			<div class="card" id="que-cuesta">
				<h2>Qué cuesta</h2>
				<ul class="priceList">
					{
						prices.map((p) => (
							<li>
								<span>{p.what}</span>
								<strong>{p.cost}</strong>
							</li>
						))
					}
				</ul>
				<p class="quiet">
					Un solo saldo de créditos cubre todo, el mismo que usas para destacar un anuncio o sacar un informe. Los créditos que compras no
					caducan.
				</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Las preguntas que hacen los agentes</h2>
		</div>
		<div class="faqList">
			{
				faqs.map((f) => (
					<details class="faqItem">
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<section class="section cta">
		<div class="ctaInner">
			<h2>Gratis para llevar tu agencia. Pagas cuando te traemos un comprador.</h2>
			<p>
				El MLS, el CRM, los anuncios ilimitados y las cuentas de equipo ilimitadas no cuestan nada. Activa las partes que trabajan mientras
				duermes cuando te merezcan la pena.
			</p>
			<div class="ctaRow" aria-label="Únete a PropertyList">
				<a class="btnPrimary" href="https://agents.propertylist.es/new_agency/new?locale=es" target="_blank" rel="noopener">
					Crea tu cuenta de agencia gratis
				</a>
				<a class="btnSecondary" href="/es/docs/propertylist-mls-manual-de-usuario/pipeline-and-tasks/pipeline/">Leer la guía de pipelines</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	:global(:root) {
		--pl-accent: #00ae9a;
		--pl-accent-rgb: 0, 174, 154;
	}

	h1,
	h2,
	h3 {
		letter-spacing: -0.03em;
	}

	.hero {
		border-radius: 22px;
		padding: 16px;
		margin: 0 0 16px;
		border: 1px solid rgba(16, 24, 40, 0.08);
		background:
			radial-gradient(1200px 600px at 20% -10%, rgba(var(--pl-accent-rgb), 0.22), rgba(255, 255, 255, 0)),
			radial-gradient(900px 500px at 90% 10%, rgba(var(--pl-accent-rgb), 0.12), rgba(255, 255, 255, 0));
	}

	.heroInner {
		background: rgba(255, 255, 255, 0.78);
		border: 1px solid rgba(16, 24, 40, 0.06);
		border-radius: 18px;
		padding: 18px;
	}

	.kicker {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(var(--pl-accent-rgb), 0.12);
		border: 1px solid rgba(var(--pl-accent-rgb), 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 900;
		font-size: 12px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 10px 0 10px;
		line-height: 1.06;
	}

	.lead {
		margin: 0 0 14px;
		color: rgba(16, 24, 40, 0.75);
		max-width: 78ch;
		line-height: 1.6;
	}

	.note {
		color: rgba(16, 24, 40, 0.65);
		font-weight: 700;
		font-size: 13px;
	}

	.section {
		margin: 0 0 14px;
	}

	.sectionHead {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
		margin-bottom: 12px;
	}

	.sectionHead p {
		margin: 8px 0 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.6;
		max-width: 88ch;
	}

	.grid2 {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.grid3 {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.card {
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.card.accent {
		border-color: rgba(var(--pl-accent-rgb), 0.25);
		background:
			linear-gradient(180deg, rgba(var(--pl-accent-rgb), 0.08), rgba(255, 255, 255, 0.86)),
			rgba(255, 255, 255, 0.86);
	}

	.card h2 {
		margin: 0 0 10px;
	}

	.card h3 {
		margin: 0;
		font-size: 16px;
	}

	.card p {
		margin: 0 0 10px;
		color: rgba(16, 24, 40, 0.78);
		line-height: 1.6;
	}

	.boardHead {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 8px;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		padding: 4px 8px;
		border-radius: 999px;
		font-weight: 900;
		font-size: 11px;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.tagFree {
		border: 1px solid rgba(var(--pl-accent-rgb), 0.3);
		background: rgba(var(--pl-accent-rgb), 0.12);
		color: rgba(16, 24, 40, 0.82);
	}

	.tagCredit {
		border: 1px solid rgba(16, 24, 40, 0.16);
		background: rgba(247, 248, 250, 0.9);
		color: rgba(16, 24, 40, 0.66);
	}

	.pillRow {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 4px;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		padding: 8px 10px;
		border-radius: 999px;
		border: 1px solid rgba(var(--pl-accent-rgb), 0.22);
		background: rgba(var(--pl-accent-rgb), 0.1);
		font-weight: 900;
		color: rgba(16, 24, 40, 0.86);
		font-size: 13px;
	}

	.cta {
		border-radius: 22px;
		padding: 16px;
		border: 1px solid rgba(var(--pl-accent-rgb), 0.22);
		background: radial-gradient(1200px 600px at 30% 0%, rgba(var(--pl-accent-rgb), 0.18), rgba(255, 255, 255, 0));
	}

	.ctaInner {
		background: rgba(255, 255, 255, 0.82);
		border: 1px solid rgba(16, 24, 40, 0.06);
		border-radius: 18px;
		padding: 16px;
	}

	.ctaInner p {
		margin: 8px 0 0;
		color: rgba(16, 24, 40, 0.75);
		line-height: 1.6;
		max-width: 90ch;
	}

	.ctaRow {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 14px;
	}

	.btnPrimary,
	.btnSecondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 12px 14px;
		border-radius: 14px;
		border: 1px solid rgba(16, 24, 40, 0.14);
		background: rgba(255, 255, 255, 0.92);
		text-decoration: none;
		font-weight: 950;
		color: rgba(16, 24, 40, 0.88);
	}

	.btnPrimary {
		border-color: rgba(var(--pl-accent-rgb), 0.35);
		background: rgba(var(--pl-accent-rgb), 0.14);
	}

	.btnPrimary:hover,
	.btnSecondary:hover {
		border-color: rgba(var(--pl-accent-rgb), 0.45);
	}

	@media (max-width: 980px) {
		.grid3 {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 860px) {
		.grid2 {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* ---- sales-page components (rewrite 2026-07-28) ---- */
	.leakCard h3 {
		margin: 0 0 6px;
		font-size: 16.5px;
	}
	.leakCard p {
		margin: 0;
		color: rgba(16, 24, 40, 0.7);
		line-height: 1.6;
	}

	.flowList {
		list-style: none;
		counter-reset: flow;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 10px;
	}
	.flowList li {
		counter-increment: flow;
		position: relative;
