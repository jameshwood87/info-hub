---
import Layout from '../../layouts/Layout.astro';

// Gemelo en espanol de /rentals/, reconstruido el 09-10-26. Mismo fondo que la pagina anterior, nueva forma: capas, detalle
// detras de un toque, tarjeta de plan. El bloque legal y cada respuesta de las preguntas frecuentes se mantienen palabra por
// palabra de la pagina revisada contra el BOE el 08-10-26 (RDL 29/2026). Precio: 50 creditos por 30 dias, 30 dias gratis, y
// los leads de alquiler vienen con el modulo sin cargo por lead.
const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/alquileres/`;
const title = 'Módulo de Gestión de Alquileres para Inmobiliarias | PropertyList';
const description =
	'Alquiler de larga duración en tu CRM: pipeline de inquilinos, renovaciones, actualización de renta, incidencias y fianzas. 30 días gratis.';
const signup = 'https://agents.propertylist.es/new_agency/new?locale=es';

const waysIn = [
	['Importar CSV.', 'Un botón arriba del todo en la pantalla de contratos, no un ajuste escondido. Sube de una vez toda una cartera de alquileres.'],
	['Desde la operación.', 'Una operación de alquiler que llega a Contrato firmado crea su propio contrato: propiedad, inquilino, propietario, fechas, renta y fianza. Tú rellenas los huecos.'],
	['A mano.', 'Nuevo contrato, para los acuerdos que todavía no están en ningún sitio.'],
];

const stages = ['Lead de alquiler', 'Cualificado, criterios definidos', 'Propiedades que encajan', 'Visitas agendadas', 'Visitas en curso', 'Negociando', 'Reserva pagada', 'Revisión del contrato', 'Contrato firmado', 'Fianza pagada', 'Pendiente de entrada', 'Contrato activo', 'Renovación pendiente'];
const keyStages = [9, 12];

const features = [
	{ name: 'Pipeline de Tenants (inquilinos)', line: 'Trece etapas, de la consulta al contrato activo.', desc: 'Trece etapas desde la primera consulta hasta el contrato activo, en su propio tablero, junto al pipeline de ventas que ya llevas.' },
	{ name: 'Contratos que se mantienen al día', line: 'Borrador, Activo, Próximo a vencer, sin que lo muevas.', desc: 'Un registro por contrato. Borrador, luego Activo cuando llega la fecha de inicio, y Próximo a vencer cuando se abre la ventana de renovación. No lo mueves tú.' },
	{ name: 'Tu cartera actual, importada', line: 'CSV para toda la cartera, a mano para casos sueltos.', desc: 'Importación CSV para toda una cartera de alquileres, alta manual para casos sueltos, y las operaciones nuevas crean su propio contrato.' },
	{ name: 'Avisos de renovación', line: 'Te avisa antes de que acabe el contrato, a 60, 90 o 120 días.', desc: 'El contrato pasa a Renovación pendiente y te avisa antes de que venza, con una ventana que configuras en 60, 90 o 120 días.' },
	{ name: 'Actualización anual de la renta', line: 'La renta que corresponde, y el aviso redactado.', desc: 'Sabe el aniversario y la renta actual, calcula la renta que corresponde según el índice oficial y redacta el borrador del aviso.' },
	{ name: 'Seguimiento de fianzas y registro de auditoría', line: 'Cada cambio con fecha y hora junto al agente responsable.', desc: 'Pendiente, Depositada, y después Devuelta o retenida en parte, con fecha y hora en cada cambio junto al agente responsable, y vigilando el plazo de depósito donde tu comunidad lo siga exigiendo.' },
	{ name: 'Incidencias que abre el inquilino', line: 'Un enlace mágico, fotos, sin registro.', desc: 'El inquilino abre su incidencia con un enlace mágico y fotos, sin registrarse, y llega ya vinculada a su contrato. Tú clasificas, no transcribes.' },
	{ name: 'Umbrales de aprobación del propietario', line: 'Lo pequeño sigue adelante; lo grande necesita un clic.', desc: 'Las reparaciones pequeñas salen solas. Por encima del umbral, el propietario recibe fotos y presupuesto y aprueba o rechaza en un clic.' },
	{ name: 'Panel de alquileres', line: 'Rent roll, tus ingresos, fianzas, acciones pendientes.', desc: 'Contratos activos, los que vencen en 60 días, rent roll mensual, tus ingresos del mes como comisión de gestión al porcentaje fijado en cada contrato, fianzas y acciones pendientes, además de tu media de días hasta resolver.' },
];

const lanes = [
	{ who: 'Inquilino', steps: ['Abre el <b>enlace mágico</b> que recibió en la entrada y que se repite en sus correos. Sin registro y sin app.', 'Describe el problema y <b>añade fotos</b>. Un fontanero que presupuesta con dos fotos se ahorra muchas veces la visita.', 'Confirma la reparación al final, que es lo que cierra la incidencia.'] },
	{ who: 'Tú', steps: ['La incidencia llega <b>ya vinculada</b> al contrato, al inquilino y a la propiedad. Tú la clasificas.', 'La mandas a un proveedor del <b>directorio</b>, con descripción, fotos y dirección ya puestas. Se van acumulando tiempos de respuesta y costes por proveedor.', 'Registras <b>quién paga</b>: propietario, inquilino, agencia o a partes.'] },
	{ who: 'Propietario', steps: ['Nada, si el coste está por debajo del <b>umbral de aprobación</b> que tienes guardado para él.', 'Por encima, un correo con el problema, las fotos y el presupuesto.', '<b>Aprueba o rechaza</b> en un clic, y la decisión queda registrada por si algún día se discute.'] },
];

const tiles = ['Contratos activos', 'Vencen en 60 días', 'Rent roll mensual', 'Tus ingresos del mes', 'Fianzas', 'Acciones pendientes'];

const included = [
	'El pipeline de Tenants, trece etapas',
	'Las consultas de tus anuncios de alquiler entran directamente en el pipeline de inquilinos, y puedes añadir tus propios leads. Sin cargo por lead',
	'Contratos que se actualizan solos',
	'Importación CSV de tu cartera actual',
	'Avisos de renovación y actualización anual de la renta',
	'Seguimiento de fianzas con registro de auditoría',
	'Incidencias por enlace mágico, con umbrales de aprobación del propietario',
	'El panel de alquileres',
];

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{ '@type': 'Question', name: '¿Puedo meter los contratos que ya llevo?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. Importar CSV está arriba del todo en la pantalla de contratos y sube de una vez toda una cartera de alquileres. Hay alta manual para casos sueltos, y cualquier operación de alquiler nueva crea su contrato automáticamente al llegar a Contrato firmado, con los datos de la operación ya rellenados.' } },
		{ '@type': 'Question', name: '¿Qué incluye el módulo de Alquileres?', acceptedAnswer: { '@type': 'Answer', text: 'Un pipeline de inquilinos de trece etapas, contratos que pasan solos por Borrador, Activo, Próximo a vencer y después Renovado, Prorrogado o Finalizado, avisos de renovación con la ventana que configures, la actualización anual de la renta según el índice oficial, seguimiento de fianzas con registro de auditoría, incidencias que abre el inquilino con enlace mágico, umbrales de aprobación del propietario y directorio de proveedores, y un panel con contratos activos, los que vencen, rent roll, tus ingresos del mes, fianzas y acciones pendientes. Cubre el alquiler de larga duración.' } },
		{ '@type': 'Question', name: '¿Cuánto cuesta el módulo y qué pasa cuando acaba la prueba?', acceptedAnswer: { '@type': 'Answer', text: 'Los primeros 30 días son gratis y no hace falta tarjeta. Cuando acaba la prueba no se cobra nada. Si quieres seguir, te suscribes, y a partir de ahí son 50 créditos por período de 30 días que salen de tu saldo de créditos. Puedes activar la recarga automática para que una tarjeta guardada reponga el saldo en vez de que el módulo se pause, y puedes dar de baja la suscripción cuando quieras.' } },
		{ '@type': 'Question', name: '¿Qué pasa con mis contratos si dejo de pagar el módulo?', acceptedAnswer: { '@type': 'Answer', text: 'No se borra nada. El módulo se oculta hasta que vuelvas a suscribirte, y tus contratos, fianzas e historial de reparaciones están exactamente donde los dejaste cuando vuelve.' } },
		{ '@type': 'Question', name: '¿Cambia algo en la parte de ventas de mi agencia?', acceptedAnswer: { '@type': 'Answer', text: 'No. El mismo acceso, los mismos contactos, las mismas propiedades y el mismo pipeline de ventas. El módulo añade una sección de Alquileres con Tenancies y Maintenance, y el tablero de Tenants.' } },
		{ '@type': 'Question', name: '¿Los inquilinos y los propietarios necesitan cuenta?', acceptedAnswer: { '@type': 'Answer', text: 'No. El inquilino abre incidencias con un enlace mágico que se le envía en la entrada y se repite en sus correos, con fotos y sin registrarse. El propietario aprueba o rechaza desde un correo, en un clic, cuando el trabajo supera su umbral.' } },
		{ '@type': 'Question', name: '¿El módulo de Alquileres me mantiene al día con la ley de alquiler española?', acceptedAnswer: { '@type': 'Answer', text: 'Te da la prueba documental, no el cumplimiento normativo. El registro de auditoría marca con fecha y hora cada cambio de estado y de fianza junto al agente responsable, que es de lo que depende una disputa de fianza según el art. 36 de la LAU. No deposita fianzas ante ningún organismo autonómico ni emite el número de registro de arrendamiento: eso sigue siendo obligación tuya. Tampoco comunica nada a la policía. El registro de viajeros ante la policía (RD 933/2021) se aplica a las actividades de hospedaje, y el registro de viajeros automático llegará solo para las reservas vacacionales.' } },
		{ '@type': 'Question', name: '¿Sirve para el alquiler vacacional?', acceptedAnswer: { '@type': 'Answer', text: 'Hoy no. Las reservas, las tarifas por noche, la sincronización de canales y el registro de viajeros ante la policía están en la hoja de ruta, y la página de alquiler vacacional cuenta qué llega y recoge tu nombre. Si tu cartera es vacacional y no de larga duración, todavía no es tu herramienta. Los contratos de temporada quedan en medio: escríbenos antes de mover una cartera de temporada.' } },
	],
};
const breadcrumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
	{ '@type': 'ListItem', position: 1, name: 'Inicio', item: `${origin}/es/` },
	{ '@type': 'ListItem', position: 2, name: 'Funciones', item: `${origin}/es/funciones/` },
	{ '@type': 'ListItem', position: 3, name: 'Módulo de Alquileres', item: canonical },
] };
---
<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	ogImage="https://info.propertylist.es/og/og-rentals-es.jpg"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: `${origin}/rentals/` },
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'x-default', href: `${origin}/rentals/` },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<section class="hero"><div class="cx">
		<p class="kicker">Módulo de Alquileres</p>
		<h1>Tu cartera de alquileres, <b>fuera de la hoja de cálculo.</b></h1>
		<p class="lead">Alquiler de larga duración dentro del CRM que ya usas para vender. <strong>Un registro por contrato que avisa por sí solo de sus renovaciones, e incidencias que abre el inquilino y que, por encima del umbral que fijes, aprueba el propietario.</strong></p>
		<p class="ctaRow"><a class="btn" href={signup} target="_blank" rel="noopener">Empezar la prueba gratis</a> <a class="btnLink" href="#pricing">Cuánto cuesta</a></p>
		<p class="fric">Gratis durante 30 días, sin tarjeta y sin cobro al acabar la prueba. ¿Ya estás en PropertyList? Abre la pestaña de Alquileres en tu cuenta.</p>
		<nav class="modes" aria-label="Qué tipo de alquiler llevas">
			<a class="mode here" href="/es/alquileres/" aria-current="page"><b>Alquiler de larga duración</b><span>Ya funciona. Prueba gratis de 30 días.</span></a>
			<a class="mode" href="/es/alquiler-vacacional/"><b>Alquiler vacacional y de corta duración</b><span>Próximamente. Las normas que ya se aplican, y la lista de espera.</span></a>
		</nav>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Empieza por los contratos <b>que ya llevas.</b></h2>
		<p class="sub">Tres formas de entrar, y ninguna es volver a teclearlo todo.</p>
		<div class="steps">
			{waysIn.map(([h, p]) => (<div class="step"><h3>{h}</h3><p>{p}</p></div>))}
		</div>
		<p class="quiet">En la parte de ventas no cambia nada. El mismo acceso, los mismos contactos, las mismas propiedades y el mismo <a href="/es/pipelines/">pipeline de ventas</a>. El módulo añade una sección de Alquileres con Tenancies y Maintenance, y el tablero de Tenants.</p>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>De la consulta <b>al contrato firmado.</b></h2>
		<p class="sub">El pipeline de Tenants, tal y como sale. Trece etapas, y dos de ellas trabajan por ti.</p>
		<ol class="stages" aria-label="Las trece etapas del pipeline de Tenants">
			{stages.map((s, i) => (<li class={keyStages.includes(i + 1) ? 'on' : ''}><span>{i + 1}</span>{s}</li>))}
		</ol>
		<div class="beats">
			<p><b>9. En Contrato firmado</b> el contrato se crea solo a partir de la operación, y tu propiedad pasa a reservada. Si la propiedad es de otra agencia, le llega un correo pidiéndole que la actualice, porque PropertyList no cambia la propiedad de otra agencia. Una herramienta de alquileres sin más agencias dentro no puede hacer esto por ningún precio.</p>
			<p><b>12. En Contrato activo</b> se te piden las fechas, los datos del inquilino y del propietario y el consentimiento de marketing, y los dos entran en <a href="/es/nurture/">Nurture</a>.</p>
		</div>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Qué incluye. <b>Abre cualquier línea.</b></h2>
		<p class="sub">Nueve cosas que hace el módulo, casi todas sin que se lo pidas. Todo esto es alquiler de larga duración.</p>
		<div class="feats">
			{features.map((f) => (
				<details>
					<summary><span class="fName">{f.name}</span><span class="fLine">{f.line}</span></summary>
					<p>{f.desc}</p>
				</details>
			))}
		</div>
		<div class="states" aria-label="La vida de un contrato">
			<span>Borrador</span><span>Activo</span><span>Próximo a vencer</span><span class="end">Renovado, Prorrogado o Finalizado</span>
		</div>
		<p class="quiet">Una renovación encadena un contrato nuevo vinculado, así que el historial no se pierde. Un registro por contrato, y su estado sigue las fechas en vez de esperar a que alguien se acuerde.</p>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>Una reparación, del móvil del inquilino <b>a cerrada.</b></h2>
		<p class="sub">La parte que se come la semana de un agente de alquileres. Tres partes, un solo hilo.</p>
		<div class="lanes">
			{lanes.map((l) => (
				<div class="lane">
					<h3>{l.who}</h3>
					<ol>{l.steps.map((s) => <li set:html={s}></li>)}</ol>
				</div>
			))}
		</div>
		<p class="quiet">Las urgencias, una fuga o quedarse sin agua o cualquier cosa eléctrica, van directas a la Daily Action Queue con un temporizador de SLA. Lo que lleva una semana parado sale a la superficie como una operación atascada. La revisión anual de la caldera y el certificado de gas abren su propia incidencia en el aniversario.</p>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Seis números, <b>una pantalla.</b></h2>
		<p class="sub">El panel de alquileres, para contestar a un propietario sin abrir una hoja de cálculo.</p>
		<div class="tiles">
			{tiles.map((t) => <div>{t}</div>)}
		</div>
		<p class="quiet">Tus ingresos del mes son tu comisión de gestión, al porcentaje fijado en cada contrato, así que el rent roll y lo que de verdad te deja están uno al lado del otro. Además de tu media de días hasta resolver una incidencia, y vistas de activos, próximos a vencer, finalizados y todos.</p>
	</div></section>

	<section class="band dark"><div class="cx">
		<h2>Creado para la ley <b>de alquiler española.</b></h2>
		<p class="alt">El registro de auditoría marca con fecha y hora cada cambio de estado y de fianza junto al agente responsable, dándote prueba documental para una disputa de fianza según el art. 36 de la LAU y la normativa de fianzas de tu comunidad.</p>
		<p class="alt">Se acabó reconstruir quién cambió qué, y cuándo, una vez que la disputa ya ha empezado.</p>
		<p class="lawNote">Dos plazos que el módulo registra pero no decide por ti. Para que un contrato no se prorrogue una vez cumplido su plazo mínimo, el art. 10 de la LAU da cuatro meses al arrendador y dos al inquilino; desde el 15 de noviembre de 2026, si se convalida, el RDL 28/2026 elevaría el preaviso del arrendador a seis meses y, salvo excepciones, le obligaría a indemnizar al inquilino por no prorrogar, con reglas transitorias para los contratos en curso (los que tengan menos de seis meses por delante en esa fecha mantienen los cuatro meses). Y desde el 24 de enero de 2026 la Junta de Andalucía ya no es depositaria de las fianzas (Ley 5/2025, DA 6&ordf;): el arrendador andaluz conserva la fianza. En Cataluña, Madrid y Valencia el depósito sigue siendo obligatorio. Las fianzas depositadas en Andalucía antes de esa fecha las devuelve la Junta a medida que se extinguen esos contratos, a solicitud de los interesados. <a href="/es/docs/leyes-procedimientos/renting-a-property/long-term/tenancy-agreements/">Las reglas completas</a>.</p>
	</div></section>

	<section class="band tint" id="pricing"><div class="cx costGrid">
		<div class="plan">
			<p class="planName">Módulo de Alquileres</p>
			<p class="planPrice">50 créditos</p>
			<p class="planNote">por período de 30 días, de tu saldo de créditos. Los primeros 30 días son gratis y no hace falta tarjeta.</p>
			<ul class="checks">
				{included.map((i) => <li>{i}</li>)}
			</ul>
			<a class="btn" href={signup} target="_blank" rel="noopener">Empezar la prueba gratis</a>
		</div>
		<div>
			<h2>Cuánto <b>cuesta.</b></h2>
			<p class="sub">Cuando acaba la prueba no se cobra nada. Si te quedas, activa la recarga automática y una tarjeta guardada repone el saldo en vez de que el módulo se pause.</p>
			<p class="sub">Puedes dar de baja la suscripción cuando quieras. No se borra nada: el módulo se oculta hasta que vuelvas a suscribirte, con tus contratos, fianzas e historial de reparaciones donde los dejaste.</p>
		</div>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Lo que <b>no hace.</b></h2>
		<p class="sub">Mejor saberlo antes de empezar la prueba que durante.</p>
		<div class="nots">
			<div>
				<h3>No está en el módulo</h3>
				<ul>
					<li><b>No deposita tus fianzas.</b> Donde tu comunidad siga exigiendo el depósito, el contrato lo registra y te avisa antes de que se cierre el plazo. Presentarlo sigue siendo cosa tuya.</li>
					<li><b>No comunica nada a la policía ni emite números de registro.</b> El registro de viajeros ante la policía (RD 933/2021) se aplica a las actividades de hospedaje. Para las reservas vacacionales, el registro de viajeros automático <a href="/es/alquiler-vacacional/">está en camino</a>. Mira <a href="/es/docs/leyes-procedimientos/renting-a-property/short-term-holiday/guest-registration-police/">el registro de viajeros ante la policía</a> para la obligación en sí.</li>
					<li><b>Contratos de temporada.</b> El módulo está pensado para el alquiler de larga duración, y la actualización anual de la renta en particular da por hecho una renta de larga duración. Escríbenos antes de mover una cartera de temporada.</li>
				</ul>
			</div>
			<div>
				<h3>En la hoja de ruta</h3>
				<ul>
					<li><b>Alquiler vacacional y de corta duración.</b> Las reservas, las tarifas por noche, la sincronización de canales y el registro de viajeros llegarán más adelante. Si tu cartera es vacacional y no de larga duración, <a href="/es/alquiler-vacacional/">mira qué se está construyendo y deja tu nombre</a>.</li>
					<li><b>Informe al propietario.</b> Un informe periódico por propietario con las reparaciones hechas, su coste, las facturas, el estado de la fianza y el rent roll. Cada incidencia ya registra quién paga, así que los datos estarán ahí cuando salga.</li>
				</ul>
			</div>
		</div>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>Preguntas.</h2>
		<div class="faqwrap">
			{faqLd.mainEntity.map((qa) => (<details class="faqItem"><summary>{qa.name}</summary><p>{qa.acceptedAnswer.text}</p></details>))}
		</div>
	</div></section>

	<section class="band close"><div class="cx">
		<h2>Gestiona alquileres en el mismo sitio <b>que las ventas.</b></h2>
		<p class="alt">Un solo acceso, una sola base de contactos, un solo flujo para toda la agencia. ¿Ya estás en PropertyList? La pestaña de Alquileres está en tu cuenta, con Tenancies y Maintenance dentro.</p>
		<p class="ctaRow"><a class="btn btnLight" href={signup} target="_blank" rel="noopener">Empezar la prueba gratis</a> <a class="ghost" href="/es/docs/propertylist-mls-manual-de-usuario/pipeline-and-tasks/rentals-module/">Leer el capítulo del manual</a></p>
	</div></section>
</Layout>

<style>
	.cx { width: min(1120px, 100% - 32px); margin: 0 auto; }
	.hero { padding: 28px 0 40px; }
	.kicker { font-size: 17px; font-weight: 700; color: #0a6d61; margin: 0 0 14px; }
	h1 { font-size: 44px; line-height: 1.04; letter-spacing: -0.03em; font-weight: 800; margin: 0; max-width: 19ch; }
	h1 b, h2 b { color: #008a7a; }
	.lead { font-size: 19px; line-height: 1.5; color: #28383f; margin: 18px 0 24px; max-width: 52ch; }
	.lead strong { color: #0b1b22; }
	.ctaRow { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
	.btn { display: inline-block; background: #0a6d61; color: #fff; font-weight: 800; font-size: 18px; padding: 16px 24px; border-radius: 14px; text-decoration: none; }
	.btn:hover { background: #08584e; }
	.btnLink { font-weight: 700; color: #0a6d61; text-decoration: underline; text-underline-offset: 3px; }
	.fric { font-size: 15px; color: #5b6b73; margin: 12px 0 0; max-width: 60ch; }
	.film { margin: 32px 0 0; }
	.film video, .film .still { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; border-radius: 16px; border: 1px solid #e2e5e3; box-shadow: 0 24px 50px rgba(11, 27, 34, 0.12); background: #f4f7f8; }
	.film .still { display: none; }
	@media (prefers-reduced-motion: reduce) { .film video { display: none; } .film .still { display: block; } }
	.film figcaption { margin-top: 10px; font-size: 13px; line-height: 1.55; color: #5b6b73; max-width: 80ch; }
