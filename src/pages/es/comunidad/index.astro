---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
	lang="es"
	title="Comunidad • PropertyList Info Hub"
	description="Haz preguntas y comparte conocimiento con la comunidad de PropertyList."
	canonical="https://info.propertylist.es/es/comunidad/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/community/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/comunidad/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/community/' },
	]}
>
	<h1>Comunidad</h1>
	<p class="sub">Haz preguntas y comparte conocimiento con la comunidad de PropertyList.</p>

	<div class="grid">
		<div class="tile">
			<h2>Foro</h2>
			<p>Próximamente.</p>
		</div>
		<div class="tile">
			<h2>Tutoriales en vídeo</h2>
			<p>Próximamente.</p>
		</div>
	</div>
</Layout>

<style>
	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.03em;
	}

	.sub {
		margin: 0 0 18px;
		color: rgba(16, 24, 40, 0.7);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.tile {
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 14px;
	}

	.tile h2 {
		margin: 0 0 8px;
		font-size: 16px;
		letter-spacing: -0.01em;
	}

	.tile p {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
	}

	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>

