---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs/promises';

export const prerender = false;

// Areas come from the same store the property finder uses, so the two stay in step.
let areas: Array<{ slug: string; name: string }> = [];
try {
	const d = JSON.parse(await fs.readFile('/opt/info-hub/var/admin/finder-counts.json', 'utf8'));
	areas = (d.areas || []).map((a: any) => ({ slug: a.slug, name: a.name })).filter((a: any) => a.slug && a.name);
} catch {}

const faqs = [
	{
		q: '¿Esto es una tasación?',
		a: 'No. En España una tasación formal solo puede emitirla una sociedad de tasación homologada conforme a la Orden ECO/805/2003, normalmente para una hipoteca. Esto es una guía orientativa de mercado construida con datos reales de transacciones, para que sepas aproximadamente dónde se sitúa tu propiedad antes de hablar con nadie.',
	},
	{
		q: '¿De dónde salen los números?',
		a: 'De precios de venta registrados en el registro notarial español, publicados a través de nuestro Price Oracle, más los precios de salida en vivo de la red PropertyList. La mayoría de portales solo pueden mostrarte precios de salida, que es lo que esperan los vendedores y no lo que pagaron los compradores.',
	},
	{
		q: '¿Por qué el precio registrado es más bajo que lo que veo anunciado?',
		a: 'Porque el precio de salida es una posición de partida. La diferencia entre ambos es el dato más útil que puede conocer quien vende antes de fijar un precio, y explica por qué una propiedad valorada solo con anuncios de portales suele quedarse parada.',
	},
	{
		q: '¿Tengo que hablar con una agencia?',
		a: 'No. La guía es gratis y automática, y recibes el desglose completo por email quieras o no cualquier otra cosa. Que te contacte una agencia registrada de la zona es una casilla aparte que marcas solo si te interesa.',
	},
];
---

<Layout
	lang="es"
	title="¿Cuánto vale tu propiedad en la Costa del Sol? | PropertyList"
	description="Descubre por cuánto se han vendido realmente propiedades como la tuya, con precios registrados del registro notarial español, no precios de salida. Guía orientativa gratis, sin llamadas salvo que las pidas."
	canonical="https://info.propertylist.es/es/cuanto-vale-mi-propiedad/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/what-is-my-property-worth/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/cuanto-vale-mi-propiedad/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/what-is-my-property-worth/' },
	]}
>
	<section class="wHero">
		<h1 class="wH1">¿Cuánto vale realmente tu propiedad?</h1>
		<p class="wLead">
			La mayoría de estimadores te enseñan lo que <em>piden</em> los vecinos. Este parte de lo que los compradores
			realmente <strong>pagaron</strong>: precios registrados del registro notarial español. Dos preguntas, sin cuenta,
			sin llamadas salvo que las pidas.
		</p>
	</section>

	<section class="wCard" aria-labelledby="wFormTitle">
		<h2 class="wCardTitle" id="wFormTitle">Cuéntanos sobre la propiedad</h2>
		<form class="wForm" data-w-form>
			<label class="wField">
				<span class="wLabel">Zona</span>
				<select class="wInput" name="area" required>
					<option value="">Elige una zona</option>
					{areas.map((a) => <option value={a.name}>{a.name}</option>)}
				</select>
			</label>
			<label class="wField">
				<span class="wLabel">Superficie construida (m²)</span>
				<input class="wInput" name="builtSqm" type="number" min="20" max="2000" required placeholder="p. ej. 120" />
			</label>
			<label class="wField">
				<span class="wLabel">Tipo</span>
				<select class="wInput" name="propertyType">
					<option value="">Cualquiera</option>
					<option>Piso</option>
					<option>Adosado</option>
					<option>Villa</option>
					<option>Parcela</option>
				</select>
			</label>
			<label class="wField">
				<span class="wLabel">Dormitorios</span>
				<select class="wInput" name="bedrooms">
					<option value="">Cualquiera</option>
					<option>1</option><option>2</option><option>3</option><option>4</option><option>5+</option>
				</select>
			</label>
			<div class="wSubmitRow">
				<button class="wBtn" type="submit">Enséñame los números</button>
			</div>
		</form>
	</section>

	<section class="wResult" data-w-result hidden aria-live="polite"></section>

	<section class="wFaq">
		<h2 class="wFaqTitle">Respuestas claras</h2>
		{faqs.map((f) => (
			<details class="wFaqItem">
				<summary class="wFaqQ">{f.q}</summary>
				<p class="wFaqA">{f.a}</p>
			</details>
		))}
		<p class="wLegal">
			Esto es una guía de mercado, no una tasación formal, y no constituye asesoramiento legal, fiscal ni financiero.
			Las cifras son estimaciones a partir de los datos de mercado disponibles y no están garantizadas. Busca
			asesoramiento profesional independiente antes de tomar una decisión.
		</p>
	</section>
</Layout>

<script is:inline>
	(function () {
		var form = document.querySelector('[data-w-form]');
		var out = document.querySelector('[data-w-result]');
		if (!form || !out) return;
		var started = Date.now();
		var last = null;

		var eur = function (n) {
			try { return new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n); }
			catch (e) { return '€' + n; }
		};
		var esc = function (v) { return String(v == null ? '' : v).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); };

		form.addEventListener('submit', async function (e) {
			e.preventDefault();
			var fd = new FormData(form);
			var area = String(fd.get('area') || '');
			var builtSqm = Number(fd.get('builtSqm') || 0);
			if (!area || !builtSqm) return;

			out.hidden = false;
			out.innerHTML = '<p class="wMuted">Consultando el registro…</p>';

			var d = {};
			try {
				var res = await fetch('/api/seller-estimate', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ area: area, builtSqm: builtSqm }),
				});
				d = await res.json();
			} catch (_) {
				out.innerHTML = '<p class="wMuted">No hemos podido acceder a los datos ahora mismo. Inténtalo de nuevo.</p>';
				return;
			}

			if (!d.ok || !d.enough) {
				out.innerHTML =
					'<div class="wBox"><h2 class="wCardTitle">Todavía no hay suficientes ventas registradas en ' + esc(area) + '</h2>' +
					'<p class="wMuted">Preferimos decírtelo antes que inventarnos una cifra. Una agencia de la zona todavía puede preparar un informe serio con comparables cercanos.</p>' +
					'<p><a class="wLink" href="/es/informe-inteligencia-propiedad/">Cómo funciona el informe completo →</a></p></div>';
				return;
			}

			last = d;
			var basisLine = d.basis === 'registered'
				? 'Basado en <strong>' + eur(d.perSqm) + '/m² registrados</strong> en ' + esc(d.area) +
				  (d.oracle && d.oracle.sampleSize ? ' sobre ' + Number(d.oracle.sampleSize).toLocaleString('es-ES') + ' ventas ante notario' : '') + '.'
				: 'Basado en <strong>' + eur(d.perSqm) + '/m² de precio de salida</strong> en ' + esc(d.area) +
				  '. Todavía no hay cifra verificada ante notario para esta zona, así que tómalo como una señal más débil.';

			out.innerHTML =
				'<div class="wBox">' +
				'<div class="wRangeLabel">Guía orientativa para ' + esc(d.builtSqm) + ' m² en ' + esc(d.area) + '</div>' +
				'<div class="wRange">' + eur(d.low) + ' - ' + eur(d.high) + '</div>' +
				'<p class="wBasis">' + basisLine + '</p>' +
				(d.basis === 'registered'
					? '<p class="wMuted">Esto es lo que pagaron los compradores. Los precios de salida en la misma zona son más altos, y esa diferencia es la que pilla a la mayoría de vendedores.</p>'
					: '') +
				'<form class="wEmail" data-w-email>' +
				'<p class="wEmailPitch"><strong>¿Quieres el desglose completo?</strong> Te enviamos por email el detalle de la zona detrás de este número: precios registrados, cómo se han movido y qué significa para fijar tu precio.</p>' +
				'<div class="wEmailRow">' +
				'<input class="wInput" name="name" type="text" placeholder="Tu nombre (opcional)" autocomplete="name" />' +
				'<input class="wInput" name="email" type="email" required placeholder="tu@email.com" autocomplete="email" />' +
				'</div>' +
				'<input type="text" name="pl_hp_x9" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />' +
				'<label class="wOptIn"><input type="checkbox" name="agentOptIn" /> <span>Me gustaría que una agencia registrada de la zona me contactara sobre la venta. Opcional: si lo desmarcas, igualmente recibes el desglose.</span></label>' +
				'<button class="wBtn" type="submit">Envíame el desglose</button>' +
				'<p class="wMsg" data-w-msg role="status" aria-live="polite"></p>' +
				'</form>' +
				'</div>';

			var ef = out.querySelector('[data-w-email]');
			var msg = out.querySelector('[data-w-msg]');
			ef.addEventListener('submit', async function (ev) {
				ev.preventDefault();
				var f2 = new FormData(ef);
				var email = String(f2.get('email') || '').trim();
				if (!email || email.indexOf('@') < 0) { msg.textContent = 'Introduce un email válido.'; msg.className = 'wMsg bad'; return; }
				var btn = ef.querySelector('button');
				btn.disabled = true;
				msg.textContent = '';
				try {
					var r2 = await fetch('/api/seller-lead', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({
							email: email,
							name: String(f2.get('name') || ''),
							pl_hp_x9: String(f2.get('pl_hp_x9') || ''),
							t: Date.now() - started,
							area: area,
							propertyType: String(fd.get('propertyType') || ''),
							bedrooms: String(fd.get('bedrooms') || ''),
							builtSqm: String(builtSqm),
							estimateLow: String(last.low),
							estimateHigh: String(last.high),
							basis: String(last.basis || ''),
							agentOptIn: !!f2.get('agentOptIn'),
							lang: 'es',
							page: location.pathname,
						}),
					});
					var j2 = await r2.json().catch(function () { return {}; });
					if (!r2.ok || !j2.ok) { msg.textContent = 'Algo ha fallado. Inténtalo de nuevo.'; msg.className = 'wMsg bad'; btn.disabled = false; return; }
					ef.innerHTML = '<p class="wMsg ok"><strong>Listo.</strong> El desglose va camino de ' + esc(email) + '.</p>';
					if (window.umami && window.umami.track) window.umami.track('seller-lead', { area: area, agent: !!f2.get('agentOptIn') });
				} catch (_) {
					msg.textContent = 'Error de red. Inténtalo de nuevo.';
					msg.className = 'wMsg bad';
					btn.disabled = false;
				}
			});

			if (window.umami && window.umami.track) window.umami.track('seller-estimate', { area: area, basis: d.basis });
			out.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	})();
</script>

<style is:global>
	.wHero { max-width: 760px; margin: 0 auto; padding: 44px 20px 8px; text-align: center; }
	.wH1 { margin: 0 0 12px; font-size: clamp(28px, 5vw, 42px); line-height: 1.12; font-weight: 900; color: #101828; }
	.wLead { margin: 0; font-size: 17px; line-height: 1.6; color: rgba(16, 24, 40, 0.72); }
	.wCard, .wResult, .wFaq { max-width: 760px; margin: 22px auto 0; padding: 0 20px; }
	.wCardTitle { margin: 0 0 14px; font-size: 20px; font-weight: 800; color: #101828; }
	.wForm { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 22px; border: 1px solid rgba(16, 24, 40, 0.12); border-radius: 16px; background: #fff; }
	.wField { display: flex; flex-direction: column; gap: 6px; }
	.wLabel { font-size: 13px; font-weight: 700; color: rgba(16, 24, 40, 0.7); }
	.wInput { padding: 11px 13px; font-size: 15px; border: 1px solid rgba(16, 24, 40, 0.2); border-radius: 10px; background: #fff; width: 100%; }
	.wInput:focus { outline: 2px solid rgba(0, 174, 154, 0.5); outline-offset: 1px; }
	.wSubmitRow { grid-column: 1 / -1; }
	.wBtn { width: 100%; padding: 13px 20px; font-size: 16px; font-weight: 800; color: #fff; background: #00ae9a; border: 0; border-radius: 10px; cursor: pointer; }
	.wBtn:hover { background: #0a9285; }
	.wBtn:disabled { opacity: 0.6; cursor: default; }
	.wBox { padding: 24px; border: 1px solid rgba(0, 174, 154, 0.3); border-radius: 16px; background: linear-gradient(180deg, rgba(0, 174, 154, 0.07), rgba(0, 174, 154, 0.02)); }
	.wRangeLabel { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: rgba(16, 24, 40, 0.55); }
	.wRange { margin: 6px 0 10px; font-size: clamp(26px, 5vw, 36px); font-weight: 900; color: #0a6d61; }
	.wBasis { margin: 0 0 8px; font-size: 15px; color: #101828; }
	.wMuted { margin: 0 0 10px; font-size: 14px; line-height: 1.55; color: rgba(16, 24, 40, 0.66); }
	.wLink { font-weight: 800; color: #0a6d61; text-decoration: none; }
	.wEmail { margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(16, 24, 40, 0.12); }
	.wEmailPitch { margin: 0 0 12px; font-size: 14.5px; line-height: 1.55; color: rgba(16, 24, 40, 0.78); }
	.wEmailRow { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
	.wOptIn { display: flex; gap: 9px; align-items: flex-start; margin: 0 0 14px; font-size: 13.5px; line-height: 1.5; color: rgba(16, 24, 40, 0.7); }
	.wOptIn input { margin-top: 3px; flex: 0 0 auto; }
	.wMsg { margin: 10px 0 0; font-size: 14px; min-height: 1em; }
	.wMsg.ok { color: #0a6d61; }
	.wMsg.bad { color: #b42318; }
	.wFaq { margin-top: 34px; padding-bottom: 48px; }
	.wFaqTitle { margin: 0 0 12px; font-size: 20px; font-weight: 800; color: #101828; }
	.wFaqItem { border-bottom: 1px solid rgba(16, 24, 40, 0.1); padding: 12px 0; }
	.wFaqQ { font-weight: 700; font-size: 15.5px; color: #101828; cursor: pointer; }
	.wFaqA { margin: 8px 0 0; font-size: 14.5px; line-height: 1.6; color: rgba(16, 24, 40, 0.7); }
	.wLegal { margin: 18px 0 0; font-size: 12.5px; line-height: 1.55; color: rgba(16, 24, 40, 0.5); }
	@media (max-width: 560px) {
		.wForm, .wEmailRow { grid-template-columns: minmax(0, 1fr); }
	}
</style>
