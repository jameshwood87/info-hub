---
import Layout from '../../layouts/Layout.astro';
import ReviewsPage from '../../components/ReviewsPage.astro';
import data from '../../data/reviews.json';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/opiniones/`;
const title = 'Opiniones sobre PropertyList: lo que dicen los agentes | PropertyList';
const description = `Todas las reseñas de PropertyList en Google y Trustpilot, tal como se publicaron y con enlace al original, más las recomendaciones de Facebook. ${data.sources.google.rating.toFixed(1).replace('.', ',')} en Google con ${data.sources.google.count} reseñas.`;

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: `${origin}/es/` },
		{ '@type': 'ListItem', position: 2, name: 'Opiniones', item: canonical },
	],
};
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	hideSearch
	hreflangs={[
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'en', href: `${origin}/reviews/` },
		{ hreflang: 'x-default', href: `${origin}/reviews/` },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<ReviewsPage lang="es" />
</Layout>
