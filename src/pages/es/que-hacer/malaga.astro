	<script is:inline define:vars={{ planEvents, planPlaces, planMarkets }}>
		(() => {
			const L = {
				added: '&#10003; En el plan', add: '+ Añadir al plan', empty: 'Tu plan está vacío - toca "+ Añadir al plan" en cualquier evento.',
				remove: 'Quitar', copied: 'Enlace copiado - envíaselo a quien quieras.', shareTitle: 'Nuestro plan de Málaga',
				details: 'Detalles del evento &rarr;', map: '&#128205; Mapa', placesHead: 'Por decidir - toca Elegir día para programarlo', pick: 'Elegir día &rarr;',
				marketNote: (d) => `Este mercadillo se celebra cada ${d}.`, marketErr: (d) => `Elige un ${d} - es el día en que se celebra este mercadillo.`, needDate: 'Elige primero una fecha.',
			};
			const KEY = 'pl_plan_malaga';
			const byId = Object.fromEntries([...planEvents, ...planPlaces, ...planMarkets].map((e) => [e.id, e]));
			// entradas del plan: {id} para eventos, {id,d,tm?} para lugares/mercadillos con fecha
			const norm = (x) => (typeof x === 'string' ? { id: x } : x || {});
			const trk = (n) => { try { window.umami && window.umami.track(n); } catch {} };
			const load = () => { try { return (JSON.parse(localStorage.getItem(KEY)) || []).map(norm).filter((p) => byId[p.id]); } catch { return []; } };
			const save = (ids) => { try { localStorage.setItem(KEY, JSON.stringify(ids)); } catch {} };
			let plan = load();
			const inPlan = (id) => plan.some((p) => p.id === id);

			// import a shared plan from the URL (tokens: id or id@YYYYMMDD or id@YYYYMMDD-HHMM)
			const shared = (location.hash.match(/plan=([a-zA-Z0-9,@-]+)/) || [])[1];
			if (shared) {
				for (const tok of shared.split(',')) {
					const m = tok.match(/^([a-z0-9-]+?)(?:@(ns|\d{8})(?:-(\d{4}))?)?$/i);
					if (!m || !byId[m[1]] || inPlan(m[1])) continue;
					const entry = { id: m[1] };
					if (m[2] === 'ns') entry.ns = true;
					else if (m[2]) entry.d = `${m[2].slice(0, 4)}-${m[2].slice(4, 6)}-${m[2].slice(6, 8)}`;
					if (m[3]) entry.tm = `${m[3].slice(0, 2)}:${m[3].slice(2, 4)}`;
					plan.push(entry);
				}
				save(plan); trk('plan-import');
			}

			const pill = document.querySelector('[data-plan-pill]');
			const count = document.querySelector('[data-plan-count]');
			const overlay = document.querySelector('[data-plan-overlay]');
			const list = document.querySelector('[data-plan-list]');
			const note = document.querySelector('[data-plan-note]');
			const fmtD = new Intl.DateTimeFormat('es-ES', { weekday: 'short', day: 'numeric', month: 'short' });
			const dLabel = (e) => {
				const s = fmtD.format(new Date(e.start + 'T12:00:00Z'));
				return e.end && e.end !== e.start ? s + ' - ' + fmtD.format(new Date(e.end + 'T12:00:00Z')) : s;
			};
			const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

			const sync = () => {
				count.textContent = plan.length;
				pill.hidden = plan.length === 0;
				document.querySelectorAll('[data-plan-add]').forEach((b) => {
					const isIn = inPlan(b.getAttribute('data-plan-add'));
					b.innerHTML = isIn ? L.added : L.add;
					b.classList.toggle('isIn', isIn);
				});
				const items = plan.map((p) => (byId[p.id] ? { ...byId[p.id], _d: p.d || null, _tm: p.tm || null, _ns: !!p.ns } : null)).filter(Boolean);
				// programado = día concreto (elegido por el usuario, o evento de un solo día); el resto queda "por decidir"
				const singleDay = (e) => e.start && (!e.end || e.end === e.start);
				const schedDay = (e) => e._d || (singleDay(e) ? e.start : null);
				const schedTime = (e) => e._tm || (singleDay(e) ? e.time : null) || null;
				const dated = items.filter((e) => !e._ns && schedDay(e)).sort((a, b) =>
					(schedDay(a) + '|' + (schedTime(a) || '99:99')).localeCompare(schedDay(b) + '|' + (schedTime(b) || '99:99')));
				const undated = items.filter((e) => e._ns || !schedDay(e));
				const warn = document.querySelector('[data-plan-warn]');
				if (warn) warn.hidden = !items.some((e) => !e.start);
				const mapUrl = (e) => 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent([e.t, e.town, 'Spain'].filter(Boolean).join(', '));
				const dateBadge = (e) => {
					const d = schedDay(e);
					if (!e._ns && d) return fmtD.format(new Date(d + 'T12:00:00Z')) + (schedTime(e) ? ' · ' + schedTime(e) : '');
					if (e.start) return dLabel(e);
					return esc(e.cat || '');
				};
				const itemHtml = (e, deciding) => `<div class="planItem">
						<div class="planItemHead" data-plan-tgl>
							<div class="planItemMain"><span class="planItemDate">${dateBadge(e)}</span><strong>${esc(e.t)}</strong><span class="planItemVenue">${esc([e.venue, e.town].filter(Boolean).join(' · '))}</span></div>
							<div class="planItemBtns">${deciding ? `<button class="planPick" type="button" data-plan-sched="${e.id}">${L.pick}</button>` : ''}<span class="planItemChev" aria-hidden="true">&#9662;</span><button class="planItemX" type="button" data-plan-rm="${e.id}" aria-label="${L.remove}">&times;</button></div>
						</div>
						<div class="planItemMore" hidden>
							${e.blurb ? `<p>${esc(e.blurb)}</p>` : ''}
							<div class="planItemLinks">
								${e.url ? `<a href="${esc(e.url)}" target="_blank" rel="noopener nofollow">${L.details}</a>` : ''}
								<a href="${mapUrl(e)}" target="_blank" rel="noopener">${L.map}</a>
							</div>
						</div>
					</div>`;
				list.innerHTML = items.length
					? dated.map((e) => itemHtml(e, false)).join('') + (undated.length ? `<p class="planSubhead">${L.placesHead}</p>` + undated.map((e) => itemHtml(e, true)).join('') : '')
					: `<p class="planEmpty">${L.empty}</p>`;
				list.querySelectorAll('[data-plan-sched]').forEach((b) => b.addEventListener('click', (ev) => { ev.stopPropagation(); openWhen(b.getAttribute('data-plan-sched')); }));
				list.querySelectorAll('[data-plan-rm]').forEach((b) => b.addEventListener('click', (ev) => { ev.stopPropagation(); plan = plan.filter((p) => p.id !== b.getAttribute('data-plan-rm')); save(plan); sync(); }));
				list.querySelectorAll('[data-plan-tgl]').forEach((h) => h.addEventListener('click', () => {
					const more = h.parentElement.querySelector('.planItemMore');
					more.hidden = !more.hidden;
					h.parentElement.classList.toggle('isOpen', !more.hidden);
				}));
			};

			// diálogo "cuándo": chips de día y franja horaria (sin widgets de calendario)
			const wOverlay = document.querySelector('[data-when-overlay]');
			const wTitle = document.querySelector('[data-when-title]');
			const wNote = document.querySelector('[data-when-note]');
			const wDays = document.querySelector('[data-when-days]');
			const wTimes = document.querySelector('[data-when-times]');
			let wId = null;
			const isoLocal = (dt) => `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}`;
			const chipFmt = new Intl.DateTimeFormat('es-ES', { weekday: 'short', day: 'numeric', month: 'short' });
			const TIME_CHIPS = [
				['', 'Cualquier hora'], ['10:00', '&#127749; Por la mañana'], ['13:00', '&#127860; Mediodía'],
				['17:00', '&#9728;&#65039; Por la tarde'], ['21:00', '&#127756; Por la noche'], ['23:00', '&#127747; De madrugada'],
			];
			const dayChip = (iso, i) => {
				const todayL = isoLocal(new Date());
				const tomorrow = isoLocal(new Date(Date.now() + 86400000));
				let label = chipFmt.format(new Date(iso + 'T12:00:00'));
				if (iso === todayL) label = 'Hoy';
				else if (iso === tomorrow) label = 'Mañana';
				return `<button class="chip wchip${i === 0 ? ' isActive' : ''}" type="button" data-wd="${iso}">${label}</button>`;
			};
			const openWhen = (id) => {
				const item = byId[id];
				wId = id;
				wTitle.textContent = item.t;
				// chips de día: los mercadillos solo muestran sus próximos 4 días válidos
				const days = [];
				const d = new Date();
				if (item.dow != null) {
					wNote.textContent = L.marketNote(item.dayName) + (item.hours ? ` (${item.hours})` : '');
					wNote.hidden = false;
					while (days.length < 4) { if (d.getDay() === item.dow) days.push(isoLocal(d)); d.setDate(d.getDate() + 1); }
				} else if (item.start) {
					// evento: elige el día de su programa al que irás
					wNote.hidden = true;
					const todayL = isoLocal(new Date());
					let cur = new Date((item.start > todayL ? item.start : todayL) + 'T12:00:00');
					const last = new Date((item.end || item.start) + 'T12:00:00');
					while (days.length < 14 && cur <= last) { days.push(isoLocal(cur)); cur.setDate(cur.getDate() + 1); }
					if (!days.length) days.push(item.start);
				} else {
					wNote.hidden = true;
					for (let i = 0; i < 14; i++) { days.push(isoLocal(d)); d.setDate(d.getDate() + 1); }
				}
				wDays.innerHTML = days.map((iso, i) => dayChip(iso, i)).join('');
				// los eventos con hora conocida solo preguntan QUE DIA - la hora va fijada
				wTimes.innerHTML = item.time
					? `<button class="chip wchip isActive" type="button" data-wt="${item.time}">&#128337; Empieza ${item.time}</button>`
					: TIME_CHIPS.map(([tm, label], i) => `<button class="chip wchip${i === 0 ? ' isActive' : ''}" type="button" data-wt="${tm}">${label}</button>`).join('');
				const wire = (sel) => wOverlay.querySelectorAll(sel).forEach((c) =>
					c.addEventListener('click', () => { c.parentElement.querySelectorAll('.wchip').forEach((x) => x.classList.toggle('isActive', x === c)); }));
				wire('[data-wd]'); wire('[data-wt]');
				wOverlay.hidden = false;
			};
			document.querySelector('[data-when-cancel]').addEventListener('click', () => { wOverlay.hidden = true; });
			wOverlay.addEventListener('click', (ev) => { if (ev.target === wOverlay) wOverlay.hidden = true; });
			document.querySelector('[data-when-ns]').addEventListener('click', () => {
				if (!byId[wId]) return;
				plan = [...plan.filter((p) => p.id !== wId), { id: wId, ns: true }];
				save(plan); sync();
				wOverlay.hidden = true;
			});
			document.querySelector('[data-when-add]').addEventListener('click', () => {
				const item = byId[wId];
				if (!item) return;
				const day = wDays.querySelector('.isActive');
				if (!day) return;
				const entry = { id: wId, d: day.getAttribute('data-wd') };
				const tm = (wTimes.querySelector('.isActive') || {}).getAttribute ? wTimes.querySelector('.isActive').getAttribute('data-wt') : '';
				if (tm) entry.tm = tm;
				plan = [...plan.filter((p) => p.id !== wId), entry]; trk('plan-add');
				save(plan); sync();
				wOverlay.hidden = true;
			});

			document.querySelectorAll('[data-plan-add]').forEach((b) =>
				b.addEventListener('click', () => {
					const id = b.getAttribute('data-plan-add');
					if (inPlan(id)) { plan = plan.filter((p) => p.id !== id); save(plan); sync(); return; }
					const it = byId[id];
					// solo los eventos de un día con hora conocida entran directos;
					// el resto (lugares, mercadillos, eventos multi-día o sin hora) pregunta cuándo
					if (it && it.start && it.time && (!it.end || it.end === it.start)) {
						plan = [...plan, { id }]; trk('plan-add');
						save(plan); sync();
						return;
					}
					openWhen(id);
				})
			);
			pill.addEventListener('click', () => { overlay.hidden = false; });
			document.querySelector('[data-plan-close]').addEventListener('click', () => { overlay.hidden = true; });
			overlay.addEventListener('click', (ev) => { if (ev.target === overlay) overlay.hidden = true; });
			document.querySelector('[data-plan-clear]').addEventListener('click', () => { plan = []; save(plan); sync(); });

			// .ics export (all-day events; DTEND is exclusive so +1 day)
			const icsEsc = (s) => String(s == null ? '' : s).replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\n/g, '\\n');
			const plusDay = (iso) => new Date(new Date(iso + 'T00:00:00Z').getTime() + 86400000).toISOString().slice(0, 10);
			document.querySelector('[data-plan-ics]').addEventListener('click', () => {
				const entries = plan.map((p) => ({ p, e: byId[p.id] })).filter((x) => x.e && !x.p.ns && (x.e.start || x.p.d));
				if (!entries.length) return; trk('plan-calendar');
				const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//PropertyList//WhatsOn//ES'];
				for (const { p, e } of entries) {
					lines.push('BEGIN:VEVENT', `UID:${e.id}@info.propertylist.es`);
					const single = e.start && (!e.end || e.end === e.start);
					const day = p.d || (single ? e.start : null);
					const time = p.tm || (single && !p.d ? e.time : null) || p.tm;
					if (day && time) {
						// entrada con hora (2,5h por defecto)
						const d8 = day.replace(/-/g, '');
						const [hh, mm] = time.split(':').map(Number);
						const endMin = Math.min(hh * 60 + mm + 150, 23 * 60 + 59);
						lines.push(`DTSTART:${d8}T${String(hh).padStart(2, '0')}${String(mm).padStart(2, '0')}00`, `DTEND:${d8}T${String(Math.floor(endMin / 60)).padStart(2, '0')}${String(endMin % 60).padStart(2, '0')}00`);
					} else if (day) {
						lines.push(`DTSTART;VALUE=DATE:${day.replace(/-/g, '')}`, `DTEND;VALUE=DATE:${plusDay(day).replace(/-/g, '')}`);
					} else {
						// evento multi-día sin programar: se mantiene el rango completo como día entero
						lines.push(`DTSTART;VALUE=DATE:${e.start.replace(/-/g, '')}`, `DTEND;VALUE=DATE:${plusDay(e.end || e.start).replace(/-/g, '')}`);
					}
					lines.push(`SUMMARY:${icsEsc(e.t)}`,
						`LOCATION:${icsEsc([e.venue, e.town].filter(Boolean).join(', '))}`,
						`DESCRIPTION:${icsEsc((e.url || '') + ' - via info.propertylist.es/es/que-hacer/malaga/')}`,
						'END:VEVENT');
				}
				lines.push('END:VCALENDAR');
				const blob = new Blob([lines.join('\r\n')], { type: 'text/calendar' });
				const a = document.createElement('a');
				a.href = URL.createObjectURL(blob); a.download = 'plan-malaga.ics'; a.click();
				setTimeout(() => URL.revokeObjectURL(a.href), 5000);
			});

			// share plan
			document.querySelector('[data-plan-share]').addEventListener('click', async () => {
				if (!plan.length) return; trk('plan-share');
				const tok = (p) => p.id + (p.ns ? '@ns' : p.d ? '@' + p.d.replace(/-/g, '') + (p.tm ? '-' + p.tm.replace(':', '') : '') : '');
				const url = location.origin + location.pathname + '#plan=' + plan.map(tok).join(',');
				try {
					if (navigator.share) { await navigator.share({ title: L.shareTitle, url }); return; }
					await navigator.clipboard.writeText(url);
					note.textContent = L.copied;
				} catch {}
			});

			sync();
			if (shared) overlay.hidden = false;
		})();
	</script>

	<script is:inline>
		(() => {
			// pestañas Eventos | Lugares
			const tabBtns = Array.from(document.querySelectorAll('[data-tab-btn]'));
			const panes = Array.from(document.querySelectorAll('[data-tab-pane]'));
			const setTab = (name) => {
				tabBtns.forEach((b) => b.classList.toggle('isActive', b.getAttribute('data-tab-btn') === name));
				panes.forEach((p) => { p.hidden = p.getAttribute('data-tab-pane') !== name; });
				const add = document.querySelector('[data-add-link]');
				if (add) { add.href = name === 'places' ? '#add-place' : '#add-event'; add.textContent = name === 'places' ? 'Añade tu local - gratis' : 'Añade tu evento - gratis'; }
			};
			tabBtns.forEach((b) => b.addEventListener('click', () => setTab(b.getAttribute('data-tab-btn'))));
			const addLink = document.querySelector('[data-add-link]');
			if (addLink) addLink.addEventListener('click', () => setTab(addLink.getAttribute('href') === '#add-place' ? 'places' : 'events'));
			if (/(^|[#&])tab=places/.test(location.hash)) setTab('places');

			// combinable time + category filters, state kept in the URL hash
			const tchips = Array.from(document.querySelectorAll('.tchip'));
			const cchips = Array.from(document.querySelectorAll('.cchip'));
			const cards = Array.from(document.querySelectorAll('[data-events] .evCard'));
			const empty = document.querySelector('[data-empty]');
			const state = { t: 'all', c: 'all' };
			const pstate = { c: 'all', t: 'all' };
			const writeHash = () => {
				const parts = [];
				if (state.t !== 'all') parts.push('t=' + state.t);
				if (state.c !== 'all') parts.push('c=' + state.c);
				if (pstate.c !== 'all') parts.push('pc=' + pstate.c);
				if (pstate.t !== 'all') parts.push('pt=' + pstate.t);
				history.replaceState(null, '', parts.length ? '#' + parts.join('&') : location.pathname);
			};
			const apply = (updateHash) => {
				let visible = 0;
				for (const card of cards) {
					const okT = state.t === 'all' || card.getAttribute('data-' + state.t) === '1';
					const okC = state.c === 'all' || card.getAttribute('data-cat') === state.c;
					const show = okT && okC;
					card.style.display = show ? '' : 'none';
					if (show) visible++;
				}
				if (empty) empty.hidden = visible > 0 || !cards.length;
				// ocultar bloques temporales sin tarjetas visibles
				document.querySelectorAll('[data-bucket]').forEach((sec) => {
					sec.hidden = !Array.from(sec.querySelectorAll('.evCard')).some((c) => c.style.display !== 'none');
				});
				tchips.forEach((c) => c.classList.toggle('isActive', c.getAttribute('data-t') === state.t));
				cchips.forEach((c) => c.classList.toggle('isActive', c.getAttribute('data-c') === state.c));
				if (updateHash) writeHash();
			};
			tchips.forEach((chip) => chip.addEventListener('click', () => { state.t = chip.getAttribute('data-t'); apply(true); }));
			cchips.forEach((chip) => chip.addEventListener('click', () => { state.c = chip.getAttribute('data-c'); apply(true); }));
			// pastillas del hero: salto directo a un filtro temporal
			document.querySelectorAll('[data-hero-t]').forEach((p) => p.addEventListener('click', () => {
				state.t = p.getAttribute('data-hero-t'); apply(true);
				const f = document.querySelector('.filters');
				if (f) f.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}));

			// filtros de lugares (tipo + zona)
			const pcChips = Array.from(document.querySelectorAll('.pchip'));
			const ptChips = Array.from(document.querySelectorAll('.ptchip'));
			const pCards = Array.from(document.querySelectorAll('[data-pcard]'));
			const pSecs = Array.from(document.querySelectorAll('[data-psec]'));
			const papply = (updateHash) => {
				for (const card of pCards) {
					const ok = (pstate.c === 'all' || card.getAttribute('data-pcat') === pstate.c) && (pstate.t === 'all' || card.getAttribute('data-ptown') === pstate.t);
					card.style.display = ok ? '' : 'none';
				}
				for (const sec of pSecs) {
					sec.hidden = !Array.from(sec.querySelectorAll('[data-pcard]')).some((c) => c.style.display !== 'none');
				}
				pcChips.forEach((c) => c.classList.toggle('isActive', c.getAttribute('data-pc') === pstate.c));
				ptChips.forEach((c) => c.classList.toggle('isActive', c.getAttribute('data-pt') === pstate.t));
				if (updateHash) writeHash();
			};
			pcChips.forEach((chip) => chip.addEventListener('click', () => { pstate.c = chip.getAttribute('data-pc'); papply(true); }));
			ptChips.forEach((chip) => chip.addEventListener('click', () => { pstate.t = chip.getAttribute('data-pt'); papply(true); }));

			// restore state from a shared URL
			const h = location.hash.replace(/^#/, '');
			for (const kv of h.split('&')) {
				const [k, v] = kv.split('=');
				if (k === 't' && ['now', 'wknd', 'month'].includes(v)) state.t = v;
				if (k === 'c' && v) state.c = v;
				if (k === 'pc' && v) pstate.c = v;
				if (k === 'pt' && v) pstate.t = v;
			}
			if (state.t !== 'all' || state.c !== 'all') apply(false);
			if (pstate.c !== 'all' || pstate.t !== 'all') { papply(false); setTab('places'); }
			// mini-formularios de local + feed -> /api/whatson-submit
			document.querySelectorAll('[data-mini-form]').forEach((mf) => {
				const mmsg = mf.querySelector('[data-msg]') || mf.parentElement.querySelector('[data-msg]');
				mf.addEventListener('submit', async (ev) => {
					ev.preventDefault();
					const data = Object.fromEntries(new FormData(mf).entries());
					data.kind = mf.getAttribute('data-kind'); data.lang = 'es';
					mmsg.hidden = false; mmsg.textContent = 'Enviando...'; mmsg.className = 'formMsg';
					try {
						const res = await fetch('/api/whatson-submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
						const j = await res.json();
						if (j.ok) {
							mmsg.textContent = data.kind === 'feed' ? '¡Gracias! Revisaremos tu feed y empezaremos a recoger tus eventos automáticamente.' : '¡Gracias! Tu local se ha enviado y aparecerá una vez revisado.';
							mmsg.classList.add('ok'); mf.reset();
						} else { mmsg.textContent = 'Revisa los datos e inténtalo de nuevo.'; mmsg.classList.add('err'); }
					} catch { mmsg.textContent = 'Algo ha fallado - inténtalo de nuevo.'; mmsg.classList.add('err'); }
				});
			});

			const form = document.querySelector('[data-event-form]');
			if (!form) return;
			// al pulsar un campo de fecha se abre el calendario nativo
			form.querySelectorAll('input[type=date]').forEach((i) => i.addEventListener('click', () => { try { i.showPicker(); } catch {} }));
			const msg = form.querySelector('[data-msg]');
			form.addEventListener('submit', async (ev) => {
				ev.preventDefault();
				const data = Object.fromEntries(new FormData(form).entries());
				msg.hidden = false; msg.textContent = 'Enviando...'; msg.className = 'formMsg';
				try {
					const res = await fetch('/api/event-submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
					const j = await res.json();
					if (j.ok) { msg.textContent = '¡Gracias! Tu evento se ha enviado y aparecerá una vez verificado.'; msg.classList.add('ok'); form.reset(); }
					else if (j.error === 'need_venue_or_link') { msg.textContent = 'Añade un lugar o un enlace del evento para poder verificarlo.'; msg.classList.add('err'); }
					else { msg.textContent = 'Revisa los datos e inténtalo de nuevo.'; msg.classList.add('err'); }
				} catch { msg.textContent = 'Algo ha fallado - inténtalo de nuevo.'; msg.classList.add('err'); }
			});
		})();
	</script>
</Layout>

