---
import Layout from '../../../layouts/Layout.astro';
import fs from 'node:fs';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/que-hacer/malaga/`;
const title = 'Qué hacer en Málaga 2026: eventos, ferias y planes | PropertyList';
const description =
	'Agenda de eventos en Málaga capital siempre al día: ferias, conciertos, exposiciones, deporte y planes en familia - de fuentes oficiales, actualizada automáticamente.';

type Ev = {
	id: string; title: string; titleEn?: string; titleEs?: string; start: string; time?: string | null; end: string | null; town: string;
	venue: string | null; category: string; scope: 'local' | 'nearby';
	url: string | null; source: string; blurbEn: string; blurbEs: string;
};
let events: Ev[] = [];
let updated: string | null = null;
try {
	const store = JSON.parse(fs.readFileSync('/opt/info-hub/var/admin/events/malaga.json', 'utf8'));
	events = Array.isArray(store.events) ? store.events : [];
	updated = store.updated || null;
} catch {}

const todayIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(new Date()); // Spain time, not server UTC
events = events.filter((e) => String(e.end || e.start) >= todayIso);
const local = events.filter((e) => e.scope === 'local');
const nearby = events.filter((e) => e.scope === 'nearby');
const cats = [...new Set(local.map((e) => e.category))].sort();

const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short' });
const dateLabel = (e: Ev) => {
	const s = new Date(e.start + 'T12:00:00Z');
	if (!e.end || e.end === e.start) return fmt.format(s);
	return `${fmt.format(s)} - ${fmt.format(new Date(e.end + 'T12:00:00Z'))}`;
};
const isOn = (e: Ev) => e.start <= todayIso && String(e.end || e.start) >= todayIso;
const CAT_LABEL: Record<string, string> = {
	music: 'Música', festival: 'Ferias y fiestas', culture: 'Cultura', sport: 'Deporte',
	family: 'Familia', food: 'Gastronomía', market: 'Mercadillos', nightlife: 'Vida nocturna', other: 'Otros',
};

// time-window flags for the filters + soonest-first ordering
const msDay = 86400000;
const today = new Date(todayIso + 'T00:00:00Z');
const dow = today.getUTCDay();
const weekendStart = dow === 6 || dow === 0 ? today : new Date(today.getTime() + (((5 - dow + 7) % 7) * msDay));
const weekendEnd = new Date(weekendStart.getTime() + (((7 - weekendStart.getUTCDay()) % 7) * msDay));
const wkndStartIso = weekendStart.toISOString().slice(0, 10);
const wkndEndIso = weekendEnd.toISOString().slice(0, 10);
const monthEndIso = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() + 1, 0)).toISOString().slice(0, 10);
const endOf = (e: Ev) => String(e.end || e.start);
const inWeekend = (e: Ev) => e.start <= wkndEndIso && endOf(e) >= wkndStartIso;
const inMonth = (e: Ev) => e.start <= monthEndIso;
const durDays = (e: Ev) => Math.max(0, (new Date(endOf(e) + 'T00:00:00Z').getTime() - new Date(e.start + 'T00:00:00Z').getTime()) / msDay);
const sortKey = (e: Ev) => `${e.start > todayIso ? e.start : todayIso}|${String(Math.round(durDays(e))).padStart(4, '0')}`;
local.sort((a, b) => sortKey(a).localeCompare(sortKey(b)));
const catCount = new Map<string, number>();
for (const e of local) catCount.set(e.category, (catCount.get(e.category) || 0) + 1);
const countNow = local.filter(isOn).length;
const countWknd = local.filter(inWeekend).length;
const countMonth = local.filter(inMonth).length;

// "imperdibles": los próximos eventos cortos de gran nombre (sin exposiciones largas)
const featured = local.filter((e) => durDays(e) <= 3 && (['starlite', 'marbella-arena'].includes(e.source) || ['festival', 'music'].includes(e.category))).slice(0, 4);

// bloques temporales: cómo piensa realmente quien planea (lo de larga duración a su propia estantería)
const weekAheadIso = new Date(today.getTime() + 7 * msDay).toISOString().slice(0, 10);
const bucketOf = (e: Ev) => (isOn(e) ? (durDays(e) > 21 ? 'ongoing' : 'today') : e.start <= weekAheadIso ? 'week' : 'later');
const BUCKETS = [
	{ k: 'today', icon: '\u{1F525}', title: 'Hoy', sub: null as string | null },
	{ k: 'week', icon: '\u{1F4C5}', title: 'Esta semana', sub: null },
	{ k: 'later', icon: '\u{1F52E}', title: 'Próximamente', sub: null },
	{ k: 'ongoing', icon: '\u{1F3DB}\u{FE0F}', title: 'Exposiciones y temporadas en curso', sub: 'Duran semanas - pásate cuando te venga bien.' },
].map((b) => ({ ...b, list: local.filter((e) => bucketOf(e) === b.k) })).filter((b) => b.list.length);

const CAT_ICON: Record<string, string> = {
	music: '\u{1F3B5}', festival: '\u{1F3AA}', culture: '\u{1F3AD}', sport: '\u{1F3C3}',
	family: '\u{1F46A}', food: '\u{1F37D}\u{FE0F}', market: '\u{1F6CD}\u{FE0F}', nightlife: '\u{1F319}', other: '\u{2728}',
};

const eventsLd = local.slice(0, 25).map((e) => ({
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: e.titleEs || e.title,
	startDate: e.time ? `${e.start}T${e.time}:00` : e.start,
	// Single-day events had no endDate at all, which Search Console flags.
	// schema.org treats endDate == startDate as correct for a one-day event.
	endDate: e.end || e.start,
	// No event in the feed carries its own image, so the diary's own OG image
	// stands in as the representative image for the listing.
	image: [`${origin}/og/que-hacer-malaga.png`],
	eventStatus: 'https://schema.org/EventScheduled',
	location: { '@type': 'Place', name: e.venue || e.town, address: { '@type': 'PostalAddress', addressLocality: e.town, addressRegion: 'Málaga', addressCountry: 'ES' } },
	description: e.blurbEs,
	...(e.url ? { url: e.url } : {}),
}));
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: `${origin}/es/` },
		{ '@type': 'ListItem', position: 2, name: 'Guía de Málaga', item: `${origin}/es/barrios/malaga-centre/` },
		{ '@type': 'ListItem', position: 3, name: 'Qué hacer en Málaga', item: canonical },
	],
};
const updatedFmt = updated ? new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(updated)) : null;
// hasta cuándo llega la agenda actualmente, p. ej. "hasta noviembre"
const lastIso = local.reduce((m, e) => (String(e.end || e.start) > m ? String(e.end || e.start) : m), todayIso);
const lastDate = new Date(lastIso + 'T12:00:00Z');
const horizon = new Intl.DateTimeFormat('es-ES', { month: 'long', ...(lastIso.slice(0, 4) !== todayIso.slice(0, 4) ? { year: 'numeric' } : {}) }).format(lastDate);

// minimal event data for the day-planner (localStorage + .ics + share link)
const planEvents = events.map((e) => ({
	id: e.id, t: e.titleEs || e.title, start: e.start, time: e.time || null, end: e.end, blurb: e.blurbEs,
	venue: e.venue, town: e.town, url: e.url,
}));

// mercadillos semanales - citas fijas recurrentes, verificado 2026-07
const MARKETS = [
	{ id: 'mk-atarazanas', dow: null, dayName: 'laborable', day: 'De lunes a sábado', name: 'Mercado de Atarazanas', town: 'Centro', place: 'Calle Atarazanas, Centro', hours: '08:00 - 14:00', desc: 'El mercado de hierro de 1879 - pescado fresco, fruta y barras de tapas. Cierra los domingos.' },
	{ id: 'mk-rastro', dow: 0, dayName: 'domingo', day: 'Cada domingo', name: 'Rastro dominical de Málaga', town: 'Málaga', place: 'Recinto Ferial, Cortijo de Torres', hours: '09:00 - 15:00', desc: 'Más de 300 puestos - uno de los rastros dominicales más grandes de Andalucía, en el recinto ferial.' },
];
const mapsQ = (m: { place: string; town: string }) =>
	'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`${m.place}, ${m.town}, Spain`);

// lugares seleccionados - validados externamente (Michelin 2026 en restaurantes;
// clubs verificados en activo 2026-07). Estacionales - el planificador avisa.
type Place = { id: string; cat: string; name: string; town: string; area: string; desc: string; url?: string };
const PLACES: Place[] = [
	{ id: 'pl-malagueta', cat: 'Playa', name: 'Playa de la Malagueta', town: 'La Malagueta', area: 'A dos pasos del centro', desc: 'La playa urbana - paseo marítimo, chiringuitos y las famosas letras de MALAGUETA en la arena.' },
	{ id: 'pl-caleta', cat: 'Playa', name: 'Playa de la Caleta', town: 'La Caleta', area: 'Al este de la Malagueta', desc: 'Más arbolada y tranquila que su vecina - la elección local para un baño cerca del centro.' },
	{ id: 'pl-pedregalejo', cat: 'Playa', name: 'Playa de Pedregalejo', town: 'Pedregalejo', area: 'El antiguo barrio pesquero', desc: 'Pequeñas calas con los mejores chiringuitos de espetos de la ciudad - sardinas asadas en barca.' },
	{ id: 'pl-elpalo', cat: 'Playa', name: 'Playa de El Palo', town: 'El Palo', area: 'Más al este', desc: 'Profundamente local - barcas en la arena y marisco legendario en cada esquina.' },
	{ id: 'pl-penon', cat: 'Playa', name: 'Peñón del Cuervo', town: 'El Palo', area: 'Extremo este de la ciudad', desc: 'Cala salvaje partida por un peñón - favorita para las barbacoas al atardecer.' },
	{ id: 'pl-balneario', cat: 'Beach club', name: 'El Balneario', town: 'El Palo', area: 'Baños del Carmen', desc: 'El balneario de 1918 sobre las rocas - mejor chiringuito de España 2025; copas al atardecer bajo árboles centenarios.', url: 'https://elbalneariomalaga.com/' },
	{ id: 'pl-cachalote', cat: 'Beach club', name: 'Chiringuito El Cachalote', town: 'La Malagueta', area: 'Playa de la Malagueta', desc: 'Gran terraza cubierta en la arena urbana - marisco, tapas y Victoria bien fría.' },
	{ id: 'pl-gutierrez', cat: 'Beach club', name: 'Gutiérrez Playa', town: 'Huelin', area: 'Paseo Antonio Banderas', desc: 'Espetos y marisco como mandan los cánones, en el paseo del oeste.' },
	{ id: 'pl-jcg', cat: 'Restaurante', name: 'José Carlos García', town: 'Centro', area: 'Muelle Uno, el puerto', desc: 'Una estrella Michelin en el puerto - la cocina estrellada original de Málaga, menús marineros.' },
	{ id: 'pl-kaleja', cat: 'Restaurante', name: 'Kaleja', town: 'Centro', area: 'Antigua judería', desc: 'Una estrella Michelin - la cocina de candela y puchero de Dani Carnero.' },
	{ id: 'pl-blossom', cat: 'Restaurante', name: 'Blossom', town: 'Centro', area: 'Edificio del Museo de Málaga', desc: 'Una estrella Michelin - los menús refinados de Emi Schobert para solo 30 comensales.' },
	{ id: 'pl-palodu', cat: 'Restaurante', name: 'Palodú', town: 'Centro', area: 'Centro histórico', desc: 'Nueva estrella 2026 - la cocina creativa y cercana de Cristina Cánovas y Diego Aguilar.' },
	{ id: 'pl-salagold', cat: 'Ocio nocturno', name: 'Sala Gold', town: 'Centro', area: 'Calle Luis de Velázquez', desc: 'Abierta los 365 días - fiestas temáticas y un equipo de luces serio en pleno centro histórico.', url: 'https://www.salagold.com/' },
	{ id: 'pl-theatro', cat: 'Ocio nocturno', name: 'Theatro Club', town: 'Centro', area: 'Centro histórico', desc: 'Noches de club con cabaret, jazz y espectáculos en un espacio teatral.' },
	{ id: 'pl-amazonia', cat: 'Ocio nocturno', name: 'Amazonia by Wengé', town: 'Centro', area: 'Centro histórico', desc: 'Salas de ambiente selvático para sesiones de house y electrónica.' },
];
const PLACE_CATS = [
	{ key: 'Playa', title: 'Playas' },
	{ key: 'Beach club', title: 'Beach clubs' },
	{ key: 'Restaurante', title: 'Restaurantes con estrella Michelin' },
	{ key: 'Ocio nocturno', title: 'Ocio nocturno' },
];
const placeMap = (p: Place) => 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`${p.name}, ${p.town}, Spain`);
// entradas del planificador para lugares (se fechan al añadir con el diálogo "cuándo")
const planPlaces = PLACES.map((p) => ({ id: p.id, t: p.name, start: null, end: null, blurb: p.desc, venue: p.area, town: p.town, url: p.url || null, cat: p.cat }));
// mercadillos: dow limita el selector de fecha al día en que se celebran
const planMarkets = MARKETS.map((m) => ({ id: m.id, t: m.name, start: null, end: null, blurb: m.desc, venue: m.place, town: m.town, url: null, cat: 'Mercadillo', dow: m.dow, dayName: m.dayName, hours: m.hours }));

// filtros de lugares: tipo + zona (mercadillos incluidos)
const pkey = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const CAT_KEY: Record<string, string> = { Playa: 'beach', 'Beach club': 'club', Restaurante: 'rest', 'Ocio nocturno': 'night' };
const P_CHIP_LABEL: Record<string, string> = { beach: 'Playas', club: 'Beach clubs', rest: 'Restaurantes', night: 'Ocio nocturno' };
const P_CATS = [
	{ k: 'market', label: 'Mercadillos', n: MARKETS.length },
	...PLACE_CATS.map((c) => ({ k: CAT_KEY[c.key], label: P_CHIP_LABEL[CAT_KEY[c.key]] || c.title, n: PLACES.filter((p) => p.cat === c.key).length })),
];
const townCounts = new Map<string, number>();
for (const t of [...PLACES.map((p) => p.town), ...MARKETS.map((m) => m.town)]) townCounts.set(pkey(t), (townCounts.get(pkey(t)) || 0) + 1);
const P_TOWNS = [...townCounts.entries()].sort((a, b) => b[1] - a[1]);
const townLabel = (k: string) =>
	({ malaga: 'Málaga', centro: 'Centro', 'la-malagueta': 'La Malagueta', 'la-caleta': 'La Caleta', pedregalejo: 'Pedregalejo', 'el-palo': 'El Palo', huelin: 'Huelin' })[k] || k;
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	ogImage={`${origin}/og/que-hacer-malaga.png`}
	hideSearch
	hreflangs={[
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'en', href: `${origin}/whats-on/malaga/` },
		{ hreflang: 'x-default', href: `${origin}/whats-on/malaga/` },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(eventsLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<section class="hero">
		<div class="heroInner">
			<div class="kicker">Qué hacer &middot; Málaga</div>
			<h1>Qué hacer en Málaga</h1>
			<p class="lead">
				Tu noche, tu feria, tu día de playa - todo lo que merece la pena en Málaga capital, del Centro a Pedregalejo, en una agenda
				siempre al día. Toca <strong>+ Añadir al plan</strong> para montar tu itinerario, compártelo con tus amigos y pásalo
				directo a tu calendario. Contrastada con fuentes oficiales cada semana, para que nunca planees la noche sobre
				un evento cancelado.
			</p>
			<div class="ctaRow">
				<a class="btnSecondary" href="#add-event" data-add-link>Añade tu evento - gratis</a>
			</div>
			{updatedFmt ? <div class="note">Actualizado el {updatedFmt} &middot; {local.length} eventos en Málaga, de hoy hasta {horizon} &middot; <a class="noteLink" href="/es/barrios/malaga-centre/">Guía de Málaga</a></div> : null}
			<div class="townNav" style="margin-top:14px;display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px;">
				<span style="opacity:.65;">Qué hacer en:</span>
				<a href="/es/que-hacer/marbella/" style="color:#fff;text-decoration:none;border:1px solid rgba(255,255,255,0.35);border-radius:999px;padding:4px 13px;font-weight:700;">Marbella</a>
				<a href="/es/que-hacer/estepona/" style="color:#fff;text-decoration:none;border:1px solid rgba(255,255,255,0.35);border-radius:999px;padding:4px 13px;font-weight:700;">Estepona</a>
				<a href="/es/que-hacer/" style="color:#7fe7d9;text-decoration:none;padding:4px 4px;font-weight:800;">Todas las ciudades &rarr;</a>
			</div>
		</div>
	</section>

	<div class="tabRow" role="tablist" aria-label="Eventos o lugares">
		<button class="tabBtn isActive" data-tab-btn="events" type="button">&#128197; Eventos <span class="chipCount">{local.length}</span></button>
		<button class="tabBtn" data-tab-btn="places" type="button">&#127958; Lugares <span class="chipCount">{PLACES.length + MARKETS.length}</span></button>
	</div>

	<div data-tab-pane="events">
	{featured.length >= 3 ? (
		<section class="section" aria-label="Imperdibles">
			<div class="featHead"><h2>&#11088; Imperdibles</h2><span>Las noches de las que hablará todo el mundo</span></div>
			<div class="featRow">
				{featured.map((e) => (
					<a class="featCard" href={e.url || '#'} target="_blank" rel="noopener nofollow">
						<span class="featDate">{dateLabel(e)}</span>
						<strong class="featTitle">{e.titleEs || e.title}</strong>
						<span class="featVenue">{e.venue || e.town}</span>
					</a>
				))}
			</div>
		</section>
	) : null}

	{local.length ? (
		<div class="filters">
			<div class="chipRow" role="group" aria-label="Filtrar por fecha">
				<button class="chip tchip isActive" data-t="all" type="button">Todos <span class="chipCount">{local.length}</span></button>
				<button class="chip tchip" data-t="now" type="button">Hoy <span class="chipCount">{countNow}</span></button>
				<button class="chip tchip" data-t="wknd" type="button">Este fin de semana <span class="chipCount">{countWknd}</span></button>
				<button class="chip tchip" data-t="month" type="button">Este mes <span class="chipCount">{countMonth}</span></button>
			</div>
			{cats.length > 1 ? (
				<div class="chipRow chipRowSub" role="group" aria-label="Filtrar por categoría">
					<button class="chip cchip isActive" data-c="all" type="button">Todos los tipos</button>
					{cats.map((c) => (
						<button class="chip cchip" data-c={c} type="button">{CAT_ICON[c]} {CAT_LABEL[c] || c} <span class="chipCount">{catCount.get(c)}</span></button>
					))}
				</div>
			) : null}
		</div>
	) : null}

	<div data-events>
		{BUCKETS.map((b, i) => (
			<Fragment>
			{i === 2 ? (
				<aside class="evAd" aria-label="Búsqueda de propiedades">
					<div class="evAdText">
						<strong>¿Buscas alquiler o compra en Málaga?</strong>
						<span>Casas vacacionales para tu estancia y viviendas en venta - de agentes registrados, en vivo en PropertyList.</span>
					</div>
					<div class="evAdBtns">
						<a href="https://propertylist.es/portal/for-sale/malaga" target="_blank" rel="noopener">En venta &rarr;</a>
						<a href="https://propertylist.es/portal/holiday-rentals/malaga" target="_blank" rel="noopener">Alquiler vacacional &rarr;</a>
					</div>
				</aside>
			) : null}
			<section class="section" aria-label={b.title} data-bucket={b.k}>
				<div class="bucketHead">
					<h2>{b.icon} {b.title} <span class="chipCount">{b.list.length}</span></h2>
					{b.sub ? <p>{b.sub}</p> : null}
				</div>
				<div class="grid3">
					{b.list.map((e) => (
						<article
							class="card evCard"
							data-cat={e.category}
							data-now={isOn(e) ? '1' : '0'}
							data-wknd={inWeekend(e) ? '1' : '0'}
							data-month={inMonth(e) ? '1' : '0'}
						>
							<div class="evTop">
								<span class="evDate">{dateLabel(e)}{e.time && (!e.end || e.end === e.start) ? ` · ${e.time}` : ""}</span>
								{isOn(e) ? <span class="evNow">Hoy</span> : null}
							</div>
							<h2 class="evTitle">{e.titleEs || e.title}</h2>
							<div class="evMeta">
								<span class="evCat">{CAT_ICON[e.category]} {CAT_LABEL[e.category] || e.category}</span>
								<span class="evTown">&#128205; {e.town}</span>
								{e.venue ? <span class="evVenue">{e.venue}</span> : null}
							</div>
							<p class="evBlurb">{e.blurbEs}</p>
							<div class="evFoot">
								{e.url ? (
									<a class="evLink" href={e.url} target="_blank" rel="noopener nofollow">Ver detalles &rarr;</a>
								) : <span></span>}
								<button class="planBtn" type="button" data-plan-add={e.id}>+ Añadir al plan</button>
							</div>
						</article>
					))}
				</div>
			</section>
			</Fragment>
		))}
		<p class="empty" data-empty hidden>Nada coincide con esos filtros - amplía las fechas o elige otra categoría.</p>
		{!local.length ? <p class="empty">Ahora mismo no hay eventos próximos - vuelve pronto, la agenda se actualiza cada semana.</p> : null}
	</div>

	{nearby.length ? (
		<section class="section">
			<div class="sectionHead">
				<h2>Merece el viaje</h2>
				<p>Grandes eventos en otros puntos de la Costa del Sol que no querrás perderte.</p>
			</div>
			<div class="grid3">
				{nearby.map((e) => (
					<article class="card evCard">
						<div class="evTop"><span class="evDate">{dateLabel(e)}{e.time && (!e.end || e.end === e.start) ? ` · ${e.time}` : ""}</span><span class="evTown">{e.town}</span></div>
						<h2 class="evTitle">{e.titleEs || e.title}</h2>
						<p class="evBlurb">{e.blurbEs}</p>
						<div class="evFoot">
							{e.url ? <a class="evLink" href={e.url} target="_blank" rel="noopener nofollow">Ver detalles &rarr;</a> : <span></span>}
							<button class="planBtn" type="button" data-plan-add={e.id}>+ Añadir al plan</button>
						</div>
					</article>
				))}
			</div>
		</section>
	) : null}

	<section class="section" id="add-event">
		<div class="sectionHead">
			<h2>Añade tu evento - gratis</h2>
			<p>
