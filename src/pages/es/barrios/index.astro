---
import Layout from '../../../layouts/Layout.astro';
import { adminCreateKbPage, listKbPagesByPrefix } from '../../../lib/directus';

let items = await listKbPagesByPrefix({ prefix: '/es/barrios/', lang: 'es', limit: 200 });
if (!items.length) {
	try {
		await adminCreateKbPage({
			status: 'published',
			language: 'es',
			path: '/es/barrios/marbella/',
			title: 'Guía de Marbella',
			description: 'Resumen práctico de estilo de vida, tipos de propiedad y puntos clave para compradores.',
			body: `<h2>Resumen</h2>
<p>Marbella es uno de los mercados más conocidos de la Costa del Sol, con demanda internacional y vida durante todo el año.</p>
<h2>Para quién es</h2>
<p>Familias, segunda residencia y compradores orientados al estilo de vida que buscan servicios, playa y gastronomía.</p>
<h2>Tipos de propiedad</h2>
<p>Apartamentos en el centro y primera línea; villas en zonas residenciales; urbanizaciones cerradas en áreas de montaña.</p>
<h2>Qué revisar</h2>
<ul><li>Distancia a pie vs. necesidad de coche</li><li>Gastos de comunidad y servicios</li><li>Licencias y registro para alquiler</li></ul>`,
			seo_title: 'Guía de Marbella (Costa del Sol)',
			seo_description: 'Resumen local de Marbella: estilo de vida, tipos de propiedad y consideraciones prácticas.',
		});
	} catch {}
	items = await listKbPagesByPrefix({ prefix: '/es/barrios/', lang: 'es', limit: 200 });
}
---

<Layout
	lang="es"
	title="Guías de barrios • PropertyList Info Hub"
	description="Guías de zonas y conocimiento local."
	canonical="https://info.propertylist.es/es/barrios/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/neighbourhood/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/barrios/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/neighbourhood/' },
	]}
>
	<h1>Guías de barrios</h1>
	<p class="sub">Guías de zonas y conocimiento local.</p>

	{items.length ? (
		<div class="grid">
			{items.map((p) => (
				<a class="card" href={p.path}>
					<h2>{p.title}</h2>
					{p.description ? <p>{p.description}</p> : null}
				</a>
			))}
		</div>
	) : (
		<div class="empty">Aún no hay guías.</div>
	)}
</Layout>

<style>
	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.03em;
	}

	.sub {
		margin: 0 0 18px;
		color: rgba(16, 24, 40, 0.7);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.card {
		display: block;
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 14px;
		text-decoration: none;
	}

	.card:hover {
		text-decoration: none;
		border-color: rgba(0, 174, 154, 0.35);
	}

	.card h2 {
		margin: 0 0 8px;
		font-size: 16px;
		letter-spacing: -0.01em;
	}

	.card p {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
	}

	.empty {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
