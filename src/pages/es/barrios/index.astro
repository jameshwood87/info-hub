---
import Layout from '../../../layouts/Layout.astro';
import { adminCreateKbPage, listKbPagesByPrefix } from '../../../lib/directus';

let itemsRaw = await listKbPagesByPrefix({ prefix: '/es/barrios/', lang: 'es', limit: 200 });
if (!itemsRaw.length) {
	try {
		await adminCreateKbPage({
			status: 'published',
			language: 'es',
			path: '/es/barrios/marbella/',
			title: 'Guía de Marbella',
			description: 'Resumen práctico de estilo de vida, tipos de propiedad y puntos clave para compradores.',
			body: `<h2>Resumen</h2>
<p>Marbella es uno de los mercados más conocidos de la Costa del Sol, con demanda internacional y vida durante todo el año.</p>
<h2>Para quién es</h2>
<p>Familias, segunda residencia y compradores orientados al estilo de vida que buscan servicios, playa y gastronomía.</p>
<h2>Tipos de propiedad</h2>
<p>Apartamentos en el centro y primera línea; villas en zonas residenciales; urbanizaciones cerradas en áreas de montaña.</p>
<h2>Qué revisar</h2>
<ul><li>Distancia a pie vs. necesidad de coche</li><li>Gastos de comunidad y servicios</li><li>Licencias y registro para alquiler</li></ul>`,
			seo_title: 'Guía de Marbella (Costa del Sol)',
			seo_description: 'Resumen local de Marbella: estilo de vida, tipos de propiedad y consideraciones prácticas.',
		});
	} catch {}
	itemsRaw = await listKbPagesByPrefix({ prefix: '/es/barrios/', lang: 'es', limit: 200 });
}

const stripSuffix = (s: string) => String(s || '').replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '').trim();
const stripGuideSuffix = (s: string) =>
	stripSuffix(s)
		.replace(/^gu[ií]a\s+del\s+barrio\s+(?:de\s+|del\s+)?/i, '')
		.replace(/^gu[ií]a\s+de\s+/i, '')
		.replace(/\s+/g, ' ')
		.trim();

const slugify = (s: string) =>
	String(s || '')
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');

const trimTo = (s: string, max: number) => {
	const t = String(s || '').trim();
	if (!t) return '';
	const n = Math.max(1, Number(max) || 80);
	if (t.length <= n) return t;
	return `${t.slice(0, Math.max(0, n - 1)).trimEnd()}…`;
};

const slugFromBarrioPath = (p: any) => {
	const parts = String(p?.path || '').split('/').filter(Boolean);
	if (parts[0] !== 'es' || parts[1] !== 'barrios') return '';
	if (parts.length === 3) return parts[2] || '';
	if (parts.length === 5) return parts[4] || '';
	return '';
};

const cardDescFor = (p: any) => trimTo(String(p?.description || '').trim(), 120);

const TOP_SUMMARY_BY_SLUG: Record<string, string> = {
	marbella:
		'Marbella combina vida todo el año con playas, gastronomía y un casco antiguo peatonal. La demanda se mantiene fuerte en apartamentos y zonas de villas.',
	'puerto-banus':
		'Puerto Banús es conocido por su puerto deportivo, su vida nocturna y sus tiendas de lujo. Un favorito para apartamentos de cerrar y marchar y para el alquiler.',
	'nueva-andalucia':
		'Nueva Andalucía es el Valle del Golf detrás de Banús, con grandes zonas de villas y urbanizaciones cerradas. Popular entre familias y compradores internacionales.',
	benalmadena:
		'Benalmádena ofrece puerto deportivo, playas y servicios familiares con acceso rápido al aeropuerto. Ideal tanto para uso vacacional como para vivir todo el año.',
	estepona:
		'Estepona tiene un centro revitalizado, puerto deportivo y un largo paseo marítimo, con muchas promociones nuevas. Encaja con quienes buscan valor y estilo de vida.',
};

const topSummaryFor = (p: any) => {
	const slug = slugFromBarrioPath(p) || slugify(String((p as any)._label || ''));
	const mapped = slug && TOP_SUMMARY_BY_SLUG[slug] ? TOP_SUMMARY_BY_SLUG[slug] : '';
	if (mapped) return mapped;
	const first = cardDescFor(p);
	const s1 = first ? (first.endsWith('.') || first.endsWith('…') ? first : `${first}.`) : '';
	const s2 = 'Consulta lo destacado, consejos prácticos y la instantánea actual del mercado en la guía.';
	return s1 ? `${s1} ${s2}` : s2;
};

const items = [...itemsRaw]
	.map((p) => ({
		...p,
		title: stripSuffix(String(p.title || '')),
		_label: stripGuideSuffix(String(p.title || '')) || stripSuffix(String(p.title || '')),
	}))
	.sort((a, b) => String((a as any)._label || a.title || '').localeCompare(String((b as any)._label || b.title || ''), 'es'));

const topItems = (() => {
	const fallbackSlugs = ['marbella', 'puerto-banus', 'nueva-andalucia', 'benalmadena', 'estepona'];
	const uniq: typeof items = [];
	const seen = new Set<string>();
	for (const s of fallbackSlugs) {
		const hit =
			items.find((p) => slugFromBarrioPath(p) === s) ||
			items.find((p) => slugify(String((p as any)._label || '')) === s) ||
			null;
		if (!hit) continue;
		const id = String((hit as any)?.id || hit.path || '');
		if (!id || seen.has(id)) continue;
		seen.add(id);
		uniq.push(hit);
		if (uniq.length >= 5) break;
	}
	return uniq;
})();

const groups = (() => {
	const map = new Map<string, typeof items>();
	for (const p of items) {
		const label = String((p as any)._label || p.title || '').trim();
		const first = label ? label[0]!.toUpperCase() : '#';
		const key = /[A-Z]/.test(first) ? first : '#';
		const arr = map.get(key) || [];
		arr.push(p);
		map.set(key, arr);
	}
	return [...map.entries()].sort((a, b) => a[0].localeCompare(b[0], 'es'));
})();
---

<Layout
	lang="es"
	title="Guías de barrios | PropertyList Info Hub"
	description="Guías de barrios que ayudan a compradores e inquilinos a comparar estilo de vida, desplazamientos, colegios y estrategia de alquiler."
	canonical="https://info.propertylist.es/es/barrios/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/neighbourhood/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/barrios/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/neighbourhood/' },
	]}
>
	<section class="hero" aria-label="Guías de barrios">
		<div class="heroInner">
			<div class="badge">Guías de zona</div>
			<h1>Guías de barrios</h1>
			<p class="lead">Compara estilo de vida, desplazamientos, servicios y potencial de alquiler entre las zonas clave.</p>
			<div class="filterRow">
				<label class="filterLabel" for="nb-filter">Filtrar</label>
				<input id="nb-filter" class="filterInput" type="search" autocomplete="off" spellcheck="false" placeholder="Buscar zonas…" data-nb-filter />
				<div class="count" aria-live="polite" data-nb-count />
			</div>
			<div class="ctaRow" aria-label="Siguientes pasos">
				<a class="cta" href="/es/docs/leyes-procedimientos/">Guía legal de compra</a>
				<a class="cta secondary" href="/es/docs/">Toda la documentación</a>
			</div>
		</div>
	</section>

	{items.length ? (
		<>
			{topItems.length ? (
				<section class="top5" aria-label="Barrios más buscados">
					<h2 class="topTitle">Barrios más buscados</h2>
					<p class="topLead">Populares ahora según las visitas recientes a las guías.</p>
					<div class="topGrid">
						{topItems.map((p) => {
							const title = String((p as any)._label || p.title || '').trim();
							return (
								<article class="topCard">
									<h3 class="topCardTitle">{title}</h3>
									<div class="topSummary">{topSummaryFor(p)}</div>
									<a class="topCta" href={p.path}>
										Ver detalles
									</a>
								</article>
							);
						})}
					</div>
				</section>
			) : null}

			<nav class="jump" aria-label="Saltar a la letra">
				<div class="jumpInner">
					{groups.map(([letter]) => (
						<a class="jumpLink" href={`#letter-${letter}`} data-letter={letter}>
							{letter}
						</a>
					))}
				</div>
			</nav>

			<section class="sections" aria-label="Lista de barrios">
				{groups.map(([letter, pages]) => (
					<section class="section" id={`letter-${letter}`} data-section={letter}>
						<h2 class="sectionTitle">{letter}</h2>
						<div class="grid">
							{pages.map((p) => (
								<a
									class="card"
									href={p.path}
									data-label={String((p as any)._label || p.title || '').toLowerCase()}
								>
									<div class="cardTitle">{String((p as any)._label || p.title || '')}</div>
									{cardDescFor(p) ? <div class="cardDesc">{cardDescFor(p)}</div> : null}
								</a>
							))}
						</div>
					</section>
				))}
			</section>

			<section class="compare" aria-label="Comparación comprador e inquilino">
				<h2>Comprador vs inquilino: qué priorizar</h2>
				<div class="tableWrap" role="region" aria-label="Tabla comparativa" tabindex="0">
					<table class="table">
						<thead>
							<tr>
								<th scope="col">Compradores</th>
								<th scope="col">Inquilinos</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Demanda de reventa, liquidez y rentabilidad futura</td>
								<td>Desplazamientos, ruido y comodidad en el día a día</td>
							</tr>
							<tr>
								<td>Normas de comunidad, gastos y estado del edificio a largo plazo</td>
								<td>Estacionalidad, sol de invierno y facilidad para ir a pie</td>
							</tr>
							<tr>
								<td>Acceso a colegios, aparcamiento y logística de segunda residencia</td>
								<td>Internet, calidad del amueblado y respuesta del propietario</td>
							</tr>
							<tr>
								<td>Viabilidad de licencia de alquiler (si vas a alquilar)</td>
								<td>Condiciones del contrato, fianza y claridad de los suministros</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>
		</>
	) : (
		<div class="empty">Aún no hay guías de barrios.</div>
	)}
</Layout>

<script is:inline>
	(() => {
		const init = () => {
			const input = document.querySelector('[data-nb-filter]');
			const province = document.querySelector('[data-nb-province]');
			const count = document.querySelector('[data-nb-count]');
			if (!(input instanceof HTMLInputElement)) return;

			const norm = (s) =>
				String(s || '')
					.toLowerCase()
					.normalize('NFKD')
					.replace(/[̀-ͯ]/g, '')
					.replace(/\s+/g, ' ')
					.trim();

			const cards = Array.from(document.querySelectorAll('.card[data-label]'))
				.map((el) => {
					if (!(el instanceof HTMLElement)) return null;
					const label = norm(el.getAttribute('data-label') || '');
					const prov = String(el.getAttribute('data-province') || '').trim();
					return { el, label, prov };
				})
				.filter(Boolean);
			const topSection = document.querySelector('.top5');
			const sections = Array.from(document.querySelectorAll('[data-section]'));
			const jumpLinks = Array.from(document.querySelectorAll('.jumpLink[data-letter]'));

			const apply = () => {
				const q = norm(input.value || '');
				const tokens = q ? q.split(' ').filter(Boolean) : [];
				const prov = province instanceof HTMLSelectElement ? String(province.value || '').trim() : '';
				const isSearching = tokens.length > 0;
				let visible = 0;

				if (topSection instanceof HTMLElement) topSection.style.display = isSearching ? 'none' : '';

				for (const c of cards) {
					const matchesQ = !tokens.length || tokens.every((t) => c.label.includes(t));
					const matchesProv = !prov || c.prov === prov;
					const show = matchesQ && matchesProv;
					c.el.style.display = show ? '' : 'none';
					if (show) visible += 1;
				}

				for (const sec of sections) {
					const anyVisible = Array.from(sec.querySelectorAll('.card[data-label]')).some((c) => c.style.display !== 'none');
					sec.style.display = anyVisible ? '' : 'none';
				}

				if (count) count.textContent = visible ? `${visible} gu${visible === 1 ? 'ía' : 'ías'}` : 'Sin resultados';

				for (const a of jumpLinks) {
					const letter = String(a.getAttribute('data-letter') || '').trim();
					const sec = letter ? document.getElementById(`letter-${letter}`) : null;
					const show = sec ? sec.style.display !== 'none' : true;
					a.style.display = show ? '' : 'none';
				}
			};

			input.addEventListener('input', apply, { passive: true });
			if (province) province.addEventListener('change', apply, { passive: true });
			apply();
		};

		if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
		else init();
	})();
</script>

