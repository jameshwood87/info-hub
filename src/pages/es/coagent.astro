---
import Layout from '../../layouts/Layout.astro';
import AgentInterestCta from '../../components/AgentInterestCta.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/coagent/`;
const title = 'PropertyList CoAgent - el CRM con el que hablas por WhatsApp | PropertyList';
const description =
	'Manda una nota de voz al salir de una visita y CoAgent te prepara las actualizaciones del CRM para que las apruebes. Pidele propiedades, la ficha de un cliente, tu proxima visita o cuanto vale una vivienda, o mandale fotos para empezar un anuncio, en el WhatsApp que ya usas. El audio nunca se guarda y nada se graba hasta que respondes SI.';

const asks = [
	{ q: 'Que tenemos en Marbella, tres dormitorios, hasta dos millones?', a: 'Cinco propiedades del MLS compartido con precios y enlaces. No hace falta nombrar a un cliente, asi que funciona con alguien sentado a tu lado.' },
	{ q: 'Donde es mi proxima visita?', a: 'Tu agenda, empezando por la direccion y el telefono del cliente, porque lo estas leyendo en el coche.' },
	{ q: 'Que tengo manana?', a: 'El dia entero, en orden, con la propiedad y con quien has quedado.' },
	{ q: 'Hablame de PL22234', a: 'Precio, dormitorios, superficie, ubicacion y el enlace de esa propiedad, sea tuya o de otra agencia.' },
	{ q: 'Cual es el telefono de Marta Ruiz?', a: 'Su telefono y su email primero, para que puedas llamar directamente.' },
	{ q: 'Ponme al dia con los Berg', a: 'En que punto estan, que buscan y lo ultimo que paso, antes de marcar.' },
	{ q: 'Cuanto vale Nueva Andalucia?', a: 'El precio medio de salida y el rango de lo que hay en el mercado alli. Si no tenemos suficientes anuncios en una zona, te lo dice en vez de inventar una cifra.' },
	{ q: 'Anade una nota a Marta: quiere verla otra vez el sabado', a: 'Te lee la nota con tus propias palabras y la guarda en su ficha cuando respondes SI.' },
	{ q: 'Sigue disponible PL22234?', a: 'Si la propiedad es de otra agencia, CoAgent se ofrece a preguntarles por ti. Responde SI y la consulta les llega por el MLS, y su respuesta vuelve a ti.' },
	{ q: 'Anade a Maria Lopez 600 111 222 maria@email.com', a: 'O comparte su tarjeta de contacto desde el movil. CoAgent te lee el nombre, el telefono y el email y la anade a tu CRM cuando respondes SI. Si ya esta, te enlaza su ficha en vez de crear un duplicado.' },
	{ photo: true, q: 'Fotos de una propiedad nueva', a: 'Mándalas directamente desde la galería y después cuéntale a CoAgent cómo es la propiedad, escribiendo o con una nota de voz. Te pide lo que falte, como el precio, te lee el anuncio y, cuando respondes SÍ, escribe el título, la descripción y las características. Responde PUBLICAR y pasa a revisión, igual que desde el CRM. Nada se publica sin eso.' },
	{ photo: true, q: 'La foto de un cartel de Se Vende', a: 'CoAgent lee el telefono del cartel, y el nombre o el precio si aparecen. Responde SI y el propietario queda guardado como contacto en tu CRM, con una nota del cartel, listo para que le llames.' },
	{ photo: true, q: 'La foto del DNI de un cliente', a: 'Solo se leen el nombre, los apellidos y la fecha de nacimiento, y se anade como contacto nuevo cuando respondes SI. El numero del documento nunca se guarda, y la foto tampoco.' },
	{ q: 'Cual es la mejor compra, PL5001, PL5002 o PL5003?', a: 'Las compara con viviendas parecidas en venta en la zona, con el precio por metro cuadrado, para que puedas decirle al cliente cual tiene buen precio y cual pide demasiado. Preguntalo justo despues de una busqueda y compara esos resultados.' },
	{ q: 'Cuanto vale PL22234?', a: 'Un valor basado en ventas escrituradas ante notario en ese municipio, con un rango y un enlace a la prueba publica. O describe la vivienda: “un piso de 120 m² en Estepona”. Siempre te dice en que se basa la cifra.' },
	{ q: 'INFORME', a: 'Despues de una valoracion, responde INFORME y recibes el Informe de Inteligencia completo de la propiedad, como un enlace que puedes mandar al vendedor. El primero es gratis. Despues cuesta creditos, y te dice cuantos y te pregunta antes de gastar nada.' },
	{ q: '¿Cuántos pisos hay en venta en San Pedro?', a: 'El número real en el mercado allí, las mejores opciones y un enlace a la lista completa en tu CRM.' },
	{ q: 'FOLLETO PL22234', a: 'Un folleto de la propiedad con tu propia marca: una página que tu cliente puede abrir, con el precio de hoy y un formulario para consultar, y el PDF. Antes te dice el precio en créditos, y un folleto que ya hiciste se vuelve a enviar gratis.' },
	{ photo: true, q: 'La foto de una estancia antigua, con "reformar"', a: 'En plena visita, manda la cocina tal como está y recíbela reformada un minuto después, para enseñarle al comprador lo que podría ser. Cuesta lo mismo que en el CRM, y solo se cobra un render que sale bien.' },
	{ q: 'Marta ha hecho una oferta', a: 'CoAgent mueve su tarjeta a la etapa correcta de tu pipeline cuando respondes SÍ, igual que arrastrarla en el CRM. Marcar un cliente como ganado o perdido se queda en el CRM, donde te pide los detalles.' },
	{ q: 'RESPONDER', a: 'CoAgent escribe un email a tu último lead en su propio idioma, a partir de lo que preguntó. Responde SÍ y sale de tu parte a través del CRM, y su respuesta llega a tu email. O simplemente contesta al aviso de lead nuevo.' },
	{ q: 'Vamos a anunciar una propiedad', a: 'CoAgent te dice qué enviar: las fotos, y después el precio, dónde está y los dormitorios, con tus propias palabras. Sin comandos que aprender.' },
];

const trust = [
	{ name: 'Tu voz no se guarda', desc: 'El audio se transcribe y se descarta. Solo queda el texto, en la ficha a la que pertenece, donde puedes leerlo y corregirlo. No hay grabacion que filtrar ni que entregar.' },
	{ name: 'Nada se guarda sin tu permiso', desc: 'CoAgent te muestra lo que quiere cambiar y espera. Ninguna ficha se edita y ninguna consulta sale hacia otra agencia hasta que respondes SI. Si no dices nada, no pasa nada.' },
	{ name: 'Responde con tus datos o no responde', desc: 'Cada respuesta sale de tu CRM y del MLS compartido. Preguntale algo fuera de eso y te lo dice claramente, en lugar de inventarse un dato que podrias repetirle a un cliente.' },
];

const soon = [
	{ name: 'Tu propio WhatsApp, conectado', desc: 'Seguir escribiendo a los clientes desde tu numero y que esas conversaciones se archiven solas, en ambos sentidos, sin capturar nunca a quien no es cliente. En diseno.' },
	{ name: 'Una linea de trabajo', desc: 'Un numero de empresa dentro de la app de PropertyList, junto a tu SIM personal, con las llamadas resumidas igual que una nota de voz. En la hoja de ruta.' },
	{ name: 'La ficha en la pantalla de llamada', desc: 'Hoy puedes pedir la ficha de un cliente cuando quieras. Que aparezca sola al sonar el telefono necesita trabajo dentro de la app movil, y es la siguiente pieza.' },
];

const plans = [
	{ name: 'Septiembre: gratis para todos', desc: 'Todos los agentes, todos los mensajes, sin limite, mientras lanzamos.' },
	{ name: 'Los 10 primeros agentes: gratis hasta el 1 de enero', desc: 'Los diez primeros agentes que escriban a CoAgent lo mantienen gratis e ilimitado tres meses más, hasta el 1 de enero.' },
	{ name: 'Desde octubre: 5 al dia gratis, o ilimitado', desc: 'Cada agente tiene 5 mensajes gratis al dia, y aprobar con SI nunca cuenta. Para mas, CoAgent ilimitado cuesta 50 creditos al mes por agente, y se activa desde la pagina de Facturacion o respondiendo SUSCRIBIR.' },
];

const faqs = [
	{ q: 'Que tengo que instalar?', a: 'Nada. CoAgent funciona en WhatsApp, que ya usas todo el dia. Guarda el numero de PropertyList, asegurate de que tu movil esta en tu perfil del CRM para que sepa que eres agente y no cliente, y mandale una nota de voz.' },
	{ q: 'Va a cambiar mi CRM automaticamente?', a: 'No. CoAgent propone y espera. Te ensena el cliente que ha identificado y los cambios que quiere hacer, campo por campo, y no escribe nada hasta que respondes SI. Si entiende mal algo, te cuesta una palabra, no un presupuesto equivocado guardado en una ficha compartida.' },
	{ q: 'Se graban mis notas de voz?', a: 'No. El audio se transcribe y se descarta. La transcripcion se guarda en la ficha del cliente, donde puedes leer exactamente lo que se le dijo al CRM.' },
	{ q: 'Funciona en espanol?', a: 'Si, y en aleman, frances, portugues, bulgaro y griego. Responde en tu idioma y entiende una nota que cambia de idioma a mitad de frase, que en esta costa son casi todas.' },
	{ q: 'Tengo que nombrar a un cliente siempre?', a: 'No. Nombrar a un cliente convierte la nota de voz en actualizaciones del CRM. Sin nombrarlo puedes pedir propiedades, tu agenda, una referencia concreta o cuanto vale una zona, que es justo lo que necesitas con alguien esperando a tu lado.' },
	{ q: 'Puede hablar con otras agencias por mi?', a: 'Si. Preguntale si una propiedad de otra agencia sigue disponible y CoAgent se ofrece a enviar la consulta. Responde SI y sale por el MLS igual que una enviada desde el CRM, asi que les llega por su via de siempre.' },
	{ q: 'Y si CoAgent no reconoce mi numero?', a: 'Te responde, en espanol y en ingles, con un enlace para crear tu cuenta gratis y otro a la pagina Personal de tu CRM, donde anades tu movil a tu perfil. Si tu numero no es espanol, ponle delante el prefijo del pais, y vuelve a escribirle.' },
	{ q: '¿Qué se paga con créditos?', a: 'Los mensajes entran en tu plan. Un folleto, el informe de mercado después del primero gratis y una estancia reformada se pagan con créditos de PropertyList, al mismo precio que en el CRM. CoAgent siempre te dice el precio y espera tu SÍ antes de gastar nada, y un folleto o un render que falla nunca se cobra.' },
	{ q: 'Cuanto cuesta?', a: 'CoAgent es gratis para todos en septiembre. Los 10 primeros agentes que le escriban lo mantienen gratis e ilimitado hasta el 1 de enero. Desde octubre cada agente tiene 5 mensajes gratis al día, y aprobar con SÍ nunca cuenta; el ilimitado cuesta 50 créditos al mes por agente, se paga con tus créditos de PropertyList y puedes dejar de renovarlo cuando quieras. El MLS y el núcleo del CRM siguen siendo gratis, y crear tu cuenta no cuesta nada.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: `${origin}/es/` },
		{ '@type': 'ListItem', position: 2, name: 'Funciones', item: `${origin}/es/features/` },
		{ '@type': 'ListItem', position: 3, name: 'CoAgent', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList CoAgent',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android', url: canonical,
	description: 'Un asistente para agentes inmobiliarios que funciona por WhatsApp: las notas de voz se convierten en actualizaciones del CRM que el agente aprueba, y las preguntas sobre clientes, propiedades, agenda y precios de zona se responden desde el CRM de la agencia y el MLS compartido. El audio nunca se guarda.',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};

const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=es';
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	hideSearch
	hreflangs={[
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'en', href: `${origin}/coagent/` },
		{ hreflang: 'x-default', href: `${origin}/coagent/` },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="heroInner heroGrid">
			<div>
				<div class="kicker">CoAgent</div>
				<h1>Habla con tu CRM como hablas con un companero.</h1>
				<p class="heroSub">Sales de la visita. Mandas una nota de voz. El resumen te espera para que lo apruebes.</p>
				<div class="whatIs">
					<div class="whatIsTitle">Como va</div>
					<ol>
						<li>Terminas una llamada o una visita y mandas una nota de voz, en el WhatsApp que ya usas.</li>
						<li>CoAgent deduce que ha cambiado y te lo ensena antes de tocar nada.</li>
						<li>Respondes SI. La busqueda, la nota y los recordatorios quedan en el CRM.</li>
						<li>Y ya que estas, pidele propiedades, un telefono o tu proxima cita.</li>
					</ol>
				</div>
				<p class="lead">
					El papeleo que se come tus tardes se escribe solo. Lo que prometiste el martes pasado se convierte en un recordatorio. Y
					cuando tienes a un cliente al lado preguntando que hay en Marbella por dos millones, lo preguntas en voz alta y la
					respuesta vuelve al mismo chat.
				</p>
				<div class="winRow" aria-label="What CoAgent gives back">
					<div class="win"><b>Recuperas las tardes</b><span>El resumen despues de la visita se hace solo.</span></div>
					<div class="win"><b>Promesas cumplidas</b><span>Lo que dijiste que harias se convierte en recordatorio.</span></div>
					<div class="win"><b>Respuestas en el coche</b><span>Agenda, propiedades y telefonos sin abrir el portatil.</span></div>
				</div>
				<div class="ctaRow">
					<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Crea tu cuenta gratis</a>
					<a class="btnSecondary" href="#ask">Mira que le puedes pedir</a>
				</div>
				<div class="note">Ya funciona para los agentes de PropertyList. Nada que instalar.</div>
			</div>

			<div class="bfWrap" aria-hidden="true">
				<div class="bfTag">Despues de la visita</div>
				<div class="bfCard">
					<div class="bfHead">
						<span class="bfAvatar">MR</span>
						<span>
							<b>Marta Ruiz</b>
							<i>Compradora &middot; identificada en tu nota</i>
						</span>
						<span class="bfRing"></span>
					</div>
					<div class="bfReq">Presupuesto 800.000 &euro; &rarr; <b>850.000 &euro;</b> &middot; + Nueva Andaluc&iacute;a &middot; 3 dorm.</div>
					<div class="bfMeta">Recordatorio: enviar la propiedad de Cerquilla &middot; sabado</div>
					<div class="bfWarn">Responde SI para guardarlo todo. Todavia no se ha escrito nada.</div>
					<div class="bfFoot">Se transcribe y el audio se descarta</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="how">
		<div class="sectionHead">
			<h2>Lo que nadie hace: escribirlo</h2>
			<p>Todos sabemos que un CRM solo te devuelve algo si esta al dia, y todos sabemos lo que pasa de verdad entre visita y visita. CoAgent recoge la nota donde ya estas, en el formato que ya usas, y escribe el por ti.</p>
		</div>
		<div class="grid3 steps">
			<div class="card step">
				<div class="stepTime">Paso 1</div>
				<h3>Manda la nota de voz</h3>
				<p>"Acabo de ver el piso de Nueva Andaluc&iacute;a con Marta. Ahora acepta tres dormitorios, hasta ochocientos cincuenta, y le he dicho que le mando el de Cerquilla el sabado."</p>
			</div>
			<div class="card step">
				<div class="stepTime">Paso 2</div>
				<h3>Lee lo que ha entendido</h3>
				<p>Te devuelve el cliente que ha identificado, los cambios que propone en su busqueda, el recordatorio del sabado y las propiedades que ahora le encajan.</p>
			</div>
			<div class="card step">
				<div class="stepTime">Paso 3</div>
				<h3>Responde SI</h3>
				<p>Solo entonces se mueve algo. La busqueda se actualiza, la nota queda en su historial y el sabado esta en tu calendario. Si no dices nada, no pasa nada.</p>
			</div>
		</div>
	</section>

	<section class="section" id="ask">
		<div class="sectionHead">
			<h2>Todo lo demas que le puedes pedir</h2>
			<p>Por voz o escribiendo, con tus palabras. CoAgent deduce que querias decir en vez de obligarte a aprender comandos, y cuando algo se sale de lo que tiene, te lo dice.</p>
		</div>
		<div class="grid2">
			{
				asks.map((item) => (
					<div class="card">
						{item.photo && <div class="stepTime">Manda una foto</div>}
						<h3>{item.photo ? item.q : `“${item.q}”`}</h3>
						<p>{item.a}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Tu privacidad: que se guarda y que no</h2>
			<p>Un asistente que escucha tus conversaciones tiene que ganarse el sitio. Esto son decisiones de diseno, no ajustes que tengas que buscar.</p>
		</div>
		<div class="grid3">
			{
				trust.map((t) => (
					<div class="card accent">
						<h3>{t.name}</h3>
						<p>{t.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="grid2">
			<div class="card accent">
				<h2>Habla el idioma de esta costa</h2>
				<p>
					Aqui los clientes cambian de ingles a espanol a mitad de frase, y los agentes tambien. CoAgent entiende una nota que
					cambia de idioma por el camino y responde en el tuyo: espanol, ingles, aleman, frances, portugues, bulgaro o griego.
					Los nombres, los presupuestos y las zonas siguen cayendo en el campo correcto.
				</p>
			</div>
			<div class="card">
				<h2>Ninguna app nueva que aprender</h2>
				<p>
					CoAgent no es otra app que adoptar. Vive en WhatsApp, y detras esta la plataforma donde ya trabajan mas de 1.300 agentes
					y mas de 970 agencias, buscando entre mas de 4.400 propiedades compartidas en cuanto un cliente te dice lo que quiere.
				</p>
			</div>
		</div>
	</section>

	<section class="section" id="precios">
		<div class="sectionHead">
			<h2>Cuanto cuesta</h2>
			<p>Sin permanencia. El ilimitado se paga en creditos, del mismo saldo que todo lo demas en PropertyList, y puedes dejar de renovarlo cuando quieras.</p>
		</div>
		<div class="grid3">
			{
				plans.map((p) => (
					<div class="card">
						<h3>{p.name}</h3>
						<p>{p.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section" id="next">
		<div class="sectionHead">
			<h2>Lo que estamos construyendo ahora</h2>
			<p>Todo lo de arriba funciona hoy. Esto todavia no, y preferimos decirlo aqui a que lo descubras despues.</p>
		</div>
		<div class="grid3">
			{
				soon.map((s) => (
					<div class="card">
						<h3>{s.name}</h3>
						<p>{s.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="sectionHead"><h2>Preguntas, resueltas</h2></div>
		<div class="faq">
			{
				faqs.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<section class="cta">
		<div class="ctaInner">
			<h2>Se acuerda de cada promesa que hiciste.</h2>
			<p>Tu memoria es excelente. Hasta el jueves. Cada agente lleva cincuenta promesas abiertas en la cabeza, y la que se escapa siempre es la que importaba. Crea tu cuenta gratis y empieza a hablar con el, dentro de la <a href="/es/features/">plataforma gratuita de PropertyList</a>.</p>
			<div class="ctaRow">
				<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Crea tu cuenta gratis</a>
			</div>
		</div>
	</section>

	<style>
		:global(:root) {
			--pl-accent: #00ae9a;
			--pl-accent-rgb: 0, 174, 154;
			--pl-ink: #0a6d61;
		}
		h1, h2, h3 { letter-spacing: -0.03em; }
		.hero { border-radius: 22px; padding: 16px; margin: 0 0 14px; border: 1px solid rgba(16, 24, 40, 0.08);
			background: radial-gradient(1200px 600px at 20% -10%, rgba(var(--pl-accent-rgb), 0.22), rgba(255, 255, 255, 0)), radial-gradient(900px 500px at 90% 10%, rgba(var(--pl-accent-rgb), 0.12), rgba(255, 255, 255, 0)); }
		.heroInner { background: rgba(255, 255, 255, 0.8); border: 1px solid rgba(16, 24, 40, 0.06); border-radius: 18px; padding: 22px; }
		.heroGrid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 24px; align-items: center; }
		.kicker { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(var(--pl-accent-rgb), 0.12); border: 1px solid rgba(var(--pl-accent-rgb), 0.22); color: var(--pl-ink); font-weight: 900; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
		h1 { margin: 14px 0 12px; line-height: 1.06; font-size: clamp(28px, 4.4vw, 42px); }
		.lead { margin: 0 0 16px; color: rgba(16, 24, 40, 0.75); max-width: 60ch; line-height: 1.62; }
		.note { color: rgba(16, 24, 40, 0.6); font-weight: 700; font-size: 12.5px; margin-top: 12px; }
		.whatIs { border: 1px solid rgba(0,174,154,0.28); background: rgba(0,174,154,0.06); border-radius: 14px; padding: 14px 16px; margin: 0 0 16px; }
		.whatIsTitle { font-size: 12px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: rgba(11,18,32,.55); margin-bottom: 8px; }
		.whatIs ol { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
		.whatIs li { color: rgba(16,24,40,.82); line-height: 1.5; font-size: 15.5px; }
		.heroSub { margin: -4px 0 12px; font-size: 17px; font-weight: 700; color: rgba(11,18,32,.6); letter-spacing: -.01em; }
		.winRow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0 0 16px; }
		.win { background: rgba(255, 255, 255, 0.75); border: 1px solid rgba(var(--pl-accent-rgb), 0.25); border-radius: 12px; padding: 10px 12px; }
		.win b { display: block; font-size: 13px; color: var(--pl-ink); }
		.win span { display: block; font-size: 12px; color: rgba(16, 24, 40, 0.65); line-height: 1.45; margin-top: 2px; }
		@media (max-width: 560px) { .winRow { grid-template-columns: minmax(0, 1fr); } }
		.ctaRow { display: flex; gap: 12px; flex-wrap: wrap; }
