---
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
import AgentInterestCta from '../../components/AgentInterestCta.astro';

const __ps = await getPortalStats();
const plListings = statPlus(__ps.listings, 'es');
const plAgents = statPlus(__ps.agents, 'es');
const plAgencies = statPlus(__ps.agencies, 'es');

const title = 'Precios: software inmobiliario y MLS gratis | PropertyList';
const description =
	'El MLS y el CRM son gratis para siempre para agentes inmobiliarios. Usa créditos de pago por uso opcionales para destacar anuncios y complementos, solo cuando los necesites.';

const sections: Array<{
	title: string;
	subtitle: string;
	items: Array<{ feature: string; price: string; note?: string }>;
}> = [
	{
		title: 'MLS',
		subtitle: 'Multi-Listing Service',
		items: [
			{ feature: 'Anuncios ilimitados', price: 'Gratis' },
			{ feature: 'Publica con la voz (Instant Listing)', price: 'Gratis' },
			{ feature: 'Usuarios/Personal', price: 'Gratis' },
			{ feature: 'MicroSite con tu marca', price: 'Gratis' },
			{ feature: 'Destacar un anuncio', price: 'desde 10 créditos (~10€)' },
			{ feature: 'Alertas de propiedades', price: 'Gratis' },
			{ feature: 'Anuncios Privados (no compartir)', price: '5 gratis, después 5 créditos cada uno' },
			{ feature: 'LeadBoard', price: 'Próximamente' },
			{ feature: 'Importación XML', price: 'Gratis' },
			{ feature: 'Envío XML a otros portales', price: 'Gratis' },
			{ feature: 'Feed a tu propia web (XML o API): todos los anuncios de la red del MLS, reventa y alquileres. Tus propios anuncios son gratis', price: '35 créditos / mes' },
			{ feature: 'Feed a tu propia web: obra nueva y sobre plano de la red (feed aparte)', price: '25 créditos / mes' },
		],
	},
	{
		title: 'CRM',
		subtitle: 'Gestión de Relaciones con Clientes',
		items: [
			{ feature: 'Contactos ilimitados', price: 'Gratis' },
			{ feature: 'Eventos de calendario', price: 'Gratis' },
			{ feature: 'Pipeline de Leads', price: 'Gratis' },
			{ feature: 'Pipeline de Buyers (tú eliges quién entra)', price: '1 crédito por cada lead que metas en él' },
			{ feature: 'Pipeline de Sellers', price: 'Gratis' },
			{ feature: 'Pipeline de Property', price: 'Gratis' },
			{ feature: 'Pipeline de Tenants (Rentals Module)', price: '50 créditos / 30 días, prueba gratis de 30 días' },
			{ feature: 'Pipeline de Nurture (Automation & Nurture)', price: '20 créditos/mes' },
			{ feature: 'Subida de documentos', price: 'Gratis' },
			{ feature: 'Embudos de IA', price: 'Próximamente' },
			{ feature: 'Chatbot de IA', price: 'Próximamente' },
			{ feature: 'Análisis de mercado por propiedad', price: '5 créditos por análisis (oferta por tiempo limitado)' },
		],
	},
	{
		title: 'Portal Público',
		subtitle: 'Anunciamos por ti',
		items: [
			{ feature: 'Destacar un anuncio', price: 'desde 10 créditos (~10€)' },
			{ feature: 'Búsqueda con IA (busca escribiendo)', price: 'Gratis' },
			{ feature: 'Abrir un lead directo', price: 'Gratis por tiempo limitado' },
			{ feature: 'Agentes destacados', price: 'Próximamente' },
			{ feature: 'Tours virtuales con IA', price: 'Próximamente' },
			{ feature: 'Portada premium', price: 'Próximamente' },
		],
	},
	{
		title: 'Constructor de Webs',
		subtitle: 'Tu propia web de agencia',
		items: [
			{ feature: 'Constructor drag-and-drop', price: '50 créditos/mes' },
			{ feature: 'SEO y meta con IA', price: '5 créditos/mes' },
			{ feature: 'Instant Content: blogs y guías de zona con IA ilimitados', price: '30 créditos/mes, requiere el Constructor de Webs' },
			{ feature: 'Captura de leads con popup', price: '8 créditos/mes' },
			{ feature: 'Dominio personalizado', price: '20 créditos/mes' },
			{ feature: 'Quitar la marca PropertyList', price: '50 créditos/mes' },
			{ feature: 'Todos los anuncios del MLS cargados automáticamente', price: 'Incluido' },
			{ feature: 'Hosting y SSL gratis', price: 'Incluido' },
		],
	},
];

const pricingFaqItems = [
	{
		q: '¿PropertyList es realmente gratis para agentes inmobiliarios?',
		a: 'El núcleo es gratis y sin límite: el MLS, los anuncios ilimitados, las cuentas de equipo, la gestión de contactos y los pipelines de Leads, Vendedores y Propiedades. El CRM no es 100% gratis: pasar un lead de comprador cualificado al pipeline de Buyer cuesta 1 crédito (~1€). Los 5 primeros son gratis, después es 1 crédito cada uno. Lo demás que se paga es opcional: destacar anuncios (10 créditos (~10€) por 3 días), el Módulo de Alquileres (50 créditos / 30 días, con prueba gratis de 30 días), Automation y Nurture (20 créditos al mes) o el Constructor de Webs (50 créditos al mes).',
	},
	{
		q: '¿Cómo funcionan los créditos?',
		a: 'Todo lo de pago en PropertyList sale de un único saldo de créditos. Se compran en packs - desde 20 € por 20 créditos (1 € cada uno) hasta 0,80 € por crédito en el pack de 1.000 - y los créditos comprados nunca caducan. Las suscripciones mensuales (como el Constructor de Webs) y las funciones de pago por uso (como los informes de mercado) salen del mismo saldo.',
	},
	{
		q: '¿Qué pasa si me quedo sin créditos?',
		a: 'No se pierde nada. Si tu saldo no cubre una renovación, tu web personalizada se pausa y los visitantes ven la página estándar, mientras todas tus páginas y ajustes quedan guardados como borrador. Recarga y republica con un clic. Activa la Auto-Renovación y tu saldo se recarga automáticamente antes de cada renovación, por el coste mensual de lo que tengas activo, para que nada se pause ni caduque.',
	},
	{
		q: '¿Puedo cancelar mi suscripción al constructor de webs en cualquier momento?',
		a: 'Sí. No hay contratos de permanencia ni comisiones de cancelación. Desactiva una función y simplemente no se renueva el mes siguiente; el mes en curso sigue activo hasta tu fecha de renovación (no hay reembolsos por mes parcial).',
	},
	{
		q: '¿Qué incluye el plan gratuito?',
		a: 'Anuncios de propiedades ilimitados, Publica con la voz (crea un anuncio completo con fotos y una nota de voz con Instant Listing), búsqueda de propiedades con IA, cuentas de personal ilimitadas, un MicroSite con la marca de tu agencia, CRM con gestión de contactos y leads, eventos de calendario, pipeline de leads, subida de documentos, acceso a la Comunidad de WhatsApp y distribución social en Facebook - todo gratis.',
	},
	{
		q: '¿Cómo funcionan los pipelines del CRM?',
		a: 'PropertyList incluye seis pipelines de CRM. Lead, Seller y Property son gratis. Buyer cuesta 1 crédito (~1€) por lead de comprador, que solo se gasta si decides meter ese contacto en el pipeline, y los 5 primeros son gratis. Tenants va incluido en el Rentals Module (pipeline de Tenants, Tenancies y Maintenance): 50 créditos por período de 30 días, con prueba gratis de 30 días y sin cargo hasta que renueves. Nurture va incluido en Automation & Nurture por 20 créditos/mes (unos 20 €), un solo producto a un solo precio, que cubre además los emails automáticos, la detección de leads calientes y la Daily Action Queue. Los leads nuevos entran en New Lead y los anuncios nuevos en Active Listing. Lead y Seller son fijos; Buyer y Property los puedes editar. La fase legal está dentro de los pipelines de Buyer y Property: Reservation Paid, Deposit Paid, Mortgage in Progress, Notary Appointment y WON - Deed Signed.',
	},
	{
		q: '¿Cuánto cuesta el Constructor de Webs?',
		a: 'La web base son 50 créditos al mes (unos 50 €) e incluye tu página de resultados, las fichas de propiedades y tus primeras páginas; cada página extra son 10 créditos/mes. Añade potenciadores opcionales: Instant Content (30 créditos/mes, blogs y guías de zona con IA ilimitados), meta SEO con IA (5 créditos/mes), captura de leads con popup (8 créditos/mes), dominio personalizado (20 créditos/mes) o quitar la marca PropertyList (50 créditos/mes). Hosting gratis, SSL y carga automática de anuncios del MLS siempre incluidos.',
	},
	{
		q: '¿Instant Content puede funcionar en automático?',
		a: 'Sí. Activa la publicación automática y escribe y publica solo blogs y guías de zona SEO ilimitados para tu web, basados en tus propios anuncios y datos de mercado verificados - o elige revisar y aprobar cada pieza antes de publicarla.',
	},
	{
		q: '¿Hay una prueba gratis para las funciones de pago?',
		a: 'Sí. Cada función de pago incluye una prueba gratuita, así que puedes probarla antes de gastar créditos: tus 5 primeros leads de comprador son gratis, el informe de mercado por propiedad te da 3 informes gratis, el Módulo de Alquileres tiene una prueba de 30 días, y el Constructor de Webs es gratis para crear y previsualizar hasta que lo publiques. Las Agencias Verificadas también reciben 20 créditos gratis, y ganas otros 20 créditos por cada agencia que se registre con tu enlace de referido, mientras que la agencia nueva empieza con 10.',
		link: { href: 'https://agents.propertylist.es/referrals', label: 'Consigue tu enlace de referido' },
	},
];

const pricingFaqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: pricingFaqItems.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const softwareAppLd = {
 "@context": "https://schema.org",
 "@type": "SoftwareApplication",
 "name": "PropertyList",
 "applicationCategory": "BusinessApplication",
 "applicationSubCategory": "Estate agency CRM, agent-to-agent MLS and property portal",
 "operatingSystem": "Web browser, Android",
 "url": "https://propertylist.es/",
 "sameAs": [
  "https://agents.propertylist.es/",
  "https://info.propertylist.es/"
 ],
 "inLanguage": [
  "en",
  "es"
 ],
 "areaServed": {
  "@type": "Country",
  "name": "Spain"
 },
 "provider": {
  "@type": "Organization",
  "name": "PropertyList"
 },
 "description": `Estate agency system for Spain combining a CRM, an agent-to-agent MLS shared by ${plAgents} agents across ${plAgencies} agencies, and a public property portal. Listings, the CRM and the Lead, Seller and Property pipelines are free with no limit. A buyer lead costs 1 credit, and only when the agent chooses to move it into the Buyer pipeline. Automation, rentals and the website builder are monthly credit subscriptions from one prepaid balance.`,
 "featureList": [
  "Six CRM pipelines: Leads, Buyers, Sellers, Property, Tenants, Nurture",
  `Agent-to-agent MLS with co-broking across ${plAgencies} agencies`,
  "Public property portal listing and direct buyer enquiries",
  "AI Property Match: plain-language search across own stock and the whole MLS",
  "Automated lead acknowledgement and a day 0, 1, 3, 7 follow-up cadence",
  "Nurture: automated past-client follow-up with intent detection",
  "Rentals Module: tenancies, renewals, annual rent review, deposit compliance, maintenance",
  "Free branded MicroSite for every agency",
  "AI website builder with automated SEO content",
  "Notary-verified register prices and per-property CMA reports",
  "XML feed import and export",
  "Android app",
  "MCP server for AI-native property queries"
 ],
 "offers": [
  {
   "@type": "Offer",
   "name": "Free plan",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "MLS and CRM, unlimited listings, unlimited staff accounts, the Lead, Seller and Property pipelines, a branded MicroSite and XML push to other portals. No card, no time limit."
  },
  {
   "@type": "Offer",
   "name": "Portal direct lead",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "Enquiries from the public property portal are free to open, taking no credits. Free for a limited time; expected to move to a pay-per-lead model in future, with notice."
  },
  {
   "@type": "Offer",
   "name": "Buyer lead",
   "price": "1",
   "priceCurrency": "EUR",
   "description": "Costs 1 credit, charged only when the agent chooses to move a qualified contact into the Buyer pipeline, and the first 5 are free. Everything up to that point is free and declining costs nothing. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  },
  {
   "@type": "Offer",
   "name": "Automation and Nurture",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "20",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "20 credits a month from the same prepaid credit balance as everything else. Includes the Nurture pipeline, all automated emails, Hot-lead detection and the Daily Action Queue. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  },
  {
   "@type": "Offer",
   "name": "Rentals Module",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits per 30-day period, taken from your prepaid credit balance, bought in advance at 1.00 EUR per credit and less in larger packs. Free 30-day trial with no charge until you renew. Includes the Tenants pipeline, Tenancies, Maintenance and renewal email reminders."
  },
  {
   "@type": "Offer",
   "name": "Website Builder",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits a month. Add-ons are separate monthly credit costs, for example pop-up lead capture at 8 and auto meta descriptions at 5. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  }
 ],
 "paymentAccepted": "Credits from a single prepaid balance",
 "termsOfService": "https://info.propertylist.es/docs/propertylist-mls-user-manual/credits/how-billing-works/"
};

---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/es/precios/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/pricing/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/precios/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/pricing/' },
	]}
	schema={[pricingFaqLd, softwareAppLd]}
>
	<section class="hero">
		<div class="heroInner">
			<div class="badge">Precios transparentes</div>
			<h1>MLS + CRM gratis. Paga solo por las mejoras.</h1>
			<p class="lead">
				PropertyList ofrece a cada agente inmobiliario y promotor acceso gratis para publicar propiedades, colaborar con tu equipo y gestionar
				contactos - sin suscripciones. Cuando quieras más visibilidad o automatización, usa créditos de pago por uso a tu propio ritmo.
			</p>
			<div class="ctaRow">
				<a class="btnPrimary" href="/es/docs/propertylist-mls-manual-de-usuario/">Empieza con el manual del MLS</a>
				<a class="btnSecondary" href="/es/docs/">Ver la documentación</a>
			</div>
			<div class="trustRow" aria-label="Términos clave">
				<div class="trustPill">Sin permanencia</div>
				<div class="trustPill">Sin cuotas de alta</div>
				<div class="trustPill">Sin comisiones de cancelación</div>
				<div class="trustPill">Sin costes ocultos</div>
			</div>
		</div>
	</section>

	<section aria-label="Precios por perfil" style="max-width:1120px;margin:6px auto 0;padding:0 20px;">
		<div style="display:flex;gap:12px;flex-wrap:wrap;">
			<a href="#agents" style="flex:1 1 200px;display:block;background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:16px 18px;text-decoration:none;color:inherit;"><span style="font-size:20px;">🏠</span><span style="display:block;font-weight:800;font-size:15.5px;margin-top:6px;color:#0b1220;">Agentes inmobiliarios</span><span style="display:block;font-size:13px;color:rgba(16,24,40,0.62);margin-top:3px;line-height:1.45;">MLS + CRM gratis para siempre. Créditos solo para mejoras opcionales.</span></a>
			<a href="#developers" style="flex:1 1 200px;display:block;background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:16px 18px;text-decoration:none;color:inherit;"><span style="font-size:20px;">🏗️</span><span style="display:block;font-weight:800;font-size:15.5px;margin-top:6px;color:#0b1220;">Promotores</span><span style="display:block;font-size:13px;color:rgba(16,24,40,0.62);margin-top:3px;line-height:1.45;">Sin suscripción. Tú fijas la comisión, pagadera solo con ventas reales.</span></a>
			<a href="#buyers" style="flex:1 1 200px;display:block;background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:16px 18px;text-decoration:none;color:inherit;"><span style="font-size:20px;">🔑</span><span style="display:block;font-weight:800;font-size:15.5px;margin-top:6px;color:#0b1220;">Compradores y vendedores</span><span style="display:block;font-size:13px;color:rgba(16,24,40,0.62);margin-top:3px;line-height:1.45;">Buscar, la búsqueda con IA y las consultas son gratis. Sin cuenta.</span></a>
			<a href="#services" style="flex:1 1 200px;display:block;background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:16px 18px;text-decoration:none;color:inherit;"><span style="font-size:20px;">🧰</span><span style="display:block;font-weight:800;font-size:15.5px;margin-top:6px;color:#0b1220;">Servicios inmobiliarios</span><span style="display:block;font-size:13px;color:rgba(16,24,40,0.62);margin-top:3px;line-height:1.45;">Muy pronto - un lugar para los oficios de cada mudanza.</span></a>
		</div>
	</section>

	<section class="section" id="agents">
		<div class="twoCol">
			<div class="panel">
				<h2>Por qué el MLS es gratis</h2>
				<p>
					En PropertyList potenciamos a todos los agentes inmobiliarios y promotores dándoles acceso gratis a nuestra plataforma. Esto permite a los
					agentes mostrar sus propiedades sin costes iniciales, y ofrece a quienes buscan propiedad una amplia variedad donde elegir.
				</p>
				<p>
					Creemos en un mercado inclusivo donde cada agente y cada anuncio pueda brillar - por eso mantenemos lo esencial gratis y solo ganamos con
					herramientas opcionales de valor añadido.
				</p>
				<figure class="panelMock">
					<img src="/img/mls-preview-es.jpg" alt="Anuncios de propiedades en vivo en el portal público de PropertyList - villas y apartamentos en venta en Marbella" loading="lazy" width="980" height="700" />
					<figcaption>El MLS como lo ven los compradores - anuncios en vivo ahora mismo en <a href="https://propertylist.es/portal/for-sale/marbella" target="_blank" rel="noopener">propertylist.es</a>.</figcaption>
				</figure>
				<figure class="panelMock">
					<img src="/img/crm-dashboard.jpg" alt="El panel del CRM de PropertyList: pipelines de leads, compradores, vendedores y transacciones, AI Property Match, agenda y saldo de créditos" loading="lazy" width="1600" height="792" />
					<figcaption>...y el CRM en el que trabajan los agentes: pipelines, AI Property Match, agenda y leads. El núcleo es gratis; mover un lead cualificado al pipeline de Buyer cuesta 1 crédito.</figcaption>
				</figure>
			</div>
			<div class="panel">
				<h2>Créditos: un solo saldo para todo</h2>
				<p>
					Todo lo de pago en PropertyList sale de un único saldo de créditos - suscripciones mensuales como tu web y extras de
					pago por uso como los informes de mercado. Compra packs cuando quieras; los packs grandes salen mejor. Precios en
					euros, IVA al pagar.
				</p>
				<div class="creditPacks">
					<div class="creditPackRow creditPackHead"><span>Pagas</span><span>Recibes</span><span>Sale a</span></div>
					<div class="creditPackRow"><span>20 €</span><span>20 créditos</span><span>1,00 € / crédito</span></div>
					<div class="creditPackRow"><span>47 €</span><span>50 créditos</span><span>0,94 € / crédito</span></div>
					<div class="creditPackRow"><span>90 €</span><span>100 créditos</span><span>0,90 € / crédito</span></div>
					<div class="creditPackRow"><span>425 €</span><span>500 créditos</span><span>0,85 € / crédito</span></div>
					<div class="creditPackRow"><span>800 €</span><span>1.000 créditos</span><span>0,80 € / crédito</span></div>
				</div>
				<div class="callout">
					<div class="calloutTitle">Los créditos comprados nunca caducan</div>
					<div class="calloutBody">Quedan en tu saldo hasta que los uses. Si una renovación te pilla sin saldo, tu web se pausa como borrador - no se pierde nada y con un clic la republicas.</div>
				</div>
				<div class="callout muted">
					<div class="calloutTitle">Bono de Agencia Verificada</div>
					<div class="calloutBody">Cada Agencia Verificada recibe 20 créditos gratis.</div>
				</div>
				<div class="callout muted">
					<div class="calloutTitle">Novedad: Auto-Renovación</div>
					<div class="calloutBody">Guarda una tarjeta y recargamos tu saldo automáticamente antes de cada renovación, por el coste mensual de tus suscripciones activas, para que nada se caiga. Es una forma de pagar, no un cargo extra.</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Extras de pago (todas las funciones)</h2>
			<div class="sectionMeta">Pago por uso, a tu propio ritmo.</div>
		</div>
		<div class="grid">
			{sections.map((s) => (
				<section class="pricingCard">
					<div class="pricingHead">
						<div class="pricingTitle">{s.title}</div>
						<div class="pricingSubtitle">{s.subtitle}</div>
					</div>
					<ul class="pricingList">
						{s.items.map((it) => (
							<li class="pricingRow">
								<span class="pricingFeature">{it.feature}</span>
								<span class={`pricingPrice ${it.price.toLowerCase().includes('gratis') ? 'isFree' : ''}`}>{it.price}</span>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Constructor de Webs</h2>
			<div class="sectionMeta">50 créditos/mes · Sin permanencia</div>
		</div>
		<div class="wbPricing">
			<div class="wbBase">
				<div class="wbBaseBadge">Plan base</div>
				<div class="wbBasePrice">50 créditos<span>/mes</span></div>
				<div class="wbBaseNote">unos 50 € - cancela cuando quieras</div>
				<ul class="wbBaseList">
					<li>Constructor de páginas drag-and-drop</li>
					<li>Todas las propiedades del MLS cargadas automáticamente</li>
					<li>La marca de tu propia agencia</li>
					<li>Diseños adaptados a móvil</li>
					<li>Formularios de contacto y captura de leads</li>
					<li>Integración con Google Analytics</li>
					<li>Hosting y SSL gratis</li>
					<li>Construye y previsualiza antes de pagar</li>
				</ul>
				<a class="btnPrimary" href="/es/website-builder/">Ver cómo funciona</a>
			</div>
			<div class="wbAddons">
