---
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
import AgentInterestCta from '../../components/AgentInterestCta.astro';
import ExitIntent from '../../components/ExitIntent.astro';

// Espejo en español de /free/ (rediseño 09-10-26). Un solo gesto fuerte: el ticket de la cabecera, la factura mensual
// de una agencia típica con los mínimos habituales del mercado (portal desde 250, CRM desde 30, web desde 30, XML desde
// 20 = desde 330 al mes), tachado línea a línea y sellado a 0. Movimiento solo con transform y opacity, estado final
// estático con movimiento reducido.
const __ps = await getPortalStats();
const plListings = statPlus(__ps.listings, 'es');
const plAgents = statPlus(__ps.agents, 'es');
const plAgencies = statPlus(__ps.agencies, 'es');
const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=es';

const bill = [
	{ tool: 'Presencia en portal inmobiliario', eur: 250, note: 'a menudo 700+ con promociones', freeNote: '' },
	{ tool: 'CRM inmobiliario', eur: 30, note: 'lo habitual es de 29 a 150', freeNote: 'núcleo gratis; leads de compradores 1 crédito cada uno' },
	{ tool: 'Web de agencia + hosting', eur: 30, note: 'o de 500 a 2.000 por crearla', freeNote: 'MicroSite con tu marca' },
	{ tool: 'Envío a otros portales (XML)', eur: 20, note: 'suele ser un extra', freeNote: '' },
];
const billTotal = bill.reduce((s, b) => s + b.eur, 0);

const trade = [
	['Lo esencial es gratis.', 'El MLS, el CRM con tus pipelines de Leads, Vendedores y Propiedades, los anuncios en el portal y un MicroSite con tu marca. Sin tarjeta, sin contrato.'],
	['Tus anuncios se comparten.', `Con los ${plAgents} agentes de la red, que pueden venderlos por ti.`],
	['Ganamos cuando eliges un extra.', 'Un lead de comprador cualificado, destacar un anuncio, un informe, el feed de la red, el Creador de Webs o el Rentals Module. Todo opcional, con su precio más abajo.'],
];

const smallTiles = [
	['Un MicroSite con tu marca', 'Tu propia web en tuagencia.estate-agency.co, generada con tus anuncios y con hosting gratis. Las consultas te llegan directas.', 'microsite'],
	['Instant Listing', 'Añade tus imágenes, describe la propiedad en voz alta y el anuncio completo se redacta solo, listo para revisar.', ''],
	['AI Property Match', 'Pega el mensaje de un cliente y encuentra el match: primero tu cartera, después toda la red. Gratis en beta.', 'beta'],
	['Datos de mercado gratis', 'Informes mensuales de 20+ municipios de la Costa del Sol, basados en precios notariales de cada zona.', ''],
	['Alertas de propiedades', 'Guarda el encargo de un cliente y recibe un email en cuanto aparezca una vivienda que encaje en cualquier punto de la red.', ''],
	['XML de entrada y salida', 'Importa tu feed actual y envía tus propios anuncios a tu web o a otros portales. Ambas cosas, gratis.', ''],
	['La app de Android', 'Tu MLS y tu CRM en el bolsillo: capta un anuncio, registra un lead, revisa tu pipeline.', ''],
	['Comunidad de WhatsApp', 'Los grupos de WhatsApp de agentes, incluidos con tu cuenta.', ''],
];

const extras = [
	['/es/precios/', 'Leads de compradores', 'Solo se cobra cuando decides pasar un lead cualificado al pipeline de Buyer', '1 crédito cada uno, los 5 primeros gratis'],
	['/es/precios/', 'Automation & Nurture', 'Pipeline de Nurture, emails automáticos, detección de leads calientes y Daily Action Queue', 'Gratis'],
	['/es/precios/', 'Rentals Module', 'Pipeline de Inquilinos, Tenancies, Mantenimiento y recordatorios de renovación, con prueba gratis de 30 días', '50 créditos / 30 días'],
	['/es/informe-inteligencia-propiedad/', 'Property Intelligence Report', 'Una valoración basada en precios notariales de la zona, con brief para el agente', '5 créditos, los 3 primeros gratis'],
	['/es/precios/', 'Destacar un anuncio', 'Arriba del MLS o del portal', 'desde 10 créditos'],
	['/es/precios/', 'Feed de la red', 'Todos los anuncios de la red en tu propia web, por XML o con la Website API. Tus propios anuncios siguen gratis por feed XML', '35 créditos / mes'],
	['/es/constructor-de-webs/', 'Creador de Webs', 'Una web totalmente a medida. Tu propio dominio es un extra de 20 créditos. Crear y previsualizar gratis', 'desde 50 créditos / mes'],
	['/es/contenido-instantaneo/', 'Instant Content', 'Un artículo de blog y una guía de zona con IA cada semana, complemento del Creador de Webs', '30 créditos / mes'],
];

const faqs = [
	{ q: '¿Es de verdad gratis o es una prueba?', a: 'Gratis para siempre, no una prueba. El MLS, el núcleo del CRM, anunciar en el portal y tu MicroSite no cuestan nada y nunca lo harán, y el resto de herramientas de arriba también son gratis (AI Property Match mientras esté en beta). No hace falta tarjeta para empezar ni hay cuota mensual en lo esencial. Todo lo de pago es opcional y tiene su precio en esta página. Automation & Nurture es gratis.' },
	{ q: '¿Entonces cómo gana dinero PropertyList?', a: 'De dos formas. Con créditos, para la demanda y los extras puntuales: 1 crédito por cada lead cualificado que decidas meter en tu pipeline de Buyer, además de destacar un anuncio, los Property Intelligence Reports o mantener una venta fuera de la red compartida. Y con suscripciones mensuales, pagadas en créditos: el Rentals Module (50 créditos por período de 30 días, con prueba gratis de 30 días), el Creador de Webs y el feed de la red. Publicar en la red (hasta 25 fotos por anuncio) y tu pipeline de Vendedores no cuestan nada.' },
	{ q: '¿Cuál es la trampa?', a: 'En el precio no hay ninguna. El intercambio es que tus anuncios se comparten con otros agentes de la red: ese es el objetivo, así consigues que más gente pueda vender tu cartera. Si alguna vez necesitas mantener un anuncio privado, puedes (los 5 primeros gratis, después 5 créditos cada uno).' },
	{ q: '¿Tengo que dejar mi portal o CRM actual?', a: 'No. Importa tu feed XML actual, conserva lo demás que uses y usa PropertyList en paralelo, gratis.' },
	{ q: '¿Cuántos agentes hay de verdad?', a: `${plAgents} agentes en ${plAgencies} agencias, con ${plListings} anuncios en vivo en la cartera compartida. Agencias reales y registradas.` },
];

const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const breadcrumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
	{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://info.propertylist.es/es/' },
	{ '@type': 'ListItem', position: 2, name: 'Lo que consigues gratis', item: 'https://info.propertylist.es/es/gratis/' },
] };
---
<Layout
	lang="es"
	title="CRM inmobiliario y MLS gratis para tu agencia | PropertyList"
	description="MLS, CRM, anuncios en el portal, web con tu marca y herramientas de IA, gratis para inmobiliarias en España. Mira qué incluye y qué sustituye."
	canonical="https://info.propertylist.es/es/gratis/"
	ogImage="https://info.propertylist.es/og/og-free-v2-es.jpg"
	twitterCard="summary_large_image"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/free/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/gratis/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/free/' },
	]}
>
	<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<section class="hero"><div class="cx heroGrid">
		<div class="heroCopy">
			<p class="badge"><span class="dot"></span>Sin tarjeta. Sin contrato.</p>
			<h1>Capta más propiedades. Vende más casas. <b>Gratis.</b></h1>
			<p class="lead">La mayoría de los portales te cobran por anunciar. PropertyList funciona al revés: tus anuncios llegan a {plAgents} agentes que pueden venderlos, y tú puedes vender los {plListings} anuncios de la red.</p>
			<p class="ctaRow"><a class="btn" href={SIGNUP} target="_blank" rel="noopener">Crea tu cuenta gratis</a> <a class="ghost" href="#gratis">Ver todo lo que incluye</a></p>
			<p class="micro">{plAgents} agentes &middot; {plAgencies} agencias &middot; {plListings} anuncios en vivo</p>
		</div>
		<figure class="rWrap" id="stack">
			<div class="receipt" role="group" aria-labelledby="rTitle">
				<p class="rHead" id="rTitle">La factura mensual de una agencia típica</p>
				<p class="rSub">Precios de partida con tarifas habituales del mercado español, 2026</p>
				<ul class="rLines">
					{bill.map((b, i) => (
						<li style={`--i:${i}`}>
							<span class="rTool">{b.tool}<em>{b.note}</em></span>
							<span class="rCost"><s>desde {b.eur} &euro;</s><b class="rFree">Gratis{b.freeNote ? <em>{b.freeNote}</em> : null}</b></span>
						</li>
					))}
				</ul>
				<div class="rTotal"><span>Total al mes</span><s>desde {billTotal} &euro;</s></div>
				<div class="stamp"><span>Lo esencial en PropertyList</span><b>0 &euro;</b></div>
			</div>
			<figcaption>Mínimos de las tarifas habituales del mercado español, 2026; los rangos varían según el tamaño de la agencia, la región y las promociones. La web gratis es tu MicroSite con tu marca; una web totalmente a medida es el <a href="/es/constructor-de-webs/">Creador de Webs</a>, desde 50 créditos al mes, con tu propio dominio como extra de 20 créditos.</figcaption>
		</figure>
		<script is:inline>(function(){var r=document.querySelector('.receipt');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;r.classList.add('pre');var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){r.classList.add('anim');io.disconnect();}},{threshold:0.4});io.observe(r);})();</script>
	</div></section>

	<section class="band"><div class="cx">
		<h2>¿Suena demasiado bien? <b>Este es el intercambio.</b></h2>
		<div class="steps">
			{trade.map(([h, p]) => (<div class="step"><h3>{h}</h3><p>{p}</p></div>))}
		</div>
	</div></section>

	<section class="band soft" id="gratis"><div class="cx">
		<h2>Lo que consigues, <b>gratis.</b></h2>
		<p class="sub">Todo lo que necesita una agencia, del primer anuncio al trato cerrado.</p>
		<div class="bento">
			<div class="tile xl">
				<p class="tName">El MLS compartido</p>
				<p class="big">{plAgents}</p>
				<p class="bigLabel">agentes pueden vender tu anuncio</p>
				<p class="tText">Publica una vez y vende los {plListings} anuncios de la red, no solo los tuyos. Los leads y referidos entre agentes son gratis, para siempre.</p>
			</div>
			<div class="tile wide">
				<p class="tName">Un CRM gratis</p>
				<p class="tText">Contactos ilimitados, calendario y documentos. Los pipelines de Leads, Vendedores y Propiedades son gratis, y Nurture también. Un lead de comprador cuesta 1 crédito al pasarlo al pipeline de Buyer, los 5 primeros gratis. Inquilinos va con el Rentals Module.</p>
				<p class="chips"><span>Leads</span><span>Vendedores</span><span>Propiedades</span><span>Nurture</span></p>
			</div>
			<div class="tile wide">
				<p class="tName">Tus anuncios en el portal</p>
				<p class="mid">{plListings}</p>
				<p class="tText">viviendas en propertylist.es ante los compradores, con las tuyas entre ellas. Sin cuotas de publicación, nunca.</p>
			</div>
			{smallTiles.map(([t, d, kind]) => (
				<div class="tile">
					<p class="tName">{t}{kind === 'beta' ? <span class="beta">Beta</span> : null}</p>
					{kind === 'microsite' ? <p class="url"><i></i>tuagencia.estate-agency.co</p> : null}
					<p class="tText">{d}</p>
				</div>
			))}
		</div>
	</div></section>

	<section class="band dark"><div class="cx">
		<div class="proof">
			<div><b>{plAgents}</b><span>agentes en la red</span></div>
			<div><b>{plAgencies}</b><span>agencias locales reales</span></div>
			<div><b>{plListings}</b><span>anuncios en vivo compartidos</span></div>
			<div><b>0 &euro;</b><span>para unirte, sin tarjeta</span></div>
		</div>
		<p class="alt">Cada vivienda que captas la pueden vender {plAgents} agentes, así que hay más agentes buscando comprador para ella.</p>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Cuando quieras crecer, <b>precios a la vista.</b></h2>
		<p class="sub">Lo esencial sigue gratis. Créditos cuando te pasamos demanda o quieres algo puntual; una suscripción mensual para lo que trabaja de fondo. <a href="/es/verifica-tu-agencia/">Verifica tu agencia</a> (gratis, cuando quieras) y consigue 20 créditos gratis, y la mayoría de las funciones de pago tienen una prueba gratis.</p>
		<div class="extras">
			{extras.map(([href, t, d, price]) => (
				<a href={href}><b>{t}</b><span>{d}</span><em>{price}</em></a>
			))}
		</div>
		<p class="links"><a href="/es/precios/">Precios completos</a> <a href="/es/funciones/">Todas las herramientas</a> <a href="/es/costa-del-sol/">Recorre la costa</a></p>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>Preguntas frecuentes.</h2>
		<div class="faqwrap">
			{faqs.map((f) => (<details class="faqItem"><summary>{f.q}</summary><p>{f.a}</p></details>))}
		</div>
	</div></section>

	<section class="band close"><div class="cx">
		<h2>Empieza gratis. <b>Sigue gratis.</b></h2>
		<p class="alt">Crea tu cuenta, importa tus anuncios y estarás en la red en minutos. Sin tarjeta, sin contrato.</p>
		<p class="ctaRow"><a class="btn" href={SIGNUP} target="_blank" rel="noopener">Crea tu cuenta gratis</a> <a class="ghost" href="/es/lanza-tu-agencia/">Míralo montarse en 9 minutos</a></p>
	</div></section>

	<AgentInterestCta lang="es" page="/es/gratis/" />
	<ExitIntent lang="es" />
</Layout>

<style>
	.cx { width: min(1120px, 100% - 32px); margin: 0 auto; }

	/* Hero: brand ink, one teal glow, the receipt as the single bold move */
	.hero { position: relative; overflow: hidden; background: #0b1b22; color: #fff; padding: 36px 0 56px; }
	.hero::before { content: ''; position: absolute; width: 720px; height: 720px; right: -220px; top: -260px; border-radius: 50%; background: radial-gradient(circle, rgba(0, 174, 154, 0.28), rgba(0, 174, 154, 0) 70%); pointer-events: none; }
	.heroGrid { position: relative; display: grid; gap: 36px; align-items: center; }
	.badge { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; padding: 6px 12px; border-radius: 999px; background: rgba(125, 238, 222, 0.12); border: 1px solid rgba(125, 238, 222, 0.35); color: #c9f5ee; font-size: 14px; font-weight: 700; }
	.dot { width: 8px; height: 8px; border-radius: 50%; background: #00ae9a; box-shadow: 0 0 0 4px rgba(0, 174, 154, 0.2); }
	h1 { font-size: 44px; line-height: 1.04; letter-spacing: -0.035em; font-weight: 800; margin: 0; max-width: 15ch; }
	h1 b { color: #7deede; }
	.lead { font-size: 19px; line-height: 1.5; color: #c9d6da; margin: 18px 0 24px; max-width: 44ch; }
	.ctaRow { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
	.btn { display: inline-block; background: #00ae9a; color: #0b1b22; font-weight: 800; font-size: 18px; padding: 16px 26px; border-radius: 14px; text-decoration: none; box-shadow: 0 10px 30px rgba(0, 174, 154, 0.35); }
	.btn:hover { background: #7deede; }
	.ghost { color: #c9d6da; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
	.ghost:hover { color: #fff; }
	.micro { margin: 16px 0 0; font-size: 14px; color: #8fa0a6; }

	.rWrap { margin: 0; position: relative; }
	.rWrap figcaption { margin: 76px auto 0; max-width: 420px; font-size: 12px; line-height: 1.5; color: #8fa0a6; text-align: center; }
	.rWrap figcaption a { color: #c9d6da; }
	.receipt { position: relative; max-width: 440px; margin: 0 auto; background: #fbfaf6; color: #0b1b22; padding: 26px 24px 30px; border-radius: 4px 4px 0 0; transform: rotate(1.6deg); box-shadow: 0 40px 80px rgba(0, 0, 0, 0.45); }
	.receipt::after { content: ''; position: absolute; left: 0; right: 0; bottom: -12px; height: 12px; background: linear-gradient(-45deg, transparent 8px, #fbfaf6 0) 0 0 / 16px 12px repeat-x, linear-gradient(45deg, transparent 8px, #fbfaf6 0) 0 0 / 16px 12px repeat-x; }
	.rHead { margin: 0; font-size: 18px; font-weight: 800; letter-spacing: -0.01em; text-align: center; }
	.rSub { margin: 4px 0 14px; font-size: 12px; color: #5b6b73; text-align: center; padding-bottom: 14px; border-bottom: 2px dashed #d5dcdf; }
	.rLines { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
	.rLines li { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
	.rTool { font-size: 15px; font-weight: 700; line-height: 1.3; }
	.rTool em { display: block; font-style: normal; font-weight: 500; font-size: 12px; color: #5b6b73; margin-top: 2px; }
	.rCost { display: grid; justify-items: end; text-align: right; flex-shrink: 0; max-width: 46%; font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; }
	.rCost s, .rTotal s { position: relative; text-decoration: none; color: #3d4a4f; font-size: 15px; white-space: nowrap; }
	.rCost s::after, .rTotal s::after { content: ''; position: absolute; left: -3px; right: -3px; top: 52%; height: 2px; background: #b4232a; transform: scaleX(1); transform-origin: left center; }
	.rFree { font-family: inherit; font-size: 15px; color: #0a6d61; }
	.rFree em { display: block; white-space: normal; line-height: 1.3; margin-top: 2px; font-style: normal; font-weight: 500; font-size: 11px; color: #3d4a4f; font-family: system-ui, sans-serif; }
	.rTotal { --i: 4.2; display: flex; justify-content: space-between; align-items: baseline; margin-top: 16px; padding-top: 14px; border-top: 2px dashed #d5dcdf; font-weight: 800; }
	.rTotal s { font-size: 20px; font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; color: #0b1b22; }
	.stamp { position: absolute; right: -6px; bottom: -58px; z-index: 2; display: grid; justify-items: center; padding: 8px 16px 6px; border: 4px solid #00ae9a; border-radius: 12px; color: #0a6d61; background: rgba(230, 247, 244, 0.95); transform: rotate(-8deg); }
	.stamp span { font-size: 11px; font-weight: 800; }
	.stamp b { font-size: 46px; line-height: 1; font-weight: 800; letter-spacing: -0.03em; }
	/* Default is the finished receipt (no JS, reduced motion). The inline script adds .pre (start state) and then .anim
	   when the receipt is 40% in view, so the strike-through plays where the visitor can see it, including on a phone. */
	.receipt.pre .rCost s::after, .receipt.pre .rTotal s::after { transform: scaleX(0); }
	.receipt.pre .rFree { opacity: 0; transform: translateY(6px); }
	.receipt.pre .stamp { opacity: 0; transform: rotate(-10deg) scale(1.9); }
	.receipt.anim .rCost s::after, .receipt.anim .rTotal s::after { animation: strike 0.45s ease-out forwards; animation-delay: calc(0.3s + var(--i, 0) * 0.38s); }
	.receipt.anim .rFree { animation: rise 0.4s ease-out forwards; animation-delay: calc(0.55s + var(--i, 0) * 0.38s); }
	.receipt.anim .stamp { animation: stamp 0.5s cubic-bezier(0.2, 1.5, 0.4, 1) 2.5s forwards; }
	@keyframes strike { to { transform: scaleX(1); } }
	@keyframes rise { to { opacity: 1; transform: none; } }
	@keyframes stamp { to { opacity: 1; transform: rotate(-8deg) scale(1); } }
	@media (prefers-reduced-motion: reduce) {
		.receipt.pre .rCost s::after, .receipt.pre .rTotal s::after { transform: scaleX(1); animation: none; }
		.receipt.pre .rFree { opacity: 1; transform: none; animation: none; }
		.receipt.pre .stamp { opacity: 1; transform: rotate(-8deg); animation: none; }
	}
	/* Bands */
	.band { padding: 48px 0; border-top: 1px solid #e7eef1; background: #fff; }
	.soft { background: #f4f7f8; }
	h2 { font-size: 32px; line-height: 1.1; letter-spacing: -0.025em; font-weight: 800; margin: 0; max-width: 22ch; }
	h2 b { color: #008a7a; }
	.sub { font-size: 17px; line-height: 1.5; color: #28383f; margin: 10px 0 0; max-width: 60ch; }
	.sub a { color: #0a6d61; font-weight: 700; }
	.steps { display: grid; gap: 22px; margin-top: 26px; }
	.step { padding-top: 14px; border-top: 3px solid #00ae9a; }
	.step h3 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 0; }
	.step p { margin: 6px 0 0; color: #28383f; max-width: 38ch; }

	/* Bento of free tools */
	.bento { display: grid; gap: 12px; margin-top: 26px; }
	.tile { background: #fff; border: 1px solid #dfe6e8; border-radius: 18px; padding: 18px; display: flex; flex-direction: column; gap: 6px; }
	.tName { margin: 0; font-size: 17px; font-weight: 800; display: flex; align-items: center; gap: 8px; }
	.tText { margin: 0; font-size: 15px; line-height: 1.5; color: #3d4a4f; }
	.beta { font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 999px; background: #e6f7f4; color: #0a6d61; }
	.url { margin: 2px 0 4px; display: flex; align-items: center; gap: 8px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px; color: #28383f; background: #f4f7f8; border: 1px solid #dfe6e8; border-radius: 8px; padding: 6px 10px; overflow-wrap: anywhere; }
	.url i { width: 8px; height: 8px; border-radius: 50%; background: #00ae9a; flex-shrink: 0; }
	.tile.xl { background: #0a6d61; border-color: #0a6d61; color: #fff; justify-content: flex-end; min-height: 280px; background-image: radial-gradient(circle at 85% 10%, rgba(125, 238, 222, 0.35), rgba(125, 238, 222, 0) 55%); }
	.tile.xl .tName { color: #c9f5ee; }
	.tile.xl .tText { color: #e6f7f4; }
	.big { margin: 4px 0 0; font-size: 72px; line-height: 0.95; font-weight: 800; letter-spacing: -0.04em; }
