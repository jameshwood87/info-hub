---
import Layout from '../../layouts/Layout.astro';

// LAUNCH-DAY FLIP: poner LIVE = true cuando Video Studio se lance (igual que
// en /instant-video/ - los dos flags deben cambiarse juntos). Luego redeploy.
const LIVE = false;

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/video-instantaneo/`;
const title = 'Vídeo Instantáneo - vídeos inmobiliarios con IA para tu agencia | PropertyList';
const description =
	'Vídeos de propiedades con tu marca en minutos, creados desde tus propios anuncios: fotos reales animadas, tu logo y contacto, todos los tamaños sociales - con un avatar IA tuyo como presentador opcional.';

const steps = [
	{ n: 1, t: 'Elige un anuncio', d: 'Cualquiera de tus anuncios directos - o simplemente pulsa "Crear vídeo" en el propio anuncio. El vídeo se crea con sus fotos y datos reales.' },
	{ n: 2, t: 'Elige estilo y tamaños', d: 'Promo, Nuevo anuncio, Precio rebajado, Open House y más. Un tamaño o los tres - y añade tu avatar como presentador.' },
	{ n: 3, t: 'Descarga y publica', d: 'Un vídeo terminado y con tu marca por tamaño, con subtítulos y cierre con tu contacto. Publícalo en Facebook, Instagram, YouTube o WhatsApp.' },
];

const makers = [
	{ name: 'Vídeos de anuncios', desc: 'Las fotos de tu anuncio cobran vida, con precio, dormitorios y zona sacados directamente del anuncio - nunca escritos a mano, nunca mal. Estilos para cada momento: una Promo directa del inmueble, Nuevo anuncio, Precio rebajado, Open House, Vendido, Exclusiva.' },
	{ name: 'Vídeos de guías de zona', desc: 'Un recorrido de 30-60 segundos por una zona en la que trabajas - estilo de vida, cifras reales de mercado y tu marca. Añade tu avatar y eres el experto local presentándola.' },
	{ name: 'Vídeo de presentación de agencia', desc: 'Tu vídeo de "conoce la agencia": quiénes sois, las zonas que cubrís, cómo contactaros. El activo permanente para tu web, tus redes y WhatsApp.' },
	{ name: 'Vídeos de actualidad del mercado', desc: 'Un vídeo mensual de "tu zona ahora mismo" con precios medianos reales y cifras verificadas ante notario - datos de mercado que ninguna IA genérica puede producir con honestidad.' },
];

const gets = [
	{ name: 'Hecho con tus fotos reales', desc: 'Las fotos reales de tu anuncio, animadas - nunca una casa o habitación inventada por IA.' },
	{ name: 'Datos de tu anuncio', desc: 'Precio, dormitorios, superficie y zona salen del anuncio y de datos de mercado verificados - nunca cifras inventadas.' },
	{ name: 'Con marca - o sin marca', desc: 'Tu logo, tus colores y un cierre con tu contacto y un código QR al anuncio. O genera una versión sin marca para que tus colaboradores del MLS la compartan con sus compradores.' },
	{ name: 'Todos los tamaños que importan', desc: 'Vertical para Reels, Stories, TikTok y Estados de WhatsApp. Cuadrado para el feed. Panorámico para YouTube y tu web.' },
	{ name: 'Tú como presentador', desc: 'Sube tu imagen una vez y tu avatar IA puede presentar cualquier vídeo - sobre todo guías de zona y presentaciones.' },
	{ name: 'Subtítulos incluidos', desc: 'La mayoría del vídeo social se ve sin sonido - cada vídeo lleva subtítulos limpios integrados.' },
];

const styles = ['Promo', 'Nuevo anuncio', 'Precio rebajado', 'Open House', 'Vendido', 'De vuelta al mercado', 'Exclusiva', 'Lujo'];

const prices = [
	{ name: 'Un tamaño', price: '10 créditos', desc: 'Un vídeo en el formato que elijas, en Full HD.' },
	{ name: 'Los 3 tamaños', price: '20 créditos', desc: 'El mismo vídeo en vertical, cuadrado y panorámico - todas las plataformas cubiertas.', tag: 'Mejor valor' },
	{ name: 'Avatar presentador', price: '+10 créditos', desc: 'Tu avatar IA presenta el vídeo. Sube tu imagen una vez y reutilízala en todos tus vídeos.' },
	{ name: 'Idioma extra', price: '+5 créditos', desc: 'El mismo vídeo con voz y subtítulos en otro idioma para tus compradores internacionales. Español e inglés en el lanzamiento - alemán, francés, neerlandés y sueco después.' },
];

const faqs = [
	{ q: '¿Tengo que grabar algo?', a: 'No. Los vídeos de anuncios se crean con las fotos que ya tiene tu anuncio. Lo único opcional es tu avatar: graba un breve vídeo selfie una sola vez y tu presentador IA podrá aparecer en cualquier vídeo a partir de entonces.' },
	{ q: '¿Qué plataformas cubren los tamaños?', a: 'Tres formatos lo cubren todo: vertical (9:16) para Reels y Stories de Instagram, TikTok, YouTube Shorts, Stories de Facebook y Estados de WhatsApp; cuadrado (1:1) para los feeds de Facebook e Instagram; panorámico (16:9) para YouTube, tu web y el email. Todo se genera en Full HD (1080p).' },
	{ q: '¿Los datos serán correctos?', a: 'Sí - esa es la gracia. Cada precio, número de dormitorios y cifra de mercado viene de tu anuncio real o de los datos de mercado de PropertyList verificados ante notario. Nada se escribe a mano y nada se inventa.' },
	{ q: '¿Cómo funciona el avatar?', a: 'Subes un breve vídeo tuyo una sola vez, con tu consentimiento, y es solo tuyo - nadie más puede usarlo. Tu avatar IA puede entonces presentar guías de zona, presentaciones de agencia o el vídeo que quieras. Los vídeos con avatar llevan una pequeña nota de presentador IA, que los compradores respetan mucho más de lo que les molesta.' },
	{ q: '¿Puedo hacer una versión sin marca?', a: 'Sí. Cada vídeo puede generarse con o sin marca, sin coste extra. La versión con marca es para tus propios canales; la versión sin marca está pensada para compartir por el MLS, para que los agentes colaboradores presenten tu propiedad a sus compradores sin tus datos de contacto.' },
	{ q: '¿Cuánto cuesta?', a: LIVE
		? 'Los vídeos son de pago por uso con tus créditos de PropertyList: 10 créditos un tamaño, 20 créditos los tres tamaños del mismo vídeo. El avatar presentador son +10 créditos y cada idioma extra +5 créditos. 1 crédito = 1 euro, sin suscripción.'
		: 'El precio previsto es de pago por uso con tus créditos de PropertyList: 10 créditos un tamaño, 20 créditos los tres tamaños del mismo vídeo, +10 créditos el avatar presentador y +5 créditos por idioma extra. 1 crédito = 1 euro, sin suscripción. El precio final se confirma en el lanzamiento.' },
	{ q: '¿Cuándo puedo usarlo?', a: LIVE
		? 'Ya está disponible - abre la sección Marketing de tu cuenta PropertyList y crea tu primer vídeo. Las agencias nuevas empiezan gratis en propertylist.es.'
		: 'Muy pronto. Vídeo Instantáneo está en la fase final de desarrollo. Apúntate a la lista de espera y te enviaremos un solo email el día que se lance - y si aún no estás en PropertyList, tu cuenta gratuita se crea en minutos, así estarás listo desde el primer día.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: `${origin}/es/` },
		{ '@type': 'ListItem', position: 2, name: 'Funciones', item: `${origin}/es/funciones/` },
		{ '@type': 'ListItem', position: 3, name: 'Vídeo Instantáneo', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList Vídeo Instantáneo',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: canonical,
	description: 'Vídeos inmobiliarios con IA y con la marca de la agencia: vídeos de anuncios, guías de zona, presentaciones de agencia y actualidad del mercado, creados desde los anuncios de la propia agencia y datos de mercado verificados.',
	offers: { '@type': 'Offer', price: '10', priceCurrency: 'EUR' },
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};
const SIGNUP = 'https://agents.propertylist.es/new-agent-signup/new';
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	hideSearch
	hreflangs={[
		{ hreflang: 'en', href: `${origin}/instant-video/` },
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'x-default', href: `${origin}/instant-video/` },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="heroInner heroGrid">
			<div>
				<div class="kicker">{LIVE ? 'Vídeo Instantáneo - Ya disponible' : 'Vídeo Instantáneo - Muy pronto'}</div>
				<h1>Un vídeo para cada anuncio. Sin videógrafo.</h1>
				<p class="lead">
					PropertyList convierte cualquiera de tus anuncios en un vídeo con tu marca y listo para redes en minutos - tus
					fotos reales animadas, los datos sacados del anuncio, tu logo y contacto en cada fotograma. Añade tu avatar IA
					como presentador y consigue todos los tamaños que piden Facebook, Instagram, YouTube y WhatsApp.
				</p>
				<div class="ctaRow">
					{LIVE
						? <a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Crea tu primer vídeo</a>
						: <a class="btnPrimary" href="#waitlist">Apúntate a la lista</a>}
					<a class="btnSecondary" href="#how">Cómo funciona</a>
				</div>
				<div class="note">
					{LIVE
						? 'Ya disponible en la sección Marketing de tu cuenta PropertyList. Pago por uso con créditos - sin suscripción.'
						: 'Se lanza muy pronto en tu cuenta PropertyList. Pago por uso con créditos - sin suscripción.'}
				</div>
			</div>

			<div class="preview" aria-hidden="true">
				<div class="pvBar"><span class="pvDot"></span><span class="pvDot"></span><span class="pvDot"></span><span class="pvUrl">Video Studio &rsaquo; Nuevo anuncio</span></div>
				<div class="pvBody">
					<div class="pvPlayer">
						<div class="pvPlay">&#9654;</div>
						<span class="pvStyle">NUEVO ANUNCIO</span>
						<div class="pvOverlay">
							<b>1.950.000 &euro;</b>
							<span>Villa de 3 dormitorios &middot; Nueva Andaluc&iacute;a</span>
						</div>
						<div class="pvAvatar"><span class="pvAvDot"></span> Presentado por tu avatar</div>
					</div>
					<div class="pvChips">
						<span class="pvChip">Reels &middot; 9:16</span>
						<span class="pvChip">Feed &middot; 1:1</span>
						<span class="pvChip">YouTube &middot; 16:9</span>
					</div>
					<div class="pvFoot">Full HD &middot; subtítulos incluidos &middot; tu logo + cierre con contacto</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>El vídeo consigue el alcance. Casi ninguna agencia los hace.</h2>
			<p>Los anuncios con vídeo consiguen mucha más atención en todas las plataformas - pero un videógrafo cuesta cientos de euros por propiedad, editar lleva horas que no tienes, y las herramientas de IA genéricas no conocen tus anuncios. Así que ese alcance se queda sin reclamar.</p>
		</div>
		<div class="grid3">
			<div class="card"><h3>Los videógrafos son caros</h3><p>Cientos de euros por anuncio significa que el vídeo se reserva para unas pocas propiedades afortunadas.</p></div>
			<div class="card"><h3>Editar se come tu semana</h3><p>Cortar clips, poner subtítulos y adaptar el tamaño a cada plataforma es un trabajo en sí mismo.</p></div>
			<div class="card"><h3>La IA genérica no conoce tu cartera</h3><p>Las herramientas de plantilla inventan datos y usan imágenes falsas. Tus anuncios merecen sus fotos y sus precios reales.</p></div>
		</div>
	</section>

	<section class="section" id="how">
		<div class="sectionHead">
			<h2>Del anuncio al vídeo terminado en tres pasos</h2>
			<p>Sin grabar, sin editar, sin subir nada. Son tus datos y tus fotos - el vídeo ya está medio hecho.</p>
		</div>
		<div class="grid3 steps">
			{steps.map((s) => (
				<div class="card step"><div class="stepNum">{s.n}</div><h3>{s.t}</h3><p>{s.d}</p></div>
			))}
		</div>
		<div class="styleStrip">
			<span class="styleLabel">Estilos:</span>
			{styles.map((s) => <span class="styleChip">{s}</span>)}
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Cuatro creadores de vídeo, una sección de Marketing</h2>
			<p>Todo se genera desde tus propios anuncios, tus zonas y datos de mercado verificados - cada vídeo es preciso, lleva tu marca y es inconfundiblemente tuyo. Créalos desde la sección Marketing o simplemente pulsando "Crear vídeo" en cualquiera de tus anuncios.</p>
		</div>
		<div class="grid2">
			{makers.map((m) => (
				<div class="card accent"><h2>{m.name}</h2><p>{m.desc}</p></div>
			))}
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Qué incluye cada vídeo</h2>
		</div>
		<div class="grid3">
			{gets.map((g) => (
				<div class="card"><h3>{g.name}</h3><p>{g.desc}</p></div>
			))}
		</div>
	</section>

	<section class="section" id="pricing">
		<div class="sectionHead">
			<h2>Precio sencillo, de pago por uso</h2>
			<p>Siempre en Full HD - sin niveles de calidad, sin suscripción. 1 crédito = 1 euro, del mismo saldo de créditos que tu agencia ya usa.{LIVE ? '' : ' Precio previsto, se confirma en el lanzamiento.'}</p>
		</div>
		<div class="grid4">
			{prices.map((p) => (
				<div class={p.tag ? 'card priceCard best' : 'card priceCard'}>
					{p.tag && <span class="bestTag">{p.tag}</span>}
					<h3>{p.name}</h3>
					<div class="priceBig">{p.price}</div>
					<p>{p.desc}</p>
				</div>
			))}
		</div>
	</section>

	{LIVE ? (
		<section class="cta" id="waitlist">
			<div class="ctaInner">
				<h2>Ya disponible en tu sección Marketing.</h2>
				<p>Abre PropertyList, entra en Marketing y convierte un anuncio en vídeo antes de que se enfríe el café. ¿Aún no estás en PropertyList? El MLS y el CRM son gratis para siempre.</p>
				<div class="ctaRow">
					<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Empieza gratis</a>
					<a class="btnSecondary" href="/es/funciones/">Todo lo que incluye</a>
				</div>
			</div>
		</section>
	) : (
		<section class="cta waitlistBand" id="waitlist">
			<div class="ctaInner">
				<h2>Se lanza muy pronto. Sé el primero.</h2>
				<p>Déjanos tu email y te enviaremos un solo mensaje el día que Vídeo Instantáneo esté disponible - nada más. Y si aún no estás en PropertyList, crea ahora tu cuenta gratuita para estar listo desde el primer día.</p>
				<form class="waitlistForm" data-source="instant-video">
					<input type="email" name="email" required placeholder="tu@agencia.com" aria-label="Tu email" autocomplete="email" />
					<input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
					<button type="submit">Avísame en el lanzamiento</button>
					<p class="wlStatus" role="status" aria-live="polite"></p>
				</form>
				<div class="ctaRow" style="margin-top: 12px;">
					<a class="btnSecondary" href={SIGNUP} target="_blank" rel="noopener">Crea tu cuenta gratuita</a>
				</div>
			</div>
		</section>
	)}

	<section class="section">
		<div class="sectionHead"><h2>Preguntas frecuentes</h2></div>
		<div class="faq">
			{faqs.map((f) => (
				<details>
					<summary>{f.q}</summary>
					<p>{f.a}</p>
				</details>
			))}
		</div>
	</section>

	<script is:inline>
		document.querySelectorAll('.waitlistForm').forEach((form) => {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const status = form.querySelector('.wlStatus');
				const emailEl = form.querySelector('input[name="email"]');
				const hpEl = form.querySelector('input[name="website"]');
				const email = emailEl ? emailEl.value : '';
				const website = hpEl ? hpEl.value : '';
				const es = (document.documentElement.lang || '').indexOf('es') === 0;
				status.className = 'wlStatus';
				status.textContent = es ? 'Enviando...' : 'Sending...';
				try {
					const r = await fetch('/api/app-waitlist', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ email: email, website: website, lang: es ? 'es' : 'en', source: form.getAttribute('data-source') || 'instant-video' }),
					});
					const j = await r.json().catch(() => ({}));
					if (r.ok && j && j.ok) {
						form.classList.add('done');
						status.className = 'wlStatus ok';
						status.textContent = es ? 'Estas en la lista. Te avisaremos el dia del lanzamiento.' : "You're on the list. We'll email you the day it launches.";
					} else {
						status.className = 'wlStatus err';
						status.textContent = es ? 'Revisa tu correo e intentalo de nuevo.' : 'Please check your email and try again.';
					}
				} catch (err) {
					status.className = 'wlStatus err';
					status.textContent = es ? 'Algo salio mal. Intentalo de nuevo.' : 'Something went wrong. Please try again.';
				}
			});
		});
	</script>

	<style>
		:global(:root) {
			--pl-accent: #00ae9a;
			--pl-accent-rgb: 0, 174, 154;
			--pl-ink: #0a6d61;
		}
		h1, h2, h3 { letter-spacing: -0.03em; }
		.hero { border-radius: 22px; padding: 16px; margin: 0 0 14px; border: 1px solid rgba(16, 24, 40, 0.08);
			background: radial-gradient(1200px 600px at 20% -10%, rgba(var(--pl-accent-rgb), 0.22), rgba(255, 255, 255, 0)), radial-gradient(900px 500px at 90% 10%, rgba(var(--pl-accent-rgb), 0.12), rgba(255, 255, 255, 0)); }
		.heroInner { background: rgba(255, 255, 255, 0.8); border: 1px solid rgba(16, 24, 40, 0.06); border-radius: 18px; padding: 22px; }
		.heroGrid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 24px; align-items: center; }
		.kicker { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(var(--pl-accent-rgb), 0.12); border: 1px solid rgba(var(--pl-accent-rgb), 0.22); color: var(--pl-ink); font-weight: 900; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
		h1 { margin: 14px 0 12px; line-height: 1.06; font-size: clamp(28px, 4.4vw, 42px); }
		.lead { margin: 0 0 16px; color: rgba(16, 24, 40, 0.75); max-width: 60ch; line-height: 1.62; }
		.note { color: rgba(16, 24, 40, 0.6); font-weight: 700; font-size: 12.5px; margin-top: 12px; }
		.ctaRow { display: flex; gap: 12px; flex-wrap: wrap; }
		.btnPrimary, .btnSecondary { display: inline-flex; align-items: center; justify-content: center; padding: 14px 22px; border-radius: 14px; text-decoration: none; font-weight: 900; font-size: 15px; cursor: pointer; }
		.btnPrimary { background: var(--pl-ink); color: #fff; border: 1px solid var(--pl-ink); }
		.btnPrimary:hover { background: #086055; }
		.btnSecondary { background: rgba(16, 24, 40, 0.05); border: 1px solid rgba(16, 24, 40, 0.12); color: var(--pl-ink); }
		.btnSecondary:hover { background: rgba(16, 24, 40, 0.08); }

		.preview { background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid rgba(16, 24, 40, 0.1); box-shadow: 0 14px 36px rgba(16, 24, 40, 0.12); }
		.pvBar { display: flex; align-items: center; gap: 7px; padding: 10px 14px; background: rgba(16, 24, 40, 0.03); border-bottom: 1px solid rgba(16, 24, 40, 0.08); }
		.pvDot { width: 9px; height: 9px; border-radius: 50%; background: rgba(16, 24, 40, 0.16); }
		.pvUrl { flex: 1; margin-left: 6px; background: #fff; border: 1px solid rgba(16, 24, 40, 0.1); border-radius: 999px; padding: 5px 12px; font-size: 12px; color: rgba(16, 24, 40, 0.55); }
		.pvBody { padding: 16px 18px; }
		.pvPlayer { position: relative; border-radius: 12px; overflow: hidden; height: 210px; background: linear-gradient(160deg, #0e2f2a 0%, #114b42 45%, rgba(var(--pl-accent-rgb), 0.65) 130%); display: flex; align-items: center; justify-content: center; }
		.pvPlay { width: 54px; height: 54px; border-radius: 50%; background: rgba(255, 255, 255, 0.92); color: #0a6d61; display: flex; align-items: center; justify-content: center; font-size: 20px; padding-left: 4px; box-shadow: 0 8px 22px rgba(16, 24, 40, 0.3); }
		.pvStyle { position: absolute; top: 12px; left: 12px; font-size: 11px; font-weight: 900; letter-spacing: 0.08em; color: #fff; background: rgba(10, 109, 97, 0.9); padding: 5px 10px; border-radius: 999px; }
		.pvOverlay { position: absolute; left: 12px; bottom: 12px; background: rgba(255, 255, 255, 0.94); border-radius: 10px; padding: 8px 12px; }
		.pvOverlay b { display: block; font-size: 16px; font-weight: 900; color: #101828; letter-spacing: -0.02em; }
		.pvOverlay span { font-size: 12px; color: rgba(16, 24, 40, 0.65); }
		.pvAvatar { position: absolute; right: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 800; color: #fff; background: rgba(16, 24, 40, 0.55); padding: 5px 10px; border-radius: 999px; }
		.pvAvDot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; }
		.pvChips { display: flex; flex-wrap: wrap; gap: 7px; margin: 12px 0 0; }
		.pvChip { font-size: 12px; font-weight: 800; color: var(--pl-ink); background: rgba(var(--pl-accent-rgb), 0.12); border: 1px solid rgba(var(--pl-accent-rgb), 0.2); padding: 5px 10px; border-radius: 8px; }
		.pvFoot { font-size: 12px; color: rgba(16, 24, 40, 0.5); margin-top: 12px; }

		.section { margin: 0 0 14px; }
		.sectionHead { background: rgba(255, 255, 255, 0.7); border: 1px solid rgba(16, 24, 40, 0.08); border-radius: 18px; padding: 16px; margin-bottom: 12px; }
		.sectionHead p { margin: 8px 0 0; color: rgba(16, 24, 40, 0.72); line-height: 1.6; max-width: 90ch; }
		.grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
