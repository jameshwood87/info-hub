---
import Layout from '../../layouts/Layout.astro';

// Live network map. map-data.json (8 deep-coverage municipalities) is rebuilt nightly by
// scripts/build-map-data.py. cities.json holds every listing's town, geocoded once.
// Boundaries are OSM admin_level=8 relations, stitched and simplified.
const origin = 'https://info.propertylist.es';
const canonical = origin + '/es/mapa/';
const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=es';
const MAPTEXT = {
	thin: 'Publícalas gratis, para siempre. Tus propiedades llegan a todos los agentes de la red.',
	cta: 'Publicar gratis',
	thinTitle: 'Hay sitio para otra agencia',
	verified: 'Verificado ante notario',
	paid: 'lo que pagaron de verdad los compradores',
	sales: 'ventas',
	whyPt: 'Aquí no hay precio verificado: el registro notarial que usamos cubre España, no Portugal.',
	whyThin: 'Hay muy pocas ventas registradas aquí para publicar un precio verificado.',
	whyNone: 'Todavía no hay cifra notarial para este sitio: el registro publica por municipio y esta es una zona dentro de uno.',
	loc: 'es-ES',
	layerSale: 'El color indica cuántas viviendas hay anunciadas.',
	layerPsm: 'El color indica el precio de salida por m\u00b2.',
	layerVerified: 'El color indica el precio verificado ante notario por m\u00b2.',
	layerGap: 'Viviendas anunciadas por cada 10.000 habitantes. El rojo señala los sitios con muy poca presencia para su tamaño. El gris indica que todavía hay muy pocas viviendas para poder medirlo.',
	cov: 'anunciadas por cada 10.000 habitantes',
	popLbl: 'Población',
	gapThin: 'Muy poca presencia para un sitio de este tamaño.',
	forSale: 'viviendas en venta',
	listed1: 'vivienda anunciada',
	listedN: 'viviendas anunciadas',
	medianAsking: 'Precio medio',
	askingPsm: '\u20ac/m\u00b2 de salida',
	longTerm: 'Larga temporada',
	holidayLbl: 'Vacacional',
	agenciesHere: 'Agencias que publican aquí',
	askPre: '¿Publicas en ',
	askPost: '?',
};

const title = 'Mapa de la red inmobiliaria - todas las propiedades, en 3D | PropertyList';
const description =
	'Un mapa 3D en directo de todas las viviendas de la red de PropertyList en Espana y Portugal. Gira el globo, baja hasta la Costa del Sol y consulta el numero de anuncios, los precios medios, el precio por m2 y el precio verificado ante notario que pagaron de verdad los compradores.';

let data: any = null;
let cities: any = null;
try {
	const raw = await import('../../../public/map/map-data.json');
	data = raw.default ?? raw;
} catch (e) {}
try {
	const raw = await import('../../../public/map/cities.json');
	cities = raw.default ?? raw;
} catch (e) {}

const munis = data?.municipalities ?? {};
const rows = Object.entries(munis)
	.map(([name, m]: any) => ({
		name,
		ine: m.ine,
		sale: m.ops?.sale?.n ?? 0,
		rent: m.ops?.rent?.n ?? 0,
		holiday: m.ops?.holiday?.n ?? 0,
		median: m.ops?.sale?.median ?? null,
		psm: m.ops?.sale?.psm ?? null,
		verified: m.verified?.psm ?? null,
		vn: m.verified?.n ?? null,
		pop: m.pop ?? null,
		p10: m.p10 ?? null,
		agencies: m.agencies?.top ?? [],
	}))
	.sort((a, b) => b.sale - a.sale);

const feats = cities?.features ?? [];
const totalListings = feats.reduce((s: number, f: any) => s + (f.properties?.n ?? 0), 0);
const townCount = feats.length;
const regionMap: Record<string, number> = {};
feats.forEach((f: any) => {
	const r = f.properties?.region ?? '?';
	regionMap[r] = (regionMap[r] ?? 0) + (f.properties?.n ?? 0);
});
const regions = Object.entries(regionMap).sort((a, b) => b[1] - a[1]);

const generated = data?.generated ? new Date(data.generated) : null;
const fmtDate = generated
	? `${String(generated.getUTCDate()).padStart(2, '0')}-${String(generated.getUTCMonth() + 1).padStart(2, '0')}-${String(generated.getUTCFullYear()).slice(2)}`
	: null;
const eur = (n: number | null) => (n == null ? '-' : '€' + n.toLocaleString('es-ES'));
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	fullBleed
	ogImage="/og/map-es.png"
	hreflangs={[
		{ hreflang: 'en', href: origin + '/map/' },
		{ hreflang: 'es', href: origin + '/es/mapa/' },
		{ hreflang: 'x-default', href: origin + '/map/' },
	]}
>
	<section class="hero">
		<div class="wrap">
			<p class="eyebrow">Mapa de la red en directo</p>
			<h1>Dónde está de verdad la red</h1>
			<p class="lede">
				Todas las viviendas de la red de PropertyList, contadas una sola vez por muchas agencias que las estén
				comercializando, y situadas en la localidad a la que pertenecen. Gira el globo, baja hasta la Costa del Sol y
				fíjate en el color: cuanto más intenso, más viviendas anunciadas tiene ese municipio. Los precios de salida
				salen de la MLS. La cifra verificada de debajo viene del registro notarial español: lo que pagaron de verdad
				los compradores.
			</p>
			<div class="counters">
				<div><strong>{totalListings.toLocaleString('es-ES')}</strong><span>viviendas &uacute;nicas en la red</span></div>
				<div><strong>{townCount}</strong><span>localidades</span></div>
				<div><strong>{regions.length}</strong><span>regiones de España y Portugal</span></div>
			</div>
		</div>
	</section>

	<section class="mapsec">
		<div class="wrap">
			<div class="controls" role="group" aria-label="Capa del mapa">
				<button class="chip on" data-layer="sale" type="button">Viviendas en venta</button>
				<button class="chip" data-layer="psm" type="button">&euro;/m&sup2; de salida</button>
				<button class="chip" data-layer="verified" type="button">&euro;/m&sup2; verificado</button>
				<button class="chip" data-layer="gap" type="button">Zonas con poca cobertura</button>
			</div>
			<div class="controls secondary" role="group" aria-label="Vista del mapa">
				<button class="ghost" id="spainbtn" type="button">Toda la red</button>
				<button class="ghost" id="homebtn" type="button">Costa del Sol</button>
				<button class="ghost" id="flattoggle" type="button">Vista plana</button>
			</div>

			<div class="maplayout">
				<button id="skipintro" type="button">Saltar intro</button>
				<div id="map" role="application" aria-label="Mapa 3D de la red de PropertyList">
					<noscript>
						<p class="nojs">El mapa interactivo necesita JavaScript. Tienes todos los municipios y regiones en las tablas de abajo.</p>
					</noscript>
				</div>
				<aside id="panel" aria-live="polite">
					<p class="panelhint">Selecciona un municipio o una localidad en el mapa para ver sus cifras.</p>
				</aside>
			</div>

			<p class="legend"><span id="legendlabel">El color indica cuántas viviendas hay anunciadas.</span>
				{fmtDate && <span class="stamp">Actualizado {fmtDate}</span>}
			</p>
			<p class="credits">Imagen de sat&eacute;lite Esri, Maxar, Earthstar Geographics &middot; l&iacute;mites y top&oacute;nimos &copy; OpenStreetMap &middot; elevaci&oacute;n AWS Terrain Tiles &middot; datos de mercado PropertyList &middot; precios verificados Consejo General del Notariado.</p>
		</div>
	</section>

	<section class="tablesec">
		<div class="wrap">
			<h2>Máxima cobertura: la Costa del Sol</h2>
			<p class="sub">
				Estos ocho municipios concentran la mayor parte de la red. Los precios de salida son lo que piden los vendedores hoy.
				El precio por m<sup>2</sup> verificado es la cifra del registro notarial de ese municipio en los últimos doce meses,
				de todos los tipos de vivienda: tómalo como el suelo sobre el que se apoya un mercado, no como la valoración de una vivienda concreta.
			</p>
			<div class="tablewrap">
				<table>
					<thead>
						<tr>
							<th>Municipio</th>
							<th class="n">En venta</th>
							<th class="n">Por 10.000 hab.</th>
							<th class="n">Precio medio</th>
							<th class="n">&euro;/m&sup2; de salida</th>
							<th class="n">&euro;/m&sup2; verificado</th>
							<th class="n">Larga temporada</th>
							<th class="n">Vacacional</th>
						</tr>
					</thead>
					<tbody>
						{rows.map((r) => (
							<tr>
								<th scope="row">{r.name}</th>
								<td class="n">{r.sale.toLocaleString('es-ES')}</td>
								<td class="n">{r.p10 == null ? '-' : r.p10.toLocaleString('es-ES')}</td>
								<td class="n">{eur(r.median)}</td>
								<td class="n">{eur(r.psm)}</td>
								<td class="n v">{eur(r.verified)}{r.vn && <em> n={r.vn.toLocaleString('es-ES')}</em>}</td>
								<td class="n">{r.rent.toLocaleString('es-ES')}</td>
								<td class="n">{r.holiday.toLocaleString('es-ES')}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<h2 class="mt">Todo lo demás a lo que llega la red</h2>
			<p class="sub">
				Todas las regiones donde la red ya tiene alguna vivienda. En algunas hay muy pocas: si publicas ahí, serías de
				los primeros.
			</p>
			<div class="tablewrap narrow">
				<table>
					<thead><tr><th>Región</th><th class="n">Viviendas</th><th class="n">Porcentaje</th></tr></thead>
					<tbody>
						{regions.map(([r, n]) => (
							<tr>
								<th scope="row">{r}</th>
								<td class="n">{n.toLocaleString('es-ES')}</td>
								<td class="n">{totalListings ? ((n / totalListings) * 100).toFixed(1) + '%' : '-'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section class="ctasec">
		<div class="wrap">
			<h2>Tus propiedades, en este mapa</h2>
			<p>
				Cada vivienda que ves aquí pertenece a una agencia de la red de PropertyList. Publicar es gratis: tus propiedades llegan
				a los demás agentes que pueden venderlas, y tú puedes vender de todo lo que ellos publican. Sin tarjeta y sin permanencia.
			</p>
			<a class="btn" href={SIGNUP} data-umami-event="map-signup-es">Crea tu cuenta de agencia gratis</a>
			<p class="fine">El núcleo de la plataforma es gratis para siempre. Mira <a href="/es/gratis/">qué es gratis</a>.</p>
		</div>
	</section>

	<script is:inline define:vars={{ rows, SIGNUP, MAPTEXT }}>
		window.__PLMAP__ = rows;
		window.__PLSIGNUP__ = SIGNUP;
		window.__PLTEXT__ = MAPTEXT;
	</script>
	<link rel="stylesheet" href="/map/maplibre-gl.css" />
	<script is:inline src="/map/maplibre-gl.js"></script>
	<script is:inline src="/map/map.js"></script>
</Layout>

<style>
	.wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
	.hero { background: linear-gradient(160deg, #06302c 0%, #0b1b22 70%); color: #fff; padding: 62px 0 40px; }
	.eyebrow { text-transform: uppercase; letter-spacing: 1.4px; font-size: 12px; font-weight: 800; color: #5be3d0; margin: 0 0 10px; }
	.hero h1 { font-size: clamp(30px, 4.6vw, 50px); line-height: 1.06; letter-spacing: -1.2px; margin: 0 0 14px; }
	.lede { max-width: 800px; font-size: 17.5px; line-height: 1.62; color: rgba(255,255,255,0.82); margin: 0 0 26px; }
	.counters { display: flex; flex-wrap: wrap; gap: 34px; }
	.counters strong { display: block; font-size: 30px; font-weight: 800; letter-spacing: -0.8px; color: #5be3d0; }
	.counters span { font-size: 13px; color: rgba(255,255,255,0.62); }

	.mapsec { padding: 30px 0 10px; background: #f6fafb; }
	.controls { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
	.controls.secondary { margin-bottom: 14px; }
	.chip { border: 1.5px solid #d5e2e0; background: #fff; color: #5b6b73; border-radius: 999px; padding: 9px 17px; font-size: 14px; font-weight: 700; cursor: pointer; transition: background .14s, color .14s, border-color .14s; }
	.chip:hover { border-color: #00ae9a; color: #0b1b22; }
	.chip.on { background: #00ae9a; border-color: #00ae9a; color: #fff; }
	.ghost { border: 1.5px solid #d5e2e0; background: #fff; color: #5b6b73; border-radius: 999px; padding: 7px 15px; font-size: 13px; font-weight: 700; cursor: pointer; }
	.ghost:hover { border-color: #00ae9a; color: #0b1b22; }

	.maplayout { display: grid; grid-template-columns: 1fr 330px; gap: 16px; position: relative; }
	#map { height: 600px; border-radius: 14px; overflow: hidden; background: #0b1b22; border: 1px solid #e7eef1; }
	#skipintro { display: none; position: absolute; z-index: 5; top: 14px; left: 14px; align-items: center; background: rgba(11,27,34,.84); color: #fff; border: 0; border-radius: 999px; padding: 8px 17px; font-size: 13px; font-weight: 700; cursor: pointer; }
	#skipintro:hover { background: rgba(11,27,34,.95); }
	.nojs { padding: 20px; color: #cfe0e2; }
	#panel { background: #fff; border: 1px solid #e7eef1; border-radius: 14px; padding: 18px; overflow-y: auto; max-height: 600px; }
	.panelhint { color: #5b6b73; font-size: 14.5px; margin: 0; }
	.legend { display: flex; justify-content: space-between; align-items: center; gap: 14px; font-size: 13px; color: #5b6b73; margin: 12px 0 0; }
	.stamp { color: #8aa0a6; }

	.credits { font-size: 11.5px; color: #8aa0a6; line-height: 1.5; margin: 8px 0 0; max-width: 900px; }
	.maplibregl-ctrl-attrib.maplibregl-compact:not(.maplibregl-compact-show) .maplibregl-ctrl-attrib-inner { display: none; }
	.tablesec { padding: 46px 0; background: #fff; }
	.tablesec h2, .ctasec h2 { font-size: clamp(23px, 3vw, 32px); letter-spacing: -0.7px; margin: 0 0 10px; color: #0b1b22; }
	.mt, .tablesec h2.mt, .ctasec h2.mt { margin-top: 64px; }
	.sub { color: #5b6b73; max-width: 800px; line-height: 1.6; margin: 0 0 20px; font-size: 15.5px; }
	.tablewrap { overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 640px; }
	/* three columns do not need the wide table's minimum, and on a phone that
	   minimum was spreading them across a scrollable 640px. */
	.tablewrap.narrow table { min-width: 0; }
	.tablewrap.narrow th.n, .tablewrap.narrow td.n { width: 1%; white-space: nowrap; }
	th, td { padding: 11px 12px; border-bottom: 1px solid #eef3f4; text-align: left; }
	thead th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.6px; color: #5b6b73; border-bottom: 2px solid #e7eef1; }
	td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
	tbody th { font-weight: 700; color: #0b1b22; }
	td.v { color: #00867a; font-weight: 700; }
	td.v em { display: block; font-style: normal; font-size: 11.5px; color: #8aa0a6; font-weight: 400; }

	.ctasec { padding: 52px 0 66px; background: #f6fafb; }
	.ctasec p { color: #45585f; max-width: 720px; line-height: 1.62; margin: 0 0 18px; }
	.btn { display: inline-block; background: #00ae9a; color: #fff; border-radius: 999px; padding: 14px 30px; font-weight: 800; text-decoration: none; }
	.btn:hover { background: #00998a; }
	.fine { font-size: 13.5px; color: #5b6b73; margin-top: 14px; }
	.fine a { color: #00867a; }

	@media (max-width: 640px) {
		.tablewrap.narrow th, .tablewrap.narrow td { padding: 10px 8px; font-size: 14px; }
		.tablewrap.narrow thead th { font-size: 11px; letter-spacing: 0.4px; }
	}

	@media (max-width: 380px) {
		.tablewrap.narrow th, .tablewrap.narrow td { padding: 9px 5px; font-size: 13px; }
		.tablewrap.narrow thead th { font-size: 10px; letter-spacing: 0.2px; }
	}

	@media (max-width: 900px) {
		.maplayout { grid-template-columns: 1fr; }
		/* Full-bleed. The 20px gutters cost a quarter of the map's width on a phone, which
		   was enough to make every municipality label collide away. body is overflow-x: clip
		   so breaking out of the container cannot cause side-scrolling. */
		#map {
			height: min(62vh, 600px);
			min-height: 450px;
			width: 100vw;
			margin-left: calc(50% - 50vw);
			margin-right: calc(50% - 50vw);
			border-radius: 0;
			border-left: 0;
			border-right: 0;
		}
		#skipintro { left: 12px; }
		#panel { max-height: none; }
		.counters { gap: 22px; }
	}
</style>
