---
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';

const __ps = await getPortalStats();
const plListings = statPlus(__ps.listings, 'es');
const plAgents = statPlus(__ps.agents, 'es');
const plAgencies = statPlus(__ps.agencies, 'es');

const title = 'Lanza tu agencia inmobiliaria en minutos | PropertyList';
const description =
	'Mira cómo una agencia pasa de cero a publicada, visible y con leads en nueve minutos: MLS gratis, portal, web con tu marca, CRM e IA. Sin tarjeta ni contrato.';

// The nine beats. Times are narrative markers; every feature shown is live and free.
const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=es';

const checklist = [
	'Agencia creada',
	'Anuncio publicado',
	`En el MLS de ${plAgents} agentes`,
	'En el portal',
	'Web online',
	'Feeds activos',
	'Lead captado',
	'IA emparejando',
	'Alertas armadas',
];

// fan-out mini cards: x, y offsets from centre + a hue for the photo block
const minis = [
	[-300, -150, 172], [-180, -215, 200], [-40, -245, 38], [115, -225, 172],
	[255, -160, 210], [335, -45, 45], [305, 95, 185], [185, 175, 26],
	[40, 215, 195], [-115, 205, 210], [-265, 155, 40], [-355, 15, 178],
	[365, -140, 205], [-350, -80, 30],
];

const howToLd = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'Lanza una agencia inmobiliaria con PropertyList',
	description: 'Los pasos que completa una agencia nueva con el stack gratuito de PropertyList: cuenta, primer anuncio, red MLS, portal, web con marca, feeds, leads en el CRM, IA y alertas.',
	step: [
		{ '@type': 'HowToStep', position: 1, name: 'Crea tu cuenta de agencia gratis', text: 'Regístrate en agents.propertylist.es. Sin tarjeta ni contrato.' },
		{ '@type': 'HowToStep', position: 2, name: 'Crea tu primer anuncio con Instant Listing', text: 'Sube fotos del móvil y describe la propiedad en voz alta. El anuncio se redacta solo, en español e inglés.' },
		{ '@type': 'HowToStep', position: 3, name: 'Compártelo en la red MLS', text: `Tu anuncio aparece en los paneles de más de ${plAgents} agentes de ${plAgencies} agencias, que pueden venderlo contigo.` },
		{ '@type': 'HowToStep', position: 4, name: 'Llega a compradores en el portal', text: `El anuncio se publica en propertylist.es junto a más de ${plListings} viviendas.` },
		{ '@type': 'HowToStep', position: 5, name: 'Consigue tu MicroSite gratis', text: 'Una web con tu marca en tuagencia.estate-agency.co con todos tus anuncios cargados. Gratis.' },
		{ '@type': 'HowToStep', position: 6, name: 'Envía tu cartera a otros portales', text: 'El envío XML a otros portales es gratis.' },
		{ '@type': 'HowToStep', position: 7, name: 'Capta leads en el CRM', text: 'Las consultas del portal y del MLS llegan solas a tu pipeline.' },
		{ '@type': 'HowToStep', position: 8, name: 'Empareja clientes con AI Property Match', text: 'Pega el mensaje del cliente. Busca primero en tu cartera y después en toda la red compartida. Gratis en beta.' },
		{ '@type': 'HowToStep', position: 9, name: 'Configura alertas de propiedades', text: 'Guarda el encargo del cliente y recibe un email en cuanto aparezca una propiedad que encaje.' },
	],
};
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://info.propertylist.es/es/' },
		{ '@type': 'ListItem', position: 2, name: 'Lanza tu agencia', item: 'https://info.propertylist.es/es/lanza-tu-agencia/' },
	],
};
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/es/lanza-tu-agencia/"
	ogImage="https://info.propertylist.es/og/og-launch.jpg"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/launch/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/lanza-tu-agencia/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/launch/' },
	]}
>
	<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(howToLd)} />
	<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<div class="launch">
		<!-- ================= INTRO (dark) ================= -->
		<section class="lIntro">
			<div class="lIntroInner">
				<p class="eyebrow">Para agentes que se independizan</p>
				<h1>Nueve minutos para<br /><span class="accent">una agencia en marcha.</span></h1>
				<p class="lead">
					Acabas de dejar la gran agencia. Tienes un móvil, tus contactos y cero anuncios. Esto es lo que hace con eso el
					stack gratuito de PropertyList.
				</p>
				<div class="clockZero" aria-hidden="true">00:00</div>
				<p class="cue"><span class="wheel" aria-hidden="true"><i></i></span> Desplázate para arrancar el reloj</p>
			</div>
		</section>

		<!-- ================= THE CLOCK (pinned) ================= -->
		<div class="journey">
			<div class="stage">
				<div class="aur a1" aria-hidden="true"></div>
				<div class="aur a2" aria-hidden="true" style="animation-range: contain 30% contain 44%;"></div>
				<div class="aur a3" aria-hidden="true" style="animation-range: contain 62% contain 78%;"></div>
				<div class="dots" aria-hidden="true"></div>

				<div class="clockBox" aria-hidden="true">
					<span class="clockLabel">En el reloj</span>
					<span class="clockDigits"></span>
					<span class="progTrack"><i class="progFill"></i></span>
				</div>

				<div class="checklist" aria-hidden="true">
					{checklist.map((c, i) => (
						<div class="ck" style={`animation-range: contain ${(i * 11.11 + 0.6).toFixed(2)}% contain ${(i * 11.11 + 2.4).toFixed(2)}%;`}>
							<i style={`animation-range: contain ${(i * 11.11 + 0.6).toFixed(2)}% contain ${(i * 11.11 + 2.6).toFixed(2)}%;`}>&#10003;</i>
							<span>{c}</span>
						</div>
					))}
				</div>

				<!-- 00:30 signup -->
				<section class="beat b0" style="animation-range: contain 0% contain 2%, contain 8.6% contain 11.9%;">
					<div class="beatInner">
						<p class="chip">00:30 en el reloj</p>
						<h2>Tu agencia ya existe.</h2>
						<p class="beatLead">Sin tarjeta. Sin contrato. Gratis para siempre: el MLS y el CRM no son una prueba.</p>
						<div class="uiCard signCard">
							<div class="skel w70"></div>
							<div class="skel w90"></div>
							<div class="skel w60"></div>
							<span class="uiBtn">Crear cuenta gratis</span>
						</div>
					</div>
				</section>

				<!-- 01:30 instant listing -->
				<section class="beat b1" style="animation-range: contain 9.9% contain 12.9%, contain 19.7% contain 23%;">
					<div class="beatInner">
						<p class="chip">01:30</p>
						<h2>El primer anuncio, hablado.</h2>
						<p class="beatLead">Fotos del móvil y descríbelo en voz alta. Instant Listing lo redacta, en español e inglés.</p>
						<div class="voiceRow">
							<div class="phone">
								<span class="mic">&#127908;</span>
								<span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
								<span class="phoneHint">"Adosado en el casco antiguo de Estepona, cuatro dormitorios, solárium..."</span>
							</div>
							<span class="arrow" aria-hidden="true">&rarr;</span>
							<div class="listingCard">
								<img src="/coast/estepona-800.jpg" alt="" width="800" height="600" loading="lazy" decoding="async" />
								<b>Adosado en Estepona</b>
								<span>4 dorm &middot; 3 ba&ntilde;os &middot; &euro;1.350.000</span>
							</div>
						</div>
					</div>
				</section>

				<!-- 02:30 fan-out -->
				<section class="beat b2" style="animation-range: contain 21% contain 24%, contain 30.8% contain 34.1%;">
					<div class="beatInner">
						<p class="chip">02:30</p>
						<h2>Publica una vez. <span class="accent">{plAgents} agentes</span> pueden venderlo.</h2>
						<p class="beatLead">Tu anuncio acaba de aterrizar en todos los paneles MLS de la costa: m&aacute;s de 920 agencias que pueden traerte al comprador.</p>
						<div class="fanWrap">
							<div class="listingCard heroCard">
								<img src="/coast/estepona-800.jpg" alt="" width="800" height="600" loading="lazy" decoding="async" />
								<b>Adosado en Estepona</b>
								<span>Compartido con la red</span>
							</div>
							<div class="fanRing" aria-hidden="true">
								{minis.map(([x, y, h], j) => (
									<i class="mini" style={`--mx:${x}px; --my:${y}px; --mh:${h}; animation-range: contain ${(23.6 + j * 0.26).toFixed(2)}% contain ${(25.2 + j * 0.26).toFixed(2)}%;`}></i>
								))}
							</div>
						</div>
					</div>
				</section>

				<!-- 03:30 portal -->
				<section class="beat b3" style="animation-range: contain 32.1% contain 35.1%, contain 41.9% contain 45.2%;">
					<div class="beatInner">
						<p class="chip">03:30</p>
						<h2>Los compradores ya pueden verlo.</h2>
						<p class="beatLead">En vivo en propertylist.es junto a m&aacute;s de {plListings} viviendas, sin cuotas de publicaci&oacute;n, nunca.</p>
						<div class="browser">
							<span class="bDots" aria-hidden="true"><i></i><i></i><i></i></span>
							<span class="bUrl">propertylist.es</span>
							<div class="bGrid">
								<figure class="bCard isYours"><img src="/coast/estepona-800.jpg" alt="" loading="lazy" decoding="async" /><figcaption>El tuyo &middot; &euro;1.350.000</figcaption></figure>
								<figure class="bCard"><img src="/coast/marbella-800.jpg" alt="" loading="lazy" decoding="async" /><figcaption>&euro;2.400.000</figcaption></figure>
								<figure class="bCard"><img src="/coast/benalmadena-800.jpg" alt="" loading="lazy" decoding="async" /><figcaption>&euro;690.000</figcaption></figure>
							</div>
						</div>
					</div>
				</section>

				<!-- 04:30 microsite -->
				<section class="beat b4" style="animation-range: contain 43.2% contain 46.2%, contain 53% contain 56.3%;">
					<div class="beatInner">
						<p class="chip">04:30 &middot; gratis</p>
						<h2>Tu web con tu marca, en vivo.</h2>
						<p class="beatLead">Cada agencia recibe un MicroSite con su propia direcci&oacute;n y todos sus anuncios cargados. Incluido, gratis.</p>
						<div class="browser">
							<span class="bDots" aria-hidden="true"><i></i><i></i><i></i></span>
							<span class="bUrl">youragency.estate-agency.co</span>
							<div class="msHero"><span class="msLogo"></span><b>Tu Agencia</b></div>
							<div class="bGrid two">
								<figure class="bCard"><img src="/coast/estepona-800.jpg" alt="" loading="lazy" decoding="async" /><figcaption>Adosado &middot; Estepona</figcaption></figure>
								<figure class="bCard"><img src="/coast/mijas-800.jpg" alt="" loading="lazy" decoding="async" /><figcaption>Casa de pueblo &middot; Mijas</figcaption></figure>
							</div>
						</div>
					</div>
				</section>

				<!-- 05:30 xml -->
				<section class="beat b5" style="animation-range: contain 54.3% contain 57.3%, contain 64.1% contain 67.4%;">
					<div class="beatInner">
						<p class="chip">05:30 &middot; gratis</p>
						<h2>Tu cartera sale a todas partes.</h2>
						<p class="beatLead">Un solo feed XML env&iacute;a tus anuncios a otros portales. En PropertyList, ese env&iacute;o es gratis.</p>
						<div class="xmlWrap">
							<span class="xmlHub">Tu cartera MLS</span>
							<div class="feeds" aria-hidden="true">
								<span class="feed"><i class="feedLine"><b></b></i><span class="feedChip">&#127760; Portal</span></span>
								<span class="feed"><i class="feedLine"><b></b></i><span class="feedChip">&#127760; Portal</span></span>
								<span class="feed"><i class="feedLine"><b></b></i><span class="feedChip">&#127760; Portal</span></span>
							</div>
						</div>
					</div>
				</section>

				<!-- 06:30 lead -->
				<section class="beat b6" style="animation-range: contain 65.5% contain 68.5%, contain 75.2% contain 78.5%;">
					<div class="beatInner">
						<p class="chip">06:30</p>
						<h2>Primer lead. Ya en tu CRM.</h2>
						<p class="beatLead">Las consultas del portal y del MLS llegan solas a tu pipeline: contactos, compradores, vendedores, transacciones.</p>
						<div class="browser crm">
							<span class="bDots" aria-hidden="true"><i></i><i></i><i></i></span>
							<span class="bUrl">agents.propertylist.es</span>
							<img class="crmShot" src="/img/crm-dashboard.jpg" alt="The PropertyList CRM dashboard with pipeline boards and AI Property Match" width="1600" height="792" loading="lazy" decoding="async" />
							<div class="toast" style="animation-range: contain 68.6% contain 70.2%;">&#128276; Nuevo lead &middot; Sof&iacute;a G. &middot; Adosado en Estepona</div>
						</div>
					</div>
				</section>

				<!-- 07:30 ai match -->
				<section class="beat b7" style="animation-range: contain 76.6% contain 79.6%, contain 86.3% contain 89.6%;">
					<div class="beatInner">
						<p class="chip">07:30 &middot; gratis en beta</p>
						<h2>Un cliente escribe. La IA encuentra el match.</h2>
						<p class="beatLead">Pega el mensaje en AI Property Match. Primero tu cartera, despu&eacute;s toda la red compartida.</p>
						<div class="waRow">
							<div class="waBubble">"3 dormitorios cerca de la playa en Estepona, menos de 500.000 &euro;... flexible si hay vistas al mar" <span class="waMeta">Cliente &middot; WhatsApp</span></div>
							<span class="arrow" aria-hidden="true">&rarr;</span>
							<div class="browser aiShot">
								<span class="bDots" aria-hidden="true"><i></i><i></i><i></i></span>
								<span class="bUrl">AI Property Match</span>
								<img src="/docs-images/ai-search/mls-results.jpg" alt="AI Property Match ranking matching listings for a pasted client brief" loading="lazy" decoding="async" />
							</div>
						</div>
					</div>
				</section>

				<!-- 08:30 alerts -->
				<section class="beat b8" style="animation-range: contain 87.7% contain 90.7%;">
					<div class="beatInner">
						<p class="chip">08:30</p>
						<h2>La red trabaja mientras duermes.</h2>
						<p class="beatLead">Guarda el encargo como alerta. Cuando aparezca una vivienda que encaje en cualquier punto de la red, el email te encuentra.</p>
						<div class="uiCard alertCard">
							<span class="bell" aria-hidden="true">&#128276;</span>
							<b>Alerta guardada</b>
							<span>3 dorm &middot; Estepona &middot; menos de 500.000 &euro;</span>
							<em>Vigilando {plListings} anuncios en vivo</em>
						</div>
					</div>
				</section>

				<div class="grain" aria-hidden="true"></div>
			</div>
		</div>

		<!-- ================= CLOCK STOPS ================= -->
		<section class="stopSec">
			<p class="stopTime" aria-hidden="true">09:12</p>
			<h2>Tiempo.</h2>
			<div class="tally">
				<div><b>1</b><span>anuncio en vivo en el portal</span></div>
				<div><b>{plAgents}</b><span>agentes que pueden venderlo</span></div>
				<div><b>1</b><span>web online, gratis</span></div>
				<div><b>{plListings}</b><span>viviendas que puedes vender desde el d&iacute;a uno</span></div>
			</div>
			<p class="zero">Total gastado: <b>0 &euro;</b></p>
			<div class="ctaRow">
				<a class="btnBig" href={SIGNUP} target="_blank" rel="noopener">Arranca tu reloj - &uacute;nete gratis</a>
			</div>
			<p class="fine">Un recorrido guiado por funciones reales de PropertyList, con pantallas reales del producto. La mayor&iacute;a de los agentes le gana al reloj.</p>
		</section>

		<!-- ================= PAID, OPENLY ================= -->
		<section class="growSec">
			<h3>Cuando quieras crecer</h3>
			<p class="growLead">La base sigue siendo gratis. Estos son los extras opcionales, con su precio en cr&eacute;ditos, a la vista.</p>
			<div class="growGrid">
				<a href="/es/docs/propertylist-mls-manual-de-usuario/reports-statistics/generating-property-reports/"><b>Property Intelligence Report</b><span>Valoraciones verificadas ante notario con brief para el agente</span><em>5 cr&eacute;ditos</em></a>
				<a href="/es/precios/"><b>Destacar un anuncio</b><span>Arriba del MLS o del portal</span><em>desde 10 cr&eacute;ditos</em></a>
				<a href="/es/constructor-de-webs/"><b>Creador de Webs</b><span>Web completa a medida: crear y previsualizar es gratis</span><em>50 cr&eacute;ditos/mes</em></a>
				<a href="/es/precios/"><b>Anuncios privados</b><span>Mant&eacute;n una venta fuera de la red compartida</span><em>los 5 primeros gratis</em></a>
			</div>
			<p class="growMore"><a href="/es/precios/">Precios completos</a> &middot; <a href="/es/docs/">Documentaci&oacute;n</a> &middot; <a href="/es/costa-del-sol/">Recorre la costa</a></p>
		</section>
	</div>
</Layout>

<script is:inline>
	(function () {
		var seen = {};
		var q = [];
		function track(n) { try { if (window.umami && umami.track) umami.track(n, {}); else q.push(n); } catch (e) {} }
		var flushT = setInterval(function () { try { if (window.umami && umami.track) { q.splice(0).forEach(function (n) { umami.track(n, {}); }); clearInterval(flushT); } } catch (e) {} }, 400);
		function mark(k) { if (k && !seen[k]) { seen[k] = 1; track('launch-sec-' + k); } }
		var keys = ['b0', 'b1', 'b2', 'b3', 'b4', 'b5', 'b6', 'b7', 'b8'];
		var journey = document.querySelector('.journey');
		var stage = document.querySelector('.stage');
		var sticky = stage && getComputedStyle(stage).position === 'sticky';
		if (journey && sticky) {
			// pinned mode: beats share the same geometry, so depth = scroll progress through the journey
			var onScroll = function () {
				var r = journey.getBoundingClientRect();
				var total = r.height - innerHeight;
				if (total <= 0) return;
				var p = Math.min(1, Math.max(0, -r.top / total));
				var idx = Math.min(8, Math.floor((p * 100) / 11.11));
				for (var i = 0; i <= idx; i++) mark(keys[i]);
			};
			addEventListener('scroll', onScroll, { passive: true });
			onScroll();
		} else if ('IntersectionObserver' in window) {
			// static fallback: beats are in normal flow, geometry works
			var io = new IntersectionObserver(function (es) {
				es.forEach(function (e) { if (e.isIntersecting) mark(e.target.className.split(' ')[1]); });
			}, { threshold: 0.3 });
			document.querySelectorAll('.beat').forEach(function (s) { io.observe(s); });
		}
		if ('IntersectionObserver' in window) {
			var io2 = new IntersectionObserver(function (es) {
				es.forEach(function (e) { if (e.isIntersecting) mark(e.target.className.split(' ')[0]); });
			}, { threshold: 0.3 });
			document.querySelectorAll('.stopSec, .growSec').forEach(function (s) { io2.observe(s); });
		}
		document.addEventListener('click', function (ev) {
			var a = ev.target.closest && ev.target.closest('a');
			if (a && (a.href || '').indexOf('new_agency') > -1) track('launch-signup-click');
		});
	})();
</script>

<style is:global>
	@property --lm { syntax: '<integer>'; initial-value: 0; inherits: true; }
	@property --ls { syntax: '<integer>'; initial-value: 0; inherits: true; }
</style>

<style>
	/* ============ shell ============ */
	.launch {
		width: 100vw; margin-left: calc(50% - 50vw); margin-top: -28px; margin-bottom: -40px;
		color: #0b1220;
		--teal: #00ae9a; --deep: #0a6d61; --gold: #e6a94e; --ink: #0b1220;
		background: #eef4fa;
	}
	.eyebrow { font-size: 12px; letter-spacing: .22em; text-transform: uppercase; font-weight: 800; margin: 0 0 16px; }
	.accent { color: var(--teal); }

	/* ============ intro (dark) ============ */
	.lIntro {
		position: relative; min-height: 100svh; display: grid; place-items: center;
		text-align: center; padding: 90px 20px 110px; overflow: hidden;
		background:
			radial-gradient(90% 70% at 50% 110%, rgba(0, 174, 154, .16) 0%, rgba(0, 174, 154, 0) 60%),
			linear-gradient(180deg, #060a18 0%, #0b1226 60%, #101a34 100%);
		color: #fff;
	}
	.lIntroInner { max-width: 780px; }
	.lIntro .eyebrow { color: rgba(255, 255, 255, .6); }
	.lIntro h1 { font-size: clamp(40px, 7.6vw, 84px); line-height: 1.02; letter-spacing: -.035em; font-weight: 900; margin: 0 0 20px; }
	.lIntro .lead { max-width: 560px; margin: 0 auto 34px; font-size: 17px; line-height: 1.66; color: rgba(255, 255, 255, .82); }
	.clockZero {
		font-variant-numeric: tabular-nums; font-weight: 900; letter-spacing: .02em;
		font-size: clamp(56px, 10vw, 104px); line-height: 1; margin-bottom: 30px;
		background: linear-gradient(120deg, #7ee8d8, #ffd79a); -webkit-background-clip: text; background-clip: text; color: transparent;
	}
	.cue { display: inline-flex; align-items: center; gap: 11px; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: rgba(255, 255, 255, .7); font-weight: 700; margin: 0; }
	.wheel { width: 22px; height: 34px; border: 1.6px solid rgba(255, 255, 255, .45); border-radius: 999px; position: relative; display: inline-block; }
	.wheel i { position: absolute; left: 50%; top: 7px; translate: -50% 0; width: 3px; height: 7px; border-radius: 2px; background: rgba(255, 255, 255, .85); animation: wheelCue 1.9s ease-in-out infinite; }
	@keyframes wheelCue { 0%, 100% { transform: translateY(0); opacity: 1; } 55% { transform: translateY(11px); opacity: .25; } }

	/* ============ pinned stage ============ */
	.journey { position: relative; height: calc(12 * 100svh); }
	.stage { position: sticky; top: 0; height: 100svh; overflow: hidden; isolation: isolate; background: #eef4fa; }

	.aur { position: absolute; inset: -12%; z-index: -4; opacity: 1; }
	.a1 { background:
