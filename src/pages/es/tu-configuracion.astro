	.ticks { display: flex; justify-content: space-between; gap: 6px; margin-top: 4px; padding: 0 54px; }
	.tick { appearance: none; border: 0; background: none; font: inherit; font-size: 12.5px; font-weight: 700; color: rgba(16, 24, 40, 0.4); text-align: center; flex: 1 1 0; line-height: 1.3; cursor: pointer; padding: 6px 2px; border-radius: 8px; }
	.tick:hover { color: #0a6d61; background: rgba(var(--pl-accent-rgb), 0.07); }
	.tick.on { color: #0a6d61; }
	.tick[aria-current='true'] { font-weight: 900; }
	.stepline { display: none; margin: 6px 0 0; font-size: 13px; font-weight: 700; color: rgba(16, 24, 40, 0.6); }
	.delta { min-height: 20px; margin: 8px 0 0; font-size: 13.5px; font-weight: 700; color: #0a6d61; }
	@media (max-width: 600px) {
		.ticks { display: none; }
		.stepline { display: block; }
	}

	.board { display: grid; grid-template-columns: 1fr; gap: 16px; }
	@media (min-width: 880px) { .board { grid-template-columns: 1fr 300px; } }
	/* grid children default to min-width auto, so one nowrap span inside a row
	   can force the whole column past the viewport on a phone */
	.board > * { min-width: 0; }

	.panel { border: 1px solid rgba(16, 24, 40, 0.1); border-radius: 20px; padding: 20px 22px; background: #fff; }
	.panelHead h2 { font-size: 22px; margin: 0 0 6px; letter-spacing: -0.015em; }
	.panelSub { margin: 0 0 14px; font-size: 15px; line-height: 1.6; color: rgba(16, 24, 40, 0.72); max-width: 62ch; }

	.toolSet { display: none; }
	.toolSet.on { display: block; }
	.tool { padding: 11px 0; border-top: 1px solid rgba(16, 24, 40, 0.08); }
	.toolTop { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 14px; align-items: baseline; }
	.toolName { font-size: 15px; font-weight: 700; }
	.toolName a { color: #0a6d61; }
	.toolPrice { font-size: 14px; font-weight: 800; color: #0a6d61; white-space: nowrap; }
	.tool.soon .toolPrice { color: #8a5a00; }
	.toolNote { margin: 4px 0 0; font-size: 13px; line-height: 1.5; color: rgba(16, 24, 40, 0.55); }
	.soonBadge { margin-left: 8px; font-size: 10.5px; font-weight: 900; letter-spacing: 0.05em; text-transform: uppercase; color: #8a5a00; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.32); padding: 2px 8px; border-radius: 999px; }

	.addonWrap { margin-top: 18px; padding-top: 14px; border-top: 2px solid rgba(var(--pl-accent-rgb), 0.25); }
	.addonHead { font-size: 12px; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(16, 24, 40, 0.45); margin: 0 0 4px; }
	.addonSub { margin: 0 0 4px; font-size: 13px; line-height: 1.5; color: rgba(16, 24, 40, 0.55); }
