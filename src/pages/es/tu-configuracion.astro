	.sw[aria-checked='true'] .swKnob { left: 20px; }
	.offAgain { color: rgba(16, 24, 40, 0.4); }

	.week { margin-top: 18px; padding-top: 14px; border-top: 2px solid rgba(16, 24, 40, 0.1); }
	.weekHead { font-size: 12px; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(16, 24, 40, 0.45); margin: 0 0 4px; }
	.weekList { list-style: none; margin: 0; padding: 0; }
	.weekList li { border-top: 1px solid rgba(16, 24, 40, 0.06); }
	.wJump { appearance: none; border: 0; background: none; font: inherit; width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 12px; padding: 8px 0; cursor: pointer; text-align: left; }
	.wRight { margin-left: auto; }
	.wLabel { font-size: 14px; line-height: 1.45; color: rgba(16, 24, 40, 0.78); }
	.wRight { display: inline-flex; align-items: baseline; gap: 8px; white-space: nowrap; }
	.wH { font-size: 13px; font-weight: 800; color: rgba(16, 24, 40, 0.55); }
	.wFix { font-size: 12px; font-weight: 700; color: rgba(16, 24, 40, 0.38); }
	li.done .wLabel { text-decoration: line-through; color: rgba(16, 24, 40, 0.38); transition: color 0.3s; }
	li.done .wH { text-decoration: line-through; color: rgba(16, 24, 40, 0.3); }
	li.done .wFix { color: #0a6d61; }
	li.soonTask .wJump { cursor: default; }
