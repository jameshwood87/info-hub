---
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';

// A configurator, not a fifth telling of the value story. /free/ already does
// money, /hours/ does time, /what-we-do/ follows a listing and /launch/ does
// speed. The gap none of them fills is "which of these should I actually switch
// on, and what will it cost me a month". That is what this answers.
//
// Rebuilt 25-08-26 after a three-lens review. The shape now tells the truth the
// old FAQ had to apologise for: the slider carries only the stages that ARE a
// progression (now -> free core -> pay per use -> runs itself), and everything
// optional is an add-on with its own switch. Nothing is bundled: sliding never
// adds a paid tool the viewer did not flick on themselves.
//
// Every hour figure is lifted from /hours/ rather than invented, including the
// afterMin residue, so the two pages cannot drift apart. Hours given back is
// hours minus that residue, never the whole task, because none of these tools
// removes a job entirely.
//
// Three rules the page has to keep:
//   1. Monthly credits and pay-per-use are counted separately. Rolling a 1-credit
//      buyer lead into a monthly figure would be fiction.
//   2. Unbuilt tools are badged, priced at nothing and contribute no hours. They
//      live in a strip below the board, not on the slider, because a stage that
//      changes nothing must not be the story's ending.
//   3. The week list only shows jobs this viewer actually has: no lettings, no
//      tenancies row; own website already, no nagging-a-developer row.

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/tu-configuracion/`;
const title = 'Tu configuración: qué activar y qué cuesta | PropertyList';
const description =
	'Empieza por cómo trabajas hoy y añade las cosas de una en una. Cada paso muestra las herramientas, los créditos al mes y las horas a la semana que devuelve. El núcleo es gratis y casi todo lo sigue siendo.';

const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'es');

// hours: weekly hours the task costs. after: minutes still left once the tool is
// on. Both come straight from /hours/, where they are described as deliberately
// conservative. fix names what strikes the task through: a spine stage, an
// add-on switch, or a tool that is not built yet (never struck).
type Task = {
	id: string;
	label: string;
	hours: number;
	after: number;
	fix: string; // 'stage:<key>' | 'addon:<key>' | 'soon:<name>'
	needs?: 'lettings' | 'nosite';
};

const allTasks: Task[] = [
	{ id: 'listings', label: 'Anuncios a las once de la noche', hours: 2, after: 15, fix: 'stage:free' },
	{ id: 'portals', label: 'Repetir el mismo piso en cinco portales', hours: 2, after: 0, fix: 'stage:free' },
	{ id: 'matching', label: 'Bucear en portales buscando el piso de un comprador', hours: 2, after: 10, fix: 'stage:free' },
	{ id: 'desk', label: 'Volver a la oficina solo para usar el CRM', hours: 1, after: 0, fix: 'stage:free' },
	{ id: 'valuation', label: 'Discutir el precio con un propietario', hours: 2, after: 30, fix: 'stage:demand' },
	{ id: 'followup', label: 'Acordarme de a quién prometí llamar', hours: 3, after: 15, fix: 'stage:auto' },
	{ id: 'website', label: 'Suplicarle cambios al de la web', hours: 1, after: 10, fix: 'addon:wb', needs: 'nosite' },
	{ id: 'tenants', label: 'Alquileres viviendo en un Excel', hours: 2, after: 30, fix: 'addon:rent', needs: 'lettings' },
	{ id: 'callnotes', label: 'Pasar a limpio llamadas que ya dije en voz alta', hours: 2, after: 0, fix: 'soon:CoAgent' },
	{ id: 'signatures', label: 'Perseguir una firma durante una semana', hours: 1, after: 0, fix: 'soon:Documentos Instantáneos' },
	{ id: 'brochures', label: 'Hacer folletos en Canva a medianoche', hours: 1, after: 0, fix: 'soon:Folleto Instantáneo' },
];

type Tool = {
	name: string;
	href?: string;
	price: string;
	monthly: number;   // credits per month, 0 for free and for pay-per-use
	perUse?: string;   // shown separately, never folded into the monthly figure
	soon?: boolean;
	note?: string;
};

type Stage = { key: string; tick: string; head: string; sub: string; tools: Tool[] };

// The spine: only what is genuinely a progression. Everything optional is an
// add-on below, with its own switch.
const stages: Stage[] = [
	{
		key: 'now',
		tick: 'Hoy',
		head: 'Cómo trabajas hoy',
		sub: 'Nada activado. Cada tarea de abajo la haces a mano, por la noche, de memoria.',
		tools: [],
	},
	{
		key: 'free',
		tick: 'Núcleo gratis',
		head: 'El núcleo gratis',
		sub: 'Esto es lo que toda agencia recibe por nada, sin tarjeta y sin reloj de prueba. La mayoría de las agencias nunca necesita ir más allá.',
		tools: [
			{ name: 'MLS y CRM compartidos', href: '/es/pipelines/', price: 'Gratis', monthly: 0 },
			{ name: 'Anuncios y personal ilimitados', price: 'Gratis', monthly: 0 },
			{ name: 'Listado Instantáneo', href: '/es/listado-instantaneo/', price: 'Gratis', monthly: 0 },
			{ name: 'Feeds XML de tu propia cartera, de entrada y de salida', href: '/es/importar-feed-xml/', price: 'Gratis', monthly: 0, note: 'Importa tu cartera y publica tus propios anuncios en portales y en tu propia web, gratis. Solo el feed de toda la red para tu web es de pago.' },
			{ name: 'Microsite de marca', price: 'Gratis', monthly: 0 },
			{ name: 'App móvil', href: '/es/app-movil/', price: 'Gratis', monthly: 0 },
			{ name: 'Búsqueda de propiedades con IA', href: '/es/busqueda-ia/', price: 'Gratis en beta', monthly: 0 },
		],
	},
	{
		key: 'demand',
		tick: 'Pago por uso',
		head: 'Paga solo cuando funciona',
		sub: 'Aquí no hay nada mensual. Gastas un crédito en el momento en que algo merece la pena, y no antes.',
		tools: [
			{ name: 'Leads de compradores', href: '/es/precios/', price: '1 crédito cada uno', monthly: 0, perUse: '1 crédito por lead que decides pasar al pipeline de Compradores, los 5 primeros gratis' },
			{ name: 'Informe de Inteligencia de Propiedad', href: '/es/informe-inteligencia-propiedad/', price: '5 créditos', monthly: 0, perUse: '5 créditos por informe' },
			{ name: 'Destacar un anuncio', price: '10 créditos / 3 días', monthly: 0, perUse: '10 créditos por destacar un anuncio 3 días' },
		],
	},
	{
		key: 'auto',
		tick: 'Se hace solo',
		head: 'Las partes que funcionan solas',
		sub: 'Lo primero genuinamente mensual. Trabaja mientras estás en una visita y te dice a quién llamar cuando encuentra algo.',
		tools: [
			{ name: 'Automatización y Nurture', href: '/es/nurture/', price: '20 créditos al mes', monthly: 20 },
			{ name: 'Bandeja de correo conectada', href: '/es/bandeja-conectada/', price: '10 créditos por buzón al mes', monthly: 0, soon: true, note: 'Aún no está construida, así que hoy no cuesta nada.' },
		],
	},
];

// Add-ons: opt-in, one switch each, nothing on by default. show decides which
// cards exist for this viewer; needs ties a card to another one.
type Addon = {
	key: string;
	name: string;
	href?: string;
	price: string;
	monthly: number;
	taskId?: string; // the week-list job this strikes through
	note: string;
	show: 'nosite' | 'hassite' | 'lettings';
	needs?: string;
};

const addons: Addon[] = [
	{
		key: 'wb',
		name: 'Constructor de Webs',
		href: '/es/constructor-de-webs/',
		price: '50 créditos al mes',
		monthly: 50,
		taskId: 'website',
		note: 'Una web de verdad que carga tu cartera del MLS por sí sola. Constrúyela y previsualízala gratis, pagas solo cuando la publicas.',
		show: 'nosite',
	},
	{
		key: 'ic',
		name: 'Contenido Instantáneo',
		href: '/es/contenido-instantaneo/',
		price: '30 créditos al mes',
		monthly: 30,
		note: 'Complemento del Constructor de Webs: blog con IA y guías de zona para tu web.',
		show: 'nosite',
		needs: 'wb',
	},
	{
		key: 'feed',
		name: 'Feed de la red a tu propia web',
		href: '/es/importar-feed-xml/',
		price: '35 créditos al mes',
		monthly: 35,
		note: 'Todos los anuncios compartidos de la red, en la web que ya tienes. Tus propios anuncios son gratis en cualquier caso.',
		show: 'hassite',
	},
	{
		key: 'devfeed',
		name: 'Feed de obra nueva',
		price: '25 créditos al mes',
		monthly: 25,
		note: 'Feed aparte, sobre plano y obra nueva.',
		show: 'hassite',
	},
	{
		key: 'rent',
		name: 'Módulo de Alquileres',
		href: '/es/alquileres/',
		price: '50 créditos por 30 días',
		monthly: 50,
		taskId: 'tenants',
		note: 'Persigue solo sus propias fechas de renovación, que es la parte que nadie recuerda hasta que es tarde. Gratis 30 días, sin tarjeta.',
		show: 'lettings',
	},
];

// Not built. In a strip below the board, never on the slider: a stage that
// changes nothing must not be where the story ends.
const soonTools = [
	{ name: 'CoAgent', href: '/es/coagent/' },
	{ name: 'Documentos Instantáneos', href: '/es/documentos-instantaneos/' },
	{ name: 'Folleto Instantáneo', href: '/es/folleto-instantaneo/' },
	{ name: 'Vídeo e Imágenes Instantáneos', href: '/es/video-instantaneo/' },
];

const faqs = [
	{
		q: '¿De dónde salen las horas?',
		a: 'De la misma lista que el recuento de papeleo de la página de horas, que es deliberadamente conservador. Una herramienta casi nunca elimina una tarea del todo, así que la cifra de aquí son las horas que cuesta la tarea menos los minutos que sigue costando después. Redactar anuncios baja de dos horas a quince minutos, por ejemplo, y esta página cuenta la diferencia, no las dos horas enteras.',
	},
	{
		q: '¿Por qué los créditos de pago por uso quedan fuera del total mensual?',
		a: 'Porque meterlos sería inventarse un número. Un lead de comprador cuesta un crédito en el momento en que decides que ese lead merece la pena, y si en un mes no tomas ninguno no gastas nada. Añadir una suposición de cuántos podrías tomar haría que la cifra mensual pareciera precisa cuando no lo es.',
	},
	{
		q: '¿Tengo que ir de izquierda a derecha?',
		a: 'No. La mayoría de las agencias se queda en el núcleo gratis y es un sitio perfectamente bueno donde quedarse. El deslizador es el orden que suele tener sentido, y los complementos son exactamente eso: complementos, cada uno con su interruptor, y ninguno encendido si no lo enciendes tú. Todo lo que va después del núcleo gratis se puede apagar el mes que dejes de quererlo.',
	},
	{
		q: '¿Y los marcados como próximamente?',
		a: 'No están construidos. No cuestan nada, no ahorran nada, y están en la página porque los agentes preguntan qué viene. Cuando uno se lance tendrá precio y empezará a contar, y no antes.',
	},
];
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	robots="noindex,follow"
	hreflangs={[
		{ hreflang: 'en', href: `${origin}/your-setup/` },
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'x-default', href: `${origin}/your-setup/` },
	]}
>
	<div class="wrap" data-setup>
		<section class="intro">
			<p class="kicker">Tu configuración</p>
			<h1>Empieza donde estás.<br /><em>Añade las cosas de una en una.</em></h1>
			<p class="sub">
				Nadie lo activa todo de golpe, y la mayoría de las agencias nunca lo necesita. Desliza a la derecha, enciende
				solo los complementos que de verdad usarías, y mira qué cuesta y qué devuelve. El núcleo es gratis, y muchas
				agencias se quedan ahí.
			</p>
		</section>

		<section class="qs">
			<div class="q">
				<span class="qLab">¿Llevas alquileres?</span>
				<div class="seg" role="group" aria-label="¿Llevas alquileres?">
					<button type="button" class="segBtn on" data-lettings="no">No</button>
					<button type="button" class="segBtn" data-lettings="yes">Sí</button>
				</div>
			</div>
			<div class="q">
				<span class="qLab">¿Tienes web propia?</span>
				<div class="seg" role="group" aria-label="¿Tienes web propia?">
					<button type="button" class="segBtn on" data-site="no">Aún no</button>
					<button type="button" class="segBtn" data-site="yes">Sí</button>
				</div>
			</div>
		</section>

		<section class="rig">
			<div class="sliderRow">
				<span class="srLab" id="sliderLab">Móntalo por pasos</span>
				<div class="sliderLine">
					<button type="button" class="step" data-step="-1" aria-label="Paso anterior">&#8249;</button>
					<input id="stage" class="slider" type="range" min="0" max={stages.length - 1} step="1" value="0" aria-labelledby="sliderLab" aria-describedby="stageName" />
					<button type="button" class="step" data-step="1" aria-label="Paso siguiente">&#8250;</button>
				</div>
				<div class="ticks">
					{stages.map((s, i) => (
						<button type="button" class="tick" data-goto={String(i)}>{s.tick}</button>
					))}
				</div>
				<p class="stepline" data-stepline aria-hidden="true">Paso 1 de {stages.length} &middot; Cómo trabajas hoy</p>
				<p class="delta" data-delta aria-live="polite"></p>
			</div>

			<div class="board">
				<div class="panel">
					<div class="panelHead">
						<h2 id="stageName">Cómo trabajas hoy</h2>
						<p class="panelSub" data-sub>Nada activado. Cada tarea de abajo la haces a mano, por la noche, de memoria.</p>
					</div>

					<div class="toolWrap" data-tools>
						{stages.map((s) => (
							<div class="toolSet" data-stage={s.key}>
								{s.tools.map((t) => (
									<div class:list={['tool', { soon: t.soon }]}>
										<div class="toolTop">
											<span class="toolName">
												{t.href ? <a href={t.href}>{t.name}</a> : t.name}
												{t.soon ? <span class="soonBadge">Coming soon</span> : null}
											</span>
											<span class="toolPrice">{t.price}</span>
										</div>
										{t.note ? <p class="toolNote">{t.note}</p> : null}
									</div>
								))}
							</div>
						))}
					</div>

					<div class="addonWrap" data-addonwrap hidden>
						<h3 class="addonHead">Complementos, solo si los quieres</h3>
						<p class="addonSub">Cada uno tiene su propio interruptor. Aquí no hay paquetes y nada se enciende si no lo enciendes tú.</p>
						{addons.map((a) => (
							<div class="addon" data-addon={a.key} data-show={a.show} data-needs={a.needs || ''}>
								<div class="toolTop">
									<span class="toolName">
										{a.href ? <a href={a.href}>{a.name}</a> : a.name}
									</span>
									<span class="addonRight">
										<span class="toolPrice">{a.price}</span>
										<button type="button" class="sw" role="switch" aria-checked="false" data-sw={a.key} aria-label={`Encender o apagar ${a.name}`}>
											<span class="swKnob"></span>
										</button>
									</span>
								</div>
								<p class="toolNote">{a.note} <span class="offAgain">Se apaga el mes que quieras.</span></p>
							</div>
						))}
					</div>

					<div class="week">
						<h3 class="weekHead">Tu semana, a mano</h3>
						<ul class="weekList" data-week>
							{allTasks.map((t) => (
								<li data-task={t.id}>
									<button type="button" class="wJump" data-jump={t.fix}>
										<span class="wLabel">{t.label}</span>
										<span class="wRight">
											<span class="wH">{t.hours}h</span>
											<span class="wFix" data-wfix></span>
										</span>
									</button>
								</li>
							))}
						</ul>
						<p class="weekTotal">Unas <strong data-weektotal>17</strong> horas de papeleo a la semana, del <a href="/es/horas/">recuento de horas</a>. Deliberadamente conservador.</p>
					</div>
				</div>

				<aside class="meter">
					<div class="mBlock">
						<div class="mLab">Créditos al mes</div>
						<div class="mNum" data-credits>0</div>
						<div class="mEuro" data-euro hidden></div>
						<div class="mNote" data-perUse>Nada mensual. Nada de nada, de hecho.</div>
					</div>
					<div class="mBlock">
						<div class="mLab">Horas a la semana devueltas</div>
						<div class="mNum alt" data-hours>0</div>
						<div class="mNote">De unas <strong data-weektotal2>17</strong> horas de papeleo a la semana.</div>
					</div>
					<div class="mBlock last mCta" data-ctablock>
						<p class="mCtaLine" data-ctaline>Desliza a la derecha para ver qué activa el núcleo gratis.</p>
						<a class="btnP mBtn" href="https://agents.propertylist.es/new_agency/new?locale=es" target="_blank" rel="noopener" data-cta hidden>
							Crea la cuenta gratis de tu agencia
						</a>
					</div>
				</aside>
			</div>

			<div class="soonStrip">
				<span class="soonStripLab">En camino, nada construido, nada contado:</span>
				{soonTools.map((t, i) => (
					<span class="soonItem">
						<a href={t.href}>{t.name}</a>{i < soonTools.length - 1 ? ',' : ''}
					</span>
				))}
			</div>
		</section>

		<section class="band">
			<h2>Guarda esta configuración</h2>
			<p class="lead" data-keeplead>
				Desliza y enciende hasta que se parezca a tu agencia, y llévatela. El enlace reproduce exactamente lo
				que has montado.
			</p>
			<div class="receipt" data-receipt>
				<p class="rTitle">TU CONFIGURACIÓN</p>
				<div class="rLines" data-rlines>
					<p class="rEmpty">Nada activado todavía. Desliza a la derecha para montar una.</p>
				</div>
			</div>
			<div class="ctaRow">
				<button type="button" class="btnS" data-share-wa hidden>Compartir por WhatsApp</button>
				<button type="button" class="btnS" data-share-copy hidden>Copiar enlace</button>
				<a class="btnP" href="https://agents.propertylist.es/new_agency/new?locale=es" target="_blank" rel="noopener" data-cta2>
					Crea la cuenta gratis de tu agencia
				</a>
				<a class="btnS" href="/es/precios/">Ver todos los precios</a>
			</div>
			<p class="agentsLine">{plAgents} agentes ya están en el núcleo gratis. Lo demás lo decides cuando hayas visto si la parte gratis vale la pena.</p>
		</section>

		<section class="band">
			<h2>Preguntas</h2>
			<div class="faq">
				{faqs.map((qa) => (
					<details>
						<summary>{qa.q}</summary>
						<p>{qa.a}</p>
					</details>
				))}
			</div>
		</section>

		<button type="button" class="bar" data-bar aria-label="Tu total en marcha. Toca para ver las cifras completas.">
			<span class="barC"><strong data-bar-c>0</strong> cr/mes</span>
			<span class="barE" data-bar-e hidden></span>
			<span class="barH"><strong data-bar-h>0</strong> h/sem devueltas</span>
		</button>
	</div>

	<script define:vars={{ stages, addons, allTasks }}>
		// All the DOM above is server-rendered. This only toggles classes and
		// writes numbers, so the page is complete and readable with JS off.
		const root = document.querySelector('[data-setup]');
		if (root) {
			const slider = root.querySelector('#stage');
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const track = (n, d) => { try { if (window.umami && umami.track) umami.track(n, d); } catch (e) {} };

			const state = { lettings: 'no', site: 'no', stage: 0, on: new Set(), touched: false };

			// restore a shared configuration from the URL
			try {
				const p = new URLSearchParams(location.search);
				const st = parseInt(p.get('st') || '', 10);
				if (st >= 0 && st < stages.length) { state.stage = st; state.touched = true; }
				if (p.get('let') === 'y') { state.lettings = 'yes'; state.touched = true; }
				if (p.get('site') === 'y') { state.site = 'yes'; state.touched = true; }
				(p.get('add') || '').split(',').filter(Boolean).forEach((k) => {
					if (addons.some((a) => a.key === k)) { state.on.add(k); state.touched = true; }
				});
			} catch (e) {}

			const fmtH = (h) => (h < 0.05 ? '0' : h.toFixed(1).replace(/\.0$/, ''));
			const back = (t) => t.hours - t.after / 60;

			// which add-on cards exist for this viewer
			const addonVisible = (a) =>
				(a.show === 'lettings' && state.lettings === 'yes') ||
				(a.show === 'nosite' && state.site === 'no') ||
				(a.show === 'hassite' && state.site === 'yes');

			// which week-list jobs this viewer actually has
			const taskVisible = (t) =>
				(t.needs !== 'lettings' || state.lettings === 'yes') &&
				(t.needs !== 'nosite' || state.site === 'no');

			const tween = (el, to, animate) => {
				const from = parseFloat(el.dataset.v || '0') || 0;
				el.dataset.v = String(to);
				// rAF stalls in background tabs, so anything but a live animation
				// writes the final value synchronously
				if (!animate || reduced || document.hidden || Math.abs(to - from) < 0.01) { el.textContent = fmtH(to); return; }
				const t0 = performance.now();
				const stepFn = (now) => {
					const k = Math.min(1, (now - t0) / 300);
					const v = from + (to - from) * (k * (2 - k));
					el.textContent = fmtH(k === 1 ? to : v);
					if (k < 1) requestAnimationFrame(stepFn);
				};
				requestAnimationFrame(stepFn);
			};

			const totals = () => {
				let monthly = 0;
				let hours = 0;
				const perUse = [];
				stages.slice(0, state.stage + 1).forEach((s) =>
					s.tools.forEach((t) => {
						if (!t.soon) monthly += t.monthly || 0;
						if (t.perUse) perUse.push(t.perUse);
					}),
				);
				allTasks.forEach((t) => {
					if (!taskVisible(t)) return;
					const [kind, key] = t.fix.split(':');
					const fixed =
						(kind === 'stage' && stages.findIndex((s) => s.key === key) <= state.stage && stages.findIndex((s) => s.key === key) > 0) ||
						(kind === 'addon' && state.on.has(key));
					if (fixed) hours += back(t);
				});
				addons.forEach((a) => {
					if (addonVisible(a) && state.on.has(a.key)) monthly += a.monthly;
				});
				return { monthly, hours, perUse };
			};

			let prev = { monthly: 0, hours: 0 };
			let settleTimer = 0;
			let settledSent = false;

			const payload = () => ({
				stage: stages[state.stage].key,
				lettings: state.lettings,
				site: state.site,
				addons: [...state.on].join(',') || 'none',
				credits: totals().monthly,
			});

			const writeUrl = () => {
				if (!state.touched) return;
				try {
					const p = new URLSearchParams();
					if (state.stage > 0) p.set('st', String(state.stage));
					if (state.lettings === 'yes') p.set('let', 'y');
					if (state.site === 'yes') p.set('site', 'y');
					if (state.on.size) p.set('add', [...state.on].join(','));
					const q = p.toString();
					history.replaceState(null, '', q ? '?' + q : location.pathname);
				} catch (e) {}
			};

			const shareUrl = () => location.origin + location.pathname + (location.search || '');

			function render(reason) {
				// drop switched-on add-ons that stopped being visible (toggle flip)
				[...state.on].forEach((k) => {
					const a = addons.find((x) => x.key === k);
					if (a && !addonVisible(a)) state.on.delete(k);
				});
				// an add-on that needs another one follows it off
				addons.forEach((a) => {
					if (a.needs && state.on.has(a.key) && !state.on.has(a.needs)) state.on.delete(a.key);
				});

				slider.value = String(state.stage);
				const current = stages[state.stage];

				// the segmented buttons follow the state, so a restored URL shows
				// the toggles it encodes
				root.querySelectorAll('[data-lettings]').forEach((x) => x.classList.toggle('on', x.dataset.lettings === state.lettings));
				root.querySelectorAll('[data-site]').forEach((x) => x.classList.toggle('on', x.dataset.site === state.site));

				root.querySelector('#stageName').textContent = current.head;
				root.querySelector('[data-sub]').textContent = current.sub;
				root.querySelector('[data-stepline]').textContent =
					'Paso ' + (state.stage + 1) + ' de ' + stages.length + ' · ' + current.head;

				const activeKeys = new Set(stages.slice(0, state.stage + 1).map((s) => s.key));
				root.querySelectorAll('.toolSet').forEach((el) => {
					el.classList.toggle('on', activeKeys.has(el.dataset.stage));
				});

				root.querySelectorAll('.tick').forEach((el, i) => {
					el.classList.toggle('on', i <= state.stage);
					el.setAttribute('aria-current', i === state.stage ? 'true' : 'false');
				});
				root.querySelectorAll('[data-step]').forEach((b) => {
					const d = Number(b.dataset.step);
					b.disabled = (d < 0 && state.stage === 0) || (d > 0 && state.stage === stages.length - 1);
				});

				// add-on cards: section appears once anything is switched on at all
				root.querySelector('[data-addonwrap]').hidden = state.stage === 0;
				root.querySelectorAll('.addon').forEach((el) => {
					const a = addons.find((x) => x.key === el.dataset.addon);
					const vis = a && addonVisible(a);
					el.style.display = vis ? '' : 'none';
					const needsOff = a && a.needs && !state.on.has(a.needs);
					el.classList.toggle('locked', Boolean(needsOff));
					const sw = el.querySelector('.sw');
					sw.disabled = Boolean(needsOff);
					sw.setAttribute('aria-checked', state.on.has(el.dataset.addon) ? 'true' : 'false');
					el.classList.toggle('isOn', state.on.has(el.dataset.addon));
				});

				// the week list: strike what is fixed, tag what is not built
				let weekTotal = 0;
				root.querySelectorAll('[data-week] li').forEach((li) => {
					const t = allTasks.find((x) => x.id === li.dataset.task);
					if (!taskVisible(t)) { li.style.display = 'none'; return; }
					li.style.display = '';
					weekTotal += t.hours;
					const [kind, key] = t.fix.split(':');
					const fixEl = li.querySelector('[data-wfix]');
					if (kind === 'soon') {
						li.classList.add('soonTask');
						fixEl.textContent = key + ' · aún no construido';
						return;
					}
					const fixed =
						(kind === 'stage' && stages.findIndex((s) => s.key === key) <= state.stage) ||
						(kind === 'addon' && state.on.has(key));
					li.classList.toggle('done', fixed);
					fixEl.textContent = fixed
						? t.after > 0 ? t.hours + 'h → ' + t.after + ' min' : t.hours + 'h → 0'
						: kind === 'stage'
							? 'se arregla en ' + stages.find((s) => s.key === key).tick.toLowerCase()
							: 'se arregla con ' + (addons.find((a) => a.key === key) || {}).name;
				});
				root.querySelectorAll('[data-weektotal], [data-weektotal2]').forEach((el) => {
					el.textContent = String(weekTotal);
				});

				// the two numbers
				const t = totals();
				const anim = Boolean(reason);
				tween(root.querySelector('[data-credits]'), t.monthly, anim);
				tween(root.querySelector('[data-hours]'), t.hours, anim);
				const euro = root.querySelector('[data-euro]');
				euro.hidden = t.monthly === 0;
				euro.textContent = '1 crédito es aproximadamente 1€, así que unos ' + t.monthly + '€ al mes.';
				root.querySelector('[data-perUse]').textContent = t.perUse.length
					? 'Además, solo cuando los usas: ' + t.perUse.join('; ') + '.'
					: t.monthly === 0
						? 'Nada mensual. Nada de nada, de hecho.'
						: 'Sin pago por uso en este paso.';

				// sticky bar
				root.querySelector('[data-bar-c]').textContent = String(t.monthly);
				root.querySelector('[data-bar-h]').textContent = fmtH(t.hours);
				const barE = root.querySelector('[data-bar-e]');
				barE.hidden = t.monthly === 0;
				barE.textContent = '~' + t.monthly + '€';
				if (reason && !reduced) {
					const bar = root.querySelector('[data-bar]');
					bar.classList.remove('pulse');
					void bar.offsetWidth;
					bar.classList.add('pulse');
				}

				// the delta line: say what this interaction just did
				const deltaEl = root.querySelector('[data-delta]');
				if (reason) {
					const dc = t.monthly - prev.monthly;
					const dh = t.hours - prev.hours;
					const bits = [];
					if (dc !== 0) bits.push((dc > 0 ? '+' : '−') + Math.abs(dc) + ' créditos al mes');
					if (Math.abs(dh) >= 0.05) bits.push((dh > 0 ? '+' : '−') + fmtH(Math.abs(dh)) + ' h a la semana');
					if (reason.type === 'stage') {
						deltaEl.textContent = reason.dir > 0
							? current.head + (bits.length ? ': ' + bits.join(', ') : ': nada mensual')
							: 'Vuelta a ' + current.head.toLowerCase() + (bits.length ? ': ' + bits.join(', ') : '');
					} else if (reason.type === 'addon') {
						deltaEl.textContent = (reason.on ? 'Añadido ' : 'Quitado ') + reason.name + (bits.length ? ': ' + bits.join(', ') : '');
					} else {
						deltaEl.textContent = bits.length ? bits.join(', ') : '';
					}
				}
				prev = { monthly: t.monthly, hours: t.hours };

				// stage-aware CTA
				const ctaLine = root.querySelector('[data-ctaline]');
				const cta = root.querySelector('[data-cta]');
				if (state.stage === 0 && state.on.size === 0) {
					cta.hidden = true;
					ctaLine.textContent = 'Desliza a la derecha para ver qué activa el núcleo gratis.';
				} else {
					cta.hidden = false;
					ctaLine.textContent =
						t.monthly > 0
							? 'Todo lo mensual se apaga el mes que dejas de quererlo.'
							: state.stage >= 2
								? 'Tus 5 primeros leads de compradores son gratis.'
								: 'Todo en este paso es gratis. Sin tarjeta.';
				}

				// the receipt
				const lines = [];
				if (state.stage >= 1) lines.push(['El núcleo gratis', 'Gratis']);
				stages.slice(0, state.stage + 1).forEach((s) =>
					s.tools.forEach((tl) => {
						if (!tl.soon && tl.monthly > 0) lines.push([tl.name, tl.monthly + ' cr']);
					}),
				);
				addons.forEach((a) => {
					if (addonVisible(a) && state.on.has(a.key)) lines.push([a.name, a.monthly + ' cr']);
				});
				const rl = root.querySelector('[data-rlines]');
				if (!lines.length) {
					rl.innerHTML = '<p class="rEmpty">Nada activado todavía. Desliza a la derecha para montar una.</p>';
				} else {
					let html = lines
						.map(([n, p]) => '<p class="rLine"><span>' + n + '</span><span class="rDots"></span><span>' + p + '</span></p>')
						.join('');
					html += '<p class="rLine rTot"><span>Total al mes</span><span class="rDots"></span><span>' + t.monthly + ' cr' + (t.monthly > 0 ? ' (~' + t.monthly + '€)' : '') + '</span></p>';
					if (t.perUse.length) {
						html += '<p class="rSub">Solo cuando lo usas:</p>';
						html += t.perUse.map((x) => '<p class="rPer">· ' + x + '</p>').join('');
					}
					if (t.hours >= 0.05) {
						html += '<p class="rLine rBack"><span>Devueltas</span><span class="rDots"></span><span>' + fmtH(t.hours) + ' h a la semana</span></p>';
					}
					rl.innerHTML = html;
				}
				root.querySelector('[data-share-wa]').hidden = !lines.length;
				root.querySelector('[data-share-copy]').hidden = !lines.length;

				writeUrl();

				// research: the configuration the viewer settles on, not every drag
				settledSent = false;
				clearTimeout(settleTimer);
				if (state.touched) {
					settleTimer = setTimeout(() => {
						settledSent = true;
						track('setup-settled', payload());
					}, 5000);
				}
			}

			slider.addEventListener('input', () => {
				const next = Number(slider.value);
				const dir = next - state.stage;
				state.stage = next;
				state.touched = true;
				track('setup-stage', { stage: stages[next].key });
				render({ type: 'stage', dir });
			});
			root.querySelectorAll('.tick').forEach((b) =>
				b.addEventListener('click', () => {
					const next = Number(b.dataset.goto);
					const dir = next - state.stage;
					if (dir === 0) return;
					state.stage = next;
					state.touched = true;
					track('setup-stage', { stage: stages[next].key, via: 'tick' });
					render({ type: 'stage', dir });
				}),
			);
			root.querySelectorAll('[data-step]').forEach((b) =>
				b.addEventListener('click', () => {
					const next = Math.max(0, Math.min(stages.length - 1, state.stage + Number(b.dataset.step)));
					if (next === state.stage) return;
					const dir = next - state.stage;
					state.stage = next;
					state.touched = true;
					track('setup-stage', { stage: stages[next].key, via: 'step' });
					render({ type: 'stage', dir });
				}),
			);
			root.querySelectorAll('[data-lettings]').forEach((b) =>
				b.addEventListener('click', () => {
					state.lettings = b.dataset.lettings;
					state.touched = true;
					root.querySelectorAll('[data-lettings]').forEach((x) => x.classList.toggle('on', x === b));
					track('setup-toggle', { which: 'lettings', v: state.lettings });
					render({ type: 'toggle' });
				}),
			);
			root.querySelectorAll('[data-site]').forEach((b) =>
				b.addEventListener('click', () => {
					state.site = b.dataset.site;
					state.touched = true;
					root.querySelectorAll('[data-site]').forEach((x) => x.classList.toggle('on', x === b));
					track('setup-toggle', { which: 'site', v: state.site });
					render({ type: 'toggle' });
				}),
			);
			root.querySelectorAll('[data-sw]').forEach((b) =>
				b.addEventListener('click', () => {
					const key = b.dataset.sw;
					const a = addons.find((x) => x.key === key);
					const on = !state.on.has(key);
					if (on) state.on.add(key); else state.on.delete(key);
					state.touched = true;
					track('setup-addon', { key, on: on ? 'yes' : 'no' });
					render({ type: 'addon', name: a.name, on });
				}),
			);

			// tapping a job jumps to what fixes it. Never switches an add-on on:
			// it shows you the switch and lets you decide.
			root.querySelectorAll('.wJump').forEach((b) =>
				b.addEventListener('click', () => {
					const [kind, key] = b.dataset.jump.split(':');
					const li = b.closest('li');
					track('setup-pain-jump', { task: li.dataset.task });
					if (kind === 'stage') {
						const idx = stages.findIndex((s) => s.key === key);
						if (idx > state.stage) {
							const dir = idx - state.stage;
							state.stage = idx;
							state.touched = true;
							render({ type: 'stage', dir });
						}
					} else if (kind === 'addon') {
						if (state.stage === 0) { state.stage = 1; state.touched = true; render({ type: 'stage', dir: 1 }); }
						const card = root.querySelector('.addon[data-addon="' + key + '"]');
						if (card && card.style.display !== 'none') {
							card.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
							card.classList.remove('flash');
							void card.offsetWidth;
							card.classList.add('flash');
						}
					}
				}),
			);

			root.querySelector('[data-bar]').addEventListener('click', () => {
				root.querySelector('.meter').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
				track('setup-bar-tap', {});
			});

			root.querySelector('[data-share-wa]').addEventListener('click', () => {
				const t = totals();
				track('setup-share', { via: 'whatsapp', credits: t.monthly });
				const msg =
					t.monthly > 0
						? 'Mi configuración de PropertyList: ' + t.monthly + ' créditos al mes (~' + t.monthly + '€), ' + fmtH(t.hours) + ' horas a la semana devueltas. Montada aquí: ' + shareUrl()
						: 'Solo el núcleo gratis de PropertyList ya devuelve ' + fmtH(t.hours) + ' horas a la semana. Míralo: ' + shareUrl();
				window.open('https://wa.me/?text=' + encodeURIComponent(msg), '_blank', 'noopener');
			});
			root.querySelector('[data-share-copy]').addEventListener('click', (e) => {
				track('setup-share', { via: 'copy', credits: totals().monthly });
				if (navigator.clipboard) navigator.clipboard.writeText(shareUrl());
				e.target.textContent = 'Copiado';
				setTimeout(() => { e.target.textContent = 'Copiar enlace'; }, 1600);
			});
			['[data-cta]', '[data-cta2]'].forEach((sel) =>
				root.querySelector(sel).addEventListener('click', () => track('setup-cta', payload())),
			);
			addEventListener('pagehide', () => {
				if (state.touched && !settledSent) track('setup-settled', payload());
			});

			render(null);
			// restoring a shared link should land the viewer on their setup
			if (state.touched && (state.stage > 0 || state.on.size)) {
				root.querySelector('.board').scrollIntoView({ behavior: 'auto', block: 'start' });
			}
		}
	</script>
</Layout>

<style>
	.wrap { max-width: 1040px; margin: 0 auto; padding: 0 20px 72px; }
	.intro { padding: 44px 0 10px; }
	.kicker { font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--pl-accent); margin: 0 0 10px; }
	h1 { font-size: clamp(30px, 5vw, 46px); line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 16px; }
