	.sliderLine { display: flex; align-items: center; gap: 10px; }
	.slider { flex: 1 1 auto; width: 100%; accent-color: var(--pl-accent); height: 26px; }
	.step { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(16, 24, 40, 0.14); background: #fff; font-size: 22px; line-height: 1; font-weight: 800; color: #0a6d61; cursor: pointer; }
