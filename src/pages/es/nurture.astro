---
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';

// Espejo en español de /nurture/ (reconstruida 09-10-26). Misma sustancia, nueva forma: capas, tarjeta de contacto
// dibujada en código en la cabecera y una tarjeta de plan con todo lo incluido. Precio según el ledger free-vs-paid:
// Automation y Nurture gratis desde 16-09-26 (decir "gratis", nunca "gratis para siempre").
const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/nurture/`;
const title = 'Nurture: mantén a cada cliente antiguo, en automático | PropertyList';
const description =
	'Clientes antiguos y compradores que se enfriaron siguen en contacto solos, y avisamos en cuanto uno está listo. Gratis, y nada sale hasta que lo actives.';

const stats = await getPortalStats();
const plAgents = statPlus(stats.agents, 'es');
const plAgencies = statPlus(stats.agencies, 'es');
const signup = 'https://agents.propertylist.es/new_agency/new?locale=es';
const guide = '/es/docs/propertylist-mls-manual-de-usuario/pipeline-and-tasks/nurture/';

const owed = [
	['El cliente de hace cuatro años.', 'Te compró a ti. Cuando venda, llamará a quien haya sabido de él más recientemente. Muchas veces es la agencia que le mandó una actualización de mercado, no la que le dio las llaves.'],
	['El comprador que se enfrió.', 'En marzo se le cayó la financiación. En octubre vuelve a ser comprador, con entrada y con la hipoteca aprobada, y ya es cliente de otro.'],
	['El propietario al que nunca llamaste.', 'Los propietarios en alquiler vuelven a comprar, recomiendan a otros propietarios y acaban vendiendo. Con ellos nunca hay prisa, así que es fácil perder el contacto.'],
];

const askNothing = [
	['Cumpleaños', 'El suyo y el de su pareja.'],
	['El día que firmaron', 'Una nota en el aniversario.'],
	['Navidad', 'Con tu nombre.'],
	['Una petición de recomendación', 'Mientras la buena experiencia sigue fresca.'],
];

const nextDeal = [
	['Propietarios de vivienda', 'Una valoración anual honesta de su propia casa.'],
	['Inversores', 'Cuánto vale su cartera y por cuánto se alquilan hoy pisos parecidos.'],
	['Propietarios en alquiler', 'Rentabilidad, cambios normativos y un análisis de renovar, realquilar o vender en cada renovación.'],
	['Inquilinos de larga duración', 'Una comparación tranquila entre su renta y una hipoteca.'],
];

const watches = ['Un clic en un enlace de valoración.', 'Una respuesta.', 'El mismo email de "¿estás pensando en vender?" abierto tres veces en una semana.'];
const outcome = ['Los emails automáticos de esa persona se paran.', 'Se le etiqueta como Caliente.', 'Una llamada sube al principio de tu Cola de Acciones Diarias, con el motivo en la tarjeta.'];

const control = [
	'Un email por contacto y semana, esté en las secuencias que esté. Si coinciden dos la misma semana, gana el personal.',
	'El consentimiento se registra por contacto y se respetan las bajas. Quien se da de baja sigue en el tablero y no recibe nada.',
	'Cada contacto tiene un historial de lo enviado y lo siguiente. Puedes leerlo, editarlo o saltarte cualquier cosa.',
	'Desactívalo para una sola persona, o para un tipo de email, cuando sabes algo que el sistema no sabe.',
	'Quien se detecta como otro agente queda fuera de todo, así que una valoración nunca llega a un agente colaborador.',
	'Los emails salen en el idioma que el cliente eligió cuando se ganó la operación.',
];

const included = [
	'El pipeline de Nurture, que llena cada operación que ganas',
	'Emails de cumpleaños, aniversario y Navidad con tu nombre',
	'Una nota de valoración anual para propietarios de vivienda',
	'Notas de cartera y renta para inversores, y de renovación para propietarios en alquiler',
	'Notas de renta frente a hipoteca para inquilinos de larga duración',
	'Detección de interés y etiqueta Caliente',
	'La Cola de Acciones Diarias, con el motivo en la tarjeta',
	'Como mucho, un email por contacto y semana',
	'Registro de consentimiento y bajas por contacto',
	'Otros agentes excluidos de forma automática',
	'Emails en el idioma de cada cliente',
	'Un contador de lo que habría salido, antes de activarlo',
];

const faqs = [
	['¿Qué cuesta?', 'Nada. Nurture forma parte de Automation y Nurture, que es gratis. Incluye el pipeline de Nurture, todos los emails automáticos, la detección de contactos Caliente y la Cola de Acciones Diarias. Es un solo producto, así que no hay nada que configurar ni añadir.'],
	['¿Va a enviar cosas que me den vergüenza?', 'Puedes ver cada email antes de que salga. Cada contacto tiene un historial de lo enviado y lo programado, y todo lo pendiente se puede leer, editar o saltar. Nadie recibe más de un email por semana, los contactos marcados como agentes quedan excluidos del todo, y puedes desactivar a una persona por completo sin sacarla del tablero.'],
	['¿De dónde sale la información?', 'Del momento en que se gana la operación. El sistema pide la fecha de firma, los cumpleaños, si van a vivir allí o es inversión, el idioma que prefieren y el consentimiento de marketing. Eso es lo que hace que los emails sean concretos y no genéricos. Si falta algo, te lo pide en vez de inventarlo.'],
	['¿Qué pasa cuando alguien muestra interés?', 'Los emails automáticos de ese contacto se paran, se le etiqueta como Caliente, y una llamada sube al principio de tu Cola de Acciones Diarias con el motivo delante, por ejemplo que ha abierto tres veces esta semana un email de valoración. Un contacto que vuelve a ti desde Nurture nunca cuesta un crédito.'],
	['¿Qué pasa antes de activarlo?', 'El tablero se llena igual. Cada operación ganada coloca al contacto en él y los datos se recogen igual, pero no se envía nada, y un contador te muestra lo que ese mes habría salido. Cuando lo actives, arranca con todo lo que lleva recogido y no desde una pantalla vacía.'],
];

const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const breadcrumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
	{ '@type': 'ListItem', position: 1, name: 'Inicio', item: `${origin}/es/` },
	{ '@type': 'ListItem', position: 2, name: 'Funciones', item: `${origin}/es/funciones/` },
	{ '@type': 'ListItem', position: 3, name: 'Nurture', item: canonical },
] };
---
<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	ogImage="https://info.propertylist.es/og/og-nurture-es.jpg"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: `${origin}/nurture/` },
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'x-default', href: `${origin}/nurture/` },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<section class="hero"><div class="cx heroGrid">
		<div>
			<p class="kicker">Automation y Nurture</p>
			<h1>Tu base de datos es tu <b>jubilación.</b></h1>
			<p class="lead">Ya conoces a cientos de compradores, vendedores y propietarios. Algunos se mudan este año. <strong>Nurture mantiene el contacto con todos ellos sin ti, y te avisa en cuanto uno está listo.</strong></p>
			<p class="ctaRow"><a class="btn" href={signup} target="_blank" rel="noopener">Crea tu cuenta de agencia gratis</a> <a class="btnLink" href="#que-cuesta">Ver todo lo que incluye</a></p>
			<p class="fric">{plAgencies} agencias y {plAgents} agentes ya están en la red. Nurture es gratis, y el tablero se llena antes de que actives nada.</p>
		</div>
		<figure class="nFig">
			<div class="ncard" role="group" aria-label="Ejemplo de contacto en Nurture">
				<div class="ncTop">
					<div><b>Cliente antiguo, compró contigo</b><span>Nueva Andalucía, operación ganada en mayo de 2022</span></div>
					<div class="tags"><span class="tg">Nurture</span><span class="tg hot">Caliente</span></div>
				</div>
				<p class="ncLabel">Enviado con tu nombre, como mucho uno por semana</p>
				<ol class="tl">
					<li><b>ago 2022</b>Cumpleaños</li>
					<li><b>may 2023</b>Un año desde la firma</li>
					<li><b>dic 2024</b>Navidad</li>
					<li class="hotDot"><b>may 2026</b>Valoración anual</li>
				</ol>
				<p class="ncSent">4 emails en cuatro años, todos con tu nombre.</p>
				<div class="paused">Emails automáticos en pausa para este contacto.</div>
				<div class="queue"><span class="qTag">Lo primero de la cola</span><b>Llámale hoy</b><span>Ha abierto tres veces esta semana el email de valoración. Cuatro años desde que le diste las llaves.</span></div>
			</div>
			<figcaption>Una ilustración de un contacto en Nurture, no una grabación del CRM.</figcaption>
		</figure>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Las operaciones que <b>ya te has ganado.</b></h2>
		<p class="sub">Nadie las pierde a propósito. Se enfrían semana a semana, mientras estás con la operación que tienes delante.</p>
		<div class="steps">
			{owed.map(([h, p]) => (<div class="step"><h3>{h}</h3><p>{p}</p></div>))}
		</div>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>Funciona con fechas <b>que ya tienes.</b></h2>
		<p class="sub">Cuando se gana una operación se te piden la fecha de firma, los cumpleaños, si van a vivir allí o es inversión, y su idioma. No hay nada más que configurar. Los contratos que pasan a activo en el <a href="/es/alquileres/">Módulo de Alquileres</a> también entran aquí.</p>
		<h3 class="groupH">Emails que no piden nada</h3>
		<div class="asks four">
			{askNothing.map(([h, p]) => (<div>{h}<span>{p}</span></div>))}
		</div>
		<h3 class="groupH">Emails que encuentran la siguiente operación</h3>
		<div class="asks four">
			{nextDeal.map(([h, p]) => (<div>{h}<span>{p}</span></div>))}
		</div>
	</div></section>

	<section class="band dark"><div class="cx">
		<h2>La parte que da dinero: <b>sabe cuándo parar.</b></h2>
		<div class="intent">
			<div><h3>Lo que vigila</h3><ul>{watches.map((w) => <li>{w}</li>)}</ul></div>
			<div><h3>Lo que pasa después</h3><ul>{outcome.map((w) => <li>{w}</li>)}</ul></div>
		</div>
		<p class="alt"><b>Un contacto que vuelve a ti desde Nurture nunca cuesta un crédito.</b></p>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Míralo funcionar <b>antes de activarlo.</b></h2>
		<p class="sub">El tablero se llena igual. Cada operación ganada entra, las fechas de firma y los cumpleaños se recogen, y un contador te muestra lo que ese mes habría salido. No sale nada hasta que tú decides, y cuando lo activas arranca con todo lo que lleva recogido.</p>
		<p class="pills"><span>No se envía nada sin tu permiso</span><span>Arranca ya cargado</span></p>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>Tú controlas <b>cada mensaje.</b></h2>
		<p class="sub">La automatización solo merece la pena si estás tranquilo con que un cliente te la lea entera.</p>
		<ul class="auto">
			{control.map((c) => <li>{c}</li>)}
		</ul>
	</div></section>

	<section class="band tint" id="que-cuesta"><div class="cx costGrid">
		<div class="plan">
			<p class="planName">Automation y Nurture</p>
			<p class="planPrice">Gratis</p>
			<p class="planNote">Un solo producto, sin nada que añadir.</p>
			<ul class="checks">
				{included.map((i) => <li>{i}</li>)}
			</ul>
			<p class="planFoot">Un contacto que vuelve a ti desde Nurture nunca se cobra.</p>
			<a class="btn" href={signup} target="_blank" rel="noopener">Crea tu cuenta de agencia gratis</a>
		</div>
		<div>
			<h2>Lo alimentan tus pipelines. <b>La mayoría son gratis.</b></h2>
			<p class="sub">Cada operación que cierras entra en Nurture, actives o no el seguimiento. Leads, Sellers y Property son gratis y sin límite.</p>
			<p class="sub">Un lead que pasas al pipeline de Buyer cuesta 1 crédito, y los 5 primeros son gratis. El pipeline de Tenants viene con el Módulo de Alquileres, 50 créditos cada 30 días. Un contacto que vuelve a ti desde Nurture nunca cuesta un crédito.</p>
			<p class="sub">Cuanto más lleves tu agencia aquí, más valor tiene tu base de datos, y es tuya de todas formas.</p>
			<p class="links"><a href="/es/pipelines/">Ver los seis pipelines</a> <a href="/es/precios/">Todos los precios</a> <a href={guide}>Guía de configuración</a></p>
		</div>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>Antes de que preguntes.</h2>
		<div class="faqwrap">
			{faqs.map(([q, a]) => (<details class="faqItem"><summary>{q}</summary><p>{a}</p></details>))}
		</div>
	</div></section>

	<section class="band close"><div class="cx">
		<h2>Los clientes que ya tienes son los más baratos que <b>volverás a ganar.</b></h2>
		<p class="alt">Publicar en el MLS, los pipelines de Leads, Sellers y Property que alimentan Nurture, y el propio Nurture son gratis. Activa el seguimiento cuando quieras.</p>
		<a class="btn btnLight" href={signup} target="_blank" rel="noopener">Crea tu cuenta de agencia gratis</a>
		<p class="dev">¿Quieres el detalle primero? <a href={guide}>Lee la guía de Nurture</a>.</p>
	</div></section>
</Layout>

<style>
	.cx { width: min(1120px, 100% - 32px); margin: 0 auto; }
	.hero { padding: 28px 0 44px; }
	.heroGrid { display: grid; gap: 32px; align-items: center; }
	.kicker { font-size: 17px; font-weight: 700; color: #0a6d61; margin: 0 0 14px; }
	h1 { font-size: 44px; line-height: 1.04; letter-spacing: -0.03em; font-weight: 800; margin: 0; }
	h1 b, h2 b { color: #008a7a; }
	.lead { font-size: 19px; line-height: 1.5; color: #28383f; margin: 18px 0 24px; max-width: 40ch; }
	.lead strong { color: #0b1b22; }
	.btn { display: inline-block; background: #0a6d61; color: #fff; font-weight: 800; font-size: 18px; padding: 16px 24px; border-radius: 14px; text-decoration: none; }
	.btn:hover { background: #08584e; }
	.btnLink { display: inline-block; margin: 0; font-weight: 700; color: #0a6d61; text-decoration: underline; text-underline-offset: 3px; }
	.ctaRow { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
	.band[id] { scroll-margin-top: 72px; }
	.fric { font-size: 15px; color: #5b6b73; margin: 12px 0 0; max-width: 52ch; }
	.nFig { margin: 0; }
	.nFig figcaption { font-size: 13px; color: #5b6b73; margin: 10px 0 0; text-align: center; }
	.ncard { background: #fff; border: 1px solid #f2b8b0; border-radius: 18px; padding: 18px; box-shadow: 0 24px 50px rgba(11, 27, 34, 0.12); max-width: 480px; margin: 0 auto; }
	.ncTop { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
	.ncTop b { display: block; font-size: 17px; }
	.ncTop span { font-size: 13px; color: #5b6b73; }
	.tags { display: flex; gap: 6px; flex-shrink: 0; }
	.tg { font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 999px; background: #e6f7f4; color: #0a6d61; }
	.tg.hot { background: #fde8e5; color: #b4232a; }
	.ncLabel { font-size: 12px; font-weight: 700; color: #5b6b73; margin: 16px 0 8px; }
	.tl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; position: relative; }
	.tl::before { content: ''; position: absolute; left: 6px; right: 6px; top: 6px; height: 2px; background: #00ae9a; }
	.tl li { position: relative; padding-top: 18px; font-size: 12px; color: #28383f; }
	.tl li::before { content: ''; position: absolute; left: 0; top: 0; width: 14px; height: 14px; border-radius: 50%; background: #00ae9a; border: 2px solid #fff; box-sizing: border-box; }
	.tl li.hotDot::before { background: #b4232a; }
	.tl li b { display: block; font-size: 12px; color: #0b1b22; }
	.ncSent { font-size: 13px; color: #5b6b73; margin: 12px 0 10px; }
	.paused { background: #fdecea; border: 1px solid #f2b8b0; color: #b4232a; font-size: 13px; font-weight: 700; padding: 9px 12px; border-radius: 10px; }
	.queue { margin-top: 10px; border-left: 4px solid #b4232a; background: #fbfbfa; border-radius: 10px; padding: 10px 12px; }
	.queue b { display: block; font-size: 16px; margin-top: 4px; }
	.queue span:last-child { font-size: 13px; color: #3d4a4f; }
	.qTag { font-size: 11px; font-weight: 800; color: #b4232a; }
	.band { padding: 44px 0; border-top: 1px solid #e7eef1; background: #fff; }
	.soft { background: #f4f7f8; }
	.tint { background: #e6f7f4; }
	h2 { font-size: 32px; line-height: 1.1; letter-spacing: -0.025em; font-weight: 800; margin: 0; max-width: 22ch; }
	.sub { font-size: 17px; line-height: 1.5; color: #28383f; margin: 10px 0 0; max-width: 56ch; }
	.sub a { color: #0a6d61; font-weight: 700; }
	.steps { display: grid; gap: 22px; margin-top: 26px; }
	.step { padding-top: 14px; border-top: 3px solid #00ae9a; }
	.step h3 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 0; }
	.step p { margin: 6px 0 0; color: #28383f; max-width: 38ch; }
	.groupH { font-size: 20px; font-weight: 800; margin: 28px 0 0; }
	.asks { display: grid; gap: 10px; margin-top: 14px; }
	.asks div { background: #fff; border: 1px solid #dfe6e8; border-radius: 14px; padding: 14px 16px; font-weight: 700; font-size: 17px; }
	.asks div span { display: block; font-weight: 500; color: #3d4a4f; font-size: 15px; margin-top: 4px; }
	.dark { background: #0b1b22; color: #fff; border-top: 0; }
	.dark h2 b { color: #7deede; }
	.intent { display: grid; gap: 22px; margin-top: 24px; }
	.intent h3 { font-size: 15px; font-weight: 800; color: #7deede; margin: 0 0 10px; }
	.intent ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
	.intent li { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 12px; padding: 12px 14px; font-size: 17px; line-height: 1.4; }
	.alt { margin: 22px 0 0; color: #c9d6da; font-size: 17px; max-width: 56ch; }
	.alt b { color: #fff; }
	.pills { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0 0; }
	.pills span { background: #e6f7f4; color: #0a6d61; font-weight: 800; font-size: 15px; padding: 8px 14px; border-radius: 999px; }
	.auto { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 12px; }
	.auto li { padding: 0 0 0 30px; position: relative; font-size: 17px; line-height: 1.45; color: #0b1b22; max-width: 60ch; }
	.auto li::before { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: #00ae9a; }
	.costGrid { display: grid; gap: 32px; align-items: start; }
	.plan { background: #fff; border: 2px solid #00ae9a; border-radius: 20px; padding: 24px; box-shadow: 0 24px 50px rgba(11, 27, 34, 0.1); }
	.planName { font-size: 15px; font-weight: 800; color: #0a6d61; margin: 0; }
	.planPrice { font-size: 52px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; margin: 8px 0 4px; }
	.planNote { font-size: 15px; color: #5b6b73; margin: 0 0 16px; }
	.checks { list-style: none; margin: 0 0 16px; padding: 16px 0 0; border-top: 1px solid #dfe6e8; display: grid; gap: 9px; }
	.checks li { position: relative; padding-left: 28px; font-size: 16px; line-height: 1.4; }
	.checks li::before { content: ''; position: absolute; left: 0; top: 2px; width: 18px; height: 18px; border-radius: 50%; background: #e6f7f4; }
	.checks li::after { content: ''; position: absolute; left: 6px; top: 5px; width: 5px; height: 9px; border: solid #0a6d61; border-width: 0 2px 2px 0; transform: rotate(45deg); }
	.planFoot { font-size: 15px; font-weight: 700; color: #0b1b22; margin: 0 0 18px; }
	.links { display: flex; flex-wrap: wrap; gap: 18px; margin: 18px 0 0; }
	.links a { color: #0a6d61; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
	.faqwrap { margin-top: 20px; }
	.faqItem { border-top: 1px solid #e7eef1; padding: 14px 0; }
	.faqItem:last-child { border-bottom: 1px solid #e7eef1; }
	.faqItem summary { font-weight: 800; font-size: 19px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
	.faqItem summary::-webkit-details-marker { display: none; }
	.faqItem summary::after { content: '+'; color: #008a7a; font-size: 26px; line-height: 1; }
	.faqItem[open] summary::after { content: '-'; }
	.faqItem p { margin: 10px 0 0; color: #28383f; max-width: 60ch; }
	.close { background: #0b1b22; color: #fff; border-top: 0; }
	.close h2 { max-width: 24ch; }
	.close h2 b { color: #7deede; }
	.btnLight { background: #00ae9a; color: #0b1b22; margin-top: 22px; }
	.btnLight:hover { background: #2fe3cb; }
	.dev { margin: 18px 0 0; font-size: 14px; color: #8fa0a6; }
	.dev a { color: #c9d6da; }
	@media (min-width: 900px) {
		h1 { font-size: 68px; }
		.lead { font-size: 22px; }
		.hero { padding: 48px 0 64px; }
		.heroGrid { grid-template-columns: 1.05fr 1fr; gap: 48px; }
		h2 { font-size: 44px; }
		.steps { grid-template-columns: repeat(3, 1fr); gap: 32px; }
		.asks.four { grid-template-columns: repeat(4, 1fr); }
		.intent { grid-template-columns: 1fr 1fr; gap: 32px; }
		.auto { grid-template-columns: repeat(2, 1fr); gap: 14px 32px; }
		.costGrid { grid-template-columns: 1fr 1.1fr; gap: 56px; }
