---
import Layout from '../../../../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../../../../lib/directus';

const base = '/es/docs/leyes-procedimientos/';
const baseEn = '/docs/laws-procedures/';
const strictEs = true;
const itemsEs = await listKbPagesByPrefix({ prefix: base, lang: 'es', limit: 2000 });
const itemsEn = strictEs ? [] : await listKbPagesByPrefix({ prefix: baseEn, lang: 'en', limit: 2000 });
const esByRest = new Map(itemsEs.map((p) => [p.path.startsWith(base) ? p.path.slice(base.length) : p.path, p]));
const items = strictEs
	? itemsEs
	: itemsEn.map((p) => {
			const rest = p.path.startsWith(baseEn) ? p.path.slice(baseEn.length) : p.path;
			const es = esByRest.get(rest);
			return {
				...p,
				title: es?.title || p.title,
				description: es?.description || p.description,
				path: `${base}${rest}`,
			};
		});

const toSeg = (path: string) => {
	const rest = path.startsWith(base) ? path.slice(base.length) : path;
	const parts = rest.split('/').filter(Boolean);
	return { seg: parts[0] || '', depth: parts.length };
};

const titleCase = (s: string) => s.replace(/[_-]+/g, ' ').replace(/\b\w/g, (m) => m.toUpperCase());

const segmentLabels: Record<string, string> = {
	'listing-a-property-what-to-know': 'Publicar una propiedad: lo que debes saber',
	'buying-a-property': 'Comprar una propiedad',
	'selling-a-property': 'Vender una propiedad',
	'renovating-a-property': 'Reformar una propiedad',
	'building-a-property': 'Construir una propiedad',
	'renting-a-property': 'Alquilar una propiedad',
	'traspaso-business-transfer': 'Traspaso de negocio',
	'property-taxes-in-andalucia': 'Impuestos sobre la propiedad en Andalucía',
	'inheritance-laws-in-andalucia': 'Herencias en Andalucía',
	'property-insurance-in-andalucia': 'Seguros de hogar en Andalucía',
};

const segmentDescriptions: Record<string, string> = {
	'listing-a-property-what-to-know': 'Qué preparar antes de sacar una propiedad al mercado.',
	'buying-a-property': 'Guías para compradores: comprobaciones, contratos y plazos.',
	'selling-a-property': 'Guías para vendedores: papeleo, proceso y costes.',
	'renovating-a-property': 'Reformas: normativa, cumplimiento y pasos prácticos.',
	'building-a-property': 'Obra nueva: licencias, normativa y planificación del proyecto.',
	'renting-a-property': 'Alquileres: obligaciones del propietario, derechos del inquilino e impuestos.',
	'traspaso-business-transfer': 'El traspaso: cómo funciona y qué conviene comprobar.',
	'property-taxes-in-andalucia': 'Impuestos y costes recurrentes de tener una propiedad.',
	'inheritance-laws-in-andalucia': 'Herencias: pasos legales y errores frecuentes.',
	'property-insurance-in-andalucia': 'Tipos de seguro, coberturas y qué preguntar.',
};

const segLabel = (s: string) => segmentLabels[s] || titleCase(s);

const grouped = new Map<string, typeof items>();
const segMeta = new Map<string, { count: number; hasChildren: boolean }>();

for (const p of items) {
	const { seg, depth } = toSeg(p.path);
	if (!seg) continue;
	const list = grouped.get(seg) || [];
	list.push(p);
	grouped.set(seg, list);
	const meta = segMeta.get(seg) || { count: 0, hasChildren: false };
	meta.count += 1;
	if (depth > 1) meta.hasChildren = true;
	segMeta.set(seg, meta);
}

const segments = [...grouped.keys()].sort((a, b) => a.localeCompare(b));
const categorySegs = segments.filter((s) => {
	const meta = segMeta.get(s);
	if (!meta) return false;
	return meta.count > 1 || meta.hasChildren;
});
const singlePages = segments
	.filter((s) => !categorySegs.includes(s))
	.map((s) => grouped.get(s)?.[0])
	.filter(Boolean);

const decodeHtmlEntities = (s: string) =>
	s
		.replaceAll('&amp;', '&')
		.replaceAll('&quot;', '"')
		.replaceAll('&#39;', "'")
		.replaceAll('&lt;', '<')
		.replaceAll('&gt;', '>')
		.replaceAll('&nbsp;', ' ');

const stripSuffix = (t: string) => t.replace(/\s*•\s*PropertyList Info Hub\s*$/i, '').trim();
const cleanTitle = (t: string) => decodeHtmlEntities(stripSuffix(t)).trim();
---

<Layout
	lang="es"
	title="Docs Leyes y Procedimientos • PropertyList Info Hub"
	description="Guías sobre leyes, procedimientos, impuestos, alquileres y normas inmobiliarias en España."
	canonical="https://info.propertylist.es/es/docs/leyes-procedimientos/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/docs/laws-procedures/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/docs/leyes-procedimientos/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/docs/laws-procedures/' },
	]}
>
	<h1>LEYES Y PROCEDIMIENTOS</h1>
	<p class="sub">Guías sobre leyes, trámites, impuestos, alquileres y normativa inmobiliaria en España. Explora por tema o empieza con las guías populares.</p>

	{singlePages.length ? (
		<section class="popular">
			<h2>Guías populares</h2>
			<div class="rows">
				{singlePages.slice(0, 8).map((p) => (
					<a class="row" href={p!.path}>
						<div class="rowTitle">{cleanTitle(p!.title)}</div>
					</a>
				))}
			</div>
		</section>
	) : null}

	{categorySegs.length ? (
		<div class="grid">
			{categorySegs.map((seg) => {
				const list = grouped.get(seg) || [];
				const viewAllHref = `${base}${seg}/`;
				const listItems = list.filter((p) => p.path !== viewAllHref).slice(0, 8);
				return (
					<section class="card">
						<div class="cardHeader">
							<h3>{segLabel(seg)}</h3>
							{segmentDescriptions[seg] ? <p class="rowDesc">{segmentDescriptions[seg]}</p> : null}
						</div>
						{listItems.length ? (
							<ul class="mini">
								{listItems.map((p) => (
									<li>
										<a class="miniRow" href={p.path}>
											<span class="miniRowTitle">{cleanTitle(p.title)}</span>
										</a>
									</li>
								))}
							</ul>
						) : (
							<div class="emptySmall">Aún no hay páginas.</div>
						)}
						{list.length ? (
							<div class="cardFooter">
								<a class="cardAction" href={viewAllHref}>
									Ver todo
								</a>
								<span class="cardMeta">{Math.max(0, list.length - 1)} guías</span>
							</div>
						) : null}
					</section>
				);
			})}
		</div>
	) : items.length ? (
		<section class="popular">
			<h2>Todas las guías</h2>
			<div class="rows">
				{items.slice(0, 24).map((p) => (
					<a class="row" href={p.path}>
						<div class="rowTitle">{cleanTitle(p.title)}</div>
					</a>
				))}
			</div>
		</section>
	) : (
		<div class="empty">Aún no hay documentación.</div>
	)}
</Layout>

<style>
	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.03em;
	}

	.sub {
		margin: 0 0 18px;
		color: rgba(16, 24, 40, 0.7);
	}

	h2 {
		margin: 0 0 12px;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.popular {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
		margin-bottom: 14px;
	}

	.rows {
		display: grid;
		gap: 10px;
	}

	.row {
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 14px;
		padding: 12px 14px;
		text-decoration: none;
	}

	.row:hover {
		text-decoration: none;
		border-color: rgba(0, 174, 154, 0.35);
	}

	.rowTitle {
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.rowDesc {
		margin-top: 6px;
		color: rgba(16, 24, 40, 0.7);
		font-size: 14px;
		line-height: 1.4;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.card {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
		display: flex;
		flex-direction: column;
	}

	.cardHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 10px;
	}

	.cardHeader h3 {
		margin: 0;
		font-size: 16px;
		letter-spacing: -0.01em;
	}

	.mini {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 6px;
	}

	.miniRow {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 10px;
		padding: 10px 10px;
		border-radius: 14px;
		text-decoration: none;
		color: rgba(16, 24, 40, 0.82);
		font-weight: 800;
		line-height: 1.25;
		background: rgba(255, 255, 255, 0.55);
		border: 1px solid rgba(16, 24, 40, 0.06);
	}

	.miniRow::after {
		content: '›';
		flex: none;
		color: rgba(16, 24, 40, 0.45);
		font-weight: 900;
		line-height: 1;
		margin-top: 1px;
	}

	.miniRowTitle {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.miniRow:hover,
	.miniRow:focus-visible {
		outline: none;
		border-color: rgba(0, 174, 154, 0.4);
		background: rgba(0, 174, 154, 0.06);
	}

	.miniRow:hover::after,
	.miniRow:focus-visible::after {
		color: var(--accent);
	}

	.cardFooter {
		margin-top: 12px;
		padding-top: 12px;
		border-top: 1px solid rgba(16, 24, 40, 0.08);
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
	}

	.cardAction {
		color: var(--accent);
		font-weight: 900;
		text-decoration: none;
		white-space: nowrap;
	}

	.cardAction:hover {
		text-decoration: underline;
	}

	.cardMeta {
		color: rgba(16, 24, 40, 0.6);
		font-size: 13px;
		font-weight: 700;
		white-space: nowrap;
	}

	.emptySmall {
		padding: 10px 12px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 14px;
		color: rgba(16, 24, 40, 0.7);
	}

	.empty {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	@media (max-width: 620px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
