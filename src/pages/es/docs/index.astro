---
import Layout from '../../../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../../../lib/directus';

const mls = await listKbPagesByPrefix({ prefix: '/es/docs/propertylist-mls-manual-de-usuario/', lang: 'es', limit: 200 });
const laws = await listKbPagesByPrefix({ prefix: '/es/docs/leyes-procedimientos/', lang: 'es', limit: 200 });
const latest = await listKbPagesByPrefix({ prefix: '/es/docs/', lang: 'es', limit: 30 });

const isIn = (p: { path: string }, prefix: string) => p.path.startsWith(prefix);
const latestOther = latest.filter(
	(p) =>
		!isIn(p, '/es/docs/propertylist-mls-manual-de-usuario/') &&
		!isIn(p, '/es/docs/leyes-procedimientos/')
);
---

<Layout
	lang="es"
	title="Documentación • PropertyList Info Hub"
	description="Explora la documentación y guías de PropertyList."
	canonical="https://info.propertylist.es/es/docs/"
>
	<h1>Documentación</h1>
	<p class="sub">Explora la base de conocimiento.</p>

	<div class="sections">
		<section class="section">
			<div class="sectionHeader">
				<h2>Manual del MLS</h2>
				<a class="link" href="/es/mls/">Ver</a>
			</div>
			{mls.length ? (
				<div class="list">
					{mls.slice(0, 24).map((p) => (
						<a class="row" href={p.path}>
							<div class="rowTitle">{p.title}</div>
							{p.description ? <div class="rowDesc">{p.description}</div> : null}
						</a>
					))}
				</div>
			) : (
				<div class="empty">Aún no hay páginas del manual.</div>
			)}
		</section>

		<section class="section">
			<div class="sectionHeader">
				<h2>Leyes y procedimientos</h2>
				<a class="link" href="/es/leyes/">Ver</a>
			</div>
			{laws.length ? (
				<div class="list">
					{laws.slice(0, 24).map((p) => (
						<a class="row" href={p.path}>
							<div class="rowTitle">{p.title}</div>
							{p.description ? <div class="rowDesc">{p.description}</div> : null}
						</a>
					))}
				</div>
			) : (
				<div class="empty">Aún no hay páginas.</div>
			)}
		</section>

		<section class="section">
			<div class="sectionHeader">
				<h2>Últimas guías</h2>
			</div>
			{latestOther.length ? (
				<div class="list">
					{latestOther.map((p) => (
						<a class="row" href={p.path}>
							<div class="rowTitle">{p.title}</div>
							{p.description ? <div class="rowDesc">{p.description}</div> : null}
						</a>
					))}
				</div>
			) : (
				<div class="empty">Aún no hay páginas.</div>
			)}
		</section>
	</div>
</Layout>

<style>
	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.03em;
	}

	.sub {
		margin: 0 0 18px;
		color: rgba(16, 24, 40, 0.7);
	}

	.sections {
		display: grid;
		gap: 18px;
	}

	.section {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.sectionHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 10px;
	}

	.sectionHeader h2 {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.link {
		color: rgba(14, 165, 233, 1);
		font-weight: 700;
		text-decoration: none;
	}

	.link:hover {
		text-decoration: underline;
	}

	.list {
		display: grid;
		gap: 10px;
	}

	.row {
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 14px;
		padding: 12px 14px;
		text-decoration: none;
	}

	.row:hover {
		text-decoration: none;
		border-color: rgba(14, 165, 233, 0.35);
	}

	.rowTitle {
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.rowDesc {
		margin-top: 6px;
		color: rgba(16, 24, 40, 0.7);
		font-size: 14px;
		line-height: 1.4;
	}

	.empty {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}
</style>

