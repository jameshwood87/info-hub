---
import Layout from '../../layouts/Layout.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/es/verifica-tu-agencia/`;
const title = 'Verifica tu agencia | PropertyList';
const description =
	'Consigue la insignia de agencia verificada en PropertyList: prioridad para tus anuncios duplicados, check en cada propiedad y 20 créditos de regalo. Gratis - dos minutos.';

const benefits = [
	{ name: 'Insignia verificada', desc: 'El check indica a agentes, compradores e inquilinos que tu agencia es una empresa registrada.' },
	{ name: 'Check en cada anuncio', desc: 'Tus propiedades muestran la insignia de verificación en su página.' },
	{ name: 'Prioridad en duplicados', desc: 'Cuando la misma propiedad está publicada dos veces, el anuncio de la agencia verificada tiene prioridad.' },
	{ name: '20 créditos de regalo', desc: 'Las agencias aprobadas reciben 20 créditos para destacar anuncios o generar informes CMA.' },
];
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical={canonical}
	hreflangs={[
		{ hreflang: 'es', href: canonical },
		{ hreflang: 'en', href: `${origin}/verify-your-agency/` },
		{ hreflang: 'x-default', href: `${origin}/verify-your-agency/` },
	]}
>
	<section class="vwrap">
		<header class="vhead">
			<h1>Verifica tu agencia</h1>
			<p class="vlead">
				La verificación es gratuita y lleva unos dos minutos. Comprobamos que tu agencia es una empresa registrada y añadimos
				la insignia verificada a tu perfil y a todos tus anuncios - más 20 créditos de regalo al aprobarse.
			</p>
		</header>

		<div class="vgrid">
			{benefits.map((b) => (
				<div class="vcard">
					<h3>{b.name}</h3>
					<p>{b.desc}</p>
				</div>
			))}
		</div>

		<form id="verify-form" class="vform" novalidate>
			<h2>Solicitud de verificación</h2>
			<p class="vnote">Usa el mismo email de tu cuenta de PropertyList para que podamos localizar tu agencia.</p>

			<div class="vrow">
				<div class="vfield">
					<label for="v-agency">Nombre de la agencia *</label>
					<input id="v-agency" name="agency_name" type="text" required maxlength="200" autocomplete="organization" />
				</div>
				<div class="vfield">
					<label for="v-cif">Número de empresa (CIF / SL) *</label>
					<input id="v-cif" name="company_number" type="text" required maxlength="60" placeholder="ej. B12345678" />
				</div>
			</div>
			<div class="vrow">
				<div class="vfield">
					<label for="v-email">Email de tu cuenta PropertyList *</label>
					<input id="v-email" name="mls_email" type="email" required maxlength="200" autocomplete="email" />
				</div>
				<div class="vfield">
					<label for="v-website">Web de la agencia *</label>
					<input id="v-website" name="website" type="text" required maxlength="300" placeholder="https://" inputmode="url" />
				</div>
			</div>
			<div class="vrow">
				<div class="vfield">
					<label for="v-name">Persona de contacto</label>
					<input id="v-name" name="contact_name" type="text" maxlength="200" autocomplete="name" />
				</div>
				<div class="vfield">
					<label for="v-phone">Teléfono</label>
					<input id="v-phone" name="phone" type="tel" maxlength="60" autocomplete="tel" />
				</div>
			</div>
			<div class="vrow">
				<div class="vfield">
					<label for="v-gbp">Enlace de Google Business Profile</label>
					<input id="v-gbp" name="google_business" type="text" maxlength="300" placeholder="https://maps.google.com/..." />
					<span class="vhint">Tu insignia verificada enlaza a tus reseñas de Google.</span>
				</div>
				<div class="vfield">
					<label for="v-social">Red social</label>
					<input id="v-social" name="social_link" type="text" maxlength="300" placeholder="Instagram, Facebook o LinkedIn" />
				</div>
			</div>
			<div class="vfield">
				<label for="v-notes">¿Algo más que debamos saber?</label>
				<textarea id="v-notes" name="notes" rows="3" maxlength="2000"></textarea>
			</div>
			<p class="vhp" aria-hidden="true"><label>Fax <input name="company_fax" type="text" tabindex="-1" autocomplete="off" /></label></p>

			<button class="vsubmit" type="submit">Enviar solicitud de verificación</button>
			<p class="vstatus" id="v-status" role="status" aria-live="polite"></p>
			<p class="vsmall">
				Revisamos las solicitudes en 1-2 días laborables. ¿Aún no tienes cuenta?
				<a href="https://agents.propertylist.es/new_agency/new?locale=es" target="_blank" rel="noopener">Crea tu cuenta gratis primero</a>.
				Más información en la <a href="/es/docs/propertylist-mls-manual-de-usuario/verified-agencies/">guía de agencias verificadas</a>.
			</p>
		</form>
	</section>
</Layout>

<script>
	const form = document.getElementById('verify-form') as HTMLFormElement | null;
	const status = document.getElementById('v-status');
	const started = performance.now();
	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!form || !status) return;
		const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
		for (const k of ['agency_name', 'company_number', 'mls_email', 'website']) {
			if (!String(data[k] || '').trim()) {
				status.textContent = 'Completa los campos obligatorios marcados con *.';
				status.className = 'vstatus err';
				return;
			}
		}
		const btn = form.querySelector('.vsubmit') as HTMLButtonElement | null;
		if (btn) btn.disabled = true;
		status.textContent = 'Enviando...';
		status.className = 'vstatus';
		try {
			const res = await fetch('/api/verify-agency', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ ...data, lang: 'es', page: location.pathname, t: Math.round(performance.now() - started) }),
			});
			const j = await res.json().catch(() => ({ ok: false }));
			if (res.ok && j.ok) {
				form.reset();
				status.textContent = 'Solicitud recibida. La revisaremos en 1-2 días laborables y te avisaremos por email cuando la insignia y tus 20 créditos estén activos.';
				status.className = 'vstatus ok';
			} else {
				status.textContent = res.status === 429 ? 'Demasiadas solicitudes - inténtalo más tarde.' : 'Algo ha fallado - inténtalo de nuevo o escribe a xml@propertylist.es.';
				status.className = 'vstatus err';
				if (btn) btn.disabled = false;
			}
		} catch {
			status.textContent = 'Error de red - inténtalo de nuevo.';
			status.className = 'vstatus err';
			if (btn) btn.disabled = false;
		}
	});
</script>

<style>
	.vwrap { max-width: 880px; margin: 0 auto; padding: 32px 18px 64px; }
	.vhead h1 { font-size: 34px; font-weight: 900; letter-spacing: -0.02em; margin: 0 0 10px; }
	.vlead { color: rgba(16, 24, 40, 0.72); font-size: 16px; line-height: 1.6; margin: 0 0 26px; max-width: 640px; }
	.vgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin-bottom: 34px; }
	.vcard { border: 1px solid rgba(16, 24, 40, 0.1); border-radius: 14px; padding: 14px; background: #fff; }
	.vcard h3 { margin: 0 0 6px; font-size: 15px; font-weight: 800; }
	.vcard p { margin: 0; font-size: 13.5px; color: rgba(16, 24, 40, 0.66); line-height: 1.5; }
	.vform { border: 1px solid rgba(16, 24, 40, 0.1); border-radius: 16px; padding: 22px; background: #fff; }
	.vform h2 { margin: 0 0 4px; font-size: 22px; font-weight: 900; }
	.vnote { margin: 0 0 18px; color: rgba(16, 24, 40, 0.6); font-size: 14px; }
	.vrow { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
	.vfield { margin-bottom: 14px; display: flex; flex-direction: column; }
	.vfield label { font-size: 13.5px; font-weight: 700; margin-bottom: 5px; }
	.vfield input, .vfield textarea { border: 1px solid rgba(16, 24, 40, 0.18); border-radius: 10px; padding: 10px 12px; font-size: 15px; font-family: inherit; }
	.vfield input:focus, .vfield textarea:focus { outline: 2px solid rgba(13, 148, 136, 0.4); border-color: rgba(13, 148, 136, 0.6); }
	.vhint { font-size: 12px; color: rgba(16, 24, 40, 0.55); margin-top: 4px; }
	.vhp { position: absolute; left: -9999px; height: 0; overflow: hidden; }
	.vsubmit { background: #0d9488; color: #fff; font-weight: 800; font-size: 15.5px; border: 0; border-radius: 999px; padding: 12px 26px; cursor: pointer; }
	.vsubmit:disabled { opacity: 0.6; cursor: default; }
	.vstatus { min-height: 20px; font-size: 14px; margin: 12px 0 0; }
	.vstatus.ok { color: #047857; font-weight: 600; }
	.vstatus.err { color: #b91c1c; font-weight: 600; }
	.vsmall { font-size: 13px; color: rgba(16, 24, 40, 0.6); margin: 14px 0 0; }
	@media (max-width: 640px) { .vrow { grid-template-columns: 1fr; } }
</style>
