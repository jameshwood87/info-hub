---
import Layout from '../../layouts/Layout.astro';

// Twin de /unsubscribe/. Noindex: es una confirmación, no una página que nadie
// deba encontrar en el buscador. La dirección nunca se imprime de vuelta.
const bad = Astro.url.searchParams.has('bad');
---

<Layout
	lang="es"
	title="Baja completada | PropertyList"
	description="Te has dado de baja del correo de mercado de PropertyList."
	canonical="https://info.propertylist.es/es/baja/"
	robots="noindex,follow"
>
	<section class="unsubWrap">
		<div class="unsubCard">
			{bad ? (
				<>
					<h1>Ese enlace no ha funcionado</h1>
					<p>El enlace de baja estaba incompleto o había sido modificado, así que no hemos podido aplicarlo. Reenvía el correo a <a href="mailto:info@propertylist.es">info@propertylist.es</a> y quitamos la dirección de la lista a mano.</p>
				</>
			) : (
				<>
					<h1>Te has dado de baja</h1>
					<p>Esa dirección no volverá a recibir el correo de mercado de la Costa del Sol. No cambia nada más: si tienes cuenta en PropertyList, sigue igual.</p>
				</>
			)}
			<p class="unsubBack"><a href="/es/">Volver al info hub</a></p>
		</div>
	</section>
</Layout>

<style is:global>
	.unsubWrap { max-width: 640px; margin: 0 auto; padding: 72px 24px 96px; }
	.unsubCard { background: #fff; border: 1px solid #e5ecec; border-radius: 18px; padding: 36px 32px; }
	.unsubCard h1 { font-size: 28px; line-height: 1.2; color: #0d2b2e; margin: 0 0 14px; }
	.unsubCard p { font-size: 16px; line-height: 1.65; color: #4a5b5d; margin: 0 0 14px; }
	.unsubCard a { color: #00ae9a; }
	.unsubBack { margin-top: 22px !important; font-size: 14px !important; }
	@media (max-width: 560px) { .unsubWrap { padding: 48px 18px 72px; } .unsubCard { padding: 26px 22px; } }
</style>
