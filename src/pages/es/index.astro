---
import Layout from '../../layouts/Layout.astro';
import background from '../../assets/background.svg';

const personaParam = Astro.url.searchParams.get('persona') || '';

const persona = (() => {
	if (personaParam === 'public' || personaParam === 'portal' || personaParam === 'public-portal') return 'public';
	if (personaParam === 'developers' || personaParam === 'developer') return 'developers';
	if (personaParam === 'services' || personaParam === 'service') return 'services';
	if (personaParam === 'agents' || personaParam === 'freelancer' || personaParam === 'agency') return 'agents';
	return 'agents';
})();

const hrefForPersona = (nextPersona: string) => {
	const params = new URLSearchParams();
	params.set('persona', nextPersona);
	return `/es/?${params.toString()}`;
};
---

<Layout
	lang="es"
	title="PropertyList - MLS, CRM y Portal Inmobiliario gratis para España"
	description="PropertyList es el Smart MLS, CRM y Portal Inmobiliario gratis de Europa. El MLS y el CRM son 100% gratis para siempre para agentes inmobiliarios y promotores. Sin comisiones ocultas, sin cuotas de alta, sin permanencia."
	canonical="https://info.propertylist.es/es/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/' },
	]}
>
	<section class="hero">
		<div class="heroBg" aria-hidden="true">
			<img src={background.src} alt="" width="1600" height="900" fetchpriority="high" />
		</div>
		<div class="heroInner">
			<a class="btnSecondary topCta" href="/es/docs/">Cómo usar PropertyList</a>
			<div class="heroCopy">
				<h1>¿Qué es PropertyList?</h1>
				<p class="lead">PropertyList es el primer Smart MLS, CRM y Portal Inmobiliario de España orientado a resultados.</p>
				<p class="lead">
					El MLS y el CRM son 100% gratis para siempre para agentes inmobiliarios y promotores. Sin comisiones ocultas, sin cuotas de alta. Sin permanencia. Hay funciones de pago opcionales para quienes quieren más visibilidad, automatización y rendimiento. La actividad inmobiliaria debe verificarse.
				</p>

				<div class="metaRow">
					<div class="metaItem">
						<div class="metaKpi">5.700+</div>
						<div class="metaLabel">Anuncios activos</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">1.350+</div>
						<div class="metaLabel">Agentes activos</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Multi-idioma</div>
						<div class="metaLabel">Plataforma</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Herramientas IA</div>
						<div class="metaLabel">Mejoras</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Automatización</div>
						<div class="metaLabel">Flujos de trabajo</div>
					</div>
				</div>

