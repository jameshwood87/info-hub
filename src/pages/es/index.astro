					<a
						class={`pill ${persona === 'developers' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'developers' ? 'true' : 'false'}
						data-persona="developers"
						href={hrefForPersona('developers')}
					>Promotores</a>
					<a
						class={`pill ${persona === 'services' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'services' ? 'true' : 'false'}
						data-persona="services"
						href={hrefForPersona('services')}
					>Servicios inmobiliarios</a>
					<a
						class={`pill ${persona === 'public' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'public' ? 'true' : 'false'}
						data-persona="public"
						href={hrefForPersona('public')}
