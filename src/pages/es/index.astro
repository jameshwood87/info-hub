---
import Layout from '../../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../../lib/directus';
import background from '../../assets/background.svg';

const latestDocs = await listKbPagesByPrefix({ prefix: '/es/docs/', lang: 'es', limit: 8 });
const latestGeneral = await listKbPagesByPrefix({ prefix: '/es/informacion-general/', lang: 'es', limit: 8 });
---

<Layout
	lang="es"
	title="PropertyList Info Hub"
	description="Cómo usar PropertyList.es, funciones, precios y más."
>
	<section class="hero">
		<div class="heroBg" aria-hidden="true">
			<img src={background.src} alt="" width="1600" height="900" fetchpriority="high" />
		</div>
		<div class="heroInner">
			<div class="heroCopy">
				<div class="tagRow" aria-label="Temas clave">
					<a class="tag" href="/es/lo-que-ofrecemos/">¿Qué es PropertyList?</a>
					<a class="tag" href="/es/docs/empezar/">Cómo usar PropertyList</a>
				</div>
				<div class="pillRow" role="tablist" aria-label="Tipo de usuario">
					<button class="pill isActive" type="button" data-persona="freelancer">Freelancer</button>
					<button class="pill" type="button" data-persona="agency">Agencia</button>
					<button class="pill" type="button" data-persona="developer">Promotor</button>
					<button class="pill" type="button" data-persona="service">Servicios</button>
				</div>
				<h1>Comparte propiedades gratis</h1>
				<p class="lead">
					PropertyList te permite compartir tus propiedades al instante con una gran red de agentes e integrarlas
					en sus webs y viceversa.
				</p>
				<div class="ctaRow">
					<a class="btnPrimary" href="/es/docs/">Ver documentación</a>
					<a class="btnSecondary" href="/es/search">Buscar guías</a>
				</div>
				<div class="metaRow">
					<div class="metaItem">
						<div class="metaKpi">316+</div>
						<div class="metaLabel">Artículos importados</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">EN/ES</div>
						<div class="metaLabel">Bilingüe</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">MLS</div>
						<div class="metaLabel">Manual de usuario</div>
					</div>
				</div>

				<div class="personaBox" aria-label="Enlaces rápidos">
					<div class="personaPanel isActive" data-persona-panel="freelancer" role="tabpanel">
						<div class="personaTitle">Inicio rápido</div>
						<div class="personaLinks">
							<a href="/es/docs/empezar/">Empezar</a>
							<a href="/es/mls/">Manual del MLS</a>
							<a href="/es/leyes/">Guías legales</a>
						</div>
					</div>
					<div class="personaPanel" data-persona-panel="agency" role="tabpanel">
						<div class="personaTitle">Agencias</div>
						<div class="personaLinks">
							<a href="/es/docs/">Documentación</a>
							<a href="/es/informacion-general/">Últimas novedades</a>
							<a href="/es/search">Buscar</a>
						</div>
					</div>
					<div class="personaPanel" data-persona-panel="developer" role="tabpanel">
						<div class="personaTitle">Promotores</div>
						<div class="personaLinks">
							<a href="/es/docs/">Documentación</a>
							<a href="/es/informacion-general/">Noticias</a>
							<a href="/es/search">Buscar</a>
						</div>
					</div>
					<div class="personaPanel" data-persona-panel="service" role="tabpanel">
						<div class="personaTitle">Servicios</div>
						<div class="personaLinks">
							<a href="/es/informacion-general/">Información general</a>
							<a href="/es/docs/">Documentación</a>
							<a href="/es/search">Buscar</a>
						</div>
					</div>
				</div>
			</div>

			<div class="heroVisual" aria-hidden="true">
				<div class="visualCard">
					<div class="visualTitle">Manual del MLS</div>
					<div class="visualLine"></div>
					<div class="visualLine short"></div>
					<div class="visualPills">
						<span>Listados</span>
						<span>Exportar</span>
						<span>Informes</span>
					</div>
				</div>
				<div class="visualCard">
					<div class="visualTitle">Leyes y procedimientos</div>
					<div class="visualLine"></div>
					<div class="visualLine"></div>
					<div class="visualLine short"></div>
				</div>
				<div class="visualCard">
					<div class="visualTitle">Información general</div>
					<div class="visualLine"></div>
					<div class="visualLine short"></div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Explorar documentación</h2>
			<a class="link" href="/es/docs/">Ver todo</a>
		</div>
		<div class="grid">
			<a class="tile" href="/es/barrios/">
				<div class="tileIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M4.5 10.5 12 4.5l7.5 6v9.75c0 .69-.56 1.25-1.25 1.25H5.75c-.69 0-1.25-.56-1.25-1.25V10.5Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path
							d="M9 22v-6.75c0-.69.56-1.25 1.25-1.25h3.5c.69 0 1.25.56 1.25 1.25V22"
							stroke="currentColor"
							stroke-width="1.6"
						/>
					</svg>
				</div>
				<h3>Guías de barrios</h3>
				<p>Información de zonas y estilo de vida.</p>
			</a>
			<a class="tile" href="/es/mls/">
				<div class="tileIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M7 4.5h7l3 3v12.75c0 .69-.56 1.25-1.25 1.25H7.25C6.56 21.75 6 21.19 6 20.5V5.75C6 5.06 6.56 4.5 7.25 4.5Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path d="M14 4.5V8h3" stroke="currentColor" stroke-width="1.6" />
						<path d="M8.5 12h7" stroke="currentColor" stroke-width="1.6" />
						<path d="M8.5 15.5h6" stroke="currentColor" stroke-width="1.6" />
					</svg>
				</div>
				<h3>Manual del MLS</h3>
				<p>Flujos, listados, exportaciones e informes.</p>
			</a>
			<a class="tile" href="/es/leyes/">
				<div class="tileIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M12 3.75c3.2 2.47 5.5 2.47 8 2.75v8.5c0 3.9-3.1 6.6-8 8.25-4.9-1.65-8-4.35-8-8.25V6.5c2.5-.28 4.8-.28 8-2.75Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path d="M9 12h6" stroke="currentColor" stroke-width="1.6" />
						<path d="M12 9v6" stroke="currentColor" stroke-width="1.6" />
					</svg>
				</div>
				<h3>Leyes y procedimientos</h3>
				<p>Alquileres, impuestos, herencias y más.</p>
			</a>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Última documentación</h2>
			<a class="link" href="/es/docs/">Ver todo</a>
		</div>
		<div class="list">
			{latestDocs.length ? (
				latestDocs.map((p) => (
					<a class="row" href={p.path}>
						<div class="rowTitle">{p.title}</div>
						{p.description ? <div class="rowDesc">{p.description}</div> : null}
					</a>
				))
			) : (
				<div class="empty">Aún no hay páginas.</div>
			)}
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Información general</h2>
			<a class="link" href="/es/informacion-general/">Ver todo</a>
		</div>
		<div class="cards">
			{latestGeneral.length ? (
				latestGeneral.map((p) => (
					<a class="cardLink" href={p.path}>
						<h3>{p.title}</h3>
						{p.description ? <p>{p.description}</p> : null}
					</a>
				))
			) : (
				<div class="empty">Aún no hay artículos.</div>
			)}
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Sé parte de la comunidad</h2>
			<a class="link" href="/es/comunidad/">Haz una pregunta</a>
		</div>
		<div class="grid">
			<div class="tile mutedTile">
				<h3>Últimos temas del foro</h3>
				<p>Próximamente.</p>
			</div>
			<div class="tile mutedTile">
				<h3>Tutoriales en vídeo</h3>
				<p>Próximamente.</p>
			</div>
		</div>
	</section>

	<script>
		const pills = Array.from(document.querySelectorAll('[data-persona]'));
		const panels = Array.from(document.querySelectorAll('[data-persona-panel]'));

		function setPersona(next) {
			for (const p of pills) p.classList.toggle('isActive', p.dataset.persona === next);
			for (const panel of panels) panel.classList.toggle('isActive', panel.dataset.personaPanel === next);
		}

		setPersona('freelancer');

		for (const pill of pills) {
			pill.addEventListener('click', () => setPersona(pill.dataset.persona));
		}
	</script>
</Layout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(246, 248, 252, 0.85));
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 18px;
		padding: 22px;
	}

	.heroBg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.9;
	}

	.heroBg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.1);
		filter: blur(60px) saturate(1.15);
	}

	.heroBg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(900px 420px at 5% 20%, rgba(14, 165, 233, 0.35), transparent 55%),
			radial-gradient(900px 420px at 100% 10%, rgba(34, 197, 94, 0.18), transparent 55%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(246, 248, 252, 0.92));
	}

	.heroInner {
		position: relative;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 20px;
		align-items: start;
	}

	.heroCopy {
		padding: 8px;
	}

	.pillRow {
		display: inline-flex;
		gap: 8px;
		padding: 6px;
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 999px;
		margin-top: 12px;
	}

	.tagRow {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 8px 12px;
		border-radius: 999px;
		background: rgba(var(--accent-rgb), 0.12);
		border: 1px solid rgba(var(--accent-rgb), 0.22);
		color: rgba(11, 18, 32, 0.82);
		font-weight: 900;
		text-decoration: none;
	}

	.tag:hover {
		text-decoration: none;
		background: rgba(var(--accent-rgb), 0.16);
	}

	.pill {
		border: 0;
		background: transparent;
		padding: 8px 10px;
		border-radius: 999px;
		cursor: pointer;
		font-weight: 600;
		color: rgba(16, 24, 40, 0.7);
	}

	.pill.isActive {
		background: rgba(14, 165, 233, 0.12);
		color: rgba(16, 24, 40, 1);
	}

	h1 {
		font-size: 46px;
		line-height: 1.05;
		margin: 14px 0 12px;
		letter-spacing: -0.03em;
	}

	.lead {
		font-size: 18px;
		line-height: 1.55;
		color: rgba(11, 18, 32, 0.72);
		margin: 0 0 18px;
	}

	.ctaRow {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.btnPrimary,
	.btnSecondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 11px 14px;
		border-radius: 12px;
		text-decoration: none;
		font-weight: 700;
	}

	.btnPrimary {
		background: var(--accent);
		color: #fff;
	}

	.btnPrimary:hover {
		text-decoration: none;
		filter: brightness(0.95);
	}

	.btnSecondary {
		background: rgba(16, 24, 40, 0.06);
		border: 1px solid rgba(16, 24, 40, 0.1);
	}

	.btnSecondary:hover {
		text-decoration: none;
		background: rgba(16, 24, 40, 0.08);
	}

	.metaRow {
		margin-top: 18px;
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}

	.metaItem {
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 14px;
		padding: 10px 12px;
		min-width: 140px;
	}

	.metaKpi {
		font-weight: 900;
		letter-spacing: -0.01em;
	}

	.metaLabel {
		margin-top: 2px;
		font-size: 13px;
		color: rgba(11, 18, 32, 0.65);
	}

	.personaBox {
		margin-top: 14px;
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 16px;
		padding: 12px;
	}

	.personaPanel {
		display: none;
	}

	.personaPanel.isActive {
		display: block;
	}

	.personaTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}

	.personaLinks {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
	}

	.personaLinks a {
		background: rgba(var(--accent-rgb), 0.08);
		border: 1px solid rgba(var(--accent-rgb), 0.18);
		border-radius: 14px;
		padding: 10px 12px;
		font-weight: 800;
		text-decoration: none;
	}

	.personaLinks a:hover {
		text-decoration: none;
		background: rgba(var(--accent-rgb), 0.12);
	}

	.heroVisual {
		display: grid;
		gap: 12px;
		align-content: start;
	}

	.visualCard {
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 16px;
		padding: 14px;
		box-shadow: 0 20px 60px rgba(11, 18, 32, 0.08);
	}

	.visualTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}

	.visualLine {
		height: 10px;
		border-radius: 999px;
		background: rgba(11, 18, 32, 0.08);
		margin: 10px 0;
	}

	.visualLine.short {
		width: 70%;
	}

	.visualPills {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin-top: 12px;
	}

	.visualPills span {
		display: inline-flex;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(var(--accent-rgb), 0.12);
		color: rgba(11, 18, 32, 0.8);
		font-weight: 700;
		font-size: 12px;
	}

	.card {
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 14px;
	}

	.card h3 {
		margin: 0 0 8px;
		font-size: 16px;
	}

	.card p {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
	}

	.card ul {
		margin: 0;
		padding-left: 18px;
		color: rgba(16, 24, 40, 0.72);
	}

	.card li {
		margin: 6px 0;
	}

	.persona {
		display: none;
	}

	.persona.isActive {
		display: block;
	}

	.section {
		margin-top: 22px;
	}

	.sectionHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 10px;
	}

	.sectionHeader h2 {
		margin: 0;
		font-size: 20px;
		letter-spacing: -0.01em;
	}

	.link {
		color: rgba(14, 165, 233, 1);
		font-weight: 700;
		text-decoration: none;
	}

	.link:hover {
		text-decoration: underline;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.tile {
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 14px;
		text-decoration: none;
	}

	.tileIcon {
		width: 42px;
		height: 42px;
		border-radius: 14px;
		display: grid;
		place-items: center;
		background: rgba(var(--accent-rgb), 0.12);
		color: var(--accent);
		margin-bottom: 10px;
	}

	.tile:hover {
		text-decoration: none;
		border-color: rgba(14, 165, 233, 0.35);
	}

	.tile h3 {
		margin: 0 0 8px;
		font-size: 16px;
	}

	.tile p {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
	}

	.mutedTile {
		background: rgba(255, 255, 255, 0.6);
	}

	.list {
		display: grid;
		gap: 10px;
	}

	.row {
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 14px;
		padding: 12px 14px;
		text-decoration: none;
	}

	.row:hover {
		text-decoration: none;
		border-color: rgba(14, 165, 233, 0.35);
	}

	.rowTitle {
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.rowDesc {
		margin-top: 6px;
		color: rgba(16, 24, 40, 0.7);
		font-size: 14px;
		line-height: 1.4;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.cardLink {
		display: block;
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 14px;
		text-decoration: none;
	}

	.cardLink:hover {
		text-decoration: none;
		border-color: rgba(14, 165, 233, 0.35);
	}

	.cardLink h3 {
		margin: 0 0 8px;
		font-size: 16px;
		letter-spacing: -0.01em;
	}

	.cardLink p {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
	}

	.empty {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	@media (max-width: 980px) {
		.heroInner {
			grid-template-columns: 1fr;
		}

		.heroVisual {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
		}

		.cards {
			grid-template-columns: 1fr;
		}

		.personaLinks {
			grid-template-columns: 1fr;
		}

		.heroVisual {
			grid-template-columns: 1fr;
		}

		h1 {
			font-size: 36px;
		}
	}
</style>
