---
import { statPlus } from '../../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'es');
const plAgencies = statPlus(__ps.agencies, 'es');
const plListings = statPlus(__ps.listings, 'es');
import Layout from '../../layouts/Layout.astro';
import background from '../../assets/background.svg';
import { getPortalStats } from '../../lib/portalStats';

const stats = await getPortalStats();
const nf = { format: (n) => n.toLocaleString('en-GB').replace(/,/g, '.') };

const personaParam = Astro.url.searchParams.get('persona') || '';

const persona = (() => {
	if (personaParam === 'public' || personaParam === 'portal' || personaParam === 'public-portal') return 'public';
	if (personaParam === 'developers' || personaParam === 'developer') return 'developers';
	if (personaParam === 'services' || personaParam === 'service') return 'services';
	if (personaParam === 'agents' || personaParam === 'freelancer' || personaParam === 'agency') return 'agents';
	return 'agents';
})();

const hrefForPersona = (nextPersona: string) => {
	const params = new URLSearchParams();
	params.set('persona', nextPersona);
	return `/es/?${params.toString()}`;
};

const softwareAppLd = {
 "@context": "https://schema.org",
 "@type": "SoftwareApplication",
 "name": "PropertyList",
 "applicationCategory": "BusinessApplication",
 "applicationSubCategory": "Estate agency CRM, agent-to-agent MLS and property portal",
 "operatingSystem": "Web browser, Android",
 "url": "https://propertylist.es/",
 "sameAs": [
  "https://agents.propertylist.es/",
  "https://info.propertylist.es/"
 ],
 "inLanguage": [
  "en",
  "es"
 ],
 "areaServed": {
  "@type": "Country",
  "name": "Spain"
 },
 "provider": {
  "@type": "Organization",
  "name": "PropertyList"
 },
 "description": `Estate agency system for Spain combining a CRM, an agent-to-agent MLS shared by ${plAgents} agents across ${plAgencies} agencies, and a public property portal. Listings, the CRM and the Lead, Seller and Property pipelines are free with no limit. A buyer lead costs 1 credit and only when the agent chooses to take it. Automation, rentals and the website builder are monthly credit subscriptions from one prepaid balance.`,
 "featureList": [
  "Six CRM pipelines: Leads, Buyers, Sellers, Property, Tenants, Nurture",
  `Agent-to-agent MLS with co-broking across ${plAgencies} agencies`,
  "Public property portal listing and direct buyer enquiries",
  "AI Property Match: plain-language search across own stock and the whole MLS",
  "Automated lead acknowledgement and a day 0, 1, 3, 7 follow-up cadence",
  "Nurture: automated past-client follow-up with intent detection",
  "Rentals Module: tenancies, renewals, annual rent review, deposit compliance, maintenance",
  "Free branded MicroSite for every agency",
  "AI website builder with automated SEO content",
  "Notary-verified register prices and per-property CMA reports",
  "XML feed import and export",
  "Android app",
  "MCP server for AI-native property queries"
 ],
 "offers": [
  {
   "@type": "Offer",
   "name": "Free plan",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "MLS and CRM, unlimited listings, unlimited staff accounts, the Lead, Seller and Property pipelines, a branded MicroSite and XML push to other portals. No card, no time limit."
  },
  {
   "@type": "Offer",
   "name": "Portal direct lead",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "Enquiries from the public property portal are free to open, taking no credits. Free for a limited time; expected to move to a pay-per-lead model in future, with notice."
  },
  {
   "@type": "Offer",
   "name": "Buyer lead",
   "price": "1",
   "priceCurrency": "EUR",
   "description": "Costs 1 credit, charged only when the agent chooses to move a qualified contact into one of the paid pipeline boards, and the first 5 are free. Everything up to that point is free and declining costs nothing. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  },
  {
   "@type": "Offer",
   "name": "Automation and Nurture",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "20",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "20 credits a month from the same prepaid credit balance as everything else. Includes the Nurture pipeline, all automated emails, Hot-lead detection and the Daily Action Queue. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  },
  {
   "@type": "Offer",
   "name": "Rentals Module",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits per 30-day period, taken from your prepaid credit balance, bought in advance at 1.00 EUR per credit and less in larger packs. Free 30-day trial with no charge until you renew. Includes the Tenants pipeline, Tenancies, Maintenance and renewal email reminders."
  },
  {
   "@type": "Offer",
   "name": "Website Builder",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits a month. Add-ons are separate monthly credit costs, for example pop-up lead capture at 8 and auto meta descriptions at 5. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  }
 ],
 "paymentAccepted": "Credits from a single prepaid balance",
 "termsOfService": "https://info.propertylist.es/docs/propertylist-mls-user-manual/credits/how-billing-works/"
};

---

<Layout
	schema={softwareAppLd}
	lang="es"
	title="PropertyList - MLS, CRM y Portal Inmobiliario gratis para España"
	description="PropertyList es el Smart MLS, CRM y Portal Inmobiliario gratis de Europa. El MLS y el núcleo del CRM son gratis para siempre para agentes y promotores, y solo se cobra 1 crédito al pasar un lead cualificado a un pipeline de pago. Sin cuotas de alta, sin permanencia."
	canonical="https://info.propertylist.es/es/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/' },
	]}
>
	<section class="hero">
		<div class="heroBg" aria-hidden="true">
			<img src={background.src} alt="" width="1600" height="900" fetchpriority="high" />
		</div>
		<div class="heroInner">
			<a class="btnSecondary topCta" href="/es/docs/">Cómo usar PropertyList</a>
			<div class="heroCopy">
				<div class="heroEyebrow">Compartir propiedades gratis para siempre, para agentes y promotores</div>
				<h1>Publica una vez. Deja que {plAgents} agentes la vendan.</h1>
				<p class="lead">
					PropertyList es el MLS, CRM y portal inmobiliario gratis de España. Publica una propiedad una vez y llega a más
					de {plAgents} agentes registrados y a miles de compradores - sin cuotas de alta, sin mensualidades, sin permanencia.
					Añade herramientas de IA y marketing solo cuando una operación concreta lo pida.
				</p>
				<div class="heroCtas">
					<a class="btnPrimary heroCtaPrimary" href="https://agents.propertylist.es/new_agency/new?locale=es" target="_blank" rel="noopener">Crea tu cuenta gratis</a>
					<a class="btnSecondary" href="https://propertylist.es/" target="_blank" rel="noopener">Explora el portal inmobiliario</a>
				</div>

				<div class="metaRow">
					<div class="metaItem">
						<div class="metaKpi">{nf.format(stats.listings)}</div>
						<div class="metaLabel">Anuncios activos</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">{nf.format(stats.agencies)}</div>
						<div class="metaLabel">Agencias</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Multi-idioma</div>
						<div class="metaLabel">Plataforma</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Herramientas IA</div>
						<div class="metaLabel">Mejoras</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Automatización</div>
						<div class="metaLabel">Flujos de trabajo</div>
					</div>
				</div>

				<div class="pillRow" role="tablist" aria-label="Audience">
					<a
						class={`pill ${persona === 'agents' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'agents' ? 'true' : 'false'}
						data-persona="agents"
						href={hrefForPersona('agents')}
					>Agentes inmobiliarios</a>
					<a
						class={`pill ${persona === 'developers' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'developers' ? 'true' : 'false'}
						data-persona="developers"
						href={hrefForPersona('developers')}
					>Promotores</a>
					<a
						class={`pill ${persona === 'services' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'services' ? 'true' : 'false'}
						data-persona="services"
						href={hrefForPersona('services')}
					>Servicios inmobiliarios</a>
					<a
						class={`pill ${persona === 'public' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'public' ? 'true' : 'false'}
						data-persona="public"
						href={hrefForPersona('public')}
					>Compradores e inquilinos</a>
				</div>

				<div class="personaBox" aria-label="By audience">
					<div class={`personaPanel ${persona === 'agents' ? 'isActive' : ''}`} data-persona-panel="agents">
							<div class="personaTitle">Para agentes inmobiliarios</div>
						<div class="personaSummary">
								Deja de pagar una mensualidad solo para alojar tus propios anuncios. Publícalos gratis en PropertyList y {plAgents} agentes registrados pueden venderlos por ti - tú fijas la comisión y mantienes el control.<br /><br />Cruza al instante a tus compradores con miles de anuncios compartidos de toda la red. El MLS y el CRM son gratis para siempre - sin cuotas de alta, sin permanencia.<br /><br />Solo pagas cuando quieres ventaja en una operación concreta, como un CMA con IA para fijar el precio. Sin costes fijos, nunca.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://agents.propertylist.es/new_agency/new?locale=es" target="_blank" rel="noopener">Crea tu cuenta gratis</a></div>
						<div class="personaLinks">
							<a href="/es/docs/propertylist-mls-manual-de-usuario/">Guía del MLS y CRM</a>
							<a href="/es/docs/leyes-procedimientos/">Leyes y procedimientos</a>
							<a href="/es/barrios/">Guías de zona</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'developers' ? 'isActive' : ''}`} data-persona-panel="developers">
							<div class="personaTitle">Para promotores</div>
						<div class="personaSummary">
								Pon toda tu promoción ante {plAgents} agentes registrados el mismo día que la publicas - gratis. Tu cartera pasa a ser inventario compartido en la red, así que una fuerza de ventas real vende tus unidades, no un simple anuncio aparcado en un portal.<br /><br />Solo pagas la comisión que tú fijas, y solo cuando un agente trae de verdad a un comprador. Cada euro va ligado a una venta confirmada - sin gasto de publicidad por adelantado, sin presupuesto desperdiciado.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://agents.propertylist.es/new_agency/new?locale=es" target="_blank" rel="noopener">Crea tu cuenta gratis</a></div>
						<div class="personaLinks">
							<a href="https://info.propertylist.es/es/developers#get-updates">¿Cómo funciona?</a>
							<a href="/es/docs/">Docs para promotores</a>
							<a href="/es/barrios/">Guías de zona</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'services' ? 'isActive' : ''}`} data-persona-panel="services">
							<div class="personaTitle">Para servicios inmobiliarios</div>
						<div class="personaSummary">
								Llega a agentes y compradores justo cuando te necesitan - no con un anuncio genérico de directorio, sino dentro de la propia operación. Tu servicio aparece en el flujo de trabajo cuando la transacción lo requiere.<br /><br />Muy pronto: nuestra IA hará la presentación, poniendo tu perfil ante las personas adecuadas justo cuando la operación necesite tu gremio. Solo pagarás por contactos cualificados ligados a una operación real.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://agents.propertylist.es/new_agency/new?locale=es" target="_blank" rel="noopener">Crea tu cuenta gratis</a></div>
						<div class="personaLinks">
							<a href="/es/docs/property-services/">Docs de servicios</a>
							<a href="/es/barrios/">Guías de zona</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'public' ? 'isActive' : ''}`} data-persona-panel="public">
							<div class="personaTitle">Para compradores e inquilinos</div>
						<div class="personaSummary">
								Ve todo el mercado, en tiempo real. Cada propiedad aparece una sola vez - sin anuncios duplicados, sin pasar por el mismo inmueble de una docena de agencias. Explora ventas, alquileres de larga temporada, propiedades vacacionales y obra nueva sin muros de pago ni trucos - y nunca vendemos tus datos.<br /><br />¿Quieres una ventaja profesional? Genera un informe de análisis de mercado (CMA) con IA en segundos - la misma inteligencia que usan los mejores agentes de la zona, basada en datos reales verificados ante notario.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://propertylist.es/" target="_blank" rel="noopener">Explora el portal inmobiliario</a></div>
						<div class="personaLinks">
							<a href="/es/docs/portal-publico/">Portal público de propiedades</a>
							<a href="/es/docs/leyes-procedimientos/">Leyes y procedimientos</a>
							<a href="/es/barrios/">Guías de zona</a>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2 class="offerTitle">Qué ofrecemos</h2>
		</div>
		<p class="sectionLead">
Mantén el motor en marcha gratis - para siempre. PropertyList te da un MLS + CRM totalmente funcional sin coste, para que puedas publicar propiedades, gestionar leads, coordinarte con tu equipo y cerrar operaciones sin otra factura mensual.
			</p>
		<p class="sectionLead">
Cuando quieras ir más rápido, destacar o crear tu propia web de agencia, activa las herramientas opcionales. Úsalas solo cuando de verdad te ayuden: flujos automatizados que ahorran horas, impulsos de marketing que ganan captaciones, y analíticas que te ayudan a fijar precios y presentar con confianza.
			</p>

		<div class="wbHeroCard">
			<div class="wbHeroInner">
				<div class="wbHeroText">
					<div class="wbBadge">Seis pipelines - tres de ellos gratis</div>
					<h3 class="wbHeadline">Casi ninguna operación se pierde.<br />Nadie hizo el seguimiento.</h3>
					<p class="wbSub">
						Leads, Sellers y Property funcionan gratis y sin límite. Un lead recibe respuesta en cuanto entra, se te escribe
						el plan de seguimiento, y un anuncio que se queda quieto crea su propia tarea de revisión de precio.<br />
						Todo hasta cualificar a un comprador es gratis. Tú decides cuáles merecen un crédito, y decir que no no te cuesta
						nada.<br />
						Los clientes antiguos se mantienen solos en <a href="/es/docs/propertylist-mls-manual-de-usuario/pipeline-and-tasks/nurture/" style="color:inherit;text-decoration:underline;font-weight:600">Nurture</a>,
						y a ti te llega el que acaba de mostrar interés.
					</p>
					<a href="/es/pipelines/" class="wbCta">Ver los seis pipelines &rarr;</a>
				</div>
			</div>
		</div>

		<div class="wbHeroCard">
			<div class="wbHeroInner">
				<div class="wbHeroText">
					<div class="wbBadge">Constructor de Webs - 50 créditos/mes</div>
					<h3 class="wbHeadline">Tu web de agencia.<br />Creada y escrita por IA.</h3>
					<p class="wbSub">
						Describe lo que quieres con tus palabras y la IA crea las páginas y redacta el contenido - tus anuncios, tu
						marca, sin necesidad de desarrollador.<br />
						Ajústala con drag-and-drop, previsualízala como un cliente gratis, y solo pagas y publicas cuando estés satisfecho.<br />
						Y sigue trabajando: <a href="/es/contenido-instantaneo/" style="color:inherit;text-decoration:underline;font-weight:600">Contenido Instantáneo</a> escribe blogs SEO y guías de zona a partir de tus propios inmuebles y precios verificados en notaría - para que posiciones sin escribir una palabra.
					</p>
					<a href="/es/website-builder/" class="wbCta">Ver cómo funciona &rarr;</a>
				</div>
				<div class="wbHeroImage">
					<img
						src="/email-images/originals/email-mock-website-builder.png"
						alt="Vista previa del Constructor de Webs de PropertyList"
						width="520"
						loading="lazy"
					/>
				</div>
			</div>
		</div>

		<div class="aiHeroCard">
			<div class="aiHeroInner">
				<div class="aiHeroText">
					<div class="aiBadge">Gratis - atajos con IA</div>
					<h3 class="aiHeadline">Olvida los formularios.<br />Solo habla, o escribe.</h3>
					<p class="aiSub">
						<strong>Publica con la voz:</strong> añade fotos y graba una nota de voz - PropertyList completa el tipo, tamaño,
						características y descripción para que la revises y publiques.<br />
						<strong>Busca escribiendo:</strong> describe lo que quiere un cliente con tus propias palabras y recibe las
						propiedades que coinciden, en el MLS y en el portal.
					</p>
					<div class="aiCtaRow">
						<a href="/es/listado-instantaneo/" class="aiCta">Prueba Instant Listing &rarr;</a>
						<a href="https://propertylist.es/" target="_blank" rel="noopener" class="aiCtaGhost">Buscar en el portal &rarr;</a>
						<a href="/es/busqueda-ia/" class="aiCtaGhost">Cómo funciona la búsqueda IA &rarr;</a>
					</div>
				</div>
				<div class="aiHeroDemo" aria-hidden="true">
					<div class="aiMock">
						<div class="aiMockTitle">&#127908; Publica con la voz</div>
						<div class="aiMockQuote">"Villa de tres habitaciones, Nueva Andalucía, piscina privada, vistas al mar..."</div>
						<div class="aiMockChips"><span>3 hab</span><span>Piscina</span><span>Vista al mar</span></div>
					</div>
					<div class="aiMock">
						<div class="aiMockTitle">&#128172; Busca escribiendo</div>
						<div class="aiMockQuote">"Villa de 3 habitaciones cerca de la playa, bajo 500.000 &euro;"</div>
						<div class="aiMockChips"><span>4 resultados</span><span>Marbella</span><span>480.000 &euro;</span></div>
					</div>
				</div>
			</div>
		</div>

		<div class="instantSuite">
			<div class="instantSuiteHead">
				<div class="instantBadge">La suite Instant</div>
				<h3 class="instantHeadline">Un clic. Marketing de nivel estudio.</h3>
				<p class="instantSub">Un conjunto creciente de herramientas de IA que convierten un inmueble en folletos, vídeos, renders y contenido - creados a partir de tus propias fotos y datos reales, nunca inventados. Añadimos nuevas a menudo.</p>
			</div>
			<div class="instantGrid">
				<a class="instantTile" href="/es/listado-instantaneo/">
					<span class="itTop"><span class="itIcon">&#127908;</span><span class="itTag isLive">Disponible</span></span>
					<span class="itName">Listado Instantáneo</span>
					<span class="itDesc">Fotos y una nota de voz se convierten en un anuncio completo listo para publicar.</span>
				</a>
				<a class="instantTile" href="/es/contenido-instantaneo/">
					<span class="itTop"><span class="itIcon">&#9997;&#65039;</span><span class="itTag isLive">Disponible</span></span>
					<span class="itName">Contenido Instantáneo</span>
					<span class="itDesc">Entradas de blog SEO y guías de zona escritas a partir de tus propios inmuebles.</span>
				</a>
				<a class="instantTile" href="/es/folleto-instantaneo/">
					<span class="itTop"><span class="itIcon">&#128196;</span><span class="itTag isSoon">Muy pronto</span></span>
					<span class="itName">Folleto Instantáneo</span>
					<span class="itDesc">Un PDF listo para imprimir y una página web en vivo de cualquier inmueble, en un clic.</span>
				</a>
				<a class="instantTile" href="/es/renovacion-instantanea/">
					<span class="itTop"><span class="itIcon">&#128736;&#65039;</span><span class="itTag isSoon">Muy pronto</span></span>
					<span class="itName">Renovación Instantánea</span>
					<span class="itDesc">Renders de antes y después con IA y estimaciones de coste locales y detalladas.</span>
				</a>
				<a class="instantTile" href="/es/video-instantaneo/">
					<span class="itTop"><span class="itIcon">&#127916;</span><span class="itTag isSoon">Muy pronto</span></span>
					<span class="itName">Vídeo Instantáneo</span>
					<span class="itDesc">Vídeos de inmueble, zona y mercado con tu marca en Full HD.</span>
				</a>
				<a class="instantTile" href="/es/imagenes-instantaneas/">
					<span class="itTop"><span class="itIcon">&#128247;</span><span class="itTag isSoon">Muy pronto</span></span>
					<span class="itName">Imágenes Instantáneas</span>
					<span class="itDesc">Atardecer, cambio de cielo, homestaging virtual y tarjetas para redes.</span>
				</a>
			</div>
		</div>

		<div style="display:flex;flex-wrap:wrap;gap:16px;">
			<div class="tile pricingTile" style="flex:1;min-width:300px;">
				<div class="pricingHeader">
					<h2 class="pricingTitle">Gratis, sin límite</h2>
					<div class="pricingBadge isFree">Gratis</div>
				</div>
				<ul style="list-style:none;margin:0;padding:0;">
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>El MLS compartido: publica una vez y toda la red puede venderla contigo</li>
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>El CRM: contactos y usuarios ilimitados, y los pipelines de Leads, Vendedores y Propiedades</li>
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>Tu MicroSite de marca, con alojamiento y sus consultas gratis para siempre</li>
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>Instant Listing: fotos y una nota de voz se convierten en un anuncio completo</li>
