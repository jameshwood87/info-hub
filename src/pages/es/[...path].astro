			const pathAttr = escapeHtml(n.path.toLowerCase());
			const manualRootAttr = n.path === mlsManualPath ? ' data-manual-root="1"' : '';
			const externalAttrs = ext ? ` target="${ext.target}" rel="${ext.rel}"` : '';

			// Single leaf child: link the section straight to that page (no dead-end section page).
			if (n.children.length === 1 && !n.children[0].children.length && n.children[0].hasPage) {
				const only = n.children[0];
				const onlyExt = externalDocLinkForPath(only.path);
				const onlyHref = escapeHtml(onlyExt?.href || only.path);
				const onlyAttrs = onlyExt ? ` target="${onlyExt.target}" rel="${onlyExt.rel}"` : '';
