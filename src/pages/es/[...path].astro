const findDocNode = (node: DocNode, target: string): DocNode | null => {
	if (node.path === target) return node;
	for (const c of node.children) {
		const hit = findDocNode(c, target);
		if (hit) return hit;
	}
	return null;
};

const manualTitleForHref = (hrefRaw: string, fallback: string) => {
	const raw = String(hrefRaw || '').trim();
	const path = raw.startsWith('http') ? String(new URL(raw).pathname || '') : raw;
	const clean = `/${String(path || '').replace(/^\/+/, '')}`.replace(/\/{2,}/g, '/').replace(/\/?$/, '/');
	const map: Record<string, string> = {
		'/es/docs/propertylist-mls-manual-de-usuario/': 'Manual de Usuario MLS & CRM',
		'/es/docs/leyes-procedimientos/': 'Leyes y procedimientos',
		'/es/docs/portal-publico/': 'Portal público',
		'/es/docs/developers/': 'Promotores',
		'/es/docs/property-services/': 'Servicios inmobiliarios',
	};
	return map[clean] || String(fallback || 'Docs');
};

const docsManualOptions = (() => {
	if (!isDocs) return [] as Array<{ title: string; href: string }>;
	const out: Array<{ title: string; href: string }> = [];
	const seen = new Set<string>();
	for (const n of docsRoot.children.filter((n) => n.hasPage)) {
		const ext = externalDocLinkForPath(n.path);
		const href = String(ext?.href || (strictEs ? n.path : toSpanishPath(n.path)));
		if (seen.has(href)) continue;
		seen.add(href);
		out.push({ title: manualTitleForHref(href, String(n.title || 'Docs')), href });
	}
	const pref = new Map(
		[
			'/es/docs/propertylist-mls-manual-de-usuario/',
			'/es/docs/leyes-procedimientos/',
			'/es/docs/portal-publico/',
			'/es/docs/developers/',
			'/es/docs/property-services/',
		].map((p, i) => [p, i] as const),
	);
	return out.sort((a, b) => {
		const ai = pref.has(a.href) ? (pref.get(a.href) as number) : Infinity;
		const bi = pref.has(b.href) ? (pref.get(b.href) as number) : Infinity;
		if (ai !== bi) return ai - bi;
		return a.title.localeCompare(b.title);
	});
})();

const currentManualHref = (() => {
	if (!isDocs) return '';
	if (!currentManualRoot) return '';
	const ext = externalDocLinkForPath(currentManualRoot);
	return String(ext?.href || (strictEs ? currentManualRoot : toSpanishPath(currentManualRoot)));
})();

const currentManualTitle = (() => {
	if (!isDocs) return '';
	if (!currentManualRoot) return 'Docs';
	const node = findDocNode(docsRoot, currentManualRoot);
