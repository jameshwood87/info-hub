})();

const mlsManualPath = strictEs ? '/es/docs/mls-manual-de-usuario/' : '/docs/propertylist-mls-user-manual/';
const manualOrderWeight = (node: DocNode): number => {
	const s = `${node.seg} ${node.title}`.toLowerCase();
	if (node.path === mlsManualPath) return 0;
	if (/\binicio\b|\bcomenz(ar|ando)\b|\bprimeros\b|\bconfiguraci(o|ó)n\b/.test(s)) return 10;
	if (/\bpanel\b|\bresumen\b|\binicio\b/.test(s)) return 20;
	if (/\bbuscar\b|\bb(us|ú)squeda\b|\bpropiedades\b/.test(s)) return 30;
	if (/\banuncios?\b|\balertas?\b/.test(s)) return 40;
	if (/\bleads?\b|\bcontactos?\b|\bpipeline\b|\bventas\b/.test(s)) return 50;
	if (/\bcontactos?\b|\bclientes?\b/.test(s)) return 60;
	if (/\bcalendario\b|\bcitas?\b|\btareas?\b/.test(s)) return 70;
	if (/\binformes?\b|\bestad(i|í)sticas\b|\ban(a|á)lisis\b/.test(s)) return 80;
	if (/\bsolicitudes?\b/.test(s)) return 90;
	if (/\bseguridad\b|\bpermisos?\b|\busuarios?\b|\bagencia\b|\bempresa\b|\bpersonal\b|\bcuenta\b/.test(s)) return 100;
	if (/\bai\b|\bautomatizaci(o|ó)n\b|\bintegraciones?\b/.test(s)) return 110;
	if (/\bt(e|é)cnico\b|\bapi\b/.test(s)) return 120;
	if (/\bvideo\b|\btutorial(es)?\b/.test(s)) return 130;
	if (/\brecursos?\b|\badicional(es)?\b/.test(s)) return 140;
	return 500;
};

const openDocPaths = (() => {
	const s = new Set<string>();
	if (!isDocs) return s;
	const currentPath = strictEs ? renderPath : englishPath;
	const rest = currentPath.slice(docsPrefix.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = docsPrefix;
	for (const seg of parts) {
		acc += `${seg}/`;
		s.add(acc);
	}
	return s;
})();

const filteredDocsChildren = (() => {
	if (!isDocs) return docsRoot.children;
	const q = navFilter.toLowerCase().trim();
	const manualNode = currentManualRoot ? findDocNode(docsRoot, currentManualRoot) : null;
	const base = manualNode?.children?.length ? manualNode.children : docsRoot.children;
	if (!q) return base;

	const filterTree = (nodes: DocNode[]): DocNode[] => {
		const out: DocNode[] = [];
		for (const n of nodes) {
			const label = `${n.seg} ${n.title}`.toLowerCase();
			const path = n.path.toLowerCase();
			const selfMatches = label.includes(q) || path.includes(q);
			const kids = filterTree(n.children);
			if (selfMatches || kids.length) out.push({ ...n, children: kids });
		}
		return out;
	};

	return filterTree(base);
})();

const currentTreePath = strictEs ? renderPath : englishPath;
const manualDepth = isDocs ? currentTreePath.slice(docsPrefix.length).split('/').filter(Boolean).length : 0;
const isMlsManualMainFolder = isDocs && currentTreePath.startsWith(mlsManualPath) && currentTreePath !== mlsManualPath && manualDepth === 2;
const folderArticles = (() => {
	if (!isMlsManualMainFolder) return [] as Array<{ href: string; title: string; description?: string | null; external: boolean }>;
	const findNode = (node: DocNode, target: string): DocNode | null => {
		if (node.path === target) return node;
		for (const c of node.children) {
			const hit = findNode(c, target);
			if (hit) return hit;
		}
		return null;
	};
	const node = findNode(docsRoot, currentTreePath);
	const children = node?.children || [];
	const out: Array<{ href: string; title: string; description?: string | null; external: boolean }> = [];
	for (const c of [...children].sort((a, b) => a.title.localeCompare(b.title))) {
		if (!c.hasPage) continue;
		const ext = externalDocLinkForPath(c.path);
		const href = ext?.href || (strictEs ? c.path : toSpanishPath(c.path));
		const title = String(c.title || '');
		const desc = strictEs ? (docsByPath.get(c.path)?.description ?? null) : (docsEsByEnPath.get(c.path)?.description ?? docsByPath.get(c.path)?.description ?? null);
		out.push({ href, title, description: desc, external: Boolean(ext) });
	}
	return out;
})();

const esTreeOrder = isDocs ? await getKbTreeOrderSnapshot() : null;
const orderOf = (() => {
	const m = new Map<string, number>();
	const pcx = (esTreeOrder as any)?.parentChildren || {};
	for (const parent of Object.keys(pcx)) {
		(pcx[parent] || []).forEach((c: string, i: number) => { if (!m.has(c)) m.set(c, i); });
	}
	return m;
})();

const docPager = (() => {
	if (!isDocs) {
		return {
			prev: siblingPrev ? { path: siblingPrev.path, title: siblingPrev.title, href: siblingPrev.path, external: false } : null,
			next: siblingNext ? { path: siblingNext.path, title: siblingNext.title, href: siblingNext.path, external: false } : null,
		};
	}

	const compare = (a: DocNode, b: DocNode, depth: number) => {
		if (depth === 0 && currentManualRoot) {
			const aIsCurrent = a.path === currentManualRoot;
			const bIsCurrent = b.path === currentManualRoot;
			if (aIsCurrent !== bIsCurrent) return aIsCurrent ? -1 : 1;
		}
		const _ao = orderOf.get(a.path); const _bo = orderOf.get(b.path); if (_ao != null || _bo != null) { if (_ao == null) return 1; if (_bo == null) return -1; if (_ao !== _bo) return _ao - _bo; } const aInMls = a.path.startsWith(mlsManualPath);
		const bInMls = b.path.startsWith(mlsManualPath);
		if (depth === 1 && aInMls && bInMls) {
			const aw = manualOrderWeight(a);
			const bw = manualOrderWeight(b);
			if (aw !== bw) return aw - bw;
		}
		return a.title.localeCompare(b.title);
	};

	const sortNodes = (nodes: DocNode[], depth: number) => [...nodes].sort((a, b) => compare(a, b, depth));

	const manualNode = currentManualRoot ? findDocNode(docsRoot, currentManualRoot) : null;
	const base = manualNode?.children?.length ? manualNode.children : docsRoot.children;
	const currentTreePath = strictEs ? renderPath : englishPath;
	const seq: Array<{ nodePath: string; title: string; href: string; external: boolean }> = [];

	const walk = (nodes: DocNode[], depth: number) => {
		for (const n of sortNodes(nodes, depth)) {
			if (n.hasPage) {
				const ext = externalDocLinkForPath(n.path);
				const href = String(ext?.href || (strictEs ? n.path : toSpanishPath(n.path)));
				seq.push({ nodePath: n.path, title: String(n.title || ''), href, external: Boolean(ext) });
			}
			if (n.children?.length) walk(n.children, depth + 1);
		}
	};
	walk(base, 0);

	const idx = seq.findIndex((p) => p.nodePath === currentTreePath);
	return {
		prev: idx > 0 ? seq[idx - 1] : null,
		next: idx >= 0 && idx < seq.length - 1 ? seq[idx + 1] : null,
	};
})();

const prev = docPager.prev;
const next = docPager.next;

const renderDocNavHtml = (nodes: DocNode[], depth = 0, forceOpen = false): string =>
	[...nodes]
		.sort((a, b) => {
			if (depth === 0 && currentManualRoot) {
				const aIsCurrent = a.path === currentManualRoot;
				const bIsCurrent = b.path === currentManualRoot;
				if (aIsCurrent !== bIsCurrent) return aIsCurrent ? -1 : 1;
			}
			const _ao = orderOf.get(a.path); const _bo = orderOf.get(b.path); if (_ao != null || _bo != null) { if (_ao == null) return 1; if (_bo == null) return -1; if (_ao !== _bo) return _ao - _bo; } const aInMls = a.path.startsWith(mlsManualPath);
			const bInMls = b.path.startsWith(mlsManualPath);
			if (depth === 1 && aInMls && bInMls) {
				const aw = manualOrderWeight(a);
				const bw = manualOrderWeight(b);
				if (aw !== bw) return aw - bw;
			}
			return a.title.localeCompare(b.title);
		})
		.map((n) => {
			const isCurrent = strictEs ? n.path === renderPath : n.path === englishPath;
			const isOpen = forceOpen || openDocPaths.has(n.path);
			const title = escapeHtml(n.title || '');
			const label = escapeHtml((n.title || '').toLowerCase());
			const ext = externalDocLinkForPath(n.path);
			const href = escapeHtml(ext?.href || (strictEs ? n.path : toSpanishPath(n.path)));
			const pathAttr = escapeHtml(n.path.toLowerCase());
			const manualRootAttr = n.path === mlsManualPath ? ' data-manual-root="1"' : '';
			const externalAttrs = ext ? ` target="${ext.target}" rel="${ext.rel}"` : '';

			if (n.children.length) {
				const kids = renderDocNavHtml(n.children, depth + 1, forceOpen);
				const summaryInner = n.hasPage
					? `<a class="docNavSummaryLink" href="${href}"${externalAttrs}>${title}</a>`
					: `<span class="docNavSummaryText">${title}</span>`;
				return `<li class="docNavNode" data-doc-nav-node="1" data-depth="${depth}" data-label="${label}" data-path="${pathAttr}"${manualRootAttr}><details class="docNavGroup" ${
					isOpen ? 'open' : ''
				} data-default-open="${isOpen ? '1' : '0'}"><summary class="docNavSummary${isCurrent ? ' active' : ''}">${summaryInner}</summary><ul class="docNavList">${kids}</ul></details></li>`;
			}

			if (n.hasPage) {
				return `<li class="docNavItem" data-doc-nav-node="1" data-depth="${depth}" data-label="${label}" data-path="${pathAttr}"${manualRootAttr}><a class="docNavLink${isCurrent ? ' active' : ''}" href="${href}"${externalAttrs}>${title}</a></li>`;
			}

			return `<li class="docNavItem" data-doc-nav-node="1" data-depth="${depth}" data-label="${label}" data-path="${pathAttr}"${manualRootAttr}><span class="docNavLabel">${title}</span></li>`;
		})
		.join('');

const extractSteps = (html: string) => {
	const m = html.match(/<ol[^>]*>([\s\S]*?)<\/ol>/i);
	if (!m) return [];
	const olInner = m[1] || '';
	const steps: string[] = [];
	const liRe = /<li[^>]*>([\s\S]*?)<\/li>/gi;
	let hit: RegExpExecArray | null = null;
	while ((hit = liRe.exec(olInner))) {
		const text = stripTags(hit[1] || '').replace(/\s+/g, ' ').trim();
		if (text) steps.push(text);
		if (steps.length >= 10) break;
	}
	return steps;
};

