---
import Layout from '../../layouts/Layout.astro';
import wpSlugMap from '../../data/wp-slug-map.json';
import { areaImagePath } from '../../lib/areaImages';
import { canonicalAreaPath } from '../../lib/areaProvince';
import AreaGuide from '../../components/AreaGuide.astro';
import AreaPage from '../../components/AreaPage.astro';
import { getKbPageByPath, listKbPagesByPrefix, listKbPagesByPrefixes } from '../../lib/directus';
import { getKbTreeOrderSnapshot } from '../../lib/kbTreeOrder';
import { getKbMeta } from '../../lib/adminMeta';
import { searchProperties, enrichListingPrices, type MarketListing } from '../../lib/marketData';
import PropertyCard from '../../components/PropertyCard.astro';
import { listPrefixRedirects } from '../../lib/kbRedirects';
import { getTotalViewCounts } from '../../lib/weeklyViews';
import { canTranslateWithDeepL, deeplTranslate, deeplTranslateHtml } from '../../lib/deepl';
import mlsManualArchive from '../../data/mls-manual-archive.json';

// Hrefs left behind by the WordPress import that point at routes this site never
// rebuilt. Both forms show up in the bodies: root-relative and absolute on our own
// host. Anything else (a real external link) is left alone.
const DEAD_TAXONOMY_HREF = /^(?:https?:\/\/(?:www\.)?info\.propertylist\.es)?\/(?:es\/)?(?:categoria|category)\//i;
const DEAD_DATE_ARCHIVE_HREF = /^(?:https?:\/\/(?:www\.)?info\.propertylist\.es)?\/(?:es\/)?20\d\d\/\d\d\/\d\d\//i;

const rawPath = Astro.params.path ?? '';
const requestUrl = new URL(Astro.request.url);
const normalizedPathProp = typeof (Astro.props as any)?.normalizedPath === 'string' ? String((Astro.props as any).normalizedPath) : '';
const defaultRawNormalizedPath = `/es/${rawPath.replace(/^\/+|\/+$/g, '')}/`;
const rawNormalizedPath = (normalizedPathProp || defaultRawNormalizedPath).replace(/\/{2,}/g, '/').replace(/\/?$/, '/');
const shareMode = rawNormalizedPath.startsWith('/es/share/');
const normalizedPath = shareMode ? `/es/${rawNormalizedPath.slice('/es/share/'.length)}`.replace(/^\/+/, '/') : rawNormalizedPath;
const clientMode = requestUrl.searchParams.get('client') === '1' || shareMode;
const isArea = normalizedPath.startsWith('/es/andalucia/');

const normaliseEsDocsPath = (p: string) => {
	const path = String(p || '');
	if (!path.startsWith('/es/docs/')) return path;
	const parts = path.split('/').filter(Boolean);
	if (parts[0] !== 'es' || parts[1] !== 'docs') return path;
	const root = parts[2] || '';
	const mappedRoot =
		root === 'propertylist-mls-user-manual'
			? 'propertylist-mls-manual-de-usuario'
			: root === 'mls-manual-de-usuario'
				? 'propertylist-mls-manual-de-usuario'
			: root === 'laws-procedures'
				? 'leyes-procedimientos'
				: root === 'public-portal'
					? 'portal-publico'
					: root === 'getting-started'
						? 'empezar'
						: root;
	parts[2] = mappedRoot;
	if (mappedRoot === 'propertylist-mls-manual-de-usuario') {
		const sub = parts[3] || '';
		if (sub === 'getting-started') parts[3] = 'empezar';
	}
	return `/${parts.join('/')}/`;
};

const canonicalEsDocsPath = normaliseEsDocsPath(normalizedPath);
if (canonicalEsDocsPath !== normalizedPath) {
	return new Response(null, { status: 301, headers: { Location: `${canonicalEsDocsPath}${requestUrl.search}` } });
}

const mapPairs: Array<{ en: string; es: string }> = [
	{ en: '/general-information/', es: '/es/informacion-general/' },
	{ en: '/blog/', es: '/es/blog/' },
	{ en: '/community/', es: '/es/comunidad/' },
	{ en: '/laws/', es: '/es/leyes/' },
	{ en: '/neighbourhood/', es: '/es/barrios/' },
	{ en: '/andalucia/', es: '/es/andalucia/' },
	{ en: '/pricing/', es: '/es/precios/' },
	{ en: '/search', es: '/es/search' },
];

const toEnglishPath = (p: string) => {
	const path = String(p || '');
	if (!path.startsWith('/es/')) return path;
	// WordPress-era articles have different slugs per language; the map is
	// built from the TranslatePress switcher links embedded in the imported
	// bodies and every pair is verified 200 both ways. Without it the prefix
	// swap below keeps the Spanish slug and the en-hreflang 404s.
	{ const _n = path.endsWith('/') ? path : path + '/'; const _m = (wpSlugMap as Record<string, string>)[_n]; if (_m) return _m; }
	const withoutEs = path.replace(/^\/es\//, '/');
	{ const _n = path.endsWith('/') ? path : path + '/'; if (_n === '/es/blog/como-evitar-estafas-inmobiliarias-en-espana/') return '/blog/how-to-avoid-property-scams-in-spain/'; }
	if (withoutEs.startsWith('/informacion-general/')) {
		return withoutEs.replace(/^\/informacion-general\//, '/general-information/');
	}
	if (withoutEs.startsWith('/barrios/')) {
		const parts = withoutEs.split('/').filter(Boolean);
		if (parts.length === 2) {
			const slug = parts[1] || '';
			return slug ? canonicalAreaPath(slug) : withoutEs;
		}
	}
	if (withoutEs.startsWith('/docs/')) {
		const parts = withoutEs.split('/').filter(Boolean);
		if (parts[0] !== 'docs') return withoutEs;
		const seg = parts[1] || '';
		const mapped =
			seg === 'propertylist-mls-manual-de-usuario'
				? 'propertylist-mls-user-manual'
				: seg === 'mls-manual-de-usuario'
					? 'propertylist-mls-user-manual'
				: seg === 'leyes-procedimientos'
					? 'laws-procedures'
					: seg === 'portal-publico'
						? 'public-portal'
						: seg === 'empezar'
							? 'getting-started'
							: seg;
		parts[1] = mapped;
		if (mapped === 'propertylist-mls-user-manual') {
			const sub = parts[2] || '';
			if (sub === 'empezar') parts[2] = 'getting-started';
		}
		return `/${parts.join('/')}/`;
	}
	for (const pair of mapPairs) {
		if (path.startsWith(pair.es)) return `${pair.en}${path.slice(pair.es.length)}`;
	}
	return withoutEs;
};

const toSpanishPath = (p: string) => {
	const path = String(p || '');
	if (path.startsWith('/neighbourhood/')) {
		const parts = path.split('/').filter(Boolean);
		if (parts[0] === 'neighbourhood' && parts.length === 4) {
			const slug = parts[3] || '';
			if (slug) return `/es/barrios/${slug}/`;
		}
	}
	for (const pair of mapPairs) {
		if (path.startsWith(pair.en)) return `${pair.es}${path.slice(pair.en.length)}`;
	}
	if (!path.startsWith('/docs/')) return `/es${path.startsWith('/') ? path : `/${path}`}`;
	const parts = path.split('/').filter(Boolean);
	if (parts[0] !== 'docs') return `/es/${parts.join('/')}/`;
	const seg = parts[1] || '';
	const mapped =
		seg === 'propertylist-mls-user-manual'
			? 'propertylist-mls-manual-de-usuario'
			: seg === 'mls-manual-de-usuario'
				? 'propertylist-mls-manual-de-usuario'
			: seg === 'laws-procedures'
				? 'leyes-procedimientos'
				: seg === 'public-portal'
					? 'portal-publico'
					: seg === 'getting-started'
						? 'empezar'
						: seg;
	parts[1] = mapped;
	if (mapped === 'propertylist-mls-manual-de-usuario') {
		const sub = parts[2] || '';
		if (sub === 'getting-started') parts[2] = 'empezar';
	}
	return `/es/${parts.join('/')}/`;
};

const strictEs = false;

const esRuntimeTranslationCache: Map<string, any> = ((globalThis as any).__plEsRuntimeTranslationCache =
	(globalThis as any).__plEsRuntimeTranslationCache || new Map());
const esNeighbourhoodGuideCache: Map<string, string> = ((globalThis as any).__plEsNeighbourhoodGuideCache =
	(globalThis as any).__plEsNeighbourhoodGuideCache || new Map());

const translateEnKbPageToEs = async (pageEn: any, targetPath: string) => {
	const cacheKey = `${String(pageEn?.id || '')}::${String(pageEn?.path || '')}::${String(targetPath || '')}`;
	const cached = esRuntimeTranslationCache.get(cacheKey);
	if (cached !== undefined) return cached;
	const titleSrc = String(pageEn?.seo_title || pageEn?.title || '');
	const descSrc = String(pageEn?.seo_description || pageEn?.description || '');
	const bodySrc = String(pageEn?.body || '');

	let translatedTitle = '';
	let translatedDesc = '';
	let translatedBody = '';
	try {
		translatedTitle = titleSrc ? await deeplTranslate(titleSrc) : '';
		translatedDesc = descSrc ? await deeplTranslate(descSrc) : '';
		translatedBody = bodySrc ? await deeplTranslateHtml(bodySrc) : '';
	} catch {
		// Translation unavailable (the DeepL key has been returning 403 since at least
		// 2026-08-03). Do NOT fabricate a Spanish page here: the old placeholder made
		// pageEsResolved truthy, so isFallback stayed false and the URL shipped
		// index,follow with a self-referencing ES canonical over an empty body - 29 ES
		// docs URLs were in that state. Returning null falls through to the EN page,
		// which is already wired to emit noindex,follow + an English canonical.
		// Negative-cached so a dead key costs one API attempt per page per process,
		// not one per request; a restart re-tries.
		esRuntimeTranslationCache.set(cacheKey, null);
		return null;
	}

	const pageEs = {
		id: `runtime-es-${String(pageEn?.id || '') || String(targetPath || '').replace(/[^a-z0-9]+/gi, '-').replace(/^-+|-+$/g, '').slice(0, 80)}`,
		status: 'published',
		language: 'es',
		path: targetPath,
		title: translatedTitle || String(pageEn?.title || ''),
		description: translatedDesc || null,
		body: translatedBody || '',
		seo_title: translatedTitle || null,
		seo_description: translatedDesc || null,
	} as any;
	esRuntimeTranslationCache.set(cacheKey, pageEs);
	return pageEs;
};
const prefixRedirects = (await listPrefixRedirects().catch(() => []))
	.map((r) => ({ from: String(r?.from || ''), to: String(r?.to || '') }))
	.filter((r) => r.from && r.to)
	.sort((a, b) => b.from.length - a.from.length);
const applyPrefixRedirect = (pRaw: string) => {
	const raw = String(pRaw || '');
	if (!raw.startsWith('/')) return raw;
	const u = raw.split('#');
	const beforeHash = u[0] || '';
	const hash = u.length > 1 ? `#${u.slice(1).join('#')}` : '';
	const q = beforeHash.split('?');
	const pathOnly = q[0] || '';
	const query = q.length > 1 ? `?${q.slice(1).join('?')}` : '';
	const pn = pathOnly.replace(/\/{2,}/g, '/');
	const withSlash = pn.endsWith('/') || /\/[^/]+\.[a-z0-9]{1,8}$/i.test(pn) ? pn : `${pn}/`;
	for (const r of prefixRedirects) {
		if (!withSlash.startsWith(r.from)) continue;
		const rest = withSlash.slice(r.from.length);
		const next = `${r.to}${rest}`;
		return `${next}${query}${hash}`;
	}
	return `${withSlash}${query}${hash}`;
};
const isMlsManualEsPath = normalizedPath.startsWith('/es/docs/propertylist-mls-manual-de-usuario/');

const looksLikeEnglish = (html: string | null | undefined) => {
	const strip = (s: string) => String(s || '').replace(/<[^>]+>/g, ' ');
	const decode = (s: string) =>
		String(s || '').replace(/&(#x[0-9a-f]+|#\d+|[a-z0-9]+);/gi, (m: string, entRaw: string) => {
			const ent = String(entRaw || '').toLowerCase();
			if (ent === 'amp') return '&';
			if (ent === 'lt') return '<';
			if (ent === 'gt') return '>';
			if (ent === 'quot') return '"';
			if (ent === 'apos' || ent === '#39') return "'";
			if (ent === 'nbsp') return ' ';
			if (ent.startsWith('#x')) {
				const cp = Number.parseInt(ent.slice(2), 16);
				if (Number.isFinite(cp) && cp > 0) return String.fromCodePoint(cp);
				return m;
			}
			if (ent.startsWith('#')) {
				const cp = Number.parseInt(ent.slice(1), 10);
				if (Number.isFinite(cp) && cp > 0) return String.fromCodePoint(cp);
				return m;
			}
			return m;
		});
	const text = decode(strip(String(html || '')))
		.toLowerCase()
		.replace(/\s+/g, ' ')
		.trim();
	if (!text.trim()) return false;
	const enWords = [
		'the',
		'and',
		'for',
		'with',
		'this',
		'that',
		'you',
		'your',
		'how',
		'what',
		'where',
		'when',
		'click',
		'account',
		'create',
		'import',
		'add',
		'adding',
		'edit',
		'manage',
		'contact',
		'listings',
		'listing',
		'properties',
		'property',
		'generate',
		'report',
		'reports',
		'export',
		'search',
		'calendar',
		'tasks',
		'task',
		'schedule',
		'support',
		'ticket',
		'leads',
		'contacts',
	];
	const esWords = [
		'el',
		'la',
		'los',
		'las',
		'de',
		'del',
		'y',
		'para',
		'con',
		'como',
		'cómo',
		'cuenta',
		'anuncio',
		'anuncios',
		'propiedad',
		'propiedades',
		'contacto',
		'contactos',
		'calendario',
		'tareas',
		'soporte',
		'ticket',
		'leads',
	];
	const hasWord = (w: string) => text === w || text.includes(` ${w} `) || text.startsWith(`${w} `) || text.endsWith(` ${w}`);
	const enHits = enWords.reduce((acc, w) => acc + (hasWord(w) ? 1 : 0), 0);
	const esHits = esWords.reduce((acc, w) => acc + (hasWord(w) ? 1 : 0), 0);
	return enHits >= 4 && enHits > esHits + 1;
};

const stripTagsForTitle = (html: string) => String(html || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const titleFromHtml = (html: string | null | undefined) => {
	const src = String(html || '');
	const m = src.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
	if (!m) return '';
	return stripTagsForTitle(m[1] || '');
};

// Legacy hand-written ES stubs for MLS-manual paths that have no Directus page yet.
// Only fires when there is no published ES page at the path AND an EN twin exists,
// so an entry whose path now redirects, 404s, or has a real ES page can never be
// reached. Trimmed 2026-08-03 from 51 to 27 entries: the 24 removed were verified
// unreachable (11 redirected away, 10 shadowed by a real page, 2 dead).
// TRAP when re-probing: the EN twin that satisfies the gate may come from
// src/data/mls-manual-archive.json, not Directus - /security/ was removed on that
// mistake and restored the same day. Also do not detect 'is this stub live?' by
// searching for a <p> sentence: several stubs are <h2>+<ul> only. mlsManualBackfillEsNavItems
// does NOT reach the sidebar (strictEs is false, so the merge is dead) - these entries
// only affect page bodies. Fall-through when an entry is missing is DeepL, whose key is
