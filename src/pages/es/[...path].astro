const stripTags = (html: string) => String(html || '').replace(/<[^>]+>/g, '');
const decodeHtmlEntities = (s: string) =>
	String(s || '').replace(/&(#x[0-9a-f]+|#\d+|[a-z0-9]+);/gi, (m: string, entRaw: string) => {
		const ent = String(entRaw || '').toLowerCase();
		if (ent === 'amp') return '&';
		if (ent === 'lt') return '<';
		if (ent === 'gt') return '>';
		if (ent === 'quot') return '"';
		if (ent === 'apos' || ent === '#39') return "'";
		if (ent === 'nbsp') return ' ';
		if (ent.startsWith('#x')) {
			const cp = Number.parseInt(ent.slice(2), 16);
			if (Number.isFinite(cp) && cp > 0) return String.fromCodePoint(cp);
			return m;
		}
		if (ent.startsWith('#')) {
			const cp = Number.parseInt(ent.slice(1), 10);
			if (Number.isFinite(cp) && cp > 0) return String.fromCodePoint(cp);
			return m;
		}
		return m;
	});
const slugify = (s: string) =>
	stripTags(s)
		.toLowerCase()
		.normalize('NFKD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/&[a-z0-9#]+;/gi, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '')
		.slice(0, 80);

const escapeHtml = (s: string) =>
	String(s || '')
		.replaceAll('&', '&amp;')
		.replaceAll('<', '&lt;')
		.replaceAll('>', '&gt;')
		.replaceAll('"', '&quot;')
		.replaceAll("'", '&#39;');

