const looksEnglishForEsGate = (html: string | null | undefined) => {
	const text = String(html || '').replace(/<[^>]*>/g, ' ').toLowerCase();
	const enWords = [
		'the',
		'and',
		'for',
		'with',
		'to',
		'from',
		'this',
		'that',
		'you',
		'your',
		'are',
		'not',
		'guide',
		'neighbourhood',
		'market',
		'buyers',
		'renters',
	];
	const esWords = ['de', 'la', 'el', 'y', 'para', 'con', 'este', 'esta', 'que', 'tu', 'tus', 'guía', 'barrio', 'mercado', 'compradores', 'inquilinos'];

	const count = (words: string[]) => {
		let n = 0;
		for (const w of words) {
			const re = new RegExp(`\\b${w.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}\\b`, 'g');
			const m = text.match(re);
			if (m) n += m.length;
		}
		return n;
	};

	const en = count(enWords);
	const es = count(esWords);
	if (es === 0 && en > 0) return true;
	return en >= es * 1.8 && en >= 25;
};

