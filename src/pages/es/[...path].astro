	};

	const sortNodes = (nodes: DocNode[], depth: number) => [...nodes].sort((a, b) => compare(a, b, depth));

	const manualNode = currentManualRoot ? findDocNode(docsRoot, currentManualRoot) : null;
	const base = manualNode?.children?.length ? manualNode.children : docsRoot.children;
	const currentTreePath = strictEs ? renderPath : englishPath;
	const seq: Array<{ nodePath: string; title: string; href: string; external: boolean }> = [];

	const walk = (nodes: DocNode[], depth: number) => {
		for (const n of sortNodes(nodes, depth)) {
			if (n.hasPage) {
				const ext = externalDocLinkForPath(n.path);
				const href = String(ext?.href || (strictEs ? n.path : toSpanishPath(n.path)));
				seq.push({ nodePath: n.path, title: String(n.title || ''), href, external: Boolean(ext) });
			}
			if (n.children?.length) walk(n.children, depth + 1);
