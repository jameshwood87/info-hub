		</div>
	</article>

	{isDocs ? (
		<button class="docNavStickyTag" type="button" data-doc-nav-open aria-label="Abrir filtros">
			<span class="docNavStickyIcon" aria-hidden="true">≡</span>
			<span class="docNavStickyText">Filtros</span>
		</button>
	) : null}
	{isDocs ? (
		<div class="docNavOverlay" data-doc-nav-overlay hidden>
			<div class="docNavDrawer" role="dialog" aria-modal="true" aria-label="Explorar manual">
				<div class="docNavDrawerTop">
					<div class="docNavDrawerHeader">
						<div class="docNavDrawerTitle">{currentManualTitle || 'Docs'}</div>
						<button class="docNavDrawerClose" type="button" data-doc-nav-close aria-label="Cerrar">
							Cerrar
						</button>
					</div>
					<form class="docNavFilterRow" method="get">
						<input
							id="doc-nav-filter-mobile"
							class="docNavFilterInput"
							type="search"
							autocomplete="off"
							spellcheck="false"
							placeholder="Filtrar este manual…"
							aria-label="Filtrar este manual"
							data-doc-nav-filter="mobile"
							name="filter"
							value={navFilter}
						/>
						<button type="submit" hidden>
							Aplicar
						</button>
					</form>
				</div>
				<nav class="docNavDrawerBody" aria-label="Navegación de docs" data-current-manual-root={currentManualRoot || ''}>
					<ul class="docNavList">
						<Fragment set:html={renderDocNavHtml(filteredDocsChildren, 0, Boolean(navFilter))} />
					</ul>
				</nav>
			</div>
		</div>
	) : null}
	{isDocs ? (
		<script
			is:inline
			set:html={String.raw`(() => {
  const openBtns = Array.from(document.querySelectorAll('[data-doc-nav-open]'));
  let lastOpenBtn = openBtns.find((x) => x instanceof HTMLElement) || null;
  const overlay = document.querySelector('[data-doc-nav-overlay]');
  const drawer = overlay?.querySelector('.docNavDrawer');
  const drawerScroll = drawer instanceof HTMLElement ? drawer : null;
  const closeBtn = overlay?.querySelector('[data-doc-nav-close]');
  const mobileMq = window.matchMedia('(max-width: 960px)');
  const desktopNav = document.querySelector('.docNav');
  const drawerBody = overlay?.querySelector('.docNavDrawerBody');
  const manualSelect = document.querySelector('[data-doc-manual-select]');
  const getInputs = () => Array.from(document.querySelectorAll('input[data-doc-nav-filter]')).filter((x) => x instanceof HTMLInputElement);

  const getActiveEl = (container) => {
    if (!(container instanceof HTMLElement)) return null;
    const hits = Array.from(container.querySelectorAll('.docNavLink.active, .docNavSummary.active, .docNavSummaryLink.active')).filter(
      (x) => x instanceof HTMLElement,
    );
    if (!hits.length) return null;
    let best = hits[0];
    let bestDepth = -1;
    for (const el of hits) {
      const node = el.closest('[data-depth]');
      const d = node ? Number.parseInt(node.getAttribute('data-depth') || '0', 10) : 0;
      if (d > bestDepth) {
        bestDepth = d;
        best = el;
      } else if (d === bestDepth) {
        best = el;
      }
    }
    return best;
  };

  const scrollToActive = (container) => {
    if (!(container instanceof HTMLElement)) return;
    const active = getActiveEl(container);
    if (!(active instanceof HTMLElement)) return;
    const parentGroups = [];
    let d = active.closest('details.docNavGroup');
    while (d instanceof HTMLDetailsElement) {
      parentGroups.push(d);
      d = d.parentElement?.closest('details.docNavGroup');
    }
    for (const g of parentGroups) g.open = true;
    const c = container.getBoundingClientRect();
    const a = active.getBoundingClientRect();
    const header = container.querySelector('.docNavHeader');
    const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
    const delta = a.top - c.top - headerHeight - container.clientHeight * 0.35;
    container.scrollTop = Math.max(0, container.scrollTop + delta);
  };

  const STORAGE_KEY = 'docNavScrollTargetV1';
  const normalisePath = (href) => {
    try {
      const u = new URL(String(href || ''), window.location.origin);
      const p = u.pathname || '/';
      return p.endsWith('/') ? p : p + '/';
    } catch {
      return null;
    }
  };

  const scrollElementToTop = (container, el) => {
    if (!(container instanceof HTMLElement)) return;
    if (!(el instanceof HTMLElement)) return;
    const c = container.getBoundingClientRect();
    const a = el.getBoundingClientRect();
    const header = container.querySelector('.docNavHeader');
    const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
    const delta = a.top - c.top - headerHeight - 8;
    container.scrollTop = Math.max(0, container.scrollTop + delta);
  };

  const scrollToStoredTarget = (container) => {
    if (!(container instanceof HTMLElement)) return false;
    const target = sessionStorage.getItem(STORAGE_KEY);
    if (!target) return false;
    const current = normalisePath(window.location.pathname);
    if (!current || current !== target) return false;
    sessionStorage.removeItem(STORAGE_KEY);
    const links = Array.from(container.querySelectorAll('a.docNavLink, a.docNavSummaryLink'));
    const hit = links.find((a) => normalisePath(a.getAttribute('href')) === target);
    if (hit instanceof HTMLElement) {
      scrollElementToTop(container, hit);
      return true;
    }
    const active = getActiveEl(container);
    if (active instanceof HTMLElement) {
      scrollElementToTop(container, active);
      return true;
    }
    return false;
  };

  const ensureScrolledToActive = (container, tries = 0) => {
    if (!(container instanceof HTMLElement)) return;
    if (tries === 0 && scrollToStoredTarget(container)) return;
    scrollToActive(container);
    const active = getActiveEl(container);
    if (active instanceof HTMLElement) {
      const c = container.getBoundingClientRect();
      const a = active.getBoundingClientRect();
      const header = container.querySelector('.docNavHeader');
      const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
      const visible = a.top >= c.top + headerHeight + 10 && a.bottom <= c.bottom - 10;
      if (visible) return;
    }
    if (tries >= 10) return;
    setTimeout(() => ensureScrolledToActive(container, tries + 1), 60);
  };

  const setOpen = (next) => {
    if (!(overlay instanceof HTMLElement)) return;
    const canOpen = mobileMq.matches;
    const effective = Boolean(next && canOpen);
    overlay.hidden = !effective;
    document.documentElement.classList.toggle('docNavLock', effective);
    if (next && drawer instanceof HTMLElement) drawer.focus?.();
    if (!next && lastOpenBtn instanceof HTMLElement) lastOpenBtn.focus?.();
    if (next && drawerScroll instanceof HTMLElement) requestAnimationFrame(() => ensureScrolledToActive(drawerScroll, 0));
  };

  setOpen(false);
  mobileMq.addEventListener?.('change', () => setOpen(false));
  window.addEventListener?.('pageshow', (e) => {
    if (e?.persisted) setOpen(false);
  });
  window.addEventListener?.('hashchange', () => setOpen(false));

  if (desktopNav instanceof HTMLElement) {
    requestAnimationFrame(() => ensureScrolledToActive(desktopNav, 0));
    window.addEventListener('load', () => ensureScrolledToActive(desktopNav, 0), { once: true });
  }

  if (manualSelect instanceof HTMLSelectElement) {
    manualSelect.addEventListener('change', () => {
      const href = String(manualSelect.value || '');
      if (!href) return;
      const next = normalisePath(href);
      if (next) sessionStorage.setItem(STORAGE_KEY, next);
      window.location.assign(href);
    });
  }

  const restoreDefaults = (container) => {
    if (!(container instanceof HTMLElement)) return;
    const groups = Array.from(container.querySelectorAll('details.docNavGroup'));
    for (const d of groups) {
      const val = d.getAttribute('data-default-open') || '0';
      d.open = val === '1';
    }
  };

  const applyTo = (container, qRaw) => {
    if (!(container instanceof HTMLElement)) return;
    const nodes = Array.from(container.querySelectorAll('[data-doc-nav-node]'));
    const groups = Array.from(container.querySelectorAll('details.docNavGroup'));
    const manualRoot = (container.getAttribute('data-current-manual-root') || '').toLowerCase();
    const q = String(qRaw || '').trim().toLowerCase();
    if (!q) {
      for (const el of nodes) {
        el.hidden = false;
        if (el instanceof HTMLElement) el.style.removeProperty('display');
      }
      restoreDefaults(container);
      return;
    }

    for (const el of nodes) {
      const label = (el.getAttribute('data-label') || '').toLowerCase();
      const path = (el.getAttribute('data-path') || '').toLowerCase();
      const text = (el.textContent || '').toLowerCase();
      const withinManual = !manualRoot || path.startsWith(manualRoot);
      const matches = label.includes(q) || path.includes(q) || text.includes(q);
      const hide = !withinManual || !matches;
      el.hidden = hide;
      if (el instanceof HTMLElement) el.style.display = hide ? 'none' : '';
    }

    for (let i = nodes.length - 1; i >= 0; i--) {
      const el = nodes[i];
      const hasVisibleChild = Array.from(el.querySelectorAll('[data-doc-nav-node]')).some((c) => c !== el && !c.hidden);
      if (hasVisibleChild) el.hidden = false;
    }

    for (const d of groups) {
      const hasVisible = Array.from(d.querySelectorAll('[data-doc-nav-node]')).some((c) => !c.hidden);
      d.open = hasVisible;
    }
  };

  const scrollToFirstVisible = (container) => {
    if (!(container instanceof HTMLElement)) return;
    const link = Array.from(container.querySelectorAll('a.docNavLink, a.docNavSummaryLink')).find((a) => a instanceof HTMLElement && !a.closest('[hidden]'));
    if (!(link instanceof HTMLElement)) return;
    const c = container.getBoundingClientRect();
    const a = link.getBoundingClientRect();
    const delta = a.top - c.top - container.clientHeight * 0.25;
    container.scrollTop = Math.max(0, container.scrollTop + delta);
  };

  const onInput = (ev) => {
    const src = ev?.target;
    if (!(src instanceof HTMLInputElement)) return;
    if (!src.matches('input[data-doc-nav-filter]')) return;
    const inputs = getInputs();
    for (const other of inputs) {
      if (other instanceof HTMLInputElement && other !== src) other.value = src.value;
    }
    applyTo(desktopNav, src.value);
    applyTo(drawerBody, src.value);
    const mode = src.getAttribute('data-doc-nav-filter');
    const container = mode === 'mobile' ? drawerScroll || drawerBody : desktopNav;
    requestAnimationFrame(() => scrollToFirstVisible(container));
  };

  document.addEventListener('input', onInput, true);
  document.addEventListener('search', onInput, true);
  document.addEventListener('keyup', onInput, true);
  const initialInputs = getInputs();
  for (const input of initialInputs) {
    if (input.value.trim()) {
      applyTo(desktopNav, input.value);
      applyTo(drawerBody, input.value);
      break;
    }
  }

  let lastFilterValue = null;
  window.setInterval(() => {
    const inputs = getInputs();
    const active =
      inputs.find((i) => i.getAttribute('data-doc-nav-filter') === (mobileMq.matches ? 'mobile' : 'desktop')) || inputs[0];
    const value = active instanceof HTMLInputElement ? active.value : '';
    if (value === lastFilterValue) return;
    lastFilterValue = value;
    applyTo(desktopNav, value);
    applyTo(drawerBody, value);
  }, 250);

  for (const btn of openBtns) {
    if (!(btn instanceof HTMLElement)) continue;
    btn.addEventListener('click', (e) => {
      if (!mobileMq.matches) return;
      e.preventDefault?.();
      lastOpenBtn = btn;
      setOpen(true);
    });
  }
  if (closeBtn instanceof HTMLElement) closeBtn.addEventListener('click', () => setOpen(false));
  if (desktopNav instanceof HTMLElement) {
    desktopNav.addEventListener('click', (e) => {
      const el = e.target;
      if (!(el instanceof Element)) return;
      const a = el.closest('a.docNavLink, a.docNavSummaryLink');
      if (!(a instanceof HTMLAnchorElement)) return;
      const next = normalisePath(a.getAttribute('href'));
      if (next) sessionStorage.setItem(STORAGE_KEY, next);
    });
  }
  if (drawerBody instanceof HTMLElement) {
    drawerBody.addEventListener('click', (e) => {
      const el = e.target;
      if (!(el instanceof Element)) return;
      const a = el.closest('a');
      if (!(a instanceof HTMLAnchorElement)) return;
      const isDocNavLink = a.matches('a.docNavLink, a.docNavSummaryLink');
      const next = normalisePath(a.getAttribute('href'));
      if (isDocNavLink && next) sessionStorage.setItem(STORAGE_KEY, next);
      setOpen(false);
    }, true);
  }
  if (overlay instanceof HTMLElement) {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) setOpen(false);
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
})();`}
		></script>
	) : null}
	</Layout>
)}

<script is:inline define:vars={{ subOk: 'Listo. El próximo llega a tu bandeja de entrada.', subBad: 'Introduce un email válido.', subErr: 'Algo ha fallado. Inténtalo de nuevo.' }}>
	(function () {
		var form = document.querySelector('[data-blog-sub]');
		if (!form) return;
		var msg = document.querySelector('[data-blog-sub-msg]');
		var input = form.querySelector('input[type=email]');
		var btn = form.querySelector('button');
		var set = function (t, cls) { if (msg) { msg.textContent = t; msg.className = 'blogSubMsg' + (cls ? ' ' + cls : ''); } };
		form.addEventListener('submit', async function (e) {
			e.preventDefault();
			var email = String(input.value || '').trim();
			if (!email || email.indexOf('@') < 0) { set(subBad, 'bad'); return; }
			btn.disabled = true;
			set('', '');
			try {
				var res = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ email: email, tag: 'blog', lang: document.documentElement.lang || 'en', page: location.pathname }),
				});
				var data = await res.json().catch(function () { return {}; });
				if (!res.ok || !data.ok) { set(subErr, 'bad'); btn.disabled = false; return; }
				set(subOk, 'ok');
				input.value = '';
				if (window.umami && window.umami.track) window.umami.track('blog-subscribe', { page: location.pathname });
			} catch (_) { set(subErr, 'bad'); }
			btn.disabled = false;
		});
	})();
</script>

