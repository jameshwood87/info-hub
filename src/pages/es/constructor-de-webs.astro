---
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'es');
const plAgencies = statPlus(__ps.agencies, 'es');
const plListings = statPlus(__ps.listings, 'es');

const title = 'Creador de Webs para Agencias Inmobiliarias | PropertyList.es';
const description =
	'Elige uno de los quince diseños de web de agencia ya terminados, hazlo tuyo, y cada anuncio de tu cuenta de PropertyList ya está en ella. Gratis para crear y previsualizar, 50 créditos al mes en cuanto publicas.';
const BUILD = 'https://agents.propertylist.es/website-builder';
const DOCS = 'https://info.propertylist.es/docs/propertylist-mls-user-manual/website-builder/';
const REFERRALS = 'https://agents.propertylist.es/referrals';
const DASHBOARD = 'https://agents.propertylist.es';

// The fifteen templates, as captured from the real files (public/wb). Order is
// the order shown; the style filter hides the rest.
const templates = [
	{ id: '14-solaz', name: 'Solaz', style: 'Escaparate', line: 'Empieza con una película: cipreses y costa al atardecer, el titular colocado en la parte baja de la imagen.' },
	{ id: '01-marina', name: 'Marina', style: 'Moderno', line: 'Cabecera en verde azulado y blanco, un buscador en vivo arriba y tus últimos anuncios en una cuadrícula debajo.' },
	{ id: '03-onyx', name: 'Onyx', style: 'Lujo', line: 'Una fotografía nocturna de una villa iluminada, un titular serif en blanco, un solo botón.' },
	{ id: '13-horizon', name: 'Horizon', style: 'Escaparate', line: 'Pantalla dividida: un titular destacado a un lado, una fotografía de interior a toda altura al otro.' },
	{ id: '02-blanca', name: 'Blanca', style: 'Minimalista', line: 'Una fotografía a todo ancho de una villa con piscina, un menú pequeño, sin titular sobre la imagen.' },
	{ id: '05-puerto', name: 'Puerto', style: 'Moderno', line: 'Una fotografía a todo ancho al atardecer con una tarjeta flotante encima que muestra el precio y los detalles.' },
	{ id: '07-noir', name: 'Noir', style: 'Lujo', line: 'Empieza con una película: un paisaje oscuro y cinematográfico con un titular grande y destacado encima, menú mínimo.' },
	{ id: '04-sierra', name: 'Sierra', style: 'Clásico', line: 'Fondo color crema, espacio para tu fotografía junto a tu nombre y un párrafo editorial.' },
	{ id: '09-continental', name: 'Continental', style: 'Moderno', line: 'Una fotografía en azul marino al atardecer, un titular blanco destacado y una tarjeta de precio superpuesta a la imagen.' },
	{ id: '06-atrium', name: 'Atrium', style: 'Minimalista', line: 'Gris claro y blanco, un color de acento en el titular, un buscador y una franja con los últimos inmuebles.' },
	{ id: '11-imperial', name: 'Imperial', style: 'Lujo', line: 'Fondo color crema, un titular serif destacado, dos fotografías debajo en una galería sencilla.' },
	{ id: '08-cortijo', name: 'Cortijo', style: 'Clásico', line: 'Fondo color pergamino cálido, un marco en arco junto a tu nombre y una presentación.' },
	{ id: '10-meridian', name: 'Meridian', style: 'Minimalista', line: 'Fondo pálido, un titular serif en cursiva, un buscador sencillo, nada que compita por la atención.' },
	{ id: '12-heritage', name: 'Heritage', style: 'Clásico', line: 'Fondo blanco, tu nombre y un párrafo de presentación, botones de llamada a la acción en verde.' },
	{ id: '15-faro', name: 'Faro', style: 'Escaparate', line: 'Empieza con una película: la silueta oscura de una montaña y el mar, un titular serif grande, menú mínimo.' },
];
const styles = ['Moderno', 'Minimalista', 'Lujo', 'Clásico', 'Escaparate'];

const addons = [
	{ name: 'Página extra', what: 'Una página más además de las incluidas', price: '10 créditos al mes' },
	{ name: 'Instant Content', what: 'Guías de zona y un blog, escritos para ti, sin límite', price: '30 créditos al mes' },
	{ name: 'Tu propio dominio', what: 'Tu dominio en vez de una dirección de PropertyList', price: '20 créditos al mes' },
	{ name: 'Quitar la marca de PropertyList', what: 'Elimina el distintivo de PropertyList de tu web', price: '50 créditos al mes' },
	{ name: 'Captura de leads con pop-up', what: 'Un pop-up que capta leads en tu web', price: '8 créditos al mes' },
	{ name: 'Respuestas con IA en los anuncios', what: 'Genera una FAQ a partir de lo que preguntan de verdad los compradores', price: '8 créditos al mes' },
	{ name: 'SEO y GEO automáticos', what: 'Revisa tu web cada semana y corrige lo que puede', price: '5 créditos al mes' },
	{ name: 'Informe mensual por email', what: 'Un resumen de rendimiento enviado por email el día 1 de cada mes', price: '5 créditos al mes' },
];

const faqs = [
	{ q: '¿De verdad es gratis crearla?', a: 'Sí. Crear y previsualizar tu web no cuesta nada. Solo se te cobra cuando la publicas, 50 créditos al mes a partir de ese momento.' },
	{ q: '¿Qué pasa cuando publico?', a: 'Tu web se pone en marcha y cada anuncio de tu cuenta de PropertyList aparece en ella de inmediato. A partir de ahí se te cobran 50 créditos al mes por la web, más los extras que tengas activados, cada uno con su cuota mensual.' },
	{ q: '¿Puedo cambiar de plantilla más adelante?', a: 'Sí. Cambia a cualquiera de los quince diseños cuando quieras, y conservas tus textos, tus páginas y tus ajustes.' },
	{ q: '¿Tengo que subir mis anuncios?', a: 'No. Cada anuncio de tu cuenta de PropertyList ya está en la web, y se actualiza cuando cambias el anuncio en el CRM. Nada se escribe dos veces.' },
	{ q: '¿A dónde van las consultas?', a: 'Directas a tu CRM de PropertyList. Los pipelines de Lead, Seller y Property son gratis y sin límite. Mover un lead cualificado al pipeline de Buyer cuesta 1 crédito.' },
	{ q: '¿Puedo usar mi propio dominio?', a: 'Sí, por 20 créditos al mes. Hasta entonces tu web funciona con una dirección de PropertyList.' },
	{ q: '¿Qué pasa si cancelo?', a: 'Tu web vuelve al microsite gratuito de agencia al final del periodo de facturación. Conservas tu dominio.' },
	{ q: '¿El SEO es bueno de verdad?', a: 'SEO y GEO automáticos revisa tu web cada semana y corrige lo que puede, por 5 créditos al mes. No prometemos posiciones; cómo rinde una web depende de más factores que una sola plataforma.' },
	{ q: '¿Necesito ser técnico?', a: 'No. Eliges una plantilla, la editas en un editor que muestra tu web real mientras trabajas, y publicas cuando estés listo. Editar con IA también te permite describir un cambio en lenguaje sencillo.' },
	{ q: '¿Están incluidas las páginas legales?', a: 'Sí. El aviso legal, la política de privacidad y de cookies, más un banner de cookies, vienen con cada plantilla. Están incluidos y nunca se facturan aparte.' },
];

const ldWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'PropertyList Creador de Webs',
	url: 'https://info.propertylist.es/es/constructor-de-webs/',
	description,
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es', logo: { '@type': 'ImageObject', url: 'https://info.propertylist.es/og/logo-default.png' } },
};
const ldBreadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://info.propertylist.es/' },
		{ '@type': 'ListItem', position: 2, name: 'Creador de Webs' },
	],
};
const ldVideo = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: 'PropertyList Creador de Webs: elige un diseño, edítalo, publica',
	description: 'Una grabación de 33 segundos del Creador de Webs de PropertyList con una agencia de ejemplo: los quince diseños, uno elegido, el titular seleccionado, la cabecera reorganizada y después Revisar y publicar. Sin sonido.',
	thumbnailUrl: ['https://info.propertylist.es/hero/wb-hero-poster.jpg'],
	contentUrl: 'https://info.propertylist.es/hero/wb-hero.mp4',
	uploadDate: '2026-09-05',
	duration: 'PT33S',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es' },
};
const ldFaq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/es/constructor-de-webs/"
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/website-builder/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/constructor-de-webs/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/website-builder/' },
	]}
>
	<script type="application/ld+json" set:html={JSON.stringify(ldWebsite)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldVideo)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />

	<!-- HERO -->
	<header class="wb-hero">
		<div class="wrap">
			<div class="wb-hero-grid">
				<div class="wb-hero-text">
					<div class="wb-hero-eyebrow"><img src="https://info.propertylist.es/og/icon-default.png" alt="" width="18" height="18" /><span>Website Builder &middot; funciona con tu cuenta MLS</span></div>
					<h1 class="wb-hero-h1">Elige un diseño.<br />Tus anuncios <em>la llenan.</em></h1>
					<p class="wb-hero-sub">Quince webs de agencia ya terminadas, listas para tus anuncios y tus consultas. Cada propiedad de tu cuenta de PropertyList ya está en la web el día que publicas.</p>
					<div class="wb-hero-ctas">
						<a class="btn btn-primary btn-large" href={BUILD}>Crea gratis</a>
						<a class="btn btn-secondary on-dark" href="#xml">Ya tengo una web</a>
					</div>
					<p class="wb-hero-trust">Gratis para crear y previsualizar. 50 créditos al mes (unos 50 EUR) en cuanto publicas. Cancela al final de cualquier mes.</p>
				</div>
				<div class="wb-hero-visual">
					<figure class="film wb-film">
						<div class="wb-frame wb-frame-dark">
							<div class="wb-frame-bar"><span></span><span></span><span></span><i>Website Builder</i></div>
							<video class="filmVid" autoplay muted loop playsinline preload="auto" poster="/hero/wb-hero-poster.jpg" width="1440" height="900" aria-label="El creador de webs: las quince plantillas, Solaz elegida, el editor con el titular seleccionado, la cabecera reorganizada y después Revisar y publicar">
								<source src="/hero/wb-hero.mp4" type="video/mp4" />
							</video>
						</div>
						<figcaption class="filmCap">Grabado en el nuevo creador con una agencia de ejemplo: los quince diseños, Solaz elegida, el titular seleccionado, la cabecera reorganizada y después Revisar y publicar. 33 segundos, sin sonido. Los extras y los totales que se ven son los de la web de ejemplo.</figcaption>
					</figure>
				</div>
			</div>
		</div>
	</header>

	<!-- PROOF -->
	<section class="wb-trust">
		<div class="wrap">
			<div class="wb-trust-grid">
				<div><div class="wb-trust-num">{plAgents}</div><div class="wb-trust-label">agentes registrados en PropertyList</div></div>
				<div><div class="wb-trust-num">{plAgencies}</div><div class="wb-trust-label">agencias que gestionan su negocio en ella</div></div>
				<div><div class="wb-trust-num">{plListings}</div><div class="wb-trust-label">anuncios en la red</div></div>
			</div>
			<p class="wb-trust-line">Tu web lee de la misma cuenta que tu MLS y tu CRM. Cada anuncio ya está en tu web el día que publicas, y se actualiza en el momento en que lo editas.</p>
		</div>
	</section>

	<!-- LAS QUINCE -->
	<section class="wb-section wb-fifteen" id="templates">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Las quince</p>
				<h2 class="wb-section-h2">Quince diseños, <em>una sola plataforma.</em></h2>
				<p class="wb-lead">Cada plantilla es una web de agencia completa: las mismas páginas, los mismos bloques que necesita una agencia, con un aspecto distinto. Elige la que se adapte a cómo trabajas, no al revés.</p>
			</div>
			<div class="wb-chips" role="tablist" aria-label="Filtrar plantillas por estilo">
				<button class="wb-chip on" type="button" data-style="all" aria-pressed="true">Las quince</button>
				{styles.map((s) => <button class="wb-chip" type="button" data-style={s} aria-pressed="false">{s}</button>)}
			</div>
		</div>
		<div class="wb-rail-wrap">
			<button class="wb-rail-btn prev" type="button" aria-label="Plantillas anteriores">&lsaquo;</button>
			<div class="wb-rail" id="wbRail">
				{templates.map((t, i) => (
					<article class="wb-tpl" data-style={t.style}>
						<div class="wb-tpl-shots">
							<div class="wb-frame">
								<div class="wb-frame-bar"><span></span><span></span><span></span><i>tumarca.estate-agency.co</i></div>
								<img src={`/wb/${t.id}-desktop.webp`} width="1440" height="900" alt={`Plantilla ${t.name}, página de inicio en una pantalla de escritorio`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							</div>
							<img class="wb-phone" src={`/wb/${t.id}-phone.webp`} width="390" height="844" alt={`Plantilla ${t.name} en un móvil`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
						</div>
						<div class="wb-tpl-meta">
							<span class="wb-tpl-style">{t.style}</span>
							<h3>{t.name}</h3>
							<p>{t.line}</p>
						</div>
					</article>
				))}
			</div>
			<button class="wb-rail-btn next" type="button" aria-label="Plantillas siguientes">&rsaquo;</button>
		</div>
		<div class="wrap"><p class="wb-fifteen-note">Cambia de opinión más adelante: cambia de plantilla y conserva tus textos, tus páginas y tus ajustes. Tres de las quince (Solaz, Noir, Faro) empiezan con una película.</p></div>
	</section>

	<!-- CÓMO FUNCIONA -->
	<section class="wb-section wb-steps">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Cómo funciona</p>
				<h2 class="wb-section-h2">Elige. Hazla tuya. <em>Publica.</em></h2>
			</div>
			<div class="wb-steps-grid">
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Elige una plantilla</i></div><img src="/wb/step-1-pick.webp" width="1440" height="900" alt="El selector de plantillas con Solaz elegida y su vista previa al lado" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">1</div>
					<h3>Elige una plantilla</h3>
					<p>Elige entre quince diseños de web de agencia ya terminados. Todos tienen ya las páginas que necesita una agencia.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Edita tu web</i></div><img src="/wb/step-2-edit.webp" width="1440" height="900" alt="El editor con los ajustes del bloque principal abiertos, mostrando tres disposiciones" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">2</div>
					<h3>Hazla tuya</h3>
					<p>Añade tu color de marca, tus textos y tus fotos en un editor que muestra la web real mientras trabajas. Cada bloque tiene varias disposiciones; elige una.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Revisar y publicar</i></div><img src="/wb/step-3-publish.webp" width="1440" height="900" alt="El diálogo de Revisar y publicar con los créditos mensuales antes de que la web se ponga en marcha" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">3</div>
					<h3>Publica</h3>
					<p>Tus anuncios ya están ahí, así que publicar no significa subir nada. Las consultas empiezan a llegar a tu CRM de inmediato.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- HECHO PARA UNA AGENCIA -->
	<section class="wb-section wb-agency">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Hecho para una agencia, no para una cafetería</p>
				<h2 class="wb-section-h2">Los bloques que un agente inmobiliario <em>de verdad necesita.</em></h2>
				<p class="wb-lead">Cuadrícula de propiedades, propiedad destacada, buscador, formulario de valoración, guías de zona, equipo, reseñas, cifras, qué cuesta comprar, obra nueva. Cada uno lee de tu cuenta en vez de pedirte que escribas.</p>
			</div>
			<div class="wb-cards">
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9 21v-6h6v6" /></svg><strong>Todos los anuncios de la red, listos para mostrar.</strong><p>Tus propios anuncios están en tu web el día que publicas. Los de la red también: fíltralos y muestra los que encajan con tus compradores, desde el primer momento.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h7M18 15l3 3-3 3" /></svg><strong>Los leads llegan a tu CRM.</strong><p>Cada consulta entra como lead. Pasa los que quieras por tus pipelines: Lead, Seller y Property son gratis y sin límite, y mover un lead cualificado al pipeline de Buyer cuesta 1 crédito.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg><strong>Un buscador que funciona como un portal.</strong><p>Los compradores filtran la cartera por zona, tipo y precio en la página de Propiedades, y pueden guardar una búsqueda.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10l8-6 8 6v10M9 20v-5h6v5" /><path d="M2 20h20" /></svg><strong>Un formulario de valoración gratis que hace más.</strong><p>Cada solicitud de un vendedor llega como un lead con un Property Intelligence Report ya rellenado, listo para comprar por 5 créditos si lo quieres.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6z" /><path d="M9 12h6M9 16h6M15 3v4h4" /></svg><strong>Los gastos de compra, siempre al día.</strong><p>Gastos de compra en España con la ley citada. Comprobamos si hay tipos nuevos o actualizados y refrescamos el bloque, así tu web sigue correcta sin que la toques. Tu abogado confirma la cifra final.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19h16M6 16V9M11 16V5M16 16v-7" /></svg><strong>Cifras que se cuentan solas.</strong><p>El bloque de cifras lee de tus anuncios en directo. Nadie lo escribe a mano.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-5-6.3" /></svg><strong>Reseñas y equipo, de lo que ya tienes.</strong><p>Conecta tu Perfil de Empresa de Google y tus reseñas aparecen en la web, o escríbelas tú. Nada se inventa. Tu equipo sale del personal que ya está en tu cuenta de agencia.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg><strong>Todos los idiomas que hablan tus compradores.</strong><p>Inglés y español vienen de serie. Añade los demás idiomas que usan tus compradores, en la misma web.</p></article>
			</div>
		</div>
	</section>

	<!-- EDITAR CON IA -->
	<section class="wb-section wb-ai">
		<div class="wrap">
			<div class="wb-ai-grid">
				<div class="wb-ai-text">
					<p class="eyebrow" style="color:#6fe5d3">Editar con IA</p>
					<h2 class="wb-section-h2 on-dark">Haz clic en cualquier cosa. <em>Di qué quieres cambiar.</em></h2>
					<p class="wb-lead" style="color:#b8c9cb">Describe un cambio en lenguaje normal y la página se actualiza. Cada cambio es un borrador hasta que lo publicas, y Deshacer siempre está ahí.</p>
				</div>
				<figure class="wb-ai-shot">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Edita tu web</i></div><img src="/wb/ai-bubble.webp" width="1440" height="900" alt="El titular seleccionado en el editor, con los cambios que el agente puede pedir" loading="lazy" decoding="async" /></div>
					<figcaption>El titular seleccionado en el editor. Más corto, un tono más cercano, que mencione la localidad, o tus propias palabras.</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- PRECIOS -->
	<section id="pricing" class="wb-pricing wb-section">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow" style="color:#6fe5d3">Precios</p>
				<h2 class="wb-section-h2 on-dark">Gratis para crear. <em>50 créditos al mes en cuanto publicas.</em></h2>
				<p class="wb-lead" style="color:#b8c9cb">Un plan base, extras en créditos, y puedes cancelar cualquiera de ellos al final de cualquier mes.</p>
			</div>
			<div class="wb-price-grid">
				<div class="wb-pricing-card">
					<div class="wb-pricing-name">Website Builder</div>
					<div class="wb-pricing-price">50 créditos <span class="unit">al mes</span></div>
					<p class="wb-pricing-tagline">No se cobra nada mientras creas y previsualizas; la suscripción empieza el día que publicas.</p>
					<ul class="wb-pricing-features">
						<li>Inicio, Propiedades (búsqueda y resultados, con filtros y una búsqueda guardada), una página de propiedad para cada anuncio, Sobre Nosotros y Contacto</li>
						<li>Páginas legales (aviso legal, privacidad, cookies) y un banner de cookies, incluidos y nunca facturados</li>
						<li>Inglés y español de serie, se pueden añadir más idiomas</li>
						<li>Las quince plantillas, cambia cuando quieras y conserva tu trabajo</li>
						<li>Consultas directas a tu CRM de PropertyList</li>
						<li>Cancela al final de cualquier mes; la web vuelve al microsite gratuito de agencia y conservas tu dominio</li>
					</ul>
					<div class="wb-pricing-cta"><a class="btn btn-primary btn-large" href={BUILD}>Crea gratis</a></div>
					<p class="wb-pricing-note">Páginas extra: <strong>10 créditos al mes</strong> cada una.</p>
				</div>
				<div class="wb-pricing-aside">
					<div class="wb-addon-card">
						<h4>Extras, <em>si los quieres</em></h4>
						<p class="wb-addon-intro">Cada uno es mensual, se activa desde tu cuenta, y puede cancelarse al final de cualquier mes.</p>
						<ul class="wb-addon-list">
							{addons.map((a) => (
								<li><span class="wb-addon-name">{a.name}<small>{a.what}</small></span><span class="wb-addon-price">{a.price}</span></li>
							))}
						</ul>
						<div class="wb-addon-footer">Feed de obra nueva: un módulo aparte, con precio en tu cuenta.</div>
					</div>
					<div class="wb-credit-info">
						<h4>Qué es un crédito</h4>
						<p>La unidad de PropertyList para las funciones de pago, que se compra en packs: 1 crédito (alrededor de 1 EUR) en el pack más pequeño, menos en los packs más grandes. Los créditos no caducan, así que lo que no uses este mes sigue disponible el mes siguiente.</p>
						<p style="margin:0"><a href={REFERRALS}>Recomienda a otra agencia</a> y consigues 20 créditos (unos 20 EUR) cuando completa la verificación, no al registrarse. La nueva agencia recibe 10 créditos.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- YA TIENES UNA WEB -->
	<section id="xml" class="wb-xml wb-section">
		<div class="wrap">
			<div class="wb-xml-inner">
				<div>
					<p class="eyebrow">¿Ya tienes una web?</p>
					<h2 class="wb-section-h2">Conserva tu web. <em>Aliméntala con toda la red.</em></h2>
					<p class="wb-lead">Lleva todos los anuncios de la red a la web que ya tienes, filtrados como tú quieras: solo tu propia cartera, o una selección de la red junto a ella. XML o la API para webs; tu desarrollador lo conecta una vez y desde entonces la web lee de la misma cuenta que tu MLS y tu CRM.</p>
				</div>
				<div class="wb-xml-card">
					<div class="wb-xml-price-row"><span class="wb-xml-price">35 créditos</span><span class="wb-xml-price-unit">al mes</span></div>
					<p class="wb-xml-detail">Feed XML o API para webs. Cancela cuando quieras.</p>
					<ul class="wb-pricing-features">
						<li>Todos los anuncios de la red en tu propia web, filtrados como quieras</li>
						<li>Feed XML o API para webs, como prefiera tu desarrollador</li>
						<li>La documentación es pública; no hay que comprar nada para leerla</li>
					</ul>
					<a class="btn btn-primary" href={DASHBOARD}>Configura un feed</a>
					<p class="wb-xml-docs"><a href={DOCS}>Lee la documentación del Creador de Webs y del feed</a></p>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="wb-faq wb-section">
		<div class="narrow">
			<div class="wb-section-head">
				<p class="eyebrow">Preguntas</p>
				<h2 class="wb-section-h2">Lo que los agentes <em>preguntan primero.</em></h2>
			</div>
			<div>
				{faqs.map((f) => (
					<div class="wb-faq-item"><details><summary>{f.q}</summary><p>{f.a}</p></details></div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA FINAL -->
	<section class="wb-final wb-section">
		<div class="narrow">
			<p class="eyebrow" style="color:#6fe5d3">Construido en la Costa del Sol &middot; usado en toda España</p>
			<h2 class="wb-section-h2 on-dark">Tus anuncios ya están listos.<br /><em>¿Y tu web?</em></h2>
			<p class="wb-lead">Elige un diseño, hazlo tuyo, y publica cuando quieras.</p>
			<a class="btn btn-primary btn-large" href={BUILD}>Crea gratis</a>
			<p class="wb-final-note">Gratis para crear y previsualizar. 50 créditos al mes en cuanto publicas. <a href={DOCS}>Lee la documentación</a>.</p>
		</div>
	</section>

	<script is:inline>
		(function () {
			var rail = document.getElementById('wbRail');
			if (!rail) return;
			var chips = document.querySelectorAll('.wb-chip');
			var cards = rail.querySelectorAll('.wb-tpl');
			chips.forEach(function (c) {
				c.addEventListener('click', function () {
					var s = c.getAttribute('data-style');
					chips.forEach(function (x) { var on = x === c; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
					cards.forEach(function (k) { k.hidden = !(s === 'all' || k.getAttribute('data-style') === s); });
					rail.scrollTo({ left: 0, behavior: 'smooth' });
				});
			});
			function step(dir) {
				var first = rail.querySelector('.wb-tpl:not([hidden])');
				var w = first ? first.getBoundingClientRect().width + 24 : rail.clientWidth * 0.8;
				rail.scrollBy({ left: dir * w, behavior: 'smooth' });
			}
			document.querySelector('.wb-rail-btn.prev').addEventListener('click', function () { step(-1); });
			document.querySelector('.wb-rail-btn.next').addEventListener('click', function () { step(1); });
		})();
	</script>
</Layout>

<style is:global>
