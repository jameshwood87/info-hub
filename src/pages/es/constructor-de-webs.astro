<style>.aiCta{max-width:680px;margin:40px auto;padding:26px 28px;border:1px solid rgba(0,174,154,.26);border-radius:16px;background:linear-gradient(180deg,rgba(0,174,154,.07),rgba(0,174,154,.02));font-family:-apple-system,Segoe UI,Roboto,sans-serif;text-align:left}.aiCtaTitle{margin:0 0 8px;font-size:20px;line-height:1.25;font-weight:800;color:#101828}.aiCtaBody{margin:0 0 16px;font-size:14.5px;line-height:1.6;color:rgba(16,24,40,.7)}.aiCtaForm{display:flex;gap:8px;flex-wrap:wrap}.aiCtaInput{flex:1 1 240px;min-width:0;padding:11px 14px;font-size:15px;border:1px solid rgba(16,24,40,.18);border-radius:10px;background:#fff;color:#101828}.aiCtaInput:focus{outline:2px solid rgba(0,174,154,.5);outline-offset:1px}.aiCtaBtn{flex:0 0 auto;padding:11px 22px;font-size:15px;font-weight:800;color:#fff;background:#00ae9a;border:0;border-radius:10px;cursor:pointer}.aiCtaBtn:hover{background:#0a9285}.aiCtaBtn:disabled{opacity:.6;cursor:default}.aiCtaNote{margin:10px 0 0;font-size:12.5px;color:rgba(16,24,40,.5)}.aiCtaMsg{margin:8px 0 0;font-size:13.5px;min-height:1em}.aiCtaMsg.ok{color:#0a6d61;font-weight:700}.aiCtaMsg.bad{color:#b42318}</style><section class="aiCta" data-agent-cta data-lang="es" data-page="/es/constructor-de-webs/" data-ok="Hecho. Va camino de tu bandeja de entrada." data-bad="Introduce un email válido." data-err="Algo ha fallado. Inténtalo de nuevo."><h2 class="aiCtaTitle">¿Aún no quieres crear la cuenta?</h2><p class="aiCtaBody">Te enviamos el resumen por email: qué está incluido gratis, qué cuesta el Creador de Webs y a qué sustituye. Así lo miras con calma o se lo pasas a tu socio.</p><form class="aiCtaForm" data-agent-cta-form><input class="aiCtaInput" type="email" name="email" required placeholder="tu@email.com" aria-label="tu@email.com" autocomplete="email" /><button class="aiCtaBtn" type="submit">Envíame los detalles</button></form><p class="aiCtaNote">Un email. Puedes darte de baja cuando quieras.</p><p class="aiCtaMsg" data-agent-cta-msg role="status" aria-live="polite"></p></section><script>(function(){var box=document.querySelector("[data-agent-cta]");if(!box)return;var form=box.querySelector("[data-agent-cta-form]"),msg=box.querySelector("[data-agent-cta-msg]");var input=form.querySelector("input[type=email]"),btn=form.querySelector("button");form.addEventListener("submit",async function(e){e.preventDefault();var email=String(input.value||"").trim();if(!email||email.indexOf("@")<0){msg.textContent=box.dataset.bad;msg.className="aiCtaMsg bad";return;}btn.disabled=true;msg.textContent="";try{var res=await fetch("/api/subscribe",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({email:email,audience:"agent",tag:"agent-interested",lang:box.dataset.lang,page:box.dataset.page})});var d=await res.json().catch(function(){return{}});if(!res.ok||!d.ok){msg.textContent=box.dataset.err;msg.className="aiCtaMsg bad";btn.disabled=false;return;}msg.textContent=box.dataset.ok;msg.className="aiCtaMsg ok";input.value="";if(window.umami&&window.umami.track){window.umami.track("agent-interested",{page:box.dataset.page});}}catch(_){msg.textContent=box.dataset.err;msg.className="aiCtaMsg bad";}btn.disabled=false;});})();</script>
