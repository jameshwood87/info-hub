---
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'es');
const plAgencies = statPlus(__ps.agencies, 'es');
const plListings = statPlus(__ps.listings, 'es');
const title = 'Creador de Sitios Web para Agencias Inmobiliarias | PropertyList.es';
const description = 'Lanza un sitio web de agencia con marca propia en minutos. Cada propiedad MLS cargada automáticamente y actualizada en tiempo real, un asistente con IA que crea tus páginas a partir de una frase, captura de leads y SEO - desde 50 créditos/mes (unos 50 €).';
---

<Layout
	lang="es"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/es/constructor-de-webs/"
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/website-builder/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/constructor-de-webs/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/website-builder/' },
	]}
>
	<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "PropertyList Creador de Sitios Web",
  "url": "https://info.propertylist.es/es/constructor-de-webs/",
  "description": "AI-powered website builder for Spanish estate agents. Auto-loads MLS properties, writes SEO meta, generates location pages - no developer needed.",
  "publisher": {
    "@type": "Organization",
    "name": "PropertyList",
    "url": "https://propertylist.es",
    "logo": {
      "@type": "ImageObject",
      "url": "https://info.propertylist.es/og/logo-default.png"
    }
  }
}
</script>
	<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "description": "Navigation path for PropertyList Creador de Sitios Web page",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://info.propertylist.es/"
    },
    {
      "@type": "ListItem",
