---
import Layout from '../layouts/Layout.astro';
import ReviewsPage from '../components/ReviewsPage.astro';
import data from '../data/reviews.json';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/reviews/`;
const title = 'PropertyList Reviews: what agents say | PropertyList';
const description = `Every review of PropertyList on Google and Trustpilot, shown as published and linked to the original, plus the Facebook recommendations. ${data.sources.google.rating.toFixed(1)} on Google from ${data.sources.google.count} reviews.`;

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Reviews', item: canonical },
	],
};
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	hideSearch
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/opiniones/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<ReviewsPage lang="en" />
</Layout>
