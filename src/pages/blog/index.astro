<script is:inline>
	(() => {
		const init = () => {
			const input = document.getElementById('blog-filter');
			if (!(input instanceof HTMLInputElement)) return;
			const posts = Array.from(document.querySelectorAll('[data-post="1"]'));
			const results = document.getElementById('blog-results');
			const clearBtn = document.querySelector('[data-clear]');
			const catButtons = Array.from(document.querySelectorAll('[data-cat]'));
			let activeCat = 'all';

			const apply = () => {
				const q = (input.value || '').trim().toLowerCase();
				const wantsCat = (activeCat || 'all').toLowerCase();
				let shown = 0;
				if (!q) {
					for (const p of posts) {
						const cat = (p.getAttribute('data-cat') || '').toLowerCase();
						const okCat = wantsCat === 'all' || cat === wantsCat;
						p.hidden = !okCat;
						if (okCat) shown++;
					}
				} else {
					for (const p of posts) {
						const label = (p.getAttribute('data-label') || '').toLowerCase();
						const cat = (p.getAttribute('data-cat') || '').toLowerCase();
						const okCat = wantsCat === 'all' || cat === wantsCat;
						const okQ = label.includes(q);
						p.hidden = !(okCat && okQ);
						if (okCat && okQ) shown++;
					}
				}
				if (results) results.textContent = 'Showing ' + shown + ' ' + (shown === 1 ? 'post' : 'posts');
				if (clearBtn) clearBtn.hidden = !q;
			};

			input.addEventListener('input', apply, { passive: true });
			if (clearBtn instanceof HTMLButtonElement) {
				clearBtn.addEventListener('click', () => {
					input.value = '';
					input.focus();
					apply();
				});
			}
			for (const btn of catButtons) {
				if (!(btn instanceof HTMLButtonElement)) continue;
				btn.addEventListener('click', () => {
					activeCat = String(btn.getAttribute('data-cat') || 'all');
					for (const other of catButtons) {
						if (other instanceof HTMLButtonElement) other.setAttribute('aria-pressed', other === btn ? 'true' : 'false');
					}
					apply();
				});
			}
			apply();
		};

		if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
		else init();
	})();
</script>
