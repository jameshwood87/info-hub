const { html: neighbourhoodAutoHtml, toc: neighbourhoodAutoToc } = isNeighbourhood ? withHeadingIdsAndToc(neighbourhoodAutoSource) : { html: '', toc: [] };

const finalBodyHtml = (() => {
	let out = renamedBodyHtml;
	if (moveDocHeaderIntoBody) {
		const titleHtml = `<h1 class="docTitle">${escapeHtmlAttr(stripInfoHubSuffix(h1))}</h1>`;
		const leadHtml = (() => {
			if (!page.description) return '';
			const leadText = normText(page.description);
			const firstP = renamedBodyHtml.match(/<p\b[^>]*>([\s\S]*?)<\/p>/i);
			const firstPText = firstP ? normText(firstP[1]) : '';
			const overlap = leadText && firstPText && (leadText.slice(0, 60) === firstPText.slice(0, 60) || leadText.includes(firstPText.slice(0, 80)));
			return overlap ? '' : `<p class="docLead">${escapeHtmlAttr(page.description)}</p>`;
		})();
		out = `${titleHtml}${leadHtml}${out}`;
	}
	if (isBlogLike) {
		out = removeLeadingDuplicateHeading(out, stripInfoHubSuffix(h1));
		const alt = featuredImageAlt || stripInfoHubSuffix(h1);
		const titleAttr = featuredImageTitle ? ` title="${escapeHtmlAttr(featuredImageTitle)}"` : '';
		const captionText = featuredImageCaption || '';
		const creditText = featuredImageCredit || '';
		const figcaption =
			captionText || creditText
				? `<figcaption class="blogHeroCaption">${escapeHtmlAttr(captionText)}${captionText && creditText ? ' — ' : ''}${escapeHtmlAttr(creditText)}</figcaption>`
				: '';
		const isUnsplash = typeof heroSrc === 'string' && /^https?:\/\//i.test(heroSrc) && /images\.unsplash\.com/i.test(heroSrc);
		const isPexels = typeof heroSrc === 'string' && /^https?:\/\//i.test(heroSrc) && /images\.pexels\.com/i.test(heroSrc);
		if (isUnsplash || isPexels) {
			const u = new URL(heroSrc);
			const sizes = [640, 960, 1200];
			const mk = (w: number, fm: 'avif' | 'webp' | 'jpg') => {
				const h = Math.round((w * 630) / 1200);
				const next = new URL(u.toString());
				next.searchParams.set('fit', 'crop');
				next.searchParams.set('w', String(w));
				next.searchParams.set('h', String(h));
				if (isPexels) {
					next.searchParams.set('auto', 'compress');
					next.searchParams.set('cs', 'tinysrgb');
					next.searchParams.set('q', '65');
					next.searchParams.set('fm', fm === 'jpg' ? 'jpg' : fm);
				} else {
					next.searchParams.set('q', '70');
					next.searchParams.set('fm', fm === 'jpg' ? 'jpg' : fm);
				}
				return next.toString();
			};
			const avif = sizes.map((w) => `${mk(w, 'avif')} ${w}w`).join(', ');
			const webp = sizes.map((w) => `${mk(w, 'webp')} ${w}w`).join(', ');
			const jpg = sizes.map((w) => `${mk(w, 'jpg')} ${w}w`).join(', ');
			out = `<figure class="blogHero"><picture><source type="image/avif" srcset="${escapeHtmlAttr(avif)}" sizes="(max-width: 900px) 100vw, 900px" /><source type="image/webp" srcset="${escapeHtmlAttr(webp)}" sizes="(max-width: 900px) 100vw, 900px" /><img src="${escapeHtmlAttr(mk(1200, 'jpg'))}" srcset="${escapeHtmlAttr(jpg)}" sizes="(max-width: 900px) 100vw, 900px" alt="${escapeHtmlAttr(alt)}"${titleAttr} width="1200" height="630" loading="eager" decoding="async" fetchpriority="high" /></picture>${figcaption}</figure>${out}`;
		} else {
			out = `<figure class="blogHero"><img src="${escapeHtmlAttr(heroSrc)}" alt="${escapeHtmlAttr(alt)}"${titleAttr} width="1200" height="630" loading="eager" decoding="async" fetchpriority="high" />${figcaption}</figure>${out}`;
		}
	}
	if (isDocs) out = rewriteDocLinksToCanonical(out);
	if (isNeighbourhood) {
		out = neighbourhoodAutoHtml;
	}
	return out;
})();

const toc = isNeighbourhood ? neighbourhoodAutoToc : sourceToc;

const crumbs = (() => {
	const parts = renderPath.split('/').filter(Boolean);
	const acc: Array<{ href: string; label: string }> = [];
	let current = '';
	for (const seg of parts.slice(0, -1)) {
		current += `/${seg}`;
		acc.push({ href: `${current}/`, label: labelForCrumb(seg) });
	}
	return acc;
})();

const parentPrefix = renderPath.replace(/[^/]+\/$/, '');
const siblings = isDocs
	? []
	: await listKbPagesByPrefix({
			prefix: parentPrefix,
			lang: 'en',
			limit: 500,
		});
const siblingSorted = [...siblings].sort((a, b) => a.path.localeCompare(b.path));
const siblingCurrentIndex = siblingSorted.findIndex((p) => p.path === renderPath);
const docsPrefix = '/docs/';
const docsItemsRaw = isDocs ? await listKbPagesByPrefixes({ prefixes: ['/docs/', '/es/docs/'], lang: 'en', limit: 2000 }) : [];
const docsItems = (() => {
	const byPath = new Map<string, (typeof docsItemsRaw)[number]>();
	const sorted = [...docsItemsRaw].sort((a, b) => {
		const aOk = a.path.startsWith('/docs/');
		const bOk = b.path.startsWith('/docs/');
		if (aOk !== bOk) return aOk ? -1 : 1;
		return a.path.localeCompare(b.path);
	});
	for (const p of sorted) {
		const canonicalPath = p.path.startsWith('/es/docs/') ? mapDocsSpanishToEnglishPath(p.path) : p.path;
		if (!byPath.has(canonicalPath)) byPath.set(canonicalPath, { ...p, path: canonicalPath });
	}
	return [...byPath.values()];
})();
const currentManualRoot = (() => {
	if (!isDocs) return null;
	const rest = renderPath.slice(docsPrefix.length);
	const seg = rest.split('/').filter(Boolean)[0] || null;
	return seg ? `${docsPrefix}${seg}/` : docsPrefix;
})();
const navFilter = (requestUrl.searchParams.get('filter') || '').trim();

type DocNode = {
	key: string;
	path: string;
	seg: string;
	title: string;
	children: DocNode[];
	hasPage: boolean;
};

const mlsManualPath = '/docs/propertylist-mls-user-manual/';
const manualOrderWeight = (node: { seg: string; title: string; path: string }): number => {
	const s = `${node.seg} ${node.title}`.toLowerCase();
	if (node.path === mlsManualPath) return 0;
	if (/\bgetting\b|\bstart\b|\bsetup\b|\bonboarding\b/.test(s)) return 10;
	if (/\bdashboard\b|\boverview\b|\bhome\b/.test(s)) return 20;
	if (/\bsearch\b|\bsearching\b|\bproperties\b/.test(s)) return 30;
	if (/\blistings?\b|\bproperty alerts?\b|\balerts?\b/.test(s)) return 40;
	if (/\bleads?\b|\benquir(y|ies)\b|\bpipeline\b|\bsales\b/.test(s)) return 50;
	if (/\bcontacts?\b|\bclients?\b/.test(s)) return 60;
	if (/\bcalendar\b|\bappointments?\b|\bviewings?\b|\btasks?\b/.test(s)) return 70;
	if (/\breports?\b|\bstatistics\b|\banalytics\b/.test(s)) return 80;
	if (/\brequests?\b/.test(s)) return 90;
	if (/\bsecurity\b|\bpermissions?\b|\busers?\b|\bverified\b|\bagency\b|\bcompany\b|\bstaff\b|\baccount\b/.test(s)) return 100;
	if (/\bai\b|\bautomation\b|\bintegrations?\b/.test(s)) return 110;
	if (/\btechnical\b|\bapi\b/.test(s)) return 120;
	if (/\bvideo\b|\btutorials?\b/.test(s)) return 130;
	if (/\badditional\b|\bresources?\b/.test(s)) return 140;
	return 500;
};

const treeOrder = isDocs ? await getKbTreeOrderSnapshot() : null;
const docsByPath = new Map(docsItems.map((p) => [p.path, p]));

const docsRoot: DocNode = { key: docsPrefix, path: docsPrefix, seg: '', title: 'Docs', children: [], hasPage: docsByPath.has(docsPrefix) };
const docNodesByPath = new Map<string, DocNode>();
docNodesByPath.set(docsRoot.path, docsRoot);

const ensureNode = (path: string, seg: string) => {
	const key = String(path || '');
	if (!key) return null;
	const existing = docNodesByPath.get(key) || null;
	if (existing) return existing;
	const node: DocNode = { key, path: key, seg, title: '', children: [], hasPage: false };
	docNodesByPath.set(key, node);
	return node;
};

for (const p of docsItems) {
	if (!p.path.startsWith(docsPrefix)) continue;
	const rest = p.path.slice(docsPrefix.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = docsPrefix;
	let lastSeg = '';
	for (const seg of parts) {
		lastSeg = seg;
		acc += `${seg}/`;
		ensureNode(acc, seg);
	}
	const node = ensureNode(p.path, lastSeg);
	if (node) node.hasPage = true;
}

for (const [path, node] of docNodesByPath.entries()) {
	if (path === docsPrefix) continue;
	const hit = docsByPath.get(path) || null;
	if (path === '/docs/propertylist-mls-user-manual/') node.title = 'MLS & CRM User Manual';
	else if (hit?.title) node.title = stripInfoHubSuffix(hit.title);
}

for (const node of docNodesByPath.values()) {
	if (!node.title) node.title = node.seg ? titleCase(node.seg) : 'Docs';
}

const derivedParent = (p: string) => {
	if (!p.startsWith(docsPrefix)) return '';
	if (p === docsPrefix) return '';
	const rest = p.slice(docsPrefix.length);
	const parts = rest.split('/').filter(Boolean);
	if (!parts.length) return '';
	if (parts.length === 1) return docsPrefix;
	return `${docsPrefix}${parts.slice(0, -1).join('/')}/`;
};

const effectiveParent = (p: string) => {
	const explicit = treeOrder?.parentOverride?.[p] || '';
	return explicit ? String(explicit) : derivedParent(p);
};

const kidsByParent = new Map<string, string[]>();
for (const p of docNodesByPath.keys()) {
	const parent = effectiveParent(p);
	if (!parent) continue;
	const arr = kidsByParent.get(parent) || [];
	arr.push(p);
	kidsByParent.set(parent, arr);
}

const sortForParent = (parentPath: string, childPaths: string[], depth: number) => {
	const orderList = (treeOrder?.parentChildren?.[parentPath] || []).slice();
	const fallbackCompare = (a: string, b: string) => {
		if (depth === 0 && currentManualRoot) {
			const aIsCurrent = a === currentManualRoot;
			const bIsCurrent = b === currentManualRoot;
			if (aIsCurrent !== bIsCurrent) return aIsCurrent ? -1 : 1;
		}
		const aNode = docNodesByPath.get(a);
		const bNode = docNodesByPath.get(b);
		if (depth === 1) {
			const aInMls = a.startsWith(mlsManualPath);
			const bInMls = b.startsWith(mlsManualPath);
			if (aInMls && bInMls) {
				const aw = manualOrderWeight({ seg: aNode?.seg || '', title: aNode?.title || '', path: a });
				const bw = manualOrderWeight({ seg: bNode?.seg || '', title: bNode?.title || '', path: b });
				if (aw !== bw) return aw - bw;
			}
		}
		return String(aNode?.title || '').localeCompare(String(bNode?.title || ''));
	};
	return sortPathsWithOrder({ parentPath, paths: childPaths, order: orderList, fallbackCompare }).ordered;
};

const buildChildren = (parentPath: string, depth: number): DocNode[] => {
	const childPaths = kidsByParent.get(parentPath) || [];
	const sorted = sortForParent(parentPath, childPaths, depth);
	return sorted
		.map((p) => docNodesByPath.get(p) || null)
		.filter(Boolean)
		.map((n) => {
			n!.children = buildChildren(n!.path, depth + 1);
			return n!;
		});
};

docsRoot.children = buildChildren(docsPrefix, 0);

const docsManualOptions = (() => {
	if (!isDocs) return [] as Array<{ title: string; href: string }>;
	return docsRoot.children
		.filter((n) => n.hasPage)
		.map((n) => {
			const ext = externalDocLinkForPath(n.path);
			return { title: String(n.title || 'Docs'), href: String(ext?.href || n.path) };
		});
})();
const currentManualTitle = (() => {
	if (!isDocs) return '';
	if (!currentManualRoot) return 'Docs';
	const node = docNodesByPath.get(currentManualRoot) || null;
	return String(node?.title || 'Docs');
})();

const openDocPaths = (() => {
	const s = new Set<string>();
	if (!isDocs) return s;
	const rest = renderPath.slice(docsPrefix.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = docsPrefix;
	for (const seg of parts) {
		acc += `${seg}/`;
		s.add(acc);
	}
	return s;
})();

const filteredDocsChildren = (() => {
	if (!isDocs) return docsRoot.children;
	const q = navFilter.toLowerCase().trim();
	const rootKey = currentManualRoot || '';
	const manualNode = rootKey ? (docNodesByPath.get(rootKey) || null) : null;
	const base = manualNode?.children?.length ? manualNode.children : docsRoot.children;
	if (!q) return base;

	const filterTree = (nodes: DocNode[]): DocNode[] => {
		const out: DocNode[] = [];
		for (const n of nodes) {
			const label = `${n.seg} ${n.title}`.toLowerCase();
			const path = n.path.toLowerCase();
			const selfMatches = label.includes(q) || path.includes(q);
			const kids = filterTree(n.children);
			if (selfMatches || kids.length) out.push({ ...n, children: kids });
		}
		return out;
	};

	return filterTree(base);
})();

const manualDepth = isDocs ? renderPath.slice(docsPrefix.length).split('/').filter(Boolean).length : 0;
const isMlsManualMainFolder = isDocs && renderPath.startsWith(mlsManualPath) && renderPath !== mlsManualPath && manualDepth === 2;
const folderArticles = (() => {
	if (!isMlsManualMainFolder) return [] as Array<{ path: string; title: string; description?: string | null; href: string; external: boolean }>;
	const childPaths = kidsByParent.get(renderPath) || [];
	if (!childPaths.length) return [];
	const sorted = sortForParent(renderPath, childPaths, manualDepth);
	const out: Array<{ path: string; title: string; description?: string | null; href: string; external: boolean }> = [];
	for (const p of sorted) {
		const n = docNodesByPath.get(p) || null;
		if (!n || !n.hasPage) continue;
		const hit = docsByPath.get(p) || null;
		const ext = externalDocLinkForPath(p);
		out.push({
			path: p,
			title: String(n.title || ''),
			description: hit?.description ?? null,
			href: ext?.href || p,
			external: Boolean(ext),
		});
	}
	return out;
})();

const docPager = (() => {
	if (!isDocs) {
		const prevRaw = siblingCurrentIndex > 0 ? siblingSorted[siblingCurrentIndex - 1] : null;
		const nextRaw = siblingCurrentIndex >= 0 && siblingCurrentIndex < siblingSorted.length - 1 ? siblingSorted[siblingCurrentIndex + 1] : null;
		return {
			prev: prevRaw ? { path: prevRaw.path, title: prevRaw.title, href: prevRaw.path, external: false } : null,
			next: nextRaw ? { path: nextRaw.path, title: nextRaw.title, href: nextRaw.path, external: false } : null,
		};
	}

	const rootKey = currentManualRoot || '';
	const manualNode = rootKey ? (docNodesByPath.get(rootKey) || null) : null;
	const base = manualNode?.children?.length ? manualNode.children : docsRoot.children;
	const seq: Array<{ path: string; title: string; href: string; external: boolean }> = [];

	const walk = (nodes: DocNode[]) => {
		for (const n of nodes) {
			if (n.hasPage) {
				const ext = externalDocLinkForPath(n.path);
				seq.push({ path: n.path, title: String(n.title || ''), href: String(ext?.href || n.path), external: Boolean(ext) });
			}
			if (n.children?.length) walk(n.children);
		}
	};
	walk(base);

	const idx = seq.findIndex((p) => p.path === renderPath);
	return {
		prev: idx > 0 ? seq[idx - 1] : null,
		next: idx >= 0 && idx < seq.length - 1 ? seq[idx + 1] : null,
	};
})();

const prev = docPager.prev;
const next = docPager.next;

const escapeHtml = (s: string) =>
	String(s || '')
		.replaceAll('&', '&amp;')
		.replaceAll('<', '&lt;')
		.replaceAll('>', '&gt;')
		.replaceAll('"', '&quot;')
		.replaceAll("'", '&#39;');

function externalDocLinkForPath(p: string) {
	if (p === '/docs/propertylist-mls-user-manual/ai-ezd_ampersand-automation/ai-property-research-agent/')
		return { href: 'https://ai.propertylist.es/how-it-works', target: '_blank' as const, rel: 'noopener' };
	return null;
}

const renderDocNavHtml = (nodes: DocNode[], depth = 0, forceOpen = false): string =>
	nodes
		.map((n) => {
			const isCurrent = n.path === renderPath;
			const isOpen = forceOpen || openDocPaths.has(n.path);
			const title = escapeHtml(n.title || '');
			const label = escapeHtml((n.title || '').toLowerCase());
			const ext = externalDocLinkForPath(n.path);
			const href = escapeHtml(ext?.href || n.path);
			const pathAttr = escapeHtml(n.path.toLowerCase());
			const manualRootAttr = n.path === mlsManualPath ? ' data-manual-root="1"' : '';
			const externalAttrs = ext ? ` target="${ext.target}" rel="${ext.rel}"` : '';

			if (n.children.length) {
				const kids = renderDocNavHtml(n.children, depth + 1, forceOpen);
				const summaryInner = n.hasPage
					? `<a class="docNavSummaryLink" href="${href}"${externalAttrs}>${title}</a>`
					: `<span class="docNavSummaryText">${title}</span>`;
				return `<li class="docNavNode" data-doc-nav-node="1" data-depth="${depth}" data-label="${label}" data-path="${pathAttr}"${manualRootAttr}><details class="docNavGroup" ${
					isOpen ? 'open' : ''
				} data-default-open="${isOpen ? '1' : '0'}"><summary class="docNavSummary${isCurrent ? ' active' : ''}">${summaryInner}</summary><ul class="docNavList">${kids}</ul></details></li>`;
			}

			if (n.hasPage) {
				return `<li class="docNavItem" data-doc-nav-node="1" data-depth="${depth}" data-label="${label}" data-path="${pathAttr}"${manualRootAttr}><a class="docNavLink${isCurrent ? ' active' : ''}" href="${href}"${externalAttrs}>${title}</a></li>`;
			}

			return `<li class="docNavItem" data-doc-nav-node="1" data-depth="${depth}" data-label="${label}" data-path="${pathAttr}"${manualRootAttr}><span class="docNavLabel">${title}</span></li>`;
		})
		.join('');

const extractSteps = (html: string) => {
	const m = html.match(/<ol[^>]*>([\s\S]*?)<\/ol>/i);
	if (!m) return [];
	const olInner = m[1] || '';
	const steps: string[] = [];
	const liRe = /<li[^>]*>([\s\S]*?)<\/li>/gi;
	let hit: RegExpExecArray | null = null;
	while ((hit = liRe.exec(olInner))) {
		const text = stripTags(hit[1] || '').replace(/\s+/g, ' ').trim();
		if (text) steps.push(text);
		if (steps.length >= 10) break;
	}
	return steps;
};

const origin = 'https://info.propertylist.es';
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: `${origin}/`,
		},
		...crumbs.map((c, i) => ({
			'@type': 'ListItem',
			position: i + 2,
			name: c.label,
			item: `${origin}${c.href}`,
		})),
		{
			'@type': 'ListItem',
			position: crumbs.length + 2,
			name: stripInfoHubSuffix(h1),
			item: canonical,
		},
	],
};

const toIso = (value: string | null | undefined) => {
	if (!value) return null;
	const ms = Date.parse(String(value));
	return Number.isFinite(ms) ? new Date(ms).toISOString() : null;
};

const articleType = isBlogLike ? 'BlogPosting' : isDocs ? 'TechArticle' : 'Article';
const datePublished = isBlogLike ? toIso((page as any).date_created) : null;
const dateModified = isBlogLike ? toIso((page as any).date_updated || (page as any).date_created) : null;
const absUrl = (u: string) => (/^https?:\/\//i.test(u) ? u : `${origin}${u.startsWith('/') ? u : `/${u}`}`);
const heroAbs = heroSrc ? absUrl(heroSrc) : null;

const articleLd = {
	'@context': 'https://schema.org',
	'@type': articleType,
	headline: h1,
	description: description,
	inLanguage: lang === 'en' ? 'en-GB' : lang,
	mainEntityOfPage: canonical,
	url: canonical,
	...(isBlogLike && heroAbs ? { image: heroAbs } : null),
	...(datePublished ? { datePublished } : null),
	...(dateModified ? { dateModified } : null),
};

const stepTexts = extractSteps(bodyHtml);
const howToLd =
	stepTexts.length >= 2
		? {
				'@context': 'https://schema.org',
				'@type': 'HowTo',
				name: h1,
				description: description,
				inLanguage: lang === 'en' ? 'en-GB' : lang,
				step: stepTexts.map((t, i) => ({
					'@type': 'HowToStep',
					position: i + 1,
					name: t.length > 80 ? `${t.slice(0, 77)}...` : t,
					text: t,
				})),
			}
		: null;

const placeLd = (() => {
	if (!isNeighbourhood) return null;
	const g: any = neighbourhoodMeta?.neighbourhoodGeo;
	const lat = typeof g?.lat === 'number' ? g.lat : Number(g?.lat);
	const lon = typeof g?.lon === 'number' ? g.lon : Number(g?.lon);
	if (!Number.isFinite(lat) || !Number.isFinite(lon)) return null;
	return {
		'@context': 'https://schema.org',
		'@type': 'Place',
		name: stripGuideSuffix(h1),
		url: canonical,
		geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lon },
	};
})();

const faqLd = (() => {
	if (!isNeighbourhood) return null;
	const faqs = neighbourhoodMeta?.neighbourhoodFaq || [];
	if (!faqs.length) return null;
	return {
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((f: { q: string; a: string }) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	};
})();

const toHttps = (u: string) => String(u || '').replace(/^http:\/\//i, 'https://');

const listingsLd = (() => {
	if (!isNeighbourhood) return null;
	const listings = neighbourhoodMeta?.neighbourhoodListings || [];
	if (!listings.length) return null;
	const items = listings
		.slice(0, 4)
		.map((l: any, i: number) => {
			const url = toHttps(String(l?.url || '').trim());
			if (!url) return null;
			const name = String(l?.title || '').trim() || null;
			const img = typeof l?.imageUrl === 'string' ? toHttps(String(l.imageUrl).trim()) : '';
			const price = typeof l?.priceEur === 'number' ? l.priceEur : null;
			const beds = typeof l?.bedrooms === 'number' ? l.bedrooms : null;
			const baths = typeof l?.bathrooms === 'number' ? l.bathrooms : null;
			const build = typeof l?.buildM2 === 'number' ? l.buildM2 : null;
			return {
				'@type': 'ListItem',
				position: i + 1,
				url,
				item: {
					'@type': 'RealEstateListing',
					name,
					url,
					...(img ? { image: [img] } : null),
					...(typeof beds === 'number' ? { numberOfRooms: beds } : null),
					...(typeof baths === 'number' ? { numberOfBathroomsTotal: baths } : null),
					...(typeof build === 'number' ? { floorSize: { '@type': 'QuantitativeValue', value: build, unitCode: 'MTK' } } : null),
					...(typeof price === 'number'
						? {
								offers: {
									'@type': 'Offer',
									priceCurrency: 'EUR',
									price: Math.round(price),
									url,
									availability: 'https://schema.org/InStock',
								},
						  }
						: null),
				},
			};
		})
		.filter(Boolean);
	if (!items.length) return null;
	return {
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: `${stripGuideSuffix(h1)} homes for sale`,
		itemListElement: items,
	};
})();

const ldJson = JSON.stringify([
	breadcrumbLd,
	articleLd,
	...(howToLd ? [howToLd] : []),
	...(placeLd ? [placeLd] : []),
	...(listingsLd ? [listingsLd] : []),
	...(faqLd ? [faqLd] : []),
]);
---

{isArea ? (
	<AreaPage lang={lang} page={page} meta={areaMeta} canonical={canonical} hreflangs={hreflangs} clientMode={clientMode} />
) : (
	<Layout
		lang={lang}
		title={title}
		description={description}
		canonical={canonical}
		hreflangs={hreflangs}
		ogImage={isBlogLike ? heroSrc : undefined}
		twitterCard="summary_large_image"
	>
		<script type="application/ld+json" slot="head" is:inline set:html={ldJson} />
		<article class:list={['doc', isBlogLike ? 'blogPost' : null]}>
		<header class="docHeader">
			<div class="docHeaderTop">
				<div class="docIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M7.5 3.75h9a1.75 1.75 0 0 1 1.75 1.75v13A1.75 1.75 0 0 1 16.5 20.25h-9A1.75 1.75 0 0 1 5.75 18.5v-13A1.75 1.75 0 0 1 7.5 3.75Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path d="M8.5 8h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						<path d="M8.5 12h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						<path d="M8.5 16h4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
					</svg>
				</div>
				<nav class="docCrumbs" aria-label="Breadcrumb">
					<span class="docCrumb">
						<a href="/">Home</a>
					</span>
					{crumbs.map((c) => (
						<span class="docCrumb">
							<span class="docCrumbSep" aria-hidden="true">
								/
							</span>
							<a href={c.href}>{c.label}</a>
						</span>
					))}
					<span class="docCrumb">
						<span class="docCrumbSep" aria-hidden="true">
							/
						</span>
						<span class="docCrumbCurrent">{stripInfoHubSuffix(h1)}</span>
					</span>
				</nav>
				{isDocs ? (
					<div class="docHeaderActions">
						<select class="docManualSelect" data-doc-manual-select aria-label="Select manual">
							{docsManualOptions.map((m) => (
								<option value={m.href} selected={Boolean(currentManualRoot && m.href === (externalDocLinkForPath(currentManualRoot)?.href || currentManualRoot))}>
									{m.title}
								</option>
							))}
						</select>
						<a class="docBrowseBtn" href={currentManualRoot || '/docs/'} data-doc-nav-open>
							Browse manual
						</a>
					</div>
				) : null}
			</div>

		{!bodyHasH1 && !moveDocHeaderIntoBody ? <h1 class="docTitle">{h1}</h1> : null}
		{!bodyHasH1 && !moveDocHeaderIntoBody && isBlogLike ? (
				<div class="blogMeta">
					<span class="blogAuthor">PropertyList</span>
					{blogMetaDate && blogDateLabel ? (
						<time class="blogDate" datetime={blogMetaDate.toISOString()}>
							{blogDateLabel}
						</time>
					) : null}
					<span class="blogRead">{readingMins} min read</span>
					<span class="blogRead" data-view-count data-view-locale="en-GB" data-view-suffix=" views">
						{viewCountLabel} views
					</span>
				</div>
			) : null}
		{!bodyHasH1 && !moveDocHeaderIntoBody && !isBlogLike && (isDocs || isNeighbourhood) ? (
			<div class="pageMeta" data-view-count data-view-locale="en-GB" data-view-suffix=" views">
				{viewCountLabel} views
			</div>
		) : null}
		{!bodyHasH1 && !moveDocHeaderIntoBody && page.description ? <p class="docLead">{page.description}</p> : null}
		</header>

		<div class:list={['docGrid', isDocs ? 'withNav' : null]}>
			{isDocs ? (
				<aside class="docNav" aria-label="Docs navigation" data-current-manual-root={currentManualRoot || ''}>
					<div class="docNavHeader">
						<div class="docNavTitle">{currentManualTitle || 'Docs'}</div>
						<form class="docNavFilterRow" method="get">
							<input
								id="doc-nav-filter-desktop"
								class="docNavFilterInput"
								type="search"
								autocomplete="off"
								spellcheck="false"
								placeholder="Filter this manual…"
								aria-label="Filter this manual"
								data-doc-nav-filter="desktop"
								name="filter"
								value={navFilter}
							/>
							<button type="submit" hidden>
								Apply
							</button>
						</form>
					</div>
					<ul class="docNavList">
						<Fragment set:html={renderDocNavHtml(filteredDocsChildren, 0, Boolean(navFilter))} />
					</ul>
				</aside>
			) : null}

			<div class="docMain">
				{isNeighbourhood ? <AreaGuide areaName={h1} lang="en" /> : null}

				{isNeighbourhood ? (
					<style>
						.nbTop {
							margin: 0 0 14px;
							padding: 12px;
							border: 1px solid rgba(16, 24, 40, 0.08);
							border-radius: 18px;
							background: rgba(255, 255, 255, 0.7);
						}

						.nbCtas {
							display: flex;
							gap: 10px;
							flex-wrap: wrap;
							margin-bottom: 12px;
						}

						.nbBtn {
							display: inline-flex;
							align-items: center;
							justify-content: center;
							padding: 10px 12px;
							border-radius: 12px;
							border: 1px solid rgba(16, 24, 40, 0.14);
							background: rgba(255, 255, 255, 0.9);
							text-decoration: none;
							font-weight: 800;
							color: rgba(16, 24, 40, 0.86);
						}

						.nbBtn.primary {
							border-color: rgba(0, 174, 154, 0.35);
							background: rgba(0, 174, 154, 0.12);
						}

						.nbStats {
							display: grid;
							grid-template-columns: repeat(3, minmax(0, 1fr));
							gap: 10px;
							margin: 0;
						}

						.nbStat {
							background: rgba(247, 248, 250, 0.7);
							border: 1px solid rgba(16, 24, 40, 0.08);
							border-radius: 14px;
							padding: 10px 12px;
						}

						.nbStat dt {
							font-size: 12px;
							font-weight: 800;
							letter-spacing: 0.12em;
							text-transform: uppercase;
							color: rgba(16, 24, 40, 0.6);
							margin: 0 0 6px;
						}

						.nbStat dd {
							margin: 0;
							font-size: 16px;
							font-weight: 900;
							color: rgba(16, 24, 40, 0.86);
						}

						.nbStatsEmpty {
							padding: 10px 12px;
							border-radius: 14px;
							border: 1px dashed rgba(16, 24, 40, 0.18);
							color: rgba(16, 24, 40, 0.68);
							background: rgba(255, 255, 255, 0.6);
						}

						.nbToc {
							margin-top: 12px;
							border-top: 1px solid rgba(16, 24, 40, 0.08);
							padding-top: 12px;
						}

						.nbTocTitle {
							font-size: 12px;
							font-weight: 900;
							letter-spacing: 0.14em;
							text-transform: uppercase;
							color: rgba(16, 24, 40, 0.6);
							margin: 0 0 8px;
						}

						.nbTocList {
							list-style: none;
							padding: 0;
							margin: 0;
							display: grid;
							grid-template-columns: repeat(2, minmax(0, 1fr));
							gap: 6px 10px;
						}

						.nbTocItem {
							margin: 0;
						}

						.nbTocItem.depth3 {
							opacity: 0.9;
						}

						.nbTocLink {
							display: block;
							padding: 8px 10px;
							border-radius: 12px;
							border: 1px solid rgba(16, 24, 40, 0.1);
							background: rgba(255, 255, 255, 0.9);
							text-decoration: none;
							color: rgba(16, 24, 40, 0.8);
							font-weight: 700;
							font-size: 13px;
						}

						.nbAuto {
							margin-top: 14px;
						}

						.nbListings {
							margin: 0 0 14px;
							padding: 12px;
							border: 1px solid rgba(16, 24, 40, 0.08);
							border-radius: 18px;
							background: rgba(255, 255, 255, 0.7);
						}

						.nbListingsTop {
							display: flex;
							align-items: center;
							justify-content: space-between;
							gap: 10px;
							margin-bottom: 10px;
						}

						.nbListingsTitle {
							font-size: 12px;
							font-weight: 900;
							letter-spacing: 0.14em;
							text-transform: uppercase;
							color: rgba(16, 24, 40, 0.6);
							margin: 0;
						}

						.nbListingsLink {
							text-decoration: none;
							font-weight: 800;
							color: rgba(0, 174, 154, 0.9);
						}

						.nbListingsGrid {
							display: grid;
							grid-template-columns: repeat(2, minmax(0, 1fr));
							gap: 10px;
						}

						.nbCard {
							display: grid;
							grid-template-columns: 110px 1fr;
							gap: 10px;
							border: 1px solid rgba(16, 24, 40, 0.1);
							border-radius: 14px;
							background: rgba(255, 255, 255, 0.9);
							text-decoration: none;
							color: rgba(16, 24, 40, 0.86);
							overflow: hidden;
						}

						.nbCardImg {
							width: 110px;
							height: 100%;
							min-height: 92px;
							object-fit: cover;
							display: block;
							background: rgba(247, 248, 250, 0.9);
						}

						.nbCardImgEmpty {
							width: 110px;
							min-height: 92px;
							background: rgba(247, 248, 250, 0.9);
						}

						.nbCardBody {
							padding: 10px 10px 10px 0;
						}

						.nbCardTitle {
							font-weight: 900;
							font-size: 13px;
							line-height: 1.25;
							margin: 0 0 6px;
						}

						.nbCardMeta {
							display: flex;
							gap: 8px;
							flex-wrap: wrap;
							font-size: 12px;
							font-weight: 800;
							color: rgba(16, 24, 40, 0.7);
						}

						.nbMap iframe {
							width: 100%;
							height: 320px;
							border: 0;
							border-radius: 14px;
							background: rgba(255, 255, 255, 0.9);
						}

						.nbMapLink {
							margin: 8px 0 0;
						}

						.nbCompareWrap {
							overflow: auto;
							border-radius: 14px;
							border: 1px solid rgba(16, 24, 40, 0.08);
							background: rgba(255, 255, 255, 0.9);
						}

						.nbCompare {
							width: 100%;
							border-collapse: collapse;
							table-layout: fixed;
						}

						.nbCompare th,
						.nbCompare td {
							padding: 10px 12px;
							border-bottom: 1px solid rgba(16, 24, 40, 0.08);
							text-align: left;
							vertical-align: top;
							color: rgba(16, 24, 40, 0.8);
							font-size: 14px;
							overflow-wrap: anywhere;
						}

						.nbCompare thead th {
							font-weight: 900;
							color: rgba(16, 24, 40, 0.86);
							background: rgba(247, 248, 250, 0.9);
							position: sticky;
							top: 0;
						}

						.nbCompare tbody th {
							font-weight: 900;
							color: rgba(16, 24, 40, 0.86);
							background: rgba(255, 255, 255, 0.7);
						}

						@media (max-width: 820px) {
							.nbStats {
								grid-template-columns: repeat(2, minmax(0, 1fr));
							}

							.nbListingsGrid {
								grid-template-columns: 1fr;
							}

							.nbCard {
								grid-template-columns: 96px 1fr;
							}

							.nbCardImg,
							.nbCardImgEmpty {
								width: 96px;
							}

							.nbTocList {
								grid-template-columns: 1fr;
							}
						}

						@media (max-width: 560px) {
							.nbCompareWrap {
								max-width: 100%;
								overflow-x: auto;
								-webkit-overflow-scrolling: touch;
							}

							.nbCompare th,
							.nbCompare td {
								font-size: 13px;
								padding: 10px;
							}
						}
					</style>
				) : null}

				<style>
					.blogPropertySection {
						margin: 32px 0;
						padding: 24px;
						border: 1px solid rgba(16, 24, 40, 0.08);
						border-radius: 18px;
						background: rgba(0, 174, 154, 0.04);
					}
					.blogPropertyTitle {
						margin: 0 0 16px;
						font-size: 20px;
						font-weight: 900;
						letter-spacing: -0.01em;
					}
					.blogPropertyGrid {
						display: grid;
						grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
						gap: 16px;
					}
					.blogPropertyCta {
						margin: 16px 0 0;
						text-align: center;
					}
					.blogPropertyCta a {
						color: var(--accent, #00ae9a);
						font-weight: 900;
						text-decoration: none;
					}
					.blogPropertyCta a:hover {
						text-decoration: underline;
					}
				</style>

				<div class="docContent">{finalBodyHtml ? <Fragment set:html={finalBodyHtml} /> : null}</div>

				{isBlogLike ? (
					<section class="blogPropertySection" aria-label="Featured properties">
						<h2 class="blogPropertyTitle">Featured Properties</h2>
						<div class="blogPropertyGrid">
							<PropertyCard
								title="Stunning Sea View Apartment"
								price="€650,000"
								location="Estepona, Málaga"
								beds={2}
								baths={2}
								area="90 m²"
								image="/blog/hero-marbella-property.png"
								url="https://propertylist.es/"
							/>
							<PropertyCard
								title="Luxury Villa with Pool"
								price="€1,200,000"
								location="Marbella, Málaga"
								beds={4}
								baths={3}
								area="250 m²"
								image="/blog/hero-villa-spain.jpg"
								url="https://propertylist.es/"
							/>
						</div>
						<p class="blogPropertyCta">
							<a href="https://propertylist.es/" target="_blank" rel="noopener">Browse all listings on PropertyList →</a>
						</p>
					</section>
				) : null}

				{folderArticles.length ? (
					<section class="docArticles" aria-label="Articles">
						<div class="docArticlesTitle">Articles</div>
						<ul class="docArticlesList">
							{folderArticles.map((a) => (
								<li>
									<a class="docArticlesLink" href={a.href} target={a.external ? '_blank' : undefined} rel={a.external ? 'noopener' : undefined}>
										<span class="docArticlesLinkTitle">{a.title}</span>
										{a.description ? <span class="docArticlesLinkDesc">{a.description}</span> : null}
									</a>
								</li>
							))}
						</ul>
					</section>
				) : null}

				{prev || next ? (
					<footer class="docPager" aria-label="Page navigation">
						{prev ? (
							<a class="docPagerLink" href={prev.href || prev.path} target={prev.external ? '_blank' : undefined} rel={prev.external ? 'noopener' : undefined}>
								<span class="docPagerKicker">Previous</span>
								<span class="docPagerTitle">{prev.title}</span>
							</a>
						) : (
							<span />
						)}
						{next ? (
							<a class="docPagerLink" href={next.href || next.path} target={next.external ? '_blank' : undefined} rel={next.external ? 'noopener' : undefined}>
								<span class="docPagerKicker">Next</span>
								<span class="docPagerTitle">{next.title}</span>
							</a>
						) : null}
					</footer>
				) : null}
			</div>

			{toc.filter((t) => t.depth === 2).length > 1 ? (
				<aside class="docToc" aria-label="On this page">
					<div class="docTocTitle">On this page</div>
					<ol class="docTocList">
						{toc
							.filter((t) => t.depth === 2)
							.slice(0, 12)
							.map((t) => (
								<li>
									<a href={`#${t.id}`}>{t.text}</a>
								</li>
							))}
					</ol>
				</aside>
			) : null}
		</div>
	</article>

	{isDocs ? (
		<button class="docNavStickyTag" type="button" data-doc-nav-open aria-label="Open filters">
			<span class="docNavStickyIcon" aria-hidden="true">≡</span>
			<span class="docNavStickyText">Filters</span>
		</button>
	) : null}
	{isDocs ? (
		<div class="docNavOverlay" data-doc-nav-overlay hidden>
			<div class="docNavDrawer" role="dialog" aria-modal="true" aria-label="Browse manual">
				<div class="docNavDrawerTop">
					<div class="docNavDrawerHeader">
						<div class="docNavDrawerTitle">{currentManualTitle || 'Docs'}</div>
						<button class="docNavDrawerClose" type="button" data-doc-nav-close aria-label="Close">
							Close
						</button>
					</div>
					<form class="docNavFilterRow" method="get">
						<input
							id="doc-nav-filter-mobile"
							class="docNavFilterInput"
							type="search"
							autocomplete="off"
							spellcheck="false"
							placeholder="Filter this manual…"
							aria-label="Filter this manual"
							data-doc-nav-filter="mobile"
							name="filter"
							value={navFilter}
						/>
						<button type="submit" hidden>
							Apply
						</button>
					</form>
				</div>
				<nav class="docNavDrawerBody" aria-label="Docs navigation" data-current-manual-root={currentManualRoot || ''}>
					<ul class="docNavList">
						<Fragment set:html={renderDocNavHtml(filteredDocsChildren, 0, Boolean(navFilter))} />
					</ul>
				</nav>
			</div>
		</div>
	) : null}
	{isDocs ? (
		<script
			is:inline
			set:html={String.raw`(() => {
  const openBtns = Array.from(document.querySelectorAll('[data-doc-nav-open]'));
  let lastOpenBtn = openBtns.find((x) => x instanceof HTMLElement) || null;
  const overlay = document.querySelector('[data-doc-nav-overlay]');
  const drawer = overlay?.querySelector('.docNavDrawer');
  const drawerScroll = drawer instanceof HTMLElement ? drawer : null;
  const closeBtn = overlay?.querySelector('[data-doc-nav-close]');
  const mobileMq = window.matchMedia('(max-width: 960px)');
  const desktopNav = document.querySelector('.docNav');
  const drawerBody = overlay?.querySelector('.docNavDrawerBody');
  const manualSelect = document.querySelector('[data-doc-manual-select]');
  const getInputs = () => Array.from(document.querySelectorAll('input[data-doc-nav-filter]')).filter((x) => x instanceof HTMLInputElement);

  const getActiveEl = (container) => {
    if (!(container instanceof HTMLElement)) return null;
    const hits = Array.from(container.querySelectorAll('.docNavLink.active, .docNavSummary.active, .docNavSummaryLink.active')).filter(
      (x) => x instanceof HTMLElement,
    );
    if (!hits.length) return null;
    let best = hits[0];
    let bestDepth = -1;
    for (const el of hits) {
      const node = el.closest('[data-depth]');
      const d = node ? Number.parseInt(node.getAttribute('data-depth') || '0', 10) : 0;
      if (d > bestDepth) {
        bestDepth = d;
        best = el;
      } else if (d === bestDepth) {
        best = el;
      }
    }
    return best;
  };

  const scrollToActive = (container) => {
    if (!(container instanceof HTMLElement)) return;
    const active = getActiveEl(container);
    if (!(active instanceof HTMLElement)) return;
    const parentGroups = [];
    let d = active.closest('details.docNavGroup');
    while (d instanceof HTMLDetailsElement) {
      parentGroups.push(d);
      d = d.parentElement?.closest('details.docNavGroup');
    }
    for (const g of parentGroups) g.open = true;
    const c = container.getBoundingClientRect();
    const a = active.getBoundingClientRect();
    const header = container.querySelector('.docNavHeader');
    const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
    const delta = a.top - c.top - headerHeight - container.clientHeight * 0.35;
    container.scrollTop = Math.max(0, container.scrollTop + delta);
  };

  const STORAGE_KEY = 'docNavScrollTargetV1';
  const normalisePath = (href) => {
    try {
      const u = new URL(String(href || ''), window.location.origin);
      if (u.origin !== window.location.origin) return null;
      const p = u.pathname || '/';
      return p.endsWith('/') ? p : p + '/';
    } catch {
      return null;
    }
  };

  const scrollElementToTop = (container, el) => {
    if (!(container instanceof HTMLElement)) return;
    if (!(el instanceof HTMLElement)) return;
    const c = container.getBoundingClientRect();
    const a = el.getBoundingClientRect();
    const header = container.querySelector('.docNavHeader');
    const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
    const delta = a.top - c.top - headerHeight - 8;
    container.scrollTop = Math.max(0, container.scrollTop + delta);
  };

  const scrollToStoredTarget = (container) => {
    if (!(container instanceof HTMLElement)) return false;
    const target = sessionStorage.getItem(STORAGE_KEY);
    if (!target) return false;
    const current = normalisePath(window.location.pathname);
    if (!current || current !== target) return false;
    sessionStorage.removeItem(STORAGE_KEY);
    const links = Array.from(container.querySelectorAll('a.docNavLink, a.docNavSummaryLink'));
    const hit = links.find((a) => normalisePath(a.getAttribute('href')) === target);
    if (hit instanceof HTMLElement) {
      scrollElementToTop(container, hit);
      return true;
    }
    const active = getActiveEl(container);
    if (active instanceof HTMLElement) {
      scrollElementToTop(container, active);
      return true;
    }
    return false;
  };

  const ensureScrolledToActive = (container, tries = 0) => {
    if (!(container instanceof HTMLElement)) return;
    if (tries === 0 && scrollToStoredTarget(container)) return;
    scrollToActive(container);
    const active = getActiveEl(container);
    if (active instanceof HTMLElement) {
      const c = container.getBoundingClientRect();
      const a = active.getBoundingClientRect();
      const header = container.querySelector('.docNavHeader');
      const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
      const visible = a.top >= c.top + headerHeight + 10 && a.bottom <= c.bottom - 10;
      if (visible) return;
    }
    if (tries >= 10) return;
    setTimeout(() => ensureScrolledToActive(container, tries + 1), 60);
  };

  const setOpen = (next) => {
    if (!(overlay instanceof HTMLElement)) return;
    const canOpen = mobileMq.matches;
    const effective = Boolean(next && canOpen);
    overlay.hidden = !effective;
    document.documentElement.classList.toggle('docNavLock', effective);
    if (next && drawer instanceof HTMLElement) drawer.focus?.();
    if (!next && lastOpenBtn instanceof HTMLElement) lastOpenBtn.focus?.();
    if (next && drawerScroll instanceof HTMLElement) requestAnimationFrame(() => ensureScrolledToActive(drawerScroll, 0));
  };

  setOpen(false);
  mobileMq.addEventListener?.('change', () => setOpen(false));
  window.addEventListener?.('pageshow', (e) => {
    if (e?.persisted) setOpen(false);
  });
  window.addEventListener?.('hashchange', () => setOpen(false));

  if (desktopNav instanceof HTMLElement) {
    requestAnimationFrame(() => ensureScrolledToActive(desktopNav, 0));
    window.addEventListener('load', () => ensureScrolledToActive(desktopNav, 0), { once: true });
  }

  if (manualSelect instanceof HTMLSelectElement) {
    manualSelect.addEventListener('change', () => {
      const href = String(manualSelect.value || '');
      if (!href) return;
      const next = normalisePath(href);
      if (next) sessionStorage.setItem(STORAGE_KEY, next);
      window.location.assign(href);
    });
  }

  const restoreDefaults = (container) => {
    if (!(container instanceof HTMLElement)) return;
    const groups = Array.from(container.querySelectorAll('details.docNavGroup'));
    for (const d of groups) {
      const val = d.getAttribute('data-default-open') || '0';
      d.open = val === '1';
    }
  };

  const applyTo = (container, qRaw) => {
    if (!(container instanceof HTMLElement)) return;
    const nodes = Array.from(container.querySelectorAll('[data-doc-nav-node]'));
    const groups = Array.from(container.querySelectorAll('details.docNavGroup'));
    const manualRoot = (container.getAttribute('data-current-manual-root') || '').toLowerCase();
    const q = String(qRaw || '').trim().toLowerCase();
    if (!q) {
      for (const el of nodes) {
        el.hidden = false;
        if (el instanceof HTMLElement) el.style.removeProperty('display');
      }
      restoreDefaults(container);
      return;
    }

    for (const el of nodes) {
      const label = (el.getAttribute('data-label') || '').toLowerCase();
      const path = (el.getAttribute('data-path') || '').toLowerCase();
      const text = (el.textContent || '').toLowerCase();
      const withinManual = !manualRoot || path.startsWith(manualRoot);
      const matches = label.includes(q) || path.includes(q) || text.includes(q);
      const hide = !withinManual || !matches;
      el.hidden = hide;
      if (el instanceof HTMLElement) el.style.display = hide ? 'none' : '';
    }

    for (let i = nodes.length - 1; i >= 0; i--) {
      const el = nodes[i];
      const hasVisibleChild = Array.from(el.querySelectorAll('[data-doc-nav-node]')).some((c) => c !== el && !c.hidden);
      if (hasVisibleChild) {
        el.hidden = false;
        if (el instanceof HTMLElement) el.style.display = '';
      }
    }

    for (const d of groups) {
      const hasVisible = Array.from(d.querySelectorAll('[data-doc-nav-node]')).some((c) => !c.hidden);
      d.open = hasVisible;
    }
  };

  const scrollToFirstVisible = (container) => {
    if (!(container instanceof HTMLElement)) return;
    const link = Array.from(container.querySelectorAll('a.docNavLink, a.docNavSummaryLink')).find((a) => a instanceof HTMLElement && !a.closest('[hidden]'));
    if (!(link instanceof HTMLElement)) return;
    const c = container.getBoundingClientRect();
    const a = link.getBoundingClientRect();
    const delta = a.top - c.top - container.clientHeight * 0.25;
    container.scrollTop = Math.max(0, container.scrollTop + delta);
  };

  const onInput = (ev) => {
    const src = ev?.target;
    if (!(src instanceof HTMLInputElement)) return;
    if (!src.matches('input[data-doc-nav-filter]')) return;
    const inputs = getInputs();
    for (const other of inputs) {
      if (other instanceof HTMLInputElement && other !== src) other.value = src.value;
    }
    applyTo(desktopNav, src.value);
    applyTo(drawerBody, src.value);
    const mode = src.getAttribute('data-doc-nav-filter');
    const container = mode === 'mobile' ? drawerScroll || drawerBody : desktopNav;
    requestAnimationFrame(() => scrollToFirstVisible(container));
  };

  const attachFilterListeners = () => {
    const inputs = getInputs();
    for (const input of inputs) {
      if (input.dataset.docNavFilterBound === '1') continue;
      input.dataset.docNavFilterBound = '1';
      input.addEventListener('input', onInput);
      input.addEventListener('search', onInput);
      input.addEventListener('keyup', onInput);
    }
  };
  attachFilterListeners();
  document.addEventListener('input', onInput, true);
  document.addEventListener('search', onInput, true);
  document.addEventListener('keyup', onInput, true);
  const initialInputs = getInputs();
  for (const input of initialInputs) {
    if (input.value.trim()) {
      applyTo(desktopNav, input.value);
      applyTo(drawerBody, input.value);
      break;
    }
  }

  let lastFilterValue = null;
  window.setInterval(() => {
    const inputs = getInputs();
    const active =
      inputs.find((i) => i.getAttribute('data-doc-nav-filter') === (mobileMq.matches ? 'mobile' : 'desktop')) || inputs[0];
    const value = active instanceof HTMLInputElement ? active.value : '';
    if (value === lastFilterValue) return;
    lastFilterValue = value;
    applyTo(desktopNav, value);
    applyTo(drawerBody, value);
  }, 250);

  for (const btn of openBtns) {
    if (!(btn instanceof HTMLElement)) continue;
    btn.addEventListener('click', (e) => {
      if (!mobileMq.matches) return;
      e.preventDefault?.();
      lastOpenBtn = btn;
      setOpen(true);
    });
  }
  if (closeBtn instanceof HTMLElement) closeBtn.addEventListener('click', () => setOpen(false));
  if (desktopNav instanceof HTMLElement) {
    desktopNav.addEventListener('click', (e) => {
      const el = e.target;
      if (!(el instanceof Element)) return;
      const a = el.closest('a.docNavLink, a.docNavSummaryLink');
      if (!(a instanceof HTMLAnchorElement)) return;
      const next = normalisePath(a.getAttribute('href'));
      if (next) sessionStorage.setItem(STORAGE_KEY, next);
    });
  }
  if (drawerBody instanceof HTMLElement) {
    drawerBody.addEventListener('click', (e) => {
      const el = e.target;
      if (!(el instanceof Element)) return;
      const a = el.closest('a');
      if (!(a instanceof HTMLAnchorElement)) return;
      const isDocNavLink = a.matches('a.docNavLink, a.docNavSummaryLink');
      const next = normalisePath(a.getAttribute('href'));
      if (isDocNavLink && next) sessionStorage.setItem(STORAGE_KEY, next);
      setOpen(false);
    }, true);
  }
  if (overlay instanceof HTMLElement) {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) setOpen(false);
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
})();`}
		></script>
	) : null}
	</Layout>
)}
