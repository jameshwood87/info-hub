					buildM2: typeof l?.buildM2 === 'number' ? l.buildM2 : l?.buildM2 ? Number(l.buildM2) : null,
				}))
				.filter((l: any) => l.url && l.title)
		: undefined;
	return { neighbourhoodStats, neighbourhoodStatsUpdatedAt, neighbourhoodStatsDueAt, neighbourhoodFaq, neighbourhoodGeo, neighbourhoodListings };
})();

