		typeof (kbMeta as any).neighbourhoodStatsUpdatedAt === 'string' ? String((kbMeta as any).neighbourhoodStatsUpdatedAt) : undefined;
	const neighbourhoodStatsDueAt =
		typeof (kbMeta as any).neighbourhoodStatsDueAt === 'string' ? String((kbMeta as any).neighbourhoodStatsDueAt) : undefined;
	const rawFaq = Array.isArray((kbMeta as any).neighbourhoodFaq) ? (kbMeta as any).neighbourhoodFaq : undefined;
	const neighbourhoodFaq = rawFaq
		? rawFaq
				.map((f: any) => ({ q: String(f?.q || '').trim(), a: String(f?.a || '').trim() }))
				.filter((f: any) => f.q && f.a)
		: undefined;
	const rawGeo = (kbMeta as any).neighbourhoodGeo;
	const neighbourhoodGeo = rawGeo && typeof rawGeo === 'object' ? rawGeo : undefined;
	const rawListings = Array.isArray((kbMeta as any).neighbourhoodListings) ? (kbMeta as any).neighbourhoodListings : undefined;
	const neighbourhoodListings = rawListings
		? rawListings
				.map((l: any) => ({
					url: String(l?.url || '').trim(),
					title: String(l?.title || '').trim(),
					imageUrl: typeof l?.imageUrl === 'string' ? String(l.imageUrl).trim() : null,
					priceEur: typeof l?.priceEur === 'number' ? l.priceEur : l?.priceEur ? Number(l.priceEur) : null,
