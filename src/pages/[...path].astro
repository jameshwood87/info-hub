const buildNeighbourhoodAutoHtml = (slug: string, name: string, stats: any, portalUrl: string, geo: any, updatedAtIso?: string) => {
	const slugKey = slugify(String(slug || '')) || slugify(String(name || ''));
	const n = escapeHtmlAttr(String(name || '').trim() || 'this area');
	const tagline = NEIGHBOURHOOD_TAGLINES[slugKey] || '';
	const muni = typeof stats?.municipality === 'string' ? String(stats.municipality).trim() : '';
	const listingCount = typeof stats?.listingCount === 'number' ? stats.listingCount : null;
	const sampleSize = typeof stats?.sampleSize === 'number' ? stats.sampleSize : null;
	const medPrice = typeof stats?.avgPriceEur === 'number' ? stats.avgPriceEur : null;
	const medPerM2 = typeof stats?.pricePerM2Eur === 'number' ? stats.pricePerM2Eur : null;
	const minPrice = typeof stats?.priceMinEur === 'number' ? stats.priceMinEur : null;
	const maxPrice = typeof stats?.priceMaxEur === 'number' ? stats.priceMaxEur : null;
	const recentAvgMaxC = typeof stats?.recentAvgMaxC === 'number' ? stats.recentAvgMaxC : null;
	const recentAvgMinC = typeof stats?.recentAvgMinC === 'number' ? stats.recentAvgMinC : null;
	const annualRainMm = typeof stats?.annualRainMm === 'number' ? stats.annualRainMm : null;
	const driveAirport = typeof stats?.driveToMalagaAirportMin === 'number' ? stats.driveToMalagaAirportMin : null;
	const driveMarbella = typeof stats?.driveToMarbellaMin === 'number' ? stats.driveToMarbellaMin : null;
	const driveBanus = typeof stats?.driveToPuertoBanusMin === 'number' ? stats.driveToPuertoBanusMin : null;
	const beachName = typeof stats?.nearestBeachName === 'string' ? String(stats.nearestBeachName).trim() : '';
	const driveBeach = typeof stats?.driveToBeachMin === 'number' ? stats.driveToBeachMin : null;
	const subareasRaw: string[] = Array.isArray(stats?.topSubareas)
		? stats.topSubareas
				.map((x: any) => String(x || '').trim())
				.filter(Boolean)
				.slice(0, 6)
		: [];
	const subareas = subareasRaw.filter((s) => slugify(s) !== slugKey && slugify(s) !== slugify(name) && (!muni || slugify(s) !== slugify(muni)));
	const types = stats?.propertyTypeBreakdown && typeof stats.propertyTypeBreakdown === 'object' ? stats.propertyTypeBreakdown : null;
	const updatedAtMs = updatedAtIso ? Date.parse(String(updatedAtIso)) : NaN;
	const updatedAtLabel = Number.isFinite(updatedAtMs)
		? new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(updatedAtMs))
		: '';

	const fmtEur = (v: number) => `€${Math.round(v).toLocaleString('en-GB')}`;
	const marketBits = [
		typeof listingCount === 'number' && listingCount > 0 ? `${listingCount.toLocaleString('en-GB')} listings` : null,
		typeof medPrice === 'number' ? `median asking price ${fmtEur(medPrice)}` : null,
		typeof medPerM2 === 'number' ? `median ${fmtEur(medPerM2)}/m²` : null,
		typeof minPrice === 'number' && typeof maxPrice === 'number' ? `range ${fmtEur(minPrice)} to ${fmtEur(maxPrice)}` : null,
		typeof sampleSize === 'number' && sampleSize > 0 ? `sample size ${sampleSize}` : null,
	].filter(Boolean);
	const hasMarket = typeof listingCount === 'number' && listingCount > 0 && marketBits.length > 1;

	const lat = typeof geo?.lat === 'number' ? geo.lat : Number(geo?.lat);
	const lon = typeof geo?.lon === 'number' ? geo.lon : Number(geo?.lon);
	const mapHtml =
		Number.isFinite(lat) && Number.isFinite(lon)
			? (() => {
					const dLon = 0.07;
					const dLat = 0.05;
					const left = lon - dLon;
					const right = lon + dLon;
					const bottom = lat - dLat;
					const top = lat + dLat;
					const bbox = `${left},${bottom},${right},${top}`;
					const src = `https://www.openstreetmap.org/export/embed.html?bbox=${encodeURIComponent(bbox)}&layer=mapnik&marker=${encodeURIComponent(
						`${lat},${lon}`,
					)}`;
					const link = `https://www.openstreetmap.org/?mlat=${encodeURIComponent(String(lat))}&mlon=${encodeURIComponent(
						String(lon),
					)}#map=12/${encodeURIComponent(String(lat))}/${encodeURIComponent(String(lon))}`;
					return `<div class="nbMap"><iframe title="Map of ${n}" src="${escapeHtmlAttr(src)}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><p class="nbMapLink"><a href="${escapeHtmlAttr(
						link,
					)}" target="_blank" rel="noopener">Open map</a></p></div>`;
			  })()
			: '';

	const typeHtml = types
		? (() => {
				const entries = Object.entries(types as Record<string, number>)
					.map(([k, v]) => ({ k: String(k || '').trim(), v: Number(v) }))
					.filter((x) => x.k && Number.isFinite(x.v) && x.v > 0)
					.sort((a, b) => b.v - a.v)
					.slice(0, 6);
				if (!entries.length) return '';
				return `<ul>${entries.map((x) => `<li>${escapeHtmlAttr(x.k)} ~ ${Math.round(x.v)}%</li>`).join('')}</ul>`;
		  })()
		: '';
	const topType = types
		? (() => {
				const entries = Object.entries(types as Record<string, number>)
					.map(([k, v]) => ({ k: String(k || '').trim(), v: Number(v) }))
					.filter((x) => x.k && Number.isFinite(x.v) && x.v > 0)
					.sort((a, b) => b.v - a.v);
				const first = entries[0];
				return first?.k ? String(first.k) : '';
		  })()
		: '';

	const isTownLike = ['benahavis', 'benalmadena', 'estepona', 'fuengirola', 'marbella', 'mijas-costa', 'nerja', 'torremolinos'].includes(slugKey);
	const isCityLike = ['malaga-centre', 'el-limonar', 'pedregalejo'].includes(slugKey);
	const isLuxuryLike = ['la-zagaleta', 'sierra-blanca', 'golden-mile', 'la-zagaleta'].includes(slugKey) || (typeof medPerM2 === 'number' && medPerM2 >= 6500);
	const isMarinaLike = ['puerto-banus'].includes(slugKey);
	const isGolfLike = ['la-quinta', 'nueva-andalucia', 'guadalmina', 'benahavis'].includes(slugKey);

	const hasBeach = Boolean(beachName) && typeof driveBeach === 'number' && driveBeach > 0;
	const proximityNamed = [
		typeof driveMarbella === 'number' ? `~${Math.round(driveMarbella)} min to Marbella` : null,
		typeof driveBanus === 'number' ? `~${Math.round(driveBanus)} min to Puerto Banús` : null,
		hasBeach ? `~${Math.round(driveBeach)} min to ${escapeHtmlAttr(beachName)}` : null,
	].filter(Boolean);
	const proximityGeneric = [
		typeof driveMarbella === 'number' ? `~${Math.round(driveMarbella)} min to Marbella` : null,
		typeof driveBanus === 'number' ? `~${Math.round(driveBanus)} min to Puerto Banús` : null,
		hasBeach ? `~${Math.round(driveBeach)} min to the nearest beach` : null,
	].filter(Boolean);

	const subareaInline = subareas.length ? subareas.slice(0, 3).map((s: string) => escapeHtmlAttr(s)).join(', ') : '';
	const subareaBullets = subareas.length ? `<ul>${subareas.map((s: string) => `<li>${escapeHtmlAttr(s)}</li>`).join('')}</ul>` : '';
	const keyFacts = [
		typeof driveAirport === 'number' ? `<li><strong>Málaga Airport:</strong> ~${Math.round(driveAirport)} min by car</li>` : '',
		typeof medPerM2 === 'number' ? `<li><strong>Typical pricing:</strong> ~${fmtEur(medPerM2)}/m² (median, PropertyList snapshot${updatedAtLabel ? `, ${escapeHtmlAttr(updatedAtLabel)}` : ''})</li>` : '',
		hasBeach ? `<li><strong>Nearest beach:</strong> ~${Math.round(driveBeach)} min</li>` : '',
		typeof listingCount === 'number' && listingCount > 0 ? `<li><strong>Live stock depth:</strong> ${Math.round(listingCount).toLocaleString('en-GB')} listings (PropertyList)</li>` : '',
		typeof recentAvgMaxC === 'number' || typeof annualRainMm === 'number'
			? `<li><strong>Climate context:</strong> ${
					typeof recentAvgMaxC === 'number'
						? `recent avg ~${recentAvgMaxC}°C max${typeof recentAvgMinC === 'number' ? ` / ~${recentAvgMinC}°C min` : ''}`
						: ''
				}${(typeof recentAvgMaxC === 'number' || typeof recentAvgMinC === 'number') && typeof annualRainMm === 'number' ? '; ' : ''}${
					typeof annualRainMm === 'number' ? `annual rainfall ~${Math.round(annualRainMm)} mm` : ''
				} (Open-Meteo archive)</li>`
			: '',
	]
		.filter(Boolean)
		.join('');

	const buyersPriorities = 'Micro-location choice, community quality, and resale fundamentals';
	const rentersPriorities = 'Daily convenience, noise/winter comfort, and reliable internet/parking';

	const identityLine = (() => {
		const bits = [
			isLuxuryLike ? 'privacy, security, and community standards matter more than headline square metres' : '',
			isGolfLike ? 'golf-driven micro-areas and community quality tend to be the big differentiators' : '',
			isMarinaLike ? 'seasonality and noise tolerance can be deal-breakers street by street' : '',
			isCityLike ? 'parking, building condition, and day-to-day noise profiles vary sharply by block' : '',
		].filter(Boolean);
		return bits.length ? bits.join('; ') : '';
	})();

	return `
<section class="nbAuto" aria-label="Neighbourhood guide details">
<h2>At a glance</h2>
<p>${n}${tagline ? ` is ${escapeHtmlAttr(tagline)}.` : ' sits on the Costa del Sol, where results depend heavily on the exact pocket you choose.'} ${
		muni && slugKey !== slugify(muni) ? `It sits within ${escapeHtmlAttr(muni)}.` : ''
	} ${proximityNamed.length ? `Use real drive times as your mental map: ${escapeHtmlAttr(proximityNamed.join(', '))}.` : ''}</p>
<p>${identityLine ? `${escapeHtmlAttr(identityLine)}. ` : ''}This guide focuses on what matters in practice: the micro-areas that actually trade, what holds value, and what to verify before you commit.</p>
${keyFacts ? `<ul>${keyFacts}</ul>` : ''}

<h2>Overview</h2>
<p>Expect meaningful variation from one pocket to the next. ${
		subareas.length
			? `Most shortlists end up comparing a few named pockets (for example ${subareaInline}) because views, noise, walkability, and community standards can change quickly.`
			: 'Two streets can feel like different markets once you factor in privacy, outlook, and day-to-day convenience.'
	}</p>
<p>${topType ? `In the current snapshot sample, ${escapeHtmlAttr(topType)} shows up often in visible listings.` : 'Use the live stock mix as a reality check: it will shape pricing, viewings, and resale demand.'}</p>

<h2>Property market insights</h2>
${hasMarket ? `<p>${escapeHtmlAttr(marketBits.join(' • '))}.</p>` : ''}
${hasMarket ? `<p><a href="${escapeHtmlAttr(portalUrl)}" target="_blank" rel="noopener">View current homes for sale in ${n}</a></p>` : ''}
<p>${typeof medPrice === 'number' ? `In the current ${n} snapshot, the median asking price is ~${fmtEur(medPrice)},` : `In ${n},`} pricing and demand typically move with positioning: walkability, outlook, privacy, parking, and the build/maintenance standard of the community. Prioritise what you can’t change later: exact surroundings, sun orientation, and community governance.</p>

<h2>Transport &amp; connectivity</h2>
<p>Plan around real travel times rather than maps, especially in peak season. Approximate drive times (routing estimates):</p>
<ul>
	${typeof driveBanus === 'number' ? `<li>Puerto Banús — ~${Math.round(driveBanus)} min</li>` : ''}
	${typeof driveMarbella === 'number' ? `<li>Marbella — ~${Math.round(driveMarbella)} min</li>` : ''}
	${typeof driveAirport === 'number' ? `<li>Málaga Airport — ~${Math.round(driveAirport)} min</li>` : ''}
	${hasBeach ? `<li>Nearest beach — ~${Math.round(driveBeach)} min</li>` : ''}
</ul>

<h2>Local tips</h2>
<ul>
	<li>💡 Visit twice (midweek and weekend) and compare noise and parking on the <em>exact</em> streets you’d consider in ${n}.</li>
	<li>💡 ${isCityLike ? 'Walk the area at different times of day and note noise, sunlight, and parking/permit realities.' : 'Test the routes you’ll actually drive weekly, not the ones you hope to drive.'}</li>
	<li>💡 ${
		isLuxuryLike
			? 'On premium estates, verify community rules, access/security protocols, and ongoing fee/maintenance expectations early.'
			: subareas.length
				? `If you’re choosing between pockets like ${subareaInline}, prioritise fundamentals (light, outlook, community upkeep) over square metres.`
				: 'Prioritise fundamentals (light, outlook, community upkeep) over square metres.'
	}</li>
</ul>

<h2>Buyers vs renters</h2>
<div class="nbCompareWrap" role="region" aria-label="Buyers vs renters comparison">
<table class="nbCompare">
	<thead>
		<tr>
			<th scope="col">What matters</th>
			<th scope="col">Buyers</th>
			<th scope="col">Renters</th>
		</tr>
	</thead>
	<tbody>
		<tr>
			<th scope="row">Priorities</th>
			<td>${escapeHtmlAttr(buyersPriorities)}</td>
			<td>${escapeHtmlAttr(rentersPriorities)}</td>
		</tr>
		<tr>
			<th scope="row">Deal breakers</th>
			<td>Unclear rules, weak community upkeep, and issues that don’t show in photos</td>
			<td>Unexpected noise/parking, poor winter comfort, and daily friction in your routine</td>
		</tr>
		<tr>
			<th scope="row">Best strategy</th>
			<td>Choose fundamentals that stay in demand and verify community health</td>
			<td>Choose the street and test your routine before you commit</td>
