			const raw = String(kind || '').toLowerCase();
			const k = raw === 'consejo' ? 'tip' : raw === 'advertencia' ? 'warning' : raw === 'nota' ? 'note' : raw;
			const hasClass = /\bclass\s*=/.test(String(attrs || ''));
			const nextAttrs = hasClass
				? String(attrs).replace(/\bclass\s*=\s*(['"])([\s\S]*?)\1/i, (_m: string, q: string, v: string) => {
						const next = v.includes(k) ? v : `${v} ${k}`.trim();
						return ` class=${q}${next}${q}`;
					})
