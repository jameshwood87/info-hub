const stripTagsSimple = (html: string) => String(html || '').replace(/<[^>]+>/g, ' ');
const isEmptyish = (html: string | null | undefined) => {
	const raw = String(html || '')
		.replace(/<script\b[\s\S]*?<\/script>/gi, ' ')
		.replace(/<style\b[\s\S]*?<\/style>/gi, ' ');
	const text = stripTagsSimple(raw).replace(/\s+/g, ' ').trim();
	return !text || text.length < 80 || /Detailed documentation for\b/i.test(text) || /\bcoming soon\b/i.test(text);
};

const renderableText = (html: string | null | undefined) => {
	let out = String(html || '');
	out = out
		.replace(/<script\b[\s\S]*?<\/script>/gi, ' ')
		.replace(/<style\b[\s\S]*?<\/style>/gi, ' ')
		.replace(/<(meta|link)\b[^>]*>/gi, ' ')
		.replace(/<(header|nav|footer|aside)\b[\s\S]*?<\/\1>/gi, ' ')
		.replace(/<form\b[\s\S]*?<\/form>/gi, ' ')
		.replace(
			/<div\b[^>]*class=["'][^"']*(sidebar|comments-area|comment|comments|wp-block-comments|(?<!elementor-)widget)[^"']*["'][\s\S]*?<\/div>/gi,
			' ',
		);
	return stripTagsSimple(out).replace(/\s+/g, ' ').trim();
};

const hasRenderableBody = (html: string | null | undefined) => {
	const text = renderableText(html);
	return Boolean(text && text.length >= 80 && !/Detailed documentation for\b/i.test(text) && !/\bcoming soon\b/i.test(text));
};

const looksLikeEnglish = (p: { title?: string | null; description?: string | null; body?: string | null } | null) => {
	if (!p) return false;
	const bodyText = stripTagsSimple(p.body || '').slice(0, 4000).toLowerCase();
	const words = bodyText.split(/[^a-záéíóúüñ]+/i).filter(Boolean);
	if (words.length < 20) return false;

	const enStops = [
		'the',
		'and',
		'you',
		'your',
		'to',
		'of',
		'in',
		'for',
		'with',
		'this',
		'that',
		'how',
		'can',
		'will',
		'no',
		'need',
		'account',
		'download',
		'app',
		'simply',
	];
	const esStops = [
		'el',
		'la',
		'los',
		'las',
		'y',
		'de',
		'del',
		'en',
		'para',
		'con',
		'esta',
		'este',
		'como',
		'puede',
		'puedes',
		'su',
		'tu',
		'descargar',
		'aplicacion',
	];

	let en = 0;
	let es = 0;
	for (const w of words) {
		if (enStops.includes(w)) en++;
		if (esStops.includes(w)) es++;
	}

	const hasSpanishDiacriticsInBody = /[áéíóúüñ]/i.test(bodyText);
	return en >= Math.max(8, es * 2 + 2) && !hasSpanishDiacriticsInBody;
};

