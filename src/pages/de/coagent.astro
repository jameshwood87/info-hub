---
import Layout from '../../layouts/Layout.astro';
import CoagentPhone from '../../components/CoagentPhone.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
import { COAGENT_NUMBER, coagentWaLink, CRM_STAFF_URL } from '../../data/coagent';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/de/coagent/`;
const title = 'PropertyList CoAgent - Ihr CRM auf WhatsApp | PropertyList';
const description =
	'CoAgent ist Ihr CRM auf WhatsApp: eine Sprachnachricht nach der Besichtigung, und die Aktualisierung liegt zur Freigabe bereit. Ihre Stimme wird nie gespeichert, nichts ohne Ihr YES.';

const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'de');
const plAgencies = statPlus(__ps.agencies, 'de');
const plListings = statPlus(__ps.listings, 'de');

const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=de';
const WA = coagentWaLink();
// A reminder for 9am Madrid time (07:00 UTC) on launch day, until the number exists.
const CAL = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent('PropertyList CoAgent anschreiben')}&dates=20260915T070000Z/20260915T071500Z&details=${encodeURIComponent('Die Nummer von CoAgent steht ab 9 Uhr auf https://info.propertylist.es/de/coagent/. Bevor Sie schreiben, seien Sie registriert und mit Ihrer WhatsApp-Nummer bei Ihrem Benutzer hinterlegt. Die ersten 10 Agenten bekommen einen Monat gratis.')}`;

// Everything CoAgent does today, as the question an agent would actually send.
// Tap a question to see what comes back. Answers are the verified descriptions.
const moments = [
	{
		label: 'Im Auto',
		asks: [
			{ q: 'Wo ist meine nächste Besichtigung?', a: 'Ihr Terminkalender, zuerst mit der Adresse und der Telefonnummer des Kunden, weil Sie es im Auto lesen.' },
			{ q: 'Was habe ich morgen?', a: 'Der ganze Tag, der Reihe nach, mit der Immobilie und wen Sie treffen.' },
			{ q: 'Wie ist die Nummer von Marta Ruiz?', a: 'Zuerst ihr Telefon und ihre E-Mail, damit Ihr Daumen schon auf dem Anruf-Button liegt.' },
			{ q: 'Bringen Sie mich auf den neuesten Stand zu den Bergs', a: 'Wo sie gerade stehen, was sie suchen und was zuletzt passiert ist, bevor Sie anrufen.' },
		],
	},
	{
		label: 'Mit einem Kunden neben Ihnen',
		asks: [
			{ q: 'Was haben wir in Marbella, drei Schlafzimmer, bis zwei Millionen?', a: 'Fünf Inserate aus dem gemeinsamen MLS mit Preisen und Links. Kein Kunde nötig, das funktioniert also auch, wenn jemand neben Ihnen sitzt.' },
			{ q: 'Erzählen Sie mir von PL22234', a: 'Preis, Schlafzimmer, Größe, Lage und der Link zu diesem einen Inserat, ob es Ihres ist oder das einer anderen Agentur.' },
			{ q: 'Welches ist das beste Angebot, PL5001, PL5002 oder PL5003?', a: 'CoAgent vergleicht sie mit ähnlichen Immobilien, die in der Nähe zum Verkauf stehen, mit dem Preis pro Quadratmeter, damit Sie einem Kunden sagen können, welches günstig ist und welches zu teuer. Fragen Sie direkt nach einer Suche, und CoAgent vergleicht diese Ergebnisse.' },
			{ photo: true, q: 'Ein Foto eines abgenutzten Zimmers: „renovieren“', a: 'Mitten in der Besichtigung schicken Sie die Küche, wie sie ist, und bekommen sie eine Minute später renoviert zurück, um Ihrem Käufer zu zeigen, was daraus werden könnte. Es kostet die gleichen Credits wie im CRM, und berechnet wird nur ein Render, der gut gelingt.' },
			{ q: 'Wie viele Wohnungen stehen in San Pedro zum Verkauf?', a: 'Die reale Zahl am Markt dort, die besten Treffer und ein Link zur vollständigen Liste in Ihrem CRM.' },
			{ q: 'Ist PL22234 noch verfügbar?', a: 'Gehört das Inserat einer anderen Agentur, bietet CoAgent an, dort für Sie nachzufragen. Antworten Sie mit YES, und die Anfrage geht über das MLS an sie, und ihre Antwort kommt zu Ihnen zurück.' },
		],
	},
	{
		label: 'Nach der Besichtigung',
		asks: [
			{ q: 'Fügen Sie eine Notiz zu Marta hinzu: Sie möchte es am Samstag noch einmal sehen', a: 'CoAgent liest Ihnen die Notiz in Ihren eigenen Worten vor und speichert sie in ihrer Akte, wenn Sie mit YES antworten.' },
			{ q: 'Marta hat ein Angebot gemacht', a: 'CoAgent verschiebt ihre Karte auf die richtige Stufe Ihrer Pipeline, wenn Sie mit YES antworten, genau wie beim Ziehen im CRM. Einen Kunden als gewonnen oder verloren zu markieren bleibt dem CRM vorbehalten, wo nach den Details gefragt wird.' },
			{ q: 'Fügen Sie Maria Lopez hinzu: 6XX XXX XXX, maria@example.com', a: 'Oder teilen Sie ihre Kontaktkarte direkt von Ihrem Handy. CoAgent liest Ihnen Name, Nummer und E-Mail vor und fügt sie zu Ihrem CRM hinzu, wenn Sie mit YES antworten. Ist sie schon vorhanden, verknüpft CoAgent ihre Akte, statt ein Duplikat anzulegen.' },
			{ photo: true, q: 'Ein Foto vom Ausweis eines Kunden', a: 'Nur Vorname, Nachname und Geburtsdatum werden gelesen und als neuer Kontakt hinzugefügt, wenn Sie mit YES antworten. Die Ausweisnummer wird nie gespeichert, und das Foto auch nicht.' },
		],
	},
	{
		label: 'Das Inserat gewinnen',
		asks: [
			{ q: 'Lassen Sie uns eine Immobilie inserieren', a: 'CoAgent sagt Ihnen, was Sie schicken sollen: zuerst die Fotos, dann den Preis, wo sie liegt und die Schlafzimmer, in Ihren eigenen Worten. Keine Befehle, die Sie lernen müssen.' },
			{ photo: true, q: 'Fotos eines neuen Inserats', a: 'Schicken Sie sie direkt aus Ihrer Kamerarolle und erzählen Sie CoAgent dann von der Immobilie, getippt oder als Sprachnachricht. CoAgent fragt nach allem, was fehlt, etwa dem Preis, liest Ihnen das Inserat vor und schreibt bei YES den Titel, die Beschreibung und die Ausstattung. Antworten Sie mit PUBLISH, und es geht zur Prüfung, genau wie aus dem CRM. Ohne das geht nichts online.' },
			{ photo: true, q: 'Ein Foto eines Schilds mit „Se Vende“', a: 'CoAgent liest die Telefonnummer vom Schild ab, dazu Name oder Preis, falls vorhanden. Antworten Sie mit YES, und der Eigentümer wird als Kontakt in Ihrem CRM gespeichert, mit einer Notiz zum Schild und einer Wiedervorlage, ihn anzurufen.' },
			{ q: 'Was ist Nueva Andalucía wert?', a: 'Der mittlere Angebotspreis und die Spanne dessen, was dort tatsächlich am Markt ist. Haben wir in einer Gegend nicht genug Bestand, sagt CoAgent das, statt zu raten.' },
			{ q: 'Was ist PL22234 wert?', a: 'Ein Wert aus notariell beurkundeten Verkäufen in diesem Ort, mit einer Spanne und einem Link zum öffentlichen Nachweis. Oder beschreiben Sie die Immobilie stattdessen: „eine 120 m² große Wohnung in Estepona“. CoAgent sagt Ihnen immer, worauf die Zahl beruht.' },
			{ q: 'REPORT', a: 'Antworten Sie nach einer Bewertung mit REPORT für den vollständigen Property Intelligence Report, als Link, den Sie dem Verkäufer schicken können. Ihr erster ist gratis. Danach kostet es Credits, und CoAgent sagt Ihnen wie viele und fragt, bevor etwas ausgegeben wird.' },
			{ q: 'BROCHURE PL22234', a: 'Eine Broschüre des Inserats mit Ihrem eigenen Branding: eine Seite, die Ihr Kunde öffnen kann, mit dem heutigen Preis und einer Möglichkeit anzufragen, plus das PDF. CoAgent sagt Ihnen zuerst den Preis in Credits, und eine Broschüre, die Sie schon erstellt haben, wird kostenlos erneut geschickt.' },
		],
	},
	{
		label: 'Neue Leads',
		asks: [
			{ q: 'Was sind meine neuesten Leads?', a: 'Ihre fünf neuesten Leads, mit Angaben dazu, wer angefragt hat, zu welchem Inserat und wann: Ihre eigenen, oder die der ganzen Agentur, wenn Sie Administrator sind, wie im CRM. Antworten Sie mit REPLY, um den neuesten per E-Mail zu beantworten.' },
			{ q: 'REPLY', a: 'CoAgent schreibt eine E-Mail an Ihren neuesten Lead in dessen eigener Sprache, ausgehend von dem, was er gefragt hat. Antworten Sie mit YES, und sie geht von Ihnen aus über das CRM raus, und die Antwort kommt in Ihr E-Mail-Postfach zurück. Oder antworten Sie einfach auf die Benachrichtigung zum neuen Lead.' },
		],
	},
];

const faqs = [
	{ q: 'Was muss ich installieren?', a: 'Nichts. CoAgent funktioniert in WhatsApp, das Sie ohnehin den ganzen Tag nutzen. Speichern Sie die Nummer von PropertyList, stellen Sie sicher, dass Ihre Handynummer in Ihrem CRM-Profil hinterlegt ist, damit CoAgent weiß, dass Sie Agent sind und kein Kunde, und schicken Sie eine Sprachnachricht.' },
	{ q: 'Ändert CoAgent mein CRM automatisch?', a: 'Nein. CoAgent schlägt vor und wartet. Es zeigt Ihnen den Kunden, den es zugeordnet hat, und die Änderungen, die vorgenommen werden sollen, Feld für Feld, und nichts wird geschrieben, bevor Sie mit YES antworten. Verhört sich CoAgent, kostet es Sie ein Wort, nicht ein falsches Budget, das still in einer gemeinsamen Akte steht.' },
	{ q: 'Werden meine Sprachnachrichten aufgezeichnet?', a: 'Nein. Das Audio wird transkribiert und dann verworfen. Das Transkript bleibt in der Kundenakte, wo Sie genau nachlesen können, was dem CRM mitgeteilt wurde.' },
	{ q: 'Funktioniert es auf Spanisch?', a: 'Ja, und auf Deutsch, Französisch, Portugiesisch, Bulgarisch und Griechisch. CoAgent antwortet in Ihrer eigenen Sprache und kommt auch mit einer Nachricht zurecht, die mittendrin die Sprache wechselt, was an dieser Küste auf die meisten zutrifft.' },
	{ q: 'Muss ich jedes Mal einen Kunden nennen?', a: 'Nein. Einen Kunden zu nennen macht aus einer Sprachnachricht CRM-Aktualisierungen. Ohne Namen können Sie trotzdem nach Immobilien, Ihrem Terminkalender, einem Inserat per Referenz oder dem Wert einer Gegend fragen, genau das, was Sie brauchen, wenn ein Laufkunde neben Ihnen steht.' },
	{ q: 'Kann CoAgent für mich mit anderen Agenturen sprechen?', a: 'Ja. Fragen Sie, ob ein Inserat einer anderen Agentur noch verfügbar ist, und CoAgent bietet an, die Anfrage zu schicken. Antworten Sie mit YES, und sie geht über das MLS genauso raus wie eine, die vom CRM-Bildschirm aus geschickt wird, sodass sie in deren normalem Arbeitsablauf landet.' },
	{ q: 'Was, wenn CoAgent meine Nummer nicht kennt?', a: 'CoAgent antwortet auf Spanisch und Englisch, mit einem Link, um Ihr kostenloses Konto zu erstellen, und einem Link zur Staff-Seite Ihres CRM, wo Sie Ihre Handynummer zu Ihrem Profil hinzufügen. Ist Ihre Nummer nicht spanisch, stellen Sie die Landesvorwahl voran und schreiben Sie noch einmal.' },
	{ q: 'Was kostet Credits?', a: 'Nachrichten sind in Ihrem Plan enthalten. Eine Broschüre, der Marktbericht nach dem ersten gratis und ein renoviertes Zimmer werden in PropertyList Credits bezahlt, zum gleichen Preis wie im CRM. CoAgent sagt Ihnen immer den Preis und wartet auf Ihr YES, bevor etwas ausgegeben wird, und eine Broschüre oder ein Render, das fehlschlägt, wird nie berechnet.' },
	{ q: 'Was kostet es?', a: 'Die ersten 10 Agenten, die CoAgent anschreiben, bekommen einen Monat gratis und unbegrenzt, gezählt ab ihrer ersten Nachricht. Jeder Agent hat 5 gratis Nachrichten am Tag, und mit YES zu antworten zählt nie dazu. Unbegrenzt kostet 50 Credits im Monat pro Agent, bezahlt aus Ihren PropertyList Credits, und Sie können die Verlängerung jederzeit stoppen. Haben Sie mehr als 3 Agenten hinzuzufügen, sprechen Sie mit uns über ein Paket. Das MLS und der Kern des CRM bleiben gratis, und ein Konto zu erstellen kostet nichts.' },
	{ q: 'Was ist noch nicht verfügbar?', a: 'Die eigene WhatsApp-Nummer anzubinden, damit sich Kundenchats von selbst einordnen, eine eigene Arbeitsleitung in der PropertyList App und dass der Kundensteckbrief von selbst auf Ihrem Anrufbildschirm erscheint. Alles andere auf dieser Seite funktioniert schon heute.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Startseite', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Funktionen', item: `${origin}/features/` },
		{ '@type': 'ListItem', position: 3, name: 'CoAgent', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList CoAgent',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android', url: canonical,
	description: 'Ein Assistent für Immobilienmakler, der über WhatsApp funktioniert: Sprachnachrichten werden zu CRM-Aktualisierungen, die der Makler freigibt, und Fragen zu Kunden, Inseraten, dem Terminkalender und Gebietspreisen werden aus dem Agentur-CRM und dem gemeinsamen MLS beantwortet. Das Audio wird nie gespeichert.',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};
---

<Layout
	lang="de"
	title={title}
	description={description}
	canonical={canonical}
	ogImage="https://info.propertylist.es/og/og-coagent-de.jpg"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/coagent/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/coagent/' },
		{ hreflang: 'de', href: 'https://info.propertylist.es/de/coagent/' },
		{ hreflang: 'fr', href: 'https://info.propertylist.es/fr/coagent/' },
		{ hreflang: 'sv', href: 'https://info.propertylist.es/sv/coagent/' },
		{ hreflang: 'ru', href: 'https://info.propertylist.es/ru/coagent/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/coagent/' },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="cx heroGrid">
			<div>
				<div class="eyebrow"><span class="dot"></span> CoAgent &middot; Ihr CRM auf WhatsApp</div>
				<h1>Hören Sie auf, Ihr CRM abzutippen.<br /><span>Sprechen Sie einfach mit ihm.</span></h1>
				<p class="heroLead">
					Schicken Sie nach der Besichtigung eine Sprachnachricht. Antworten Sie mit YES. <strong>Der Papierkram ist erledigt, und der Abend gehört Ihnen.</strong>
				</p>
				<div class="ctaRow">
					{WA ? (
						<a class="btnPrimary" href={WA} target="_blank" rel="noopener">CoAgent auf WhatsApp anschreiben</a>
					) : (
						<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Kostenloses Konto erstellen</a>
					)}
					<a class="btnGhost" href="#how">So funktioniert es</a>
				</div>
				<p class="micro">5 gratis Nachrichten am Tag &middot; Nichts zu installieren &middot; Ihre Stimme wird nie gespeichert</p>
				{WA ? (
					<p class="member">Schon bei PropertyList? <a href={CRM_STAFF_URL} target="_blank" rel="noopener">Fügen Sie Ihre WhatsApp-Nummer zu Ihrem Benutzer hinzu</a>, damit CoAgent weiß, dass Sie es sind.</p>
				) : (
					<p class="member">
						<b>Die Nummer ist Dienstag, 15. September, ab 9 Uhr verfügbar.</b> Bevor Sie schreiben, stellen Sie sicher, dass Sie
						<a href={SIGNUP} target="_blank" rel="noopener">registriert</a> sind und Ihre
						<a href={CRM_STAFF_URL} target="_blank" rel="noopener">WhatsApp-Nummer bei Ihrem Benutzer hinterlegt ist</a>.
						<a class="calBtn" href={CAL} target="_blank" rel="noopener" style="display:table;margin-top:10px;padding:8px 14px;border-radius:10px;background:#0b1220;color:#fff;text-decoration:none;font-weight:800">Erinnern Sie mich am Dienstag um 9 Uhr</a>
					</p>
				)}
			</div>
			<CoagentPhone lang="de" />
		</div>
	</section>

	<div class="strip">
		<div class="cx stripInner">
			<span>Dahinter: <b>{plAgencies}</b> Agenturen</span>
			<span><b>{plAgents}</b> Agenten</span>
			<span><b>{plListings}</b> aktive Inserate</span>
			<span>Antwortet in <b>7</b> Sprachen</span>
		</div>
	</div>

	<section class="band dark">
		<div class="cx">
			<div class="head center">
				<h2>Zwei Arten, wie der Abend laufen kann.</h2>
				<p>Niemand vergisst mit Absicht. Der Tag ist einfach schneller als der Papierkram.</p>
			</div>
			<div class="versus">
				<div class="vCol without">
					<div class="vHead">Ohne CoAgent</div>
					<ol>
						<li><b>18:40</b><span>Letzte Besichtigung. Drei Versprechen, alle nur im Kopf.</span></li>
						<li><b>21:30</b><span>Laptop auf, den Tag aus dem Gedächtnis abtippen.</span></li>
						<li><b>Donnerstag</b><span>„Haben Sie mir das Inserat eigentlich noch geschickt?“</span></li>
					</ol>
				</div>
				<div class="vCol with">
					<div class="vHead">Mit CoAgent</div>
					<ol>
						<li><b>18:41</b><span>Eine Sprachnachricht vom Parkplatz.</span></li>
						<li><b>18:42</b><span>Sie antworten mit YES. Notiz, Anforderung und Erinnerung gespeichert.</span></li>
						<li><b>21:30</b><span>Sie sitzen nicht am Laptop.</span></li>
					</ol>
				</div>
			</div>
			<p class="punch">Ihr Gedächtnis ist ausgezeichnet. <span>Bis Donnerstag.</span></p>
		</div>
	</section>

	<section class="band soft" id="how">
		<div class="cx">
			<div class="head center">
				<div class="label">So funktioniert es</div>
				<h2>Sprechen. Prüfen. YES sagen.</h2>
			</div>
			<div class="grid3">
				<div class="demo">
					<span class="num">1</span>
					<h3>Sprechen</h3>
					<p>Wie zu einem Kollegen.</p>
					<div class="mini">
						<div class="mb me">„Marta hat es gefallen. Akzeptiert jetzt drei Schlafzimmer, bis achthundertfünfzig. Ich habe gesagt, ich schicke ihr die Immobilie in Cerquilla am Samstag.“</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">2</span>
					<h3>Prüfen</h3>
					<p>Sehen Sie genau, was es gehört hat.</p>
					<div class="mini">
						<div class="mb">
							<b>Marta Ruiz · Käuferin</b>
							<span class="kv"><i>Budget</i><em>800.000 € bis 850.000 €</em></span>
							<span class="kv"><i>Schlafzimmer</i><em>3</em></span>
							<span class="kv"><i>Erinnerung</i><em>Cerquilla, Samstag</em></span>
						</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">3</span>
					<h3>YES sagen</h3>
					<p>Erst dann ändert sich etwas.</p>
					<div class="mini">
						<div class="mb">Antworten Sie mit <b>YES</b>, um es zu speichern.</div>
						<div class="mb me short">YES</div>
						<div class="mb done">Gespeichert. Samstag steht in Ihrem Kalender.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band" id="ask">
		<div class="cx">
			<div class="head center">
				<div class="label">Was Sie fragen können</div>
				<h2>Fragen Sie wie einen Kollegen.</h2>
				<p>Tippen Sie auf eine Nachricht, um zu sehen, was zurückkommt.</p>
			</div>
			<div class="moments">
				{moments.map((m) => (
					<div class="moment">
						<div class="momentLabel">{m.label}</div>
						<div class="chips">
							{m.asks.map((item) => (
								<details class="chip">
									<summary>
										{item.photo && <span class="tag">Foto</span>}
										{item.photo ? item.q : `„${item.q}“`}
									</summary>
									<p>{item.a}</p>
								</details>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="band soft" id="matching">
		<div class="cx">
			<div class="matchBox">
				<div class="matchCopy">
					<div class="label">Aufgebaut auf dem gemeinsamen MLS</div>
					<h2>Nicht nur an den Kunden erinnern. <span>Seine nächste Immobilie finden.</span></h2>
					<p>CoAgent durchsucht den Bestand von {plAgencies} Agenturen, nicht nur Ihren eigenen. Ist die richtige Immobilie die einer anderen Agentur, fragt CoAgent dort für Sie nach.</p>
					<ul class="checks">
						<li>Das gesamte gemeinsame MLS, nicht nur Ihre Inserate</li>
						<li>Bestes Angebot nach Preis pro m² sortiert</li>
						<li>Werte aus notariell beurkundeten Verkäufen, mit Nachweis</li>
					</ul>
				</div>
				<div class="matchVisual" aria-hidden="true">
					<div class="resCard">
						<div class="resHead">
							<span>Aus dem gemeinsamen MLS</span>
							<em>3 Schlafzimmer &middot; Nueva Andalucía &middot; bis 850.000 €</em>
						</div>
						<div class="res">
							<span class="resPh a"></span>
							<span class="resTxt"><b>PL5001 &middot; Wohnung</b><i>3 SZ &middot; Nueva Andalucía</i></span>
							<span class="resP">845.000 €<small class="own">Ihr Inserat</small></span>
						</div>
						<div class="res">
							<span class="resPh b"></span>
							<span class="resTxt"><b>PL5002 &middot; Penthouse</b><i>3 SZ &middot; Nueva Andalucía</i></span>
							<span class="resP">830.000 €<small>Andere Agentur</small></span>
						</div>
						<div class="res">
							<span class="resPh c"></span>
							<span class="resTxt"><b>PL5003 &middot; Reihenhaus</b><i>3 SZ &middot; Aloha</i></span>
							<span class="resP">799.000 €<small>Andere Agentur</small></span>
						</div>
						<div class="resAsk">PL5002 gehört einer anderen Agentur. Antworten Sie mit <b>YES</b>, und ich frage nach, ob es noch verfügbar ist.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="cx">
			<div class="head center">
				<div class="label">Drei Versprechen</div>
				<h2>Arbeiten Sie nicht für Ihr CRM. <span>Lassen Sie das CRM für Sie arbeiten.</span></h2>
			</div>
			<div class="grid3">
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
