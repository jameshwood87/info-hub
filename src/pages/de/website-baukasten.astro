.wb-hero-eyebrow img{width:18px;height:18px}
.wb-hero-h1{font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:clamp(40px,5.4vw,62px);line-height:1.05;letter-spacing:-.02em;color:#fff}
.wb-hero-h1 em{color:#00ae9a;font-style:italic;white-space:nowrap}
.wb-hero-sub{font-size:19px;line-height:1.55;color:#b8c9cb;margin:24px 0 32px;max-width:520px}
