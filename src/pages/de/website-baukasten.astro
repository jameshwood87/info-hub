.wb-trust-line{text-align:center;max-width:720px;margin:40px auto 0;font-size:17px;line-height:1.6;color:#cfdedf}

/* the fifteen */
.wb-fifteen{background:#faf6ee;padding-bottom:70px}
.wb-chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:-24px 0 34px}
