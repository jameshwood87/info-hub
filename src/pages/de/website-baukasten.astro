---
/* GENERATED FILE - do not edit by hand.
   Source: src/pages/website-builder.astro (English).
   Rebuild: node scripts/gen-wb-langs.mjs --only=de
   Hand edits are lost on the next run; change the English page instead. */
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'de');
const plAgencies = statPlus(__ps.agencies, 'de');
const plListings = statPlus(__ps.listings, 'de');

const title = 'Website Builder für Immobilienmakler | PropertyList.es';
const description =
	'Fünfzehn fertige Website-Designs für Agenturen, die das gesamte PropertyList-Netzwerk zeigen und nach Ihren Vorgaben gefiltert werden. Anfragen landen in Ihrem CRM. Kostenlos zu erstellen, ab 50 Credits im Monat, sobald Sie veröffentlichen.';
const BUILD = 'https://agents.propertylist.es/website-builder';
const DOCS = 'https://info.propertylist.es/docs/propertylist-mls-user-manual/website-builder/';
const REFERRALS = 'https://agents.propertylist.es/referrals';
const DASHBOARD = 'https://agents.propertylist.es';

// The fifteen templates, as captured from the real files (public/wb). Order is
// the order shown; the style filter hides the rest.
const templates = [
	{ id: '14-solaz', name: 'Solaz', style: 'Präsentation', line: 'Beginnt mit einem Film. Zypressen und Küste in der Dämmerung, die Überschrift liegt tief über dem Bild.' },
	{ id: '01-marina', name: 'Marina', style: 'Modern', line: 'Eine türkis-weiße Kopfzeile, eine Live-Suchleiste oben und Ihre neuesten Inserate in einem Raster darunter.' },
	{ id: '03-onyx', name: 'Onyx', style: 'Luxus', line: 'Eine Nachtaufnahme einer beleuchteten Villa, eine Überschrift in Serifenschrift in Weiß, eine Schaltfläche.' },
	{ id: '13-horizon', name: 'Horizon', style: 'Präsentation', line: 'Geteilte Ansicht: auf der einen Seite eine fette Überschrift, auf der anderen ein Innenfoto in voller Höhe.' },
	{ id: '02-blanca', name: 'Blanca', style: 'Minimalistisch', line: 'Ein Foto in voller Breite einer Villa mit Pool, eine kleine Navigationsleiste, keine Überschrift über dem Bild.' },
	{ id: '05-puerto', name: 'Puerto', style: 'Modern', line: 'Ein Dämmerungsfoto in voller Breite mit einer darüber schwebenden Karte, die Preis und Details zeigt.' },
	{ id: '07-noir', name: 'Noir', style: 'Luxus', line: 'Beginnt mit einem Film. Eine filmische dunkle Landschaft mit einer großen, fetten Überschrift darüber, minimale Navigation.' },
	{ id: '04-sierra', name: 'Sierra', style: 'Klassisch', line: 'Ein cremefarbener Hintergrund, Platz für Ihr Foto neben Ihrem Namen und ein redaktioneller Absatz.' },
	{ id: '09-continental', name: 'Continental', style: 'Modern', line: 'Ein Foto in marineblauem Dämmerungslicht, eine fette weiße Überschrift und eine Preiskarte über dem Bild.' },
	{ id: '06-atrium', name: 'Atrium', style: 'Minimalistisch', line: 'Hellgrau und Weiß, eine Akzentfarbe in der Überschrift, eine Suchleiste und ein Streifen mit den neuesten Immobilien.' },
	{ id: '11-imperial', name: 'Imperial', style: 'Luxus', line: 'Ein cremefarbener Hintergrund, eine fette Überschrift in Serifenschrift, zwei Fotos darunter in einer einfachen Galerie.' },
	{ id: '08-cortijo', name: 'Cortijo', style: 'Klassisch', line: 'Ein warmer Pergamenthintergrund, ein bogenförmiger Bilderrahmen neben Ihrem Namen und eine Einleitung.' },
	{ id: '10-meridian', name: 'Meridian', style: 'Minimalistisch', line: 'Ein heller Hintergrund, eine kursive Überschrift in Serifenschrift, eine schlichte Suchleiste, nichts, das um Aufmerksamkeit konkurriert.' },
	{ id: '12-heritage', name: 'Heritage', style: 'Klassisch', line: 'Ein weißer Hintergrund, Ihr Name und ein einleitender Absatz, grüne Aktions-Buttons.' },
	{ id: '15-faro', name: 'Faro', style: 'Präsentation', line: 'Beginnt mit einem Film. Eine dunkle Silhouette von Berg und Meer, eine große Überschrift in Serifenschrift, minimale Navigation.' },
];
const styles = ['Modern', 'Minimalistisch', 'Luxus', 'Klassisch', 'Präsentation'];

const addons = [
	{ name: 'Zusätzliche Seite', what: 'Eine weitere Seite zusätzlich zum enthaltenen Set', price: '10 Credits pro Monat' },
	{ name: 'Instant Content', what: 'Regionale Leitfäden und ein Blog, für Sie geschrieben, unbegrenzt', price: '30 Credits pro Monat' },
	{ name: 'Ihre eigene Domain', what: 'Ihre Domain statt your-agency.estate-agency.co', price: '20 Credits pro Monat' },
	{ name: 'PropertyList-Branding entfernen', what: 'Entfernt das PropertyList-Zeichen von Ihrer Website', price: '50 Credits pro Monat' },
	{ name: 'Pop-up zur Lead-Erfassung', what: 'Ein Pop-up, das Leads auf Ihrer Website erfasst', price: '8 Credits pro Monat' },
	{ name: 'KI-Antworten bei Exposés', what: 'Erstellt ein FAQ aus den Fragen, die Käufer tatsächlich stellen.', price: '8 Credits pro Monat' },
	{ name: 'Automatisches SEO und GEO', what: 'Prüft Ihre Website wöchentlich und behebt, was möglich ist.', price: '5 Credits pro Monat' },
	{ name: 'Monatlicher E-Mail-Bericht', what: 'Eine Leistungszusammenfassung, die am 1. jedes Monats per E-Mail gesendet wird.', price: '5 Credits pro Monat' },
];

const faqs = [
	{ q: 'Ist das Erstellen wirklich kostenlos?', a: 'Ja. Das Erstellen und die Vorschau kosten nichts. Sie werden erst beim Veröffentlichen belastet: 50 Credits pro Monat, zuzüglich etwaiger Zusatzfunktionen, die Sie aktivieren.' },
	{ q: 'Was passiert, wenn ich veröffentliche?', a: 'Ihre Website geht mit Ihren Exposés und dem Netzwerkbestand, den Sie zur Anzeige ausgewählt haben, online. Ab dann zahlen Sie 50 Credits pro Monat, zuzüglich etwaiger Zusatzfunktionen, die Sie aktiviert haben.' },
	{ q: 'Kann ich das Template später ändern?', a: 'Ja. Wechseln Sie jederzeit zu einer der fünfzehn und behalten Sie Ihre Texte, Seiten und Einstellungen.' },
	{ q: 'Muss ich meine Inserate hochladen?', a: 'Nein. Ihre Inserate und der Netzwerkbestand sind bereits vorhanden und werden aktualisiert, wenn sich ein Inserat im CRM ändert. Nichts wird zweimal eingetippt.' },
	{ q: 'Wohin gehen Anfragen?', a: 'In Ihrem PropertyList CRM, mit einer E-Mail für jede Anfrage. Lead-, Seller- und Property-Pipelines sind kostenlos und unbegrenzt; das Verschieben eines Kontakts in Buyer kostet 1 Credit.' },
	{ q: 'Kann ich meine eigene Domain verwenden?', a: 'Ja, für 20 Credits pro Monat. Bis dahin läuft Ihre Seite unter your-agency-name.estate-agency.co, sodass Ihr Name in der Adresse steht, nicht unserer.' },
	{ q: 'Was passiert, wenn ich kündige?', a: 'Ihre Website wird am Ende des Abrechnungszeitraums auf die kostenlose Agentur-Microsite zurückgesetzt. Sie behalten Ihre Domain.' },
	{ q: 'Ist die SEO gut?', a: 'Saubere Struktur, Titel und Beschreibungen auf jeder Seite von Anfang an. Auto SEO und GEO (5 Credits pro Monat) prüfen Ihre Seite wöchentlich und aktualisieren die Keywords entsprechend dem, wonach Käufer jetzt suchen. Keine Plattform kann ernsthaft Platzierungen versprechen.' },
	{ q: 'Müssen Sie technisch versiert sein?', a: 'Nein. Wählen Sie eine Vorlage, bearbeiten Sie sie in einem Editor, der die echte Seite zeigt, und veröffentlichen Sie, wenn Sie bereit sind. Oder beschreiben Sie die Änderung in einfachem Englisch und lassen Sie die KI das erledigen.' },
	{ q: 'Wer übernimmt das Hosting, und ist es sicher?', a: 'Wir übernehmen das. Hosting und Cloudflare-Schutz sind enthalten: schnell, vor Angriffen geschützt, nichts, das Sie verwalten oder erneuern müssen.' },
	{ q: 'Sind die rechtlichen Seiten enthalten?', a: 'Ja. Aviso legal, Datenschutz- und Cookie-Seiten sowie ein Cookie-Banner sind bei jeder Vorlage enthalten und werden nie separat berechnet.' },
];

const ldWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'PropertyList Website Builder',
	url: 'https://info.propertylist.es/de/website-baukasten/',
	description,
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es', logo: { '@type': 'ImageObject', url: 'https://info.propertylist.es/og/logo-default.png' } },
};
const ldBreadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://info.propertylist.es/' },
		{ '@type': 'ListItem', position: 2, name: 'Website Builder' },
	],
};
const ldVideo = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: 'PropertyList Website Builder: pick a design, edit it, publish',
	description: 'A 33 second recording of the PropertyList Website Builder with a sample agency: the fifteen designs, one chosen, the headline selected, the hero rearranged, then Review and publish. No sound.',
	thumbnailUrl: ['https://info.propertylist.es/hero/wb-hero-poster.jpg'],
	contentUrl: 'https://info.propertylist.es/hero/wb-hero.mp4',
	uploadDate: '2026-09-05',
	duration: 'PT33S',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es' },
};
const ldFaq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
	lang="de"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/de/website-baukasten/"
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/website-builder/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/constructor-de-webs/' },
		{ hreflang: 'de', href: 'https://info.propertylist.es/de/website-baukasten/' },
		{ hreflang: 'fr', href: 'https://info.propertylist.es/fr/createur-de-site-immobilier/' },
		{ hreflang: 'sv', href: 'https://info.propertylist.es/sv/webbplatsbyggare/' },
		{ hreflang: 'ru', href: 'https://info.propertylist.es/ru/konstruktor-saytov/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/website-builder/' },
	]}
>
	<script type="application/ld+json" set:html={JSON.stringify(ldWebsite)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldVideo)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />

	<!-- HERO -->
	<header class="wb-hero">
		<div class="wrap">
			<div class="wb-hero-grid">
				<div class="wb-hero-text">
					<div class="wb-hero-eyebrow"><img src="https://info.propertylist.es/og/icon-default.png" alt="" width="18" height="18" /><span>Website Builder &middot; alle Inserate des Netzwerks &middot; Leads in Ihr CRM</span></div>
					<h1 class="wb-hero-h1">Wählen Sie ein Design.<br />Ihre Inserate <em>Füllen Sie es aus.</em></h1>
					<p class="wb-hero-sub">Fünfzehn fertige Agenturwebsites, gefüllt mit dem gesamten Netzwerk und gefiltert, wie Sie es wollen. Anfragen landen in Ihrem CRM.</p>
					<div class="wb-hero-ctas">
						<a class="btn btn-primary btn-large" href={BUILD}>Erstellen Sie kostenlos</a>
						<a class="btn btn-secondary on-dark" href="#xml">Ich habe bereits eine Website</a>
					</div>
					<p class="wb-hero-trust">Kostenlos zum Erstellen und zur Vorschau. Ab 50 Credits pro Monat (etwa 50 EUR), sobald Sie veröffentlichen. Kündigen Sie zum Ende eines jeden Monats.</p>
				</div>
				<div class="wb-hero-visual">
					<figure class="film wb-film">
						<div class="wb-frame wb-frame-dark">
							<div class="wb-frame-bar"><span></span><span></span><span></span><i>Website Builder</i></div>
							<video class="filmVid" autoplay muted loop playsinline preload="auto" poster="/hero/wb-hero-poster.jpg" width="1440" height="900" aria-label="The Website Builder: die fünfzehn Designs, Solaz ausgewählt, der Editor mit der ausgewählten Überschrift, das Hero-Element neu angeordnet, dann Überprüfen und Veröffentlichen">
								<source src="/hero/wb-hero.mp4" type="video/mp4" />
							</video>
						</div>
						
					</figure>
				</div>
			</div>
		</div>
	</header>

	<!-- PROOF -->
	<section class="wb-trust">
		<div class="wrap">
			<div class="wb-trust-grid">
				<div><div class="wb-trust-num">{plAgents}</div><div class="wb-trust-label">registrierte Makler auf PropertyList</div></div>
				<div><div class="wb-trust-num">{plAgencies}</div><div class="wb-trust-label">Agenturen, die ihr Geschäft darauf betreiben</div></div>
				<div><div class="wb-trust-num">{plListings}</div><div class="wb-trust-label">Angebote im Netzwerk</div></div>
			</div>
			<p class="wb-trust-line">Ihre Website nutzt dasselbe Netzwerk wie Ihr MLS und CRM. Sie ist am Tag der Veröffentlichung aktuell und aktualisiert sich danach selbst.</p>
		</div>
	</section>

	<!-- THE FIFTEEN -->
	<section class="wb-section wb-fifteen" id="templates">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Die fünfzehn</p>
				<h2 class="wb-section-h2">Fünfzehn Designs, <em>eine Plattform.</em></h2>
				<p class="wb-lead">Jede ist eine komplette Agentur-Website: dieselben Seiten, dieselben Bausteine, anderes Aussehen. Wählen Sie diejenige, die zu Ihrer Arbeitsweise passt.</p>
			</div>
			<div class="wb-chips" role="tablist" aria-label="Vorlagen nach Stil filtern">
				<button class="wb-chip on" type="button" data-style="all" aria-pressed="true">Alle fünfzehn</button>
				{styles.map((s) => <button class="wb-chip" type="button" data-style={s} aria-pressed="false">{s}</button>)}
			</div>
		</div>
		<div class="wb-rail-wrap">
			<button class="wb-rail-btn prev" type="button" aria-label="Vorherige Vorlagen">&lsaquo;</button>
			<div class="wb-rail" id="wbRail">
				{templates.map((t, i) => (
					<article class="wb-tpl" data-style={t.style}>
						<div class="wb-tpl-shots">
							<div class="wb-frame">
								<div class="wb-frame-bar"><span></span><span></span><span></span><i>yourbrand.estate-agency.co</i></div>
								<img src={`/wb/${t.id}-desktop.webp`} width="1440" height="900" alt={`${t.name} template, home page on a desktop screen`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							</div>
							<img class="wb-phone" src={`/wb/${t.id}-phone.webp`} width="390" height="844" alt={`${t.name} template on a phone`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
						</div>
						<div class="wb-tpl-meta">
							<span class="wb-tpl-style">{t.style}</span>
							<h3>{t.name}</h3>
							<p>{t.line}</p>
						</div>
					</article>
				))}
			</div>
			<button class="wb-rail-btn next" type="button" aria-label="Nächste Vorlagen">&rsaquo;</button>
		</div>
		<div class="wrap"><p class="wb-fifteen-note">Wechseln Sie die Vorlage später und behalten Sie Ihre Texte, Seiten und Einstellungen. Solaz, Noir und Faro starten mit einem Film.</p></div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="wb-section wb-steps">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">So funktioniert es</p>
				<h2 class="wb-section-h2">Wählen. Personalisieren Sie es. <em>Veröffentlichen.</em></h2>
			</div>
			<div class="wb-steps-grid">
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Wählen Sie eine Vorlage</i></div><img src="/wb/step-1-pick.webp" width="1440" height="900" alt="Der Vorlagen-Auswahl mit ausgewähltem Solaz und Vorschau daneben" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">1</div>
					<h3>Wählen Sie eine Vorlage</h3>
					<p>Wählen Sie aus fünfzehn fertigen Website-Designs für Agenturen. Alle haben bereits die Seiten, die ein Maklerbüro braucht.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Bearbeiten Sie Ihre Website</i></div><img src="/wb/step-2-edit.webp" width="1440" height="900" alt="Der Editor mit geöffneten Einstellungen des Hero-Blocks, der drei Anordnungen zeigt" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">2</div>
					<h3>Machen Sie sie zu Ihrer eigenen</h3>
					<p>Ihre Markenfarbe, Ihre Texte, Ihre Fotos in einem Editor, der die echte Website zeigt. Jeder Block hat mehrere Anordnungen.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Überprüfen und veröffentlichen</i></div><img src="/wb/step-3-publish.webp" width="1440" height="900" alt="Der Dialog 'Überprüfen und veröffentlichen', der die monatlichen Credits auflistet, bevor die Seite live geht" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">3</div>
					<h3>Veröffentlichen</h3>
					<p>Nichts hochzuladen: Die Inserate sind bereits vorhanden. Anfragen landen in Ihrem CRM.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- BUILT FOR AN AGENCY -->
	<section class="wb-section wb-agency">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Für ein Maklerbüro gebaut, nicht für ein Café</p>
				<h2 class="wb-section-h2">Die Bausteine, die ein Immobilienmakler <em>tatsächlich braucht.</em></h2>
				<p class="wb-lead">Objektraster, hervorgehobene Immobilie, Suche, Bewertungsformular, Bereichsführer, Team, Bewertungen, Zahlen, was der Kauf kostet, Neubauprojekte. Jeder einzelne liest aus Ihrem Account, statt Sie zum Tippen aufzufordern.</p>
			</div>
			<div class="wb-cards">
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9 21v-6h6v6" /></svg><strong>Jedes Inserat im Netzwerk, bereit zur Ansicht.</strong><p>Ihre Inserate sind am Tag der Veröffentlichung live. Der Bestand des Netzwerks ist ebenfalls dort: filtern Sie ihn und zeigen Sie, was zu Ihren Käufern passt.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h7M18 15l3 3-3 3" /></svg><strong>Leads landen in Ihrem CRM.</strong><p>Jede Anfrage kommt als Lead an. Lead-, Seller- und Property-Pipelines sind kostenlos und ohne Begrenzung; das Verschieben eines qualifizierten Leads in Buyer kostet 1 Credit.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg><strong>Suche, die wie ein Portal funktioniert.</strong><p>Käufer filtern den Bestand nach Gebiet, Typ und Preis auf der Properties-Seite und können eine Suche speichern.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10l8-6 8 6v10M9 20v-5h6v5" /><path d="M2 20h20" /></svg><strong>Ein kostenloses Bewertungsformular, das mehr kann.</strong><p>Jede Anfrage kommt als Lead mit einem bereits ausgefüllten Property Intelligence Report, der Ihnen für 5 Credits zur Verfügung steht, wenn Sie ihn möchten.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6z" /><path d="M9 12h6M9 16h6M15 3v4h4" /></svg><strong>Was der Kauf kostet, aktuell gehalten.</strong><p>Spanische Kaufnebenkosten, Gesetz zitiert. Wir aktualisieren die Sätze, wenn sie sich ändern, damit alles korrekt bleibt, ohne dass Sie eingreifen müssen. Ihr Anwalt bestätigt den Betrag.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19h16M6 16V9M11 16V5M16 16v-7" /></svg><strong>Zahlen, die automatisch ermittelt werden.</strong><p>Immobilien auf Ihrer Website, Gebiete, die Sie abdecken, Sprachen, in denen Sie arbeiten: aus Ihren Live-Anzeigen ermittelt, nie manuell eingegeben, nie veraltet.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-5-6.3" /></svg><strong>Bewertungen und Team, aus dem, was Sie bereits haben.</strong><p>Verbinden Sie Google Business Profile und Ihre Bewertungen erscheinen, oder geben Sie sie ein. Nichts wird erfunden. Ihr Team stammt aus Ihrem Agenturkonto.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg><strong>Jede Sprache, die Ihre Käufer sprechen.</strong><p>Englisch und Spanisch als Standard. Fügen Sie die anderen Sprachen hinzu, die Ihre Käufer sprechen.</p></article>
			</div>
		</div>
	</section>

	<!-- INCLUDED: HOSTING, SSL, SECURITY -->
	<section class="wb-section wb-incl">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Bei jeder Website enthalten</p>
				<h2 class="wb-section-h2">Hosting, SSL und Cloudflare-Sicherheit, <em>alles enthalten.</em></h2>
				<p class="wb-lead">Sie müssen nichts mieten, installieren oder erneuern.</p>
			</div>
			<div class="wb-incl-grid">
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" /><path d="M7 7h.01M7 17h.01" /></svg><strong>Hosting</strong><p>Wird über das Cloudflare-Netzwerk ausgeliefert, sodass Seiten schnell laden, egal wo sich Ihr Käufer befindet. Keine Hosting-Gebühren.</p></article>
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 15v2" /></svg><strong>SSL-Zertifikat</strong><p>Jede Seite läuft über https mit einem Zertifikat, das sich automatisch erneuert.</p></article>
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg><strong>Cloudflare-Sicherheit</strong><p>DDoS-Schutz vor Ihrer Website. Angriffe werden abgefangen, bevor sie diese erreichen.</p></article>
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg><strong>Ihre Adresse</strong><p>your-agency-name.estate-agency.co ab dem ersten Tag. Fügen Sie Ihre eigene Domain für 20 Credits pro Monat hinzu.</p></article>
			</div>
		</div>
	</section>

	<!-- EDIT WITH AI -->
	<section class="wb-section wb-ai">
