---
/* GENERATED FILE - do not edit by hand.
   Source: src/pages/website-builder.astro (English).
   Rebuild: node scripts/gen-wb-langs.mjs --only=de
   Hand edits are lost on the next run; change the English page instead. */
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'de');
const plAgencies = statPlus(__ps.agencies, 'de');
const plListings = statPlus(__ps.listings, 'de');

const title = 'Website Builder für Immobilienmakler | PropertyList.es';
const description =
	'Wählen Sie eines von fünfzehn fertigen Website-Designs für Agenturen, machen Sie es zu Ihrem, und jede Immobilie im PropertyList-Netzwerk erscheint darauf, gefiltert wie Sie es wünschen, mit Anfragen, die in Ihrem CRM eingehen. Kostenlos zu erstellen und in der Vorschau anzusehen, ab 50 Credits pro Monat, sobald Sie veröffentlichen.';
const BUILD = 'https://agents.propertylist.es/website-builder';
const DOCS = 'https://info.propertylist.es/docs/propertylist-mls-user-manual/website-builder/';
const REFERRALS = 'https://agents.propertylist.es/referrals';
const DASHBOARD = 'https://agents.propertylist.es';

// The fifteen templates, as captured from the real files (public/wb). Order is
// the order shown; the style filter hides the rest.
const templates = [
	{ id: '14-solaz', name: 'Solaz', style: 'Präsentation', line: 'Eröffnet wie ein Film. Zypressen und Küste in der Dämmerung, die Überschrift sitzt tief über dem Bild.' },
	{ id: '01-marina', name: 'Marina', style: 'Modern', line: 'Eine türkis-weiße Kopfzeile, eine Live-Suchleiste oben und Ihre neuesten Inserate in einem Raster darunter.' },
	{ id: '03-onyx', name: 'Onyx', style: 'Luxus', line: 'Eine Nachtaufnahme einer beleuchteten Villa, eine Überschrift in Serifenschrift in Weiß, eine Schaltfläche.' },
	{ id: '13-horizon', name: 'Horizon', style: 'Präsentation', line: 'Geteilter Bildschirm: auf der einen Seite eine kräftige Überschrift, auf der anderen ein Innenfoto in voller Höhe.' },
	{ id: '02-blanca', name: 'Blanca', style: 'Minimalistisch', line: 'Ein Foto in voller Breite einer Villa und eines Pools, eine kleine Navigationsleiste, keine Überschrift über dem Bild.' },
	{ id: '05-puerto', name: 'Puerto', style: 'Modern', line: 'Ein Foto in voller Breite bei Dämmerung mit einer schwebenden Karte darüber, die den Preis und die Details anzeigt.' },
	{ id: '07-noir', name: 'Noir', style: 'Luxus', line: 'Beginnt mit einem Film. Eine filmische, dunkle Landschaft mit einer großen, fetten Überschrift darüber und minimaler Navigation.' },
	{ id: '04-sierra', name: 'Sierra', style: 'Klassisch', line: 'Ein cremefarbener Hintergrund, Platz für Ihr Foto neben Ihrem Namen und ein redaktioneller Absatz.' },
	{ id: '09-continental', name: 'Continental', style: 'Modern', line: 'Ein dunkelblaues Dämmerungsfoto, eine fette weiße Überschrift und eine Preiskarte, die über dem Bild liegt.' },
	{ id: '06-atrium', name: 'Atrium', style: 'Minimalistisch', line: 'Hellgrau und Weiß, eine Akzentfarbe in der Überschrift, eine Suchleiste und eine Leiste mit den neuesten Immobilien.' },
	{ id: '11-imperial', name: 'Imperial', style: 'Luxus', line: 'Ein cremefarbener Hintergrund, eine fette Serifüberschrift, zwei Fotos darunter in einer einfachen Galerie.' },
	{ id: '08-cortijo', name: 'Cortijo', style: 'Klassisch', line: 'Ein warmer Pergamenthintergrund, ein bogenförmiger Bilderrahmen neben Ihrem Namen und eine Einleitung.' },
	{ id: '10-meridian', name: 'Meridian', style: 'Minimalistisch', line: 'Ein blasser Hintergrund, eine kursive Serifüberschrift, eine schlichte Suchleiste, nichts, das um Aufmerksamkeit konkurriert.' },
	{ id: '12-heritage', name: 'Heritage', style: 'Klassisch', line: 'Ein weißer Hintergrund, Ihr Name und ein Einleitungsabsatz, grüne Call-to-Action-Buttons.' },
	{ id: '15-faro', name: 'Faro', style: 'Präsentation', line: 'Beginnt mit einem Film. Eine dunkle Silhouette von Bergen und Meer, eine große Serifüberschrift, minimale Navigation.' },
];
const styles = ['Modern', 'Minimalistisch', 'Luxus', 'Klassisch', 'Präsentation'];

const addons = [
	{ name: 'Zusätzliche Seite', what: 'Eine weitere Seite über das enthaltene Set hinaus', price: '10 Credits pro Monat' },
	{ name: 'Instant Content', what: 'Gebietsführer und ein Blog, für Sie geschrieben, unbegrenzt', price: '30 Credits pro Monat' },
	{ name: 'Ihre eigene Domain', what: 'Ihre Domain statt your-agency.estate-agency.co', price: '20 Credits pro Monat' },
	{ name: 'PropertyList-Branding entfernen', what: 'Entfernt das PropertyList-Branding von Ihrer Website', price: '50 Credits pro Monat' },
	{ name: 'Pop-up zur Lead-Erfassung', what: 'Ein Pop-up, das Leads auf Ihrer Website erfasst', price: '8 Credits pro Monat' },
	{ name: 'KI-Antworten bei Inseraten', what: 'Erstellt ein FAQ aus den Fragen, die Käufer tatsächlich stellen', price: '8 Credits pro Monat' },
	{ name: 'Auto-SEO und GEO', what: 'Überprüft Ihre Website wöchentlich und behebt, was möglich ist', price: '5 Credits pro Monat' },
	{ name: 'Monatlicher E-Mail-Bericht', what: 'Eine Leistungsübersicht, die am 1st des Monats per E-Mail zugesandt wird', price: '5 Credits pro Monat' },
];

const faqs = [
	{ q: 'Ist das Erstellen wirklich kostenlos?', a: 'Ja. Das Erstellen und die Vorschau Ihrer Website kosten nichts. Sie werden erst belastet, sobald Sie sie veröffentlichen: 50 Credits pro Monat ab dann, zuzüglich aller Add-ons, die Sie aktivieren.' },
	{ q: 'Was passiert, wenn ich veröffentliche?', a: 'Ihre Website geht mit allen Immobilien aus dem Netzwerk, das Sie zur Anzeige ausgewählt haben, sowie mit Ihren eigenen Inseraten sofort online. Ab diesem Zeitpunkt werden Ihnen für die Website 50 Credits pro Monat berechnet, zuzüglich aller Add-ons, die Sie aktiviert haben. Alle Posten werden monatlich abgerechnet.' },
	{ q: 'Können Sie die Vorlage später ändern?', a: 'Ja. Wechseln Sie jederzeit zu einem der fünfzehn Designs, und Sie behalten Ihre Texte, Ihre Seiten und Ihre Einstellungen.' },
	{ q: 'Müssen Sie Ihre Inserate hochladen?', a: 'Nein. Jede Immobilie im Netzwerk ist bereits dort, gefiltert wie Sie es wünschen, mit Ihren eigenen Inseraten daneben, und alles aktualisiert sich, wenn ein Inserat im CRM geändert wird. Nichts wird zweimal eingegeben.' },
	{ q: 'Wohin gehen Ihre Anfragen?', a: 'Direkt in Ihr PropertyList CRM, und Sie erhalten für jede eine E-Mail. Lead-, Verkäufer- und Objekt-Pipelines sind kostenlos und ohne Begrenzung. Das Verschieben eines qualifizierten Leads in die Käufer-Pipeline kostet 1 Credit.' },
	{ q: 'Können Sie Ihre eigene Domain verwenden?', a: 'Ja, für 20 Credits pro Monat. Bis dahin läuft Ihre Seite unter your-agency-name.estate-agency.co: Ihr Name in der Adresse, nicht unserer.' },
	{ q: 'Was passiert, wenn Sie kündigen?', a: 'Ihre Seite fällt am Ende des Abrechnungszeitraums auf die kostenlose Agentur-Microsite zurück. Sie behalten Ihre Domain.' },
	{ q: 'Ist die SEO gut?', a: 'Von Anfang an gut: jede Seite wird mit sauberer Struktur, Titeln und Beschreibungen geliefert. Schalten Sie Auto SEO und GEO (5 Credits pro Monat) ein, dann arbeitet ein Agent, der Ihrer Website gewidmet ist, jede Woche daran: Er prüft jede Seite, aktualisiert die Keywords entsprechend dem, wonach Käufer jetzt suchen, und behebt, was er findet. Wir versprechen weiterhin keine Rankings; keine ehrliche Plattform kann das.' },
	{ q: 'Muss ich technisch versiert sein?', a: 'Nein. Sie wählen eine Vorlage, bearbeiten sie in einem Editor, der Ihnen Ihre echte Website während der Arbeit zeigt, und veröffentlichen, wenn Sie fertig sind. Mit der Funktion \'Mit AI bearbeiten\' können Sie eine Änderung auch in einfachem Englisch beschreiben.' },
	{ q: 'Wer hostet sie und ist sie sicher?', a: 'Wir übernehmen das. Hosting und Cloudflare-Schutz sind inklusive: Ihre Seite wird schnell aus dem Cloudflare-Netzwerk ausgeliefert und vor Angriffen geschützt, ohne dass Sie etwas verwalten oder erneuern müssen.' },
	{ q: 'Sind die rechtlichen Seiten enthalten?', a: 'Ja. aviso legal, Datenschutz- und Cookie-Seiten sowie ein Cookie-Banner sind in jeder Vorlage enthalten. Sie sind inklusive und werden nie separat berechnet.' },
];

const ldWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'PropertyList Website Builder',
	url: 'https://info.propertylist.es/de/website-baukasten/',
	description,
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es', logo: { '@type': 'ImageObject', url: 'https://info.propertylist.es/og/logo-default.png' } },
};
const ldBreadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://info.propertylist.es/' },
		{ '@type': 'ListItem', position: 2, name: 'Website Builder' },
	],
};
const ldVideo = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: 'PropertyList Website Builder: pick a design, edit it, publish',
	description: 'A 33 second recording of the PropertyList Website Builder with a sample agency: the fifteen designs, one chosen, the headline selected, the hero rearranged, then Review and publish. No sound.',
	thumbnailUrl: ['https://info.propertylist.es/hero/wb-hero-poster.jpg'],
	contentUrl: 'https://info.propertylist.es/hero/wb-hero.mp4',
	uploadDate: '2026-09-05',
	duration: 'PT33S',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es' },
};
const ldFaq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
	lang="de"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/de/website-baukasten/"
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/website-builder/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/constructor-de-webs/' },
		{ hreflang: 'de', href: 'https://info.propertylist.es/de/website-baukasten/' },
		{ hreflang: 'fr', href: 'https://info.propertylist.es/fr/createur-de-site-immobilier/' },
		{ hreflang: 'sv', href: 'https://info.propertylist.es/sv/webbplatsbyggare/' },
		{ hreflang: 'ru', href: 'https://info.propertylist.es/ru/konstruktor-saytov/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/website-builder/' },
	]}
>
	<script type="application/ld+json" set:html={JSON.stringify(ldWebsite)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldVideo)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />

	<!-- HERO -->
	<header class="wb-hero">
		<div class="wrap">
			<div class="wb-hero-grid">
				<div class="wb-hero-text">
					<div class="wb-hero-eyebrow"><img src="https://info.propertylist.es/og/icon-default.png" alt="" width="18" height="18" /><span>Website Builder &middot; alle Inserate im Netzwerk &middot; Leads in Ihr CRM</span></div>
					<h1 class="wb-hero-h1">Wählen Sie ein Design.<br />Ihre Inserate <em>Füllen Sie es aus.</em></h1>
					<p class="wb-hero-sub">Fünfzehn fertige Agentur-Websites, geladen mit allen Objekten im Netzwerk und so gefiltert, wie Sie es wünschen. Anfragen landen in Ihrem CRM und in Ihren Pipelines, und Ihre eigenen Inserate sind am Tag der Veröffentlichung auf der Website.</p>
					<div class="wb-hero-ctas">
						<a class="btn btn-primary btn-large" href={BUILD}>Kostenlos erstellen</a>
						<a class="btn btn-secondary on-dark" href="#xml">Ich habe bereits eine Website</a>
					</div>
					<p class="wb-hero-trust">Kostenlos zu erstellen und anzusehen. Ab 50 Credits pro Monat (etwa 50 EUR), sobald Sie es veröffentlichen. Kündigen Sie zum Ende eines beliebigen Monats.</p>
				</div>
				<div class="wb-hero-visual">
					<figure class="film wb-film">
						<div class="wb-frame wb-frame-dark">
							<div class="wb-frame-bar"><span></span><span></span><span></span><i>Website Builder</i></div>
							<video class="filmVid" autoplay muted loop playsinline preload="auto" poster="/hero/wb-hero-poster.jpg" width="1440" height="900" aria-label="Der Website Builder: die fünfzehn Vorlagen, Solaz ausgewählt, der Editor mit der ausgewählten Überschrift, der Hero-Bereich umgestellt, dann Überprüfen und Veröffentlichen">
								<source src="/hero/wb-hero.mp4" type="video/mp4" />
							</video>
						</div>
						<figcaption class="filmCap">Aufnahme aus dem neuen Builder: die fünfzehn Designs, Solaz ausgewählt, die Überschrift ausgewählt, der Hero-Bereich umgestellt, dann Überprüfen und Veröffentlichen. 33 Sekunden. Die angezeigten Add-ons und Summen stammen von der Beispielseite und können bearbeitet werden.</figcaption>
					</figure>
				</div>
			</div>
		</div>
	</header>

	<!-- PROOF -->
	<section class="wb-trust">
		<div class="wrap">
			<div class="wb-trust-grid">
				<div><div class="wb-trust-num">{plAgents}</div><div class="wb-trust-label">eingetragene Makler auf PropertyList</div></div>
				<div><div class="wb-trust-num">{plAgencies}</div><div class="wb-trust-label">Agenturen, die dort ihr Geschäft betreiben</div></div>
				<div><div class="wb-trust-num">{plListings}</div><div class="wb-trust-label">Angebote im Netzwerk</div></div>
			</div>
			<p class="wb-trust-line">Ihre Website liest aus demselben Netzwerk wie Ihr MLS und CRM. Jede Immobilie darin kann am Tag der Veröffentlichung auf Ihrer Website erscheinen, nach Ihren Wünschen gefiltert, und sie aktualisiert sich in dem Moment, in dem ein Inserat geändert wird.</p>
		</div>
	</section>

	<!-- THE FIFTEEN -->
	<section class="wb-section wb-fifteen" id="templates">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Die fünfzehn</p>
				<h2 class="wb-section-h2">Fünfzehn Designs, <em>eine Plattform.</em></h2>
				<p class="wb-lead">Jedes Template ist eine vollständige Agentur-Website: dieselben Seiten, dieselben Bausteine, die eine Agentur braucht, nur in anderem Erscheinungsbild. Wählen Sie das Template, das zu Ihrer Arbeitsweise passt, nicht umgekehrt.</p>
			</div>
			<div class="wb-chips" role="tablist" aria-label="Vorlagen nach Stil filtern">
				<button class="wb-chip on" type="button" data-style="all" aria-pressed="true">Alle fünfzehn</button>
				{styles.map((s) => <button class="wb-chip" type="button" data-style={s} aria-pressed="false">{s}</button>)}
			</div>
		</div>
		<div class="wb-rail-wrap">
			<button class="wb-rail-btn prev" type="button" aria-label="Vorherige Vorlagen">&lsaquo;</button>
			<div class="wb-rail" id="wbRail">
				{templates.map((t, i) => (
					<article class="wb-tpl" data-style={t.style}>
						<div class="wb-tpl-shots">
							<div class="wb-frame">
								<div class="wb-frame-bar"><span></span><span></span><span></span><i>yourbrand.estate-agency.co</i></div>
								<img src={`/wb/${t.id}-desktop.webp`} width="1440" height="900" alt={`${t.name} template, home page on a desktop screen`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							</div>
							<img class="wb-phone" src={`/wb/${t.id}-phone.webp`} width="390" height="844" alt={`${t.name} template on a phone`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
						</div>
						<div class="wb-tpl-meta">
							<span class="wb-tpl-style">{t.style}</span>
							<h3>{t.name}</h3>
							<p>{t.line}</p>
						</div>
					</article>
				))}
			</div>
			<button class="wb-rail-btn next" type="button" aria-label="Nächste Vorlagen">&rsaquo;</button>
		</div>
		<div class="wrap"><p class="wb-fifteen-note">Sie können später Ihre Wahl ändern: wechseln Sie die Vorlage und behalten Sie Ihre Texte, Ihre Seiten und Ihre Einstellungen. Drei der fünfzehn (Solaz, Noir, Faro) öffnen mit einem Film.</p></div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="wb-section wb-steps">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">So funktioniert es</p>
				<h2 class="wb-section-h2">Wählen. Machen Sie es zu Ihrem. <em>Veröffentlichen.</em></h2>
			</div>
			<div class="wb-steps-grid">
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Wählen Sie eine Vorlage</i></div><img src="/wb/step-1-pick.webp" width="1440" height="900" alt="Die Vorlagenauswahl mit Solaz ausgewählt und der Vorschau daneben" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">1</div>
					<h3>Wählen Sie eine Vorlage</h3>
					<p>Wählen Sie aus fünfzehn fertigen Website-Designs für Agenturen. Jedes einzelne enthält bereits die Seiten, die eine Agentur braucht.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Bearbeiten Sie Ihre Website</i></div><img src="/wb/step-2-edit.webp" width="1440" height="900" alt="Der Editor mit geöffneten Einstellungen des Hero-Blocks, der drei Anordnungen zeigt" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">2</div>
					<h3>Machen Sie es zu Ihrem eigenen</h3>
					<p>Fügen Sie Ihre Markenfarbe, Ihre Texte und Ihre Fotos in einem Editor hinzu, der die echte Website zeigt, während Sie arbeiten. Jeder Block hat mehrere Anordnungen; wählen Sie eine.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Überprüfen und veröffentlichen</i></div><img src="/wb/step-3-publish.webp" width="1440" height="900" alt="Der Dialog Überprüfen und veröffentlichen listet die monatlichen Credits auf, bevor die Website live geschaltet wird." loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">3</div>
					<h3>Veröffentlichen</h3>
					<p>Die Immobilien des Netzwerks und Ihre eigenen sind bereits vorhanden, daher müssen Sie beim Veröffentlichen nichts hochladen. Anfragen landen sofort in Ihrem CRM.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- BUILT FOR AN AGENCY -->
	<section class="wb-section wb-agency">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Für Ihre Agentur gebaut, nicht für ein Café</p>
				<h2 class="wb-section-h2">Die Bausteine, die Ihr Immobilienbüro <em>wirklich braucht.</em></h2>
				<p class="wb-lead">Objektraster, hervorgehobene Immobilie, Suche, Bewertungsformular, Gebietsleitfäden, Team, Bewertungen, Zahlen, Kaufnebenkosten, Neubauprojekte. Jedes liest aus Ihrem Konto, statt Sie zur Eingabe aufzufordern.</p>
			</div>
			<div class="wb-cards">
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9 21v-6h6v6" /></svg><strong>Jedes Inserat im Netzwerk, bereit zur Präsentation.</strong><p>Ihre eigenen Inserate sind am Tag der Veröffentlichung auf Ihrer Website. Der Bestand des Netzwerks ist ebenfalls dort: Filtern Sie ihn und präsentieren Sie sofort, was zu Ihren Käufern passt.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h7M18 15l3 3-3 3" /></svg><strong>Leads landen in Ihrem CRM.</strong><p>Jede Anfrage kommt als Lead an. Leiten Sie die gewünschten durch Ihre Pipelines: Lead, Seller und Property sind ohne Limit kostenlos, und das Verschieben eines qualifizierten Leads in die Buyer-Pipeline kostet 1 Credit.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg><strong>Suche, die wie ein Portal funktioniert.</strong><p>Käufer filtern den Bestand auf der Properties-Seite nach Gebiet, Typ und Preis und können eine Suche speichern.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10l8-6 8 6v10M9 20v-5h6v5" /><path d="M2 20h20" /></svg><strong>Ein kostenloses Bewertungsformular, das mehr kann.</strong><p>Jede Verkäuferanfrage kommt als Lead an, mit einem bereits ausgefüllten Property Intelligence Report, den Sie bei Bedarf für 5 Credits kaufen können.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6z" /><path d="M9 12h6M9 16h6M15 3v4h4" /></svg><strong>Welche Kaufnebenkosten anfallen, stets aktuell.</strong><p>Spanische Kaufnebenkosten mit Zitierung der Gesetzesgrundlage. Wir prüfen neue und geänderte Sätze und aktualisieren den Block, damit Ihre Website korrekt bleibt, ohne dass Sie etwas tun müssen. Ihr Anwalt bestätigt die endgültige Zahl.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19h16M6 16V9M11 16V5M16 16v-7" /></svg><strong>Zahlen, die sich selbst berechnen.</strong><p>Der Zahlenblock liest aus Ihren aktiven Inseraten. Niemand tippt das manuell ein.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-5-6.3" /></svg><strong>Bewertungen und Team, basierend auf dem, was Sie bereits haben.</strong><p>Verbinden Sie Ihr Google Business Profile und Ihre Bewertungen erscheinen auf der Seite, oder geben Sie sie selbst ein. Es wird nichts erfunden. Ihr Team stammt aus den Mitarbeitern, die bereits in Ihrem Agenturkonto eingetragen sind.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg><strong>Jede Sprache, die Ihre Käufer sprechen.</strong><p>Englisch und Spanisch sind standardmäßig enthalten. Fügen Sie die anderen Sprachen hinzu, die Ihre Käufer verwenden, auf derselben Website.</p></article>
			</div>
		</div>
	</section>

	<!-- INCLUDED: HOSTING, SSL, SECURITY -->
	<section class="wb-section wb-incl">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Inklusive bei jeder Website</p>
				<h2 class="wb-section-h2">Hosting, SSL und Cloudflare-Sicherheit, <em>Alles inbegriffen.</em></h2>
				<p class="wb-lead">Nichts zu mieten, zu installieren oder zu erneuern. Ihre Website ist vom Tag der Veröffentlichung an schnell und geschützt und bleibt so.</p>
			</div>
			<div class="wb-incl-grid">
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" /><path d="M7 7h.01M7 17h.01" /></svg><strong>Hosting</strong><p>Über das Cloudflare-Netzwerk ausgeliefert, laden die Seiten schnell, egal wo sich Ihr Käufer befindet. Keine Hosting-Rechnung, kein Server, um den Sie sich kümmern müssen.</p></article>
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 15v2" /></svg><strong>SSL-Zertifikat</strong><p>Jede Seite läuft über https mit einem Zertifikat, das sich automatisch erneuert. Das Vorhängeschloss, das Käufer erwarten, ohne dass Sie etwas tun müssen.</p></article>
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg><strong>Cloudflare-Sicherheit</strong><p>DDoS-Schutz und die Edge-Sicherheit von Cloudflare stehen vor Ihrer Website. Angriffe werden abgefangen, bevor sie diese erreichen.</p></article>
				<article class="wb-incl-item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg><strong>Ihre Adresse</strong><p>your-agency-name.estate-agency.co von Anfang an. Fügen Sie Ihre eigene Domain für 20 Credits pro Monat hinzu.</p></article>
			</div>
		</div>
	</section>

	<!-- EDIT WITH AI -->
	<section class="wb-section wb-ai">
		<div class="wrap">
			<div class="wb-ai-grid">
				<div class="wb-ai-text">
					<p class="eyebrow" style="color:#6fe5d3">Mit KI bearbeiten</p>
					<h2 class="wb-section-h2 on-dark">Klicken Sie ein Element an. <em>Sagen Sie, was geändert werden soll.</em></h2>
					<p class="wb-lead" style="color:#b8c9cb">Beschreiben Sie eine Änderung in einfachem Englisch, und die Seite aktualisiert sich. Jede Änderung ist ein Entwurf, bis Sie sie veröffentlichen, und die Rückgängig-Funktion ist immer verfügbar.</p>
				</div>
				<figure class="wb-ai-shot">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Bearbeiten Sie Ihre Website</i></div><img src="/wb/ai-bubble.webp" width="1440" height="900" alt="Die im Editor ausgewählte Überschrift, mit den Änderungen, die Sie anfordern können" loading="lazy" decoding="async" /></div>
					<figcaption>Die im Editor ausgewählte Überschrift. Kürzer, wärmerer Ton, erwähnen Sie die Stadt oder formulieren Sie es selbst.</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- PRICING -->
	<section id="pricing" class="wb-pricing wb-section">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow" style="color:#6fe5d3">Preise</p>
				<h2 class="wb-section-h2 on-dark">Kostenlos zu erstellen. <em>50 Credits pro Monat, sobald Sie veröffentlichen.</em></h2>
				<p class="wb-lead" style="color:#b8c9cb">Ein Basisplan, Add-ons in Credits, und Sie können jedes davon am Ende eines Monats kündigen.</p>
			</div>
			<div class="wb-price-grid">
				<div class="wb-pricing-card">
					<div class="wb-pricing-name">Website Builder</div>
					<div class="wb-pricing-price">50 Credits <span class="unit">pro Monat</span></div>
					<p class="wb-pricing-tagline">Während Sie bauen und die Vorschau nutzen, wird nichts berechnet; das Abonnement beginnt an dem Tag, an dem Sie veröffentlichen.</p>
					<ul class="wb-pricing-features">
						<li>Startseite, Immobilien (Suche und Ergebnisse, mit Filtern und einer gespeicherten Suche), eine Objektseite für jedes Inserat, Über uns und Kontakt</li>
						<li>Rechtsseiten (aviso legal, Datenschutz, Cookies) und ein Cookie-Banner, inbegriffen und nie in Rechnung gestellt</li>
						<li>Hosting und Cloudflare-Schutz inbegriffen: schnell und geschützt, nichts, das Sie verwalten müssen</li>
						<li>Englisch und Spanisch sind standardmäßig verfügbar, weitere Sprachen können hinzugefügt werden</li>
						<li>Alle fünfzehn Designs, Sie können jederzeit wechseln und Ihre Arbeit behalten</li>
						<li>Anfragen gelangen direkt in Ihr PropertyList CRM</li>
						<li>Kündigen Sie zum Ende eines Monats; die Website wird wieder zur kostenlosen Agentur-Microsite und Sie behalten Ihre Domain</li>
					</ul>
					<div class="wb-pricing-cta"><a class="btn btn-primary btn-large" href={BUILD}>Kostenlos erstellen</a></div>
					<p class="wb-pricing-note">Zusätzliche Seiten: <strong>10 Credits pro Monat</strong> jeweils.</p>
				</div>
				<div class="wb-pricing-aside">
					<div class="wb-addon-card">
						<h4>Add-ons, <em>Wenn Sie sie möchten</em></h4>
						<p class="wb-addon-intro">Jeder Zusatz ist monatlich, wird in Ihrem Konto eingeschaltet und kann zum Ende eines Monats beendet werden.</p>
						<ul class="wb-addon-list">
							{addons.map((a) => (
								<li><span class="wb-addon-name">{a.name}<small>{a.what}</small></span><span class="wb-addon-price">{a.price}</span></li>
							))}
						</ul>
						<div class="wb-addon-footer">Feed für Neubauprojekte: ein separates Modul, Preisangabe in Ihrem Konto.</div>
					</div>
					<div class="wb-credit-info">
						<h4>Was ist ein Credits</h4>
						<p>PropertyList's Einheit für kostenpflichtige Funktionen, gekauft in Paketen: 1 Credit (etwa 1 EUR) im kleinsten Paket, weniger bei größeren. Credits verfallen nicht, alles, was Sie in diesem Monat nicht nutzen, steht Ihnen im nächsten Monat noch zur Verfügung.</p>
						<p style="margin:0"><a href={REFERRALS}>Empfehlen Sie eine andere Agentur</a> und Sie erhalten 20 Credits (etwa 20 EUR), sobald die neue Agentur die Verifizierung abgeschlossen hat, nicht bei der Anmeldung. Die neue Agentur erhält 10 Credits.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ALREADY HAVE A WEBSITE -->
	<section id="xml" class="wb-xml wb-section">
		<div class="wrap">
			<div class="wb-xml-inner">
				<div>
					<p class="eyebrow">Haben Sie bereits eine Website?</p>
					<h2 class="wb-section-h2">Behalten Sie Ihre Website. <em>Speisen Sie Ihre Website mit dem gesamten Netzwerk.</em></h2>
					<p class="wb-lead">Speisen Sie alle Inserate des Netzwerks in die Website ein, die Sie bereits haben, gefiltert nach Ihren Vorgaben: nur Ihr eigenes Angebot oder zusätzlich eine Auswahl aus dem Netzwerk. XML oder die Website API; Ihr Entwickler richtet die Verbindung einmal ein und danach liest die Website aus demselben Konto wie Ihr MLS und CRM.</p>
				</div>
				<div class="wb-xml-card">
					<div class="wb-xml-price-row"><span class="wb-xml-price">35 Credits</span><span class="wb-xml-price-unit">pro Monat</span></div>
					<p class="wb-xml-detail">XML-Feed oder Website API. Kündigen Sie jederzeit.</p>
					<ul class="wb-pricing-features">
						<li>Alle Inserate des Netzwerks auf Ihrer eigenen Website, nach Ihren Wünschen gefiltert</li>
						<li>XML-Feed oder Website API, die Wahl Ihres Entwicklers</li>
						<li>Die Dokumentation ist öffentlich; zum Lesen müssen Sie nichts kaufen.</li>
					</ul>
					<a class="btn btn-primary" href={DASHBOARD}>Richten Sie einen Feed ein</a>
					<p class="wb-xml-docs"><a href={DOCS}>Lesen Sie die Website Builder- und Feed-Dokumentation</a></p>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="wb-faq wb-section">
		<div class="narrow">
			<div class="wb-section-head">
				<p class="eyebrow">Fragen</p>
				<h2 class="wb-section-h2">Welche Makler <em>fragen zuerst.</em></h2>
			</div>
			<div>
				{faqs.map((f) => (
					<div class="wb-faq-item"><details><summary>{f.q}</summary><p>{f.a}</p></details></div>
				))}
			</div>
		</div>
	</section>

	<!-- FINAL CTA -->
	<section class="wb-final wb-section">
		<div class="narrow">
			<p class="eyebrow" style="color:#6fe5d3">Entwickelt an der Costa del Sol &middot; in ganz Spanien im Einsatz</p>
			<h2 class="wb-section-h2 on-dark">Ihre Inserate sind bereit.<br /><em>Ist Ihre Website?</em></h2>
			<p class="wb-lead">Wählen Sie ein Design, machen Sie es zu Ihrem und veröffentlichen Sie es, wann Sie wollen.</p>
			<a class="btn btn-primary btn-large" href={BUILD}>Kostenlos erstellen</a>
			<p class="wb-final-note">Kostenlos zum Erstellen und zur Vorschau. Ab 50 Credits pro Monat, sobald Sie veröffentlichen. <a href={DOCS}>Lesen Sie die Dokumentation</a>.</p>
		</div>
	</section>

	<script is:inline>
		(function () {
			var rail = document.getElementById('wbRail');
			if (!rail) return;
			var chips = document.querySelectorAll('.wb-chip');
			var cards = rail.querySelectorAll('.wb-tpl');
			chips.forEach(function (c) {
				c.addEventListener('click', function () {
					var s = c.getAttribute('data-style');
					chips.forEach(function (x) { var on = x === c; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
					cards.forEach(function (k) { k.hidden = !(s === 'all' || k.getAttribute('data-style') === s); });
					rail.scrollTo({ left: 0, behavior: 'smooth' });
				});
			});
			function step(dir) {
				var first = rail.querySelector('.wb-tpl:not([hidden])');
				var w = first ? first.getBoundingClientRect().width + 24 : rail.clientWidth * 0.8;
				rail.scrollBy({ left: dir * w, behavior: 'smooth' });
			}
			document.querySelector('.wb-rail-btn.prev').addEventListener('click', function () { step(-1); });
			document.querySelector('.wb-rail-btn.next').addEventListener('click', function () { step(1); });
		})();
	</script>
</Layout>

<style is:global>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',system-ui,sans-serif;font-size:16px;line-height:1.6;color:#0d2b2e;background:#fff;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:#00ae9a;text-decoration:none}
a:hover{text-decoration:underline}
.wrap{max-width:1200px;margin:0 auto;padding:0 24px}
.narrow{max-width:880px;margin:0 auto;padding:0 24px}
.eyebrow{font-size:12px;font-weight:700;letter-spacing:2px;color:#00ae9a;text-transform:uppercase;margin-bottom:12px}
.btn{display:inline-block;padding:16px 28px;font-size:15px;font-weight:700;border-radius:10px;border:none;cursor:pointer;transition:transform .15s,box-shadow .15s,background .15s;text-decoration:none}
.btn-primary{background:#00ae9a;color:#fff;box-shadow:0 4px 14px rgba(0,174,154,.3)}
.btn-primary:hover{background:#008f7e;transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,174,154,.4);text-decoration:none}
.btn-secondary{background:transparent;color:#0d2b2e;border:1.5px solid #0d2b2e}
.btn-secondary.on-dark{color:#fff;border-color:rgba(255,255,255,.4)}
.btn-secondary:hover{background:#0d2b2e;color:#fff;text-decoration:none}
.btn-secondary.on-dark:hover{background:#fff;color:#0d2b2e}
.btn-large{padding:18px 36px;font-size:16px}
.wb-section{padding:100px 0}
.wb-section-head{text-align:center;margin-bottom:56px}
.wb-section-head p{max-width:680px;margin:0 auto}
.wb-section-head .eyebrow{margin-bottom:12px}
.wb-section-h2{font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:clamp(30px,4vw,44px);line-height:1.15;letter-spacing:-.01em;color:#0d2b2e;margin-bottom:18px;text-wrap:balance}
.wb-section-h2 em{color:#00ae9a;font-style:italic}
.wb-section-h2.on-dark{color:#fff}
.wb-lead{font-size:18px;line-height:1.6;color:#4a5b5d}

/* browser frame used for every real capture */
.wb-frame{background:#fff;border-radius:14px;overflow:hidden;border:1px solid #e5ecec;box-shadow:0 20px 60px rgba(13,43,46,.12)}
.wb-frame-bar{background:#f3f5f5;padding:10px 14px;display:flex;align-items:center;gap:7px;border-bottom:1px solid #e5ecec}
.wb-frame-bar span{width:10px;height:10px;border-radius:50%;background:#d6dede}
.wb-frame-bar span:nth-child(1){background:#ff5f57}.wb-frame-bar span:nth-child(2){background:#febd2e}.wb-frame-bar span:nth-child(3){background:#28c941}
.wb-frame-bar i{flex:1;font-style:normal;background:#fff;padding:3px 12px;border-radius:6px;font-size:11px;color:#7a8a8c;margin-left:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wb-frame img{width:100%;aspect-ratio:1440/900;object-fit:cover;object-position:top}
.wb-frame-dark{border-color:rgba(255,255,255,.14);box-shadow:0 30px 80px rgba(0,0,0,.45)}
.wb-frame-dark .wb-frame-bar{background:#12373b;border-color:rgba(255,255,255,.08)}
.wb-frame-dark .wb-frame-bar i{background:rgba(255,255,255,.08);color:#b8c9cb}

/* hero */
.wb-hero{background:#0d2b2e;color:#fff;padding:80px 0 56px;position:relative;overflow:hidden}
.wb-hero::before{content:"";position:absolute;top:-200px;right:-200px;width:600px;height:600px;background:radial-gradient(circle,rgba(0,174,154,.15),transparent 70%);pointer-events:none}
.wb-hero-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center;position:relative;z-index:1}
.wb-hero-grid>*{min-width:0}
.wb-hero-eyebrow{display:inline-flex;align-items:center;gap:10px;background:rgba(0,174,154,.16);border:1px solid rgba(0,174,154,.35);padding:8px 14px;border-radius:18px;font-size:11.5px;line-height:1.5;font-weight:700;color:#00ae9a;letter-spacing:1.2px;text-transform:uppercase;margin-bottom:28px;text-align:left}
.wb-hero-eyebrow img{width:18px;height:18px}
.wb-hero-h1{font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:clamp(40px,5.4vw,62px);line-height:1.05;letter-spacing:-.02em;color:#fff}
.wb-hero-h1 em{color:#00ae9a;font-style:italic;white-space:nowrap}
.wb-hero-sub{font-size:19px;line-height:1.55;color:#b8c9cb;margin:24px 0 32px;max-width:520px}
.wb-hero-ctas{display:flex;flex-wrap:wrap;gap:14px;align-items:center}
.wb-hero-trust{margin-top:22px;font-size:13.5px;color:#8aa5a8;letter-spacing:.2px;max-width:480px}
.wb-hero-visual{transform:none}
.film{margin:0;padding:0}
.filmVid{display:block;width:100%;height:auto;aspect-ratio:1440/900;object-fit:cover;background:#0d2b2e}
.filmCap{margin:10px 4px 0;font-size:12.5px;line-height:1.55;color:rgba(255,255,255,.5)}
@media (prefers-reduced-motion: reduce){.filmVid{display:none}.wb-film .wb-frame-dark{aspect-ratio:1440/940;background:url('/hero/wb-hero-poster.jpg') center bottom/cover no-repeat}}

/* proof */
.wb-trust{background:#0d2b2e;padding:72px 0 64px;color:#fff}
.wb-trust-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;text-align:center}
.wb-trust-num{font-family:'Playfair Display',Georgia,serif;font-size:42px;line-height:1;color:#00ae9a;margin-bottom:8px}
.wb-trust-label{font-size:12px;color:#b8c9cb;letter-spacing:1px;text-transform:uppercase}
.wb-trust-line{text-align:center;max-width:720px;margin:40px auto 0;font-size:17px;line-height:1.6;color:#cfdedf}

/* the fifteen */
.wb-fifteen{background:#faf6ee;padding-bottom:70px}
.wb-chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:-24px 0 34px}
.wb-chip{background:#fff;border:1px solid #e5ecec;color:#0d2b2e;padding:9px 16px;border-radius:50px;font-size:13.5px;font-weight:600;cursor:pointer;transition:background .15s,color .15s,border-color .15s}
.wb-chip:hover{border-color:#00ae9a}
.wb-chip.on{background:#0d2b2e;color:#fff;border-color:#0d2b2e}
.wb-rail-wrap{position:relative}
.wb-rail{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;padding:10px max(24px,calc((100vw - 1200px)/2 + 24px)) 30px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.wb-rail::-webkit-scrollbar{display:none}
.wb-tpl{flex:0 0 min(78vw,720px);scroll-snap-align:start;min-width:0}
.wb-tpl[hidden]{display:none}
.wb-tpl-shots{position:relative;padding:0 9% 9% 0}
.wb-tpl-shots .wb-frame img{transition:object-position 2.4s ease}
.wb-tpl-shots .wb-phone{position:absolute;right:0;bottom:0;width:23%;border-radius:22px;border:5px solid #0d2b2e;box-shadow:0 24px 50px rgba(13,43,46,.28);aspect-ratio:390/844;object-fit:cover;object-position:top;background:#0d2b2e}
.wb-tpl-meta{margin-top:18px;display:grid;grid-template-columns:auto 1fr;gap:6px 14px;align-items:baseline}
.wb-tpl-style{font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#00ae9a;background:#e5f5f3;padding:5px 10px;border-radius:50px;grid-row:1}
.wb-tpl-meta h3{font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:26px;line-height:1.1;color:#0d2b2e;grid-row:1}
.wb-tpl-meta p{grid-column:1/-1;color:#4a5b5d;font-size:15px;line-height:1.55;max-width:600px}
.wb-rail-btn{position:absolute;top:36%;width:46px;height:46px;border-radius:50%;border:1px solid #e5ecec;background:#fff;color:#0d2b2e;font-size:30px;line-height:1;cursor:pointer;box-shadow:0 8px 24px rgba(13,43,46,.14);z-index:2;display:flex;align-items:center;justify-content:center;padding-bottom:4px}
.wb-rail-btn:hover{background:#0d2b2e;color:#fff}
.wb-rail-btn.prev{left:max(8px,calc((100vw - 1200px)/2 - 20px))}
.wb-rail-btn.next{right:max(8px,calc((100vw - 1200px)/2 - 20px))}
.wb-fifteen-note{text-align:center;color:#4a5b5d;font-size:15px;margin-top:6px}

/* steps */
.wb-steps{background:#fff}
.wb-steps-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
.wb-step{min-width:0}
.wb-step-num{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;background:#e5f5f3;color:#00ae9a;border-radius:12px;font-family:'Playfair Display',Georgia,serif;font-weight:700;font-size:19px;margin:22px 0 12px}
.wb-step h3{font-size:20px;font-weight:700;color:#0d2b2e;margin-bottom:8px}
.wb-step p{color:#4a5b5d;font-size:15px;line-height:1.6}

/* agency cards */
.wb-agency{background:#f5efe6}
.wb-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.wb-card{background:#fff;border:1px solid #e5ecec;border-radius:18px;padding:26px 24px;min-width:0;transition:transform .2s,box-shadow .2s}
.wb-card:hover{transform:translateY(-3px);box-shadow:0 20px 40px rgba(13,43,46,.08)}
.wb-card svg{width:30px;height:30px;fill:none;stroke:#00ae9a;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;margin-bottom:16px}
.wb-card strong{display:block;font-size:16px;line-height:1.35;color:#0d2b2e;margin-bottom:8px}
.wb-card p{color:#4a5b5d;font-size:14.5px;line-height:1.6}

/* included strip */
.wb-incl{background:#fff}
.wb-incl-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.wb-incl-item{background:#faf6ee;border:1px solid #e5ecec;border-radius:18px;padding:26px 24px;min-width:0}
.wb-incl-item svg{width:30px;height:30px;fill:none;stroke:#00ae9a;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;margin-bottom:16px}
.wb-incl-item strong{display:block;font-size:17px;line-height:1.3;color:#0d2b2e;margin-bottom:8px}
.wb-incl-item p{color:#4a5b5d;font-size:14.5px;line-height:1.6}

/* edit with AI */
.wb-ai{background:#0d2b2e;color:#fff;position:relative;overflow:hidden}
.wb-ai::before{content:"";position:absolute;top:-180px;left:-160px;width:560px;height:560px;background:radial-gradient(circle,rgba(0,174,154,.18),transparent 70%);pointer-events:none}
.wb-ai-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;align-items:center;position:relative;z-index:1}
.wb-ai-grid>*{min-width:0}
.wb-ai-text h2{margin-bottom:18px}
.wb-ai-shot{margin:0}
.wb-ai-shot .wb-frame{border-color:rgba(255,255,255,.14);box-shadow:0 30px 80px rgba(0,0,0,.45)}
.wb-ai-shot figcaption{margin:10px 4px 0;font-size:12.5px;line-height:1.55;color:rgba(255,255,255,.5)}

/* pricing */
.wb-pricing{background:#0d2b2e;color:#fff}
.wb-price-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:28px;align-items:stretch}
.wb-price-grid>*{min-width:0}
.wb-pricing-card{background:linear-gradient(135deg,#fff,#f5fbfa);color:#0d2b2e;border-radius:24px;padding:44px 40px;box-shadow:0 30px 80px rgba(0,0,0,.4)}
.wb-pricing-name{font-family:'Playfair Display',Georgia,serif;font-size:26px;margin-bottom:6px}
.wb-pricing-price{font-family:'Playfair Display',Georgia,serif;font-size:clamp(30px,5vw,40px);line-height:1.1;color:#00ae9a;margin:12px 0 6px;text-wrap:balance}
.wb-pricing-price .unit{font-size:18px;color:#7a8a8c;margin-left:4px;font-family:'Inter',system-ui,sans-serif}
.wb-pricing-tagline{font-size:14.5px;color:#4a5b5d;margin-bottom:20px;line-height:1.55}
.wb-pricing-features{list-style:none;padding:0;margin:20px 0 28px}
.wb-pricing-features li{padding:8px 0 8px 34px;position:relative;color:#2a3b3d;font-size:15px;line-height:1.5}
.wb-pricing-features li::before{content:"✓";position:absolute;left:0;top:7px;color:#00ae9a;font-weight:700;width:22px;height:22px;background:#e5f5f3;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:13px}
.wb-pricing-cta{text-align:center}
.wb-pricing-cta a{display:block}
.wb-pricing-note{text-align:center;margin-top:16px;font-size:13.5px;color:#4a5b5d}
.wb-pricing-note strong{color:#00ae9a}
.wb-pricing-aside{display:flex;flex-direction:column;gap:22px}
.wb-addon-card{background:#fff;border-radius:20px;padding:28px 26px;color:#0d2b2e;box-shadow:0 10px 30px rgba(0,0,0,.15);flex:1}
.wb-addon-card h4{font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:22px;line-height:1.2;margin-bottom:6px;color:#0d2b2e}
.wb-addon-card h4 em{color:#00ae9a;font-style:italic}
.wb-addon-intro{font-size:13px;color:#4a5b5d;margin-bottom:14px;line-height:1.55}
.wb-addon-list{list-style:none;padding:0;margin:0}
.wb-addon-list li{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #e5ecec;gap:14px}
.wb-addon-list li:last-child{border-bottom:none}
.wb-addon-name{font-size:14px;font-weight:600;color:#0d2b2e;flex:1;min-width:0}
.wb-addon-name small{display:block;font-size:11.5px;font-weight:500;color:#7a8a8c;letter-spacing:.2px;margin-top:2px}
.wb-addon-price{font-size:13px;font-weight:700;color:#00ae9a;white-space:nowrap;background:#e5f5f3;padding:5px 10px;border-radius:8px}
.wb-addon-footer{margin-top:16px;padding:12px 14px;background:#f5fbfa;border-radius:10px;font-size:12.5px;color:#4a5b5d;line-height:1.5}
.wb-credit-info{background:linear-gradient(135deg,#f5efe6,#faf6ee);border-radius:20px;padding:26px;color:#0d2b2e;box-shadow:0 10px 30px rgba(0,0,0,.1)}
.wb-credit-info h4{font-family:'Playfair Display',Georgia,serif;font-weight:400;font-size:20px;margin-bottom:8px;color:#0d2b2e}
.wb-credit-info p{font-size:13.5px;color:#4a5b5d;line-height:1.55;margin-bottom:12px}
.wb-credit-info a{font-weight:700}

/* feed */
.wb-xml{background:#f5efe6;position:relative}
.wb-xml::before{content:"";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,#00ae9a,transparent)}
.wb-xml-inner{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.wb-xml-inner>*{min-width:0}
.wb-xml-card{background:#fff;border-radius:20px;padding:40px 36px;border:1px solid #e5ecec;box-shadow:0 20px 50px rgba(13,43,46,.08)}
.wb-xml-price-row{display:flex;align-items:baseline;gap:8px;margin-bottom:6px}
.wb-xml-price{font-family:'Playfair Display',Georgia,serif;font-size:44px;line-height:1;color:#0d2b2e}
.wb-xml-price-unit{font-size:16px;color:#7a8a8c}
.wb-xml-detail{font-size:13.5px;color:#00ae9a;font-weight:700;margin-bottom:8px}
.wb-xml-card .wb-pricing-features{margin:10px 0 24px}
.wb-xml-docs{margin-top:16px;font-size:13.5px}

/* faq */
.wb-faq{background:#fff}
.wb-faq-item{border-bottom:1px solid #e5ecec;padding:24px 0}
.wb-faq-item:first-of-type{border-top:1px solid #e5ecec}
.wb-faq details summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:20px;font-size:18px;font-weight:700;color:#0d2b2e;transition:color .15s}
.wb-faq details summary::-webkit-details-marker{display:none}
.wb-faq details summary::after{content:"+";font-size:28px;font-weight:300;color:#00ae9a;transition:transform .2s;line-height:1}
.wb-faq details[open] summary::after{content:"-"}
.wb-faq details summary:hover{color:#00ae9a}
.wb-faq details>p{margin-top:14px;color:#4a5b5d;line-height:1.7;font-size:15px}

/* final */
.wb-final{background:#0d2b2e;color:#fff;text-align:center}
.wb-final .wb-lead{color:#b8c9cb;max-width:620px;margin:0 auto 36px}
.wb-final-note{margin-top:20px;font-size:14px;color:#8aa5a8}
.wb-final-note a{color:#00ae9a;font-weight:700}

/* Media queries last: rules above would otherwise win at every width. */
@media(max-width:1024px){.wb-cards,.wb-incl-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.wb-steps-grid{grid-template-columns:1fr;max-width:720px;margin:0 auto}}
@media(max-width:900px){.wb-section{padding:70px 0}.wb-hero{padding:50px 0 44px}.wb-hero-grid{grid-template-columns:minmax(0,1fr);gap:36px}.wb-hero-visual{transform:none}.wb-trust{padding:60px 0 50px}.wb-trust-grid{gap:20px}.wb-trust-num{font-size:32px}.wb-ai-grid,.wb-xml-inner,.wb-price-grid{grid-template-columns:minmax(0,1fr);gap:36px}.wb-pricing-card{padding:34px 26px}.wb-tpl{flex-basis:84vw}.wb-rail-btn{display:none}}
@media(max-width:560px){.wb-trust-grid{grid-template-columns:1fr}.wb-cards,.wb-incl-grid{grid-template-columns:1fr}.wb-hero-ctas{flex-direction:column;align-items:stretch}.wb-hero-ctas .btn{text-align:center}.wb-tpl-meta h3{font-size:22px}.wb-chips{margin-top:-10px}.wb-xml-card{padding:28px 22px}.wb-addon-list li{flex-wrap:wrap}}
@media(max-width:380px){.wrap,.narrow{padding:0 16px}}
</style>
