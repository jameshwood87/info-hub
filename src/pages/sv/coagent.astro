---
import Layout from '../../layouts/Layout.astro';
import CoagentPhone from '../../components/CoagentPhone.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
import { COAGENT_NUMBER, coagentWaLink, CRM_STAFF_URL } from '../../data/coagent';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/sv/coagent/`;
const title = 'PropertyList CoAgent - ditt CRM i WhatsApp | PropertyList';
const description =
	'CoAgent är ditt CRM i WhatsApp. Skicka ett röstmeddelande efter visningen, så står uppdateringen klar för ditt godkännande. Din röst sparas aldrig, och inget sparas förrän du svarar YES.';

const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'sv');
const plAgencies = statPlus(__ps.agencies, 'sv');
const plListings = statPlus(__ps.listings, 'sv');

const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=en';
const WA = coagentWaLink('Hej');
// A reminder for 9am Madrid time (07:00 UTC) on launch day, until the number exists.
const CAL = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent('Skriv till PropertyList CoAgent')}&dates=20260915T070000Z/20260915T071500Z&details=${encodeURIComponent('CoAgents nummer finns på https://info.propertylist.es/sv/coagent/?utm_source=calendar&utm_medium=reminder&utm_campaign=coagent-launch från kl. 9. Innan du skriver till den, se till att du är registrerad och har ditt WhatsApp-nummer på din användare. Gratis för alla agenter till 22 september.')}`;

// Everything CoAgent does today, as the question an agent would actually send.
// Tap a question to see what comes back. Answers are the verified descriptions.
const moments = [
	{
		label: 'I bilen',
		asks: [
			{ q: 'Var är min nästa visning?', a: 'Din kalender, med adressen och kundens telefonnummer först, eftersom du läser det i bilen.' },
			{ q: 'Vad har jag imorgon?', a: 'Hela dagen, i ordning, med objektet och vem du ska träffa.' },
			{ q: 'Vilket nummer har Marta Ruiz?', a: 'Hennes telefon och mejl först, så att tummen redan ligger på samtalsknappen.' },
			{ q: 'Sammanfatta the Bergs för mig', a: 'Var de ligger i processen, vad de letar efter och det senaste som hänt, innan du ringer.' },
		],
	},
	{
		label: 'Med en kund bredvid dig',
		asks: [
			{ q: 'Vad har vi i Marbella, tre sovrum, upp till två miljoner?', a: 'Fem objekt från det delade MLS-systemet med priser och länkar. Ingen kund behöver anges, så det fungerar även med någon som sitter bredvid dig.' },
			{ q: 'Berätta om PL22234', a: 'Pris, sovrum, storlek, läge och länken till just det objektet, oavsett om det är ditt eller en annan byrås.' },
			{ q: 'Vilket har bäst värde, PL5001, PL5002 eller PL5003?', a: 'Den rangordnar dem mot jämförbara bostäder till salu i närheten, med pris per kvadratmeter, så att du kan säga till en kund vilket som är attraktivt prissatt och vilket som begär för mycket. Fråga direkt efter en sökning, så jämför den de resultaten.' },
			{ q: 'Hur många lägenheter är till salu i San Pedro?', a: 'Det verkliga antalet på marknaden där, de bästa träffarna och en länk till hela listan i ditt CRM.' },
			{ q: 'Är PL22234 fortfarande tillgänglig?', a: 'Om objektet tillhör en annan byrå erbjuder sig CoAgent att fråga dem åt dig. Svara YES, så går förfrågan till dem via MLS-systemet, och deras svar kommer tillbaka till dig.' },
		],
	},
	{
		label: 'Efter visningen',
		asks: [
			{ q: 'Lägg till en anteckning hos Marta: hon vill se den igen på lördag', a: 'Den läser upp anteckningen med dina egna ord och sparar den i hennes fil när du svarar YES.' },
			{ q: 'Marta har lagt ett bud', a: 'CoAgent flyttar hennes kort till rätt steg i din pipeline när du svarar YES, precis som att dra det i CRM:et. Att markera en kund som vunnen eller förlorad görs fortfarande i CRM:et, där den frågar efter detaljerna.' },
			{ q: 'Lägg till Maria Lopez 6XX XXX XXX maria@example.com', a: 'Eller dela hennes kontaktkort direkt från telefonen. CoAgent läser upp namnet, numret och mejlen och lägger till henne i ditt CRM när du svarar YES. Finns hon redan där länkas hennes post istället för att skapa en dubblett.' },
			{ photo: true, q: 'Ett foto av en kunds legitimation', a: 'Bara namn, efternamn och födelsedatum läses av, och läggs till som ny kontakt när du svarar YES. Dokumentnumret sparas aldrig, och inte heller fotot.' },
		],
	},
	{
		label: 'Vinna objektet',
		asks: [
			{ q: 'Vi lägger in ett objekt', a: 'CoAgent säger vad du ska skicka: fotona, sedan priset, var det ligger och antal sovrum, med dina egna ord. Inga kommandon att lära sig.' },
			{ photo: true, q: 'Foton av ett nytt objekt', a: 'Skicka dem direkt från kamerarullen, berätta sedan om objektet för CoAgent, skrivet eller som röstanteckning. Den frågar efter det som saknas, som priset, läser upp objektet, och skriver rubrik, beskrivning och egenskaper när du svarar YES. Svara PUBLISH, så går det till granskning, precis som från CRM:et. Inget publiceras utan det.' },
			{ photo: true, q: 'Ett foto av en Se Vende-skylt', a: 'CoAgent läser av telefonnumret på skylten, plus namn eller pris om det står med. Svara YES, så sparas ägaren som kontakt i ditt CRM med en anteckning om skylten och en påminnelse om att ringa.' },
			{ q: 'Vad är Nueva Andalucía värt?', a: 'Medianpriset och intervallet för det som faktiskt finns till salu där. Om vi inte har tillräckligt med objekt i ett område säger den det istället för att gissa.' },
			{ q: 'Vad är PL22234 värt?', a: 'Ett värde från notariebekräftade försäljningar i den staden, med ett intervall och en länk till det offentliga underlaget. Eller beskriv bostaden istället: "en lägenhet på 120 m² i Estepona". Den säger alltid vad siffran bygger på.' },
			{ q: 'REPORT', a: 'Efter en värdering, svara REPORT för den fullständiga Property Intelligence Report, som en länk du kan skicka till säljaren. Din första är gratis. Efter det kostar det krediter, och den säger hur många och frågar innan den spenderar något.' },
			{ q: 'BROCHURE PL22234', a: 'En broschyr för objektet med din egen varumärkesprofil: en sida din kund kan öppna, med dagens pris och ett sätt att höra av sig, plus PDF:en. Den säger priset i krediter först, och en broschyr du redan gjort skickas igen gratis.' },
		],
	},
	{
		label: 'Nya leads',
		asks: [
			{ q: 'Vilka är mina senaste leads?', a: 'Dina fem senaste, med vem som hörde av sig, om vilket objekt och när: dina egna, eller hela byråns om du är admin, precis som i CRM:et. Svara REPLY för att besvara den senaste via mejl.' },
			{ q: 'REPLY', a: 'CoAgent skriver ett mejl till din senaste lead på deras eget språk, utifrån vad de frågade. Svara YES, så skickas det från dig via CRM:et, och deras svar kommer till din mejl. Eller svara direkt på aviseringen om ny lead.' },
		],
	},
];

const faqs = [
	{ q: 'Vad behöver jag installera?', a: 'Inget. CoAgent fungerar i WhatsApp, som du redan använder hela dagen. Spara PropertyLists nummer, se till att din mobil finns på din CRM-profil så att den vet att du är agent och inte kund, och skicka den en röstanteckning.' },
	{ q: 'Ändrar den mitt CRM automatiskt?', a: 'Nej. CoAgent föreslår och väntar. Den visar dig kunden den har matchat och ändringarna den vill göra, fält för fält, och inget skrivs förrän du svarar YES. Hör den fel kostar det dig ett ord, inte en felaktig budget som ligger tyst i en delad post.' },
	{ q: 'Spelas mina röstanteckningar in?', a: 'Nej. Ljudet transkriberas och kastas sedan. Transkriptionen sparas på kundens post, där du kan läsa exakt vad CRM:et fick veta.' },
	{ q: 'Fungerar det på svenska?', a: 'Nej. CoAgent svarar på engelska, spanska, tyska, franska, portugisiska, bulgariska och grekiska, inte på svenska. Skriv till den på engelska (eller något av de andra språken). Den hanterar en röstanteckning som byter språk mitt i, vilket på den här kusten är de flesta.' },
	{ q: 'Måste jag namnge en kund varje gång?', a: 'Nej. Att namnge en kund gör om röstanteckningen till CRM-uppdateringar. Utan namn kan du fortfarande fråga om objekt, din kalender, ett objekt via referens eller vad ett område är värt, vilket är precis vad du vill ha när en kund som bara dykt upp står bredvid dig.' },
	{ q: 'Kan den prata med andra byråer åt mig?', a: 'Ja. Fråga om ett objekt från en annan byrå fortfarande är tillgängligt, så erbjuder sig CoAgent att skicka förfrågan. Svara YES, så går den via MLS-systemet på samma sätt som en förfrågan skickad från CRM-skärmen, så den hamnar i deras vanliga flöde.' },
	{ q: 'Vad händer om CoAgent inte känner igen mitt nummer?', a: 'Den svarar, på spanska och engelska, med en länk för att skapa ditt gratiskonto och en länk till Staff-sidan i ditt CRM, där du lägger till din mobil på din profil. Sätt landskoden framför om ditt nummer inte är spanskt, och skriv till den igen.' },
	{ q: 'Vad kostar krediter?', a: 'Meddelanden ingår i din plan. En broschyr och marknadsrapporten efter din första gratis betalas med PropertyList-krediter, till samma pris som i CRM:et. CoAgent säger alltid priset och väntar på ditt YES innan den spenderar något, och en broschyr som misslyckas debiteras aldrig.' },
	{ q: 'Vad kostar det?', a: 'CoAgent är gratis för alla agenter till 22 september. Därefter får alla agenter 20 gratis meddelanden i månaden, och att svara YES räknas aldrig. De första 10 agenterna som skriver till CoAgent är undantaget: gratis och obegränsat till 1 november 2026. Obegränsat kostar 50 krediter i månaden per agent, betalt med dina PropertyList-krediter, och du kan stoppa förnyelsen när du vill. Fler än 3 agenter? Prata med oss om ett paket. MLS-systemet och CRM-kärnan förblir gratis, och det kostar inget att skapa ditt konto.' },
	{ q: 'Vad är inte lanserat än?', a: 'Att koppla ditt eget WhatsApp-nummer så att kundchattar arkiverar sig själva, en egen arbetslinje inuti PropertyList-appen, och att kundöversikten dyker upp av sig själv på din samtalsskärm. Allt annat på den här sidan fungerar redan idag.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Hem', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Funktioner', item: `${origin}/features/` },
		{ '@type': 'ListItem', position: 3, name: 'CoAgent', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList CoAgent',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android', url: canonical,
	description: 'En assistent för mäklare som fungerar via WhatsApp: röstanteckningar blir CRM-uppdateringar som agenten godkänner, och frågor om kunder, objekt, kalendern och områdespriser besvaras från byråns CRM och det delade MLS-systemet. Ljudet sparas aldrig.',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};
---

<Layout
	lang="sv"
	title={title}
	description={description}
	canonical={canonical}
	ogImage="https://info.propertylist.es/og/og-coagent-v3-sv.jpg"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/coagent/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/coagent/' },
		{ hreflang: 'de', href: 'https://info.propertylist.es/de/coagent/' },
		{ hreflang: 'fr', href: 'https://info.propertylist.es/fr/coagent/' },
		{ hreflang: 'sv', href: 'https://info.propertylist.es/sv/coagent/' },
		{ hreflang: 'ru', href: 'https://info.propertylist.es/ru/coagent/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/coagent/' },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="cx heroGrid">
			<div>
				<div class="eyebrow"><span class="dot"></span> CoAgent &middot; ditt CRM i WhatsApp</div>
				<h1>Sluta skriva in i CRM:et.<br /><span>Prata med det istället.</span></h1>
				<p class="heroLead">
					Skicka en röstanteckning efter visningen. Svara YES. <strong>Pappersarbetet är klart, och kvällen är din.</strong>
				</p>
				<div class="ctaRow">
					{WA ? (
						<a class="btnPrimary" href={WA} target="_blank" rel="noopener">Skriv till CoAgent i WhatsApp</a>
					) : (
						<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Skapa ditt gratiskonto</a>
					)}
					<a class="btnGhost" href="#how">Se hur det fungerar</a>
				</div>
				<p class="micro">Gratis för alla agenter till 22 september &middot; Inget att installera &middot; Din röst sparas aldrig &middot; CoAgent svarar på engelska, spanska, tyska, franska, portugisiska, bulgariska och grekiska</p>
				{WA && <p class="member"><b>WhatsApp: <a href={WA} target="_blank" rel="noopener">{COAGENT_NUMBER}</a></b></p>}
				{WA ? (
					<p class="member">Redan på PropertyList? <a href={CRM_STAFF_URL} target="_blank" rel="noopener">Lägg till ditt WhatsApp-nummer på din användare</a> så att CoAgent vet att det är du.</p>
				) : (
					<p class="member">
						<b>Numret är tillgängligt från kl. 9 tisdag 15 september.</b> Innan du skriver till den, se till att du är
						<a href={SIGNUP} target="_blank" rel="noopener">registrerad</a> och att ditt
						<a href={CRM_STAFF_URL} target="_blank" rel="noopener">WhatsApp-nummer är tillagt på din användare</a>.
						<a class="calBtn" href={CAL} target="_blank" rel="noopener" style="display:table;margin-top:10px;padding:8px 14px;border-radius:10px;background:#0b1220;color:#fff;text-decoration:none;font-weight:800">Påminn mig kl. 9 på tisdag</a>
					</p>
				)}
			</div>
			<CoagentPhone lang="sv" />
		</div>
	</section>

	<div class="strip">
		<div class="cx stripInner">
			<span>Bakom det: <b>{plAgencies}</b> byråer</span>
			<span><b>{plAgents}</b> agenter</span>
			<span><b>{plListings}</b> aktiva objekt</span>
			<span>Svarar på <b>7</b> språk</span>
		</div>
	</div>

	<section class="band dark">
		<div class="cx">
			<div class="head center">
				<h2>Kvällen kan sluta på två sätt.</h2>
				<p>Ingen glömmer med flit. Dagen går bara fortare än pappersarbetet.</p>
			</div>
			<div class="versus">
				<div class="vCol without">
					<div class="vHead">Utan CoAgent</div>
					<ol>
						<li><b>18:40</b><span>Sista visningen. Tre löften, alla i huvudet.</span></li>
						<li><b>21:30</b><span>Datorn öppen, skriver av dagen ur minnet.</span></li>
						<li><b>På torsdag</b><span>”Skickade du någonsin det där objektet till mig?”</span></li>
					</ol>
				</div>
				<div class="vCol with">
					<div class="vHead">Med CoAgent</div>
					<ol>
						<li><b>18:41</b><span>En röstanteckning från parkeringen.</span></li>
						<li><b>18:42</b><span>Du svarar YES. Anteckning, önskemål och påminnelse sparade.</span></li>
						<li><b>21:30</b><span>Du är inte vid datorn.</span></li>
					</ol>
				</div>
			</div>
			<p class="punch">Ditt minne är utmärkt. <span>Fram till torsdag.</span></p>
		</div>
	</section>

	<section class="band soft" id="how">
		<div class="cx">
			<div class="head center">
				<div class="label">Så fungerar det</div>
				<h2>Prata. Kolla. Säg YES.</h2>
			</div>
			<div class="grid3">
				<div class="demo">
					<span class="num">1</span>
					<h3>Prata</h3>
					<p>Precis som du skulle prata med en kollega.</p>
					<div class="mini">
						<div class="mb me">”Marta gillade den. Nu öppen för tre sovrum, upp till åttahundrafemtio. Jag sa att jag skulle skicka henne den i Cerquilla på lördag.”</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">2</span>
					<h3>Kolla</h3>
					<p>Se exakt vad den uppfattade.</p>
					<div class="mini">
						<div class="mb">
							<b>Marta Ruiz · köpare</b>
							<span class="kv"><i>Budget</i><em>850 000 €</em></span>
							<span class="kv"><i>Sovrum</i><em>3</em></span>
							<span class="kv"><i>Påminnelse</i><em>Cerquilla, lördag</em></span>
						</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">3</span>
					<h3>Säg YES</h3>
					<p>Först då ändras något.</p>
					<div class="mini">
						<div class="mb">Svara <b>YES</b> för att spara det.</div>
						<div class="mb me short">YES</div>
						<div class="mb done">Sparat. Lördagen finns i din kalender.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band" id="ask">
		<div class="cx">
			<div class="head center">
				<div class="label">Vad du kan fråga</div>
				<h2>Fråga den som du skulle fråga en kollega.</h2>
				<p>Tryck på ett meddelande för att se vad du får tillbaka.</p>
			</div>
			<div class="moments">
				{moments.map((m) => (
					<div class="moment">
						<div class="momentLabel">{m.label}</div>
						<div class="chips">
							{m.asks.map((item) => (
								<details class="chip">
									<summary>
										{item.photo && <span class="tag">Foto</span>}
										{item.photo ? item.q : `”${item.q}”`}
									</summary>
									<p>{item.a}</p>
								</details>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="band soft" id="matching">
		<div class="cx">
			<div class="matchBox">
				<div class="matchCopy">
					<div class="label">Byggt på det delade MLS-systemet</div>
					<h2>Kom inte bara ihåg kunden. <span>Hitta deras nästa bostad.</span></h2>
					<p>Den söker i utbudet från {plAgencies} byråer, inte bara ditt eget. Om rätt bostad tillhör en annan byrå frågar den dem åt dig.</p>
					<ul class="checks">
						<li>Hela det delade MLS-systemet, inte bara dina objekt</li>
						<li>Bästa värde rangordnat efter pris per m²</li>
						<li>Värderingar från notariebekräftade försäljningar, med bevis</li>
					</ul>
				</div>
				<div class="matchVisual" aria-hidden="true">
					<div class="resCard">
						<div class="resHead">
							<span>Från det delade MLS-systemet</span>
							<em>3 sovrum &middot; Nueva Andalucía &middot; upp till 850 000 €</em>
						</div>
						<div class="res">
							<span class="resPh a"></span>
							<span class="resTxt"><b>PL5001 &middot; Lägenhet</b><i>3 sovrum &middot; Nueva Andalucía</i></span>
							<span class="resP">845 000 €<small class="own">Ditt objekt</small></span>
						</div>
						<div class="res">
							<span class="resPh b"></span>
							<span class="resTxt"><b>PL5002 &middot; Takvåning</b><i>3 sovrum &middot; Nueva Andalucía</i></span>
							<span class="resP">830 000 €<small>Annan byrå</small></span>
						</div>
						<div class="res">
							<span class="resPh c"></span>
							<span class="resTxt"><b>PL5003 &middot; Radhus</b><i>3 sovrum &middot; Aloha</i></span>
							<span class="resP">799 000 €<small>Annan byrå</small></span>
						</div>
						<div class="resAsk">PL5002 tillhör en annan byrå. Svara <b>YES</b>, så frågar jag om den fortfarande är tillgänglig.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="cx">
			<div class="head center">
				<div class="label">Tre löften</div>
				<h2>Jobba inte åt ditt CRM. <span>Låt CRM:et jobba åt dig.</span></h2>
			</div>
			<div class="grid3">
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-3.1A7 7 0 0 0 19 11z" /></svg>
					</span>
					<h3>Din röst sparas aldrig</h3>
					<p>Transkriberas, och kastas sedan. Bara texten blir kvar, på kundens post.</p>
				</div>
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M9.5 16.2 5.3 12l-1.4 1.4 5.6 5.6L21 7.5l-1.4-1.4z" /></svg>
					</span>
					<h3>Inget sparas förrän YES</h3>
					<p>Säger du inget händer inget. Ingen post ändras, ingen förfrågan skickas.</p>
				</div>
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3z" /></svg>
					</span>
					<h3>Inga hittepå-svar</h3>
