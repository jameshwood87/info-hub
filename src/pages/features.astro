<script is:inline>
	(function () {
		var input = document.getElementById('faq-filter');
		var items = Array.from(document.querySelectorAll('[data-faq="1"]'));
		var groups = Array.from(document.querySelectorAll('[data-group]'));
		var norm = function (s) { return String(s || '').toLowerCase().trim(); };
		var run = function () {
			var q = norm(input ? input.value : '');
			for (var i = 0; i < items.length; i++) {
				var it = items[i];
				var text = norm(it.getAttribute('data-q')) + ' ' + norm(it.textContent);
				it.hidden = q ? text.indexOf(q) === -1 : false;
			}
			for (var g = 0; g < groups.length; g++) {
				var visible = groups[g].querySelectorAll('[data-faq="1"]:not([hidden])').length;
				groups[g].hidden = q ? visible === 0 : false;
			}
		};
		if (input) { input.addEventListener('input', run); }
	})();
</script>
