	<script is:inline>
		const pillRow = document.querySelector('.pillRow');
		const personaBox = document.querySelector('.personaBox');

		if (pillRow && personaBox) {
			const pills = Array.from(pillRow.querySelectorAll('[data-persona]'));
			const panels = Array.from(personaBox.querySelectorAll('[data-persona-panel]'));

			const normalizePersona = (value) => {
				if (value === 'public' || value === 'portal' || value === 'public-portal') return 'public';
				if (value === 'developers' || value === 'developer') return 'developers';
				if (value === 'services' || value === 'service') return 'services';
				if (value === 'agents' || value === 'freelancer' || value === 'agency') return 'agents';
				return '';
			};

			const setPersona = (value, mode) => {
				const persona = normalizePersona(value) || 'agents';

				for (const pill of pills) {
					const isActive = pill.getAttribute('data-persona') === persona;
					pill.classList.toggle('isActive', isActive);
					pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
				}

				for (const panel of panels) {
					const isActive = panel.getAttribute('data-persona-panel') === persona;
					panel.classList.toggle('isActive', isActive);
				}

				const url = new URL(window.location.href);
				url.searchParams.set('persona', persona);
				if (mode === 'push') window.history.pushState(null, '', url.toString());
				else window.history.replaceState(null, '', url.toString());
			};

			const initialFromUrl = normalizePersona(new URL(window.location.href).searchParams.get('persona') || '');
			const activePill = pillRow.querySelector('.pill.isActive') || pillRow.querySelector('[data-persona]');
			const initialFromDom = normalizePersona(activePill ? activePill.getAttribute('data-persona') || '' : '');
			setPersona(initialFromUrl || initialFromDom, 'replace');

			for (const pill of pills) {
				pill.addEventListener('click', (e) => {
					e.preventDefault();
					setPersona(pill.getAttribute('data-persona') || '', 'push');
				});
			}

			window.addEventListener('popstate', () => {
				setPersona(new URL(window.location.href).searchParams.get('persona') || '', 'replace');
			});
		}
	</script>
</Layout>

