---
import { statPlus } from '../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'en');
const plAgencies = statPlus(__ps.agencies, 'en');
const plListings = statPlus(__ps.listings, 'en');
import Layout from '../layouts/Layout.astro';
import background from '../assets/background.svg';
import { getPortalStats } from '../lib/portalStats';

const stats = await getPortalStats();
const nf = new Intl.NumberFormat('en-GB');

const personaParam = Astro.url.searchParams.get('persona') || '';

const persona = (() => {
	if (personaParam === 'public' || personaParam === 'portal' || personaParam === 'public-portal') return 'public';
	if (personaParam === 'developers' || personaParam === 'developer') return 'developers';
	if (personaParam === 'services' || personaParam === 'service') return 'services';
	if (personaParam === 'agents' || personaParam === 'freelancer' || personaParam === 'agency') return 'agents';
	return 'agents';
})();

const hrefForPersona = (nextPersona: string) => {
	const params = new URLSearchParams();
	params.set('persona', nextPersona);
	return `/?${params.toString()}`;
};

const softwareAppLd = {
 "@context": "https://schema.org",
 "@type": "SoftwareApplication",
 "name": "PropertyList",
 "applicationCategory": "BusinessApplication",
 "applicationSubCategory": "Estate agency CRM, agent-to-agent MLS and property portal",
 "operatingSystem": "Web browser, Android",
 "url": "https://propertylist.es/",
 "sameAs": [
  "https://agents.propertylist.es/",
  "https://info.propertylist.es/"
 ],
 "inLanguage": [
  "en",
  "es"
 ],
 "areaServed": {
  "@type": "Country",
  "name": "Spain"
 },
 "provider": {
  "@type": "Organization",
  "name": "PropertyList"
 },
 "description": `Estate agency system for Spain combining a CRM, an agent-to-agent MLS shared by ${plAgents} agents across ${plAgencies} agencies, and a public property portal. Listings, the CRM and the Lead, Seller and Property pipelines are free with no limit. A buyer lead costs 1 credit, and only when the agent chooses to move it into the Buyer pipeline. Automation, rentals and the website builder are monthly credit subscriptions from one prepaid balance.`,
 "featureList": [
  "Six CRM pipelines: Leads, Buyers, Sellers, Property, Tenants, Nurture",
  `Agent-to-agent MLS with co-broking across ${plAgencies} agencies`,
  "Public property portal listing and direct buyer enquiries",
  "AI Property Match: plain-language search across own stock and the whole MLS",
  "Automated lead acknowledgement and a day 0, 1, 3, 7 follow-up cadence",
  "Nurture: automated past-client follow-up with intent detection",
  "Rentals Module: tenancies, renewals, annual rent review, deposit compliance, maintenance",
  "Free branded MicroSite for every agency",
  "AI website builder with automated SEO content",
  "Notary-verified register prices and per-property CMA reports",
  "XML feed import and export",
  "Android app",
  "MCP server for AI-native property queries"
 ],
 "offers": [
  {
   "@type": "Offer",
   "name": "Free plan",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "MLS and CRM, unlimited listings, unlimited staff accounts, the Lead, Seller and Property pipelines, a branded MicroSite and XML push to other portals. No card, no time limit."
  },
  {
   "@type": "Offer",
   "name": "Portal direct lead",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "Enquiries from the public property portal are free to open, taking no credits. Free for a limited time; expected to move to a pay-per-lead model in future, with notice."
  },
  {
   "@type": "Offer",
   "name": "Buyer lead",
   "price": "1",
   "priceCurrency": "EUR",
   "description": "Costs 1 credit, charged only when the agent chooses to move a qualified contact into the Buyer pipeline, and the first 5 are free. Everything up to that point is free and declining costs nothing. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  },
  {
   "@type": "Offer",
   "name": "Automation and Nurture",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "20",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "20 credits a month from the same prepaid credit balance as everything else. Includes the Nurture pipeline, all automated emails, Hot-lead detection and the Daily Action Queue. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  },
  {
   "@type": "Offer",
   "name": "Rentals Module",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits per 30-day period, taken from your prepaid credit balance, bought in advance at 1.00 EUR per credit and less in larger packs. Free 30-day trial with no charge until you renew. Includes the Tenants pipeline, Tenancies, Maintenance and renewal email reminders."
  },
  {
   "@type": "Offer",
   "name": "Website Builder",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits a month. Add-ons are separate monthly credit costs, for example pop-up lead capture at 8 and auto meta descriptions at 5. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  }
 ],
 "paymentAccepted": "Credits from a single prepaid balance",
 "termsOfService": "https://info.propertylist.es/docs/propertylist-mls-user-manual/credits/how-billing-works/"
};

---

<Layout
	schema={softwareAppLd}
	lang="en"
	title="PropertyList - Free MLS, CRM & Property Portal for Spain"
	description="PropertyList is Europe's free Smart MLS, CRM & Property Portal. The MLS and CRM core are free forever for agents and developers. No setup fees, no lock-ins."
	canonical="https://info.propertylist.es/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/' },
	]}
>
	<section class="hero">
		<div class="heroBg" aria-hidden="true">
			<img src={background.src} alt="" width="1600" height="900" fetchpriority="high" />
		</div>
		<div class="heroInner">
			<a class="btnSecondary topCta" href="/docs/">How to use PropertyList</a>
			<div class="heroCopy">
				<div class="heroEyebrow">Free forever property sharing for estate agents and developers</div>
				<h1>List once. Let {plAgents} agents sell it.</h1>
				<p class="lead">
					PropertyList is Spain's free Smart MLS, CRM and property portal. List a property once and it reaches {plAgents}
					registered agents and thousands of buyers - no setup fees, no monthly rent, no lock-ins. Add AI and marketing
					power only when a specific deal calls for it.
				</p>
				<div class="heroCtas">
					<a class="btnPrimary heroCtaPrimary" href="https://agents.propertylist.es/new_agency/new?locale=en" target="_blank" rel="noopener">Create your free account</a>
					<a class="btnSecondary" href="https://propertylist.es/en" target="_blank" rel="noopener">Browse the property portal</a>
				</div>

				<div class="metaRow">
					<div class="metaItem">
						<div class="metaKpi">{nf.format(stats.listings)}</div>
						<div class="metaLabel">Active Listings</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">{nf.format(stats.agencies)}</div>
						<div class="metaLabel">Agencies</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Multi-Language</div>
						<div class="metaLabel">Platform</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">AI Tools</div>
						<div class="metaLabel">Upgrades</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Automation</div>
						<div class="metaLabel">Workflows</div>
					</div>
				</div>

				<div class="pillRow" role="tablist" aria-label="Audience">
					<a
						class={`pill ${persona === 'agents' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'agents' ? 'true' : 'false'}
						data-persona="agents"
						href={hrefForPersona('agents')}
					>
						Estate Agents
					</a>
					<a
						class={`pill ${persona === 'developers' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'developers' ? 'true' : 'false'}
						data-persona="developers"
						href={hrefForPersona('developers')}
					>
						Developers
					</a>
					<a
						class={`pill ${persona === 'services' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'services' ? 'true' : 'false'}
						data-persona="services"
						href={hrefForPersona('services')}
					>
						Property Services
					</a>
					<a
						class={`pill ${persona === 'public' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'public' ? 'true' : 'false'}
						data-persona="public"
						href={hrefForPersona('public')}
					>
						Buyers &amp; Renters
					</a>
				</div>

				<div class="personaBox" aria-label="By audience">
					<div class={`personaPanel ${persona === 'agents' ? 'isActive' : ''}`} data-persona-panel="agents">
							<div class="personaTitle">For Estate Agents</div>
						<div class="personaSummary">
								Stop paying monthly rent just to host your own listings. List them free on PropertyList, and {plAgents} registered agents can sell them for you - you set the commission and keep control.<br /><br />Match your buyers instantly against thousands of shared listings across the network. The MLS and CRM stay free forever - no setup fees, no lock-ins.<br /><br />Only pay when you want an edge on a specific deal, like an AI CMA to price it. No fixed overheads, ever.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://agents.propertylist.es/new_agency/new?locale=en" target="_blank" rel="noopener">Create your free account</a></div>
						<div class="personaLinks">
							<a href="/docs/propertylist-mls-user-manual/">MLS &amp; CRM User Guide</a>
							<a href="/docs/laws-procedures/">Laws &amp; Procedures</a>
							<a href="/neighbourhood/">Area Guides</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'developers' ? 'isActive' : ''}`} data-persona-panel="developers">
							<div class="personaTitle">For Developers</div>
						<div class="personaSummary">
								Put your whole development in front of {plAgents} registered agents the day you list it - for free. Your portfolio becomes shared inventory across the network, so a real sales force is selling your units, not just an advert parked on a portal.<br /><br />You only pay the commission you set, and only when an agent actually brings a buyer. Every euro is tied to a confirmed sale - no upfront ad spend, no wasted budget.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://agents.propertylist.es/new_agency/new?locale=en" target="_blank" rel="noopener">Create your free account</a></div>
						<div class="personaLinks">
							<a href="/developers/#get-updates">How it works?</a>
							<a href="/docs/developers/">Developers Docs</a>
							<a href="/neighbourhood/">Area Guides</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'services' ? 'isActive' : ''}`} data-persona-panel="services">
							<div class="personaTitle">For Property Services</div>
						<div class="personaSummary">
								Reach agents and buyers at the exact moment they need you - not with a generic directory ad, but inside the deal itself. Your service shows up in the workflow when a transaction calls for it.<br /><br />Coming soon: our AI will do the introducing, putting your profile in front of the right people the moment a transaction calls for your trade. You will only pay for qualified connections tied to a real property deal.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="/property-services/">Register your interest</a></div>
						<div class="personaLinks">
							<a href="/property-services/">Property Services</a>
							<a href="/neighbourhood/">Area Guides</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'public' ? 'isActive' : ''}`} data-persona-panel="public">
							<div class="personaTitle">For Buyers &amp; Renters</div>
						<div class="personaSummary">
								See the whole market, in real time. Every property appears once - no duplicate listings, no wading through the same home from a dozen different agents. Browse sales, long-term rentals, holiday homes and new developments with no paywalls and no games - and we never sell your data.<br /><br />Want a professional edge? Generate an AI market-analysis (CMA) report in seconds - the same intelligence the region's top agents use, priced on real, notary-verified data.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://propertylist.es/en" target="_blank" rel="noopener">Browse the property portal</a></div>
						<div class="personaLinks">
							<a href="/docs/public-portal/">Public Property Portal</a>
							<a href="/docs/laws-procedures/">Laws &amp; Procedures</a>
							<a href="/neighbourhood/">Area Guides</a>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2 class="offerTitle">What we offer</h2>
		</div>
		<p class="sectionLead">
Keep the engine running for free - forever. PropertyList gives you a fully functional MLS + CRM at no cost, so you
			can list properties, manage leads, coordinate with your team, and close deals without another monthly bill.
		</p>
		<p class="sectionLead">
When you want to move faster, stand out, or build your own agency website - tap optional power tools. Use them only when they actually help you: automated workflows that save hours, marketing boosts that win instructions, and analytics that help you price and pitch with confidence.
		</p>

		<div class="wbHeroCard">
			<div class="wbHeroInner">
				<div class="wbHeroText">
					<div class="wbBadge">Six pipelines - three of them free</div>
					<h3 class="wbHeadline">Most lost deals were never lost.<br />They were never followed up.</h3>
					<p class="wbSub">
						Leads, Sellers and Property run free with no limit. A lead is answered the moment it lands, a follow-up plan is
						written for you, and a listing that goes quiet raises its own price-review task.<br />
						Everything up to qualifying a buyer is free. You decide which ones are worth the credits, and saying no costs you
						nothing.<br />
						Past clients keep themselves warm in <a href="/docs/propertylist-mls-user-manual/pipeline-and-tasks/nurture/" style="color:inherit;text-decoration:underline;font-weight:600">Nurture</a>,
						and you get handed the one who just showed interest.
					</p>
					<a href="/pipelines/" class="wbCta">See the six pipelines &rarr;</a>
				</div>
			</div>
		</div>

		<div class="wbHeroCard">
			<div class="wbHeroInner">
				<div class="wbHeroText">
					<div class="wbBadge">Website Builder - 50 credits/month</div>
					<h3 class="wbHeadline">Your agency website.<br />Built and written by AI.</h3>
					<p class="wbSub">
						Describe what you want in plain words and the AI builds the pages and writes the copy - your listings, your
						brand, no developer needed.<br />
						Fine-tune it with drag-and-drop, preview it like a client for free, only pay and publish when you're happy.<br />
						And it keeps working: <a href="/instant-content/" style="color:inherit;text-decoration:underline;font-weight:600">Instant Content</a> writes ongoing SEO blogs and area guides from your own listings and notary-verified prices - so you rank without writing a word.
					</p>
					<a href="/website-builder/" class="wbCta">See how it works &rarr;</a>
				</div>
				<div class="wbHeroImage">
					<img
						src="/email-images/originals/email-mock-website-builder.png"
						alt="PropertyList Website Builder preview"
						width="520"
						loading="lazy"
					/>
				</div>
			</div>
		</div>

		<div class="aiHeroCard">
			<div class="aiHeroInner">
				<div class="aiHeroText">
					<div class="aiBadge">Free - AI shortcuts</div>
					<h3 class="aiHeadline">Skip the forms.<br />Just talk, or type.</h3>
					<p class="aiSub">
						<strong>List by voice:</strong> add photos and record a quick voice note - PropertyList fills in the type, size,
						features and description for you to review and publish.<br />
						<strong>Search by texting:</strong> describe what a client wants in plain words and get matching properties back,
						across the MLS and the portal.
					</p>
					<div class="aiCtaRow">
						<a href="/instant-listing/" class="aiCta">Try Instant Listing &rarr;</a>
						<a href="https://propertylist.es/en" target="_blank" rel="noopener" class="aiCtaGhost">Search the portal &rarr;</a>
						<a href="/ai-property-search/" class="aiCtaGhost">How AI search works &rarr;</a>
					</div>
				</div>
				<div class="aiHeroDemo" aria-hidden="true">
					<div class="aiMock">
						<div class="aiMockTitle">&#127908; List by voice</div>
						<div class="aiMockQuote">"Three-bed villa, Nueva Andalucia, private pool, sea views..."</div>
						<div class="aiMockChips"><span>3 bed</span><span>Pool</span><span>Sea view</span></div>
					</div>
					<div class="aiMock">
						<div class="aiMockTitle">&#128172; Search by texting</div>
						<div class="aiMockQuote">"3-bed villa near the beach, under &euro;500k"</div>
						<div class="aiMockChips"><span>4 matches</span><span>Marbella</span><span>&euro;480,000</span></div>
					</div>
				</div>
			</div>
		</div>

		<div class="instantSuite">
			<div class="instantSuiteHead">
				<div class="instantBadge">The Instant suite</div>
				<h3 class="instantHeadline">One click. Studio-quality marketing.</h3>
				<p class="instantSub">A growing set of AI tools that turn a listing into brochures, videos, renders and content - built from your own photos and real data, never invented. New ones arrive often.</p>
			</div>
			<div class="instantGrid">
				<a class="instantTile" href="/instant-listing/">
					<span class="itTop"><span class="itIcon">&#127908;</span><span class="itTag isLive">Live</span></span>
					<span class="itName">Instant Listing</span>
					<span class="itDesc">Photos plus a voice note become a complete, ready-to-publish listing.</span>
				</a>
				<a class="instantTile" href="/instant-content/">
					<span class="itTop"><span class="itIcon">&#9997;&#65039;</span><span class="itTag isLive">Live</span></span>
					<span class="itName">Instant Content</span>
					<span class="itDesc">SEO blog posts and area guides written from your own listings.</span>
				</a>
				<a class="instantTile" href="/instant-brochure/">
					<span class="itTop"><span class="itIcon">&#128196;</span><span class="itTag isSoon">Coming soon</span></span>
					<span class="itName">Instant Brochure</span>
					<span class="itDesc">A print-ready PDF and a live web page for any property, in one click.</span>
				</a>
				<a class="instantTile" href="/instant-renovation/">
					<span class="itTop"><span class="itIcon">&#128736;&#65039;</span><span class="itTag isSoon">Coming soon</span></span>
					<span class="itName">Instant Renovation</span>
					<span class="itDesc">AI before-and-after renders with local, itemised cost estimates.</span>
				</a>
				<a class="instantTile" href="/instant-video/">
					<span class="itTop"><span class="itIcon">&#127916;</span><span class="itTag isSoon">Coming soon</span></span>
					<span class="itName">Instant Video</span>
					<span class="itDesc">Branded listing, area and market videos in full HD.</span>
				</a>
				<a class="instantTile" href="/instant-images/">
					<span class="itTop"><span class="itIcon">&#128247;</span><span class="itTag isSoon">Coming soon</span></span>
					<span class="itName">Instant Images</span>
					<span class="itDesc">Twilight, sky-swap, virtual staging and branded social cards.</span>
				</a>
			</div>
		</div>

		<div style="display:flex;flex-wrap:wrap;gap:16px;">
			<div class="tile pricingTile" style="flex:1;min-width:300px;">
				<div class="pricingHeader">
					<h2 class="pricingTitle">Free, with no limit</h2>
					<div class="pricingBadge isFree">Free</div>
				</div>
				<ul style="list-style:none;margin:0;padding:0;">
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>The shared MLS: list once and every agent on the network can sell it with you</li>
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>The CRM: unlimited contacts and staff, plus the Lead, Seller and Property pipelines</li>
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>Your branded MicroSite, hosted, with its enquiries free forever</li>
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>Instant Listing: photos and a voice note become a finished listing</li>
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>AI Property Match, free in beta</li>
					<li style="position:relative;padding:6px 0 6px 26px;color:rgba(16,24,40,0.78);line-height:1.5;"><span style="position:absolute;left:0;color:#0a6d61;font-weight:900;">&#10003;</span>Your listings on the propertylist.es portal, with no listing fees</li>
				</ul>
			</div>
			<div class="tile mutedTile pricingTile" style="flex:1;min-width:300px;">
				<div class="pricingHeader">
					<h2 class="pricingTitle">Paid, in one sentence</h2>
				</div>
				<p style="margin:0;color:rgba(16,24,40,0.78);line-height:1.65;">You pay for demand, never for supply: 1 credit when you choose to move a qualified buyer lead into the Buyer pipeline, with your first 5 free. Optional modules when you want them: <a href="/rentals/">Rentals</a> (50 credits / 30 days, free 30-day trial), <a href="/nurture/">Automation &amp; Nurture</a> (20 credits/mo) and the <a href="/website-builder/">Website Builder</a> (50 credits/mo, free until you publish).</p>
				<div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;">
					<a href="/features/" style="background:#00ae9a;color:#00100e;border-radius:999px;padding:11px 18px;font-weight:800;text-decoration:none;font-size:14.5px;">See all features &rarr;</a>
					<a href="/free/" style="border:1px solid rgba(16,24,40,0.18);border-radius:999px;padding:11px 18px;font-weight:800;text-decoration:none;font-size:14.5px;color:rgba(16,24,40,0.85);">Everything that's free</a>
					<a href="/pricing/" style="border:1px solid rgba(16,24,40,0.18);border-radius:999px;padding:11px 18px;font-weight:800;text-decoration:none;font-size:14.5px;color:rgba(16,24,40,0.85);">Pricing</a>
				</div>
			</div>
		</div>
	</section>

	<section aria-label="Quick answers" style="max-width:1120px;margin:36px auto 0;padding:0 20px;">
		<h2 style="margin:0 0 6px;letter-spacing:-0.02em;">Quick answers</h2>
		<p style="margin:0 0 14px;color:rgba(16,24,40,0.65);font-size:14.5px;">The questions agents ask before signing up. The full list lives on the <a href="/faq/">FAQ</a> and <a href="/features/">features</a> pages.</p>
		<div style="display:grid;gap:10px;">
			<details style="background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:14px 18px;">
