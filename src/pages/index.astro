---
import Layout from '../layouts/Layout.astro';
import background from '../assets/background.svg';
import { getPortalStats } from '../lib/portalStats';

const stats = await getPortalStats();
const nf = new Intl.NumberFormat('en-GB');

const personaParam = Astro.url.searchParams.get('persona') || '';

const persona = (() => {
	if (personaParam === 'public' || personaParam === 'portal' || personaParam === 'public-portal') return 'public';
	if (personaParam === 'developers' || personaParam === 'developer') return 'developers';
	if (personaParam === 'services' || personaParam === 'service') return 'services';
	if (personaParam === 'agents' || personaParam === 'freelancer' || personaParam === 'agency') return 'agents';
	return 'agents';
})();

const hrefForPersona = (nextPersona: string) => {
	const params = new URLSearchParams();
	params.set('persona', nextPersona);
	return `/?${params.toString()}`;
};
---

<Layout
	lang="en"
	title="PropertyList - Free MLS, CRM & Property Portal for Spain"
	description="PropertyList is Europe's free Smart MLS, CRM & Property Portal. The MLS and CRM are 100% free forever for estate agents and developers. No hidden fees, no setup fees, no lock-ins."
	canonical="https://info.propertylist.es/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/' },
	]}
>
	<section class="hero">
		<div class="heroBg" aria-hidden="true">
			<img src={background.src} alt="" width="1600" height="900" fetchpriority="high" />
		</div>
		<div class="heroInner">
			<a class="btnSecondary topCta" href="/docs/">How to use PropertyList</a>
			<div class="heroCopy">
				<div class="heroEyebrow">Free forever for estate agents and developers</div>
				<h1>List once. Let 1,200 agents sell it.</h1>
				<p class="lead">
					PropertyList is Spain's free Smart MLS, CRM and property portal. List a property once and it reaches 1,200+
					verified agents and thousands of buyers - no setup fees, no monthly rent, no lock-ins. Add AI and marketing
					power only when a specific deal calls for it.
				</p>
				<div class="heroCtas">
					<a class="btnPrimary heroCtaPrimary" href="https://agents.propertylist.es/new-agent-signup/new" target="_blank" rel="noopener">Create your free account</a>
					<a class="btnSecondary" href="https://propertylist.es/" target="_blank" rel="noopener">Browse the property portal</a>
				</div>

				<div class="metaRow">
					<div class="metaItem">
						<div class="metaKpi">{nf.format(stats.listings)}</div>
						<div class="metaLabel">Active Listings</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">{nf.format(stats.agencies)}</div>
						<div class="metaLabel">Agencies</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Multi-Language</div>
						<div class="metaLabel">Platform</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">AI Tools</div>
						<div class="metaLabel">Upgrades</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Automation</div>
						<div class="metaLabel">Workflows</div>
					</div>
				</div>

				<div class="pillRow" role="tablist" aria-label="Audience">
					<a
						class={`pill ${persona === 'agents' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'agents' ? 'true' : 'false'}
						data-persona="agents"
						href={hrefForPersona('agents')}
					>
						Estate Agents
					</a>
					<a
						class={`pill ${persona === 'developers' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'developers' ? 'true' : 'false'}
						data-persona="developers"
						href={hrefForPersona('developers')}
					>
						Developers
					</a>
					<a
						class={`pill ${persona === 'services' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'services' ? 'true' : 'false'}
						data-persona="services"
						href={hrefForPersona('services')}
					>
						Property Services
					</a>
					<a
						class={`pill ${persona === 'public' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'public' ? 'true' : 'false'}
						data-persona="public"
						href={hrefForPersona('public')}
					>
						Buyers &amp; Renters
					</a>
				</div>

				<div class="personaBox" aria-label="By audience">
					<div class={`personaPanel ${persona === 'agents' ? 'isActive' : ''}`} data-persona-panel="agents">
							<div class="personaTitle">For Estate Agents</div>
						<div class="personaSummary">
								Stop paying monthly rent just to host your own listings. List them free on PropertyList, and 1,200+ verified agents can sell them for you - you set the commission and keep control.<br /><br />Match your buyers instantly against thousands of shared listings across the network. The MLS and CRM stay free forever - no setup fees, no lock-ins.<br /><br />Only pay when you want an edge on a specific deal: an AI CMA to price it, or the Gemini-powered Renovation Agent to unblock it. No fixed overheads, ever.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://agents.propertylist.es/new-agent-signup/new" target="_blank" rel="noopener">Create your free account</a></div>
						<div class="personaLinks">
							<a href="/docs/propertylist-mls-user-manual/">MLS &amp; CRM User Guide</a>
							<a href="/docs/laws-procedures/">Laws &amp; Procedures</a>
							<a href="/neighbourhood/">Area Guides</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'developers' ? 'isActive' : ''}`} data-persona-panel="developers">
							<div class="personaTitle">For Developers</div>
						<div class="personaSummary">
								Put your whole development in front of 1,200+ verified agents the day you list it - for free. Your portfolio becomes shared inventory across the network, so a real sales force is selling your units, not just an advert parked on a portal.<br /><br />You only pay the commission you set, and only when an agent actually brings a buyer. Every euro is tied to a confirmed sale - no upfront ad spend, no wasted budget.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://agents.propertylist.es/new-agent-signup/new" target="_blank" rel="noopener">Create your free account</a></div>
						<div class="personaLinks">
							<a href="https://info.propertylist.es/developers#get-updates">How it works?</a>
							<a href="/docs/developers/">Developers Docs</a>
							<a href="/neighbourhood/">Area Guides</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'services' ? 'isActive' : ''}`} data-persona-panel="services">
							<div class="personaTitle">For Property Services</div>
						<div class="personaSummary">
								Reach agents and buyers at the exact moment they need you - not with a generic directory ad, but inside the deal itself. Your service shows up in the workflow when a transaction calls for it.<br /><br />Our AI does the introducing: the Renovation Agent, for example, prices a project on the spot and puts your profile in front of the right people. You only pay for qualified connections tied to a real property deal.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://agents.propertylist.es/new-agent-signup/new" target="_blank" rel="noopener">Create your free account</a></div>
						<div class="personaLinks">
							<a href="/docs/property-services/">Property Service Docs</a>
							<a href="/neighbourhood/">Area Guides</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'public' ? 'isActive' : ''}`} data-persona-panel="public">
							<div class="personaTitle">For Buyers &amp; Renters</div>
						<div class="personaSummary">
								See the whole market, in real time. Every property appears once - no duplicate listings, no wading through the same home from a dozen different agents. Browse sales, long-term rentals, holiday homes and new developments with no paywalls and no games - and we never sell your data.<br /><br />Want a professional edge? Generate an AI market-analysis (CMA) report in seconds - the same intelligence the region's top agents use, priced on real, notary-verified data.
						</div>
						<div class="personaCta"><a class="btnPrimary" href="https://propertylist.es/" target="_blank" rel="noopener">Browse the property portal</a></div>
						<div class="personaLinks">
							<a href="/docs/public-portal/">Public Property Portal</a>
							<a href="/docs/laws-procedures/">Laws &amp; Procedures</a>
							<a href="/neighbourhood/">Area Guides</a>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2 class="offerTitle">What we offer</h2>
		</div>
		<p class="sectionLead">
Keep the engine running for free - forever. PropertyList gives you a fully functional MLS + CRM at no cost, so you
			can list properties, manage leads, coordinate with your team, and close deals without another monthly bill.
		</p>
		<p class="sectionLead">
When you want to move faster, stand out, or build your own agency website - tap optional power tools. Use them only when they actually help you: automated workflows that save hours, marketing boosts that win instructions, and analytics that help you price and pitch with confidence.
		</p>

		<div class="wbHeroCard">
			<div class="wbHeroInner">
				<div class="wbHeroText">
					<div class="wbBadge">Website Builder - from €50/month</div>
					<h3 class="wbHeadline">Your agency website.<br />Built and written by AI.</h3>
					<p class="wbSub">
						Describe what you want in plain words and the AI builds the pages and writes the copy - your listings, your
						brand, no developer needed.<br />
						Fine-tune it with drag-and-drop, preview it like a client for free, only pay and publish when you're happy.<br />
						And it keeps working: <a href="/instant-content" style="color:inherit;text-decoration:underline;font-weight:600">Instant Content</a> writes ongoing SEO blogs and area guides from your own listings and notary-verified prices - so you rank without writing a word.
					</p>
					<a href="/website-builder" class="wbCta">See how it works &rarr;</a>
				</div>
