---
import { statPlus } from '../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'en');
const plAgencies = statPlus(__ps.agencies, 'en');
const plListings = statPlus(__ps.listings, 'en');
import Layout from '../layouts/Layout.astro';
import CommunityProof from '../components/CommunityProof.astro';
import ReviewQuotes from '../components/ReviewQuotes.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeSteps from '../components/HomeSteps.astro';
import HomeFree from '../components/HomeFree.astro';
import HomeTools from '../components/HomeTools.astro';
import background from '../assets/background.svg';
import { getPortalStats } from '../lib/portalStats';

const stats = await getPortalStats();
const nf = new Intl.NumberFormat('en-GB');

const personaParam = Astro.url.searchParams.get('persona') || '';

const persona = (() => {
	if (personaParam === 'public' || personaParam === 'portal' || personaParam === 'public-portal') return 'public';
	if (personaParam === 'developers' || personaParam === 'developer') return 'developers';
	if (personaParam === 'services' || personaParam === 'service') return 'services';
	if (personaParam === 'agents' || personaParam === 'freelancer' || personaParam === 'agency') return 'agents';
	return 'agents';
})();

const hrefForPersona = (nextPersona: string) => {
	const params = new URLSearchParams();
	params.set('persona', nextPersona);
	return `/?${params.toString()}`;
};

const softwareAppLd = {
 "@context": "https://schema.org",
 "@type": "SoftwareApplication",
 "name": "PropertyList",
 "applicationCategory": "BusinessApplication",
 "applicationSubCategory": "Estate agency CRM, agent-to-agent MLS and property portal",
 "operatingSystem": "Web browser, Android",
 "url": "https://propertylist.es/",
 "sameAs": [
  "https://agents.propertylist.es/",
  "https://info.propertylist.es/"
 ],
 "inLanguage": [
  "en",
  "es"
 ],
 "areaServed": {
  "@type": "Country",
  "name": "Spain"
 },
 "provider": {
  "@type": "Organization",
  "name": "PropertyList"
 },
 "description": `Estate agency system for Spain combining a CRM, an agent-to-agent MLS shared by ${plAgents} agents across ${plAgencies} agencies, and a public property portal. Listings, the CRM and the Lead, Seller and Property pipelines are free with no limit. A buyer lead costs 1 credit, and only when the agent chooses to move it into the Buyer pipeline. Automation and Nurture is free. Rentals and the website builder are monthly credit subscriptions from one prepaid balance.`,
 "featureList": [
  "Six CRM pipelines: Leads, Buyers, Sellers, Property, Tenants, Nurture",
  `Agent-to-agent MLS with co-broking across ${plAgencies} agencies`,
  "Public property portal listing and direct buyer enquiries",
  "AI Property Match: plain-language search across own stock and the whole MLS",
  "Automated lead acknowledgement and a day 0, 1, 3, 7 follow-up cadence",
  "Nurture: automated past-client follow-up with intent detection",
  "Rentals Module: tenancies, renewals, annual rent review, deposit compliance, maintenance",
  "Free branded MicroSite for every agency",
  "AI website builder with automated SEO content",
  "Notary-verified register prices and per-property CMA reports",
  "XML feed import and export",
  "Android app",
  "MCP server for AI-native property queries"
 ],
 "offers": [
  {
   "@type": "Offer",
   "name": "Free plan",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "MLS and CRM, unlimited listings, unlimited staff accounts, the Lead, Seller and Property pipelines, a branded MicroSite and XML push to other portals. No card, no time limit."
  },
  {
   "@type": "Offer",
   "name": "Portal direct lead",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "Enquiries from the public property portal are free to open, taking no credits. Free for a limited time; expected to move to a pay-per-lead model in future, with notice."
  },
  {
   "@type": "Offer",
   "name": "Buyer lead",
   "price": "1",
   "priceCurrency": "EUR",
   "description": "Costs 1 credit, charged only when the agent chooses to move a qualified contact into the Buyer pipeline, and the first 5 are free. Everything up to that point is free and declining costs nothing. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  },
  {
   "@type": "Offer",
   "name": "Automation and Nurture",
   "price": "0",
   "priceCurrency": "EUR",
   "description": "Free. Includes the Nurture pipeline, all automated emails, Hot-lead detection and the Daily Action Queue."
  },
  {
   "@type": "Offer",
   "name": "Rentals Module",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits per 30-day period, taken from your prepaid credit balance, bought in advance at 1.00 EUR per credit and less in larger packs. Free 30-day trial with no charge until you renew. Includes the Tenants pipeline, Tenancies, Maintenance and renewal email reminders."
  },
  {
   "@type": "Offer",
   "name": "Website Builder",
   "priceCurrency": "EUR",
   "priceSpecification": {
    "@type": "UnitPriceSpecification",
    "price": "50",
    "priceCurrency": "EUR",
    "unitText": "MONTH"
   },
   "description": "50 credits a month. Add-ons are separate monthly credit costs, for example pop-up lead capture at 8 and auto meta descriptions at 5. Paid in credits from a prepaid balance, bought in advance at 1.00 EUR each and less in larger packs, so the euro figure shown is the maximum."
  }
 ],
 "paymentAccepted": "Credits from a single prepaid balance",
 "termsOfService": "https://info.propertylist.es/docs/propertylist-mls-user-manual/credits/how-billing-works/"
};

---

<Layout
	schema={softwareAppLd}
	lang="en"
	title="PropertyList - Free MLS, CRM & Property Portal for Spain"
	description={`PropertyList is the free MLS, CRM and property portal for estate agents in Spain. List a property once and ${plAgents} registered agents can sell it. No listing fees, no subscription.`}
	canonical="https://info.propertylist.es/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/' },
	]}
>
	<HomeHero lang="en" persona={persona} agents={plAgents} agencies={plAgencies} listings={plListings} />
	<ReviewQuotes lang="en" />
	<HomeSteps lang="en" />
	<HomeFree lang="en" />
	<HomeTools lang="en" />
	<CommunityProof lang="en" />

	<section aria-label="Quick answers" style="max-width:1120px;margin:36px auto 0;padding:0 20px;">
		<h2 style="margin:0 0 6px;letter-spacing:-0.02em;">Quick answers</h2>
		<p style="margin:0 0 14px;color:rgba(16,24,40,0.65);font-size:14.5px;">The questions agents ask before signing up. The full list lives on the <a href="/faq/">FAQ</a> and <a href="/features/">features</a> pages.</p>
		<div style="display:grid;gap:10px;">
			<details style="background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:14px 18px;">
				<summary style="cursor:pointer;font-weight:800;letter-spacing:-0.01em;color:#101828;">What is PropertyList?</summary>
				<p style="margin:10px 0 0;color:rgba(16,24,40,0.75);line-height:1.65;">One login for an estate agency in Spain: the shared MLS, the CRM, your listings on the public portal, your MicroSite and the AI tools, with notary-verified sale prices behind the numbers. The core is free; you pay in credits only for the tools you switch on.</p>
			</details>
			<details style="background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:14px 18px;">
				<summary style="cursor:pointer;font-weight:800;letter-spacing:-0.01em;color:#101828;">Is PropertyList really free?</summary>
				<p style="margin:10px 0 0;color:rgba(16,24,40,0.75);line-height:1.65;">The core is free with no limit: the MLS, unlimited listings, team accounts, your MicroSite and the Lead, Seller and Property pipelines. Moving a qualified buyer lead into the Buyer pipeline costs 1 credit, and your first 5 are free.</p>
			</details>
			<details style="background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:14px 18px;">
				<summary style="cursor:pointer;font-weight:800;letter-spacing:-0.01em;color:#101828;">Can I get free credits?</summary>
				<p style="margin:10px 0 0;color:rgba(16,24,40,0.75);line-height:1.65;">Yes. Refer an agency: you earn <a href="/referrals/">20 credits for every agency that signs up through your link and is approved</a>, with no cap, and the new agency starts with 10. On top of that, <a href="/verify-your-agency/">verifying your agency</a> (free, about two minutes) adds another 20 credits and puts the verified badge on your listings.</p>
			</details>
			<details style="background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:14px 18px;">
				<summary style="cursor:pointer;font-weight:800;letter-spacing:-0.01em;color:#101828;">Do I have to leave my current portal or CRM?</summary>
				<p style="margin:10px 0 0;color:rgba(16,24,40,0.75);line-height:1.65;">No. Import your existing XML feed free and run PropertyList alongside whatever you use today. Pushing your listings out to other portals is free too.</p>
			</details>
			<details style="background:#fff;border:1px solid rgba(16,24,40,0.1);border-radius:14px;padding:14px 18px;">
				<summary style="cursor:pointer;font-weight:800;letter-spacing:-0.01em;color:#101828;">How much admin time does it save?</summary>
				<p style="margin:10px 0 0;color:rgba(16,24,40,0.75);line-height:1.65;">Tick what you hate doing and drag the hours on the <a href="/hours/">hours page</a>. It totals the bill and shows the fix for every line.</p>
			</details>
		</div>
	</section>

	{persona === 'public' && (
	<section aria-label="What's on in Marbella" style="max-width:1120px;margin:36px auto 0;padding:0 20px;">
		<div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;border:1px solid rgba(234,88,12,0.3);background:linear-gradient(135deg,rgba(251,146,60,0.12),rgba(251,146,60,0.03));border-radius:16px;padding:18px 22px;">
			<div style="flex:none;width:44px;height:44px;border-radius:12px;background:rgba(251,146,60,0.18);display:grid;place-items:center;font-size:22px;" aria-hidden="true">&#127774;</div>
			<div style="min-width:0;flex:1 1 200px;">
				<strong style="display:block;font-size:16px;letter-spacing:-.01em;color:rgba(16,24,40,0.92);">Visiting the Costa del Sol? See what's on this week.</strong>
				<span style="display:block;font-size:14px;color:rgba(16,24,40,0.66);margin-top:3px;">Concerts, festivals, street markets and beach clubs in Marbella, Estepona and Malaga - updated every week. Build your own day plan and drop it straight into your calendar.</span>
			</div>
			<a href="/whats-on/" style="flex:none;white-space:nowrap;background:#ea580c;color:#fff;border-radius:999px;padding:12px 20px;font-weight:800;text-decoration:none;font-size:15px;">See what's on &rarr;</a>
		</div>
	</section>
	)}

	<section aria-label="Agent survey" data-band="agent-survey-band" style="max-width:1120px;margin:36px auto 0;padding:0 20px 56px;">
		<div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;border:1px solid rgba(0,174,154,0.28);background:rgba(0,174,154,0.05);border-radius:16px;padding:18px 22px;">
			<div style="min-width:0;flex:1 1 200px;max-width:640px;">
				<strong style="display:block;font-size:16px;letter-spacing:-.01em;color:rgba(16,24,40,0.92);">Are you an agent? Help shape what we build next.</strong>
				<span style="display:block;font-size:14px;color:rgba(16,24,40,0.66);margin-top:3px;">A 2-minute survey - tell us what you want from a property portal, and we'll add 10 credits to your account.</span>
			</div>
			<a href="/agents-survey/" style="flex:0 1 auto;max-width:100%;text-align:center;background:#00ae9a;color:#00100e;border-radius:999px;padding:12px 20px;font-weight:800;text-decoration:none;font-size:15px;">Take the 2-min survey &rarr;</a>
		</div>
	</section>

</Layout>

