---
import Layout from '../layouts/Layout.astro';
import background from '../assets/background.svg';

const personaParam = Astro.url.searchParams.get('persona') || '';

const persona = (() => {
	if (personaParam === 'public' || personaParam === 'portal' || personaParam === 'public-portal') return 'public';
	if (personaParam === 'developers' || personaParam === 'developer') return 'developers';
	if (personaParam === 'services' || personaParam === 'service') return 'services';
	if (personaParam === 'agents' || personaParam === 'freelancer' || personaParam === 'agency') return 'agents';
	return 'agents';
})();

const hrefForPersona = (nextPersona: string) => {
	const params = new URLSearchParams();
	params.set('persona', nextPersona);
	return `/?${params.toString()}`;
};
---

<Layout
	lang="en"
	title="PropertyList — Free MLS, CRM & Property Portal for Spain"
	description="Free Smart MLS & CRM for Spanish estate agents. No hidden fees, no setup costs, no lock-ins. Share listings directly with other agents, 100% free forever."
	canonical="https://info.propertylist.es/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/' },
	]}
	schema={{
		'@context': 'https://schema.org',
		'@type': 'RealEstateAgent',
		name: 'PropertyList',
		description: 'Free agent-to-agent MLS and CRM for Spain. 6,000+ active listings, 1,250+ agents.',
		url: 'https://propertylist.es/',
		logo: 'https://info.propertylist.es/og/logo-default.png',
		image: 'https://info.propertylist.es/og/logo-default.png',
		address: {
			'@type': 'PostalAddress',
			addressLocality: 'Marbella',
			addressRegion: 'Andalusia',
			addressCountry: 'ES',
		},
		areaServed: {
			'@type': 'Country',
			name: 'Spain',
		},
		contactPoint: {
			'@type': 'ContactPoint',
			telephone: '+34-610-95-11-77',
			contactType: 'customer service',
			availableLanguage: ['Spanish', 'English'],
		},
		sameAs: [
			'https://www.facebook.com/PropertyList.es',
			'https://www.instagram.com/propertylist_es/',
			'https://www.linkedin.com/company/11216131',
			'https://www.youtube.com/@PropertyList_es',
		],
	}}
