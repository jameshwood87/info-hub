---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/whats-on/estepona/`;
const title = "What's On in Estepona 2026: Events, Festivals & Things To Do | PropertyList";
const description =
	'A curated, always-current diary of events in Estepona - festivals, concerts, exhibitions, sport and family days out - from official sources, updated automatically.';

type Ev = {
	id: string; title: string; titleEn?: string; titleEs?: string; start: string; time?: string | null; end: string | null; town: string;
	venue: string | null; category: string; scope: 'local' | 'nearby';
	url: string | null; source: string; blurbEn: string; blurbEs: string;
};
let events: Ev[] = [];
let updated: string | null = null;
try {
	const store = JSON.parse(fs.readFileSync('/opt/info-hub/var/admin/events/estepona.json', 'utf8'));
	events = Array.isArray(store.events) ? store.events : [];
	updated = store.updated || null;
} catch {}

const todayIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(new Date()); // Spain time, not server UTC
events = events.filter((e) => String(e.end || e.start) >= todayIso);
const local = events.filter((e) => e.scope === 'local');
const nearby = events.filter((e) => e.scope === 'nearby');
const cats = [...new Set(local.map((e) => e.category))].sort();

const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' });
const dateLabel = (e: Ev) => {
	const s = new Date(e.start + 'T12:00:00Z');
	if (!e.end || e.end === e.start) return fmt.format(s);
	return `${fmt.format(s)} - ${fmt.format(new Date(e.end + 'T12:00:00Z'))}`;
};
const isOn = (e: Ev) => e.start <= todayIso && String(e.end || e.start) >= todayIso;
const CAT_LABEL: Record<string, string> = {
	music: 'Music', festival: 'Festivals', culture: 'Culture', sport: 'Sport',
	family: 'Family', food: 'Food & drink', market: 'Markets', nightlife: 'Nightlife', other: 'Other',
};

// time-window flags for the filters + soonest-first ordering
const msDay = 86400000;
const today = new Date(todayIso + 'T00:00:00Z');
const dow = today.getUTCDay();
const weekendStart = dow === 6 || dow === 0 ? today : new Date(today.getTime() + (((5 - dow + 7) % 7) * msDay));
const weekendEnd = new Date(weekendStart.getTime() + (((7 - weekendStart.getUTCDay()) % 7) * msDay));
const wkndStartIso = weekendStart.toISOString().slice(0, 10);
const wkndEndIso = weekendEnd.toISOString().slice(0, 10);
const monthEndIso = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() + 1, 0)).toISOString().slice(0, 10);
const endOf = (e: Ev) => String(e.end || e.start);
const inWeekend = (e: Ev) => e.start <= wkndEndIso && endOf(e) >= wkndStartIso;
const inMonth = (e: Ev) => e.start <= monthEndIso;
const durDays = (e: Ev) => Math.max(0, (new Date(endOf(e) + 'T00:00:00Z').getTime() - new Date(e.start + 'T00:00:00Z').getTime()) / msDay);
const sortKey = (e: Ev) => `${e.start > todayIso ? e.start : todayIso}|${String(Math.round(durDays(e))).padStart(4, '0')}`;
local.sort((a, b) => sortKey(a).localeCompare(sortKey(b)));
const catCount = new Map<string, number>();
for (const e of local) catCount.set(e.category, (catCount.get(e.category) || 0) + 1);
const countNow = local.filter(isOn).length;
const countWknd = local.filter(inWeekend).length;
const countMonth = local.filter(inMonth).length;

// editorial "don't miss" picks: soonest short big-name events (no long exhibitions)
const featured = local.filter((e) => durDays(e) <= 3 && (['starlite', 'marbella-arena'].includes(e.source) || ['festival', 'music'].includes(e.category))).slice(0, 4);

// time buckets: how trip-planners actually think (long-running stuff gets its own shelf)
const weekAheadIso = new Date(today.getTime() + 7 * msDay).toISOString().slice(0, 10);
const bucketOf = (e: Ev) => (isOn(e) ? (durDays(e) > 21 ? 'ongoing' : 'today') : e.start <= weekAheadIso ? 'week' : 'later');
const BUCKETS = [
	{ k: 'today', icon: '\u{1F525}', title: 'On today', sub: null as string | null },
	{ k: 'week', icon: '\u{1F4C5}', title: 'This week', sub: null },
	{ k: 'later', icon: '\u{1F52E}', title: 'Coming up', sub: null },
	{ k: 'ongoing', icon: '\u{1F3DB}\u{FE0F}', title: 'Ongoing exhibitions & seasons', sub: 'Running for weeks - drop in whenever suits you.' },
].map((b) => ({ ...b, list: local.filter((e) => bucketOf(e) === b.k) })).filter((b) => b.list.length);

const CAT_ICON: Record<string, string> = {
	music: '\u{1F3B5}', festival: '\u{1F3AA}', culture: '\u{1F3AD}', sport: '\u{1F3C3}',
	family: '\u{1F46A}', food: '\u{1F37D}\u{FE0F}', market: '\u{1F6CD}\u{FE0F}', nightlife: '\u{1F319}', other: '\u{2728}',
};

const eventsLd = local.slice(0, 25).map((e) => ({
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: e.titleEn || e.title,
	startDate: e.time ? `${e.start}T${e.time}:00` : e.start,
	...(e.end ? { endDate: e.end } : {}),
	eventStatus: 'https://schema.org/EventScheduled',
	location: { '@type': 'Place', name: e.venue || e.town, address: { '@type': 'PostalAddress', addressLocality: e.town, addressRegion: 'Malaga', addressCountry: 'ES' } },
	description: e.blurbEn,
	...(e.url ? { url: e.url } : {}),
}));
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Estepona area guide', item: `${origin}/neighbourhood/spain/malaga/estepona/` },
		{ '@type': 'ListItem', position: 3, name: "What's On in Estepona", item: canonical },
	],
};
const updatedFmt = updated ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(updated)) : null;
// how far ahead the diary currently reaches, e.g. "through November"
const lastIso = local.reduce((m, e) => (String(e.end || e.start) > m ? String(e.end || e.start) : m), todayIso);
const lastDate = new Date(lastIso + 'T12:00:00Z');
const horizon = new Intl.DateTimeFormat('en-GB', { month: 'long', ...(lastIso.slice(0, 4) !== todayIso.slice(0, 4) ? { year: 'numeric' } : {}) }).format(lastDate);

// minimal event data for the day-planner (localStorage + .ics + share link)
const planEvents = events.map((e) => ({
	id: e.id, t: e.titleEn || e.title, start: e.start, time: e.time || null, end: e.end, blurb: e.blurbEn,
	venue: e.venue, town: e.town, url: e.url,
}));

// weekly street markets - fixed recurring fixtures, verified 2026-07
const MARKETS = [
	{ id: 'mk-wednesday', dow: 3, dayName: 'Wednesday', day: 'Every Wednesday', name: 'Estepona street market', town: 'Estepona', place: 'Calle Eslovaquia, off Avenida Juan Carlos I', hours: '09:00 - 14:30', desc: 'The big weekly mercadillo - over 250 stalls of produce, fashion, ceramics and crafts.' },
	{ id: 'mk-sunday', dow: 0, dayName: 'Sunday', day: 'Every Sunday', name: 'Estepona port market', town: 'Estepona', place: 'Puerto Deportivo de Estepona', hours: '09:00 - 14:00', desc: 'Sunday marina market by the boats - antiques, art, crafts and jewellery.' },
];
const mapsQ = (m: { place: string; town: string }) =>
	'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`${m.place}, ${m.town}, Spain`);

// curated places - externally validated (Michelin 2026 for restaurants; clubs
// verified operating 2026-07). Seasonal - the planner shows a check-first note.
type Place = { id: string; cat: string; name: string; town: string; area: string; desc: string; url?: string };
const PLACES: Place[] = [
	{ id: 'pl-larada', cat: 'Beach', name: 'Playa de la Rada', town: 'Estepona', area: 'Town centre promenade', desc: 'The main town beach - 2.6 km of golden sand along the palm-lined Paseo Marítimo.' },
	{ id: 'pl-cristo', cat: 'Beach', name: 'Playa del Cristo', town: 'Estepona', area: 'West of the port', desc: 'A sheltered horseshoe cove with calm, shallow water - the local sunset favourite.' },
	{ id: 'pl-padron', cat: 'Beach', name: 'Playa del Padrón', town: 'Estepona', area: 'Estepona east', desc: 'Quieter sand east of town with a boho edge - home to Beso Beach.' },
	{ id: 'pl-saladillo', cat: 'Beach', name: 'Playa del Saladillo', town: 'Estepona', area: 'New Golden Mile', desc: 'Long, low-key beach on the eastern side of the municipality - space to breathe even in August.' },
	{ id: 'pl-guadalmansa', cat: 'Beach', name: 'Playa de Guadalmansa', town: 'Estepona', area: 'New Golden Mile', desc: 'Dune-backed and wild-feeling - rarely crowded, even in high season.' },
	{ id: 'pl-salduna', cat: 'Beach club', name: 'Salduna Beach', town: 'Estepona', area: 'West Estepona', desc: 'Laid-back beach club from the PuroBeach people - sea-view terrace and sunbeds on the sand.' },
	{ id: 'pl-beso', cat: 'Beach club', name: 'Beso Beach', town: 'Estepona', area: 'Playa del Padrón', desc: 'The Ibiza and Formentera favourite on Estepona sand - seaside dining and live music.' },
	{ id: 'pl-nido', cat: 'Beach club', name: 'Nido', town: 'Estepona', area: 'East of the centre', desc: 'Boutique, design-led escape - refined Mediterranean food away from the crowds.' },
	{ id: 'pl-trocadero-est', cat: 'Beach club', name: 'Trocadero Estepona', town: 'Estepona', area: 'Estepona seafront', desc: 'Colonial-style elegance with a pool - family-friendly by day, cocktails at sunset.' },
	{ id: 'pl-palangre', cat: 'Restaurant', name: 'El Palangre', town: 'Estepona', area: 'Estepona port', desc: 'Michelin Bib Gourmand - the guide&#39;s pick for Estepona: daily-caught fish and rice dishes by the sea.', url: 'https://restauranteelpalangre.com/en/' },
	{ id: 'pl-louie', cat: 'Nightlife', name: 'Louie Louie Live', town: 'Estepona', area: 'Puerto Deportivo', desc: 'The marina&#39;s legendary music bar - live rock, blues and touring bands until very late.' },
	{ id: 'pl-gio', cat: 'Nightlife', name: 'Gió Pub', town: 'Estepona', area: 'Puerto Deportivo', desc: 'Marina favourite - big beer selection, happy hours and late-night karaoke.' },
];
const PLACE_CATS = [
	{ key: 'Beach', title: 'Beaches' },
	{ key: 'Beach club', title: 'Beach clubs' },
	{ key: 'Restaurant', title: 'Michelin Guide restaurants' },
	{ key: 'Nightlife', title: 'Nightlife' },
];
const placeMap = (p: Place) => 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`${p.name}, ${p.town}, Spain`);
// planner entries for places (dated on add via the "when" dialog)
const planPlaces = PLACES.map((p) => ({ id: p.id, t: p.name, start: null, end: null, blurb: p.desc, venue: p.area, town: p.town, url: p.url || null, cat: p.cat }));
// markets: dow restricts the date picker to the day they actually run
const planMarkets = MARKETS.map((m) => ({ id: m.id, t: m.name, start: null, end: null, blurb: m.desc, venue: m.place, town: m.town, url: null, cat: 'Market', dow: m.dow, dayName: m.dayName, hours: m.hours }));

// places filters: type + neighbourhood (markets included)
const pkey = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const CAT_KEY: Record<string, string> = { Beach: 'beach', 'Beach club': 'club', Restaurant: 'rest', Nightlife: 'night' };
const P_CHIP_LABEL: Record<string, string> = { beach: 'Beaches', club: 'Beach clubs', rest: 'Restaurants', night: 'Nightlife' };
const P_CATS = [
	{ k: 'market', label: 'Markets', n: MARKETS.length },
	...PLACE_CATS.map((c) => ({ k: CAT_KEY[c.key], label: P_CHIP_LABEL[CAT_KEY[c.key]] || c.title, n: PLACES.filter((p) => p.cat === c.key).length })),
];
const townCounts = new Map<string, number>();
for (const t of [...PLACES.map((p) => p.town), ...MARKETS.map((m) => m.town)]) townCounts.set(pkey(t), (townCounts.get(pkey(t)) || 0) + 1);
const P_TOWNS = [...townCounts.entries()].sort((a, b) => b[1] - a[1]);
const townLabel = (k: string) =>
	({ estepona: 'Estepona' })[k] || k;
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	ogImage={`${origin}/og/whats-on-estepona.png`}
	hideSearch
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/que-hacer/estepona/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(eventsLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<section class="hero">
		<div class="heroInner">
			<div class="kicker">What's On &middot; Estepona</div>
			<h1>What's on in Estepona</h1>
			<p class="lead">
				Your night out, your feria, your beach day - everything worth doing in Estepona, from the flower-filled old town to the port, in one
				always-current diary. Tap <strong>+ Add to plan</strong> to build your own itinerary, share it with your friends and
				drop it straight into your calendar. Checked against official sources every week, so you never plan around a dead
				listing.
			</p>
			<div class="ctaRow">
				<a class="btnSecondary" href="#add-event" data-add-link>Add your event - free</a>
			</div>
			{updatedFmt ? <div class="note">Last updated {updatedFmt} &middot; {local.length} events in Estepona, today through {horizon} &middot; <a class="noteLink" href="/neighbourhood/spain/malaga/estepona/">Estepona area guide</a></div> : null}
			<div class="townNav" style="margin-top:14px;display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px;">
				<span style="opacity:.65;">More What's On:</span>
				<a href="/whats-on/marbella/" style="color:#fff;text-decoration:none;border:1px solid rgba(255,255,255,0.35);border-radius:999px;padding:4px 13px;font-weight:700;">Marbella</a>
				<a href="/whats-on/malaga/" style="color:#fff;text-decoration:none;border:1px solid rgba(255,255,255,0.35);border-radius:999px;padding:4px 13px;font-weight:700;">Malaga</a>
				<a href="/whats-on/" style="color:#7fe7d9;text-decoration:none;padding:4px 4px;font-weight:800;">All towns &rarr;</a>
			</div>
		</div>
	</section>

	<div class="tabRow" role="tablist" aria-label="Events or places">
		<button class="tabBtn isActive" data-tab-btn="events" type="button">&#128197; Events <span class="chipCount">{local.length}</span></button>
		<button class="tabBtn" data-tab-btn="places" type="button">&#127958; Places <span class="chipCount">{PLACES.length + MARKETS.length}</span></button>
	</div>

	<div data-tab-pane="events">
	{featured.length >= 3 ? (
		<section class="section" aria-label="Don't miss">
			<div class="featHead"><h2>&#11088; Don't miss</h2><span>The nights everyone will be talking about</span></div>
			<div class="featRow">
				{featured.map((e) => (
					<a class="featCard" href={e.url || '#'} target="_blank" rel="noopener nofollow">
						<span class="featDate">{dateLabel(e)}</span>
						<strong class="featTitle">{e.titleEn || e.title}</strong>
						<span class="featVenue">{e.venue || e.town}</span>
					</a>
				))}
			</div>
		</section>
	) : null}

	{local.length ? (
		<div class="filters">
			<div class="chipRow" role="group" aria-label="Filter by date">
				<button class="chip tchip isActive" data-t="all" type="button">All upcoming <span class="chipCount">{local.length}</span></button>
				<button class="chip tchip" data-t="now" type="button">On today <span class="chipCount">{countNow}</span></button>
				<button class="chip tchip" data-t="wknd" type="button">This weekend <span class="chipCount">{countWknd}</span></button>
				<button class="chip tchip" data-t="month" type="button">This month <span class="chipCount">{countMonth}</span></button>
			</div>
			{cats.length > 1 ? (
				<div class="chipRow chipRowSub" role="group" aria-label="Filter by category">
					<button class="chip cchip isActive" data-c="all" type="button">All types</button>
					{cats.map((c) => (
						<button class="chip cchip" data-c={c} type="button">{CAT_ICON[c]} {CAT_LABEL[c] || c} <span class="chipCount">{catCount.get(c)}</span></button>
					))}
				</div>
			) : null}
		</div>
	) : null}

	<div data-events>
		{BUCKETS.map((b, i) => (
			<Fragment>
			{i === 2 ? (
				<aside class="evAd" aria-label="Property search">
					<div class="evAdText">
						<strong>Looking for a rental or a home for sale in Estepona?</strong>
						<span>Holiday homes for your stay and properties for sale - from registered agents, live on PropertyList.</span>
					</div>
					<div class="evAdBtns">
						<a href="https://propertylist.es/en/portal/for-sale/estepona" target="_blank" rel="noopener">Homes for sale &rarr;</a>
						<a href="https://propertylist.es/en/portal/holiday-rentals/estepona" target="_blank" rel="noopener">Holiday rentals &rarr;</a>
					</div>
				</aside>
			) : null}
			<section class="section" aria-label={b.title} data-bucket={b.k}>
				<div class="bucketHead">
					<h2>{b.icon} {b.title} <span class="chipCount">{b.list.length}</span></h2>
					{b.sub ? <p>{b.sub}</p> : null}
				</div>
				<div class="grid3">
					{b.list.map((e) => (
						<article
							class="card evCard"
							data-cat={e.category}
							data-now={isOn(e) ? '1' : '0'}
							data-wknd={inWeekend(e) ? '1' : '0'}
							data-month={inMonth(e) ? '1' : '0'}
						>
							<div class="evTop">
								<span class="evDate">{dateLabel(e)}{e.time && (!e.end || e.end === e.start) ? ` · ${e.time}` : ""}</span>
								{isOn(e) ? <span class="evNow">On today</span> : null}
							</div>
							<h2 class="evTitle">{e.titleEn || e.title}</h2>
							<div class="evMeta">
								<span class="evCat">{CAT_ICON[e.category]} {CAT_LABEL[e.category] || e.category}</span>
								<span class="evTown">&#128205; {e.town}</span>
								{e.venue ? <span class="evVenue">{e.venue}</span> : null}
							</div>
							<p class="evBlurb">{e.blurbEn}</p>
							<div class="evFoot">
								{e.url ? (
									<a class="evLink" href={e.url} target="_blank" rel="noopener nofollow">Details &rarr;</a>
								) : <span></span>}
								<button class="planBtn" type="button" data-plan-add={e.id}>+ Add to plan</button>
							</div>
						</article>
					))}
				</div>
			</section>
			</Fragment>
		))}
		<p class="empty" data-empty hidden>Nothing matches those filters - try widening the dates or picking another category.</p>
		{!local.length ? <p class="empty">No upcoming events right now - check back soon, the diary refreshes every week.</p> : null}
	</div>

	{nearby.length ? (
		<section class="section">
			<div class="sectionHead">
				<h2>Worth the drive</h2>
				<p>Bigger events elsewhere on the Costa del Sol that Estepona locals will not want to miss.</p>
			</div>
			<div class="grid3">
				{nearby.map((e) => (
					<article class="card evCard">
						<div class="evTop"><span class="evDate">{dateLabel(e)}{e.time && (!e.end || e.end === e.start) ? ` · ${e.time}` : ""}</span><span class="evTown">{e.town}</span></div>
						<h2 class="evTitle">{e.titleEn || e.title}</h2>
						<p class="evBlurb">{e.blurbEn}</p>
						<div class="evFoot">
							{e.url ? <a class="evLink" href={e.url} target="_blank" rel="noopener nofollow">Details &rarr;</a> : <span></span>}
							<button class="planBtn" type="button" data-plan-add={e.id}>+ Add to plan</button>
						</div>
					</article>
				))}
			</div>
		</section>
	) : null}

	<section class="section" id="add-event">
		<div class="sectionHead">
			<h2>Add your event - free</h2>
			<p>
				Run a venue, club, market or community group in the Estepona area? Add your event and it appears here once verified -
				free, and seen by thousands of locals, buyers and visitors every month.
			</p>
		</div>
		<form class="evForm card" data-event-form>
			<div class="formGrid">
				<label>Event name*<input name="title" type="text" required minlength="5" maxlength="120" placeholder="e.g. Sunset Jazz at the Marina" /></label>
				<label>Start date*<input name="start" type="date" required /></label>
				<label>End date (optional)<input name="end" type="date" /></label>
				<label>Venue / place*<input name="venue" type="text" maxlength="120" placeholder="e.g. Plaza de los Naranjos" /></label>
				<label>Town<select name="town">
					<option>Estepona</option><option>Estepona Port</option><option>Cancelada</option><option>El Paraiso</option>
				</select></label>
				<label>Category<select name="category">
					<option value="">Choose...</option><option value="music">Music</option><option value="festival">Festival</option><option value="culture">Culture</option><option value="sport">Sport</option><option value="family">Family</option><option value="food">Food &amp; drink</option><option value="market">Market</option><option value="nightlife">Nightlife</option><option value="other">Other</option>
				</select></label>
				<label>Event link (optional)<input name="link" type="url" maxlength="300" placeholder="https://..." /></label>
				<label>Your name / organisation<input name="organizer" type="text" maxlength="80" /></label>
				<label>Your email*<input name="email" type="email" required maxlength="160" /></label>
			</div>
			<input name="website" type="text" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true" />
			<input type="hidden" name="lang" value="en" />
			<div class="formFoot">
				<button class="btnPrimary" type="submit">Submit event</button>
				<span class="formNote">Events are checked before publishing. We only use your email to confirm details.</span>
			</div>
			<p class="formMsg" data-msg hidden></p>
		</form>
		<div class="feedCard card">
			<div class="feedText">
				<strong>&#128257; Got a full calendar of events?</strong>
				<span>Register your events feed once (an iCal/Google Calendar link, or your events page URL) and we will pick up your new events automatically, forever.</span>
			</div>
			<form class="feedForm" data-mini-form data-kind="feed">
				<input name="organizer" type="text" required minlength="3" maxlength="100" placeholder="Venue / organisation" />
				<input name="url" type="url" required maxlength="400" placeholder="Feed or events page URL" />
