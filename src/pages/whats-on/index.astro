---
import fs from 'node:fs';
import Layout from '../../layouts/Layout.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/whats-on/`;
const title = "What's On - Costa del Sol Events Diaries | PropertyList";
const description =
	'Curated, always-current event diaries for Costa del Sol towns - concerts, festivals, markets and beach days, from official sources, updated every week. Build a free day plan, share it with friends and export it to your calendar.';

const todayIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(new Date());
const TOWNS = [
	{ key: 'marbella', name: 'Marbella', href: '/whats-on/marbella/', blurb: 'Starlite nights, ferias, street markets and the famous beach clubs.' },
	{ key: 'estepona', name: 'Estepona', href: '/whats-on/estepona/', blurb: 'The flower-filled old town, the port after dark and the summer festival season.' },
	{ key: 'malaga', name: 'Malaga', href: '/whats-on/malaga/', blurb: 'City culture, Michelin stars, chiringuito beaches and clubs open until dawn.' },
];
const towns = TOWNS.map((t) => {
	let count = 0, updated = null;
	try {
		const store = JSON.parse(fs.readFileSync(`/opt/info-hub/var/admin/events/${t.key}.json`, 'utf8'));
		const evs = (store.events || []).filter((e: any) => String(e.end || e.start) >= todayIso);
		count = evs.filter((e: any) => e.scope === 'local').length;
		updated = store.updated || null;
	} catch {}
	return { ...t, count, updated };
});
const fmt = (iso: string | null) => (iso ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long' }).format(new Date(iso)) : null);

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: "What's On", item: canonical },
	],
};
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	hideSearch
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/que-hacer/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<section class="hero">
		<div class="heroInner">
			<div class="kicker">What's On &middot; Costa del Sol</div>
			<h1>What's on, town by town</h1>
			<p class="lead">
				Real, verified events - concerts, ferias, exhibitions, markets and beach days - pulled from official sources and
				refreshed every week. Pick your town, tap <strong>+ Add to plan</strong> on anything you like, share the plan
				with your friends or travel partners, and drop it straight into your calendar. Free, no signup.
			</p>
		</div>
	</section>

	<section class="section" aria-label="Towns">
		<div class="grid">
			{towns.map((t) => (
				<a class="card" href={t.href}>
					<h2>{t.name}</h2>
					<p class="blurb">{t.blurb}</p>
					<p class="meta">
						{t.count ? <strong>{t.count} events on now and coming up</strong> : <strong>Diary launching</strong>}
						{t.updated ? <span> &middot; updated {fmt(t.updated)}</span> : null}
					</p>
					<span class="go">See the {t.name} diary &rarr;</span>
				</a>
			))}
		</div>
		<p class="note">
			Run a venue or organise events in another Costa del Sol town? <a href="/whats-on/marbella/#add-event">Register your event or feed</a>
			- new towns launch where the diary fills up.
		</p>
	</section>
</Layout>

<style>
	.hero { background: linear-gradient(160deg, #04211c 0%, #0a4a3f 70%, #0d5c4d 100%); color: #fff; padding: 56px 20px 40px; }
	.heroInner { max-width: 1040px; margin: 0 auto; }
	.kicker { font-size: 12.5px; font-weight: 900; letter-spacing: 0.14em; text-transform: uppercase; color: #7fe7d9; margin-bottom: 10px; }
	h1 { font-size: clamp(30px, 5vw, 44px); letter-spacing: -0.02em; margin: 0 0 12px; }
	.lead { max-width: 720px; font-size: 16.5px; line-height: 1.6; color: rgba(255, 255, 255, 0.88); margin: 0; }
	.section { max-width: 1040px; margin: 0 auto; padding: 36px 20px 64px; }
	.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
	.card { display: block; border: 1px solid rgba(4, 33, 28, 0.12); border-radius: 16px; padding: 22px; text-decoration: none; color: inherit; background: #fff; box-shadow: 0 1px 2px rgba(4, 33, 28, 0.05); transition: transform 0.12s ease, box-shadow 0.12s ease; }
	.card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(4, 33, 28, 0.1); }
	.card h2 { margin: 0 0 6px; font-size: 22px; letter-spacing: -0.01em; color: #0a2e28; }
	.blurb { margin: 0 0 12px; font-size: 14.5px; line-height: 1.55; color: rgba(10, 46, 40, 0.72); }
	.meta { margin: 0 0 14px; font-size: 13px; color: rgba(10, 46, 40, 0.6); }
	.meta strong { color: #075e53; }
	.go { font-weight: 900; font-size: 14.5px; color: #00806f; }
	.note { margin-top: 26px; font-size: 13.5px; color: rgba(10, 46, 40, 0.65); }
	.note a { color: #00806f; font-weight: 700; }
</style>
