---
import Layout from '../../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../../lib/directus';

const items = await listKbPagesByPrefix({ prefix: '/general-information/', lang: 'en', limit: 120 });
---

<Layout
	lang="en"
	title="General Information • PropertyList Info Hub"
	description="Announcements, news, and updates from PropertyList."
	canonical="https://info.propertylist.es/general-information/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/general-information/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/informacion-general/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/general-information/' },
	]}
>
	<h1>General Information</h1>
	<p class="sub">Announcements, news, and updates from PropertyList.</p>

	{items.length ? (
		<div class="grid">
			{items.map((p) => (
				<a class="card" href={p.path}>
					<h2>{p.title}</h2>
					{p.description ? <p>{p.description}</p> : null}
				</a>
			))}
		</div>
	) : (
		<div class="empty">No articles yet.</div>
	)}
</Layout>

<style>
	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.03em;
	}

	.sub {
		margin: 0 0 18px;
		color: rgba(16, 24, 40, 0.7);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.card {
		display: block;
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 14px;
		text-decoration: none;
	}

	.card h2, .card p { overflow-wrap: anywhere; }

	.card:hover {
		text-decoration: none;
		border-color: rgba(0, 174, 154, 0.35);
	}

	.card h2 {
		margin: 0 0 8px;
		font-size: 16px;
		letter-spacing: -0.01em;
	}

	.card p {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
	}

	.empty {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	@media (max-width: 820px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
