		/* ---- scene 7 (shelves) ---- */
		.shelf { position: absolute; left: 50%; transform: translateX(-50%); width: min(92vw, 860px); display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; z-index: 3; }
