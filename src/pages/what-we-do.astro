		.save { position: absolute; right: 10px; top: 10px; border-radius: 999px; background: var(--teal); color: #fff; font-weight: 800; font-size: 11px; padding: 6px 11px; }

		/* ---- stamps (shared) ---- */
		.stamp { position: absolute; right: -8px; top: -14px; z-index: 9; border: 2.5px solid var(--glow); color: var(--glow); font-weight: 900; font-size: 16px; padding: 2px 10px; border-radius: 8px; transform: rotate(-9deg); background: rgba(11, 18, 32, 0.88); white-space: nowrap; }
		.stamp.credit { border-color: var(--amber); color: var(--amber); font-size: 12.5px; }
		.stamp.free { border-color: rgba(234, 242, 241, 0.8); color: rgba(234, 242, 241, 0.9); font-size: 11.5px; }
