		/* ---- scene 1 ---- */
		.proPhotos { position: absolute; left: 50%; top: 40%; transform: translate(-50%, -50%); z-index: 2; }
		.pp { position: absolute; width: 74px; height: 56px; border-radius: 10px; background: linear-gradient(160deg, #1d4f6e, #0f6b74); border: 1px solid rgba(234, 242, 241, 0.2); opacity: calc(1 - var(--s1)); }
		.pp1 { transform: translate(calc(-140px + var(--s1) * 110px), calc(-90px + var(--s1) * 70px)) rotate(-10deg); }
		.pp2 { transform: translate(calc(80px - var(--s1) * 80px), calc(-110px + var(--s1) * 85px)) rotate(7deg); background: linear-gradient(160deg, #16305a, #00ae9a); }
		.pp3 { transform: translate(calc(-30px + var(--s1) * 25px), calc(120px - var(--s1) * 95px)) rotate(-4deg); background: linear-gradient(160deg, #0f6b74, #16305a); }
		.wave { position: absolute; left: 50%; transform: translateX(-50%); top: 16%; display: flex; gap: 3px; align-items: center; height: 34px; }
		.wave.on { opacity: 0; }
		.js [data-stage='pro'] .wave.on { opacity: calc(0.9 - var(--s1) * 0.9); }
		/* parabola height without abs()/sin(): unitless maths, then to px */
		.wave i { width: 4px; border-radius: 3px; background: var(--glow); height: calc((26 - (var(--wi) - 9) * (var(--wi) - 9) * 0.22) * 1px); animation: wv 0.9s ease-in-out infinite alternate; animation-delay: calc(var(--wi) * -0.08s); }
		@keyframes wv { from { transform: scaleY(0.45); } to { transform: scaleY(1); } }
		.hero1 { z-index: 3; opacity: min(1, calc(var(--s1) * 1.6)); scale: calc(0.86 + 0.14 * var(--s1)); }
		.hero1 .body > *, .hero1 .chips span { opacity: min(1, calc(var(--s1) * 2 - 0.3)); }
		.stPro { right: 10px; top: auto; bottom: -12px; }
		.tool { position: absolute; left: 50%; transform: translateX(-50%); top: calc(42% + 150px); width: min(86vw, 520px); text-align: center; font-size: 12.5px; letter-spacing: 0.4px; color: rgba(234, 242, 241, 0.5); z-index: 4; }

		/* ---- scene 2 (fan-out, from the approved prototype) ---- */
		.heroF { z-index: 3; opacity: calc(1 - var(--s1) * 0.55); scale: calc(1 - var(--s1) * 0.18); }
		.clone { z-index: 2; pointer-events: none; opacity: calc(min(1, var(--s1) * 3) * clamp(0, calc((0.97 - var(--s1)) / 0.22), 1)); transform: translateY(-50%) translate(calc(var(--cx) * var(--s1)), calc(var(--cy) * var(--s1))) scale(calc(1 - 0.5 * var(--s1))); }
		.c1 { --cx: -30vw; --cy: -30vh; } .c2 { --cx: 30vw; --cy: -30vh; } .c3 { --cx: -30vw; --cy: 26vh; } .c4 { --cx: 30vw; --cy: 26vh; }
		.lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
		.ln { fill: none; stroke: rgba(91, 227, 208, 0.22); stroke-width: 0.3; stroke-dasharray: 90; stroke-dashoffset: calc(90 - var(--s2) * 90); transition: opacity 0.5s; }
		.stage[data-seg='3'] .ln { opacity: 0.22; }
		.dest { position: absolute; width: clamp(180px, 21vw, 245px); opacity: clamp(0, calc((var(--s1) - 0.55) / 0.45), 1); z-index: 4; }
		.dMls { left: max(14px, 4vw); top: max(14px, 5vh); } .dPortal { right: max(14px, 4vw); top: max(14px, 5vh); }
		.dWeb { left: max(14px, 4vw); bottom: max(14px, 7vh); } .dXml { right: max(14px, 4vw); bottom: max(14px, 7vh); }
		.dHead { font-size: 12px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; color: var(--glow); margin-bottom: 8px; }
		.dLine { font-size: 12.5px; color: rgba(234, 242, 241, 0.6); margin-top: 8px; }
		.dLine b { color: var(--ink); font-size: 15px; }
		.dotGrid { display: grid; grid-template-columns: repeat(13, 1fr); gap: 4px; }
		.dot { width: 100%; aspect-ratio: 1; border-radius: 50%; background: rgba(234, 242, 241, 0.12); transition: background 0.4s, box-shadow 0.4s; transition-delay: var(--d); }
		.stage.mlsOn .dot { background: var(--glow); box-shadow: 0 0 6px rgba(91, 227, 208, 0.7); }
		.mini { border: 1px solid rgba(234, 242, 241, 0.16); border-radius: 10px; background: #101c33; overflow: hidden; }
		.chrome { display: flex; gap: 4px; padding: 6px 8px; border-bottom: 1px solid rgba(234, 242, 241, 0.1); }
		.chrome span { width: 7px; height: 7px; border-radius: 50%; background: rgba(234, 242, 241, 0.25); }
		.mCard { display: flex; gap: 8px; padding: 8px; align-items: center; }
		.mPhoto { width: 46px; height: 34px; border-radius: 6px; background: linear-gradient(160deg, #1d4f6e, #0f6b74); flex: none; }
		.mPhoto.alt { background: linear-gradient(160deg, #16305a, #00ae9a); }
		.mMeta { flex: 1; } .mMeta i { display: block; height: 7px; border-radius: 4px; background: rgba(234, 242, 241, 0.2); margin: 5px 0; } .mMeta i.short { width: 55%; }
		.laptop { border: 0; background: transparent; overflow: visible; }
		.laptop .lapScreen { border: 1px solid rgba(234, 242, 241, 0.14); border-bottom: 0; border-radius: 8px 8px 0 0; background: #0d1830; }
		.laptop .lapBase { height: 7px; background: rgba(234, 242, 241, 0.18); border-radius: 0 0 10px 10px; }
		.code { padding: 10px 12px; font-family: ui-monospace, Consolas, monospace; font-size: 10.5px; color: rgba(91, 227, 208, 0.85); display: flex; flex-direction: column; gap: 3px; }
		.code .ind { padding-left: 14px; color: rgba(234, 242, 241, 0.6); }
		.thesis { position: absolute; left: 50%; top: 42%; transform: translate(-50%, -50%); text-align: center; font-size: clamp(22px, 4vw, 38px); font-weight: 800; letter-spacing: -0.5px; margin: 0; opacity: 0; transition: opacity 0.5s 0.1s; z-index: 5; text-shadow: 0 4px 30px rgba(11, 18, 32, 0.95); }
		.thesis span { color: var(--glow); }
		.stage[data-seg='3'] .thesis { opacity: 1; }
		.stage[data-seg='3'] .heroF { opacity: 0.1; }

		/* ---- scene 3 (valuation) ---- */
		[data-stage='val'] { filter: saturate(calc(0.55 + 0.45 * var(--p))); }
		.valScene { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: clamp(18px, 4vw, 54px); padding: 0 5vw; flex-wrap: wrap; }
		.valFrame { width: min(46vw, 430px); border-radius: 14px; overflow: hidden; border: 1px solid rgba(91, 227, 208, 0.3); box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.85); }
		.valFrame img { display: block; width: 100%; height: auto; }
		.js .valFrame { opacity: 0; transform: translateY(26px) rotate(-1.5deg); transition: opacity 0.5s, transform 0.5s; }
