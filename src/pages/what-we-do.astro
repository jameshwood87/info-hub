		.photo.alt2 { background: linear-gradient(180deg, #101a38, #232f55); }
		.sun { position: absolute; right: 18%; top: 18%; width: 24px; height: 24px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 22px rgba(255, 217, 160, 0.8); }
		.moon { position: absolute; right: 20%; top: 20%; width: 20px; height: 20px; border-radius: 50%; background: #dfe8ff; box-shadow: 0 0 18px rgba(223, 232, 255, 0.6); }
		.sea { position: absolute; left: 0; right: 0; bottom: 0; height: 34%; background: linear-gradient(180deg, rgba(0, 174, 154, 0.55), rgba(0, 174, 154, 0.25)); }
		.body { padding: 12px 14px 13px; }
		.cardTitle { font-size: 16px; margin: 0 0 2px; }
		.where { font-size: 11.5px; color: rgba(234, 242, 241, 0.55); margin: 0 0 6px; }
