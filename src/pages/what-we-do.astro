		/* ---- scene 4 (enquiry) ---- */
		.bubble { position: absolute; left: 50%; top: 16%; transform: translateX(-50%); width: min(84vw, 400px); background: #123a2e; border: 1px solid rgba(37, 211, 102, 0.5); border-radius: 16px 16px 16px 4px; padding: 14px 18px 16px; font-size: 13.5px; color: rgba(234, 242, 241, 0.85); z-index: 5; }
		.bubble b { display: block; margin-top: 4px; font-size: 15px; color: #dfffe9; }
		.bDot { position: absolute; left: -5px; top: -5px; width: 12px; height: 12px; border-radius: 50%; background: #25d366; box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); animation: pulse 2s infinite; }
		@keyframes pulse { 70% { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); } }
		.js .bubble { opacity: 0; transform: translateX(-50%) translateY(-18px); transition: opacity 0.4s, transform 0.4s; }
		.js .bubble.on { opacity: 1; transform: translateX(-50%); }
		.stEnq { right: 12px; top: auto; bottom: -14px; }
		.kanban { position: absolute; left: 50%; top: 52%; transform: translateX(-50%); display: flex; gap: clamp(10px, 2vw, 22px); z-index: 4; }
		.kCol { width: clamp(104px, 13vw, 170px); background: rgba(16, 28, 51, 0.7); border: 1px solid rgba(234, 242, 241, 0.12); border-radius: 12px; padding: 10px; min-height: 150px; }
		.kHead { font-size: 11px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; color: rgba(234, 242, 241, 0.5); margin-bottom: 8px; }
		.kGhost { height: 44px; border: 1.5px dashed rgba(234, 242, 241, 0.14); border-radius: 8px; }
		.kCard { position: relative; background: #17304f; border: 1px solid rgba(91, 227, 208, 0.35); border-radius: 8px; padding: 9px 10px 11px; font-size: 12px; }
		.kCard b { display: block; font-size: 13px; }
		.kCard > span { color: rgba(234, 242, 241, 0.55); font-size: 11px; }
		.js .kMove { opacity: 0; transform: translateX(calc(-100% - 24px)); transition: transform 0.55s cubic-bezier(0.3, 1.2, 0.4, 1), opacity 0.3s; }
		.js .kMove.on { opacity: 1; transform: none; }
		.stPipe { right: -10px; top: auto; bottom: -16px; }
		[data-stage='enq'] .tool { top: auto; bottom: 12vh; }

		/* ---- scene 5 (network) ---- */
		.coast { position: absolute; left: 50%; top: 30%; transform: translate(-50%, -50%); width: min(88vw, 680px); z-index: 2; }
		.shore { fill: none; stroke: rgba(234, 242, 241, 0.35); stroke-width: 2; stroke-dasharray: 420; stroke-dashoffset: calc(420 - var(--s1) * 420); }
		.town { fill: var(--glow); opacity: clamp(0, calc((var(--s1) - 0.6) / 0.3), 1); }
		.tLabel { fill: rgba(234, 242, 241, 0.6); font-size: 11px; letter-spacing: 0.5px; opacity: clamp(0, calc((var(--s1) - 0.7) / 0.3), 1); }
		.deal { fill: none; stroke: var(--glow); stroke-width: 2; stroke-dasharray: 220; stroke-dashoffset: 220; }
		.js .deal.on { animation: draw 0.9s ease forwards; }
		.deal.on { stroke-dashoffset: 0; }
		@keyframes draw { to { stroke-dashoffset: 0; } }
		.split { position: absolute; left: 50%; top: 58%; transform: translateX(-50%); width: min(78vw, 440px); display: flex; border-radius: 999px; overflow: hidden; border: 1px solid rgba(91, 227, 208, 0.4); z-index: 3; }
		.sHalf { flex: 1; text-align: center; font-size: 12px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; padding: 10px 0; }
		.sYou { background: rgba(0, 174, 154, 0.35); }
		.sThem { background: rgba(0, 174, 154, 0.14); }
		.js .split { opacity: 0; transform: translateX(-50%) scaleX(0.6); transition: opacity 0.45s, transform 0.45s; }
		.js .split.on { opacity: 1; transform: translateX(-50%) scaleX(1); }
		.netLine { position: absolute; left: 50%; transform: translateX(-50%); top: 70%; width: min(86vw, 520px); text-align: center; font-size: clamp(15px, 2.2vw, 18px); color: rgba(234, 242, 241, 0.85); z-index: 4; }
		.stNet { position: relative; display: inline-block; right: auto; top: auto; margin-left: 12px; }

		/* ---- scene 6 (rentals flip) ---- */
		.flipBox { position: absolute; left: 50%; top: 44%; transform: translate(-50%, -50%); width: clamp(210px, 26vw, 280px); perspective: 1100px; z-index: 3; }
		.flipInner { position: relative; width: 100%; height: 230px; transform-style: preserve-3d; transition: transform 0.2s; transform: rotateY(calc(var(--s1) * 180deg)); }
		.face { position: absolute; inset: 0; margin: 0; left: 0; top: 0; width: 100%; transform: none; backface-visibility: hidden; }
