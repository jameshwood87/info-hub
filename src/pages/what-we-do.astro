		.valNote { position: relative; max-width: 340px; }
		.js .valNote { opacity: 0; transform: translateY(18px); transition: opacity 0.5s 0.12s, transform 0.5s 0.12s; }
		.js .valNote.on { opacity: 1; transform: none; }
		.valBig { font-size: clamp(20px, 3vw, 28px); font-weight: 800; line-height: 1.25; margin: 0 0 10px; }
		.valSmall { font-size: 14px; color: rgba(234, 242, 241, 0.62); line-height: 1.6; margin: 0 0 40px; }
