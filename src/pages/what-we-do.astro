			.hint, .bDot, .wave i { animation: none; }
			.card, .dest, .kanban, .coastWrap, .splitWrap, .n5w, .flipBox, .shelf, .credScene, .till, .ctaRow, .bubble, .valScene, .tool, .thesis, .proRow, .vn { position: static; transform: none; margin: 14px auto; opacity: 1; }
