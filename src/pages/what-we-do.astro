		.stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; --p: 1; --s1: 1; --s2: 1; }

		.cap { position: absolute; left: 50%; transform: translateX(-50%); bottom: max(18px, env(safe-area-inset-bottom)); width: min(88vw, 600px); text-align: center; font-size: clamp(15px, 2.1vw, 19px); line-height: 1.5; color: rgba(234, 242, 241, 0.88); opacity: 0; transition: opacity 0.35s; margin: 0; z-index: 8; text-shadow: 0 2px 18px rgba(11, 18, 32, 0.9); }
