		.shTool { position: relative; background: rgba(16, 28, 51, 0.75); border: 1px solid rgba(234, 242, 241, 0.14); border-radius: 12px; padding: 13px 14px 15px; }
		.shTool b { display: block; font-size: 14px; margin-bottom: 3px; }
		.shTool > span { font-size: 11.5px; color: rgba(234, 242, 241, 0.55); line-height: 1.45; display: block; }
		.js .shelf.live .shTool { opacity: 0; transform: translateY(16px); transition: opacity 0.4s, transform 0.4s; transition-delay: calc(var(--i) * 90ms); }
		.js .shelf.live .shTool.on { opacity: 1; transform: none; }
		.stamp.mini2 { position: absolute; right: 8px; top: -10px; font-size: 10.5px; padding: 1px 7px; border-width: 2px; }
