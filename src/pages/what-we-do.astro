		.refCard b { display: block; margin-bottom: 3px; }
		.refCard span { color: rgba(234, 242, 241, 0.65); font-size: 13px; }
		.js .refRow { opacity: 0; transform: translateY(14px); transition: opacity 0.45s, transform 0.45s; }
		.js .refRow.on { opacity: 1; transform: none; }

		/* ---- scene 9 (receipt) ---- */
		.till { position: absolute; left: 50%; top: 47%; transform: translate(-50%, -50%); width: min(90vw, 460px); background: #f4f1e8; color: #101828; border-radius: 6px 6px 14px 14px; padding: 18px 22px 16px; font-size: 13.5px; box-shadow: 0 34px 80px -30px rgba(0, 0, 0, 0.9); z-index: 3; max-height: 74svh; overflow: auto; }
		.till::before { content: ''; position: absolute; left: 0; right: 0; top: -8px; height: 9px; background: linear-gradient(-45deg, transparent 6px, #f4f1e8 0) 0 0 / 14px 100%; }
		.tHead { text-align: center; font-weight: 900; letter-spacing: 2px; font-size: 12.5px; border-bottom: 2px dashed rgba(16, 24, 40, 0.25); padding-bottom: 9px; margin-bottom: 6px; }
		.rl { display: flex; justify-content: space-between; gap: 14px; padding: 5px 0; border-bottom: 1px dotted rgba(16, 24, 40, 0.14); }
		.rl span { color: rgba(16, 24, 40, 0.78); }
		.rl b { white-space: nowrap; color: #0a6d61; }
		.js .rl { opacity: 0; transform: translateY(8px); transition: opacity 0.3s, transform 0.3s; }
		.js .rl.on { opacity: 1; transform: none; }
		.tFoot { padding-top: 9px; }
		.js .tFoot { opacity: 0; transition: opacity 0.4s 0.1s; }
		.js .tFoot.on { opacity: 1; }
		.tSum { font-size: 15.5px; font-weight: 800; margin: 0 0 6px; }
		.tSum b { color: #0a6d61; font-size: 19px; }
		.tNote { font-size: 11px; color: rgba(16, 24, 40, 0.55); line-height: 1.5; margin: 0; }
		.js .till { opacity: 0; transform: translate(-50%, -47%); transition: opacity 0.5s, transform 0.5s; }
		.js .till.on { opacity: 1; transform: translate(-50%, -50%); }
		.ctaRow { position: absolute; left: 50%; transform: translateX(-50%); bottom: max(16px, 5vh); display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; z-index: 4; width: min(92vw, 600px); }
		.js .ctaRow { opacity: 0; transition: opacity 0.5s 0.2s; }
		.js .ctaRow.on { opacity: 1; }
		.btnP { background: var(--teal); color: #fff; border-radius: 999px; padding: 13px 26px; font-size: 15px; font-weight: 800; text-decoration: none; }
		.btnP:hover { background: #00998a; }
		.btnG { background: transparent; color: var(--ink); border: 1.5px solid rgba(234, 242, 241, 0.4); border-radius: 999px; padding: 13px 26px; font-size: 15px; font-weight: 800; text-decoration: none; }
		.btnG:hover { border-color: var(--glow); color: var(--glow); }
		[data-stage='rec'] .capA { bottom: auto; top: max(16px, 4vh); }

		/* ---- outro ---- */
		.outro { padding-bottom: 90px; }
		.outro details { text-align: left; border-bottom: 1px solid rgba(234, 242, 241, 0.12); padding: 13px 4px; }
		.outro summary { font-weight: 700; font-size: 15.5px; cursor: pointer; }
		.outro details p { margin: 10px 0 2px; font-size: 14.5px; }
		.moreLinks { margin-top: 26px !important; font-size: 14px !important; }
		.moreLinks a { color: var(--glow); text-decoration: none; }
		.moreLinks a:hover { text-decoration: underline; }

		/* ---- mobile ---- */
		@media (max-width: 700px) {
			.c1 { --cx: -24vw; --cy: -29vh; } .c2 { --cx: 24vw; --cy: -29vh; } .c3 { --cx: -24vw; --cy: 23vh; } .c4 { --cx: 24vw; --cy: 23vh; }
			.clone { display: none; }
			.dest { width: 42vw; }
			.dotGrid { grid-template-columns: repeat(10, 1fr); }
			.dot:nth-child(n + 101) { display: none; }
			.card { width: 200px; margin-left: -100px; }
			.rail { display: none; }
			.valScene { gap: 14px; padding-top: 6vh; align-content: center; }
			.valFrame { width: min(84vw, 340px); }
			.valNote { max-width: 84vw; text-align: center; }
			.valSmall { margin-bottom: 34px; }
			.kanban { top: 46%; }
			.kCol:last-child { display: none; }
			.kCol { width: 38vw; }
			.shelf { grid-template-columns: 1fr 1fr; }
			.shelf.live { top: 8vh; }
			.shelf.frosted { bottom: 10vh; }
			.stamp { font-size: 13px; }
			.stamp.credit { font-size: 10.5px; }
			.till { font-size: 12px; padding: 14px 14px 12px; top: 44%; max-height: 66svh; }
			.flipInner { height: 215px; }
			.coast { width: 94vw; top: 26%; }
			.bubble { top: 10%; }
		}

		/* ---- reduced motion: the film becomes an illustrated article ---- */
		@media (prefers-reduced-motion: reduce) {
			.wrap { height: auto !important; }
			.stage { position: static; height: auto; min-height: 92vh; padding: 46px 0 70px; }
			.cap { position: static; transform: none; opacity: 1 !important; margin: 12px auto; }
			.hint, .bDot, .wave i { animation: none; }
			.card, .dest, .kanban, .coast, .split, .netLine, .flipBox, .shelf, .credScene, .till, .ctaRow, .bubble, .valScene, .tool, .thesis, .proPhotos { position: static; transform: none; margin: 14px auto; opacity: 1; }
			.thesis { opacity: 1; }
			.clone, .lines { display: none; }
			.credScene { display: flex; }
		}
	</style>

	<script>
		const film = document.querySelector('[data-film]') as HTMLElement;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const clamp = (v: number) => Math.max(0, Math.min(1, v));
		const ease = (t: number) => 1 - Math.pow(1 - t, 3);

		// Every scene declares its beats. cls beats toggle a class on a target
		// (or each element of a stagger) once --p passes the threshold; seg sets
		// data-seg for captions; counters tween textContent.
		type Beat = { at: number; sel: string; cls?: string; all?: boolean };
		const SCENES: Record<string, { segs: number[]; s1?: [number, number]; s2?: [number, number]; beats: Beat[]; stagger?: { sel: string; from: number; to: number }; counter?: { sel: string; to: number; from: number; end: number } }> = {
			pro: { segs: [0.42], s1: [0.18, 0.62], beats: [{ at: 0.66, sel: '.stPro', cls: 'hit' }] },
			fan: {
				segs: [0.4, 0.82], s1: [0.1, 0.42], s2: [0.3, 0.52],
				beats: [
					{ at: 0.42, sel: '[data-stage=fan]', cls: 'mlsOn' },
					{ at: 0.5, sel: '.stF1', cls: 'hit' }, { at: 0.58, sel: '.stF2', cls: 'hit' },
					{ at: 0.66, sel: '.stF3', cls: 'hit' }, { at: 0.74, sel: '.stF4', cls: 'hit' },
				],
				counter: { sel: '[data-count-agents]', to: 1300, from: 0.42, end: 0.72 },
			},
			val: { segs: [0.5], beats: [{ at: 0.22, sel: '.valFrame', cls: 'on' }, { at: 0.38, sel: '.valNote', cls: 'on' }, { at: 0.62, sel: '.stVal', cls: 'hit' }] },
			enq: { segs: [0.36, 0.72], beats: [{ at: 0.14, sel: '.bubble', cls: 'on' }, { at: 0.3, sel: '.stEnq', cls: 'hit' }, { at: 0.46, sel: '.kMove', cls: 'on' }, { at: 0.62, sel: '.stPipe', cls: 'hit' }] },
			net: { segs: [0.55], s1: [0.05, 0.5], beats: [{ at: 0.55, sel: '.deal', cls: 'on' }, { at: 0.68, sel: '.split', cls: 'on' }, { at: 0.8, sel: '.stNet', cls: 'hit' }] },
			rent: { segs: [0.4], s1: [0.2, 0.62], beats: [{ at: 0.72, sel: '.stRent', cls: 'hit' }] },
			inst: {
				segs: [0.52],
				beats: [
					{ at: 0.14, sel: '.shelf.live .shTool', cls: 'on', all: true },
					{ at: 0.3, sel: '.stamp.mini2', cls: 'hit', all: true },
					{ at: 0.56, sel: '.shelf.frosted', cls: 'on' },
				],
			},
			cred: { segs: [0.5], beats: [{ at: 0.2, sel: '.coin', cls: 'on' }, { at: 0.55, sel: '.refRow', cls: 'on' }] },
			rec: {
				segs: [0.3],
				beats: [{ at: 0.03, sel: '.till', cls: 'on' }, { at: 0.78, sel: '.tFoot', cls: 'on' }, { at: 0.84, sel: '.ctaRow', cls: 'on' }],
				stagger: { sel: '.rl', from: 0.14, to: 0.74 },
			},
		};

		const wraps = Array.from(document.querySelectorAll('[data-wrap]')) as HTMLElement[];
		const railDots = Array.from(document.querySelectorAll('[data-rail-dot]'));
		const seen = new Set<string>();
		const track = (n: string, d?: Record<string, unknown>) => { try { (window as any).umami?.track?.(n, d); } catch {} };

		if (!reduced) {
			film.classList.add('js');
			// rewind every scene to its zero state
			for (const w of wraps) {
				const key = w.dataset.wrap!;
				const stage = w.querySelector('[data-stage]') as HTMLElement;
				stage.style.setProperty('--s1', '0');
				stage.style.setProperty('--s2', '0');
				stage.style.setProperty('--p', '0');
				stage.dataset.seg = '1';
				const sc = SCENES[key];
				for (const b of sc.beats) (b.all ? stage.querySelectorAll(b.sel) : [stage.querySelector(b.sel)]).forEach((el: any) => el && el.classList.remove(b.cls || 'on'));
				if (sc.stagger) stage.querySelectorAll(sc.stagger.sel).forEach((el) => el.classList.remove('on'));
				if (sc.counter) { const c = stage.querySelector(sc.counter.sel); if (c) c.textContent = '0'; }
			}

			let ticking = false;
			const frame = () => {
				ticking = false;
				const vh = innerHeight;
				let anyActive = false;
				wraps.forEach((w, wi) => {
					const r = w.getBoundingClientRect();
					if (r.bottom < -vh || r.top > vh * 2) return;
					const key = w.dataset.wrap!;
					const sc = SCENES[key];
					const stage = w.querySelector('[data-stage]') as HTMLElement;
					const p = clamp(-r.top / Math.max(1, w.offsetHeight - vh));
					stage.style.setProperty('--p', String(p));
					if (sc.s1) stage.style.setProperty('--s1', String(ease(clamp((p - sc.s1[0]) / (sc.s1[1] - sc.s1[0])))));
					if (sc.s2) stage.style.setProperty('--s2', String(clamp((p - sc.s2[0]) / (sc.s2[1] - sc.s2[0]))));
					let seg = 1;
					for (const t of sc.segs) if (p > t) seg++;
					stage.dataset.seg = String(seg);
					for (const b of sc.beats) (b.all ? stage.querySelectorAll(b.sel) : [stage.querySelector(b.sel)]).forEach((el: any) => el && el.classList.toggle(b.cls || 'on', p > b.at));
					if (sc.stagger) {
						const els = stage.querySelectorAll(sc.stagger.sel);
						els.forEach((el, i) => el.classList.toggle('on', p > sc.stagger!.from + (i * (sc.stagger!.to - sc.stagger!.from)) / els.length));
					}
					if (sc.counter) {
						const c = stage.querySelector(sc.counter.sel) as HTMLElement;
						if (c) c.textContent = Math.round(sc.counter.to * clamp((p - sc.counter.from) / (sc.counter.end - sc.counter.from))).toLocaleString('en-GB');
					}
					const active = r.top < vh * 0.5 && r.bottom > vh * 0.5;
					if (active) { railDots.forEach((d, i) => d.classList.toggle('here', i === wi)); anyActive = true; }
					if (active && !seen.has(key)) { seen.add(key); track('film-scene', { scene: key }); }
				});
				film.classList.toggle('rolling', anyActive);
			};
			addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }, { passive: true });
			addEventListener('resize', frame);
			frame();
		}
	</script>
</Layout>
