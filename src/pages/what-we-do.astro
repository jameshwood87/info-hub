		.breather { padding: 64px 22px 56px; }

		/* rail */
		.rail { position: fixed; left: max(10px, calc(50vw - 700px)); top: 50%; transform: translateY(-50%); z-index: 40; display: flex; flex-direction: column; gap: 12px; opacity: 0; pointer-events: none; transition: opacity 0.4s; }
