		.frosted.on { opacity: 1; }

		/* ---- scene 8 (credits) ---- */
		.credScene { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; padding: 0 6vw; text-align: center; }
		.coin { width: clamp(150px, 20vw, 200px); aspect-ratio: 1; border-radius: 50%; border: 3px solid var(--amber); color: var(--amber); display: grid; place-items: center; font-size: clamp(17px, 2.4vw, 22px); font-weight: 900; background: radial-gradient(circle at 34% 30%, rgba(255, 217, 160, 0.2), transparent 60%); }
		.js .coin { opacity: 0; transform: scale(0.6) rotate(-14deg); transition: opacity 0.4s, transform 0.5s cubic-bezier(0.2, 1.6, 0.4, 1); }
