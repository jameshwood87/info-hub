  <script>
    // Pricing toggle - annual default
    (function () {
      const opts   = document.querySelectorAll('.pricing-toggle-opt');
      const price  = document.getElementById('export-price');
      const period = document.getElementById('export-period');
      const detail = document.getElementById('export-detail');
      const note   = document.getElementById('export-note');
      const cta    = document.getElementById('export-cta');

      const data = {
        monthly: {
          price:  '35€',
          period: '/month',
          detail: 'Flexible billing. Cancel any time.',
          note:   '<strong>✓ Cancel anytime.</strong> No setup fee. No contract.'
        },
        annual: {
          price:  '350€',
          period: '/year',
          detail: 'Less than 30€/month · Save 70€ vs monthly',
          note:   '<strong>✓ Best value.</strong> Save 70€. Cancel anytime.'
        }
      };

      opts.forEach(opt => {
        opt.addEventListener('click', () => {
          opts.forEach(o => o.classList.remove('active'));
          opt.classList.add('active');
          const d = data[opt.dataset.period];
          price.textContent  = d.price;
          period.textContent = d.period;
          detail.textContent = d.detail;
          note.innerHTML     = d.note;
        });
      });
    })();
  </script>


