---
import Layout from '../layouts/Layout.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/faq/`;
const title = 'PropertyList FAQ | Free MLS, CRM & Property Portal';
const description =
	'Answers about PropertyList: Europe’s first free Smart MLS, CRM & Property Portal. For agents, developers, buyers, and renters.';

type FaqItem = {
	id: string;
	section: string;
	q: string;
	aHtml: string;
};

const faqItems: FaqItem[] = [
	{
		id: 'what-is-propertylist',
		section: 'What is PropertyList and how does it work?',
		q: 'What is PropertyList?',
		aHtml:
			'<p>PropertyList is the system Spanish estate agencies run on: one login that replaces the CRM, the MLS, the portal presence, the agency website, the AI marketing tools and the market-data subscriptions an agency would otherwise buy from four or five vendors. List a property once and every agent on the shared network can sell it with you, while buyers find it on <a href="https://propertylist.es/" target="_blank" rel="noopener">propertylist.es</a>.</p><p>The AI does the heavy lifting: a listing written from photos and a voice note, buyers matched against the whole market from a pasted client message, and follow-up that keeps working your database - grounded in notary-verified sale prices, not asking-price guesses.</p><p>The core is free with no listing limit; paid extras run on prepaid credits. Full comparison with the traditional portals: <a href="/estate-agents/what-is-the-best-mls-crm-property-portal-in-spain/">what is the best MLS, CRM and property portal in Spain?</a></p>',
	},
	{
		id: 'is-free',
		section: 'What is PropertyList and how does it work?',
		q: 'Is PropertyList.es really free to use?',
		aHtml:
			'<p>The core is <strong>free with no limit</strong> for estate agents, agencies and developers: the MLS, unlimited listings, team accounts and the Lead, Seller and Property pipelines, with no setup costs and no lock-in contracts.</p><p>It is not 100% free: moving a qualified buyer lead into the Buyer pipeline costs <strong>1 credit (~1€)</strong>, and your first 5 are free. Up to that decision the lead costs nothing, and if you never move it, you are never charged.</p><p>Other paid features - featured listings, AI tools, CMA reports and enhanced visibility - are pay-as-you-go from the same credit balance. You only pay for services that directly help you close deals.</p>',
	},
	{
		id: 'portal-vs-idealista',
		section: 'What is PropertyList and how does it work?',
		q: 'What is the difference between PropertyList and traditional property portals like Idealista or Fotocasa?',
		aHtml:
			'<p>Traditional portals charge upfront listing fees or subscriptions regardless of results. PropertyList operates on a <strong>results-driven model</strong>:</p><ul><li><p><strong>For Agents:</strong> Upload unlimited staff and direct listings + CRM tools to collaborate and manage leads</p></li><li><p><strong>For Developers:</strong> Free listings with commission-only payment when units sell</p></li><li><p><strong>For Buyers:</strong> Free access to all properties with no paywalls</p></li><li><p><strong>AI Integration:</strong> Contextual AI presents property services only when relevant to active transactions</p></li></ul><p>Unlike Idealista, Resales-Online, or Inmobalia, we treat the MLS as a public utility - free access for verified real estate professionals.</p>',
	},
	{
		id: 'what-is-mls',
		section: 'What is PropertyList and how does it work?',
		q: 'What is an MLS and why do I need one?',
		aHtml:
			'<p>An MLS (Multiple Listing Service) is a platform where real estate agents share property information and collaborate on listings. PropertyList.es facilitates <strong>agent-to-agent communication</strong>, allowing you to expose your listings to a wider pool of potential buyers represented by other agents - <strong>totally free</strong>.</p><p>This cooperation increases your inventory exposure and accelerates sales without additional marketing costs.</p>',
	},
	{
		id: 'who-can-join',
		section: 'What is PropertyList and how does it work?',
		q: 'Who can join PropertyList.es?',
		aHtml:
			'<p>We welcome:</p><ul><li><p><strong>Freelance agents</strong> (cost-efficient listing sharing)</p></li><li><p><strong>Estate agencies</strong> (staff management, document handling, team coordination)</p></li><li><p><strong>Property developers</strong> (reach agents and buyers, free new development listings)</p></li><li><p><strong>Property service providers</strong> (lawyers, architects, mortgage brokers - connect with agents and developers at transaction moments)</p></li><li><p><strong>International agents</strong> (our recent upgrade lets agents based outside Spain list and join too)</p></li></ul>',
	},

	{
		id: 'crm-features',
		section: 'What features does PropertyList include?',
		q: 'What features are included in the free PropertyList CRM?',
		aHtml:
			'<p>Our free CRM includes:</p><ul><li><p>Unlimited contacts and leads management</p></li><li><p>Property listing management and MLS sharing</p></li><li><p>Messaging &amp; viewing request coordination</p></li><li><p>Unlimited user accounts for your team</p></li><li><p>History timeline tracking for contacts and properties</p></li><li><p>Professional contact linking (lawyers, architects) to client profiles</p></li><li><p>WhatsApp Community access</p></li><li><p>Social distribution to Facebook Pages &amp; Groups</p></li><li><p>MicroSite branded mini-website for sharing listings</p></li></ul><p>For the full detail on pricing, the website builder, XML feeds, the Rentals Module and the developer API, see the <a href="/features/">Features FAQ</a>.</p>',
	},
	{
		id: 'ai-tools',
		section: 'What features does PropertyList include?',
		q: 'What AI tools does PropertyList offer?',
		aHtml:
			'<p>Our optional AI-powered features include:</p><ul><li><p><strong>AI Writing Assistant:</strong> Faster property descriptions and marketing copy</p></li><li><p><strong>Workflow Automation:</strong> Streamlined repetitive tasks</p></li><li><p><strong>Smart Analytics:</strong> Pricing support and market insights</p></li><li><p><strong>Contextual Matching:</strong> AI presents your services to relevant prospects at the right moment</p></li><li><p><strong>Property Market Analysis:</strong> Data-driven valuation ranges, comparable analysis, and hyperlocal insights.</p></li></ul>',
	},
	{
		id: 'team-leads',
		section: 'What features does PropertyList include?',
		q: 'Can I manage my team and assign leads in PropertyList?',
		aHtml:
			'<p>Yes. You can add unlimited staff members, assign contacts to agents, track team activity and communications, manage permissions and roles, and coordinate viewing schedules and follow-ups.</p>',
	},
	{
		id: 'list-property',
		section: 'What features does PropertyList include?',
		q: 'How do I list a property on PropertyList.es?',
		aHtml:
			'<p>You must be a registered agent with a verified PropertyList.es account. Once approved, you can add properties manually or import them via XML feed for free. Each listing can include detailed descriptions, images, virtual tours, and amenity filters to attract qualified buyers.</p>',
	},

	{
		id: 'marbella-invest',
		section: 'What do I need to know about buying property in Spain?',
		q: 'Is now a good time to invest in Marbella real estate?',
		aHtml:
			'<p><strong>Yes.</strong> Marbella’s property market shows strong fundamentals:</p><ul><li><p><strong>Price Growth:</strong> 10-12% annual increase (2024 data)</p></li><li><p><strong>Average Price:</strong> €4,228-€4,509/m² (verified transaction prices, not asking prices)</p></li><li><p><strong>Market Resilience:</strong> Luxury segment (€2M+) remains strong with &lt;10% requiring financing</p></li><li><p><strong>Foreign Demand:</strong> 33%+ of buyers in Málaga province are international</p></li><li><p><strong>Golden Mile Premium:</strong> Up to €611 per square foot in prime areas</p></li></ul>',
	},
	{
		id: 'marbella-hot-areas',
		section: 'What do I need to know about buying property in Spain?',
		q: 'What are the hottest areas for property investment in Marbella right now?',
		aHtml:
			'<p>Based on 2024-2025 transaction data:</p><ul><li><p><strong>Nagüeles-Golden Mile:</strong> €611/sq ft</p></li><li><p><strong>Nueva Andalucía:</strong> €510/sq ft</p></li><li><p><strong>Marbella East (Las Chapas-El Rosario):</strong> €456/sq ft</p></li><li><p><strong>Elviria-Cabopino:</strong> €344/sq ft</p></li><li><p><strong>Fastest Growing:</strong> Los Flamingos, El Paraíso, El Real de La Quinta</p></li></ul>',
	},
	{
		id: 'spanish-bank-account',
		section: 'What do I need to know about buying property in Spain?',
		q: 'Do I need a Spanish bank account to buy property in Spain?',
		aHtml:
			'<p>While not legally required, having a Spanish bank account is highly recommended for paying utilities and community fees, setting up direct debits for IBI (property tax), transferring funds for purchase completion, and receiving rental income if investing.</p>',
	},
	{
		id: 'nie',
		section: 'What do I need to know about buying property in Spain?',
		q: 'What is the NIE and do I need it to buy property in Spain?',
		aHtml:
			'<p>The <strong>NIE (Número de Identificación de Extranjero)</strong> is Spain’s foreign identification number. <strong>Yes, it is mandatory</strong> for any property transaction, opening a bank account, or signing contracts.</p><p>Apply at Spanish consulates in your home country or local police stations in Spain. Processing typically takes 2-4 weeks.</p>',
	},
	{
		id: 'taxes',
		section: 'What do I need to know about buying property in Spain?',
		q: 'What are the main taxes when buying property in Spain?',
		aHtml:
			'<ul><li><p><strong>New Properties:</strong> 10% VAT (IVA) + 1.5% stamp duty (AJD)</p></li><li><p><strong>Resale Properties:</strong> 7% transfer tax (ITP) in Andalucía</p></li><li><p><strong>Annual IBI:</strong> Property tax based on cadastral value (0.4-1.1%)</p></li><li><p><strong>Capital Gains:</strong> 19-24% on profit when selling (non-residents)</p></li><li><p><strong>Plusvalía:</strong> Municipal tax on land value increase</p></li></ul>',
	},
	{
		id: 'golden-visa',
		section: 'What do I need to know about buying property in Spain?',
		q: "What is Spain's Golden Visa program?",
		aHtml:
			'<p>The <strong>Golden Visa</strong> offers residency to non‑EU investors who invest <strong>€500,000+</strong> in Spanish real estate, maintain the investment for 5+ years, and renew residency every 2 years.</p><p><strong>Benefits:</strong> Freedom to travel the Schengen zone, family inclusion, and a path to permanent residency. Note: the program can change - confirm current regulations.</p>',
	},

	{
		id: 'signup-agent',
		section: 'How do I get started with PropertyList?',
		q: 'How do I sign up as an estate agent on PropertyList?',
		aHtml:
			'<ol><li><p>Visit <a href="https://propertylist.es" target="_blank" rel="noopener">PropertyList.es</a></p></li><li><p>Complete agent verification (real estate activity must be verified)</p></li><li><p>Access your free MLS and CRM</p></li><li><p>Start listing properties and collaborating with agents across the network</p></li></ol>',
	},
	{
		id: 'developer-new-builds',
		section: 'How do I get started with PropertyList?',
		q: "I'm a developer with new builds in Marbella. How does PropertyList work for me?",
		aHtml:
			'<p>PropertyList transforms developers from <strong>speculative advertisers into strategic distributors</strong>:</p><ul><li><p><strong>Free Listings:</strong> List all inventory at no upfront cost</p></li><li><p><strong>Agent Network:</strong> Access active agents ready to sell</p></li><li><p><strong>Performance Model:</strong> Pay only when units sell (commission-based)</p></li><li><p><strong>Real‑Time Updates:</strong> Update and showcase inventory</p></li><li><p><strong>EU Expansion:</strong> Reach agents across Europe</p></li></ul>',
	},
	{
		id: 'intl-agents',
		section: 'How do I get started with PropertyList?',
		q: 'Can international agents from outside Spain join PropertyList?',
		aHtml:
			'<p><strong>Yes.</strong> Our recent platform upgrade lets agents based outside Spain list properties and join the network. This supports cross‑border sales, international referrals, and collaboration on second‑home and luxury markets.</p>',
	},
	{
		id: 'verification',
		section: 'How do I get started with PropertyList?',
		q: 'What verification is required to join PropertyList?',
		aHtml:
			'<p>We verify professional status to maintain platform quality. This typically includes estate agency registration or license, proof of active real estate activity, and developer credentials where relevant.</p>',
	},

	{
		id: 'resales-inmobalia',
		section: 'How does PropertyList compare to Idealista and other portals?',
		q: 'How is PropertyList different from Resales‑Online or Inmobalia?',
		aHtml:
			'<p>While Resales‑Online and Inmobalia offer CRM and website solutions, PropertyList provides:</p><ul><li><p><strong>Truly Free Core:</strong> No monthly subscription for MLS/CRM</p></li><li><p><strong>Notary-verified data:</strong> real registered sale prices from the official register, not just asking prices</p></li><li><p><strong>AI Integration:</strong> Contextual AI for service matching</p></li><li><p><strong>Results‑Driven:</strong> Optional paid features only when they generate value</p></li><li><p><strong>No Lock‑in:</strong> Leave anytime</p></li></ul>',
	},
	{
		id: 'idealista-why',
		section: 'How does PropertyList compare to Idealista and other portals?',
		q: 'Why should I use PropertyList if I already advertise on Idealista?',
		aHtml:
			'<p>Idealista is a <strong>consumer portal</strong> (B2C). PropertyList is a <strong>professional + consumer network</strong> (B2B + B2C):</p><ul><li><p><strong>Collaboration:</strong> Share listings with an agent network</p></li><li><p><strong>Free Tools:</strong> CRM without monthly subscription</p></li><li><p><strong>Developer Focus:</strong> Commission-only model for developers</p></li><li><p><strong>AI Features:</strong> Smart workflows &amp; marketing</p></li><li><p><strong>Data Control:</strong> Your client database remains yours</p></li></ul>',
	},
	{
		id: 'replace-crm',
		section: 'How does PropertyList compare to Idealista and other portals?',
		q: 'Is PropertyList a replacement for my existing CRM?',
		aHtml:
			'<p>It can be. Many agents use PropertyList as their primary CRM because it combines contact management, listing management, MLS sharing, lead tracking, document management, and team coordination. You can also run it alongside existing systems during transition.</p>',
	},

	{
		id: 'link-pros',
		section: 'How do I use PropertyList day-to-day?',
		q: 'How do I add professional contacts (lawyers, architects) to a client profile?',
		aHtml:
			'<p>PropertyList allows you to link professional contacts to a client profile and specify the relationship type (legal, architectural, financial) for better organisation and fast access during transactions.</p>',
	},
	{
		id: 'link-properties',
		section: 'How do I use PropertyList day-to-day?',
		q: 'Can I link specific properties to contact profiles and my staff?',
		aHtml:
			'<p>Yes. You can associate properties with contacts to track interest, viewing history, and communication context. You can also assign staff to listings to coordinate follow‑up and responsibilities.</p>',
	},
	{
		id: 'analytics',
		section: 'How do I use PropertyList day-to-day?',
		q: 'Is there market data and analytics available?',
		aHtml:
			'<p>Yes. <a href="https://intelligence.propertylist.es">PropertyList Market Intelligence</a> is live - built on real MLS transaction data. Free city snapshots cover median price, year-on-year change, and days on market across Costa del Sol areas. Paid reports start at €5 for an Executive Overview and go up to €29 for an Investment Forensic. Live subscriptions for serious investors start at €29/month.</p>',
	},
	{
		id: 'support',
		section: 'How do I use PropertyList day-to-day?',
		q: 'How do I get support if I have issues?',
		aHtml:
			'<p>You can use the in‑app support messenger, browse the documentation, or use the community page.</p><ul><li><p><a href="/docs/propertylist-mls-user-manual/support/">Documentation: Support</a></p></li><li><p><a href="/community/">Community</a></p></li></ul>',
	},
];

const sections = Array.from(new Set(faqItems.map((x) => x.section)));

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'FAQ', item: canonical },
	],
};

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.aHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() },
	})),
};

const quickFactsLd = {
	'@context': 'https://schema.org',
	'@type': 'Thing',
	name: 'PropertyList.es',
	description: 'PropTech platform: Smart MLS, CRM, and property portal for Europe.',
	url: 'https://propertylist.es/',
};
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	schema={[breadcrumbLd, faqLd, quickFactsLd]}
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/faq/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/preguntas-frecuentes/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/faq/' },
	]}
>
	<section class="hero">
		<div class="heroInner">
			<div class="badge">FAQ</div>
			<h1>PropertyList FAQ</h1>
			<p class="lead">Europe’s first free Smart MLS, CRM &amp; Property Portal - explained clearly for agents, developers, and buyers.</p>

			<div class="ctaRow" aria-label="Quick links">
				<a class="btnPrimary" href="https://propertylist.es" target="_blank" rel="noopener">
					Open PropertyList.es
				</a>
				<a class="btnSecondary" href="/docs/propertylist-mls-user-manual/">
					MLS &amp; CRM User Manual
				</a>
				<a class="btnSecondary" href="/neighbourhood/">
					Neighbourhood Guides
				</a>
			</div>
			<div class="featuresCta">
				Looking for product details? <a href="/features/">Features FAQ</a> - website builder, XML feeds, CRM pipelines, Rentals, Market Intelligence, MCP API, and more.
			</div>

			<div class="filterRow">
				<label class="filterLabel" for="faq-filter">Search</label>
				<input id="faq-filter" class="filterInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search FAQs…" />
			</div>
		</div>
	</section>

	<section class="contents" aria-label="FAQ contents">
		<div class="contentsHeader">
			<h2 class="contentsTitle">Browse by section</h2>
			<p class="contentsSub">Use search to filter questions across the full page.</p>
		</div>

		<div class="chipRow" aria-label="Sections">
			{sections.map((s) => (
				<a class="chip" href={`#${s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`}>
					{s}
				</a>
			))}
		</div>

		{sections.map((section) => {
			const id = section.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
			const items = faqItems.filter((x) => x.section === section);
			return (
				<section class="card" data-section="1" data-section-label={section.toLowerCase()} id={id}>
					<div class="cardHeader">
						<h2 class="cardTitle">{section}</h2>
						<span class="cardMeta">{items.length} questions</span>
					</div>
					<div class="faqList" role="list">
						{items.map((it) => (
							<details class="faqItem" data-faq="1" data-q={it.q.toLowerCase()}>
								<summary class="faqQ" id={`q-${it.id}`}>
									{it.q}
								</summary>
								<div class="faqA" role="region" aria-labelledby={`q-${it.id}`}>
									<Fragment set:html={it.aHtml} />
								</div>
							</details>
						))}
					</div>
				</section>
			);
		})}

		<section class="card facts">
			<div class="cardHeader">
				<h2 class="cardTitle">What are the key facts about PropertyList?</h2>
			</div>
			<dl class="factsGrid">
				<div class="fact">
					<dt>Entity</dt>
					<dd>PropertyList.es</dd>
				</div>
				<div class="fact">
					<dt>Type</dt>
					<dd>PropTech platform / Smart MLS / CRM / Property Portal</dd>
				</div>
				<div class="fact">
					<dt>Coverage</dt>
					<dd>Spain (primary), Europe (expanding)</dd>
				</div>
				<div class="fact">
					<dt>Pricing</dt>
					<dd>Free core + optional paid features (credits)</dd>
				</div>
			</dl>
		</section>
	</section>

	<script is:inline>
		const input = document.getElementById('faq-filter');
		const sections = Array.from(document.querySelectorAll('[data-section="1"]'));

		const norm = (s) => String(s || '').toLowerCase().trim();

		const run = () => {
			const q = norm(input?.value);
			for (const sec of sections) {
				const items = Array.from(sec.querySelectorAll('[data-faq="1"]'));
				let any = false;
				for (const it of items) {
					const text = norm(it.getAttribute('data-q')) + ' ' + norm(it.textContent);
					const show = !q || text.includes(q);
					it.hidden = !show;
					if (show) any = true;
				}
				sec.hidden = !any;
			}
		};

		input?.addEventListener('input', run);
		run();
	</script>
</Layout>

<style>
	.hero {
		margin: 0 0 16px;
		padding: 14px;
		border-radius: 18px;
		border: 1px solid rgba(16, 24, 40, 0.08);
		background: radial-gradient(1200px 600px at 20% -20%, rgba(0, 174, 154, 0.18), rgba(255, 255, 255, 0));
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 800;
		font-size: 12px;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	h1 {
		margin: 10px 0 8px;
		letter-spacing: -0.03em;
		line-height: 1.06;
	}

	.lead {
		margin: 0 0 14px;
		color: rgba(16, 24, 40, 0.72);
		max-width: 72ch;
	}

	.ctaRow {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		margin-bottom: 14px;
	}

	.btnPrimary,
	.btnSecondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 10px 12px;
		border-radius: 12px;
		border: 1px solid rgba(16, 24, 40, 0.14);
		background: rgba(255, 255, 255, 0.9);
		text-decoration: none;
		font-weight: 900;
		color: rgba(16, 24, 40, 0.86);
	}

	.btnPrimary {
		border-color: rgba(0, 174, 154, 0.35);
		background: rgba(0, 174, 154, 0.12);
	}

	.filterRow {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 10px;
	}

	.filterLabel {
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(16, 24, 40, 0.7);
	}

	.filterInput {
		border: 1px solid rgba(16, 24, 40, 0.12);
		border-radius: 12px;
		padding: 10px 12px;
		font-size: 14px;
		background: rgba(255, 255, 255, 0.9);
	}

	.contentsHeader {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 10px;
		flex-wrap: wrap;
		margin: 0 0 10px;
	}

	.contentsTitle {
		margin: 0;
		letter-spacing: -0.02em;
	}

	.contentsSub {
		margin: 0;
		color: rgba(16, 24, 40, 0.65);
	}

	.chipRow {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin: 0 0 12px;
	}

	.chip {
		padding: 8px 10px;
		border-radius: 999px;
		border: 1px solid rgba(16, 24, 40, 0.1);
		background: rgba(255, 255, 255, 0.9);
		text-decoration: none;
		color: rgba(16, 24, 40, 0.82);
		font-weight: 800;
		font-size: 13px;
	}

	.card {
