---
// "Pick your poison" - the pain-first router built as a shareable tally.
// Tick what you hate, the hours mount up, the receipt prints the damage and the
// fix for each pain. Everything (pains AND fixes) ships in static HTML so search
// and AI crawlers read all sixteen first-person pain phrases; JS only enhances.
// Hours are per-week defaults the visitor can adjust - their number, not ours.
import Layout from '../layouts/Layout.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/hours/`;

// Share links carry ?h=N so the OG preview in the group chat shows THEIR number.
const sharedH = Math.min(120, Math.max(0, parseInt(Astro.url.searchParams.get('h') || '0', 10) || 0));
const title = sharedH
	? `I lose ${sharedH} hours a week to admin. What do you lose?`
	: 'Pick your poison: what does admin really cost you a week?';
const description =
	'Tick everything you hate doing as an estate agent - listings at 11pm, chasing signatures, re-typing portals - and see the weekly hours it takes. Then see the fix for each one.';
const ogImage = sharedH ? `${origin}/api/og-hours.png?h=${sharedH}&v=2` : `${origin}/api/og-hours.png?v=2`;

type Pain = {
	id: string;
	label: string;
	hours: number; // typical h/week, deliberately conservative
	fix: string;
	fixHref: string;
	fixLine: string;
	soon?: boolean;
};

type Cost = {
	id: string;
	label: string;
	tag: string; // what it actually costs: DEALS or MONEY
	sting: string;
	fix: string;
	fixHref: string;
	fixLine: string;
	soon?: boolean;
};

const pains: Pain[] = [
	{ id: 'listings', label: 'Writing listings at 11pm', hours: 2, fix: 'Instant Listing', fixHref: '/instant-listing/', fixLine: 'Photos plus a voice note become a finished listing. Free.', afterMin: 15 },
	{ id: 'portals', label: 'Re-typing the same flat into five portals', hours: 2, fix: 'XML feeds', fixHref: '/xml-feed-import/', fixLine: 'One feed in, every portal out. Free both ways.', afterMin: 0 },
	{ id: 'website', label: 'Nagging a developer about my website', hours: 1, fix: 'Website Builder', fixHref: '/website-builder/', fixLine: 'Type what you want, the AI builds it. Free until you publish.', afterMin: 10 },
	{ id: 'followup', label: 'Remembering who I promised to call back', hours: 3, fix: 'Nurture', fixHref: '/nurture/', fixLine: 'Follow-ups send themselves. You get told who is ready. 20 credits a month.', afterMin: 15 },
	{ id: 'valuation', label: 'Arguing with a vendor about their price', hours: 2, fix: 'Property Intelligence Report', fixHref: '/property-intelligence-report/', fixLine: 'Bring the notarial register. First 3 reports free.', afterMin: 30 },
	{ id: 'matching', label: "Scrolling portals to find a buyer's match", hours: 2, fix: 'AI Property Match', fixHref: '/ai-property-search/', fixLine: 'Paste the WhatsApp, get the matches. Free in beta.', afterMin: 10 },
	{ id: 'callnotes', label: 'Typing up calls I already said out loud', hours: 2, fix: 'CoAgent', fixHref: '/coagent/', fixLine: 'Hang up, the write-up is done.', soon: true, afterMin: null },
	{ id: 'signatures', label: 'Chasing one signature for a week', hours: 1, fix: 'Instant Documents', fixHref: '/instant-documents/', fixLine: 'Signed on any phone before you leave the viewing.', soon: true, afterMin: null },
	{ id: 'tenants', label: 'Tenancies living in a spreadsheet', hours: 2, fix: 'Rentals Module', fixHref: '/rentals/', fixLine: 'Tenancies, renewals, maintenance. 30-day free trial.', afterMin: 30 },
	{ id: 'brochures', label: 'Making brochures in Canva at midnight', hours: 1, fix: 'Instant Brochure', fixHref: '/instant-brochure/', fixLine: 'One click. Print PDF plus a live web version.', soon: true, afterMin: null },
	{ id: 'desk', label: 'Driving back to the office to use the CRM', hours: 1, fix: 'Mobile app', fixHref: '/mobile-app/', fixLine: 'The MLS and CRM in your pocket. Free on Android.', afterMin: 0 },
];

// Not hours. These cost deals or money, so they are ticked, never timed:
// putting an invented hours figure on them was the one dishonest thing
// on a page whose whole argument is that we counted honestly.
const costs: Cost[] = [
	{ id: 'exposure', label: 'Listings only my own buyers ever see', tag: 'DEALS', sting: 'One buyer pool, when there could be 1,300 agents.', fix: 'MLS sharing', fixHref: '/launch/', fixLine: 'List once, 1,300+ agents can sell it with you.' },
	{ id: 'own-stock', label: 'A website with only my own stock on it', tag: 'DEALS', sting: 'Buyers leave to find what you do not list.', fix: 'Network XML feed', fixHref: '/features/#topic-xml', fixLine: 'Every listing on the network, on your site, in sync.' },
	{ id: 'market', label: 'Guessing what the market is actually doing', tag: 'DEALS', sting: 'Priced on a hunch, sold at a discount.', fix: 'Live market data', fixHref: '/neighbourhood/', fixLine: 'Notary-verified prices for every area. Free.' },
	{ id: 'blog', label: 'A blog I have not touched since March', tag: 'DEALS', sting: 'Costs you 0h a week. That is the problem.', fix: 'Instant Content', fixHref: '/instant-content/', fixLine: 'SEO posts and area guides write themselves.' },
	{ id: 'invoices', label: 'Juggling five subscriptions to do one job', tag: 'MONEY', sting: 'Five bills where one login would do.', fix: "Everything that's free", fixHref: '/free/', fixLine: 'MLS, CRM, website, feeds. One login, core free.' },
];

const totalDefault = pains.reduce((a, p) => a + p.hours, 0);

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: pains.slice(0, 8).map((p) => ({
		'@type': 'Question',
		name: `How do estate agents in Spain stop ${p.label.toLowerCase().replace(/^a /, '').replace(/^my /, '')}?`,
		acceptedAnswer: { '@type': 'Answer', text: `${p.fix} on PropertyList: ${p.fixLine}` },
	})),
};
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	ogImage={ogImage}
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/horas/` },
		{ hreflang: 'x-default', href: canonical },
	]}
	schema={faqLd}
>
	<div class="poison">
		<section class="pHero">
			<div class="pKick">The admin tax &middot; a 60-second audit</div>
			<h1>Pick your poison.</h1>
			<p class="pLead">
				Tick everything you hate doing. We will total what it costs you every week - and show you the fix for each one.
				The hours are typical; drag them to match your week.
			</p>
		</section>

		<div class="sharedNote" data-shared-note hidden>
			<span>You are looking at someone else&rsquo;s bill (<b data-shared-h>0</b>h a week).</span>
			<button type="button" data-shared-clear>Clear it and make your own</button>
		</div>

		<section class="pList" aria-label="The pains">
			<ul>
				{pains.map((p) => (
					<li class="pain" data-pain={p.id} data-hours={p.hours} data-after={String(p.afterMin)}>
						<button class="painBtn" type="button" aria-pressed="false">
							<span class="painCheck" aria-hidden="true"></span>
							<span class="painLabel">{p.label}</span>
							<span class="painHours"><b>{p.hours}h</b>/wk</span>
						</button>
						<div class="painMore">
							<label class="painSlider">
								<span>My week: <b class="painVal">{p.hours}</b>h</span>
								<input type="range" min="0" max="10" step="1" value={p.hours} aria-label={`Hours per week spent on: ${p.label}`} />
							</label>
							<a class="painFix" href={p.fixHref}>
								<span class="fixKick">The fix{p.soon ? ' - coming soon' : ''}</span>
								<span class="fixName">{p.fix} &rarr;</span>
								<span class="fixLine">{p.fixLine}</span>
							</a>
						</div>
					</li>
				))}
			</ul>
		</section>


		<section class="cList" aria-label="Not hours. Still costing you.">
			<div class="cHead">
				<span class="cKick">Not hours. Still costing you.</span>
				<p class="cLead">These four cost you deals and one costs you money. None of them cost you hours, so none of them touch the number above.</p>
			</div>
			<ul>
				{costs.map((c) => (
					<li class="cost" data-cost={c.id}>
						<button class="costBtn" type="button" aria-pressed="false">
							<span class="painCheck" aria-hidden="true"></span>
							<span class="painLabel">{c.label}</span>
							<span class="costTag">{c.tag}</span>
						</button>
						<div class="painMore">
							<p class="costSting">{c.sting}</p>
							<a class="painFix" href={c.fixHref}>
								<span class="fixKick">The fix{c.soon ? ' - coming soon' : ''}</span>
								<span class="fixName">{c.fix} &rarr;</span>
								<span class="fixLine">{c.fixLine}</span>
							</a>
						</div>
					</li>
				))}
			</ul>
		</section>

		<div class="tally" data-tally hidden>
			<div class="tallyIn">
				<span class="tallyNum"><b data-tally-h>0</b>h<i>/week</i></span>
				<span class="tallyLabel">lost to admin</span>
				<a class="tallyGo" href="#receipt">See the bill &darr;</a>
			</div>
		</div>

		<section class="receiptWrap" id="receipt">
			<div class="receipt" data-receipt hidden>
				<div class="rHead">
					<span class="rBrand">PROPERTYLIST</span>
					<span class="rSub">THE ADMIN TAX &middot; WEEKLY BILL</span>
				</div>
				<div data-hours-block hidden>
					<ul class="rLines" data-receipt-lines>
						{pains.map((p) => (
							<li data-rl={p.id} hidden>
								<span>{p.label}</span>
								<span class="rlNums"><b data-rl-h>{p.hours}H</b><i class="rlArrow">&rarr;</i><em data-rl-a>{p.afterMin === null ? 'SOON' : p.afterMin === 0 ? '0' : `${p.afterMin}M`}</em></span>
							</li>
						))}
					</ul>
					<div class="rTotal">
						<span>TODAY</span>
						<span><b data-receipt-h>0</b>H / WEEK</span>
					</div>
					<div class="rTotal rTotalPl">
						<span>WITH PROPERTYLIST</span>
						<span><b data-receipt-pl>0</b> / WEEK</span>
					</div>
					<div class="rBack">
						<span>YOU GET BACK</span>
						<span><b data-receipt-back>0</b> / WEEK</span>
					</div>
					<div class="rDays rDaysBack">= <b data-receipt-days>0</b> working days a year, yours again</div>
					<div class="rSoonNote" data-soon-note hidden>SOON lines count at full cost - that time comes back when they ship.</div>
					<div class="rHeavy" data-heavy-note hidden>That is more than most working weeks. We believe you. Unfortunately.</div>
				</div>
				<div class="rDeals" data-deals-block hidden>
					<div class="rDealsHead">NOT HOURS. STILL COSTING YOU.</div>
					<ul class="rDealLines" data-deal-lines>
						{costs.map((c) => (
							<li data-dl={c.id} hidden>
								<span>{c.label}</span>
								<span class="dlTag">{c.tag}</span>
							</li>
						))}
					</ul>
					<div class="rDealsFoot">These were never about time.</div>
				</div>
				<div class="rFoot">Every line above has a fix on PropertyList. The core is free.</div>
				<div class="rActions">
					<button class="rShare" type="button" data-share-wa>Share your bill on WhatsApp</button>
					<button class="rCopy" type="button" data-share-copy>Copy link</button>
				</div>
				<button class="rReset" type="button" data-reset>Start again</button>
				<a class="rCta" href="https://agents.propertylist.es/new_agency/new?locale=en" target="_blank" rel="noopener" data-umami-event="hours-cta">Take your evenings back - join free</a>
			</div>
			<div class="rEmpty" data-receipt-empty>
				<p>Tick a few poisons above and your bill prints here.</p>
			</div>
		</section>

		<section class="pFootnote">
			<p>
				Typical hours are conservative estimates for a working agent; your sliders make the number yours. Fixes marked
				coming soon are in build - <a href="https://agents.propertylist.es/new_agency/new?locale=en" target="_blank" rel="noopener">join free</a>
				and you have them first. Nothing on this page needs a card.
			</p>
		</section>
	</div>

	<script is:inline>
		(() => {
			const pains = Array.from(document.querySelectorAll('.pain'));
			const tally = document.querySelector('[data-tally]');
			const tallyH = document.querySelector('[data-tally-h]');
			const receipt = document.querySelector('[data-receipt]');
			const rEmpty = document.querySelector('[data-receipt-empty]');
			const rLines = document.querySelector('[data-receipt-lines]');
			const rH = document.querySelector('[data-receipt-h]');
			const rDays = document.querySelector('[data-receipt-days]');
			const state = new Map();
			// ticked-but-not-timed items; never enter the hours total
			const dealState = new Set();
			const costEls = Array.from(document.querySelectorAll('[data-cost]'));
			const dealLines = document.querySelector('[data-deal-lines]');
			const hoursBlock = document.querySelector('[data-hours-block]');
			const dealsBlock = document.querySelector('[data-deals-block]');

			const track = (n, d) => { try { if (window.umami && umami.track) umami.track(n, d); } catch (e) {} };

			const total = () => Array.from(state.values()).reduce((a, b) => a + b, 0);

			const render = () => {
				const t = total();
				const anyTime = state.size > 0;
				const anyDeal = dealState.size > 0;
				const on = anyTime || anyDeal;
				tally.hidden = !anyTime;
				receipt.hidden = !on;
				rEmpty.hidden = on;
				hoursBlock.hidden = !anyTime;
				dealsBlock.hidden = !anyDeal;
				document.querySelector('[data-heavy-note]').hidden = t <= 50;
				for (const row of dealLines.querySelectorAll('[data-dl]')) row.hidden = !dealState.has(row.dataset.dl);
				tallyH.textContent = t;
				rH.textContent = t;
				let plMin = 0, anySoon = false;
				for (const li of pains) {
					const id = li.dataset.pain;
					if (!state.has(id)) continue;
					const a = li.dataset.after;
					if (a === 'null') { plMin += state.get(id) * 60; anySoon = true; }
					else plMin += parseInt(a, 10);
				}
				const backMin = Math.max(0, t * 60 - plMin);
				const fmt = (m) => m < 60 ? m + 'M' : (Math.round((m / 60) * 2) / 2) + 'H';
				document.querySelector('[data-receipt-pl]').textContent = fmt(plMin);
				document.querySelector('[data-receipt-back]').textContent = fmt(backMin);
				document.querySelector('[data-soon-note]').hidden = !anySoon;
				rDays.textContent = Math.round((backMin / 60) * 46 / 8);
				for (const row of rLines.querySelectorAll('[data-rl]')) {
					const id = row.dataset.rl;
					row.hidden = !state.has(id);
					if (state.has(id)) row.querySelector('[data-rl-h]').textContent = state.get(id) + 'H';
				}
			};

			const shareUrl = () => {
				const ids = pains.filter((li) => state.has(li.dataset.pain)).map((li) => li.dataset.pain)
					.concat(costEls.filter((li) => dealState.has(li.dataset.cost)).map((li) => li.dataset.cost));
				const u = new URL(location.origin + location.pathname);
				if (ids.length) { u.searchParams.set('p', ids.join('.')); u.searchParams.set('h', String(total())); }
				return u.toString();
			};

			for (const li of pains) {
				const btn = li.querySelector('.painBtn');
				const slider = li.querySelector('input[type=range]');
				const val = li.querySelector('.painVal');
				btn.addEventListener('click', () => {
					const id = li.dataset.pain;
					if (state.has(id)) {
						state.delete(id);
						li.classList.remove('isOn');
						btn.setAttribute('aria-pressed', 'false');
					} else {
						state.set(id, parseInt(slider.value, 10));
						li.classList.add('isOn');
						btn.setAttribute('aria-pressed', 'true');
						track('hours-pick', { pain: id });
					}
					render();
				});
				slider.addEventListener('input', () => {
					val.textContent = slider.value;
					if (state.has(li.dataset.pain)) { state.set(li.dataset.pain, parseInt(slider.value, 10)); render(); }
				});
			}

			for (const li of costEls) {
				const btn = li.querySelector('.costBtn');
				btn.addEventListener('click', () => {
					const id = li.dataset.cost;
					if (dealState.has(id)) {
						dealState.delete(id);
						li.classList.remove('isOn');
						btn.setAttribute('aria-pressed', 'false');
					} else {
						dealState.add(id);
						li.classList.add('isOn');
						btn.setAttribute('aria-pressed', 'true');
						track('hours-pick', { pain: id, kind: 'cost' });
					}
					render();
				});
			}

			document.querySelector('[data-share-wa]').addEventListener('click', () => {
				const t = total();
				track('hours-share', { via: 'whatsapp', h: t });
				const msg = (t > 0
					? 'Apparently I lose ' + t + ' hours a week to admin. What do you lose? '
					: 'Admin is not even my problem. Missed deals are. What is yours? ') + shareUrl();
				window.open('https://wa.me/?text=' + encodeURIComponent(msg), '_blank', 'noopener');
			});
			document.querySelector('[data-share-copy]').addEventListener('click', (e) => {
				track('hours-share', { via: 'copy', h: total() });
				navigator.clipboard && navigator.clipboard.writeText(shareUrl());
				e.target.textContent = 'Copied';
				setTimeout(() => { e.target.textContent = 'Copy link'; }, 1600);
			});

			const clearAll = () => {
				for (const li of pains) {
					if (state.has(li.dataset.pain)) li.querySelector('.painBtn').click();
				}
				for (const li of costEls) {
					if (dealState.has(li.dataset.cost)) li.querySelector('.costBtn').click();
				}
				history.replaceState(null, '', location.pathname);
			};
			document.querySelector('[data-reset]').addEventListener('click', () => { clearAll(); track('hours-reset'); });

			// restore a shared selection, but say whose it is and offer a clean start
			const q = new URLSearchParams(location.search);
			if (q.get('p')) {
				const ids = q.get('p').split('.');
				for (const li of pains) {
					if (ids.includes(li.dataset.pain)) li.querySelector('.painBtn').click();
				}
				for (const li of costEls) {
					if (ids.includes(li.dataset.cost)) li.querySelector('.costBtn').click();
				}
				const note = document.querySelector('[data-shared-note]');
				note.hidden = false;
				note.querySelector('[data-shared-h]').textContent = String(total());
				note.querySelector('[data-shared-clear]').addEventListener('click', () => {
					clearAll();
					note.hidden = true;
					track('hours-shared-clear');
					document.querySelector('.pList').scrollIntoView({ behavior: 'smooth' });
				});
			}
		})();
	</script>
</Layout>

<style>
	.poison { max-width: 780px; margin: 0 auto; padding: 8px 4px 60px; }

	.pHero { text-align: center; padding: 26px 12px 22px; }
	.pKick { display: inline-block; font-size: 11.5px; font-weight: 900; letter-spacing: 0.14em; text-transform: uppercase; color: #0a6d61; background: rgba(0, 174, 154, 0.1); border: 1px solid rgba(0, 174, 154, 0.25); padding: 6px 12px; border-radius: 999px; margin-bottom: 14px; }
	.pHero h1 { font-size: clamp(38px, 7vw, 64px); letter-spacing: -0.03em; margin: 0 0 10px; }
	.pLead { max-width: 54ch; margin: 0 auto; color: rgba(16, 24, 40, 0.68); line-height: 1.6; font-size: 16.5px; }

	.pList ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
	.pain { border: 1px solid rgba(16, 24, 40, 0.1); border-radius: 16px; background: #fff; overflow: hidden; transition: border-color 0.2s, box-shadow 0.2s; }
	.pain.isOn { border-color: rgba(0, 174, 154, 0.55); box-shadow: 0 6px 22px rgba(0, 174, 154, 0.1); }
	.painBtn { display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; background: none; border: 0; padding: 16px 18px; cursor: pointer; font: inherit; }
	.painCheck { flex: none; width: 26px; height: 26px; border-radius: 9px; border: 2px solid rgba(16, 24, 40, 0.22); display: grid; place-items: center; transition: all 0.18s; }
	.pain.isOn .painCheck { background: #00ae9a; border-color: #00ae9a; }
	.pain.isOn .painCheck::after { content: '✕'; color: #fff; font-weight: 900; font-size: 14px; }
	.painLabel { flex: 1; font-weight: 700; font-size: 16.5px; letter-spacing: -0.01em; color: #101828; position: relative; }
	.painLabel::after { content: ''; position: absolute; left: 0; top: 55%; height: 2.5px; width: 100%; background: #0a6d61; transform: scaleX(0); transform-origin: left; transition: transform 0.35s cubic-bezier(0.6, 0, 0.2, 1); }
	.pain.isOn .painLabel { color: rgba(16, 24, 40, 0.5); }
	.pain.isOn .painLabel::after { transform: scaleX(1); }
	.painHours { flex: none; font-size: 13px; color: rgba(16, 24, 40, 0.5); }
	.painHours b { color: #0a6d61; font-size: 16px; }

	.painMore { display: none; padding: 0 18px 16px 58px; }
	.pain.isOn .painMore { display: grid; gap: 12px; animation: drop 0.25s ease; }
	@keyframes drop { from { opacity: 0; transform: translateY(-6px); } }
	.painSlider { display: flex; align-items: center; gap: 12px; font-size: 13.5px; color: rgba(16, 24, 40, 0.6); }
	.painSlider b { color: #0a6d61; }
	.painSlider input { flex: 1; accent-color: #00ae9a; }
	.painFix { display: block; text-decoration: none; border: 1px solid rgba(0, 174, 154, 0.3); background: rgba(0, 174, 154, 0.06); border-radius: 12px; padding: 10px 14px; }
	.painFix:hover { background: rgba(0, 174, 154, 0.12); }
	.fixKick { display: block; font-size: 10.5px; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(10, 109, 97, 0.7); }
	.fixName { display: block; font-weight: 800; color: #0a6d61; margin: 2px 0; }
	.fixLine { display: block; font-size: 13.5px; color: rgba(16, 24, 40, 0.65); }

	.tally { position: sticky; bottom: 14px; z-index: 40; display: flex; justify-content: center; margin: 18px 0; pointer-events: none; }
	.tallyIn { pointer-events: auto; display: flex; align-items: center; gap: 14px; background: #0b1220; color: #fff; border-radius: 999px; padding: 10px 10px 10px 20px; box-shadow: 0 14px 40px rgba(11, 18, 32, 0.35); }
	.tallyNum { font-size: 24px; font-weight: 900; letter-spacing: -0.02em; }
	.tallyNum i { font-style: normal; font-size: 12px; font-weight: 600; opacity: 0.6; }
	.tallyLabel { font-size: 12.5px; opacity: 0.7; }
	.tallyGo { background: #00ae9a; color: #00100e; font-weight: 800; font-size: 13.5px; text-decoration: none; padding: 9px 16px; border-radius: 999px; }

	.receiptWrap { margin: 34px auto 0; max-width: 430px; }
