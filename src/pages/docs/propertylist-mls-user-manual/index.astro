---
import Layout from '../../../layouts/Layout.astro';
import {
	listKbPagesByPrefixes,
	mapDocsEnglishToSpanishPath,
	mapDocsSpanishToEnglishPath,
} from '../../../lib/directus';
import { getKbTreeOrderSnapshot, sortPathsWithOrder } from '../../../lib/kbTreeOrder';

const base = '/docs/propertylist-mls-user-manual/';
const aiAgentDocPath = '/docs/propertylist-mls-user-manual/ai-and-automation/ai-property-research-agent/';
const aiAgentExternalHref = 'https://ai.propertylist.es/how-it-works';
const externalHrefForDocPath = (p: string) => (p === aiAgentDocPath ? aiAgentExternalHref : null);

const itemsFromDirectusRaw = await listKbPagesByPrefixes({
	prefixes: [base, mapDocsEnglishToSpanishPath(base), `/es${base}`],
	lang: 'en',
	limit: 2000,
});
const itemsFromDirectus = (() => {
	const byPath = new Map<string, (typeof itemsFromDirectusRaw)[number]>();
	const sorted = [...itemsFromDirectusRaw].sort((a, b) => {
		const aOk = a.path.startsWith('/docs/');
		const bOk = b.path.startsWith('/docs/');
		if (aOk !== bOk) return aOk ? -1 : 1;
		return a.path.localeCompare(b.path);
	});
	for (const p of sorted) {
		const canonicalPath = p.path.startsWith('/es/docs/') ? mapDocsSpanishToEnglishPath(p.path) : p.path;
		if (!byPath.has(canonicalPath)) byPath.set(canonicalPath, { ...p, path: canonicalPath });
	}
	return [...byPath.values()];
})();

const shouldHideFromManualIndex = (p: (typeof itemsFromDirectusRaw)[number]) => {
	const title = String(p.title || '')
		.replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '')
		.trim()
		.toLowerCase();
	const path = String(p.path || '').toLowerCase();

	if (title.includes('wp plugin (customisable)')) return true;
	if (title.includes('developers pre-sign up')) return true;
	if (path.includes('wp-plugin')) return true;
	if (path.includes('pre-sign')) return true;

	return false;
};

const decodeHtmlEntities = (s: string) =>
	s
		.replaceAll('&amp;', '&')
		.replaceAll('&quot;', '"')
		.replaceAll('&#39;', "'")
		.replaceAll('&lt;', '<')
		.replaceAll('&gt;', '>')
		.replaceAll('&nbsp;', ' ');

const stripSuffix = (t: string) => t.replace(/\s*•\s*PropertyList Info Hub\s*$/i, '').trim();
const cleanTitle = (t: string) => decodeHtmlEntities(stripSuffix(t)).trim();

const normalisePath = (p: string) => {
	const raw = String(p || '').trim();
	if (!raw) return '';
	const withSlash = raw.startsWith('/') ? raw : `/${raw}`;
	const noQuery = withSlash.split('?')[0]!.split('#')[0]!;
	const cleaned = noQuery.replace(/\/{2,}/g, '/');
	return cleaned.endsWith('/') ? cleaned : `${cleaned}/`;
};

const titleCase = (s: string) =>
	s
		.replace(/[_-]+/g, ' ')
		.replace(/\b\w/g, (m) => m.toUpperCase())
		.replace(/\bAnd\b/g, 'and');

type ManualPage = { path: string; title: string; description?: string | null };

const pages: ManualPage[] = itemsFromDirectus
	.filter((p) => !shouldHideFromManualIndex(p))
	.map((p) => ({
		path: normalisePath(p.path),
		title: cleanTitle(p.title),
		description: p.description ? String(p.description) : null,
	}))
	.filter((p) => p.path.startsWith(base));

const topTasks = (() => {
	const picks: string[][] = [
		['/listings/creating-a-new-listing', '/creating-a-new-listing', 'creating-a-new-listing'],
		['/listings/import-properties', '/import-properties', 'import-properties'],
		['/integrations/export-listings/export-listings-xml', 'export-listings-xml'],
		['/leads/portal-leads', '/portal-leads', 'portal-leads'],
		['/documents/upload', '/upload', 'upload'],
	];

	const pickByPathIncludes = (needles: string[]) => pages.find((p) => needles.some((n) => p.path.includes(n))) || null;

	const chosen: typeof pages = [];
	for (const needles of picks) {
		const hit = pickByPathIncludes(needles);
		if (hit && !chosen.some((c) => c.path === hit.path)) chosen.push(hit);
	}

	for (const item of pages) {
		if (chosen.length >= 6) break;
		if (!chosen.some((c) => c.path === item.path)) chosen.push(item);
	}

	return chosen.slice(0, 6);
})();

const topTaskIcons = {
	listing:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 10.5 12 4.5l7.5 6v9.75c0 .69-.56 1.25-1.25 1.25H5.75c-.69 0-1.25-.56-1.25-1.25V10.5Z" stroke="currentColor" stroke-width="1.7" /><path d="M12 11v6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M9 14h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>',
	importIcon:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3.5v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M8.5 10.5 12 13.8l3.5-3.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><path d="M5.5 20.5h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>',
	exportIcon:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 20.5v-10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M8.5 13.5 12 10.2l3.5 3.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><path d="M5.5 3.5h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>',
	leads:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16.8 20.5c0-2.7-2-4.4-4.8-4.4s-4.8 1.7-4.8 4.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M12 13.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke="currentColor" stroke-width="1.7" /></svg>',
	upload:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.2 12.8 13 8a3.3 3.3 0 0 1 4.7 4.7l-6 6a5.3 5.3 0 0 1-7.5-7.5l6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>',
	defaultIcon:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 4.5h7l3 3v12.75c0 .69-.56 1.25-1.25 1.25H7.25C6.56 21.75 6 21.19 6 20.5V5.75C6 5.06 6.56 4.5 7.25 4.5Z" stroke="currentColor" stroke-width="1.7" /><path d="M14 4.5V8h3" stroke="currentColor" stroke-width="1.7" /></svg>',
};

const iconForTopTask = (path: string) => {
	const p = String(path || '');
	if (p.includes('/creating-a-new-listing')) return topTaskIcons.listing;
	if (p.includes('/import-properties')) return topTaskIcons.importIcon;
	if (p.includes('/export-listings-xml') || p.includes('/export-listings')) return topTaskIcons.exportIcon;
	if (p.includes('/portal-leads') || p.includes('/leads')) return topTaskIcons.leads;
	if (p.includes('/upload') || p.includes('/documents')) return topTaskIcons.upload;
	return topTaskIcons.defaultIcon;
};

type PageLink = { path: string; title: string };

type ManualNode = {
	key: string;
	path: string;
	seg: string;
	title: string;
	description: string | null;
	children: ManualNode[];
	hasPage: boolean;
};

const treeOrder = await getKbTreeOrderSnapshot();
const pagesByPath = new Map(pages.map((p) => [p.path, p]));

const addWithAncestors = (p: string, set: Set<string>) => {
	const path = normalisePath(p);
	if (!path.startsWith(base)) return;
	set.add(path);
	const rest = path.slice(base.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = base;
	for (const seg of parts.slice(0, -1)) {
		acc += `${seg}/`;
		set.add(acc);
	}
};

const allPaths = (() => {
	const s = new Set<string>();
	s.add(base);
	for (const p of pages) addWithAncestors(p.path, s);
	for (const [parent, kids] of Object.entries(treeOrder.parentChildren || {})) {
		if (!String(parent || '').startsWith(base)) continue;
		addWithAncestors(parent, s);
		for (const k of Array.isArray(kids) ? kids : []) addWithAncestors(String(k || ''), s);
	}
	for (const [child, parent] of Object.entries(treeOrder.parentOverride || {})) {
		if (String(child || '').startsWith(base)) addWithAncestors(child, s);
		if (String(parent || '').startsWith(base)) addWithAncestors(parent, s);
	}
	return s;
})();

const nodesByPath = new Map<string, ManualNode>();
const ensureNode = (path: string, seg: string) => {
	const key = normalisePath(path);
	if (!key || !key.startsWith(base)) return null;
	const existing = nodesByPath.get(key) || null;
	if (existing) return existing;
	const node: ManualNode = { key, path: key, seg, title: '', description: null, children: [], hasPage: false };
	nodesByPath.set(key, node);
	return node;
};

ensureNode(base, '');
for (const p of allPaths) {
	const rest = p.slice(base.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = base;
	let lastSeg = '';
	for (const seg of parts) {
		lastSeg = seg;
		acc += `${seg}/`;
		ensureNode(acc, seg);
	}
	ensureNode(p, lastSeg);
}

for (const node of nodesByPath.values()) {
	const hit = pagesByPath.get(node.path) || null;
	if (node.path === base) node.title = 'MLS & CRM User Manual';
	else if (hit) {
		node.title = hit.title;
		node.description = hit.description ? String(hit.description) : null;
		node.hasPage = true;
	}
	if (!node.title) node.title = node.seg ? titleCase(node.seg) : 'MLS & CRM User Manual';
}

const derivedParent = (p: string) => {
	const path = normalisePath(p);
	if (path === base) return '';
	const rest = path.slice(base.length);
	const parts = rest.split('/').filter(Boolean);
	if (!parts.length) return '';
	if (parts.length === 1) return base;
	return `${base}${parts.slice(0, -1).join('/')}/`;
};

const effectiveParent = (p: string) => {
	const key = normalisePath(p);
	const explicit = (treeOrder.parentOverride || {})[key] || '';
	const explicitKey = explicit ? normalisePath(String(explicit)) : '';
	if (explicitKey && explicitKey.startsWith(base)) return explicitKey;
	return derivedParent(key);
};

const kidsByParent = new Map<string, string[]>();
for (const p of nodesByPath.keys()) {
	if (p === base) continue;
	const parent = effectiveParent(p);
	if (!parent || !parent.startsWith(base)) continue;
	const arr = kidsByParent.get(parent) || [];
	arr.push(p);
	kidsByParent.set(parent, arr);
}

const sortForParent = (parentPath: string, childPaths: string[]) => {
	const orderList = (treeOrder.parentChildren?.[parentPath] || []).slice();
	const fallbackCompare = (a: string, b: string) => {
		const aNode = nodesByPath.get(a);
		const bNode = nodesByPath.get(b);
		return String(aNode?.title || '').localeCompare(String(bNode?.title || ''));
	};
	return sortPathsWithOrder({ parentPath, paths: childPaths, order: orderList, fallbackCompare }).ordered;
};

const buildChildren = (parentPath: string): ManualNode[] => {
	const childPaths = kidsByParent.get(parentPath) || [];
	const sorted = sortForParent(parentPath, childPaths);
	return sorted
		.map((p) => nodesByPath.get(p) || null)
		.filter(Boolean)
		.map((n) => {
			n!.children = buildChildren(n!.path);
			return n!;
		});
};

const manualRoot = nodesByPath.get(base)!;
manualRoot.children = buildChildren(base);

const listDescendantPages = (node: ManualNode): PageLink[] => {
	const out: PageLink[] = [];
	const visit = (n: ManualNode) => {
		for (const c of n.children) {
			if (c.hasPage) out.push({ path: c.path, title: c.title });
			visit(c);
		}
	};
	visit(node);
	return out.filter((p) => p.path !== node.path);
};
---


<Layout
	lang="en"
	title="MLS & CRM User Manual • PropertyList Info Hub"
	description="MLS & CRM user manual for PropertyList: listings, leads, contacts, documents, XML import/export, and reporting."
	canonical="https://info.propertylist.es/docs/propertylist-mls-user-manual/"
>
	<section class="hero">
		<div class="heroInner">
			<div class="badge">User manual</div>
			<h1>MLS &amp; CRM USER MANUAL</h1>
			<p class="lead">
				Step-by-step guides for using PropertyList to manage listings, contacts, leads, documents, reports, and XML import/export.
				Use the filter to quickly find the exact workflow you need.
			</p>
			<div class="filterRow">
				<label class="filterLabel" for="doc-filter">Filter</label>
				<input id="doc-filter" class="filterInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search within this manual…" />
			</div>
		</div>
	</section>

	{topTasks.length ? (
		<section class="top">
			<h2>Popular tasks</h2>
			<div class="rows">
				{topTasks.map((p) => (
					<a
						class="row"
						href={externalHrefForDocPath(p.path) || p.path}
						target={externalHrefForDocPath(p.path) ? '_blank' : undefined}
						rel={externalHrefForDocPath(p.path) ? 'noopener' : undefined}
					>
						<div class="rowIcon" aria-hidden="true" set:html={iconForTopTask(p.path)} />
						<div class="rowTitle">{cleanTitle(p.title)}</div>
					</a>
				))}
			</div>
		</section>
	) : null}

	<section class="contents" aria-label="Manual contents">
		<div class="contentsHeader">
			<h2 class="contentsTitle">Browse by topic</h2>
			<p class="contentsSub">Choose a topic, then pick a guide. Use the filter to search across all topics.</p>
		</div>
		{manualRoot.children.length ? (
			<div class="grid" data-grid="1">
				{manualRoot.children.map((seg) => {
					const pages = listDescendantPages(seg);
					const featured = pages.slice(0, 8);
					const remaining = pages.slice(8);
					const label = (seg.title || '').toLowerCase();
					const href = seg.hasPage ? seg.path : pages.length ? pages[0]!.path : base;
					const desc = seg.description || 'Guides and workflows for this topic.';
					return (
						<section class="card" data-card="1" data-label={label}>
							<div class="cardHeader">
								<a class="cardTitle" href={href}>
									{seg.title}
								</a>
								<span class="cardMeta">{pages.length} guides</span>
							</div>
							<p class="cardDesc">{desc}</p>
							{featured.length ? (
								<ul class="list">
									{featured.map((p) => (
										<li data-node="1" data-label={p.title.toLowerCase()}>
											<a
												class="listRow"
												href={externalHrefForDocPath(p.path) || p.path}
												target={externalHrefForDocPath(p.path) ? '_blank' : undefined}
												rel={externalHrefForDocPath(p.path) ? 'noopener' : undefined}
											>
												<span class="listRowTitle">{p.title}</span>
											</a>
										</li>
									))}
								</ul>
							) : (
								<div class="emptySmall">No guides yet.</div>
							)}
							{remaining.length ? (
								<details class="more" data-more="1">
									<summary class="moreSummary">Show all ({pages.length})</summary>
									<ul class="list moreList">
										{remaining.map((p) => (
											<li data-node="1" data-label={p.title.toLowerCase()}>
												<a
													class="listRow"
													href={externalHrefForDocPath(p.path) || p.path}
													target={externalHrefForDocPath(p.path) ? '_blank' : undefined}
													rel={externalHrefForDocPath(p.path) ? 'noopener' : undefined}
												>
													<span class="listRowTitle">{p.title}</span>
												</a>
											</li>
										))}
									</ul>
								</details>
							) : null}
						</section>
					);
				})}
			</div>
		) : (
			<div class="empty">No MLS docs yet.</div>
		)}
	</section>
</Layout>

<style>
	.hero {
		background: radial-gradient(1200px 600px at 30% -10%, rgba(0, 174, 154, 0.18), rgba(255, 255, 255, 0));
		border-radius: 22px;
		padding: 18px;
		margin-bottom: 14px;
	}

	.heroInner {
		background: rgba(255, 255, 255, 0.75);
		border-radius: 18px;
		padding: 18px;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 800;
		font-size: 12px;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.04em;
		line-height: 1.06;
	}

	h2 {
		margin: 0 0 12px;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.lead {
		margin: 10px 0 0;
		color: rgba(16, 24, 40, 0.78);
		font-size: 16px;
		line-height: 1.55;
	}

	.filterRow {
		margin-top: 12px;
	}

	.filterLabel {
		display: block;
		font-size: 13px;
		color: rgba(16, 24, 40, 0.7);
		margin: 0 0 4px;
	}

	.filterInput {
		width: min(360px, 100%);
		border: 1px solid rgba(16, 24, 40, 0.18);
		border-radius: 8px;
		padding: 8px 10px;
		background: rgba(255, 255, 255, 0.9);
		margin: 0 0 12px;
	}

	.top {
		background: rgba(255, 255, 255, 0.7);
		border-radius: 18px;
		padding: 14px;
		margin: 14px 0;
	}

	.rows {
		display: grid;
		gap: 10px;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.row {
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 14px;
		padding: 12px 14px;
		text-decoration: none;
		display: grid;
		grid-template-columns: 1fr;
		gap: 10px;
		align-content: start;
	}

	.row:hover {
		text-decoration: none;
		border-color: rgba(0, 174, 154, 0.35);
	}

	.rowIcon {
		width: 42px;
		height: 42px;
		border-radius: 14px;
		display: grid;
		place-items: center;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.22);
		color: rgba(0, 174, 154, 0.95);
	}

	.rowTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		color: rgba(16, 24, 40, 0.92);
	}

	.treeWrap {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.contents {
		background: rgba(255, 255, 255, 0.7);
		border-radius: 18px;
		padding: 14px;
	}

	.contentsHeader {
		display: grid;
		gap: 6px;
		margin-bottom: 12px;
	}

	.contentsTitle {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.contentsSub {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.55;
		max-width: 75ch;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		align-items: start;
	}

	.card {
		background: rgba(255, 255, 255, 0.82);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 12px 12px;
		display: grid;
		gap: 10px;
	}

	.cardHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
	}

	.cardTitle {
		color: #00ae9a;
		text-decoration: none;
		font-weight: 900;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.cardTitle:visited {
		color: #00ae9a;
	}

	.cardTitle:hover {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}

	.cardMeta {
		font-size: 12px;
		font-weight: 900;
		color: rgba(16, 24, 40, 0.6);
		background: rgba(16, 24, 40, 0.05);
		border: 1px solid rgba(16, 24, 40, 0.08);
		padding: 4px 8px;
		border-radius: 999px;
		white-space: nowrap;
	}

	.cardDesc {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.5;
		font-weight: 650;
	}

	.list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 6px;
	}

	.listRow {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2px;
		padding: 8px 10px;
		border-radius: 12px;
		border: 1px solid rgba(16, 24, 40, 0.08);
		background: rgba(255, 255, 255, 0.9);
		text-decoration: none;
	}

	.listRow:hover {
		text-decoration: none;
		border-color: rgba(0, 174, 154, 0.35);
	}

	.listRowTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		color: rgba(16, 24, 40, 0.9);
	}

	.more {
		border-top: 1px solid rgba(16, 24, 40, 0.08);
		padding-top: 10px;
	}

	.moreSummary {
		cursor: pointer;
		font-weight: 900;
		color: rgba(16, 24, 40, 0.78);
	}

	.moreList {
		margin-top: 10px;
	}

	.empty,
	.emptySmall {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	@media (max-width: 980px) {
		.rows {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.rows {
			grid-template-columns: 1fr;
		}
	}
</style>

<script is:inline>
	(() => {
		const input = document.getElementById('doc-filter');
		if (!(input instanceof HTMLInputElement)) return;
		const nodes = Array.from(document.querySelectorAll('li[data-node]'));
		const cards = Array.from(document.querySelectorAll('section[data-card]'));
		const top = document.querySelector('section.top');

		const apply = () => {
			const q = (input.value || '').trim().toLowerCase();
			if (!q) {
				for (const li of nodes) li.hidden = false;
				for (const c of cards) c.hidden = false;
				for (const d of Array.from(document.querySelectorAll('details[data-more]'))) d.open = false;
				if (top instanceof HTMLElement) top.hidden = false;
				return;
			}

			if (top instanceof HTMLElement) top.hidden = true;

			for (const li of nodes) {
				const label = (li.getAttribute('data-label') || '').toLowerCase();
				li.hidden = !label.includes(q);
			}

			for (const c of cards) {
				const hasVisibleChild = Array.from(c.querySelectorAll('li[data-node]')).some((li) => !li.hidden);
				c.hidden = !hasVisibleChild;
				for (const d of Array.from(c.querySelectorAll('details[data-more]'))) {
					const hasVisible = Array.from(d.querySelectorAll('li[data-node]')).some((li) => !li.hidden);
					d.open = hasVisible;
				}
			}
		};

		input.addEventListener('input', apply, { passive: true });
	})();
</script>
