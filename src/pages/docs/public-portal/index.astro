---
import Layout from '../../../layouts/Layout.astro';
import {
	listKbPagesByPrefixes,
	mapDocsEnglishToSpanishPath,
	mapDocsSpanishToEnglishPath,
} from '../../../lib/directus';

const base = '/docs/public-portal/';
const itemsRaw = await listKbPagesByPrefixes({
	prefixes: [base, mapDocsEnglishToSpanishPath(base), `/es${base}`],
	lang: 'en',
	limit: 500,
});
const items = (() => {
	const byPath = new Map<string, (typeof itemsRaw)[number]>();
	for (const p of itemsRaw) {
		const canonicalPath = p.path.startsWith('/es/docs/') ? mapDocsSpanishToEnglishPath(p.path) : p.path;
		if (!byPath.has(canonicalPath)) byPath.set(canonicalPath, { ...p, path: canonicalPath });
	}
	return [...byPath.values()];
})();

const titleCase = (s: string) =>
	s
		.replace(/[_-]+/g, ' ')
		.replace(/\b\w/g, (m) => m.toUpperCase())
		.replace(/\bAnd\b/g, 'and');

const decodeHtmlEntities = (s: string) =>
	s
		.replaceAll('&amp;', '&')
		.replaceAll('&quot;', '"')
		.replaceAll('&#39;', "'")
		.replaceAll('&lt;', '<')
		.replaceAll('&gt;', '>')
		.replaceAll('&nbsp;', ' ');

const stripSuffix = (t: string) => t.replace(/\s*•\s*PropertyList Info Hub\s*$/i, '').trim();
const cleanTitle = (t: string) => decodeHtmlEntities(stripSuffix(t)).trim();

type Node = {
	key: string;
	path: string;
	seg: string;
	title: string;
	children: Node[];
};

const pagesByPath = new Map(items.map((p) => [p.path, p]));
const root: Node = { key: base, path: base, seg: '', title: '', children: [] };

const ensureChild = (parent: Node, seg: string, path: string) => {
	let node = parent.children.find((c) => c.key === path) || null;
	if (!node) {
		node = { key: path, path, seg, title: '', children: [] };
		parent.children.push(node);
	}
	return node;
};

for (const p of items) {
	if (!p.path.startsWith(base)) continue;
	const rest = p.path.slice(base.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = base;
	let parent = root;
	for (const seg of parts) {
		acc += `${seg}/`;
		parent = ensureChild(parent, seg, acc);
		const page = pagesByPath.get(acc);
		if (page?.title) parent.title = cleanTitle(page.title);
	}
}

const fillMissingTitles = (node: Node) => {
	if (!node.title && node.seg) node.title = titleCase(node.seg);
	for (const c of node.children) fillMissingTitles(c);
};

fillMissingTitles(root);

const sortTree = (node: Node) => {
	node.children.sort((a, b) => a.title.localeCompare(b.title));
	for (const c of node.children) sortTree(c);
};

sortTree(root);

type PageLink = { path: string; title: string };

const listDescendantPages = (node: Node): PageLink[] => {
	const out: PageLink[] = [];
	const visit = (n: Node) => {
		for (const c of n.children) {
			const page = pagesByPath.get(c.path);
			if (page?.title) out.push({ path: c.path, title: cleanTitle(page.title) });
			visit(c);
		}
	};
	visit(node);
	const filtered = out.filter((p) => p.path !== node.path);
	const byTitle = new Map<string, PageLink>();
	for (const p of filtered) {
		const key = p.title.toLowerCase().trim();
		const prev = byTitle.get(key) || null;
		if (!prev) {
			byTitle.set(key, p);
			continue;
		}
		const prevDepth = prev.path.split('/').filter(Boolean).length;
		const nextDepth = p.path.split('/').filter(Boolean).length;
		if (nextDepth < prevDepth) byTitle.set(key, p);
		else if (nextDepth === prevDepth && p.path.localeCompare(prev.path) < 0) byTitle.set(key, p);
	}
	return [...byTitle.values()].sort((a, b) => a.title.localeCompare(b.title));
};
---

<Layout
	lang="en"
	title="Public Portal Docs • PropertyList Info Hub"
	description="How to use the public portal - search, save properties, and enquire."
	canonical="https://info.propertylist.es/docs/public-portal/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/docs/public-portal/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/docs/portal-publico/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/docs/public-portal/' },
	]}
>
	<section class="hero">
		<div class="heroInner">
			<div class="badge">Docs</div>
			<h1>PUBLIC PORTAL</h1>
			<p class="lead">Guides for the public portal experience: search, save properties, and enquire.</p>
			<div class="filterRow">
				<label class="filterLabel" for="doc-filter">Filter</label>
				<input id="doc-filter" class="filterInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search within these docs…" />
			</div>
		</div>
	</section>

	<section class="contents" aria-label="Public portal docs contents">
		<div class="contentsHeader">
			<h2 class="contentsTitle">Browse by topic</h2>
			<p class="contentsSub">Choose a topic, then pick a guide. Use the filter to search across all topics.</p>
		</div>
		{root.children.length ? (
			<div class="grid" data-grid="1">
				{root.children.map((seg) => {
					const pages = listDescendantPages(seg);
					const featured = pages.slice(0, 8);
					const remaining = pages.slice(8);
					const label = (seg.title || '').toLowerCase();
					const desc = cleanTitle(pagesByPath.get(seg.path)?.description || '') || 'Guides and workflows for this topic.';
					return (
						<section class="card" data-card="1" data-label={label}>
							<div class="cardHeader">
								<a class="cardTitle" href={seg.path}>
									{seg.title}
								</a>
								{pages.length > 0 && <span class="cardMeta">{pages.length} guides</span>}
							</div>
							<p class="cardDesc">{desc}</p>
							{featured.length ? (
								<ul class="list">
									{featured.map((p) => (
										<li data-node="1" data-label={p.title.toLowerCase()}>
											<a class="listRow" href={p.path}>
												<span class="listRowTitle">{p.title}</span>
											</a>
										</li>
									))}
								</ul>
							) : (
								<a class="listRow" href={seg.path}><span class="listRowTitle">Read this guide</span></a>
							)}
							{remaining.length ? (
								<details class="more" data-more="1">
									<summary class="moreSummary">Show all ({pages.length})</summary>
									<ul class="list moreList">
										{remaining.map((p) => (
											<li data-node="1" data-label={p.title.toLowerCase()}>
												<a class="listRow" href={p.path}>
													<span class="listRowTitle">{p.title}</span>
												</a>
											</li>
										))}
									</ul>
								</details>
							) : null}
						</section>
					);
				})}
			</div>
		) : (
			<div class="empty">The public portal is live at <a href="https://propertylist.es/" target="_blank" rel="noopener">propertylist.es</a> - buyer and renter guides are being written now.</div>
		)}
	</section>
</Layout>

<style>
	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.04em;
		line-height: 1.06;
	}

	h2 {
		margin: 0 0 12px;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.hero {
		background: radial-gradient(1200px 600px at 30% -10%, rgba(0, 174, 154, 0.18), rgba(255, 255, 255, 0));
		border-radius: 22px;
		padding: 18px;
		margin-bottom: 14px;
		border: 1px solid rgba(16, 24, 40, 0.08);
	}

	.heroInner {
		background: rgba(255, 255, 255, 0.75);
		border-radius: 18px;
		padding: 18px;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 800;
		font-size: 12px;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.lead {
		margin: 10px 0 0;
		color: rgba(16, 24, 40, 0.78);
		font-size: 16px;
		line-height: 1.55;
	}

	.filterRow {
		margin-top: 12px;
	}

	.filterLabel {
		display: block;
		font-size: 13px;
		color: rgba(16, 24, 40, 0.7);
		margin: 0 0 4px;
	}

	.filterInput {
		width: min(360px, 100%);
		border: 1px solid rgba(16, 24, 40, 0.18);
		border-radius: 8px;
		padding: 8px 10px;
		background: rgba(255, 255, 255, 0.9);
		margin: 0 0 12px;
	}

	.contents {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.contentsHeader {
		display: grid;
		gap: 6px;
		margin-bottom: 12px;
	}

	.contentsTitle {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.contentsSub {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.55;
		max-width: 75ch;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		align-items: start;
	}

	.card {
		background: rgba(255, 255, 255, 0.82);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 12px 12px;
		display: grid;
		gap: 10px;
	}

	.cardHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
	}

	.cardTitle {
		color: #00ae9a;
		text-decoration: none;
		font-weight: 900;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.cardTitle:visited {
		color: #00ae9a;
	}

	.cardTitle:hover {
		text-decoration: underline;
	}

	.cardMeta {
		color: rgba(16, 24, 40, 0.6);
		font-size: 13px;
		font-weight: 700;
		white-space: nowrap;
	}

	.cardDesc {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.45;
		font-size: 13px;
	}

	.list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 8px;
	}

	.listRow {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 10px;
		padding: 10px 10px;
		border-radius: 14px;
		text-decoration: none;
		color: rgba(16, 24, 40, 0.82);
		font-weight: 800;
		line-height: 1.25;
		background: rgba(255, 255, 255, 0.55);
		border: 1px solid rgba(16, 24, 40, 0.06);
	}

	.listRow::after {
		content: '›';
		flex: none;
		color: rgba(16, 24, 40, 0.45);
		font-weight: 900;
		line-height: 1;
		margin-top: 1px;
	}

	.listRowTitle {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.listRow:hover,
	.listRow:focus-visible {
		outline: none;
		border-color: rgba(0, 174, 154, 0.4);
		background: rgba(0, 174, 154, 0.06);
	}

	.listRow:hover::after,
	.listRow:focus-visible::after {
		color: var(--accent);
	}

	.moreSummary {
		cursor: pointer;
		font-weight: 900;
		color: rgba(16, 24, 40, 0.78);
	}

	.moreList {
		margin-top: 10px;
	}

	.empty {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	.emptySmall {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	@media (max-width: 980px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script is:inline>
	(() => {
		const input = document.getElementById('doc-filter');
		if (!(input instanceof HTMLInputElement)) return;
		const nodes = Array.from(document.querySelectorAll('li[data-node]'));
		const cards = Array.from(document.querySelectorAll('section[data-card]'));

		const apply = () => {
			const q = (input.value || '').trim().toLowerCase();
			if (!q) {
				for (const li of nodes) li.hidden = false;
				for (const c of cards) c.hidden = false;
				for (const d of Array.from(document.querySelectorAll('details[data-more]'))) d.open = false;
				return;
			}

			for (const li of nodes) {
				const label = (li.getAttribute('data-label') || '').toLowerCase();
				li.hidden = !label.includes(q);
			}

			for (const c of cards) {
				const hasVisibleChild = Array.from(c.querySelectorAll('li[data-node]')).some((li) => !li.hidden);
				c.hidden = !(hasVisibleChild || (c.getAttribute('data-label') || '').toLowerCase().includes(q));
				for (const d of Array.from(c.querySelectorAll('details[data-more]'))) {
					const hasVisible = Array.from(d.querySelectorAll('li[data-node]')).some((li) => !li.hidden);
					d.open = hasVisible;
				}
			}
		};

		input.addEventListener('input', apply, { passive: true });
	})();
</script>
