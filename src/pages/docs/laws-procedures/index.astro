---
import Layout from '../../../layouts/Layout.astro';
import {
	listKbPagesByPrefixes,
	mapDocsEnglishToSpanishPath,
	mapDocsSpanishToEnglishPath,
} from '../../../lib/directus';

const base = '/docs/laws-procedures/';
const itemsRaw = await listKbPagesByPrefixes({
	prefixes: [base, mapDocsEnglishToSpanishPath(base), `/es${base}`],
	lang: 'en',
	limit: 500,
});
const items = (() => {
	const byPath = new Map<string, (typeof itemsRaw)[number]>();
	for (const p of itemsRaw) {
		const canonicalPath = p.path.startsWith('/es/docs/') ? mapDocsSpanishToEnglishPath(p.path) : p.path;
		if (!byPath.has(canonicalPath)) byPath.set(canonicalPath, { ...p, path: canonicalPath });
	}
	return [...byPath.values()];
})();

const seedLegacyListing = () => {
	const definitions = [
		{
			seg: 'listing-a-property-what-to-know',
			title: 'Listing a Property (What to know)',
			desc: 'What to know before listing a property in Andalusia.',
			children: [
				{ seg: 'estate-agents', title: 'Estate Agents' },
				{ seg: 'owners', title: 'Owners' },
			],
		},
		{
			seg: 'buying-a-property',
			title: 'Buying a Property',
			desc: 'Guides for buyers: checks, contracts, and timelines.',
			children: [
				{ seg: 'verifying-documents-and-debts', title: 'Verifying documents and debts' },
				{ seg: 'legal-requirements', title: 'Legal requirements' },
				{ seg: 'obtaining-a-nie', title: 'Obtaining a NIE' },
				{ seg: 'paying-taxes', title: 'Paying taxes' },
				{ seg: 'registering-the-property-in-the-land-registry', title: 'Registering the Property in the Land Registry' },
			],
		},
		{
			seg: 'selling-a-property',
			title: 'Selling a Property',
			desc: 'Guides for sellers: paperwork, process, and costs.',
			children: [
				{ seg: 'the-selling-process', title: 'The selling process' },
				{ seg: 'marketing-the-property', title: 'Marketing the property' },
				{ seg: 'signing-a-contract-and-reservation', title: 'Signing a contract & reservation' },
				{ seg: 'costs', title: 'Costs' },
				{ seg: 'taxes', title: 'Taxes' },
			],
		},
		{
			seg: 'renovating-a-property',
			title: 'Renovating a Property',
			desc: 'Renovations, rules, compliance, and practical steps.',
			children: [
				{ seg: 'planning-permission', title: 'Planning permission' },
				{ seg: 'obtaining-a-licencia-de-obra', title: 'Obtaining a licencia de obra (building permit).' },
				{ seg: 'cost-calculations', title: 'Cost Calculations' },
				{ seg: 'hiring-a-contractor', title: 'Hiring a contractor' },
				{ seg: 'taxes-for-renovating', title: 'Taxes for Renovating' },
			],
		},
		{
			seg: 'building-a-property',
			title: 'Building a Property',
			desc: 'New builds, permits, regulations, and project planning.',
			children: [
				{ seg: 'obtaining-permits-and-approvals', title: 'Obtaining permits and approvals' },
				{ seg: 'inspections-and-compliance', title: 'Inspections and compliance' },
				{ seg: 'planning-and-design', title: 'Planning and design' },
				{ seg: 'construction-and-completion', title: 'Construction and completion' },
				{ seg: 'construction-standards', title: 'Construction standards' },
				{ seg: 'completion-and-final-inspections', title: 'Completion and final inspections' },
			],
		},
		{
			seg: 'renting-a-property',
			title: 'Renting a Property',
			desc: 'Rentals, landlord obligations, tenant rights, and taxes.',
			children: [
				{ seg: 'long-term', title: 'Long Term' },
				{ seg: 'types-of-tenancies', title: 'Types of tenancies' },
				{ seg: 'tenancy-agreements', title: 'Tenancy agreements' },
				{ seg: 'evictions', title: 'Evictions' },
				{ seg: 'short-term-holiday', title: 'Short Term/Holiday' },
				{ seg: 'community-approval-law', title: 'Community Approval Law' },
				{ seg: 'landlords', title: 'Landlords' },
				{ seg: 'requirements-for-landlords', title: 'Requirements for Landlords' },
				{ seg: 'taxes-for-landlords', title: 'Taxes for Landlords' },
			],
		},
		{
			seg: 'traspaso-business-transfer',
			title: 'Traspaso (Business Transfer)',
			desc: 'Business transfers (traspaso): how it works and what to check.',
			children: [
				{ seg: 'understanding-the-traspaso-concept', title: 'Understanding the Traspaso concept' },
				{ seg: 'essentials-of-a-traspaso-agreement', title: 'Essentials of a Traspaso Agreement' },
				{ seg: 'tax-implications-of-a-traspaso', title: 'Tax Implications of a Traspaso' },
				{ seg: 'additional-considerations', title: 'Additional Considerations' },
				{ seg: 'contractual-obligations', title: 'Contractual obligations' },
			],
		},
		{
			seg: 'property-taxes-in-andalucia',
			title: 'Property Taxes in Andalucía',
			desc: 'Taxes and ongoing costs for owning property.',
			children: [
				{ seg: 'impuesto-sobre-bienes-inmuebles-ibi', title: 'Impuesto sobre Bienes Inmuebles (IBI)' },
				{ seg: 'impuesto-sobre-transmisiones-patrimoniales-itp', title: 'Impuesto sobre Transmisiones Patrimoniales (ITP)' },
				{ seg: 'impuesto-sobre-el-valor-anadido-iva', title: 'Impuesto sobre el Valor Añadido (IVA)' },
				{ seg: 'impuesto-sobre-construcciones-instalaciones-y-obras-icio', title: 'Impuesto sobre Construcciones, Instalaciones y Obras (ICIO)' },
			],
		},
		{
			seg: 'inheritance-laws-in-andalucia',
			title: 'Inheritance Laws in Andalucía',
			desc: 'Inheritance basics: legal steps and common pitfalls.',
			children: [
				{ seg: 'inheritance-tax-impuesto-sobre-sucesiones-y-donaciones', title: 'Inheritance Tax (Impuesto sobre Sucesiones y Donaciones)' },
				{ seg: 'forced-heirship-rules-legitima', title: 'Forced Heirship Rules (Legítima)' },
				{ seg: 'wills-and-testaments', title: 'Wills and Testaments' },
				{ seg: 'intestate-succession-intestacy', title: 'Intestate Succession (Intestacy)' },
			],
		},
		{
			seg: 'property-insurance-in-andalucia',
			title: 'Property Insurance in Andalucía',
			desc: 'Insurance types, coverage, and what to ask for.',
			children: [
				{ seg: 'types-of-property-insurance', title: 'Types of Property Insurance' },
				{ seg: 'factors-influencing-premiums', title: 'Factors Influencing Premiums' },
				{ seg: 'shopping-for-insurance', title: 'Shopping for Insurance' },
				{ seg: 'additional-considerations', title: 'Additional Considerations' },
			],
		},
	];

	const results = [];
	const seenPaths = new Set(items.map((i) => i.path));

	for (const def of definitions) {
		const parentPath = `${base}${def.seg}/`;
		if (!seenPaths.has(parentPath)) {
			results.push({
				id: `legacy-laws-${def.seg}`,
				language: 'en',
				path: parentPath,
				title: def.title,
				description: def.desc,
			});
			seenPaths.add(parentPath);
		}

		for (const child of def.children) {
			const childPath = `${parentPath}${child.seg}/`;
			if (!seenPaths.has(childPath)) {
				results.push({
					id: `legacy-laws-${def.seg}-${child.seg}`,
					language: 'en',
					path: childPath,
					title: child.title,
					description: `${child.title} - Guide.`,
				});
				seenPaths.add(childPath);
			}
		}
	}

	return results;
};

items.push(...seedLegacyListing());

const titleCase = (s: string) =>
	s
		.replace(/[_-]+/g, ' ')
		.replace(/\b\w/g, (m) => m.toUpperCase())
		.replace(/\bAnd\b/g, 'and');

const decodeHtmlEntities = (s: string) =>
	s
		.replaceAll('&amp;', '&')
		.replaceAll('&quot;', '"')
		.replaceAll('&#39;', "'")
		.replaceAll('&lt;', '<')
		.replaceAll('&gt;', '>')
		.replaceAll('&nbsp;', ' ');

const stripSuffix = (t: string) => t.replace(/\s*•\s*PropertyList Info Hub\s*$/i, '').trim();
const cleanTitle = (t: string) => decodeHtmlEntities(stripSuffix(t)).trim();

type Node = {
	key: string;
	path: string;
	seg: string;
	title: string;
	children: Node[];
};

const pagesByPath = new Map(items.map((p) => [p.path, p]));
const root: Node = { key: base, path: base, seg: '', title: '', children: [] };

const ensureChild = (parent: Node, seg: string, path: string) => {
	let node = parent.children.find((c) => c.key === path) || null;
	if (!node) {
		node = { key: path, path, seg, title: '', children: [] };
		parent.children.push(node);
	}
	return node;
};

for (const p of items) {
	if (!p.path.startsWith(base)) continue;
	const rest = p.path.slice(base.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = base;
	let parent = root;
	for (const seg of parts) {
		acc += `${seg}/`;
		parent = ensureChild(parent, seg, acc);
		const page = pagesByPath.get(acc);
		if (page?.title) parent.title = cleanTitle(page.title);
	}
}

const fillMissingTitles = (node: Node) => {
	if (!node.title && node.seg) node.title = titleCase(node.seg);
	for (const c of node.children) fillMissingTitles(c);
};

fillMissingTitles(root);

const topOrder = [
	'listing-a-property-what-to-know',
	'buying-a-property',
	'selling-a-property',
	'renovating-a-property',
	'building-a-property',
	'renting-a-property',
	'traspaso-business-transfer',
	'property-taxes-in-andalucia',
	'inheritance-laws-in-andalucia',
	'property-insurance-in-andalucia',
];
const topRank = new Map(topOrder.map((s, i) => [s, i]));

const sortTree = (node: Node) => {
	node.children.sort((a, b) => {
		if (node === root) {
			const ar = topRank.has(a.seg) ? (topRank.get(a.seg) as number) : 9999;
			const br = topRank.has(b.seg) ? (topRank.get(b.seg) as number) : 9999;
			if (ar !== br) return ar - br;
		}
		return a.title.localeCompare(b.title);
	});
	for (const c of node.children) {
		sortTree(c);
	}
};

sortTree(root);

type PageLink = { path: string; title: string };

const listDescendantPages = (node: Node): PageLink[] => {
	const out: PageLink[] = [];
	const visit = (n: Node) => {
		for (const c of n.children) {
			const page = pagesByPath.get(c.path);
			if (page?.title) out.push({ path: c.path, title: cleanTitle(page.title) });
			visit(c);
		}
	};
	visit(node);
	const filtered = out.filter((p) => p.path !== node.path);
	const byTitle = new Map<string, PageLink>();
	for (const p of filtered) {
		const key = p.title.toLowerCase().trim();
		const prev = byTitle.get(key) || null;
		if (!prev) {
			byTitle.set(key, p);
			continue;
		}
		const prevDepth = prev.path.split('/').filter(Boolean).length;
		const nextDepth = p.path.split('/').filter(Boolean).length;
		if (nextDepth < prevDepth) byTitle.set(key, p);
		else if (nextDepth === prevDepth && p.path.localeCompare(prev.path) < 0) byTitle.set(key, p);
	}
	return [...byTitle.values()].sort((a, b) => a.title.localeCompare(b.title));
};

const segmentDescriptions: Record<string, string> = {
	'listing-a-property-what-to-know': 'What to prepare before listing a property in Spain.',
	'buying-a-property': 'Guides for buyers: checks, contracts, and timelines.',
	'selling-a-property': 'Guides for sellers: paperwork, process, and costs.',
	'renovating-a-property': 'Renovations, rules, compliance, and practical steps.',
	'building-a-property': 'New builds, permits, regulations, and project planning.',
	'renting-a-property': 'Rentals, landlord obligations, tenant rights, and taxes.',
	'traspaso-business-transfer': 'Business transfers (traspaso): how it works and what to check.',
	'property-taxes-in-andalucia': 'Taxes and ongoing costs for owning property.',
	'inheritance-laws-in-andalucia': 'Inheritance basics: legal steps and common pitfalls.',
	'property-insurance-in-andalucia': 'Insurance types, coverage, and what to ask for.',
};
---

<Layout
	lang="en"
	title="Laws & Procedures Docs • PropertyList Info Hub"
	description="Guides covering laws, procedures, taxes, rentals and property rules in Spain."
	canonical="https://info.propertylist.es/docs/laws-procedures/"
>
	<section class="hero">
		<div class="heroInner">
			<div class="badge">Docs</div>
			<h1>LAWS &amp; PROCEDURES</h1>
			<p class="lead">Guides covering laws, procedures, taxes, rentals and property rules in Spain.</p>
			<div class="filterRow">
				<label class="filterLabel" for="doc-filter">Filter</label>
				<input id="doc-filter" class="filterInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search within this manual…" />
			</div>
		</div>
	</section>

	<section class="contents" aria-label="Manual contents">
		<div class="contentsHeader">
			<h2 class="contentsTitle">Browse by topic</h2>
			<p class="contentsSub">Choose a topic, then pick a guide. Use the filter to search across all topics.</p>
		</div>
		{root.children.length ? (
			<div class="grid" data-grid="1">
				{root.children.map((seg) => {
					const pages = listDescendantPages(seg);
					const featured = pages.slice(0, 8);
					const remaining = pages.slice(8);
					const label = (seg.title || '').toLowerCase();
					const desc = segmentDescriptions[seg.seg] || 'Guides and workflows for this topic.';
					return (
						<section class="card" data-card="1" data-label={label}>
							<div class="cardHeader">
								<a class="cardTitle" href={seg.path}>
									{seg.title}
								</a>
								<span class="cardMeta">{pages.length} guides</span>
							</div>
							<p class="cardDesc">{desc}</p>
							{featured.length ? (
								<ul class="list">
									{featured.map((p) => (
										<li data-node="1" data-label={p.title.toLowerCase()}>
											<a class="listRow" href={p.path}>
												<span class="listRowTitle">{p.title}</span>
											</a>
										</li>
									))}
								</ul>
							) : (
								<div class="emptySmall">No guides yet.</div>
							)}
							{remaining.length ? (
								<details class="more" data-more="1">
									<summary class="moreSummary">Show all ({pages.length})</summary>
									<ul class="list moreList">
										{remaining.map((p) => (
											<li data-node="1" data-label={p.title.toLowerCase()}>
												<a class="listRow" href={p.path}>
													<span class="listRowTitle">{p.title}</span>
												</a>
											</li>
										))}
									</ul>
								</details>
							) : null}
						</section>
					);
				})}
			</div>
		) : (
			<div class="empty">No docs yet.</div>
		)}
	</section>
</Layout>



<script is:inline>
	(() => {
		const input = document.getElementById('doc-filter');
		if (!(input instanceof HTMLInputElement)) return;
		const nodes = Array.from(document.querySelectorAll('li[data-node]'));
		const cards = Array.from(document.querySelectorAll('section[data-card]'));

		const apply = () => {
			const q = (input.value || '').trim().toLowerCase();
			if (!q) {
				for (const li of nodes) li.hidden = false;
				for (const c of cards) c.hidden = false;
				for (const d of Array.from(document.querySelectorAll('details[data-more]'))) d.open = false;
				return;
			}

			for (const li of nodes) {
				const label = (li.getAttribute('data-label') || '').toLowerCase();
				li.hidden = !label.includes(q);
			}

			for (const c of cards) {
				const hasVisibleChild = Array.from(c.querySelectorAll('li[data-node]')).some((li) => !li.hidden);
				c.hidden = !hasVisibleChild;
				for (const d of Array.from(c.querySelectorAll('details[data-more]'))) {
					const hasVisible = Array.from(d.querySelectorAll('li[data-node]')).some((li) => !li.hidden);
					d.open = hasVisible;
				}
			}
		};

		input.addEventListener('input', apply, { passive: true });
	})();
</script>
