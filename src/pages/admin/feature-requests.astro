---
import Layout from '../../layouts/Layout.astro';
---
<Layout lang="en" title="Admin • Feature Requests" description="Moderate the public feature-request board" canonical="https://info.propertylist.es/admin/feature-requests">
	<meta name="robots" content="noindex,nofollow" slot="head" />
	<div class="shell">
		<header class="topbar">
			<div class="title"><a class="back" href="/admin/">← Dashboard</a><h1>Feature Requests</h1></div>
			<div class="hint">Approve pending ideas onto the public board, set statuses, prune spam. Public statuses: under-review, planned, building, live.</div>
		</header>
		<div id="status" class="status">Loading…</div>
		<div class="filters" id="filters" hidden>
			<label>Show <select id="statusFilter">
				<option value="pending">Pending (needs review)</option>
				<option value="all">All</option>
				<option value="under-review">Under review</option>
				<option value="planned">Planned</option>
				<option value="building">Building</option>
				<option value="live">Live</option>
				<option value="rejected">Rejected</option>
			</select></label>
			<span id="counts" class="muted"></span>
		</div>
		<div id="list"></div>
	</div>
</Layout>

<script>
	const statusEl = document.getElementById('status')!;
	const listEl = document.getElementById('list')!;
	const filtersEl = document.getElementById('filters')!;
	const filterSel = document.getElementById('statusFilter') as HTMLSelectElement;
	const countsEl = document.getElementById('counts')!;
	let ideas: any[] = [];

	const csrf = () => (document.cookie.match(/(?:^|;\s*)pl_admin_csrf=([^;]+)/) || [])[1] || '';

	async function load() {
		const r = await fetch('/api/admin/feature-requests');
		if (r.status === 401) { location.href = '/admin/login?next=/admin/feature-requests'; return; }
		const j = await r.json();
		if (!j.ok) { statusEl.textContent = 'Error loading: ' + (j.error || r.status); return; }
		ideas = j.ideas;
		statusEl.hidden = true;
		filtersEl.hidden = false;
		render();
	}

	function render() {
		const f = filterSel.value;
		const rows = ideas.filter((i) => (f === 'all' ? true : i.status === f));
		countsEl.textContent = `${rows.length} shown · ${ideas.length} total · ${ideas.filter((i) => i.status === 'pending').length} pending`;
		listEl.innerHTML = rows.length ? '' : '<p class="muted">Nothing here.</p>';
		for (const i of rows) {
			const card = document.createElement('div');
			card.className = 'card';
			const votes = `<span class="votes">▲ ${i.votes}</span>`;
			const email = i.email ? `<span class="muted">· ${i.email}</span>` : '';
			card.innerHTML = `
				<div class="cardTop"><strong>${escapeHtml(i.title)}</strong> ${votes} <span class="pill p-${i.status}">${i.status}</span></div>
				${i.detail ? `<p class="detail">${escapeHtml(i.detail)}</p>` : ''}
				<div class="meta muted">${new Date(i.at).toLocaleString()} · ${i.lang} ${email}</div>
				<div class="actions"></div>`;
			const actions = card.querySelector('.actions')!;
			const mk = (label: string, fn: () => void, cls = '') => {
				const b = document.createElement('button');
				b.textContent = label;
				b.className = 'btn ' + cls;
				b.addEventListener('click', fn);
				actions.appendChild(b);
			};
			for (const s of ['under-review', 'planned', 'building', 'improving', 'live', 'rejected']) {
				if (i.status !== s) mk(s === 'under-review' && i.status === 'pending' ? 'Approve → under review' : '→ ' + s, () => act(i.id, { action: 'status', status: s }), s === 'rejected' ? 'warn' : '');
			}
			mk('Delete', () => { if (confirm('Delete this idea permanently?')) act(i.id, { action: 'delete' }); }, 'danger');
			listEl.appendChild(card);
		}
	}

	async function act(id: string, body: any) {
		const r = await fetch('/api/admin/feature-requests', {
			method: 'POST',
			headers: { 'content-type': 'application/json', 'x-csrf-token': csrf() },
			body: JSON.stringify({ id, ...body }),
		});
		const j = await r.json().catch(() => null);
		if (!j || !j.ok) { alert('Action failed: ' + (j?.error || r.status)); return; }
		await load();
	}

	function escapeHtml(s: string) {
		return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	}

	filterSel.addEventListener('change', render);
	load();
</script>

<style>
	.shell { max-width: 880px; margin: 0 auto; padding: 30px 20px 70px; }
	.topbar { margin-bottom: 16px; }
	.title { display: flex; align-items: baseline; gap: 14px; }
	.back { color: #0a6d61; text-decoration: none; font-weight: 700; font-size: 14px; }
	h1 { margin: 0; font-size: 26px; }
	.hint { color: rgba(16, 24, 40, 0.6); font-size: 13.5px; margin-top: 4px; }
	.status { color: rgba(16, 24, 40, 0.6); }
	.filters { margin: 10px 0 14px; display: flex; gap: 14px; align-items: center; font-size: 14px; }
	.muted { color: rgba(16, 24, 40, 0.55); font-size: 12.5px; }
	.card { background: #fff; border: 1px solid rgba(16, 24, 40, 0.12); border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; }
	.cardTop { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
	.votes { font-weight: 800; color: #0a6d61; font-size: 13px; }
	.pill { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; padding: 2px 8px; border-radius: 999px; background: rgba(16, 24, 40, 0.08); }
	.p-pending { background: rgba(226, 104, 60, 0.15); color: #a24020; }
	.p-live { background: rgba(0, 174, 154, 0.15); color: #0a6d61; }
	.detail { margin: 8px 0 4px; font-size: 14px; color: rgba(16, 24, 40, 0.75); }
	.meta { margin-bottom: 8px; }
	.actions { display: flex; gap: 6px; flex-wrap: wrap; }
	.btn { font: inherit; font-size: 12.5px; font-weight: 700; padding: 5px 10px; border-radius: 8px; border: 1px solid rgba(16, 24, 40, 0.16); background: #f7f6f2; cursor: pointer; }
	.btn:hover { border-color: #00ae9a; }
	.btn.warn { color: #a24020; }
	.btn.danger { color: #fff; background: #c0392b; border-color: #c0392b; }
</style>
