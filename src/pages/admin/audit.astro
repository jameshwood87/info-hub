---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="en" title="Admin • Audit" description="Admin audit trail" canonical="https://info.propertylist.es/admin/audit">
	<meta name="robots" content="noindex,nofollow" slot="head" />

	<div class="shell">
		<header class="topbar">
			<div class="left">
				<a class="back" href="/admin/">← Dashboard</a>
				<div class="badge">Audit</div>
			</div>
			<div class="right">
				<button class="btnGhost" id="reloadBtn" type="button">Reload</button>
			</div>
		</header>

		<section class="controls">
			<div class="control">
				<label class="label" for="q">Filter</label>
				<input id="q" class="input" type="search" autocomplete="off" placeholder="action, path, user…" />
			</div>
		</section>

		<div id="err" class="err" role="status" aria-live="polite"></div>

		<section class="tableWrap">
			<table class="table" aria-label="Audit trail">
				<thead>
					<tr>
						<th>Time</th>
						<th>Action</th>
						<th>User</th>
						<th>Path</th>
						<th>Details</th>
					</tr>
				</thead>
				<tbody id="rows"></tbody>
			</table>
		</section>
	</div>

	<script is:inline>
		const state = { items: [], filtered: [] };
		const $ = (id) => document.getElementById(id);
		const rows = $('rows');
		const err = $('err');
		const q = $('q');
		const reloadBtn = $('reloadBtn');

		const setError = (m) => {
			err.textContent = m || '';
			err.style.display = m ? 'block' : 'none';
		};

		const escapeHtml = (s) =>
			String(s || '')
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;')
				.replaceAll("'", '&#39;');

		const applyFilter = () => {
			const query = (q.value || '').trim().toLowerCase();
			state.filtered = !query
				? state.items.slice()
				: state.items.filter((it) => {
						const hay = `${it.action || ''} ${it.userId || ''} ${it.path || ''} ${it.kbPageId || ''}`.toLowerCase();
						return hay.includes(query);
					});
			render();
		};

		const render = () => {
			rows.innerHTML = state.filtered
				.map((it) => {
					const when = it.at ? new Date(it.at).toLocaleString() : '';
					const details = it.details ? JSON.stringify(it.details) : '';
					return `
						<tr>
							<td class="tSmall">${escapeHtml(when)}</td>
							<td class="tStrong">${escapeHtml(it.action || '')}</td>
							<td class="tSmall">${escapeHtml(it.userId || '')}</td>
							<td class="tPath">${escapeHtml(it.path || '')}</td>
							<td class="tDetails">${escapeHtml(details)}</td>
						</tr>
					`;
				})
				.join('');
		};

		const load = async () => {
			setError('');
			const res = await fetch('/api/admin/audit?limit=200').catch(() => null);
			const data = res ? await res.json().catch(() => null) : null;
			if (!res || !res.ok || !data?.ok) {
				setError('Failed to load audit trail.');
				state.items = [];
				state.filtered = [];
				render();
				return;
			}
			state.items = Array.isArray(data.items) ? data.items : [];
			applyFilter();
		};

		q.addEventListener('input', applyFilter);
		reloadBtn.addEventListener('click', load);
		load();
	</script>
</Layout>

<style>
	.shell {
		display: grid;
		gap: 12px;
		padding: 10px 0 26px;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		padding: 14px;
		border-radius: 18px;
		border: 1px solid rgba(16, 24, 40, 0.08);
		background: radial-gradient(1200px 600px at 20% -20%, rgba(0, 174, 154, 0.18), rgba(255, 255, 255, 0));
	}

	.left {
		display: flex;
		gap: 10px;
		align-items: center;
	}

	.back {
		text-decoration: none;
		color: rgba(16, 24, 40, 0.75);
		font-weight: 900;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 900;
		font-size: 12px;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.right {
		display: flex;
		gap: 10px;
		align-items: center;
	}

	.controls {
		display: grid;
		grid-template-columns: 1fr;
		gap: 12px;
		align-items: end;
		padding: 14px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(16, 24, 40, 0.08);
	}

	.control {
		display: grid;
		gap: 4px;
	}

	.label {
		font-size: 13px;
		color: rgba(16, 24, 40, 0.75);
		font-weight: 800;
	}

	.input {
		border: 1px solid rgba(16, 24, 40, 0.18);
		border-radius: 10px;
		padding: 9px 11px;
		background: rgba(255, 255, 255, 0.95);
		width: 100%;
	}

	.btnGhost {
		border: 1px solid rgba(16, 24, 40, 0.18);
		background: rgba(255, 255, 255, 0.8);
		border-radius: 12px;
		padding: 9px 11px;
		font-weight: 900;
		cursor: pointer;
	}

	.err {
		display: none;
		padding: 12px 14px;
		border-radius: 18px;
		background: rgba(220, 38, 38, 0.08);
		border: 1px solid rgba(220, 38, 38, 0.18);
		color: rgba(127, 29, 29, 0.95);
		font-weight: 800;
	}

	.tableWrap {
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid rgba(16, 24, 40, 0.08);
		background: rgba(255, 255, 255, 0.85);
	}

	.table {
		width: 100%;
		border-collapse: collapse;
	}

	.table th,
	.table td {
		text-align: left;
		padding: 10px 12px;
		border-top: 1px solid rgba(16, 24, 40, 0.08);
		vertical-align: top;
	}

	.table thead th {
		border-top: 0;
		background: rgba(16, 24, 40, 0.03);
		font-size: 12px;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: rgba(16, 24, 40, 0.7);
	}

	.tSmall {
		color: rgba(16, 24, 40, 0.7);
		font-size: 13px;
		white-space: nowrap;
	}

	.tStrong {
		font-weight: 950;
	}

	.tPath {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
		font-size: 12px;
		color: rgba(16, 24, 40, 0.8);
	}

	.tDetails {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
		font-size: 12px;
		color: rgba(16, 24, 40, 0.72);
		white-space: pre-wrap;
		max-width: 70ch;
	}
</style>

