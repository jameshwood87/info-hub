---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="en" title="Admin Login • PropertyList Info Hub" description="Admin login" canonical="https://info.propertylist.es/admin/login">
	<meta name="robots" content="noindex,nofollow" slot="head" />

	<div class="wrap">
		<div class="card">
			<div class="brand">PropertyList</div>
			<h1>Admin</h1>
			<p class="sub">Sign in to manage blog posts and documentation pages.</p>

			<form id="loginForm" class="form">
				<label class="label" for="password">Password</label>
				<input id="password" name="password" type="password" class="input" autocomplete="current-password" required />
				<button class="btn" type="submit">Sign in</button>
				<div id="err" class="err" role="status" aria-live="polite"></div>
			</form>
		</div>
	</div>

	<script is:inline>
		const form = document.getElementById('loginForm');
		const pw = document.getElementById('password');
		const err = document.getElementById('err');

		const setError = (m) => {
			err.textContent = m || '';
			err.style.display = m ? 'block' : 'none';
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			setError('');
			const password = pw.value || '';
			if (!password) return setError('Password is required.');

			const res = await fetch('/api/admin/login', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ password }),
			}).catch(() => null);

			if (!res) return setError('Network error. Please try again.');
			const data = await res.json().catch(() => null);
			if (!res.ok || !data?.ok) {
				if (res.status === 429) return setError('Too many attempts. Please wait and try again.');
				return setError('Invalid password.');
			}
			location.href = '/admin/';
		});
	</script>
</Layout>

<style>
	.wrap {
		min-height: min(72vh, 720px);
		display: grid;
		place-items: center;
		padding: 24px 12px;
	}

	.card {
		width: min(460px, 100%);
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(16, 24, 40, 0.12);
		border-radius: 18px;
		padding: 18px;
		box-shadow: 0 14px 40px rgba(16, 24, 40, 0.08);
	}

	.brand {
		font-weight: 900;
		letter-spacing: -0.03em;
		color: rgba(16, 24, 40, 0.9);
	}

	h1 {
		margin: 10px 0 6px;
		letter-spacing: -0.04em;
		line-height: 1.06;
	}

	.sub {
		margin: 0 0 12px;
		color: rgba(16, 24, 40, 0.7);
		line-height: 1.55;
	}

	.form {
		display: grid;
		gap: 10px;
	}

	.label {
		font-size: 13px;
		color: rgba(16, 24, 40, 0.75);
		font-weight: 700;
	}

	.input {
		border: 1px solid rgba(16, 24, 40, 0.18);
		border-radius: 10px;
		padding: 10px 11px;
		background: rgba(255, 255, 255, 0.95);
	}

	.btn {
		border: 0;
		border-radius: 12px;
		padding: 10px 12px;
		background: rgba(var(--accent-rgb), 1);
		color: white;
		font-weight: 900;
		cursor: pointer;
	}

	.btn:active {
		transform: translateY(1px);
	}

	.err {
		display: none;
		padding: 10px 11px;
		border-radius: 12px;
		background: rgba(220, 38, 38, 0.08);
		border: 1px solid rgba(220, 38, 38, 0.18);
		color: rgba(127, 29, 29, 0.95);
		font-weight: 700;
	}
</style>

