<script>
	(async () => {
		const $ = (id) => document.getElementById(id);
		const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
		const csrf = (document.cookie.match(/(?:^|;\s*)pl_admin_csrf=([^;]+)/) || [])[1]
			|| (await fetch('/api/admin/me', { credentials: 'same-origin' }).then((r) => r.json()).then((d) => d.csrfToken).catch(() => ''));

		const load = async () => {
			const res = await fetch('/api/admin/content-proposals', { credentials: 'same-origin' });
			if (!res.ok) return;
			const d = await res.json();
			const box = $('proposalsBox');
			if (!d.proposals || !d.proposals.length) { box.innerHTML = ''; return; }
			box.innerHTML = `<div class="propWrap"><div class="actionTitle">Ready-to-publish improvements waiting for your approval (${d.proposals.length})</div>
				<p class="propExplain">The robot found pages that are close to Google page 1 and drafted a new section for each. <b>Approve &amp; publish</b> does everything automatically: the section is added to the live page (just above the FAQ), search engines are pinged, and it checks the page renders - nothing else for you to do. <b>Discard</b> deletes the draft; the page is untouched.</p>`
				+ d.proposals.map((p) => `<div class="prop" data-id="${esc(p.id)}">
					<div class="propHead"><a href="${esc(p.path)}" target="_blank" rel="noopener">${esc(p.path)}</a>
						<span class="muted">ranks #${p.position} in Google for "${esc(p.query)}" - shown ${p.impressions} times in 28 days</span></div>
					<div class="propWhy"><b>Why:</b> ${esc(p.rationale || '')}</div>
					<details><summary>Preview the section that will be added: <strong>${esc(p.heading)}</strong></summary><div class="propPrev">${p.html}</div></details>
					<div class="propBtns"><button class="btnApprove" data-act="approve" data-id="${esc(p.id)}">Approve &amp; publish</button>
						<button class="btnDiscard" data-act="discard" data-id="${esc(p.id)}">Discard</button>
						<span class="propMsg"></span></div>
				</div>`).join('') + `</div>`;
		};

		document.addEventListener('click', async (e) => {
			const b = e.target.closest('.propBtns button');
			if (!b) return;
			const wrap = b.closest('.prop');
			const msg = wrap.querySelector('.propMsg');
			b.disabled = true; msg.textContent = b.dataset.act === 'approve' ? 'Publishing…' : 'Discarding…';
			const res = await fetch('/api/admin/content-proposals', {
				method: 'POST', credentials: 'same-origin',
				headers: { 'content-type': 'application/json', 'x-csrf-token': csrf },
				body: JSON.stringify({ id: b.dataset.id, action: b.dataset.act }),
			}).then((r) => r.json()).catch(() => null);
			if (res && res.ok) {
				msg.textContent = res.action === 'approved' ? (res.rendered ? '✅ published & live' : '✅ published (may take a moment)') : 'discarded';
				setTimeout(() => wrap.remove(), 2500);
			} else { msg.textContent = 'failed'; wrap.querySelectorAll('button').forEach((x) => (x.disabled = false)); }
		});

		load();
	})();
</script>
