---
import Layout from '../../layouts/Layout.astro';
---
<Layout lang="en" title="Admin • Reports" description="Scam and problem reports" canonical="https://info.propertylist.es/admin/reports">
	<meta name="robots" content="noindex,nofollow" slot="head" />
	<div class="shell">
		<header class="topbar">
			<div class="title"><a class="back" href="/admin/">← Dashboard</a><h1>Reports</h1></div>
			<div class="hint">Confidential scam / problem reports. Private - never published.</div>
		</header>
		<div id="status" class="status">Loading…</div>
		<section id="content" hidden>
			<div id="repeats"></div>
			<div class="filters">
				<label>Show <select id="statusFilter">
					<option value="open">Open (new + reviewing)</option>
					<option value="all">All</option>
					<option value="new">New</option>
					<option value="reviewing">Reviewing</option>
					<option value="actioned">Actioned</option>
					<option value="dismissed">Dismissed</option>
				</select></label>
				<span id="counts" class="muted"></span>
			</div>
			<div id="list"></div>
		</section>
	</div>
</Layout>

<script>
	const $ = (id) => document.getElementById(id);
	const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
	const csrf = (document.cookie.match(/(?:^|;\s*)pl_admin_csrf=([^;]+)/) || [])[1] || '';
	let DATA = { reports: [], repeats: [] };

	const badge = (r) => r.flagCount >= 2 ? `<span class="flag">⚠ reported ${r.flagCount}x</span>` : '';
	const statusPill = (s) => `<span class="pill p-${s}">${s}</span>`;

	const card = (r) => `<div class="rep" data-id="${esc(r.id)}">
		<div class="repTop">
			<div><span class="type">${esc(r.type || 'report')}</span> ${r.subject ? `<strong>${esc(r.subject)}</strong>` : '<em class="muted">no name given</em>'} ${badge(r)}</div>
			<div class="meta">${esc(String(r.at).slice(0,16).replace('T',' '))} · ${statusPill(r.status || 'new')}</div>
		</div>
		<div class="detail">${esc(r.detail)}</div>
		<div class="fields">
			${r.amount ? `<span><b>Amount:</b> ${esc(r.amount)}</span>` : ''}
			${r.when ? `<span><b>When:</b> ${esc(r.when)}</span>` : ''}
			${r.evidence ? `<span><b>Evidence:</b> ${esc(r.evidence)}</span>` : ''}
			${(r.reporterName || r.reporterEmail) ? `<span><b>Reporter:</b> ${esc(r.reporterName || '')} ${r.reporterEmail ? `&lt;${esc(r.reporterEmail)}&gt;` : ''}</span>` : ''}
		</div>
		<div class="acts">
			<button data-act="reviewing">Reviewing</button>
			<button data-act="actioned">Actioned</button>
			<button data-act="dismissed">Dismiss</button>
			<button data-act="delete" class="del">Delete</button>
			<span class="msg"></span>
		</div>
	</div>`;

	const render = () => {
		const f = $('statusFilter').value;
		let rows = DATA.reports;
		if (f === 'open') rows = rows.filter((r) => r.status === 'new' || r.status === 'reviewing' || !r.status);
		else if (f !== 'all') rows = rows.filter((r) => (r.status || 'new') === f);
		$('counts').textContent = `${rows.length} shown · ${DATA.total} total · ${DATA.newCount} new`;
		$('list').innerHTML = rows.length ? rows.map(card).join('') : '<div class="empty">No reports match this filter.</div>';
		$('repeats').innerHTML = DATA.repeats.length
			? `<div class="repeatBox"><div class="repeatTitle">⚠ Reported more than once (possible repeat offenders)</div>${DATA.repeats.map((x) => `<div class="repeatRow"><strong>${esc(x.subject)}</strong> <span class="flag">${x.count} reports</span></div>`).join('')}</div>`
			: '';
	};

	const act = async (id, payload) => {
		const res = await fetch('/api/admin/reports', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json', 'x-csrf-token': csrf }, body: JSON.stringify({ id, ...payload }) }).then((r) => r.json()).catch(() => null);
		return res && res.ok;
	};

	document.addEventListener('click', async (e) => {
		const b = e.target.closest('.acts button');
		if (!b) return;
		const wrap = b.closest('.rep');
		const id = wrap.dataset.id;
		const msg = wrap.querySelector('.msg');
		const action = b.dataset.act;
		if (action === 'delete') {
			if (!confirm('Delete this report permanently?')) return;
			msg.textContent = 'deleting…';
			if (await act(id, { action: 'delete' })) { DATA.reports = DATA.reports.filter((r) => r.id !== id); render(); } else msg.textContent = 'failed';
			return;
		}
		msg.textContent = 'saving…';
		if (await act(id, { status: action })) { const r = DATA.reports.find((x) => x.id === id); if (r) r.status = action; render(); } else msg.textContent = 'failed';
	});
	$('statusFilter')?.addEventListener('change', render);

	(async () => {
		const res = await fetch('/api/admin/reports', { credentials: 'same-origin' });
		if (res.status === 401 || res.status === 403) { $('status').innerHTML = 'Session expired - <a href="/admin/login">log in</a> and reload.'; return; }
		if (!res.ok) { $('status').textContent = 'Failed to load (' + res.status + ').'; return; }
		DATA = await res.json();
		$('status').hidden = true; $('content').hidden = false; render();
	})().catch((e) => { $('status').textContent = 'Error: ' + e.message; });
</script>

<style>
	.shell { max-width: 900px; margin: 0 auto; padding: 24px 16px 60px; }
	.topbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
	.title h1 { margin: 4px 0 0; font-size: 26px; letter-spacing: -0.02em; }
	.back { font-size: 13px; color: rgba(16,24,40,0.6); text-decoration: none; }
	.hint { font-size: 12.5px; color: rgba(16,24,40,0.55); }
	.status { padding: 14px; border: 1px solid rgba(16,24,40,0.12); border-radius: 12px; background: #fff; font-size: 14px; }
	.muted { color: rgba(16,24,40,0.5); }
	.repeatBox { background: radial-gradient(600px 160px at 15% 0%, rgba(220,38,38,0.10), #fff); border: 1px solid rgba(220,38,38,0.3); border-radius: 12px; padding: 12px 14px; margin-bottom: 14px; }
	.repeatTitle { font-weight: 800; color: #b91c1c; margin-bottom: 6px; }
	.repeatRow { padding: 3px 0; font-size: 14px; }
	.filters { display: flex; align-items: center; gap: 14px; margin: 6px 0 14px; font-size: 13.5px; }
	.filters select { padding: 6px 10px; border-radius: 8px; border: 1px solid rgba(16,24,40,0.2); }
	.rep { background: #fff; border: 1px solid rgba(16,24,40,0.12); border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; }
	.repTop { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
	.type { display: inline-block; background: rgba(16,24,40,0.06); border-radius: 6px; padding: 1px 7px; font-size: 12px; font-weight: 700; margin-right: 4px; }
	.flag { display: inline-block; background: #fee2e2; color: #b91c1c; font-size: 11.5px; font-weight: 800; border-radius: 999px; padding: 1px 8px; }
	.meta { font-size: 12px; color: rgba(16,24,40,0.55); white-space: nowrap; }
	.detail { font-size: 14px; line-height: 1.55; margin: 8px 0; white-space: pre-wrap; color: rgba(16,24,40,0.85); }
	.fields { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12.5px; color: rgba(16,24,40,0.6); }
	.acts { display: flex; gap: 6px; align-items: center; margin-top: 10px; flex-wrap: wrap; }
	.acts button { font-size: 12.5px; font-weight: 700; border: 1px solid rgba(16,24,40,0.18); background: #fff; border-radius: 999px; padding: 5px 12px; cursor: pointer; }
	.acts .del { border-color: rgba(220,38,38,0.3); color: #b91c1c; }
	.msg { font-size: 12.5px; font-weight: 700; color: #065f46; }
	.pill { font-size: 11px; font-weight: 800; border-radius: 999px; padding: 1px 8px; }
	.p-new { background: #dbeafe; color: #1e40af; } .p-reviewing { background: #fef3c7; color: #92400e; }
	.p-actioned { background: #d1fae5; color: #065f46; } .p-dismissed { background: rgba(16,24,40,0.08); color: rgba(16,24,40,0.6); }
	.empty { padding: 20px; text-align: center; color: rgba(16,24,40,0.5); background: #fff; border: 1px solid rgba(16,24,40,0.1); border-radius: 12px; }
</style>
