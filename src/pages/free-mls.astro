---
import Layout from '../layouts/Layout.astro';

// Agent-facing explainer for the "free MLS" search intent. Every price below
// comes from the settled free-vs-paid ledger, verbatim. No competitor is named
// and no comparative claim is made about one, because we cannot verify their
// terms and do not need to: the network economics carry the argument.

const free = [
	['Listing your properties', 'Unlimited, with photos, documents and your own reference'],
	['The shared MLS', 'More than 1,300 agents can sell your listing with you'],
	['The public portal', 'Your listing appears on propertylist.es'],
	['Your MicroSite', 'A branded site for your agency, kept in sync automatically'],
	['XML feeds in and out', 'Import your stock, push it to Idealista, Fotocasa, Rightmove'],
	['The CRM core', 'Contacts, calendar, documents, and the Lead, Seller and Property pipelines'],
	['Market data by town and area', 'Notary-verified prices, not asking prices'],
	['The mobile app', 'The MLS and CRM on your phone'],
];

const paid = [
	['A qualified buyer moved into the Buyer pipeline', '1 credit, first 5 free'],
	['Property Intelligence Report', '5 credits, for a limited time'],
	['Automation & Nurture', '20 credits a month'],
	['Instant Content', '30 credits a month'],
	['Rentals Module', '50 credits per 30 days, after a 30-day free trial'],
	['Website Builder, once published', '50 credits a month'],
	['The whole network feed on your own website', '35 credits a month'],
];

const faqs = [
	{
		q: 'What is an MLS, and how is it different from a portal?',
		a: 'A portal shows your listing to buyers. An MLS shows it to other agents, so any of them can bring their buyer to your property and the commission splits on terms you set on the listing itself. One is advertising. The other is a network of colleagues who can close your stock for you.',
	},
	{
		q: 'What does PropertyList take from an agent-to-agent deal?',
		a: 'Nothing. No cut, no referral fee, in either direction, permanently. The split is between the two agencies on the terms attached to the listing. That is the part of the model that has to stay free, because it is what makes the network worth joining.',
	},
	{
		q: 'So where is the catch?',
		a: 'There is no catch, but the CRM is not 100% free and we would rather say so plainly. Receiving an enquiry costs nothing and reaching Qualified costs nothing. Moving a qualified buyer into the Buyer pipeline costs 1 credit, and your first 5 are free. Everything else paid is a module you switch on deliberately.',
	},
	{
		q: 'Is this free forever, or free for now?',
		a: 'Listing, MLS sharing, listings shown on the portal, your MicroSite, the XML feeds for direct listings and the CRM core are free with no time limit and no card required. Portal enquiries are free for a limited time. When that changes, it will be announced through all our channels, not slipped in.',
	},
	{
		q: 'What is a credit worth?',
		a: 'A credit is roughly 1€. It is 1.00€ at the 20-credit pack and less in larger packs, which is why we write "1 credit": 1€ is the maximum price per credit, less with larger purchases. <a href="/docs/propertylist-mls-user-manual/credits/how-to-use-and-earn-credits/">What is a credit?</a>',
	},
];
---

<Layout
	lang="en"
	title="A free MLS for Spanish estate agents: what that actually means | PropertyList"
	description="What an MLS is, what PropertyList costs, and what it never charges for. The whole price list on one page, including the parts that are not free."
	canonical="https://info.propertylist.es/free-mls/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/free-mls/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/mls-gratuito/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/free-mls/' },
	]}
	schema={{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	}}
>
	<section class="mHero">
		<p class="mKick">For estate agents in Spain</p>
		<h1 class="mH1">A free MLS, and the honest list of what is not free</h1>
		<p class="mLead">
			Joining costs nothing and listing costs nothing, permanently. Some things do cost credits, and they are all on
			this page rather than three clicks further in.
		</p>
	</section>

	<section class="mBand">
		<h2 class="mH2">First, what an MLS actually is</h2>
		<p>
			A portal advertises your property to buyers. An <strong>MLS shares it with other agents</strong>. When you list
			on PropertyList, more than 1,300 agents across the Costa del Sol can sell that property alongside you, and the
			commission splits on the terms you set on the listing.
		</p>
		<p>
			Sharing your stock does not mean sharing your reference. Every agency on the network has its own short code,
			so when another agency markets your listing it shows their number and never yours, and the references you
			have already given to clients keep working. Both numbers sit together in the CRM, yours first, so nobody
			quotes the wrong one on the phone.
		</p>
		<p class="mRefMore"><a href="/docs/propertylist-mls-user-manual/managing-listings/reference-numbers/">How reference numbers work →</a></p>
		<p>
			That single difference is the reason the core has to be free. A network that charges agents to share stock with
			each other stops being a network. <strong>PropertyList takes no cut of an agent-to-agent deal, in either
			direction, ever.</strong>
		</p>
		<p class="mCtaRow">
			<a class="mBtn" href="/what-we-do/">Watch one listing travel through it</a>
			<a class="mBtnG" href="/share-without-losing-control/">Worried about sharing? What stays yours</a>
		</p>
	</section>

	<section class="mBand mAlt">
		<h2 class="mH2">Free, with no time limit and no card</h2>
		<table class="mTable">
			<tbody>
				{free.map(([a, b]) => (
					<tr>
						<th scope="row">{a}</th>
						<td>{b}</td>
						<td class="mCost mFree">€0</td>
					</tr>
				))}
			</tbody>
		</table>
		<p class="mFine">
			Portal enquiries are also free at the moment: that one is <strong>free for a limited time</strong> rather than
			permanent, and we would rather write it that way round.
		</p>
	</section>

	<section class="mBand">
		<h2 class="mH2">What costs credits</h2>
		<p>
			Everything paid happens because you chose it, at the moment you choose it. Nothing switches itself on and there
			is no monthly fee on the core.
		</p>
		<table class="mTable">
			<tbody>
				{paid.map(([a, b]) => (
					<tr>
						<th scope="row">{a}</th>
						<td class="mCost mPaid">{b}</td>
					</tr>
				))}
			</tbody>
		</table>
		<p class="mFine">
			A credit is roughly 1€. For anything monthly, auto top-up can refill your balance before each renewal so nothing pauses; it is a way to pay, not an extra charge. Every paid feature has a free way to test it first: 5 buyer leads, 3 property reports,
			30 days of Rentals, and a Website Builder site that is free to build and preview until you publish it.
		</p>
	</section>

	<section class="mBand mAlt">
		<h2 class="mH2">The part most agents ask about twice</h2>
		<p>
			The CRM is not 100% free, and saying otherwise would be the easiest lie on this page. Receiving an enquiry is
			free. Working it up to Qualified is free. <strong>Deciding a qualified buyer is worth a place in your paid
			pipeline costs 1 credit, and your first 5 are free.</strong> If you never move them, you never pay.
		</p>
		<p>
			The Lead, Seller and Property pipelines are free with no limit. It is the Buyer pipeline that carries the
			credit, because that is the point where the platform is doing work that makes you money.
		</p>
	</section>

	<section class="mBand">
		<h2 class="mH2">Common questions</h2>
		<div class="mFaq">
			{faqs.map((f) => (
				<details class="mFaqItem">
					<summary class="mFaqQ">{f.q}</summary>
					<p class="mFaqA">{f.a}</p>
				</details>
			))}
		</div>
		<p class="mCtaRow">
			<a class="mBtn" href="https://agents.propertylist.es/new_agency/new?locale=en" target="_blank" rel="noopener" data-umami-event="signup-click">Create your free account</a>
			<a class="mBtnG" href="/pricing/">See the full pricing page</a>
		</p>
	</section>
</Layout>

<style>
	.mHero { max-width: 820px; margin: 0 auto; padding: 54px 20px 24px; text-align: center; }
	.mKick { margin: 0 0 10px; font-size: 13px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: #0a6d61; }
	.mH1 { margin: 0 0 14px; font-size: clamp(28px, 5vw, 42px); line-height: 1.15; letter-spacing: -0.5px; }
	.mLead { margin: 0 auto; max-width: 640px; font-size: 17px; line-height: 1.65; color: rgba(16, 24, 40, 0.75); }
	.mBand { max-width: 820px; margin: 0 auto; padding: 30px 20px; }
	.mAlt { background: rgba(0, 174, 154, 0.05); max-width: none; }
	.mAlt > * { max-width: 820px; margin-left: auto; margin-right: auto; }
	.mRefMore { margin: -6px 0 0; }
	.mRefMore a { color: var(--pl-accent, #00ae9a); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
	.mRefMore a:hover { text-decoration: none; }
	.mH2 { font-size: clamp(21px, 3vw, 28px); margin: 0 0 14px; letter-spacing: -0.3px; }
	.mBand p { line-height: 1.7; color: rgba(16, 24, 40, 0.78); margin: 0 0 14px; }
	.mTable { width: 100%; border-collapse: collapse; margin: 4px 0 14px; }
	.mTable tr { border-bottom: 1px solid rgba(16, 24, 40, 0.1); }
	.mTable th { text-align: left; font-weight: 700; padding: 11px 10px 11px 0; font-size: 15px; color: rgba(16, 24, 40, 0.85); }
	.mTable td { padding: 11px 0; font-size: 14.5px; color: rgba(16, 24, 40, 0.65); }
	.mCost { text-align: right; font-weight: 800; white-space: nowrap; }
	.mFree { color: #0a6d61; }
	.mPaid { color: #b45309; }
	.mFine { font-size: 14.5px; color: rgba(16, 24, 40, 0.6) !important; }
	.mCtaRow { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px !important; }
	.mBtn { background: #00ae9a; color: #fff; border-radius: 999px; padding: 13px 24px; font-weight: 800; text-decoration: none; }
	.mBtn:hover { background: #0a6d61; }
	.mBtnG { border: 1.5px solid rgba(16, 24, 40, 0.25); border-radius: 999px; padding: 13px 24px; font-weight: 700; text-decoration: none; color: rgba(16, 24, 40, 0.8); }
	.mBtnG:hover { border-color: #00ae9a; color: #0a6d61; }
	.mFaqItem { border-bottom: 1px solid rgba(16, 24, 40, 0.12); padding: 12px 2px; }
	.mFaqQ { font-weight: 700; cursor: pointer; font-size: 16px; }
	.mFaqA { margin: 10px 0 2px !important; font-size: 15px; }
	@media (max-width: 700px) { .mTable th, .mTable td { display: block; padding: 4px 0; } .mTable tr { padding: 10px 0; display: block; } .mCost { text-align: left; white-space: normal; } }
</style>
