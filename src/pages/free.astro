---
import Layout from '../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../lib/portalStats';
import AgentInterestCta from '../components/AgentInterestCta.astro';
import ExitIntent from '../components/ExitIntent.astro';

// /free/ redesigned 09-10-26 (James: "make this page a really good special design ... something people think WOW").
// One bold move: the hero receipt. A typical agency's monthly bill, built from the page's own conservative market
// floors (portal from 250, CRM from 30, website from 30, XML from 20 = from 330 a month), is struck through line by
// line and stamped 0 on load. Motion is transform and opacity only, with a static final state under reduced motion.
// Claims kept from the reviewed live page; PIR now says first 3 free (ledger); coverage no longer "mostly Costa del Sol".
const __ps = await getPortalStats();
const plListings = statPlus(__ps.listings, 'en');
const plAgents = statPlus(__ps.agents, 'en');
const plAgencies = statPlus(__ps.agencies, 'en');
const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=en';

// Typical Spanish market rates (2026), conservative floors, footnoted on the page.
const bill = [
	{ tool: 'Property portal presence', eur: 250, note: 'often 700+ with promotions', freeNote: '' },
	{ tool: 'Real estate CRM', eur: 30, note: '29 to 150 is typical', freeNote: 'core free; buyer leads 1 credit each' },
	{ tool: 'Agency website + hosting', eur: 30, note: 'or 500 to 2,000 to build', freeNote: 'branded MicroSite' },
	{ tool: 'Feed to other portals (XML)', eur: 20, note: 'often an add-on', freeNote: '' },
];
const billTotal = bill.reduce((s, b) => s + b.eur, 0);

const trade = [
	['The core is free.', 'The MLS, the CRM with your Lead, Seller and Property pipelines, portal listings and a branded MicroSite. No card, no contract.'],
	['Your listings are shared.', `With the ${plAgents} agents on the network, who can sell them for you.`],
	['We earn when you choose an extra.', 'A qualified buyer lead, featuring a listing, a report, the network feed, the Website Builder or the Rentals Module. All optional, all priced below.'],
];

const smallTiles = [
	['A branded MicroSite', 'Your own site at youragency.estate-agency.co, built from your listings, hosted free. Enquiries come straight to you.', 'microsite'],
	['Instant Listing', 'Add your images, describe the property out loud, and the full listing writes itself, ready to review.', ''],
	['AI Property Match', 'Paste a client message and it finds the match: your stock first, then the whole network. Free in beta.', 'beta'],
	['Free market data', 'Monthly snapshots for 20+ Costa del Sol towns, built on notary sale prices for each area.', ''],
	['Property alerts', 'Save a client brief and get an email the moment a matching home comes online anywhere on the network.', ''],
	['XML in and out', 'Import your existing feed, and send your own listings to your website or other portals. Both free.', ''],
	['The Android app', 'Your MLS and CRM in your pocket: capture a listing, log a lead, check your pipeline.', ''],
	['WhatsApp community', 'The agent WhatsApp groups, included with your account.', ''],
];

const extras = [
	['/pricing/', 'Buyer leads', 'Charged only when you choose to move a qualified lead into the Buyer pipeline', '1 credit each, first 5 free'],
	['/pricing/', 'Automation & Nurture', 'Nurture pipeline, automated emails, Hot-lead detection and the Daily Action Queue', 'Free'],
	['/pricing/', 'Rentals Module', 'Tenants pipeline, Tenancies, Maintenance and renewal reminders, with a free 30-day trial', '50 credits / 30 days'],
	['/property-intelligence-report/', 'Property Intelligence Report', 'A valuation built on notary sale prices for the area, with an agent brief', '5 credits, first 3 free'],
	['/pricing/', 'Feature a listing', 'Top of the MLS or the portal', 'from 10 credits'],
	['/pricing/', 'Network feed', 'Every listing on the network on your own website, by XML or the Website API. Your own listings stay free by XML feed', '35 credits / month'],
	['/website-builder/', 'Website Builder', 'A fully custom site. Your own domain is a 20-credit add-on. Build and preview free', 'from 50 credits / month'],
	['/instant-content/', 'Instant Content', 'One AI blog post and one area guide every week, an add-on to the Website Builder', '30 credits / month'],
];

const faqs = [
	{ q: 'Is it really free, or is it a trial?', a: 'Free forever, not a trial. The MLS, the CRM core, listing on the portal and your MicroSite cost nothing and always will, and the other tools above are free too (AI Property Match while it is in beta). There is no card required to start and no monthly fee on the core. Everything paid is optional and priced on this page. Automation & Nurture is free.' },
	{ q: 'Then how does PropertyList make money?', a: 'Two ways. Credits, for demand and one-offs: 1 credit for each qualified lead you decide to move into your Buyer pipeline, plus featuring a listing, Property Intelligence Reports, or keeping a sale off the shared network. And monthly subscriptions, paid in credits: the Rentals Module (50 credits per 30 days, with a free 30-day trial), the Website Builder and the network feed. Listing on the network (up to 25 photos each) and your Seller pipeline cost nothing.' },
	{ q: 'What is the catch?', a: 'There is not one on price. The trade is that your listings are shared with other agents on the network. That is the point: it is how more people can sell your stock. If you ever need a listing kept private, you can (first 5 free, then 5 credits each).' },
	{ q: 'Do I have to leave my current portal or CRM?', a: 'No. Import your existing XML feed, keep whatever else you use, and run PropertyList alongside it for free.' },
	{ q: 'How many agents are actually on it?', a: `${plAgents} agents across ${plAgencies} agencies, with ${plListings} live listings in the shared pool. Real, registered agencies.` },
];

const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const breadcrumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
	{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://info.propertylist.es/' },
	{ '@type': 'ListItem', position: 2, name: 'What you get free', item: 'https://info.propertylist.es/free/' },
] };
---
<Layout
	lang="en"
	title="Everything an Estate Agency Needs, Free | PropertyList"
	description="MLS, CRM, portal listings, a branded website and AI tools, free for estate agents in Spain. See exactly what is included, and what it replaces."
	canonical="https://info.propertylist.es/free/"
	ogImage="https://info.propertylist.es/og/og-free-v2.jpg"
	twitterCard="summary_large_image"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/free/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/gratis/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/free/' },
	]}
>
	<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(breadcrumbLd)} />

	<section class="hero"><div class="cx heroGrid">
		<div class="heroCopy">
			<p class="badge"><span class="dot"></span>No card. No contract.</p>
			<h1>Win more listings. Sell more homes. <b>Free.</b></h1>
			<p class="lead">Most portals charge you to list. PropertyList works the other way round: your listings reach {plAgents} agents who can sell them, and you can sell from all {plListings} listings on the network.</p>
			<p class="ctaRow"><a class="btn" href={SIGNUP} target="_blank" rel="noopener">Create your free account</a> <a class="ghost" href="#free">See everything included</a></p>
			<p class="micro">{plAgents} agents &middot; {plAgencies} agencies &middot; {plListings} live listings</p>
		</div>
		<figure class="rWrap" id="stack">
			<div class="receipt" role="group" aria-labelledby="rTitle">
				<p class="rHead" id="rTitle">A typical agency's monthly bill</p>
				<p class="rSub">Starting prices at typical Spanish market rates, 2026</p>
				<ul class="rLines">
					{bill.map((b, i) => (
						<li style={`--i:${i}`}>
							<span class="rTool">{b.tool}<em>{b.note}</em></span>
							<span class="rCost"><s>from &euro;{b.eur}</s><b class="rFree">Free{b.freeNote ? <em>{b.freeNote}</em> : null}</b></span>
						</li>
					))}
				</ul>
				<div class="rTotal"><span>Total a month</span><s>from &euro;{billTotal}</s></div>
				<div class="stamp"><span>Core on PropertyList</span><b>&euro;0</b></div>
			</div>
			<figcaption>Floors of typical Spanish market rates, 2026; ranges vary by agency size, region and promotions. The free website is your branded MicroSite; a fully custom site is the <a href="/website-builder/">Website Builder</a>, from 50 credits a month, with your own domain as a 20-credit add-on.</figcaption>
		</figure>
		<script is:inline>(function(){var r=document.querySelector('.receipt');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;r.classList.add('pre');var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){r.classList.add('anim');io.disconnect();}},{threshold:0.4});io.observe(r);})();</script>
	</div></section>

	<section class="band"><div class="cx">
		<h2>Sounds too good to be true? <b>Here is the trade.</b></h2>
		<div class="steps">
			{trade.map(([h, p]) => (<div class="step"><h3>{h}</h3><p>{p}</p></div>))}
		</div>
	</div></section>

	<section class="band soft" id="free"><div class="cx">
		<h2>What you get, <b>free.</b></h2>
		<p class="sub">Everything an agency runs on, from the first listing to the signed deal.</p>
		<div class="bento">
			<div class="tile xl">
				<p class="tName">The shared MLS</p>
				<p class="big">{plAgents}</p>
				<p class="bigLabel">agents can sell your listing</p>
				<p class="tText">List once, and sell from all {plListings} listings on the network, not just your own. Leads and referrals between agents are free, forever.</p>
			</div>
			<div class="tile wide">
				<p class="tName">A free CRM</p>
				<p class="tText">Unlimited contacts, calendar and documents. The Lead, Seller and Property pipelines are free, and so is Nurture. A buyer lead is 1 credit when you move it into the Buyer pipeline, your first 5 free. Tenants comes with the Rentals Module.</p>
				<p class="chips"><span>Leads</span><span>Sellers</span><span>Property</span><span>Nurture</span></p>
			</div>
			<div class="tile wide">
				<p class="tName">Your listings on the portal</p>
				<p class="mid">{plListings}</p>
				<p class="tText">homes on propertylist.es, in front of buyers, with yours among them. No listing fees, ever.</p>
			</div>
			{smallTiles.map(([t, d, kind]) => (
				<div class="tile">
					<p class="tName">{t}{kind === 'beta' ? <span class="beta">Beta</span> : null}</p>
					{kind === 'microsite' ? <p class="url"><i></i>youragency.estate-agency.co</p> : null}
					<p class="tText">{d}</p>
				</div>
			))}
		</div>
	</div></section>

	<section class="band dark"><div class="cx">
		<div class="proof">
			<div><b>{plAgents}</b><span>agents on the network</span></div>
			<div><b>{plAgencies}</b><span>real local agencies</span></div>
			<div><b>{plListings}</b><span>live listings shared</span></div>
			<div><b>&euro;0</b><span>to join, no card</span></div>
		</div>
		<p class="alt">Every home you take on can be sold by {plAgents} agents, so more agents are looking for its buyer.</p>
	</div></section>

	<section class="band"><div class="cx">
		<h2>When you are ready to grow, <b>priced openly.</b></h2>
		<p class="sub">The core stays free. Credits when we hand you demand or you want a one-off; a monthly subscription for the parts that run in the background. <a href="/verify-your-agency/">Verify your agency</a> (free, whenever you like) for 20 free credits, and most paid features have a free test.</p>
		<div class="extras">
			{extras.map(([href, t, d, price]) => (
				<a href={href}><b>{t}</b><span>{d}</span><em>{price}</em></a>
			))}
		</div>
		<p class="links"><a href="/pricing/">Full pricing</a> <a href="/features/">All the tools</a> <a href="/costa-del-sol/">Drive the coast</a></p>
	</div></section>

	<section class="band soft"><div class="cx">
		<h2>Common questions.</h2>
		<div class="faqwrap">
			{faqs.map((f) => (<details class="faqItem"><summary>{f.q}</summary><p>{f.a}</p></details>))}
		</div>
	</div></section>

	<section class="band close"><div class="cx">
		<h2>Start free. <b>Keep it free.</b></h2>
		<p class="alt">Create your account, import your listings, and you are live on the network in minutes. No card, no contract.</p>
		<p class="ctaRow"><a class="btn" href={SIGNUP} target="_blank" rel="noopener">Create your free account</a> <a class="ghost" href="/launch/">See it built in 9 minutes</a></p>
	</div></section>

	<AgentInterestCta lang="en" page="/free/" />
	<ExitIntent lang="en" />
</Layout>

<style>
	.cx { width: min(1120px, 100% - 32px); margin: 0 auto; }

	/* Hero: brand ink, one teal glow, the receipt as the single bold move */
	.hero { position: relative; overflow: hidden; background: #0b1b22; color: #fff; padding: 36px 0 56px; }
	.hero::before { content: ''; position: absolute; width: 720px; height: 720px; right: -220px; top: -260px; border-radius: 50%; background: radial-gradient(circle, rgba(0, 174, 154, 0.28), rgba(0, 174, 154, 0) 70%); pointer-events: none; }
	.heroGrid { position: relative; display: grid; gap: 36px; align-items: center; }
	.badge { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; padding: 6px 12px; border-radius: 999px; background: rgba(125, 238, 222, 0.12); border: 1px solid rgba(125, 238, 222, 0.35); color: #c9f5ee; font-size: 14px; font-weight: 700; }
	.dot { width: 8px; height: 8px; border-radius: 50%; background: #00ae9a; box-shadow: 0 0 0 4px rgba(0, 174, 154, 0.2); }
	h1 { font-size: 44px; line-height: 1.04; letter-spacing: -0.035em; font-weight: 800; margin: 0; max-width: 15ch; }
	h1 b { color: #7deede; }
	.lead { font-size: 19px; line-height: 1.5; color: #c9d6da; margin: 18px 0 24px; max-width: 44ch; }
	.ctaRow { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
	.btn { display: inline-block; background: #00ae9a; color: #0b1b22; font-weight: 800; font-size: 18px; padding: 16px 26px; border-radius: 14px; text-decoration: none; box-shadow: 0 10px 30px rgba(0, 174, 154, 0.35); }
	.btn:hover { background: #7deede; }
	.ghost { color: #c9d6da; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
	.ghost:hover { color: #fff; }
	.micro { margin: 16px 0 0; font-size: 14px; color: #8fa0a6; }

	.rWrap { margin: 0; position: relative; }
	.rWrap figcaption { margin: 76px auto 0; max-width: 420px; font-size: 12px; line-height: 1.5; color: #8fa0a6; text-align: center; }
	.rWrap figcaption a { color: #c9d6da; }
	.receipt { position: relative; max-width: 440px; margin: 0 auto; background: #fbfaf6; color: #0b1b22; padding: 26px 24px 30px; border-radius: 4px 4px 0 0; transform: rotate(1.6deg); box-shadow: 0 40px 80px rgba(0, 0, 0, 0.45); }
	.receipt::after { content: ''; position: absolute; left: 0; right: 0; bottom: -12px; height: 12px; background: linear-gradient(-45deg, transparent 8px, #fbfaf6 0) 0 0 / 16px 12px repeat-x, linear-gradient(45deg, transparent 8px, #fbfaf6 0) 0 0 / 16px 12px repeat-x; }
	.rHead { margin: 0; font-size: 18px; font-weight: 800; letter-spacing: -0.01em; text-align: center; }
	.rSub { margin: 4px 0 14px; font-size: 12px; color: #5b6b73; text-align: center; padding-bottom: 14px; border-bottom: 2px dashed #d5dcdf; }
	.rLines { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
	.rLines li { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
	.rTool { font-size: 15px; font-weight: 700; line-height: 1.3; }
	.rTool em { display: block; font-style: normal; font-weight: 500; font-size: 12px; color: #5b6b73; margin-top: 2px; }
	.rCost { display: grid; justify-items: end; text-align: right; flex-shrink: 0; max-width: 46%; font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; }
	.rCost s, .rTotal s { position: relative; text-decoration: none; color: #3d4a4f; font-size: 15px; white-space: nowrap; }
	.rCost s::after, .rTotal s::after { content: ''; position: absolute; left: -3px; right: -3px; top: 52%; height: 2px; background: #b4232a; transform: scaleX(1); transform-origin: left center; }
	.rFree { font-family: inherit; font-size: 15px; color: #0a6d61; }
	.rFree em { display: block; white-space: normal; line-height: 1.3; margin-top: 2px; font-style: normal; font-weight: 500; font-size: 11px; color: #3d4a4f; font-family: system-ui, sans-serif; }
	.rTotal { --i: 4.2; display: flex; justify-content: space-between; align-items: baseline; margin-top: 16px; padding-top: 14px; border-top: 2px dashed #d5dcdf; font-weight: 800; }
	.rTotal s { font-size: 20px; font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; color: #0b1b22; }
	.stamp { position: absolute; right: -6px; bottom: -58px; z-index: 2; display: grid; justify-items: center; padding: 8px 16px 6px; border: 4px solid #00ae9a; border-radius: 12px; color: #0a6d61; background: rgba(230, 247, 244, 0.95); transform: rotate(-8deg); }
	.stamp span { font-size: 11px; font-weight: 800; }
	.stamp b { font-size: 46px; line-height: 1; font-weight: 800; letter-spacing: -0.03em; }
	/* Default is the finished receipt (no JS, reduced motion). The inline script adds .pre (start state) and then .anim
	   when the receipt is 40% in view, so the strike-through plays where the visitor can see it, including on a phone. */
	.receipt.pre .rCost s::after, .receipt.pre .rTotal s::after { transform: scaleX(0); }
	.receipt.pre .rFree { opacity: 0; transform: translateY(6px); }
	.receipt.pre .stamp { opacity: 0; transform: rotate(-10deg) scale(1.9); }
	.receipt.anim .rCost s::after, .receipt.anim .rTotal s::after { animation: strike 0.45s ease-out forwards; animation-delay: calc(0.3s + var(--i, 0) * 0.38s); }
	.receipt.anim .rFree { animation: rise 0.4s ease-out forwards; animation-delay: calc(0.55s + var(--i, 0) * 0.38s); }
	.receipt.anim .stamp { animation: stamp 0.5s cubic-bezier(0.2, 1.5, 0.4, 1) 2.5s forwards; }
	@keyframes strike { to { transform: scaleX(1); } }
	@keyframes rise { to { opacity: 1; transform: none; } }
	@keyframes stamp { to { opacity: 1; transform: rotate(-8deg) scale(1); } }
	@media (prefers-reduced-motion: reduce) {
		.receipt.pre .rCost s::after, .receipt.pre .rTotal s::after { transform: scaleX(1); animation: none; }
		.receipt.pre .rFree { opacity: 1; transform: none; animation: none; }
		.receipt.pre .stamp { opacity: 1; transform: rotate(-8deg); animation: none; }
	}
	/* Bands */
	.band { padding: 48px 0; border-top: 1px solid #e7eef1; background: #fff; }
	.soft { background: #f4f7f8; }
	h2 { font-size: 32px; line-height: 1.1; letter-spacing: -0.025em; font-weight: 800; margin: 0; max-width: 22ch; }
	h2 b { color: #008a7a; }
	.sub { font-size: 17px; line-height: 1.5; color: #28383f; margin: 10px 0 0; max-width: 60ch; }
	.sub a { color: #0a6d61; font-weight: 700; }
	.steps { display: grid; gap: 22px; margin-top: 26px; }
	.step { padding-top: 14px; border-top: 3px solid #00ae9a; }
	.step h3 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 0; }
	.step p { margin: 6px 0 0; color: #28383f; max-width: 38ch; }

	/* Bento of free tools */
	.bento { display: grid; gap: 12px; margin-top: 26px; }
	.tile { background: #fff; border: 1px solid #dfe6e8; border-radius: 18px; padding: 18px; display: flex; flex-direction: column; gap: 6px; }
	.tName { margin: 0; font-size: 17px; font-weight: 800; display: flex; align-items: center; gap: 8px; }
	.tText { margin: 0; font-size: 15px; line-height: 1.5; color: #3d4a4f; }
	.beta { font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 999px; background: #e6f7f4; color: #0a6d61; }
	.url { margin: 2px 0 4px; display: flex; align-items: center; gap: 8px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px; color: #28383f; background: #f4f7f8; border: 1px solid #dfe6e8; border-radius: 8px; padding: 6px 10px; overflow-wrap: anywhere; }
	.url i { width: 8px; height: 8px; border-radius: 50%; background: #00ae9a; flex-shrink: 0; }
	.tile.xl { background: #0a6d61; border-color: #0a6d61; color: #fff; justify-content: flex-end; min-height: 280px; background-image: radial-gradient(circle at 85% 10%, rgba(125, 238, 222, 0.35), rgba(125, 238, 222, 0) 55%); }
	.tile.xl .tName { color: #c9f5ee; }
	.tile.xl .tText { color: #e6f7f4; }
	.big { margin: 4px 0 0; font-size: 72px; line-height: 0.95; font-weight: 800; letter-spacing: -0.04em; }
	.bigLabel { margin: 0 0 8px; font-size: 18px; font-weight: 700; color: #c9f5ee; }
	.mid { margin: 2px 0 0; font-size: 44px; line-height: 1; font-weight: 800; letter-spacing: -0.03em; color: #0a6d61; }
	.chips { margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
	.chips span { font-size: 12px; font-weight: 800; padding: 4px 10px; border-radius: 999px; background: #e6f7f4; color: #0a6d61; }

	/* Proof */
	.dark { background: #0b1b22; color: #fff; border-top: 0; }
	.proof { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 16px; }
	.proof b { display: block; font-size: 44px; line-height: 1; font-weight: 800; letter-spacing: -0.03em; color: #7deede; }
	.proof span { display: block; margin-top: 6px; font-size: 15px; color: #c9d6da; }
	.alt { margin: 26px 0 0; color: #c9d6da; font-size: 17px; line-height: 1.5; max-width: 60ch; }

	/* Extras */
	.extras { display: grid; gap: 10px; margin-top: 24px; }
	.extras a { display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; align-items: baseline; padding: 14px 16px; border: 1px solid #dfe6e8; border-radius: 14px; text-decoration: none; color: #0b1b22; background: #fff; }
	.extras a:hover { border-color: #00ae9a; }
	.extras b { font-size: 17px; }
	.extras span { grid-column: 1 / -1; grid-row: 2; font-size: 14px; color: #3d4a4f; }
	.extras em { font-style: normal; font-weight: 800; font-size: 14px; color: #0a6d61; text-align: right; }
	.links { display: flex; flex-wrap: wrap; gap: 18px; margin: 18px 0 0; }
	.links a { color: #0a6d61; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

	/* FAQ and close */
	.faqwrap { margin-top: 20px; }
	.faqItem { border-top: 1px solid #e7eef1; padding: 14px 0; }
	.faqItem:last-child { border-bottom: 1px solid #e7eef1; }
	.faqItem summary { font-weight: 800; font-size: 19px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
