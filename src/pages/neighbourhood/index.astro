---
import Layout from '../../layouts/Layout.astro';
import { areaImagePath } from '../../lib/areaImages';
import { canonicalAreaPath, provinceForAreaSlug } from '../../lib/areaProvince';
import { adminCreateKbPage, listKbPagesByPrefix } from '../../lib/directus';
import { getKbMetaSnapshot } from '../../lib/adminMeta';
import { getWeeklyTopPaths } from '../../lib/weeklyViews';

let itemsRaw = await listKbPagesByPrefix({ prefix: '/neighbourhood/', lang: 'en', limit: 200 });
if (!itemsRaw.length) {
	try {
		await adminCreateKbPage({
			status: 'published',
			language: 'en',
			path: '/neighbourhood/marbella/',
			title: 'Marbella Neighbourhood Guide',
			description: 'A practical overview of lifestyle, property types, and what buyers care about.',
			body: `<h2>At a glance</h2>
<p>Marbella is one of the Costa del Sol’s best-known markets, combining year-round liveability with strong international demand.</p>
<h2>Who it suits</h2>
<p>Families, second-home buyers, and lifestyle-led purchasers looking for beach access, dining, and services.</p>
<h2>Property types</h2>
<p>Apartments near the centre and beachfront; villas in established residential areas; gated communities in hillside zones.</p>
<h2>Things to check</h2>
<ul><li>Walking distance vs. hillside drives</li><li>Community fees and amenities</li><li>Licence/registry checks for rentals</li></ul>`,
			seo_title: 'Marbella neighbourhood guide (Costa del Sol)',
			seo_description: 'Local overview of Marbella: lifestyle, property types, and practical buying considerations.',
		});
	} catch {}
	itemsRaw = await listKbPagesByPrefix({ prefix: '/neighbourhood/', lang: 'en', limit: 200 });
}

const stripSuffix = (s: string) => String(s || '').replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '').trim();
const stripGuideSuffix = (s: string) =>
	stripSuffix(s)
		.replace(/\s+(?:neighbourhood\s+guide|area\s+guide)\s*$/i, '')
		.replace(/\s+/g, ' ')
		.trim();

const slugify = (s: string) =>
	String(s || '')
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');

const canonicalProvinceLabel = (key: string) => {
	const k = slugify(key);
	const map: Record<string, string> = {
		almeria: 'Almería',
		baleares: 'Islas Baleares',
		madrid: 'Madrid',
		cadiz: 'Cádiz',
		cordoba: 'Córdoba',
		granada: 'Granada',
		huelva: 'Huelva',
		jaen: 'Jaén',
		malaga: 'Málaga',
		sevilla: 'Sevilla',
	};
	return map[k] || String(key || '').trim();
};

const metaSnapshot = await getKbMetaSnapshot().catch(() => ({} as Record<string, any>));

const extractProvince = (id: string): { key: string; label: string } => {
	const tags = Array.isArray((metaSnapshot as any)?.[String(id)]?.tags) ? ((metaSnapshot as any)[String(id)].tags as any[]) : [];
	const cleanTags = tags.map((t) => String(t || '').trim()).filter(Boolean);
	const kv = cleanTags
		.map((t) => {
			const m = t.match(/^(?:province|prov)\s*[:=]\s*(.+)$/i);
			return m ? String(m[1] || '').trim() : '';
		})
		.filter(Boolean)[0];

	if (kv) {
		const key = slugify(kv) || 'malaga';
		return { key, label: canonicalProvinceLabel(key) };
	}

	const loose = cleanTags
		.map((t) => slugify(t))
		.filter(Boolean)
		.find((t) => ['almeria', 'cadiz', 'cordoba', 'granada', 'huelva', 'jaen', 'malaga', 'sevilla'].includes(t));
	if (loose) return { key: loose, label: canonicalProvinceLabel(loose) };

	return { key: 'malaga', label: 'Málaga' };
};

const canonicalGuideHref = (p: any) => {
	const rawPath = String(p?.path || '');
	const parts = rawPath.split('/').filter(Boolean);
	if (parts[0] !== 'neighbourhood') return rawPath;
	if (parts.length >= 4) return rawPath;
	if (parts.length !== 2) return rawPath;
	const slug = parts[1] || '';
	if (!slug) return rawPath;
	return canonicalAreaPath(slug);
};

const slugFromNeighbourhoodPath = (p: any) => {
	const rawPath = String(p?.path || '');
	const parts = rawPath.split('/').filter(Boolean);
	if (parts[0] !== 'neighbourhood') return '';
	if (parts.length === 2) return parts[1] || '';
	if (parts.length === 4) return parts[3] || '';
	return '';
};

const trimTo = (s: string, max: number) => {
	const t = String(s || '').trim();
	if (!t) return '';
	const n = Math.max(1, Number(max) || 80);
	if (t.length <= n) return t;
	return `${t.slice(0, Math.max(0, n - 1)).trimEnd()}…`;
};

const CARD_DESC_BY_SLUG: Record<string, string> = {
	benahavis: 'Benahavís hillside village: golf resorts, dining, gated villas and views.',
	benalmadena: 'Benalmádena coast: marina, beaches, family amenities and airport access.',
	cancelada: 'Cancelada: quieter Estepona pocket near golf; low-rise homes and local cafés.',
	'el-limonar': 'El Limonar (Málaga): leafy villas, schools, and quick walks to the sea.',
	elviria: 'Elviria: Marbella East for dunes, beach clubs and golf; villas and apartments.',
	'estepona-old-town': 'Estepona Old Town: flowered lanes, tapas squares and charming homes.',
	estepona: 'Estepona: renovated centre, marina, and promenade with year-round life.',
	fuengirola: 'Fuengirola: long beachfront, train to Málaga, and an amenity-rich promenade.',
	'golden-mile': 'Golden Mile: Marbella–Banús prime strip with luxury villas and beach resorts.',
	guadalmina: 'Guadalmina: established golf area by San Pedro; gated homes and beach access.',
	'la-cala-de-mijas': 'La Cala de Mijas: walkable beach village, markets, chiringuitos and cafés.',
	'la-quinta': 'La Quinta: Benahavís golf valley with views and secure communities near Marbella.',
	'la-zagaleta': 'La Zagaleta: ultra-private estate with big plots, top security and club living.',
	'los-monteros': 'Los Monteros: Marbella East luxury by the dunes; beachfront villas and golf.',
	'malaga-centre': 'Málaga Centre: historic core, museums and dining; strong city rental demand.',
	marbella: 'Marbella: beach town glamour, dining, and prime districts from centre to hills.',
	'mijas-costa': 'Mijas Costa: stretch between Fuengirola and Marbella with varied homes by sea.',
	nerja: 'Nerja: coves, caves and Balcón de Europa views with relaxed Andalusian charm.',
	'new-golden-mile': 'New Golden Mile: Marbella–Estepona coast with modern complexes and beaches.',
	'nueva-andalucia': 'Nueva Andalucía: Golf Valley behind Banús; villas, gated flats and schools.',
	pedregalejo: 'Pedregalejo (Málaga): relaxed promenade, chiringuitos and low-rise beach living.',
	'puerto-banus': 'Puerto Banús: marina, nightlife and designer shops; high-end flats and rentals.',
	'san-pedro-de-alcantara': 'San Pedro: local town feel, new boulevard, beach walks and amenities.',
	'sierra-blanca': 'Sierra Blanca: prestige gated hillside above Marbella with privacy and views.',
	torremolinos: 'Torremolinos: wide beaches, nightlife and a quick train ride into Málaga.',
};

const isGenericDesc = (s: string) => {
	const t = String(s || '').trim().toLowerCase();
	if (!t) return true;
	if (t === 'local overview of this neighbourhood.') return true;
	if (t.includes('local overview') && t.includes('neighbourhood')) return true;
	if (t.includes('practical overview') && t.includes('lifestyle')) return true;
	if (t.includes('property types') && t.includes('buyers')) return true;
	return false;
};

const autoCardDescFor = (p: any) => {
	const title = String((p as any)?._label || p?.title || '').trim();
	const base = stripGuideSuffix(title).replace(/\s*\([^)]*\)\s*$/, '').trim() || title || 'Neighbourhood';
	const slug = slugFromNeighbourhoodPath(p);
	const tokens = (slug ? slug.split('-') : slugify(base).split('-')).filter(Boolean);
	const tokenSet = new Set(tokens);
	const hints: string[] = [];

	if (tokenSet.has('puerto') || tokenSet.has('banus') || tokenSet.has('marina')) hints.push('marina living');
	if (tokenSet.has('golf') || tokenSet.has('quinta') || tokenSet.has('zagaleta') || tokenSet.has('guadalmina')) hints.push('golf nearby');
	if (tokenSet.has('old') || tokenSet.has('town') || tokenSet.has('centre') || tokenSet.has('centro')) hints.push('walkable centre');
	if (tokenSet.has('beach') || tokenSet.has('costa') || tokenSet.has('playa')) hints.push('beach access');
	if (tokenSet.has('sierra') || tokenSet.has('hills') || tokenSet.has('blanca')) hints.push('views & privacy');

	const detail = hints.length ? hints.slice(0, 2).join(', ') : 'lifestyle and property mix';
	return trimTo(`${base}: ${detail}.`, 82);
};

const cardDescFor = (p: any) => {
	const slug = slugFromNeighbourhoodPath(p);
	const fromMap = slug ? CARD_DESC_BY_SLUG[slug] : '';
	if (fromMap) return trimTo(fromMap, 82);
	const fromPage = String(p?.description || '').trim();
	if (fromPage && !isGenericDesc(fromPage)) return trimTo(fromPage, 82);
	return autoCardDescFor(p);
};

const canonicalizeNeighbourhoodPath = (path: string) => {
	const p = String(path || '').trim();
	if (!p.startsWith('/neighbourhood/')) return '';
	const parts = p.split('/').filter(Boolean);
	if (parts[0] !== 'neighbourhood') return '';
	if (parts.length === 2 && parts[1] && parts[1] !== 'andalucia' && parts[1] !== 'spain') return canonicalAreaPath(parts[1]);
	if (parts.length === 4 && parts[3]) return canonicalAreaPath(parts[3]);
	return '';
};

const TOP_SUMMARY_BY_SLUG: Record<string, { summary: string; priceHint?: string }> = {
	marbella: {
		summary:
			'Marbella blends year-round living with beaches, dining and a walkable old town. Demand stays strong across apartments and villa zones.',
	},
	'puerto-banus': {
		summary:
			'Puerto Banús is known for its marina, nightlife and designer shopping. It’s a favourite for lock-up-and-leave apartments and rentals.',
	},
	'nueva-andalucia': {
		summary:
			'Nueva Andalucía is the Golf Valley behind Banús with big villa areas and gated communities. Popular with families and international buyers.',
	},
	benalmadena: {
		summary:
			'Benalmádena offers a marina, beaches and family amenities with quick airport access. Great for holiday-use and long-term living alike.',
	},
	estepona: {
		summary:
			'Estepona has a revitalised centre, marina and long promenade, with plenty of new developments. It suits buyers wanting value with lifestyle.',
	},
};

const topSummaryFor = (p: any) => {
	const slug = slugFromNeighbourhoodPath(p);
	const mapped = slug && TOP_SUMMARY_BY_SLUG[slug]?.summary ? TOP_SUMMARY_BY_SLUG[slug]!.summary : '';
	if (mapped) return mapped;
	const first = cardDescFor(p);
	const s1 = first.endsWith('.') ? first : `${first}.`;
	const s2 = 'See highlights, practical tips and the current property snapshot in the guide.';
	return `${s1} ${s2}`;
};

const formatEurCompact = (n: number) => {
	const v = Number(n);
	if (!Number.isFinite(v) || v <= 0) return '';
	if (v >= 1_000_000) return `€${(v / 1_000_000).toFixed(v >= 10_000_000 ? 0 : 1)}M`;
	if (v >= 1_000) return `€${Math.round(v / 1_000)}k`;
	return `€${Math.round(v)}`;
};

const priceRangeFor = (p: any) => {
	const id = String((p as any)?.id || '');
	const stats: any = id ? (metaSnapshot as any)?.[id]?.neighbourhoodStats : null;
	const min = Number(stats?.priceMinEur);
	const max = Number(stats?.priceMaxEur);
	const avg = Number(stats?.avgPriceEur);
	const minOk = Number.isFinite(min) && min > 0;
	const maxOk = Number.isFinite(max) && max > 0;
	const avgOk = Number.isFinite(avg) && avg > 0;
	if (minOk && maxOk) return `${formatEurCompact(min)}–${formatEurCompact(max)}`;
	if (avgOk) return `Around ${formatEurCompact(avg)}`;
	return 'Estimate unavailable';
};

const items = [...itemsRaw]
	.map((p) => {
		const slugForProv = slugFromNeighbourhoodPath(p);
		const mappedProv = provinceForAreaSlug(slugForProv);
		const prov = mappedProv !== 'malaga' ? { key: mappedProv, label: canonicalProvinceLabel(mappedProv) } : extractProvince(String((p as any)?.id || ''));
		return {
			...p,
			title: stripSuffix(String(p.title || '')),
			_label: stripGuideSuffix(String(p.title || '')),
			_provinceKey: prov.key,
			_provinceLabel: prov.label,
		};
	})
	.sort((a, b) => String((a as any)._label || a.title || '').localeCompare(String((b as any)._label || b.title || '')));

const itemsByCanonicalPath = (() => {
	const map = new Map<string, (typeof items)[number]>();
	for (const p of items) map.set(canonicalGuideHref(p), p);
	return map;
})();

const topPathsRaw = await getWeeklyTopPaths({ prefix: '/neighbourhood/', limit: 12 }).catch(() => [] as string[]);
const topItems = (() => {
	const norm = (p: string) => {
		const s = String(p || '').trim();
		if (!s) return '';
		if (!s.startsWith('/')) return '';
		return s.endsWith('/') ? s : `${s}/`;
	};
	const candidates = topPathsRaw
		.map((p) => canonicalizeNeighbourhoodPath(norm(p)) || '')
		.filter(Boolean)
		.filter((p) => p !== '/neighbourhood/' && p !== '/neighbourhood/andalucia/')
		.map((p) => itemsByCanonicalPath.get(p))
		.filter(Boolean) as Array<(typeof items)[number]>;

	const uniq: Array<(typeof items)[number]> = [];
	const seen = new Set<string>();
	for (const p of candidates) {
		const id = String((p as any)?.id || p.path || '');
		if (!id || seen.has(id)) continue;
		seen.add(id);
		uniq.push(p);
		if (uniq.length >= 5) break;
	}

	if (uniq.length >= 5) return uniq;
	const fallbackSlugs = ['marbella', 'puerto-banus', 'nueva-andalucia', 'benalmadena', 'estepona'];
	for (const s of fallbackSlugs) {
		if (uniq.length >= 5) break;
		const hit =
			items.find((p) => slugFromNeighbourhoodPath(p) === s) ||
			items.find((p) => String((p as any)._label || '').toLowerCase() === s.replaceAll('-', ' ')) ||
			null;
		if (!hit) continue;
		const id = String((hit as any)?.id || hit.path || '');
		if (!id || seen.has(id)) continue;
		seen.add(id);
		uniq.push(hit);
	}
	return uniq.slice(0, 5);
})();

const groups = (() => {
	const map = new Map<string, typeof items>();
	for (const p of items) {
		const label = String((p as any)._label || p.title || '').trim();
		const first = label ? label[0]!.toUpperCase() : '#';
		const key = /[A-Z]/.test(first) ? first : '#';
		const arr = map.get(key) || [];
		arr.push(p);
		map.set(key, arr);
	}
	return [...map.entries()].sort((a, b) => a[0].localeCompare(b[0]));
})();

const provinces = (() => {
	const map = new Map<string, string>();
	for (const p of items) {
		const k = String((p as any)._provinceKey || '').trim();
		if (!k) continue;
		const label = String((p as any)._provinceLabel || '').trim() || canonicalProvinceLabel(k);
		if (!map.has(k)) map.set(k, label);
	}
	return [...map.entries()]
		.map(([key, label]) => ({ key, label }))
		.sort((a, b) => a.label.localeCompare(b.label));
})();
---

<Layout
	lang="en"
	title="Neighbourhood Guides • PropertyList Info Hub"
	description="Neighbourhood guides that help buyers and renters compare lifestyle, commute, schools, and rental strategy."
	canonical="https://info.propertylist.es/neighbourhood/"
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/neighbourhood/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/barrios/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/neighbourhood/' },
	]}
>
	<section class="hero" aria-label="Neighbourhood guides">
		<div class="heroInner">
			<div class="badge">Area Guides</div>
			<h1>Neighbourhood Guides</h1>
			<p class="lead">Compare lifestyle fit, commute, amenities, and rental potential across key areas.</p>
			<div class="filterRow">
				<label class="filterLabel" for="nb-filter">Filter</label>
				<input id="nb-filter" class="filterInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search areas…" data-nb-filter />
				<div class="count" aria-live="polite" data-nb-count />
			</div>
			<div class="filterRow provinceRow">
				<label class="filterLabel" for="nb-province">Province</label>
				<select id="nb-province" class="filterSelect" data-nb-province>
					<option value="">All provinces</option>
					{provinces.map((p) => (
						<option value={p.key}>{p.label}</option>
					))}
				</select>
			</div>
			<div class="ctaRow" aria-label="Next steps">
				<a class="cta" href="/docs/laws-procedures/buying-a-property/">Buying checklist</a>
				<a class="cta secondary" href="/docs/laws-procedures/renting-a-property/">Renting checklist</a>
			</div>
		</div>
	</section>

	{items.length ? (
		<>
			{topItems.length ? (
				<section class="top5" aria-label="Top searched neighbourhoods">
					<h2 class="topTitle">Top searched neighbourhoods</h2>
					<p class="topLead">Popular right now based on recent guide views.</p>
					<div class="topGrid">
						{topItems.map((p) => {
							const title = String((p as any)._label || p.title || '').trim();
							return (
								<article class="topCard">
									<h3 class="topCardTitle">{title}</h3>
									<div class="topSummary">{topSummaryFor(p)}</div>
									<div class="topMeta">
										<div class="topMetaLabel">Est. price range</div>
										<div class="topMetaValue">{priceRangeFor(p)}</div>
									</div>
									<a class="topCta" href={canonicalGuideHref(p)}>
										View Details
									</a>
								</article>
							);
						})}
					</div>
				</section>
			) : null}

			<nav class="jump" aria-label="Jump to letter">
				<div class="jumpInner">
					{groups.map(([letter]) => (
						<a class="jumpLink" href={`#letter-${letter}`} data-letter={letter}>
							{letter}
						</a>
					))}
				</div>
			</nav>

			<section class="sections" aria-label="Neighbourhood list">
				{groups.map(([letter, pages]) => (
					<section class="section" id={`letter-${letter}`} data-section={letter}>
						<h2 class="sectionTitle">{letter}</h2>
						<div class="grid">
							{pages.map((p) => (
								<a
									class="card"
									href={canonicalGuideHref(p)}
									data-label={String((p as any)._label || p.title || '').toLowerCase()}
									data-province={String((p as any)._provinceKey || '')}
								>
									{areaImagePath(slugFromNeighbourhoodPath(p)) ? (
										<img class="cardImg" src={areaImagePath(slugFromNeighbourhoodPath(p))} alt="" loading="lazy" decoding="async" width="400" height="150" />
									) : null}
									<div class="cardTitle">{String((p as any)._label || p.title || '')}</div>
									{cardDescFor(p) ? <div class="cardDesc">{cardDescFor(p)}</div> : null}
								</a>
							))}
						</div>
					</section>
				))}
			</section>

			<section class="compare" aria-label="Buyer and renter comparison">
				<h2>Buyer vs renter: what to prioritise</h2>
				<div class="tableWrap" role="region" aria-label="Comparison table" tabindex="0">
					<table class="table">
						<thead>
							<tr>
								<th scope="col">Buyers</th>
								<th scope="col">Renters</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Resale demand, liquidity, and future rentability</td>
								<td>Commute, noise, and convenience day to day</td>
							</tr>
							<tr>
								<td>Community rules, fees, and long-term building condition</td>
								<td>Seasonality, winter sun, and walkability</td>
							</tr>
							<tr>
								<td>School access, parking, and “second home” logistics</td>
								<td>Internet, furnished quality, and landlord responsiveness</td>
							</tr>
							<tr>
								<td>Rental licence feasibility (if you plan to let)</td>
								<td>Contract terms, deposit, and utilities clarity</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>
		</>
	) : (
		<div class="empty">No neighbourhood guides yet.</div>
	)}
</Layout>

<script is:inline>
	(() => {
		const init = () => {
			const input = document.querySelector('[data-nb-filter]');
			const province = document.querySelector('[data-nb-province]');
			const count = document.querySelector('[data-nb-count]');
			if (!(input instanceof HTMLInputElement)) return;

			const norm = (s) =>
				String(s || '')
					.toLowerCase()
					.normalize('NFKD')
					.replace(/[\u0300-\u036f]/g, '')
					.replace(/\s+/g, ' ')
					.trim();

			const cards = Array.from(document.querySelectorAll('.card[data-label]'))
				.map((el) => {
					if (!(el instanceof HTMLElement)) return null;
					const label = norm(el.getAttribute('data-label') || '');
					const prov = String(el.getAttribute('data-province') || '').trim();
					return { el, label, prov };
				})
				.filter(Boolean);
			const topSection = document.querySelector('.top5');
			const sections = Array.from(document.querySelectorAll('[data-section]'));
			const jumpLinks = Array.from(document.querySelectorAll('.jumpLink[data-letter]'));

			const apply = () => {
				const q = norm(input.value || '');
				const tokens = q ? q.split(' ').filter(Boolean) : [];
				const prov = province instanceof HTMLSelectElement ? String(province.value || '').trim() : '';
				const isSearching = tokens.length > 0;
				let visible = 0;

				if (topSection instanceof HTMLElement) topSection.style.display = isSearching || prov ? 'none' : '';

				for (const c of cards) {
					const matchesQ = !tokens.length || tokens.every((t) => c.label.includes(t));
					const matchesProv = !prov || c.prov === prov;
					const show = matchesQ && matchesProv;
					c.el.style.display = show ? '' : 'none';
					if (show) visible += 1;
				}

				for (const sec of sections) {
					const anyVisible = Array.from(sec.querySelectorAll('.card[data-label]')).some((c) => c.style.display !== 'none');
					sec.style.display = anyVisible ? '' : 'none';
				}

				if (count) count.textContent = visible ? `${visible} guide${visible === 1 ? '' : 's'}` : 'No matches';

				for (const a of jumpLinks) {
					const letter = String(a.getAttribute('data-letter') || '').trim();
					const sec = letter ? document.getElementById(`letter-${letter}`) : null;
					const show = sec ? sec.style.display !== 'none' : true;
					a.style.display = show ? '' : 'none';
				}
			};

			input.addEventListener('input', apply, { passive: true });
			if (province) province.addEventListener('change', apply, { passive: true });
			apply();
		};

		if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
		else init();
	})();
</script>

