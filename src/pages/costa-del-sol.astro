		kicker: 'Afternoon · km 34',
		blurb: 'A white village pinned to the mountainside, with the whole coast laid out below it, and a municipality that runs from those streets down to the sea.',
		listings: 548,
		median: '599,950',
		asking: '3,892',
		verified: '2,922',
		sky: ['#4a90c9', '#9ccbe4', '#f6f1e2'],
		sun: { x: 62, y: 28, size: 90, glow: '#ffeec2' },
		sea: ['#337fae', '#57a3c4'],
