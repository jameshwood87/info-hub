		kicker: 'Midday · km 30',
		blurb: 'The coast at its most everyday, in the best sense: a seven-kilometre paseo, a train to the airport, and neighbours who actually live here all year.',
		listings: 192,
		median: '499,000',
		asking: '4,759',
		verified: '3,782',
		sky: ['#3d86c6', '#8fc4e6', '#eef6fb'],
		sun: { x: 50, y: 22, size: 84, glow: '#fff4d0' },
		sea: ['#2f7fb4', '#4d9cc4'],
		ridge: '#2b5c85',
		text: 'light',
	},
	{
		slug: 'mijas',
