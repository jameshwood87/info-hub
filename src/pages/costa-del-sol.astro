		text: 'light',
	},
	{
		slug: 'marbella',
		name: 'Marbella',
		guide: '/neighbourhood/spain/malaga/marbella/',
		kicker: 'Golden hour · km 45',
		blurb: 'The name that sells the coast. La Concha behind it, the Golden Mile in front, and more homes changing hands than anywhere else on this list.',
		listings: 1570,
		median: '1,450,000',
		asking: '6,270',
		verified: '4,582',
