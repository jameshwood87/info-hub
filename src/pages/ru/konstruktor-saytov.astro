   Hand edits are lost on the next run; change the English page instead. */
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'ru');
const plAgencies = statPlus(__ps.agencies, 'ru');
const plListings = statPlus(__ps.listings, 'ru');

const title = 'Website Builder для агентств недвижимости | PropertyList.es';
const description =
	'Пятнадцать готовых дизайнов сайтов для агентств, показывающих всю сеть PropertyList, отфильтрованную так, как вы хотите. Запросы поступают в вашу CRM. Сборка бесплатна, от 50 кредитов в месяц после публикации.';
const BUILD = 'https://agents.propertylist.es/website-builder';
const DOCS = 'https://info.propertylist.es/docs/propertylist-mls-user-manual/website-builder/';
const REFERRALS = 'https://agents.propertylist.es/referrals';
const DASHBOARD = 'https://agents.propertylist.es';

// The fifteen templates, as captured from the real files (public/wb). Order is
// the order shown; the style filter hides the rest.
const templates = [
	{ id: '14-solaz', name: 'Solaz', style: 'Витрина', line: 'Начинается с кинематографического кадра. Кипарисы и береговая линия в сумерках, заголовок расположен низко на изображении.' },
	{ id: '01-marina', name: 'Marina', style: 'Современный', line: 'Бирюзово-белая шапка, сверху поле поиска в реальном времени, а ниже ваши последние объявления в сетке.' },
	{ id: '03-onyx', name: 'Onyx', style: 'Роскошный', line: 'Ночная фотография освещённой виллы, заголовок с засечками белого цвета, одна кнопка.' },
	{ id: '13-horizon', name: 'Horizon', style: 'Витрина', line: 'Разделённый экран: с одной стороны жирный заголовок, с другой интерьерная фотография во всю высоту.' },
	{ id: '02-blanca', name: 'Blanca', style: 'Минималистичный', line: 'Одна фотография во всю ширину виллы и бассейна, небольшая панель навигации, заголовка поверх изображения нет.' },
	{ id: '05-puerto', name: 'Puerto', style: 'Современный', line: 'Фотография сумерек во всю ширину с плавающей карточкой поверх, показывающей цену и детали.' },
	{ id: '07-noir', name: 'Noir', style: 'Роскошный', line: 'Открывается видеороликом. Кинематический тёмный пейзаж с крупным жирным заголовком поверх него, минимальная навигация.' },
	{ id: '04-sierra', name: 'Sierra', style: 'Классический', line: 'Кремовый фон, место для вашей фотографии рядом с именем и редакционный абзац.' },
	{ id: '09-continental', name: 'Continental', style: 'Современный', line: 'Фотография сумерек в тёмно-синей палитре, крупный белый заголовок и карточка с ценой поверх изображения.' },
	{ id: '06-atrium', name: 'Atrium', style: 'Минималистичный', line: 'Светло-серый и белый, один акцентный цвет в заголовке, строка поиска и полоса с последними объектами.' },
	{ id: '11-imperial', name: 'Imperial', style: 'Роскошный', line: 'Кремовый фон, крупный заголовок с засечками, два фото ниже в простой галерее.' },
	{ id: '08-cortijo', name: 'Cortijo', style: 'Классический', line: 'Тёплый фон цвета пергамента, арочная рамка рядом с вашим именем и вступительный текст.' },
	{ id: '10-meridian', name: 'Meridian', style: 'Минималистичный', line: 'Бледный фон, курсивный заголовок с засечками, простая строка поиска, ничего, что отвлекало бы внимание.' },
	{ id: '12-heritage', name: 'Heritage', style: 'Классический', line: 'Белый фон, ваше имя и вступительный абзац, зелёные кнопки призыва к действию.' },
	{ id: '15-faro', name: 'Faro', style: 'Витрина', line: 'Открывается видеороликом. Силуэт тёмной горы и моря, крупный заголовок с засечками, минимальная навигация.' },
];
const styles = ['Современный', 'Минималистичный', 'Роскошный', 'Классический', 'Витрина'];

const addons = [
	{ name: 'Дополнительная страница', what: 'Ещё одна страница сверх включённого набора', price: '10 кредитов в месяц' },
	{ name: 'Instant Content', what: 'Гиды по районам и блог, написанные для вас, без ограничений', price: '30 кредитов в месяц' },
	{ name: 'Ваш собственный домен', what: 'Ваш домен вместо your-agency.estate-agency.co', price: '20 кредитов в месяц' },
	{ name: 'Убрать брендинг PropertyList', what: 'Убирает отметку PropertyList с вашего сайта', price: '50 кредитов в месяц' },
	{ name: 'Всплывающая форма для сбора лидов', what: 'Всплывающее окно, которое собирает лиды на вашем сайте', price: '8 кредитов в месяц' },
	{ name: 'Ответы ИИ в объявлениях', what: 'Формирует FAQ из реальных вопросов покупателей', price: '8 кредитов в месяц' },
	{ name: 'Авто SEO и GEO', what: 'Проверяет ваш сайт еженедельно и исправляет то, что может', price: '5 кредитов в месяц' },
	{ name: 'Ежемесячный отчёт по электронной почте', what: 'Сводка по результатам отправляется по электронной почте 1-го числа месяца', price: '5 кредитов в месяц' },
];

const faqs = [
	{ q: 'Действительно ли создание сайта бесплатно?', a: 'Да. Создание и предварительный просмотр бесплатны. Плата взимается только при публикации: 50 кредитов в месяц, плюс любые дополнительные опции, которые вы включите' },
	{ q: 'Что происходит, когда вы публикуете?', a: 'Ваш сайт публикуется с вашими объявлениями и любыми объявлениями из сети, которые вы выбрали для отображения. С этого момента вы платите 50 кредитов в месяц, плюс любые дополнительные опции, которые вы включили' },
	{ q: 'Можете ли вы сменить шаблон позже?', a: 'Да. Вы можете переключиться на любой из пятнадцати в любое время и сохранить свои тексты, страницы и настройки.' },
	{ q: 'Нужно ли вам загружать свои объявления?', a: 'Нет. Ваши объявления и общий сток сети уже добавлены и обновляются, когда объявление меняется в CRM. Ничего не приходится вводить дважды.' },
	{ q: 'Куда поступают обращения?', a: 'В ваш PropertyList CRM, и по каждому отправляется письмо на электронную почту. Воронки Lead, Seller и Property бесплатны и без ограничений; перевод одного в Buyer стоит 1 кредит.' },
	{ q: 'Можете ли вы использовать собственный домен?', a: 'Да, за 20 кредитов в месяц. До этого ваш сайт работает по адресу your-agency-name.estate-agency.co, так что в адресе будет ваше имя, а не наше.' },
	{ q: 'Что произойдет, если вы отмените?', a: 'Ваш сайт возвращается к бесплатному микросайту агентства в конце платёжного периода. Вы сохраняете свой домен.' },
	{ q: 'Насколько хороша SEO?', a: 'Чистая структура, заголовки и описания на каждой странице с первого дня. Auto SEO и GEO (5 кредитов в месяц) еженедельно проверяют ваш сайт и обновляют ключевые слова в соответствии с тем, что сейчас ищут покупатели. Ни одна платформа не может честно обещать позиции в выдаче.' },
	{ q: 'Нужно ли вам быть технически подкованным?', a: 'Нет. Выберите шаблон, редактируйте его в редакторе, который показывает реальный сайт, публикуйте, когда будете готовы. Или опишите изменение простыми словами на английском, и ИИ сделает это.' },
	{ q: 'Кто предоставляет хостинг, и безопасно ли это?', a: 'Мы. Хостинг и защита Cloudflare включены: быстро, защищено от атак, и вам не нужно ничего настраивать или продлевать.' },
	{ q: 'Юридические страницы включены?', a: 'Да. Aviso legal, страницы конфиденциальности и cookies, а также баннер cookie входят в каждый шаблон и никогда не оплачиваются отдельно.' },
];

const ldWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'PropertyList Website Builder',
	url: 'https://info.propertylist.es/ru/konstruktor-saytov/',
	description,
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es', logo: { '@type': 'ImageObject', url: 'https://info.propertylist.es/og/logo-default.png' } },
};
const ldBreadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://info.propertylist.es/' },
		{ '@type': 'ListItem', position: 2, name: 'Website Builder' },
	],
};
const ldVideo = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: 'PropertyList Website Builder: pick a design, edit it, publish',
	description: 'A 33 second recording of the PropertyList Website Builder with a sample agency: the fifteen designs, one chosen, the headline selected, the hero rearranged, then Review and publish. No sound.',
	thumbnailUrl: ['https://info.propertylist.es/hero/wb-hero-poster.jpg'],
	contentUrl: 'https://info.propertylist.es/hero/wb-hero.mp4',
	uploadDate: '2026-09-05',
	duration: 'PT33S',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es' },
};
const ldFaq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
	lang="ru"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/ru/konstruktor-saytov/"
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/website-builder/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/constructor-de-webs/' },
		{ hreflang: 'de', href: 'https://info.propertylist.es/de/website-baukasten/' },
		{ hreflang: 'fr', href: 'https://info.propertylist.es/fr/createur-de-site-immobilier/' },
		{ hreflang: 'sv', href: 'https://info.propertylist.es/sv/webbplatsbyggare/' },
		{ hreflang: 'ru', href: 'https://info.propertylist.es/ru/konstruktor-saytov/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/website-builder/' },
	]}
>
	<script type="application/ld+json" set:html={JSON.stringify(ldWebsite)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldVideo)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />

	<!-- HERO -->
	<header class="wb-hero">
		<div class="wrap">
			<div class="wb-hero-grid">
				<div class="wb-hero-text">
					<div class="wb-hero-eyebrow"><img src="https://info.propertylist.es/og/icon-default.png" alt="" width="18" height="18" /><span>Website Builder &middot; все листинги сети &middot; попадают в ваш CRM</span></div>
					<h1 class="wb-hero-h1">Выберите дизайн.<br />Ваши объявления <em>заполните его.</em></h1>
					<p class="wb-hero-sub">Пятнадцать готовых сайтов агентств, заполненных всей сетью и отфильтрованных так, как вы хотите. Запросы поступают в ваш CRM.</p>
					<div class="wb-hero-ctas">
						<a class="btn btn-primary btn-large" href={BUILD}>Создать бесплатно</a>
						<a class="btn btn-secondary on-dark" href="#xml">У вас уже есть сайт</a>
					</div>
					<p class="wb-hero-trust">Создание и предварительный просмотр бесплатны. От 50 кредитов в месяц (примерно 50 EUR) после публикации. Отменить можно в конце любого месяца.</p>
				</div>
				<div class="wb-hero-visual">
					<figure class="film wb-film">
						<div class="wb-frame wb-frame-dark">
							<div class="wb-frame-bar"><span></span><span></span><span></span><i>Website Builder</i></div>
							<video class="filmVid" autoplay muted loop playsinline preload="auto" poster="/hero/wb-hero-poster.jpg" width="1440" height="900" aria-label="Website Builder: пятнадцать шаблонов, выбран шаблон Solaz, редактор с готовым заголовком, главный блок переставлен, затем просмотр и публикация">
								<source src="/hero/wb-hero.mp4" type="video/mp4" />
							</video>
						</div>
						
					</figure>
				</div>
			</div>
		</div>
	</header>

	<!-- PROOF -->
	<section class="wb-trust">
		<div class="wrap">
			<div class="wb-trust-grid">
				<div><div class="wb-trust-num">{plAgents}</div><div class="wb-trust-label">зарегистрированные агенты на PropertyList</div></div>
				<div><div class="wb-trust-num">{plAgencies}</div><div class="wb-trust-label">агентства, ведущие свой бизнес на ней</div></div>
				<div><div class="wb-trust-num">{plListings}</div><div class="wb-trust-label">объявления в сети</div></div>
			</div>
			<p class="wb-trust-line">Ваш сайт использует ту же сеть, что и ваш MLS и CRM. Данные актуальны на день публикации и затем обновляются автоматически.</p>
		</div>
	</section>

	<!-- THE FIFTEEN -->
	<section class="wb-section wb-fifteen" id="templates">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Пятнадцать</p>
				<h2 class="wb-section-h2">Пятнадцать дизайнов, <em>одна платформа.</em></h2>
				<p class="wb-lead">Каждый является полноценным сайтом агентства: те же страницы, те же блоки, другой внешний вид. Выберите тот, который соответствует тому, как вы уже работаете.</p>
			</div>
			<div class="wb-chips" role="tablist" aria-label="Отфильтровать шаблоны по стилю">
				<button class="wb-chip on" type="button" data-style="all" aria-pressed="true">Все пятнадцать</button>
				{styles.map((s) => <button class="wb-chip" type="button" data-style={s} aria-pressed="false">{s}</button>)}
			</div>
		</div>
		<div class="wb-rail-wrap">
			<button class="wb-rail-btn prev" type="button" aria-label="Предыдущие шаблоны">&lsaquo;</button>
			<div class="wb-rail" id="wbRail">
				{templates.map((t, i) => (
					<article class="wb-tpl" data-style={t.style}>
						<div class="wb-tpl-shots">
							<div class="wb-frame">
								<div class="wb-frame-bar"><span></span><span></span><span></span><i>yourbrand.estate-agency.co</i></div>
								<img src={`/wb/${t.id}-desktop.webp`} width="1440" height="900" alt={`${t.name} template, home page on a desktop screen`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							</div>
							<img class="wb-phone" src={`/wb/${t.id}-phone.webp`} width="390" height="844" alt={`${t.name} template on a phone`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
						</div>
						<div class="wb-tpl-meta">
							<span class="wb-tpl-style">{t.style}</span>
							<h3>{t.name}</h3>
							<p>{t.line}</p>
						</div>
					</article>
				))}
			</div>
			<button class="wb-rail-btn next" type="button" aria-label="Следующие шаблоны">&rsaquo;</button>
		</div>
		<div class="wrap"><p class="wb-fifteen-note">Поменяйте шаблон позже и сохраните ваши тексты, страницы и настройки. Solaz, Noir и Faro открываются в виде фильма.</p></div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="wb-section wb-steps">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Как это работает</p>
				<h2 class="wb-section-h2">Выберите. Сделайте его своим. <em>Опубликуйте.</em></h2>
			</div>
			<div class="wb-steps-grid">
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Выберите шаблон</i></div><img src="/wb/step-1-pick.webp" width="1440" height="900" alt="Выбор шаблона с выбранным Solaz и предпросмотром рядом" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">1</div>
					<h3>Выберите шаблон</h3>
					<p>Выберите из пятнадцати готовых дизайнов сайтов для агентств. Каждый уже содержит страницы, которые нужны агентству.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Редактируйте ваш сайт</i></div><img src="/wb/step-2-edit.webp" width="1440" height="900" alt="Редактор с открытыми настройками hero-блока, показывающий три варианта расположения" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">2</div>
					<h3>Сделайте сайт своим</h3>
					<p>Ваш фирменный цвет, ваши тексты, ваши фотографии в редакторе, который показывает реальный сайт. У каждого блока несколько вариантов расположения.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Просмотреть и опубликовать</i></div><img src="/wb/step-3-publish.webp" width="1440" height="900" alt="Диалог 'Просмотреть и опубликовать', в котором указано количество ежемесячных кредитов перед публикацией сайта." loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">3</div>
					<h3>Опубликовать</h3>
					<p>Загружать нечего: объявления уже там. Запросы начинают поступать в вашу CRM.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- BUILT FOR AN AGENCY -->
	<section class="wb-section wb-agency">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Создано для агентства, а не для кафе</p>
				<h2 class="wb-section-h2">Блоки, которые агенту по недвижимости <em>действительно нужны.</em></h2>
				<p class="wb-lead">Сетка объектов, выделенное объявление, поиск, форма оценки, справочники по районам, команда, отзывы, показатели, стоимость покупки, новые застройки. Каждый элемент берёт данные из вашей учётной записи вместо того, чтобы просить вас вводить их вручную.</p>
			</div>
			<div class="wb-cards">
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9 21v-6h6v6" /></svg><strong>Каждое объявление в сети готово к показу.</strong><p>Ваши объявления активны в день публикации. Пул объявлений сети тоже доступен: отфильтруйте его и показывайте то, что подходит вашим покупателям.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h7M18 15l3 3-3 3" /></svg><strong>Лиды попадают в ваш CRM.</strong><p>Каждый запрос приходит как лид. Воронки Lead, Seller и Property бесплатны и без ограничений; перевод квалифицированного лида в Buyer стоит 1 кредит.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg><strong>Поиск, который работает как портал.</strong><p>Покупатели отфильтровывают пул по району, типу и цене на странице Properties и могут сохранить поиск.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10l8-6 8 6v10M9 20v-5h6v5" /><path d="M2 20h20" /></svg><strong>Бесплатная форма оценки, которая делает больше.</strong><p>Каждый запрос приходит как лид с уже заполненным Property Intelligence Report; он будет вашим за 5 кредитов, если вы захотите.</p></article>
