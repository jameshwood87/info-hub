---
/* GENERATED FILE - do not edit by hand.
   Source: src/pages/website-builder.astro (English).
   Rebuild: node scripts/gen-wb-langs.mjs --only=ru
   Hand edits are lost on the next run; change the English page instead. */
import Layout from '../../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'ru');
const plAgencies = statPlus(__ps.agencies, 'ru');
const plListings = statPlus(__ps.listings, 'ru');

const title = 'Конструктор сайтов для агентств недвижимости | PropertyList.es';
const description =
	'Выберите один из пятнадцати готовых дизайнов сайта агентства, сделайте его своим, и в нём будут все объекты из сети PropertyList, отфильтрованные так, как вам нужно, а запросы будут поступать в ваш CRM. Сборка и предварительный просмотр бесплатны. После публикации - от 50 кредитов в месяц.';
const BUILD = 'https://agents.propertylist.es/website-builder';
const DOCS = 'https://info.propertylist.es/docs/propertylist-mls-user-manual/website-builder/';
const REFERRALS = 'https://agents.propertylist.es/referrals';
const DASHBOARD = 'https://agents.propertylist.es';

// The fifteen templates, as captured from the real files (public/wb). Order is
// the order shown; the style filter hides the rest.
const templates = [
	{ id: '14-solaz', name: 'Solaz', style: 'Витрина', line: 'Открывается видеороликом. Кипарисы и побережье в сумерках, заголовок расположен низко над изображением.' },
	{ id: '01-marina', name: 'Marina', style: 'Современный', line: 'Бирюзово-белая шапка, вверху поле живого поиска и ниже ваши последние объявления в сетке.' },
	{ id: '03-onyx', name: 'Onyx', style: 'Роскошный', line: 'Ночное фото освещённой виллы, заголовок с засечками белого цвета, одна кнопка.' },
	{ id: '13-horizon', name: 'Horizon', style: 'Витрина', line: 'Разделённый экран: с одной стороны - жирный заголовок, с другой - интерьерная фотография на всю высоту.' },
	{ id: '02-blanca', name: 'Blanca', style: 'Минималистичный', line: 'Одна фотография во всю ширину виллы и бассейна, небольшая навигационная панель, без заголовка поверх изображения.' },
	{ id: '05-puerto', name: 'Puerto', style: 'Современный', line: 'Фотография сумерек во всю ширину с плавающей карточкой поверх неё, показывающей цену и подробности.' },
	{ id: '07-noir', name: 'Noir', style: 'Роскошный', line: 'Открывается эффектом плёнки. Тёмный кинематографичный пейзаж с крупным жирным заголовком поверх, минимальная навигация.' },
	{ id: '04-sierra', name: 'Sierra', style: 'Классический', line: 'Кремовый фон, место для вашей фотографии рядом с именем и редакционный абзац.' },
	{ id: '09-continental', name: 'Continental', style: 'Современный', line: 'Фотография сумерек в тёмно-синем тоне, крупный белый заголовок и карточка с ценой поверх изображения.' },
	{ id: '06-atrium', name: 'Atrium', style: 'Минималистичный', line: 'Светло-серый и белый, один акцентный цвет в заголовке, поле поиска и полоса с последними объектами.' },
	{ id: '11-imperial', name: 'Imperial', style: 'Роскошный', line: 'Кремовый фон, крупный заголовок с засечками, две фотографии под ним в простой галерее.' },
	{ id: '08-cortijo', name: 'Cortijo', style: 'Классический', line: 'Тёплый пергаментный фон, арочная рамка для изображения рядом с вашим именем и вводный текст.' },
	{ id: '10-meridian', name: 'Meridian', style: 'Минималистичный', line: 'Бледный фон, курсивный заголовок с засечками, простое поле поиска, ничего, что отвлекало бы внимание.' },
	{ id: '12-heritage', name: 'Heritage', style: 'Классический', line: 'Белый фон, ваше имя и вводный абзац, зелёные кнопки призыва к действию.' },
	{ id: '15-faro', name: 'Faro', style: 'Витрина', line: 'Открывается эффектом плёнки. Силуэт гор и моря на тёмном фоне, крупный заголовок с засечками, минимальная навигация.' },
];
const styles = ['Современный', 'Минималистичный', 'Роскошный', 'Классический', 'Витрина'];

const addons = [
	{ name: 'Дополнительная страница', what: 'Ещё одна страница сверх включённого набора', price: '10 кредитов в месяц' },
	{ name: 'Instant Content', what: 'Гиды по районам и блог, написанные для вас, без ограничений', price: '30 кредитов в месяц' },
	{ name: 'Ваш собственный домен', what: 'Ваш домен вместо your-agency.estate-agency.co', price: '20 кредитов в месяц' },
	{ name: 'Удалить брендинг PropertyList', what: 'Удаляет отметку PropertyList с вашего сайта', price: '50 кредитов в месяц' },
	{ name: 'Всплывающее окно для сбора лидов', what: 'Всплывающее окно, которое собирает лиды на вашем сайте', price: '8 кредитов в месяц' },
	{ name: 'Ответы ИИ в объявлениях', what: 'Формирует раздел FAQ на основе реальных вопросов покупателей', price: '8 кредитов в месяц' },
	{ name: 'Автоматическое SEO и GEO', what: 'Проверяет ваш сайт еженедельно и исправляет то, что может', price: '5 кредитов в месяц' },
	{ name: 'Ежемесячный отчет по электронной почте', what: 'Сводка по результатам работы отправляется по электронной почте 1-го числа месяца', price: '5 кредитов в месяц' },
];

const faqs = [
	{ q: 'Действительно ли бесплатно создать сайт?', a: 'Да. Создание и предварительный просмотр вашего сайта ничего не стоят. С вас начнут взимать плату только после публикации: 50 кредитов в месяц с этого момента, плюс любые дополнения, которые вы подключите.' },
	{ q: 'Что происходит, когда вы публикуете сайт?', a: 'Ваш сайт становится доступен сразу со всеми объектами в сети, которые вы выбрали для показа, а также с вашими собственными объявлениями. С этого момента с вас взимается 50 кредитов в месяц за сайт, плюс любые дополнения, которые вы включили; все списания происходят ежемесячно.' },
	{ q: 'Можете ли вы сменить шаблон позже?', a: 'Да. Вы можете переключиться на любой из пятнадцати дизайнов в любой момент, при этом сохраняются ваши тексты, страницы и настройки.' },
	{ q: 'Нужно ли вам загружать ваши объявления?', a: 'Нет. Каждое объявление в сети уже присутствует, отфильтровано так, как вам нужно, рядом показаны ваши объявления, и всё обновляется, когда объявление меняется в CRM. Ничего не приходится вводить дважды.' },
	{ q: 'Куда поступают запросы?', a: 'Они попадают прямо в ваш PropertyList CRM, и вы получаете письмо по каждому запросу. Воронки Lead, Seller и Property бесплатны и без ограничений. Перевод квалифицированного лида в воронку Buyer стоит 1 кредит.' },
	{ q: 'Можете ли вы использовать собственный домен?', a: 'Да, за 20 кредитов в месяц. До этого ваш сайт работает по адресу your-agency-name.estate-agency.co: ваше имя в адресе, не наше.' },
	{ q: 'Что произойдёт, если вы отмените?', a: 'Ваш сайт возвращается к бесплатному микросайту агентства в конце платёжного периода. Вы сохраняете свой домен.' },
	{ q: 'Насколько хороша SEO?', a: 'Хорошо с первого дня: каждая страница сразу имеет чистую структуру, заголовки и описания. Включите Auto SEO и GEO (5 кредитов в месяц), и назначенный вашему сайту агент будет заниматься им каждую неделю: он проверяет каждую страницу, обновляет ключевые слова в соответствии с тем, что сейчас ищут покупатели, и исправляет найденные проблемы. Мы по-прежнему не обещаем места в выдаче; ни одна честная платформа этого не может.' },
	{ q: 'Нужно ли вам обладать техническими навыками?', a: 'Нет. вы выбираете шаблон, редактируете его в редакторе, который показывает ваш реальный сайт по мере работы, и публикуете, когда будете готовы. Редактирование с помощью ИИ также позволяет описать изменение простыми словами.' },
	{ q: 'Кто размещает сайт и безопасно ли это?', a: 'Мы. Хостинг и защита Cloudflare включены: ваш сайт быстро обслуживается сетью Cloudflare и защищён от атак, вам не нужно ничего настраивать или продлевать.' },
	{ q: 'Включены ли юридические страницы?', a: 'Да. aviso legal, страницы конфиденциальности и cookie, а также баннер cookie поставляются с каждым шаблоном. Они включены и никогда не выставляются отдельно.' },
];

const ldWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'PropertyList Website Builder',
	url: 'https://info.propertylist.es/ru/konstruktor-saytov/',
	description,
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es', logo: { '@type': 'ImageObject', url: 'https://info.propertylist.es/og/logo-default.png' } },
};
const ldBreadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://info.propertylist.es/' },
		{ '@type': 'ListItem', position: 2, name: 'Website Builder' },
	],
};
const ldVideo = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: 'PropertyList Website Builder: pick a design, edit it, publish',
	description: 'A 33 second recording of the PropertyList Website Builder with a sample agency: the fifteen designs, one chosen, the headline selected, the hero rearranged, then Review and publish. No sound.',
	thumbnailUrl: ['https://info.propertylist.es/hero/wb-hero-poster.jpg'],
	contentUrl: 'https://info.propertylist.es/hero/wb-hero.mp4',
	uploadDate: '2026-09-05',
	duration: 'PT33S',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es' },
};
const ldFaq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
	lang="ru"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/ru/konstruktor-saytov/"
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/website-builder/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/constructor-de-webs/' },
		{ hreflang: 'de', href: 'https://info.propertylist.es/de/website-baukasten/' },
		{ hreflang: 'fr', href: 'https://info.propertylist.es/fr/createur-de-site-immobilier/' },
		{ hreflang: 'sv', href: 'https://info.propertylist.es/sv/webbplatsbyggare/' },
		{ hreflang: 'ru', href: 'https://info.propertylist.es/ru/konstruktor-saytov/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/website-builder/' },
	]}
>
	<script type="application/ld+json" set:html={JSON.stringify(ldWebsite)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldVideo)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />

	<!-- HERO -->
	<header class="wb-hero">
		<div class="wrap">
			<div class="wb-hero-grid">
				<div class="wb-hero-text">
					<div class="wb-hero-eyebrow"><img src="https://info.propertylist.es/og/icon-default.png" alt="" width="18" height="18" /><span>Website Builder &middot; все объявления сети &middot; лиды попадают в вашу CRM</span></div>
					<h1 class="wb-hero-h1">Выберите дизайн.<br />Ваши объявления <em>заполните его.</em></h1>
					<p class="wb-hero-sub">Пятнадцать готовых сайтов агентства, заполненных всеми объектами сети и отфильтрованных так, как вы хотите. Запросы попадают в вашу CRM и в ваши воронки, а ваши собственные объявления появляются на сайте в день публикации.</p>
					<div class="wb-hero-ctas">
						<a class="btn btn-primary btn-large" href={BUILD}>Создайте бесплатно</a>
						<a class="btn btn-secondary on-dark" href="#xml">У меня уже есть сайт</a>
					</div>
					<p class="wb-hero-trust">Бесплатно для создания и предварительного просмотра. От 50 кредитов в месяц (примерно 50 EUR) после публикации. Вы можете отменить в конце любого месяца.</p>
				</div>
				<div class="wb-hero-visual">
					<figure class="film wb-film">
						<div class="wb-frame wb-frame-dark">
							<div class="wb-frame-bar"><span></span><span></span><span></span><i>Website Builder</i></div>
							<video class="filmVid" autoplay muted loop playsinline preload="auto" poster="/hero/wb-hero-poster.jpg" width="1440" height="900" aria-label="Конструктор Website Builder: пятнадцать шаблонов, выбран Solaz, в редакторе заголовок установлен, главный блок переставлен, затем Просмотреть и опубликовать">
								<source src="/hero/wb-hero.mp4" type="video/mp4" />
							</video>
						</div>
						<figcaption class="filmCap">Запись из нового конструктора: пятнадцать дизайнов, выбран Solaz, заголовок установлен, главный блок переставлен, затем Просмотреть и опубликовать. 33 секунды. Показанные дополнения и итоговые суммы относятся к демонстрационному сайту и могут быть отредактированы.</figcaption>
					</figure>
				</div>
			</div>
		</div>
	</header>

	<!-- PROOF -->
	<section class="wb-trust">
		<div class="wrap">
			<div class="wb-trust-grid">
				<div><div class="wb-trust-num">{plAgents}</div><div class="wb-trust-label">зарегистрированные агенты на PropertyList</div></div>
				<div><div class="wb-trust-num">{plAgencies}</div><div class="wb-trust-label">агентства, ведущие свой бизнес на ней</div></div>
				<div><div class="wb-trust-num">{plListings}</div><div class="wb-trust-label">объявления в сети</div></div>
			</div>
			<p class="wb-trust-line">Ваш сайт получает данные из той же сети, что и ваша MLS и CRM. Любая недвижимость оттуда может появиться на вашем сайте в день публикации, с фильтрацией по вашему желанию, и обновляется в тот же момент, когда меняется объявление.</p>
		</div>
	</section>

	<!-- THE FIFTEEN -->
	<section class="wb-section wb-fifteen" id="templates">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Пятнадцать</p>
				<h2 class="wb-section-h2">Пятнадцать дизайнов, <em>одна платформа.</em></h2>
				<p class="wb-lead">Каждый шаблон - это полный веб-сайт агентства: те же страницы, те же блоки, которые нужны агентству, в другом оформлении. Выберите тот, который соответствует тому, как вы уже работаете, а не наоборот.</p>
			</div>
			<div class="wb-chips" role="tablist" aria-label="Фильтровать шаблоны по стилю">
				<button class="wb-chip on" type="button" data-style="all" aria-pressed="true">Все пятнадцать</button>
				{styles.map((s) => <button class="wb-chip" type="button" data-style={s} aria-pressed="false">{s}</button>)}
			</div>
		</div>
		<div class="wb-rail-wrap">
			<button class="wb-rail-btn prev" type="button" aria-label="Предыдущие шаблоны">&lsaquo;</button>
			<div class="wb-rail" id="wbRail">
				{templates.map((t, i) => (
					<article class="wb-tpl" data-style={t.style}>
						<div class="wb-tpl-shots">
							<div class="wb-frame">
								<div class="wb-frame-bar"><span></span><span></span><span></span><i>yourbrand.estate-agency.co</i></div>
								<img src={`/wb/${t.id}-desktop.webp`} width="1440" height="900" alt={`${t.name} template, home page on a desktop screen`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							</div>
							<img class="wb-phone" src={`/wb/${t.id}-phone.webp`} width="390" height="844" alt={`${t.name} template on a phone`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
						</div>
						<div class="wb-tpl-meta">
							<span class="wb-tpl-style">{t.style}</span>
							<h3>{t.name}</h3>
							<p>{t.line}</p>
						</div>
					</article>
				))}
			</div>
			<button class="wb-rail-btn next" type="button" aria-label="Следующие шаблоны">&rsaquo;</button>
		</div>
		<div class="wrap"><p class="wb-fifteen-note">Вы можете изменить решение позже: смените шаблон и сохраните свои тексты, страницы и настройки. Три из пятнадцати (Solaz, Noir, Faro) открываются с видеороликом.</p></div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="wb-section wb-steps">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Как это работает</p>
				<h2 class="wb-section-h2">Выберите. Сделайте его своим. <em>Опубликуйте.</em></h2>
			</div>
			<div class="wb-steps-grid">
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Выберите шаблон</i></div><img src="/wb/step-1-pick.webp" width="1440" height="900" alt="Выбор шаблона с выбранным Solaz и предпросмотром рядом" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">1</div>
					<h3>Выберите шаблон</h3>
					<p>Выберите из пятнадцати готовых дизайнов сайтов для агентств. У каждого уже есть страницы, которые нужны агентству.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Редактируйте ваш сайт</i></div><img src="/wb/step-2-edit.webp" width="1440" height="900" alt="Редактор с открытыми настройками главного блока, показывающий три варианта компоновки" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">2</div>
					<h3>Сделайте его вашим</h3>
					<p>Добавьте цвет вашего бренда, ваш текст и ваши фотографии в редакторе, который показывает реальный сайт по мере работы. У каждого блока несколько вариантов компоновки; выберите один.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Проверьте и опубликуйте</i></div><img src="/wb/step-3-publish.webp" width="1440" height="900" alt="Диалог Просмотра и публикации, содержащий список ежемесячных кредитов перед публикацией сайта" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">3</div>
					<h3>Опубликовать</h3>
					<p>Объявления сети и ваши собственные уже там, поэтому публикация не означает загрузку чего-либо. Запросы сразу же поступают в ваш CRM.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- BUILT FOR AN AGENCY -->
	<section class="wb-section wb-agency">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Создан для агентства, а не для кафе</p>
				<h2 class="wb-section-h2">Блоки, которые агентству по недвижимости <em>действительно нужны.</em></h2>
				<p class="wb-lead">Сетка объектов, избранные объекты, поиск, форма оценки, справочники по районам, команда, отзывы, цифры, сколько стоит покупка, новые застройки. Каждый элемент берет данные из вашего аккаунта, вместо того чтобы просить вас вводить их вручную.</p>
			</div>
			<div class="wb-cards">
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9 21v-6h6v6" /></svg><strong>Каждое объявление в сети готово к показу.</strong><p>Ваши объявления появляются на сайте в день публикации. Объявления сети тоже там: отфильтруйте их и сразу показывайте то, что подходит вашим покупателям.</p></article>
