---
import Layout from '../../layouts/Layout.astro';
import CoagentPhone from '../../components/CoagentPhone.astro';
import { getPortalStats, statPlus } from '../../lib/portalStats';
import { COAGENT_NUMBER, coagentWaLink, CRM_STAFF_URL } from '../../data/coagent';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/ru/coagent/`;
const title = 'PropertyList CoAgent - ваш CRM в WhatsApp | PropertyList';
const description =
	'CoAgent: ваш CRM в WhatsApp. Голосовое сообщение после показа, и обновление CRM ждёт вашего подтверждения. Голос никогда не сохраняется, и ничего не сохраняется без вашего YES.';

const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'ru');
const plAgencies = statPlus(__ps.agencies, 'ru');
const plListings = statPlus(__ps.listings, 'ru');

const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=en';
const WA = coagentWaLink('Здравствуйте');
// A reminder for 9am Madrid time (07:00 UTC) on launch day, until the number exists.
const CAL = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent('Написать PropertyList CoAgent')}&dates=20260915T070000Z/20260915T071500Z&details=${encodeURIComponent('Номер CoAgent появится на https://info.propertylist.es/ru/coagent/?utm_source=calendar&utm_medium=reminder&utm_campaign=coagent-launch с 9:00. Прежде чем писать ему, убедитесь, что вы зарегистрированы и ваш номер WhatsApp указан в профиле. Бесплатно для всех агентов до 22 сентября.')}`;

// Everything CoAgent does today, as the question an agent would actually send.
// Tap a question to see what comes back. Answers are the verified descriptions.
const moments = [
	{
		label: 'В машине',
		asks: [
			{ q: 'Где мой следующий показ?', a: 'Ваш ежедневник, начиная с адреса и телефона клиента, потому что вы читаете это в машине.' },
			{ q: 'Что у меня завтра?', a: 'Весь день по порядку: объект и с кем встреча.' },
			{ q: 'Какой номер телефона у Marta Ruiz?', a: 'Сначала её телефон и email, чтобы палец уже был на кнопке звонка.' },
			{ q: 'Расскажите мне про the Bergs', a: 'На каком они этапе, что ищут и что случилось в последний раз, прежде чем вы наберёте номер.' },
		],
	},
	{
		label: 'Когда рядом клиент',
		asks: [
			{ q: 'Что у нас есть в Marbella, три спальни, до двух миллионов?', a: 'Пять объектов из общего MLS с ценами и ссылками. Называть клиента не нужно, поэтому это работает, даже когда рядом кто-то сидит.' },
			{ q: 'Расскажите про PL22234', a: 'Цена, спальни, площадь, расположение и ссылка на этот объект, ваш он или другого агентства.' },
			{ q: 'Что выгоднее: PL5001, PL5002 или PL5003?', a: 'CoAgent сравнивает их с похожими объектами по соседству по цене за квадратный метр, чтобы вы могли сказать клиенту, какой из них выгодно оценён, а какой стоит слишком дорого. Спросите сразу после поиска, и он сравнит именно эти результаты.' },
			{ q: 'Сколько квартир продаётся в San Pedro?', a: 'Реальное количество на рынке там, лучшие варианты и ссылка на полный список в вашем CRM.' },
			{ q: 'PL22234 всё ещё доступен?', a: 'Если объект принадлежит другому агентству, CoAgent предлагает спросить их за вас. Ответьте YES, и запрос уйдёт им через MLS, а их ответ вернётся к вам.' },
		],
	},
	{
		label: 'После показа',
		asks: [
			{ q: 'Добавьте заметку для Marta: она хочет посмотреть ещё раз в субботу', a: 'CoAgent зачитает заметку вашими же словами и сохранит её в карточке клиента, когда вы ответите YES.' },
			{ q: 'Marta сделала предложение', a: 'CoAgent переместит её карточку на нужный этап воронки, когда вы ответите YES, так же, как если бы вы перетащили её в CRM. Отметка клиента как выигранного или потерянного остаётся в CRM, где у вас спросят подробности.' },
			{ q: 'Добавьте Maria Lopez 6XX XXX XXX maria@example.com', a: 'Или отправьте её карточку контакта прямо с телефона. CoAgent зачитает имя, номер и email и добавит её в ваш CRM, когда вы ответите YES. Если она уже есть в базе, он свяжет с её карточкой вместо создания дубликата.' },
			{ photo: true, q: 'Фото документа, удостоверяющего личность клиента', a: 'Считываются только имя, фамилии и дата рождения, и добавляются как новый контакт, когда вы отвечаете YES. Номер документа никогда не сохраняется, как и само фото.' },
		],
	},
	{
		label: 'Выиграть объект',
		asks: [
			{ q: 'Давайте разместим объект', a: 'CoAgent подскажет, что отправить: сначала фото, потом цену, расположение и количество спален, своими словами. Никаких команд учить не нужно.' },
			{ photo: true, q: 'Фото нового объекта', a: 'Отправьте их прямо из галереи телефона, а затем расскажите CoAgent об объекте текстом или голосовым сообщением. Он спросит о том, чего не хватает, например о цене, зачитает объявление и по YES напишет заголовок, описание и характеристики. Ответьте PUBLISH, и объявление уйдёт на проверку, так же как из CRM. Без этого ничего не публикуется.' },
			{ photo: true, q: 'Фото таблички Se Vende', a: 'CoAgent считывает номер телефона с таблички, а также имя или цену, если они указаны. Ответьте YES, и владелец сохранится как контакт в вашем CRM с заметкой о табличке и напоминанием ему позвонить.' },
			{ q: 'Сколько стоит жильё в Nueva Andalucía?', a: 'Средняя цена предложения и диапазон по тому, что реально есть на рынке там. Если по какому-то району недостаточно объектов в базе, CoAgent так и скажет, а не станет гадать.' },
			{ q: 'Сколько стоит PL22234?', a: 'Оценка на основе сделок, зарегистрированных у нотариуса в этом городе, с диапазоном и ссылкой на публичное подтверждение. Или просто опишите жильё: «квартира 120 м² в Estepona». CoAgent всегда говорит, на чём основана цифра.' },
			{ q: 'REPORT', a: 'После оценки ответьте REPORT, и вы получите полный Property Intelligence Report в виде ссылки, которую можно отправить продавцу. Первый отчёт бесплатный. Дальше он оплачивается кредитами, CoAgent скажет сколько именно и спросит, прежде чем что-то списать.' },
			{ q: 'BROCHURE PL22234', a: 'Брошюра объекта с вашим собственным брендингом: страница, которую клиент может открыть, с актуальной ценой и формой для запроса, плюс PDF. Брошюры бесплатны.' },
		],
	},
	{
		label: 'Новые лиды',
		asks: [
			{ q: 'Какие у меня последние лиды?', a: 'Пять последних: кто спрашивал, про какой объект и когда: только ваши, или по всему агентству, если вы администратор, как и в CRM. Ответьте REPLY, чтобы ответить на самый свежий по email.' },
			{ q: 'REPLY', a: 'CoAgent напишет письмо вашему последнему лиду на его языке, исходя из того, что он спрашивал. Ответьте YES, и письмо уйдёт от вашего имени через CRM, а ответ придёт на ваш email. Или просто ответьте на уведомление о новом лиде.' },
		],
	},
];

const faqs = [
	{ q: 'Что нужно устанавливать?', a: 'Ничего. CoAgent работает в WhatsApp, которым вы и так пользуетесь весь день. Сохраните номер PropertyList, убедитесь, что ваш мобильный указан в профиле CRM, чтобы система знала, что вы агент, а не клиент, и отправьте голосовое сообщение.' },
	{ q: 'Он будет менять мой CRM автоматически?', a: 'Нет. CoAgent предлагает и ждёт. Он показывает клиента, которого определил, и изменения, которые хочет внести, поле за полем, и ничего не записывается, пока вы не ответите YES. Если он что-то не так расслышал, это стоит вам одного слова, а не неверного бюджета, тихо осевшего в общей карточке.' },
	{ q: 'Мои голосовые сообщения записываются?', a: 'Нет. Аудио расшифровывается и удаляется. Расшифровка сохраняется в карточке клиента, где вы можете прочитать именно то, что было сказано CRM.' },
	{ q: 'Работает ли он на русском языке?', a: 'Нет. CoAgent отвечает на английском, испанском, немецком, французском, португальском, болгарском и греческом языках, поэтому пишите ему по-английски (или на любом из этих языков). Он справляется даже с сообщением, где язык меняется на середине фразы, а на этом побережье так происходит почти всегда.' },
	{ q: 'Нужно ли называть клиента каждый раз?', a: 'Нет. Если вы называете клиента, голосовое сообщение превращается в обновления CRM. Без имени вы всё равно можете спросить про объекты, свой ежедневник, объект по референсу или сколько стоит район, а это как раз то, что нужно, когда рядом стоит случайный посетитель.' },
	{ q: 'Может ли он общаться с другими агентствами за меня?', a: 'Да. Спросите, доступен ли ещё объект другого агентства, и CoAgent предложит отправить запрос. Ответьте YES, и он уйдёт через MLS так же, как если бы был отправлен с экрана CRM, поэтому попадёт в их обычный рабочий процесс.' },
	{ q: 'Что если CoAgent не узнаёт мой номер?', a: 'Он ответит, на испанском и английском, со ссылкой на создание бесплатного аккаунта и ссылкой на страницу Staff вашего CRM, где вы добавляете мобильный в профиль. Если ваш номер не испанский, добавьте код страны впереди и напишите ещё раз.' },
	{ q: 'Что оплачивается кредитами?', a: 'Сообщения входят в ваш тариф, а брошюры бесплатны. Отчёт о рынке после первого бесплатного оплачивается кредитами PropertyList, по той же цене, что и в CRM. CoAgent всегда называет цену и ждёт вашего YES, прежде чем что-то списать.' },
	{ q: 'Сколько это стоит?', a: 'CoAgent бесплатен для всех агентов до 22 сентября. После этого у каждого агента есть 20 бесплатных сообщений в месяц, и ответ YES никогда не учитывается. Исключение для первых 10 агентов, которые напишут CoAgent: бесплатно и без ограничений до 1 ноября 2026 года. Безлимит стоит 50 кредитов в месяц на агента. Если вам нужно подключить больше 3 агентов, обратитесь к нам насчёт пакета. MLS и базовый CRM остаются бесплатными, и создание аккаунта ничего не стоит.' },
	{ q: 'Чего пока нет?', a: 'Подключения собственного номера WhatsApp, чтобы переписки с клиентами сохранялись сами, отдельной рабочей линии внутри приложения PropertyList и появления справки по клиенту на экране входящего звонка без вашего участия. Всё остальное на этой странице уже работает.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Главная', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Функции', item: `${origin}/features/` },
		{ '@type': 'ListItem', position: 3, name: 'CoAgent', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList CoAgent',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android', url: canonical,
	description: 'Ассистент для агентов по недвижимости, который работает через WhatsApp: голосовые сообщения превращаются в обновления CRM, которые агент утверждает, а вопросы о клиентах, объектах, ежедневнике и ценах по районам получают ответ из CRM агентства и общего MLS. Аудио никогда не сохраняется.',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};
---

<Layout
	lang="ru"
	title={title}
	description={description}
	canonical={canonical}
	ogImage="https://info.propertylist.es/og/og-coagent-v3-ru.jpg"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/coagent/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/coagent/' },
		{ hreflang: 'de', href: 'https://info.propertylist.es/de/coagent/' },
		{ hreflang: 'fr', href: 'https://info.propertylist.es/fr/coagent/' },
		{ hreflang: 'sv', href: 'https://info.propertylist.es/sv/coagent/' },
		{ hreflang: 'ru', href: 'https://info.propertylist.es/ru/coagent/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/coagent/' },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="cx heroGrid">
			<div>
				<div class="eyebrow"><span class="dot"></span> CoAgent &middot; ваш CRM в WhatsApp</div>
				<h1>Хватит печатать в CRM.<br /><span>Просто поговорите с ним.</span></h1>
				<p class="heroLead">
					Отправьте голосовое сообщение после показа. Ответьте YES. <strong>Рутина сделана, и вечер снова ваш.</strong>
				</p>
				<div class="ctaRow">
					{WA ? (
						<a class="btnPrimary" href={WA} target="_blank" rel="noopener">Написать CoAgent в WhatsApp</a>
					) : (
						<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Создать бесплатный аккаунт</a>
					)}
					<a class="btnGhost" href="#how">Посмотреть, как это работает</a>
				</div>
				<p class="micro">Бесплатно для всех агентов до 22 сентября &middot; Ничего не нужно устанавливать &middot; Ваш голос никогда не сохраняется &middot; Отвечает на английском, испанском, немецком, французском, португальском, болгарском и греческом</p>
				{WA && <p class="member"><b>WhatsApp: <a href={WA} target="_blank" rel="noopener">{COAGENT_NUMBER}</a></b></p>}
				{WA ? (
					<p class="member">Уже зарегистрированы в PropertyList? <a href={CRM_STAFF_URL} target="_blank" rel="noopener">Добавьте свой номер WhatsApp в профиль</a>, чтобы CoAgent знал, что это вы.</p>
				) : (
					<p class="member">
						<b>Номер будет доступен во вторник, 15 сентября, с 9:00.</b> Прежде чем писать ему, убедитесь, что вы
						<a href={SIGNUP} target="_blank" rel="noopener">зарегистрированы</a> и что ваш
						<a href={CRM_STAFF_URL} target="_blank" rel="noopener">номер WhatsApp добавлен в профиль</a>.
						<a class="calBtn" href={CAL} target="_blank" rel="noopener" style="display:table;margin-top:10px;padding:8px 14px;border-radius:10px;background:#0b1220;color:#fff;text-decoration:none;font-weight:800">Напомнить мне во вторник в 9:00</a>
					</p>
				)}
			</div>
			<CoagentPhone lang="ru" />
		</div>
	</section>

	<div class="strip">
		<div class="cx stripInner">
			<span>За ним: <b>{plAgencies}</b> агентств</span>
			<span><b>{plAgents}</b> агентов</span>
			<span><b>{plListings}</b> активных объектов</span>
			<span>Отвечает на <b>7</b> языках</span>
		</div>
	</div>

	<section class="band dark">
		<div class="cx">
			<div class="head center">
				<h2>Два сценария на сегодняшний вечер.</h2>
				<p>Никто не забывает специально. День просто движется быстрее, чем рутина.</p>
			</div>
			<div class="versus">
				<div class="vCol without">
					<div class="vHead">Без CoAgent</div>
					<ol>
						<li><b>18:40</b><span>Последний показ. Три обещания, и все в голове.</span></li>
						<li><b>21:30</b><span>Ноутбук открыт, вы печатаете день по памяти.</span></li>
						<li><b>Четверг</b><span>«Так вы прислали мне тот объект?»</span></li>
					</ol>
				</div>
				<div class="vCol with">
					<div class="vHead">С CoAgent</div>
					<ol>
						<li><b>18:41</b><span>Голосовое сообщение с парковки.</span></li>
						<li><b>18:42</b><span>Вы отвечаете YES. Заметка, требования клиента и напоминание сохранены.</span></li>
						<li><b>21:30</b><span>Вас нет за ноутбуком.</span></li>
					</ol>
				</div>
			</div>
			<p class="punch">У вас отличная память. <span>До четверга.</span></p>
		</div>
	</section>

	<section class="band soft" id="how">
		<div class="cx">
			<div class="head center">
				<div class="label">Как это работает</div>
				<h2>Скажите. Проверьте. Ответьте YES.</h2>
			</div>
			<div class="grid3">
				<div class="demo">
					<span class="num">1</span>
					<h3>Скажите</h3>
					<p>Так, как сказали бы коллеге.</p>
					<div class="mini">
						<div class="mb me">«Marta осталась довольна. Теперь готова и на три спальни, до восьмисот пятидесяти. Сказал, что пришлю ей вариант в Cerquilla в субботу.»</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">2</span>
					<h3>Проверьте</h3>
					<p>Смотрите, что именно он понял.</p>
					<div class="mini">
						<div class="mb">
							<b>Marta Ruiz · покупательница</b>
							<span class="kv"><i>Бюджет</i><em>850 000 €</em></span>
							<span class="kv"><i>Спальни</i><em>3</em></span>
							<span class="kv"><i>Напоминание</i><em>Cerquilla, суббота</em></span>
						</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">3</span>
					<h3>Ответьте YES</h3>
					<p>Только тогда что-то меняется.</p>
					<div class="mini">
						<div class="mb">Ответьте <b>YES</b>, чтобы сохранить.</div>
						<div class="mb me short">YES</div>
						<div class="mb done">Сохранено. Суббота уже в вашем календаре.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band" id="ask">
		<div class="cx">
			<div class="head center">
				<div class="label">Что можно спросить</div>
				<h2>Спрашивайте, как спросили бы коллегу.</h2>
				<p>Нажмите на любое сообщение, чтобы увидеть ответ.</p>
			</div>
			<div class="moments">
				{moments.map((m) => (
					<div class="moment">
						<div class="momentLabel">{m.label}</div>
						<div class="chips">
							{m.asks.map((item) => (
								<details class="chip">
									<summary>
										{item.photo && <span class="tag">Фото</span>}
										{item.photo ? item.q : `"${item.q}"`}
									</summary>
									<p>{item.a}</p>
								</details>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="band soft" id="matching">
		<div class="cx">
			<div class="matchBox">
				<div class="matchCopy">
					<div class="label">Построено на общем MLS</div>
