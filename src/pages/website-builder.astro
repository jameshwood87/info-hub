---
import Layout from '../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../lib/portalStats';
const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'en');
const plAgencies = statPlus(__ps.agencies, 'en');
const plListings = statPlus(__ps.listings, 'en');

const title = 'Website Builder for Estate Agents | PropertyList.es';
const description =
	'Pick one of fifteen finished agency website designs, make it yours, and every listing in your PropertyList account is already on it. Free to build and preview, 50 credits a month once you publish.';
const BUILD = 'https://agents.propertylist.es/website-builder';
const DOCS = 'https://info.propertylist.es/docs/propertylist-mls-user-manual/website-builder/';
const REFERRALS = 'https://agents.propertylist.es/referrals';
const DASHBOARD = 'https://agents.propertylist.es';

// The fifteen templates, as captured from the real files (public/wb). Order is
// the order shown; the style filter hides the rest.
const templates = [
	{ id: '14-solaz', name: 'Solaz', style: 'Showcase', line: 'Opens on a film. Cypress trees and coastline at dusk, the headline sitting low over the image.' },
	{ id: '01-marina', name: 'Marina', style: 'Modern', line: 'A teal and white header, a live search bar up top, and your latest listings in a grid below.' },
	{ id: '03-onyx', name: 'Onyx', style: 'Luxury', line: 'A night-time photograph of a lit villa, a serif headline in white, one button.' },
	{ id: '13-horizon', name: 'Horizon', style: 'Showcase', line: 'A split screen: a bold headline on one side, a full-height interior photograph on the other.' },
	{ id: '02-blanca', name: 'Blanca', style: 'Minimalist', line: 'One full-width photograph of a villa and pool, a small nav bar, no headline over the image.' },
	{ id: '05-puerto', name: 'Puerto', style: 'Modern', line: 'A full-width dusk photograph with a floating card over it showing the price and the details.' },
	{ id: '07-noir', name: 'Noir', style: 'Luxury', line: 'Opens on a film. A cinematic dark landscape with a large bold headline over it, minimal nav.' },
	{ id: '04-sierra', name: 'Sierra', style: 'Classic', line: 'A cream background, space for your photograph beside your name and an editorial paragraph.' },
	{ id: '09-continental', name: 'Continental', style: 'Modern', line: 'A navy dusk photograph, a bold white headline, and a price card overlaid on the image.' },
	{ id: '06-atrium', name: 'Atrium', style: 'Minimalist', line: 'Light grey and white, one accent colour in the headline, a search bar and a strip of latest properties.' },
	{ id: '11-imperial', name: 'Imperial', style: 'Luxury', line: 'A cream background, a bold serif headline, two photographs underneath in a simple gallery.' },
	{ id: '08-cortijo', name: 'Cortijo', style: 'Classic', line: 'A warm parchment background, an arched picture frame beside your name and an introduction.' },
	{ id: '10-meridian', name: 'Meridian', style: 'Minimalist', line: 'A pale background, an italic serif headline, a plain search bar, nothing competing for attention.' },
	{ id: '12-heritage', name: 'Heritage', style: 'Classic', line: 'A white background, your name and an introduction paragraph, green call to action buttons.' },
	{ id: '15-faro', name: 'Faro', style: 'Showcase', line: 'Opens on a film. A dark mountain and sea silhouette, a large serif headline, minimal nav.' },
];
const styles = ['Modern', 'Minimalist', 'Luxury', 'Classic', 'Showcase'];

const addons = [
	{ name: 'Extra page', what: 'One more page beyond the included set', price: '10 credits a month' },
	{ name: 'Instant Content', what: 'Area guides and a blog, written for you, unlimited', price: '30 credits a month' },
	{ name: 'Your own domain', what: 'Your domain instead of a PropertyList address', price: '20 credits a month' },
	{ name: 'Remove PropertyList branding', what: 'Takes the PropertyList mark off your site', price: '50 credits a month' },
	{ name: 'Pop-up lead capture', what: 'A pop-up that captures leads on your site', price: '8 credits a month' },
	{ name: 'AI answers on listings', what: 'Builds an FAQ from what buyers actually ask', price: '8 credits a month' },
	{ name: 'Auto SEO and GEO', what: 'Checks your site weekly and fixes what it can', price: '5 credits a month' },
	{ name: 'Monthly email report', what: 'A performance summary emailed on the 1st of the month', price: '5 credits a month' },
];

const faqs = [
	{ q: 'Is it really free to build?', a: 'Yes. Building and previewing your site costs nothing. You are only charged once you publish it, 50 credits a month from then on.' },
	{ q: 'What happens when I publish?', a: 'Your site goes live and every listing in your PropertyList account appears on it straight away. From that point the 50 credits a month covers running the site.' },
	{ q: 'Can I change template later?', a: 'Yes. Switch to a different one of the fifteen designs whenever you want, and you keep your words, your pages and your settings.' },
	{ q: 'Do I have to upload my listings?', a: 'No. Every listing in your PropertyList account is already on the site, and it updates when you change the listing in the CRM. Nothing is typed twice.' },
	{ q: 'Where do enquiries go?', a: 'Straight into your PropertyList CRM. Lead, Seller and Property pipelines are free with no limit. Moving a qualified lead into the Buyer pipeline costs 1 credit.' },
	{ q: 'Can I use my own domain?', a: 'Yes, for 20 credits a month. Until then your site runs on a PropertyList address.' },
	{ q: 'What if I cancel?', a: 'Your site reverts to the free agency microsite at the end of the billing period. You keep your domain.' },
	{ q: 'Is the SEO any good?', a: 'Auto SEO and GEO checks your site weekly and fixes what it can, for 5 credits a month. We do not promise rankings; how a site performs depends on more than any one platform.' },
	{ q: 'Do I need to be technical?', a: 'No. You pick a template, edit it in an editor that shows your real site as you work, and publish when you are ready. Edit with AI lets you describe a change in plain English too.' },
	{ q: 'Are the legal pages included?', a: 'Yes. Aviso legal, privacy and cookies pages, plus a cookie banner, come with every template. They are included and never billed separately.' },
];

const ldWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'PropertyList Website Builder',
	url: 'https://info.propertylist.es/website-builder/',
	description,
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es', logo: { '@type': 'ImageObject', url: 'https://info.propertylist.es/og/logo-default.png' } },
};
const ldBreadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://info.propertylist.es/' },
		{ '@type': 'ListItem', position: 2, name: 'Website Builder' },
	],
};
const ldVideo = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: 'PropertyList Website Builder: pick a design, edit it, publish',
	description: 'A 33 second recording of the PropertyList Website Builder with a sample agency: the fifteen designs, one chosen, the headline selected, the hero rearranged, then Review and publish. No sound.',
	thumbnailUrl: ['https://info.propertylist.es/hero/wb-hero-poster.jpg'],
	contentUrl: 'https://info.propertylist.es/hero/wb-hero.mp4',
	uploadDate: '2026-09-05',
	duration: 'PT33S',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es' },
};
const ldFaq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical="https://info.propertylist.es/website-builder/"
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: 'https://info.propertylist.es/website-builder/' },
		{ hreflang: 'es', href: 'https://info.propertylist.es/es/constructor-de-webs/' },
		{ hreflang: 'x-default', href: 'https://info.propertylist.es/website-builder/' },
	]}
>
	<script type="application/ld+json" set:html={JSON.stringify(ldWebsite)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldVideo)} />
	<script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />

	<!-- HERO -->
	<header class="wb-hero">
		<div class="wrap">
			<div class="wb-hero-grid">
				<div class="wb-hero-text">
					<div class="wb-hero-eyebrow"><img src="https://info.propertylist.es/og/icon-default.png" alt="" width="18" height="18" /><span>Website Builder &middot; runs on your MLS account</span></div>
					<h1 class="wb-hero-h1">Pick a design.<br />Your listings <em>fill it.</em></h1>
					<p class="wb-hero-sub">Fifteen finished agency websites, ready for your listings and your enquiries. Every property in your PropertyList account is already on the site the day you publish.</p>
					<div class="wb-hero-ctas">
						<a class="btn btn-primary btn-large" href={BUILD}>Build for free</a>
						<a class="btn btn-secondary on-dark" href="#xml">I already have a website</a>
					</div>
					<p class="wb-hero-trust">Free to build and preview. 50 credits a month (about 50 EUR) once you publish. Cancel at the end of any month.</p>
				</div>
				<div class="wb-hero-visual">
					<figure class="film wb-film">
						<div class="wb-frame wb-frame-dark">
							<div class="wb-frame-bar"><span></span><span></span><span></span><i>Website Builder</i></div>
							<video class="filmVid" autoplay muted loop playsinline preload="auto" poster="/hero/wb-hero-poster.jpg" width="1440" height="900" aria-label="The Website Builder: the fifteen templates, Solaz chosen, the editor with the headline selected, the hero rearranged, then Review and publish">
								<source src="/hero/wb-hero.mp4" type="video/mp4" />
							</video>
						</div>
						<figcaption class="filmCap">Recorded from the new builder with a sample agency: the fifteen designs, Solaz chosen, the headline selected, the hero rearranged, then Review and publish. 33 seconds, no sound. The add-ons and totals shown are the sample site's.</figcaption>
					</figure>
				</div>
			</div>
		</div>
	</header>

	<!-- PROOF -->
	<section class="wb-trust">
		<div class="wrap">
			<div class="wb-trust-grid">
				<div><div class="wb-trust-num">{plAgents}</div><div class="wb-trust-label">registered agents on PropertyList</div></div>
				<div><div class="wb-trust-num">{plAgencies}</div><div class="wb-trust-label">agencies running their business on it</div></div>
				<div><div class="wb-trust-num">{plListings}</div><div class="wb-trust-label">listings on the network</div></div>
			</div>
			<p class="wb-trust-line">Your site reads from the same account as your MLS and CRM. Every listing in it is already on your site the day you publish, and it updates the moment you edit it.</p>
		</div>
	</section>

	<!-- THE FIFTEEN -->
	<section class="wb-section wb-fifteen" id="templates">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">The fifteen</p>
				<h2 class="wb-section-h2">Fifteen designs, <em>one platform.</em></h2>
				<p class="wb-lead">Every template is a complete agency website: the same pages, the same blocks an agency needs, in a different look. Pick the one that matches how you already work, not the other way round.</p>
			</div>
			<div class="wb-chips" role="tablist" aria-label="Filter templates by style">
				<button class="wb-chip on" type="button" data-style="all" aria-pressed="true">All fifteen</button>
				{styles.map((s) => <button class="wb-chip" type="button" data-style={s} aria-pressed="false">{s}</button>)}
			</div>
		</div>
		<div class="wb-rail-wrap">
			<button class="wb-rail-btn prev" type="button" aria-label="Previous templates">&lsaquo;</button>
			<div class="wb-rail" id="wbRail">
				{templates.map((t, i) => (
					<article class="wb-tpl" data-style={t.style}>
						<div class="wb-tpl-shots">
							<div class="wb-frame">
								<div class="wb-frame-bar"><span></span><span></span><span></span><i>yourbrand.estate-agency.co</i></div>
								<img src={`/wb/${t.id}-desktop.webp`} width="1440" height="900" alt={`${t.name} template, home page on a desktop screen`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
							</div>
							<img class="wb-phone" src={`/wb/${t.id}-phone.webp`} width="390" height="844" alt={`${t.name} template on a phone`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
						</div>
						<div class="wb-tpl-meta">
							<span class="wb-tpl-style">{t.style}</span>
							<h3>{t.name}</h3>
							<p>{t.line}</p>
						</div>
					</article>
				))}
			</div>
			<button class="wb-rail-btn next" type="button" aria-label="Next templates">&rsaquo;</button>
		</div>
		<div class="wrap"><p class="wb-fifteen-note">Change your mind later: switch template and keep your words, your pages and your settings. Three of the fifteen (Solaz, Noir, Faro) open on a film.</p></div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="wb-section wb-steps">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">How it works</p>
				<h2 class="wb-section-h2">Pick. Make it yours. <em>Publish.</em></h2>
			</div>
			<div class="wb-steps-grid">
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Choose a template</i></div><img src="/wb/step-1-pick.webp" width="1440" height="900" alt="The template picker with Solaz selected and its preview beside it" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">1</div>
					<h3>Pick a template</h3>
					<p>Choose from fifteen finished agency website designs. Every one already has the pages an agency needs.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Edit your website</i></div><img src="/wb/step-2-edit.webp" width="1440" height="900" alt="The editor with the hero block's settings open, showing three arrangements" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">2</div>
					<h3>Make it yours</h3>
					<p>Add your brand colour, your words and your photos in an editor that shows the real site as you work. Each block has several arrangements; pick one.</p>
				</article>
				<article class="wb-step">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Review and publish</i></div><img src="/wb/step-3-publish.webp" width="1440" height="900" alt="The Review and publish dialog listing the monthly credits before the site goes live" loading="lazy" decoding="async" /></div>
					<div class="wb-step-num">3</div>
					<h3>Publish</h3>
					<p>Your listings are already there, so publishing does not mean uploading anything. Enquiries start landing in your CRM straight away.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- BUILT FOR AN AGENCY -->
	<section class="wb-section wb-agency">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow">Built for an agency, not a cafe</p>
				<h2 class="wb-section-h2">The blocks an estate agent <em>actually needs.</em></h2>
				<p class="wb-lead">Property grid, featured property, search, valuation form, area guides, team, reviews, numbers, what buying costs, new developments. Each one reads from your account instead of asking you to type.</p>
			</div>
			<div class="wb-cards">
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9 21v-6h6v6" /></svg><strong>Every listing on the network, ready to show.</strong><p>Your own listings are on your site the day you publish. The network's stock is there too: filter it and showcase what fits your buyers, straight away.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h7M18 15l3 3-3 3" /></svg><strong>Leads land in your CRM.</strong><p>Every enquiry arrives as a lead. Push the ones you want through your pipelines: Lead, Seller and Property are free with no limit, and moving a qualified lead into the Buyer pipeline costs 1 credit.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg><strong>Search that works like a portal.</strong><p>Buyers filter the stock by area, type and price on the Properties page, and can save a search.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10l8-6 8 6v10M9 20v-5h6v5" /><path d="M2 20h20" /></svg><strong>A free valuation form that does more.</strong><p>Each seller request arrives as a lead with a Property Intelligence Report already filled in, ready to buy for 5 credits if you want it.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6z" /><path d="M9 12h6M9 16h6M15 3v4h4" /></svg><strong>What buying costs, kept current.</strong><p>Spanish purchase costs with the law cited. We check for new and updated rates and refresh the block, so your site stays right without you touching it. Your lawyer confirms the final figure.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19h16M6 16V9M11 16V5M16 16v-7" /></svg><strong>Numbers that count themselves.</strong><p>The numbers block reads from your live listings. Nobody types it in.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-5-6.3" /></svg><strong>Reviews and team, from what you already have.</strong><p>Connect your Google Business Profile and your reviews appear on the site, or type them in yourself. Nothing is invented. Your team comes from the staff already in your agency account.</p></article>
				<article class="wb-card"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg><strong>Every language your buyers speak.</strong><p>English and Spanish come as standard. Add the other languages your buyers use, on the same site.</p></article>
			</div>
		</div>
	</section>

	<!-- EDIT WITH AI -->
	<section class="wb-section wb-ai">
		<div class="wrap">
			<div class="wb-ai-grid">
				<div class="wb-ai-text">
					<p class="eyebrow" style="color:#6fe5d3">Edit with AI</p>
					<h2 class="wb-section-h2 on-dark">Click anything. <em>Say what to change.</em></h2>
					<p class="wb-lead" style="color:#b8c9cb">Describe a change in plain English and the page updates. Every change is a draft until you publish it, and Undo is always there.</p>
				</div>
				<figure class="wb-ai-shot">
					<div class="wb-frame"><div class="wb-frame-bar"><span></span><span></span><span></span><i>Edit your website</i></div><img src="/wb/ai-bubble.webp" width="1440" height="900" alt="The headline selected in the editor, with the changes the agent can ask for" loading="lazy" decoding="async" /></div>
					<figcaption>The headline selected in the editor. Shorter, warmer tone, mention the town, or your own words.</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!-- PRICING -->
	<section id="pricing" class="wb-pricing wb-section">
		<div class="wrap">
			<div class="wb-section-head">
				<p class="eyebrow" style="color:#6fe5d3">Pricing</p>
				<h2 class="wb-section-h2 on-dark">Free to build. <em>50 credits a month once you publish.</em></h2>
				<p class="wb-lead" style="color:#b8c9cb">One base plan, add-ons in credits, and you can stop any of them at the end of any month.</p>
			</div>
			<div class="wb-price-grid">
				<div class="wb-pricing-card">
					<div class="wb-pricing-name">Website Builder</div>
					<div class="wb-pricing-price">50 credits <span class="unit">a month</span></div>
					<p class="wb-pricing-tagline">Nothing is charged while you build and preview; the subscription starts the day you publish.</p>
					<ul class="wb-pricing-features">
						<li>Home, Properties (search and results, with filters and a saved search), a property page for every listing, About and Contact</li>
						<li>Legal pages (aviso legal, privacy, cookies) and a cookie banner, included and never billed</li>
						<li>English and Spanish as standard, more languages can be added</li>
						<li>All fifteen designs, switch any time and keep your work</li>
						<li>Enquiries straight into your PropertyList CRM</li>
						<li>Cancel at the end of any month; the site reverts to the free agency microsite and you keep your domain</li>
					</ul>
					<div class="wb-pricing-cta"><a class="btn btn-primary btn-large" href={BUILD}>Build for free</a></div>
					<p class="wb-pricing-note">Extra pages: <strong>10 credits a month</strong> each.</p>
				</div>
				<div class="wb-pricing-aside">
					<div class="wb-addon-card">
						<h4>Add-ons, <em>if you want them</em></h4>
						<p class="wb-addon-intro">Each is monthly, switched on from your account, and can be stopped at the end of any month.</p>
						<ul class="wb-addon-list">
							{addons.map((a) => (
								<li><span class="wb-addon-name">{a.name}<small>{a.what}</small></span><span class="wb-addon-price">{a.price}</span></li>
							))}
						</ul>
						<div class="wb-addon-footer">New developments feed: a separate module, priced in your account.</div>
					</div>
					<div class="wb-credit-info">
						<h4>What is a credit</h4>
						<p>PropertyList's unit for paid features, bought in packs: 1 credit (about 1 EUR) at the smallest pack, less at larger ones. Credits do not expire, so anything you do not use this month is still there next month.</p>
						<p style="margin:0"><a href={REFERRALS}>Refer another agency</a> and you get 20 credits (about 20 EUR) once they complete verification, not on signup. The new agency gets 10 credits.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ALREADY HAVE A WEBSITE -->
	<section id="xml" class="wb-xml wb-section">
		<div class="wrap">
			<div class="wb-xml-inner">
				<div>
					<p class="eyebrow">Already have a website?</p>
					<h2 class="wb-section-h2">Keep your site. <em>Feed it your listings.</em></h2>
					<p class="wb-lead">Feed your PropertyList listings into the site you already have, by XML or by the Website API. Your developer connects it once; from then on the site reads from the same account as your MLS and CRM.</p>
				</div>
				<div class="wb-xml-card">
					<div class="wb-xml-price-row"><span class="wb-xml-price">35 credits</span><span class="wb-xml-price-unit">a month</span></div>
					<p class="wb-xml-detail">XML feed or Website API. Cancel any time.</p>
					<ul class="wb-pricing-features">
						<li>Your PropertyList listings on your own site</li>
						<li>XML feed or Website API, your developer's choice</li>
						<li>The docs are public; nothing to buy to read them</li>
					</ul>
					<a class="btn btn-primary" href={DASHBOARD}>Set up a feed</a>
					<p class="wb-xml-docs"><a href={DOCS}>Read the Website Builder and feed docs</a></p>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="wb-faq wb-section">
		<div class="narrow">
			<div class="wb-section-head">
				<p class="eyebrow">Questions</p>
				<h2 class="wb-section-h2">What agents <em>ask first.</em></h2>
			</div>
			<div>
				{faqs.map((f) => (
					<div class="wb-faq-item"><details><summary>{f.q}</summary><p>{f.a}</p></details></div>
				))}
			</div>
		</div>
	</section>

	<!-- FINAL CTA -->
	<section class="wb-final wb-section">
		<div class="narrow">
			<p class="eyebrow" style="color:#6fe5d3">Built on the Costa del Sol &middot; used across Spain</p>
			<h2 class="wb-section-h2 on-dark">Your listings are ready.<br /><em>Is your website?</em></h2>
			<p class="wb-lead">Pick a design, make it yours, and publish when you want.</p>
			<a class="btn btn-primary btn-large" href={BUILD}>Build for free</a>
			<p class="wb-final-note">Free to build and preview. 50 credits a month once you publish. <a href={DOCS}>Read the docs</a>.</p>
		</div>
	</section>

	<script is:inline>
		(function () {
			var rail = document.getElementById('wbRail');
			if (!rail) return;
			var chips = document.querySelectorAll('.wb-chip');
			var cards = rail.querySelectorAll('.wb-tpl');
			chips.forEach(function (c) {
				c.addEventListener('click', function () {
					var s = c.getAttribute('data-style');
					chips.forEach(function (x) { var on = x === c; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
					cards.forEach(function (k) { k.hidden = !(s === 'all' || k.getAttribute('data-style') === s); });
					rail.scrollTo({ left: 0, behavior: 'smooth' });
				});
			});
			function step(dir) {
				var first = rail.querySelector('.wb-tpl:not([hidden])');
				var w = first ? first.getBoundingClientRect().width + 24 : rail.clientWidth * 0.8;
				rail.scrollBy({ left: dir * w, behavior: 'smooth' });
			}
			document.querySelector('.wb-rail-btn.prev').addEventListener('click', function () { step(-1); });
			document.querySelector('.wb-rail-btn.next').addEventListener('click', function () { step(1); });
		})();
	</script>
</Layout>

<style is:global>
