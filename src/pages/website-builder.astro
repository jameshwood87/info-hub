<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does it take to launch a site?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most agencies launch in 1 day or 2. Pick a layout, brand it, point your domain - and your MLS properties are already there. No content to upload, no developer to brief, no waiting."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to upload my properties manually?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Every property already in your PropertyList account appears on your site automatically. Add a property in your CRM and it is on your site within minutes - prices, photos, descriptions, the lot."
      }
    },
    {
      "@type": "Question",
      "name": "Can AI really build my site for me?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Open Edit with AI, describe what you want in plain English - for example add a section about our rental service and make the headline warmer - and the assistant rewrites the page, adjusts your colours and fonts, or adds whole sections in seconds. Every change is a draft, so you refine it and publish only when you are happy."
      }
    },
    {
      "@type": "Question",
      "name": "What if I want to use my own domain?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Connect your own domain - your-agency.com - in minutes. We handle SSL and hosting automatically. If you do not have a domain yet, we can help you register one."
      }
    },
    {
      "@type": "Question",
      "name": "I already have a website. Can I still use PropertyList?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The XML feed (from 35 euros/month or 350 euros/year) feeds every PropertyList property straight into your existing website. The same feed can also push to other portals you work with."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I cancel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your site reverts back to the free MicroSite at the end of your billing period. No cancellation fee, no commitment. You keep your domain. You can come back any time."
      }
    },
    {
      "@type": "Question",
      "name": "Is the SEO actually any good?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The AI writes meta titles and descriptions tuned for the way buyers in Spain actually search - villa con piscina en Marbella rather than generic real estate copy. Schema markup is built in for every listing. Auto-generated location pages cover the areas you list in. We do not promise rankings (no one honest can), but we give you the technical foundation most agency sites lack."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get leads from my site to my CRM?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Automatically. Every enquiry form, popup, and property enquiry button feeds directly into the PropertyList CRM with source tracking. Auto-assign rules send each lead to the right agent on your team."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to be technical to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not at all. The builder is drag-and-drop - if you can move a slide around in PowerPoint, you can build a page. For agents who do want full control, custom HTML blocks are available."
      }
    }
  ]
}
</script>
