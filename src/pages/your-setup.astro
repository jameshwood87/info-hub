---
import Layout from '../layouts/Layout.astro';
import { getPortalStats, statPlus } from '../lib/portalStats';

// A configurator, not a fifth telling of the value story. /free/ already does
// money, /hours/ does time, /what-we-do/ follows a listing and /launch/ does
// speed. The gap none of them fills is "which of these should I actually switch
// on, and what will it cost me a month". That is what this answers.
//
// Third shape, 26-08-26, after a three-lens panel voted unanimously (including
// the agent instructed to DEFEND the slider) to kill the stage slider. This is
// the settings-list: the idiom a 50-something phone user already knows cold.
//   - The free core is ON from first paint (free has no off switch), so the
//     first screen shows value delivered instead of three zeros and homework.
//   - Everything paid is a switch row, off by default. Nothing can enter the
//     receipt without a deliberate flick - the slider's worst bug was adding
//     Nurture's 20cr because you LOOKED at the last stage.
//   - Pay-per-use is a fact box, not switches, because those are not
//     subscriptions and dressing them as toggles would misprice them.
//
// Every hour figure is lifted from /hours/ rather than invented, including the
// afterMin residue, so the two pages cannot drift apart. Hours given back is
// hours minus that residue, never the whole task. Per-use savings (the
// valuation argument) are NOT counted in the hours meter for the same reason
// per-use credits are not in the monthly total: no invented usage.
//
// The ES twin /es/tu-configuracion/ is GENERATED by /root/es_translate.py on
// the droplet (exact-count-asserted replacements). Change this file, re-run
// that script; never hand-edit the Spanish file.

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/your-setup/`;
const title = 'Your setup: what to switch on, and what it costs | PropertyList';
const description =
	'Start with how you work now and add one thing at a time. What is free is already on, everything paid has its own switch, and the running total is always in view. Most of it stays free.';

const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'en');

// hours: weekly hours the task costs. after: minutes still left once the tool
// is on. Both from /hours/, deliberately conservative. fix says what strikes
// the task: 'free' (on from first paint), 'addon:<key>' (a switch), 'peruse:'
// (available pay-per-use, never struck, never counted) or 'soon:' (not built,
// never struck, never counted).
type Task = {
	id: string;
	label: string;
	hours: number;
	after: number;
	fix: string;
	needs?: 'lettings' | 'nosite';
};

const allTasks: Task[] = [
	{ id: 'listings', label: 'Writing listings at 11pm', hours: 2, after: 15, fix: 'free' },
	{ id: 'portals', label: 'Re-typing the same flat into five portals', hours: 2, after: 0, fix: 'free' },
	{ id: 'matching', label: "Scrolling portals to find a buyer's match", hours: 2, after: 10, fix: 'free' },
	{ id: 'desk', label: 'Driving back to the office to use the CRM', hours: 1, after: 0, fix: 'free' },
	{ id: 'valuation', label: 'Arguing with a vendor about their price', hours: 2, after: 30, fix: 'peruse:Property Intelligence Report' },
	{ id: 'followup', label: 'Remembering who I promised to call back', hours: 3, after: 15, fix: 'addon:nur' },
	{ id: 'website', label: 'Nagging a developer about my website', hours: 1, after: 10, fix: 'addon:wb', needs: 'nosite' },
	{ id: 'tenants', label: 'Tenancies living in a spreadsheet', hours: 2, after: 30, fix: 'addon:rent', needs: 'lettings' },
	{ id: 'callnotes', label: 'Typing up calls I already said out loud', hours: 2, after: 0, fix: 'soon:CoAgent' },
	{ id: 'signatures', label: 'Chasing one signature for a week', hours: 1, after: 0, fix: 'soon:Instant Documents' },
	{ id: 'brochures', label: 'Making brochures in Canva at midnight', hours: 1, after: 0, fix: 'soon:Instant Brochure' },
];

// on from first paint, with ticks, because free has no off switch
const freeTools = [
	{ name: 'Shared MLS and CRM', href: '/pipelines/' },
	{ name: 'Unlimited listings and staff' },
	{ name: 'Instant Listing', href: '/instant-listing/' },
	{ name: 'XML feeds for your own stock, in and out', href: '/xml-feed-import/', note: 'Your own stock moves free, in any direction: out to other portals, CRMs and your own website. The paid thing is the feed of the whole network’s listings for your site, 35 credits a month.' },
	{ name: 'Branded microsite' },
	{ name: 'Mobile app', href: '/mobile-app/' },
	{ name: 'AI Property Search', href: '/ai-property-search/', note: 'Free in beta.' },
];

// facts, not switches: these are not subscriptions and never join the monthly
const perUseFacts = [
	{ name: 'Buyer leads', href: '/pricing/', fact: '1 credit per lead you move into the Buyer pipeline, first 5 free' },
	{ name: 'Property Intelligence Report', href: '/property-intelligence-report/', fact: '5 credits per report' },
	{ name: 'Feature a listing', fact: '10 credits for 3 days' },
];

// the switches: off by default, each filtered by the two questions.
// show 'always' | 'nosite' | 'hassite' | 'lettings'; needs = another switch.
type Paid = {
	key: string;
	name: string;
	href?: string;
	price: string;
	monthly: number;
	taskId?: string;
	note: string;
	show: 'always' | 'nosite' | 'hassite' | 'lettings';
	needs?: string;
};

const paidTools: Paid[] = [
	{
		key: 'nur',
		name: 'Automation and Nurture',
		href: '/nurture/',
		price: '20 credits a month',
		monthly: 20,
		taskId: 'followup',
		note: 'Follow-up emails under your own name, hot-lead detection and the daily call list. It works while you are at a viewing.',
		show: 'always',
	},
	{
		key: 'rent',
		name: 'Rentals Module',
		href: '/rentals/',
		price: '50 credits per 30 days',
		monthly: 50,
		taskId: 'tenants',
		note: 'Chases its own renewal dates, which is the part nobody remembers until it is late. Free for 30 days, no card.',
		show: 'lettings',
	},
	{
		key: 'wb',
		name: 'Website Builder',
		href: '/website-builder/',
		price: '50 credits a month',
		monthly: 50,
		taskId: 'website',
		note: 'A real site that loads your MLS stock on its own. Build and preview free, pay only once you publish.',
		show: 'nosite',
	},
	{
		key: 'ic',
		name: 'Instant Content',
		href: '/instant-content/',
		price: '30 credits a month',
		monthly: 30,
		note: 'Add-on to the Website Builder: AI blog and area guides for your site.',
		show: 'nosite',
		needs: 'wb',
	},
	{
		key: 'feed',
		name: 'Network feed to your own site',
		href: '/xml-feed-import/',
		price: '35 credits a month',
		monthly: 35,
		note: 'Every shared listing on the network, on the site you already have. Your own listings are free either way.',
		show: 'hassite',
	},
	{
		key: 'devfeed',
		name: 'New developments feed',
		price: '25 credits a month',
		monthly: 25,
		note: 'Separate feed, off-plan and new build.',
		show: 'hassite',
	},
];

// not built: no price, no switch, no counting
const soonTools = [
	{ name: 'Connected inbox', href: '/connected-inbox/' },
	{ name: 'CoAgent', href: '/coagent/' },
	{ name: 'Instant Documents', href: '/instant-documents/' },
	{ name: 'Instant Brochure', href: '/instant-brochure/' },
	{ name: 'Instant Video and Images', href: '/instant-video/' },
];

const faqs = [
	{
		q: 'Where do the hours come from?',
		a: 'From the same list as the admin tally on the hours page, which is deliberately conservative. A tool almost never removes a job completely, so the figure here is the hours the task costs minus the minutes it still costs afterwards. Writing listings drops from two hours to fifteen minutes, for example, and this page counts the difference rather than the whole two hours.',
	},
	{
		q: 'Why are the per-use credits kept out of the monthly total?',
		a: 'Because rolling them in would be a made-up number. A buyer lead costs a credit at the moment you decide that lead is worth having, and if you take none in a month you spend none. Adding a guess about how many you might take would make the monthly figure look precise when it is not.',
	},
	{
		q: 'Why is everything paid switched off?',
		a: 'Because nothing here turns itself on. Most agencies use the free core alone, and that is a perfectly good place to stay. Each paid tool has its own switch, you flick it the day you want it, and it can be switched off again the month you stop wanting it.',
	},
	{
		q: 'What about the ones marked coming soon?',
		a: 'They are not built. They cost nothing, they save nothing, and they are on the page because agents ask what is next. When one ships it gets a price and starts counting, and not before.',
	},
];
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	robots="noindex,follow"
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/tu-configuracion/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<div class="wrap" data-setup>
		<section class="intro">
			<p class="kicker">Your setup</p>
			<h1>Start where you are.<br /><em>Add one thing at a time.</em></h1>
			<p class="sub">
				Answer two questions, see what is already free, and switch on only what you would actually use. Nothing
				paid turns itself on, and a lot of agencies never go past the free part.
			</p>
		</section>

		<section class="qs">
			<div class="q">
				<span class="qLab">Do you do lettings?</span>
				<div class="seg" role="group" aria-label="Do you do lettings?">
					<button type="button" class="segBtn on" data-lettings="no">No</button>
					<button type="button" class="segBtn" data-lettings="yes">Yes</button>
				</div>
			</div>
			<div class="q">
				<span class="qLab">Have you got your own website?</span>
				<div class="seg" role="group" aria-label="Have you got your own website?">
					<button type="button" class="segBtn on" data-site="no">Not yet</button>
					<button type="button" class="segBtn" data-site="yes">Yes</button>
				</div>
			</div>
		</section>

		<div class="board">
			<div class="panel">
				<section class="week">
					<h2 class="secHead">Your week, by hand</h2>
					<ul class="weekList" data-week>
						{allTasks.map((t) => (
							<li data-task={t.id}>
								<button type="button" class="wJump" data-jump={t.fix}>
									<span class="wLabel">{t.label}</span>
									<span class="wRight">
										<span class="wH">{t.hours}h</span>
										<span class="wFix" data-wfix></span>
									</span>
								</button>
							</li>
						))}
					</ul>
					<p class="weekTotal">About <strong data-weektotal>17</strong> hours of admin a week, from the <a href="/hours/">admin tally</a>. Deliberately conservative.</p>
				</section>

				<section class="freeBlock">
					<h2 class="secHead">Included free, from day one</h2>
					<p class="secSub">Already on for everyone. Free has no off switch and no trial clock.</p>
					{freeTools.map((t) => (
						<div class="tool">
							<div class="toolTop">
								<span class="toolName">
									<span class="tick" aria-hidden="true">&#10003;</span>
									{t.href ? <a href={t.href}>{t.name}</a> : t.name}
								</span>
								<span class="toolPrice">Free</span>
							</div>
							{t.note ? <p class="toolNote">{t.note}</p> : null}
						</div>
					))}
				</section>

				<section class="perUse">
					<h2 class="secHead">Pay per use, no subscription</h2>
					{perUseFacts.map((t) => (
						<p class="puRow">
							<span class="puName">{t.href ? <a href={t.href}>{t.name}</a> : t.name}</span>
							<span class="puFact">{t.fact}</span>
						</p>
					))}
					<p class="puNote">These never join the monthly total. You spend a credit at the moment something is worth having, and not before.</p>
				</section>

				<p class="stopLine">{plAgents} agents are on the free core. A lot of agencies stop here.</p>

				<section class="paid">
					<h2 class="secHead">Add only what you would use</h2>
					<p class="secSub">Each one has its own switch. Nothing is bundled, and nothing is on unless you turn it on.</p>
					{paidTools.map((a) => (
						<div class="addon" data-addon={a.key}>
							<div class="toolTop">
								<span class="toolName">
									{a.href ? <a href={a.href}>{a.name}</a> : a.name}
								</span>
								<span class="addonRight">
									<span class="toolPrice">{a.price}</span>
									<button type="button" class="sw" role="switch" aria-checked="false" data-sw={a.key} aria-label={`Switch ${a.name} on or off`}>
										<span class="swKnob"></span>
									</button>
								</span>
							</div>
							<p class="toolNote">{a.note} <span class="offAgain">Off again any month.</span></p>
						</div>
					))}
				</section>

				<div class="soonStrip">
					<span class="soonStripLab">On the way, none of it built, none of it counted:</span>
					{soonTools.map((t, i) => (
						<span class="soonItem">
							<a href={t.href}>{t.name}</a>{i < soonTools.length - 1 ? ',' : ''}
						</span>
					))}
				</div>
			</div>

			<aside class="meter">
				<div class="mBlock">
					<div class="mLab">Credits a month</div>
					<div class="mNum" data-credits>0</div>
					<div class="mEuro" data-euro hidden></div>
					<div class="mNote" data-perUse>Nothing monthly. Nothing at all, in fact.</div>
				</div>
				<div class="mBlock">
					<div class="mLab">Hours a week handed back</div>
					<div class="mNum alt" data-hours>0</div>
					<div class="mNote">Out of about <strong data-weektotal2>17</strong> hours of admin a week.</div>
				</div>
				<div class="mBlock last mCta">
					<p class="mCtaLine" data-ctaline>Everything switched on so far is free. No card.</p>
					<a class="btnP mBtn" href="https://agents.propertylist.es/new_agency/new?locale=en" target="_blank" rel="noopener" data-cta>
						Create your free agency account
					</a>
				</div>
			</aside>
		</div>

		<section class="band">
			<h2>Keep this setup</h2>
			<p class="lead">
				Switch things until it looks like your agency, then take it with you. The link reproduces exactly what
				you built.
			</p>
			<div class="receipt" data-receipt>
				<p class="rTitle">YOUR SETUP</p>
				<div class="rLines" data-rlines></div>
			</div>
			<div class="ctaRow">
				<button type="button" class="btnS" data-share-wa>Share on WhatsApp</button>
				<button type="button" class="btnS" data-share-copy>Copy link</button>
				<a class="btnP" href="https://agents.propertylist.es/new_agency/new?locale=en" target="_blank" rel="noopener" data-cta2>
					Create your free agency account
				</a>
				<a class="btnS" href="/pricing/">See every price</a>
			</div>
		</section>

		<section class="band">
			<h2>Questions</h2>
			<div class="faq">
				{faqs.map((qa) => (
					<details>
						<summary>{qa.q}</summary>
						<p>{qa.a}</p>
					</details>
				))}
			</div>
		</section>

		<button type="button" class="bar" data-bar aria-label="Your running total. Tap to see the full figures.">
			<span class="barC"><strong data-bar-c>0</strong> cr/mo</span>
			<span class="barE" data-bar-e hidden></span>
			<span class="barH"><strong data-bar-h>0</strong> h/wk back</span>
		</button>
	</div>

	<script define:vars={{ allTasks, paidTools }}>
		// All the DOM above is server-rendered. This only toggles classes and
		// writes numbers, so the page is complete and readable with JS off.
		const root = document.querySelector('[data-setup]');
		if (root) {
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const track = (n, d) => { try { if (window.umami && umami.track) umami.track(n, d); } catch (e) {} };

			const state = { lettings: 'no', site: 'no', on: new Set(), touched: false };

			// restore a shared configuration from the URL (legacy ?st= from the
			// slider era is ignored: stages no longer exist, and a stage was
			// never something the visitor chose to pay for)
			try {
				const p = new URLSearchParams(location.search);
				if (p.get('let') === 'y') { state.lettings = 'yes'; state.touched = true; }
				if (p.get('site') === 'y') { state.site = 'yes'; state.touched = true; }
				(p.get('add') || '').split(',').filter(Boolean).forEach((k) => {
					if (paidTools.some((a) => a.key === k)) { state.on.add(k); state.touched = true; }
				});
			} catch (e) {}

			const fmtH = (h) => (h < 0.05 ? '0' : h.toFixed(1).replace(/\.0$/, ''));
			const back = (t) => t.hours - t.after / 60;

			const paidVisible = (a) =>
				a.show === 'always' ||
				(a.show === 'lettings' && state.lettings === 'yes') ||
				(a.show === 'nosite' && state.site === 'no') ||
				(a.show === 'hassite' && state.site === 'yes');

			const taskVisible = (t) =>
				(t.needs !== 'lettings' || state.lettings === 'yes') &&
				(t.needs !== 'nosite' || state.site === 'no');

			const taskFixed = (t) => {
				const [kind, key] = t.fix.split(':');
				if (kind === 'free') return true;
				if (kind === 'addon') return state.on.has(key);
				return false;
			};

			const tween = (el, to, animate) => {
				const from = parseFloat(el.dataset.v || '0') || 0;
				el.dataset.v = String(to);
				// rAF stalls in background tabs, so anything but a live animation
				// writes the final value synchronously
				if (!animate || reduced || document.hidden || Math.abs(to - from) < 0.01) { el.textContent = fmtH(to); return; }
				const t0 = performance.now();
				const stepFn = (now) => {
					const k = Math.min(1, (now - t0) / 300);
					const v = from + (to - from) * (k * (2 - k));
					el.textContent = fmtH(k === 1 ? to : v);
					if (k < 1) requestAnimationFrame(stepFn);
				};
				requestAnimationFrame(stepFn);
			};

			const totals = () => {
				let monthly = 0;
				let hours = 0;
				paidTools.forEach((a) => {
					if (paidVisible(a) && state.on.has(a.key)) monthly += a.monthly;
				});
				allTasks.forEach((t) => {
					if (taskVisible(t) && taskFixed(t)) hours += back(t);
				});
				return { monthly, hours };
			};

			let settleTimer = 0;
			let settledSent = false;
			const payload = () => ({
				lettings: state.lettings,
				site: state.site,
				addons: [...state.on].join(',') || 'none',
				credits: totals().monthly,
			});

			const writeUrl = () => {
				if (!state.touched) return;
				try {
					const p = new URLSearchParams();
					if (state.lettings === 'yes') p.set('let', 'y');
					if (state.site === 'yes') p.set('site', 'y');
					if (state.on.size) p.set('add', [...state.on].join(','));
					const q = p.toString();
					history.replaceState(null, '', q ? '?' + q : location.pathname);
				} catch (e) {}
			};

			const shareUrl = () => location.origin + location.pathname + (location.search || '');

			// the four free strikes animate once on load, so the before/after is
			// felt without any interaction; skipped when motion is reduced or the
			// tab is hidden, where they simply appear struck
			let introDone = false;

			function render(reason) {
				// a switch whose card disappeared (toggle flip) turns off, and a
				// switch that needs another one follows it off
				[...state.on].forEach((k) => {
					const a = paidTools.find((x) => x.key === k);
					if (a && !paidVisible(a)) state.on.delete(k);
				});
				paidTools.forEach((a) => {
					if (a.needs && state.on.has(a.key) && !state.on.has(a.needs)) state.on.delete(a.key);
				});

				root.querySelectorAll('[data-lettings]').forEach((x) => x.classList.toggle('on', x.dataset.lettings === state.lettings));
				root.querySelectorAll('[data-site]').forEach((x) => x.classList.toggle('on', x.dataset.site === state.site));

				root.querySelectorAll('.addon').forEach((el) => {
					const a = paidTools.find((x) => x.key === el.dataset.addon);
					const vis = a && paidVisible(a);
					el.style.display = vis ? '' : 'none';
					const needsOff = a && a.needs && !state.on.has(a.needs);
					el.classList.toggle('locked', Boolean(needsOff));
					const sw = el.querySelector('.sw');
					sw.disabled = Boolean(needsOff);
					sw.setAttribute('aria-checked', state.on.has(el.dataset.addon) ? 'true' : 'false');
					el.classList.toggle('isOn', state.on.has(el.dataset.addon));
				});

				// the week list: strike what a switched-on thing fixes, tag the rest
				let weekTotal = 0;
				const introStrikes = [];
				root.querySelectorAll('[data-week] li').forEach((li) => {
					const t = allTasks.find((x) => x.id === li.dataset.task);
					if (!taskVisible(t)) { li.style.display = 'none'; return; }
					li.style.display = '';
					weekTotal += t.hours;
					const [kind, key] = t.fix.split(':');
					const fixEl = li.querySelector('[data-wfix]');
					if (kind === 'soon') {
						li.classList.add('soonTask');
						fixEl.textContent = key + ' · not built yet';
						return;
					}
					if (kind === 'peruse') {
						li.classList.add('puTask');
						fixEl.textContent = key + ' · pay per use';
						return;
					}
					const fixed = taskFixed(t);
					const doneText = t.after > 0 ? t.hours + 'h → ' + t.after + ' min' : t.hours + 'h → 0';
					if (fixed && kind === 'free' && !introDone && !reduced && !document.hidden) {
						introStrikes.push([li, fixEl, doneText]);
						fixEl.textContent = doneText;
						return;
					}
					li.classList.toggle('done', fixed);
					fixEl.textContent = fixed
						? doneText
						: 'fixed by ' + (paidTools.find((a) => a.key === key) || {}).name;
				});
				if (!introDone) {
					introDone = true;
					if (introStrikes.length) {
						introStrikes.forEach(([li], i) => {
							setTimeout(() => li.classList.add('done'), 250 + i * 180);
						});
					}
				}
				root.querySelectorAll('[data-weektotal], [data-weektotal2]').forEach((el) => {
					el.textContent = String(weekTotal);
				});

				// the two numbers
				const t = totals();
				const anim = Boolean(reason) || !reduced;
				tween(root.querySelector('[data-credits]'), t.monthly, Boolean(reason));
				tween(root.querySelector('[data-hours]'), t.hours, anim);
				const euro = root.querySelector('[data-euro]');
				euro.hidden = t.monthly === 0;
				euro.textContent = '1 credit is about 1€, so about ' + t.monthly + '€ a month.';
				root.querySelector('[data-perUse]').textContent =
					t.monthly === 0 ? 'Nothing monthly. Nothing at all, in fact.' : 'Only what you switched on. Per-use credits stay out of this number.';

				// sticky bar
				root.querySelector('[data-bar-c]').textContent = String(t.monthly);
				root.querySelector('[data-bar-h]').textContent = fmtH(t.hours);
				const barE = root.querySelector('[data-bar-e]');
				barE.hidden = t.monthly === 0;
				barE.textContent = '~' + t.monthly + '€';
				if (reason && !reduced) {
					const bar = root.querySelector('[data-bar]');
					bar.classList.remove('pulse');
					void bar.offsetWidth;
					bar.classList.add('pulse');
				}

				// CTA line follows the money
				root.querySelector('[data-ctaline]').textContent =
					t.monthly > 0
						? 'Everything monthly switches off the month you stop wanting it.'
						: 'Everything switched on so far is free. No card.';

				// the receipt: the free core plus exactly what was flicked
				const lines = [['The free core', 'Free']];
				paidTools.forEach((a) => {
					if (paidVisible(a) && state.on.has(a.key)) lines.push([a.name, a.monthly + ' cr']);
				});
				let html = lines
					.map(([n, p]) => '<p class="rLine"><span>' + n + '</span><span class="rDots"></span><span>' + p + '</span></p>')
					.join('');
				html += '<p class="rLine rTot"><span>Total a month</span><span class="rDots"></span><span>' + t.monthly + ' cr' + (t.monthly > 0 ? ' (~' + t.monthly + '€)' : '') + '</span></p>';
				html += '<p class="rSub">Only when you use it:</p>';
				html += '<p class="rPer">· 1 credit per lead you move into the Buyer pipeline, first 5 free</p>';
				html += '<p class="rPer">· 5 credits per report · 10 credits to feature a listing for 3 days</p>';
				if (t.hours >= 0.05) {
					html += '<p class="rLine rBack"><span>Handed back</span><span class="rDots"></span><span>' + fmtH(t.hours) + ' h a week</span></p>';
				}
				root.querySelector('[data-rlines]').innerHTML = html;

				writeUrl();

				// research: the configuration the viewer settles on, not every flick
				settledSent = false;
				clearTimeout(settleTimer);
				if (state.touched) {
					settleTimer = setTimeout(() => {
						settledSent = true;
						track('setup-settled', payload());
					}, 5000);
				}
			}

			root.querySelectorAll('[data-lettings]').forEach((b) =>
				b.addEventListener('click', () => {
					state.lettings = b.dataset.lettings;
					state.touched = true;
					track('setup-toggle', { which: 'lettings', v: state.lettings });
					render({ type: 'toggle' });
				}),
			);
			root.querySelectorAll('[data-site]').forEach((b) =>
				b.addEventListener('click', () => {
					state.site = b.dataset.site;
					state.touched = true;
					track('setup-toggle', { which: 'site', v: state.site });
					render({ type: 'toggle' });
				}),
			);
			root.querySelectorAll('[data-sw]').forEach((b) =>
				b.addEventListener('click', () => {
					const key = b.dataset.sw;
					const on = !state.on.has(key);
					if (on) state.on.add(key); else state.on.delete(key);
					state.touched = true;
					track('setup-addon', { key, on: on ? 'yes' : 'no' });
					render({ type: 'addon' });
				}),
			);

			// tapping a job scrolls to what fixes it and flashes it. It never
			// flips a switch: it shows you the switch and lets you decide.
			root.querySelectorAll('.wJump').forEach((b) =>
				b.addEventListener('click', () => {
					const [kind, key] = b.dataset.jump.split(':');
					track('setup-pain-jump', { task: b.closest('li').dataset.task });
					let target = null;
					if (kind === 'addon') target = root.querySelector('.addon[data-addon="' + key + '"]');
					if (kind === 'peruse') target = root.querySelector('.perUse');
					if (kind === 'soon') target = root.querySelector('.soonStrip');
					if (target && target.style.display !== 'none') {
						target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
						target.classList.remove('flash');
						void target.offsetWidth;
						target.classList.add('flash');
					}
				}),
			);

			root.querySelector('[data-bar]').addEventListener('click', () => {
				root.querySelector('.meter').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
				track('setup-bar-tap', {});
			});

			root.querySelector('[data-share-wa]').addEventListener('click', () => {
				const t = totals();
				track('setup-share', { via: 'whatsapp', credits: t.monthly });
				const msg =
					t.monthly > 0
						? 'My PropertyList setup: ' + t.monthly + ' credits a month (~' + t.monthly + '€), ' + fmtH(t.hours) + ' hours a week handed back. Built here: ' + shareUrl()
						: 'The free PropertyList core alone hands back ' + fmtH(t.hours) + ' hours a week. See it: ' + shareUrl();
				window.open('https://wa.me/?text=' + encodeURIComponent(msg), '_blank', 'noopener');
			});
			root.querySelector('[data-share-copy]').addEventListener('click', (e) => {
				track('setup-share', { via: 'copy', credits: totals().monthly });
				if (navigator.clipboard) navigator.clipboard.writeText(shareUrl());
				e.target.textContent = 'Copied';
				setTimeout(() => { e.target.textContent = 'Copy link'; }, 1600);
			});
			['[data-cta]', '[data-cta2]'].forEach((sel) =>
				root.querySelector(sel).addEventListener('click', () => track('setup-cta', payload())),
			);
			addEventListener('pagehide', () => {
				if (state.touched && !settledSent) track('setup-settled', payload());
			});

			render(null);
			if (state.touched && state.on.size) {
				root.querySelector('.paid').scrollIntoView({ behavior: 'auto', block: 'center' });
			}
		}
	</script>
</Layout>

