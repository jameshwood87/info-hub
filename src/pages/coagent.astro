<script>
	document.querySelectorAll<HTMLElement>('[data-mtabs]').forEach((bar) => {
		const tabs = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-mtab]'));
		const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-mpanel]'));
		const show = (key: string) => {
			tabs.forEach((t) => {
				const on = t.dataset.mtab === key;
				t.classList.toggle('on', on);
				t.setAttribute('aria-selected', on ? 'true' : 'false');
			});
			panels.forEach((p) => (p.hidden = p.dataset.mpanel !== key));
		};
		// Without JavaScript every panel shows, stacked. With it, one at a time.
		bar.classList.add('ready');
		tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.mtab || '')));
		if (tabs[0]) show(tabs[0].dataset.mtab || '');
	});
</script>

