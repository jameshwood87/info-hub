---
import Layout from '../layouts/Layout.astro';
import AgentInterestCta from '../components/AgentInterestCta.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/coagent/`;
const title = 'PropertyList CoAgent - the CRM you talk to on WhatsApp | PropertyList';
const description =
	'Send a voice note after a viewing and CoAgent writes up the CRM for you to approve. Ask it for properties, a client brief, your next viewing or what a home is worth, or send photos to start a listing, in the WhatsApp you already use. Audio is never stored and nothing is saved until you reply YES.';

const asks = [
	{ q: 'What have we got in Marbella, three beds, up to two million?', a: 'Five listings from the shared MLS with prices and links. No client needed, so it works with someone sitting next to you.' },
	{ q: 'Where is my next viewing?', a: 'Your diary, leading with the address and the client’s phone number, because you are reading it in the car.' },
	{ q: 'What have I got tomorrow?', a: 'The whole day, in order, with the property and who you are meeting.' },
	{ q: 'Tell me about PL22234', a: 'Price, bedrooms, size, location and the link for that one listing, whether it is yours or another agency’s.' },
	{ q: 'What is Marta Ruiz’s number?', a: 'Her phone and email first, so your thumb is already on the call button.' },
	{ q: 'Brief me on the Bergs', a: 'Where they are up to, what they are looking for, and the last thing that happened, before you dial.' },
	{ q: 'What is Nueva Andalucía worth?', a: 'The middle asking price and the range across what is actually on the market there. If we do not hold enough stock in an area, it says so rather than guessing.' },
	{ q: 'Add a note to Marta: she wants to see it again Saturday', a: 'It reads the note back in your own words and saves it to her file when you reply YES.' },
	{ q: 'Is PL22234 still available?', a: 'If the listing belongs to another agency, CoAgent offers to ask them for you. Reply YES and the enquiry goes to them through the MLS, and their answer comes back to you.' },
	{ q: 'Add Maria Lopez 600 111 222 maria@email.com', a: 'Or share her contact card straight from your phone. CoAgent reads the name, number and email back and adds her to your CRM when you reply YES. If she is already there, it links her record instead of making a duplicate.' },
	{ photo: true, q: 'Photos of a new listing', a: 'Send them straight from your camera roll, with a line about the property if you like. CoAgent starts a draft listing, and when you reply DONE it writes the title, description and features from the photos. The draft waits in your CRM for you to check. It is never published by itself.' },
	{ photo: true, q: 'A photo of a Se Vende sign', a: 'CoAgent reads the phone number off the sign, with any name or price on it. Reply YES and the owner is saved as a contact in your CRM with a note of the sign, ready for you to call.' },
	{ photo: true, q: 'A photo of a client’s ID', a: 'Only the name, surnames and date of birth are read, and added as a new contact when you reply YES. The document number is never kept, and neither is the photo.' },
	{ q: 'Which is the best value, PL5001, PL5002 or PL5003?', a: 'It ranks them against comparable homes for sale nearby, with the price per square metre, so you can tell a client which one is keenly priced and which is asking too much. Ask straight after a search and it compares those results.' },
	{ q: 'What is PL22234 worth?', a: 'A value from notary-recorded sales in that town, with a range and a link to the public proof. Or describe the home instead: “a 120 m² apartment in Estepona”. It always tells you what the figure is based on.' },
	{ q: 'REPORT', a: 'After a valuation, reply REPORT for the full Property Intelligence Report, as a link you can send to the seller. Your first one is free. After that it costs credits, and it tells you how many and asks before spending anything.' },
];

const trust = [
	{ name: 'Your voice is not kept', desc: 'The audio is transcribed and thrown away. Only the text survives, on the record it belongs to, where you can read it and correct it. There is no recording to leak and none to hand over.' },
	{ name: 'Nothing is saved until you say so', desc: 'CoAgent lays out what it wants to change, then waits. No client record is edited and no enquiry leaves for another agency until you reply YES. Say nothing and nothing happens.' },
	{ name: 'It answers from your data or not at all', desc: 'Every answer comes from your CRM and the shared MLS. Ask it something outside that and it says so plainly, instead of inventing a fact you might repeat to a client.' },
];

const soon = [
	{ name: 'Your own WhatsApp, connected', desc: 'Keep messaging clients from your own number and have those conversations file themselves, in both directions, with anyone who is not a client never captured. In design now.' },
	{ name: 'A dedicated work line', desc: 'A business number that lives in the PropertyList app beside your personal SIM, with calls written up the same way a voice note is. On the roadmap.' },
	{ name: 'The brief on your caller screen', desc: 'Today you can ask for a client brief any time. Having it appear by itself as the phone rings needs work inside the mobile app, and that is the next piece we build.' },
];

const plans = [
	{ name: 'September: free for everyone', desc: 'Every agent, every message, no limit, while we launch.' },
	{ name: 'The first 10 agents: free until 1 January', desc: 'The first ten agents to message CoAgent keep it free and unlimited for three more months, until 1 January.' },
	{ name: 'From October: 5 a day free, or unlimited', desc: 'Every agent gets 5 free messages a day, and approving with YES never counts. For more, unlimited CoAgent is 50 credits a month per agent, turned on from the Billing page or by replying SUBSCRIBE.' },
];

const faqs = [
	{ q: 'What do I have to install?', a: 'Nothing. CoAgent works in WhatsApp, which you already use all day. Save the PropertyList number, make sure your mobile is on your CRM profile so it knows you are an agent rather than a client, and send it a voice note.' },
	{ q: 'Will it change my CRM automatically?', a: 'No. CoAgent proposes and waits. It shows you the client it matched and the changes it wants to make, field by field, and nothing is written until you reply YES. If it mishears, it costs you one word, not a wrong budget sitting quietly in a shared record.' },
	{ q: 'Are my voice notes recorded?', a: 'No. The audio is transcribed and discarded. The transcript is kept on the client record, where you can read exactly what the CRM was told.' },
	{ q: 'Does it work in Spanish?', a: 'Yes, and in German, French, Portuguese, Bulgarian and Greek. It replies in your own language and it copes with a note that switches language halfway through, which on this coast is most of them.' },
	{ q: 'Do I need to name a client every time?', a: 'No. Naming a client turns a voice note into CRM updates. Without one you can still ask for properties, your diary, a listing by reference or what an area is worth, which is what you want when a walk-in is standing next to you.' },
	{ q: 'Can it talk to other agencies for me?', a: 'Yes. Ask whether a listing from another agency is still available and CoAgent offers to send the enquiry. Reply YES and it goes through the MLS the same way one sent from the CRM screen does, so it lands in their normal workflow.' },
	{ q: 'What if CoAgent does not know my number?', a: 'It replies, in Spanish and English, with a link to create your free account and a link to the Staff page of your CRM, where you add your mobile to your profile. Put the country code in front if your number is not Spanish, then write to it again.' },
	{ q: 'What does it cost?', a: 'CoAgent is free for everyone in September. The first 10 agents to message it keep it free and unlimited until 1 January. From October every agent gets 5 free messages a day, and approving with YES never counts toward them; unlimited is 50 credits a month per agent, paid from your PropertyList credits, and you can stop it renewing any time. The MLS and the CRM core stay free, and creating your account costs nothing.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Features', item: `${origin}/features/` },
		{ '@type': 'ListItem', position: 3, name: 'CoAgent', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList CoAgent',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android', url: canonical,
	description: 'An assistant for estate agents that works over WhatsApp: voice notes become CRM updates the agent approves, and questions about clients, listings, the diary and area prices are answered from the agency CRM and the shared MLS. Audio is never stored.',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};

const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=en';
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	hideSearch
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/coagent/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="heroInner heroGrid">
			<div>
				<div class="kicker">CoAgent</div>
				<h1>Talk to your CRM the way you talk to a colleague.</h1>
				<p class="heroSub">Walk out of the viewing. Send a voice note. The write-up is waiting for you to approve.</p>
				<div class="whatIs">
					<div class="whatIsTitle">How it goes</div>
					<ol>
						<li>You finish a call or a viewing and send a voice note, in the WhatsApp you already use.</li>
						<li>CoAgent works out what changed, and shows you before it touches anything.</li>
						<li>You reply YES. The requirement, the note and the reminders are in the CRM.</li>
						<li>While you are there, ask it for properties, a phone number or your next appointment.</li>
					</ol>
				</div>
				<p class="lead">
					The admin that eats your evenings writes itself. The promise you made last Tuesday becomes a reminder. And when a
					client is standing next to you asking what is available in Marbella at two million, you ask out loud and the
					answer comes back into the thread.
				</p>
				<div class="winRow" aria-label="What CoAgent gives back">
					<div class="win"><b>Evenings back</b><span>The after-viewing write-up does itself.</span></div>
					<div class="win"><b>Promises kept</b><span>What you said you would do becomes a reminder.</span></div>
					<div class="win"><b>Answers in the car</b><span>Diary, listings and numbers without opening a laptop.</span></div>
				</div>
				<div class="ctaRow">
					<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Create your free account</a>
					<a class="btnSecondary" href="#ask">See what you can ask it</a>
				</div>
				<div class="note">Live for PropertyList agents. Nothing to install.</div>
			</div>

			<div class="bfWrap" aria-hidden="true">
				<div class="bfTag">After the viewing</div>
				<div class="bfCard">
					<div class="bfHead">
						<span class="bfAvatar">MR</span>
						<span>
							<b>Marta Ruiz</b>
							<i>Buyer &middot; matched from your note</i>
						</span>
						<span class="bfRing"></span>
					</div>
					<div class="bfReq">Budget &euro;800k &rarr; <b>&euro;850k</b> &middot; + Nueva Andaluc&iacute;a &middot; 3 beds</div>
					<div class="bfMeta">Reminder: send the Cerquilla listing &middot; Saturday</div>
					<div class="bfWarn">Reply YES to save it all. Nothing is written yet.</div>
					<div class="bfFoot">Transcribed, then the audio is discarded</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="how">
		<div class="sectionHead">
			<h2>The bit nobody does: writing it up</h2>
			<p>Everyone knows a CRM only pays you back if it is current, and everyone knows what actually happens between viewings. CoAgent takes the note where you already are, in the format you already use, and does the typing.</p>
		</div>
		<div class="grid3 steps">
			<div class="card step">
				<div class="stepTime">Step 1</div>
				<h3>Send the voice note</h3>
				<p>"Just saw the Nueva Andaluc&iacute;a apartment with Marta. She is open to three beds now, up to eight fifty, and I said I would send her the Cerquilla one on Saturday."</p>
			</div>
			<div class="card step">
				<div class="stepTime">Step 2</div>
				<h3>Read what it heard</h3>
				<p>Back comes the client it matched, the changes it proposes to her requirements, the reminder it will set for Saturday, and the listings that now match her.</p>
			</div>
			<div class="card step">
				<div class="stepTime">Step 3</div>
				<h3>Reply YES</h3>
				<p>Only then does anything move. The requirement is updated, the note lands on her timeline, Saturday is on your calendar. Say nothing and nothing happens.</p>
			</div>
		</div>
	</section>

	<section class="section" id="ask">
		<div class="sectionHead">
			<h2>Everything else you can ask it</h2>
			<p>By voice or by typing, in your own words. CoAgent works out what you meant rather than making you learn commands, and when a question is outside what it holds it tells you so.</p>
		</div>
		<div class="grid2">
			{
				asks.map((item) => (
					<div class="card">
						{item.photo && <div class="stepTime">Send a photo</div>}
						<h3>{item.photo ? item.q : `“${item.q}”`}</h3>
						<p>{item.a}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Your privacy: what is kept and what is not</h2>
			<p>An assistant that hears your conversations has to earn its place. These are design decisions, not settings you have to find.</p>
		</div>
		<div class="grid3">
			{
				trust.map((t) => (
					<div class="card accent">
						<h3>{t.name}</h3>
						<p>{t.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="grid2">
			<div class="card accent">
				<h2>It speaks this coast</h2>
				<p>
					Clients here switch between English and Spanish mid-sentence, and so do agents. CoAgent understands a note that
					changes language halfway through, and replies in yours: English, Spanish, German, French, Portuguese, Bulgarian or
					Greek. The names, the budgets and the areas still land in the right fields.
				</p>
			</div>
			<div class="card">
				<h2>No new app to learn</h2>
				<p>
					CoAgent is not another app to adopt. It lives in WhatsApp, and behind it sits the platform where 1,300+ agents and
					970+ agencies already work, matching against 4,400+ shared listings the moment a client tells you what they want.
				</p>
			</div>
		</div>
	</section>

	<section class="section" id="pricing">
		<div class="sectionHead">
			<h2>What it costs</h2>
			<p>No contract. Unlimited is paid in credits, from the same wallet as everything else on PropertyList, and you can stop it renewing any time.</p>
		</div>
		<div class="grid3">
			{
				plans.map((p) => (
					<div class="card">
						<h3>{p.name}</h3>
						<p>{p.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section" id="next">
		<div class="sectionHead">
			<h2>What we are building next</h2>
			<p>Everything above works today. These do not yet, and we would rather say so here than let you find out later.</p>
		</div>
		<div class="grid3">
			{
				soon.map((s) => (
					<div class="card">
						<h3>{s.name}</h3>
						<p>{s.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="sectionHead"><h2>Questions, answered</h2></div>
		<div class="faq">
			{
				faqs.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<section class="cta">
		<div class="ctaInner">
			<h2>It remembers every promise you made.</h2>
			<p>Your memory is excellent. Until Thursday. Every agent carries fifty open promises, and the one that slips is always the one that mattered. Create your free account and start talking to it, inside the free <a href="/features/">PropertyList platform</a>.</p>
			<div class="ctaRow">
				<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Create your free account</a>
			</div>
		</div>
	</section>

	<style>
		:global(:root) {
			--pl-accent: #00ae9a;
			--pl-accent-rgb: 0, 174, 154;
			--pl-ink: #0a6d61;
		}
		h1, h2, h3 { letter-spacing: -0.03em; }
		.hero { border-radius: 22px; padding: 16px; margin: 0 0 14px; border: 1px solid rgba(16, 24, 40, 0.08);
			background: radial-gradient(1200px 600px at 20% -10%, rgba(var(--pl-accent-rgb), 0.22), rgba(255, 255, 255, 0)), radial-gradient(900px 500px at 90% 10%, rgba(var(--pl-accent-rgb), 0.12), rgba(255, 255, 255, 0)); }
		.heroInner { background: rgba(255, 255, 255, 0.8); border: 1px solid rgba(16, 24, 40, 0.06); border-radius: 18px; padding: 22px; }
		.heroGrid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 24px; align-items: center; }
		.kicker { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(var(--pl-accent-rgb), 0.12); border: 1px solid rgba(var(--pl-accent-rgb), 0.22); color: var(--pl-ink); font-weight: 900; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
		h1 { margin: 14px 0 12px; line-height: 1.06; font-size: clamp(28px, 4.4vw, 42px); }
		.lead { margin: 0 0 16px; color: rgba(16, 24, 40, 0.75); max-width: 60ch; line-height: 1.62; }
		.note { color: rgba(16, 24, 40, 0.6); font-weight: 700; font-size: 12.5px; margin-top: 12px; }
		.whatIs { border: 1px solid rgba(0,174,154,0.28); background: rgba(0,174,154,0.06); border-radius: 14px; padding: 14px 16px; margin: 0 0 16px; }
		.whatIsTitle { font-size: 12px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: rgba(11,18,32,.55); margin-bottom: 8px; }
		.whatIs ol { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
		.whatIs li { color: rgba(16,24,40,.82); line-height: 1.5; font-size: 15.5px; }
		.heroSub { margin: -4px 0 12px; font-size: 17px; font-weight: 700; color: rgba(11,18,32,.6); letter-spacing: -.01em; }
		.winRow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0 0 16px; }
		.win { background: rgba(255, 255, 255, 0.75); border: 1px solid rgba(var(--pl-accent-rgb), 0.25); border-radius: 12px; padding: 10px 12px; }
		.win b { display: block; font-size: 13px; color: var(--pl-ink); }
		.win span { display: block; font-size: 12px; color: rgba(16, 24, 40, 0.65); line-height: 1.45; margin-top: 2px; }
		@media (max-width: 560px) { .winRow { grid-template-columns: minmax(0, 1fr); } }
		.ctaRow { display: flex; gap: 12px; flex-wrap: wrap; }
		.btnPrimary, .btnSecondary { display: inline-flex; align-items: center; justify-content: center; padding: 14px 22px; border-radius: 14px; text-decoration: none; font-weight: 900; font-size: 15px; }
		.btnPrimary { background: var(--pl-ink); color: #fff; border: 1px solid var(--pl-ink); }
		.btnPrimary:hover { background: #086055; }
		.btnSecondary { background: rgba(16, 24, 40, 0.05); border: 1px solid rgba(16, 24, 40, 0.12); color: var(--pl-ink); }
		.btnSecondary:hover { background: rgba(16, 24, 40, 0.08); }

		.bfWrap { position: relative; padding: 18px 6px 6px; }
		.bfTag { position: absolute; top: 0; left: 18px; z-index: 2; background: var(--pl-ink); color: #fff; border-radius: 999px; padding: 5px 12px; font-size: 11px; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; }
		.bfCard { background: #fff; border: 1px solid rgba(16, 24, 40, 0.1); border-radius: 16px; padding: 18px 16px 14px; box-shadow: 0 14px 36px rgba(16, 24, 40, 0.12); }
		.bfHead { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; position: relative; }
		.bfAvatar { width: 42px; height: 42px; border-radius: 50%; background: rgba(var(--pl-accent-rgb), 0.14); color: var(--pl-ink); display: inline-flex; align-items: center; justify-content: center; font-weight: 900; font-size: 14px; flex: none; }
		.bfHead b { display: block; font-size: 15.5px; color: #101828; }
		.bfHead i { display: block; font-style: normal; font-size: 12px; color: rgba(16, 24, 40, 0.55); }
		.bfRing { position: absolute; right: 2px; top: 50%; transform: translateY(-50%); width: 10px; height: 10px; border-radius: 50%; background: #16a34a; box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.18); }
		.bfReq { font-size: 13.5px; font-weight: 700; color: #101828; margin-bottom: 4px; line-height: 1.5; }
		.bfMeta { font-size: 12px; color: rgba(16, 24, 40, 0.55); margin-bottom: 10px; }
		.bfWarn { background: #fef6e7; border: 1px solid #f5d9a8; color: #8a5a10; border-radius: 10px; padding: 9px 11px; font-size: 12.5px; font-weight: 700; line-height: 1.45; margin-bottom: 10px; }
		.bfFoot { font-size: 11.5px; color: rgba(16, 24, 40, 0.5); text-align: center; border-top: 1px solid rgba(16, 24, 40, 0.07); padding-top: 9px; }

		.way { display: flex; flex-direction: column; }
		.wayNum { width: 30px; height: 30px; border-radius: 50%; background: var(--pl-ink); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 900; margin-bottom: 10px; }
		.wayFor { font-size: 12.5px; font-weight: 700; color: var(--pl-ink); margin-top: 10px; }
		.way p { margin-top: 10px; }
		.gBox { background: #f7f9f9; border: 1px solid rgba(16, 24, 40, 0.08); border-radius: 12px; padding: 10px; margin-top: 4px; }
		.waRow { display: flex; align-items: center; gap: 8px; border-radius: 10px; padding: 8px 10px; font-size: 12px; }
		.waRow.me { background: #dcf8c6; justify-content: flex-end; margin-bottom: 6px; }
		.waMic { color: var(--pl-ink); font-size: 10px; }
		.waBars { display: inline-flex; align-items: center; gap: 2px; }
		.waBars i { width: 3px; border-radius: 2px; background: rgba(16, 24, 40, 0.45); display: inline-block; }
		.waBars i:nth-child(odd) { height: 12px; }
		.waBars i:nth-child(even) { height: 7px; }
		.waBars i:nth-child(3), .waBars i:nth-child(6) { height: 15px; }
		.waTime { font-size: 11px; color: rgba(16, 24, 40, 0.55); }
		.waRow.bot { background: #fff; border: 1px solid rgba(var(--pl-accent-rgb), 0.3); display: block; }
		.waRow.bot b { display: block; font-size: 12.5px; color: var(--pl-ink); }
		.waRow.bot i { display: block; font-style: normal; font-size: 11.5px; color: rgba(16, 24, 40, 0.6); margin-top: 2px; }
		.syncRow { display: flex; align-items: center; gap: 8px; font-size: 12px; padding: 6px 8px; border-radius: 8px; background: #fff; border: 1px solid rgba(16, 24, 40, 0.07); margin-bottom: 5px; color: rgba(16, 24, 40, 0.8); }
		.syncRow:last-child { margin-bottom: 0; }
		.syncDot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
		.syncRow.ok .syncDot { background: #16a34a; }
		.syncRow.no { color: rgba(16, 24, 40, 0.45); }
		.syncRow.no .syncDot { background: rgba(16, 24, 40, 0.25); }
		.simRow { background: #fff; border: 1px solid rgba(16, 24, 40, 0.08); border-radius: 8px; padding: 7px 9px; margin-bottom: 5px; font-size: 12px; }
