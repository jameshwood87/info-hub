---
import Layout from '../layouts/Layout.astro';
import AgentInterestCta from '../components/AgentInterestCta.astro';
import CoagentPhone from '../components/CoagentPhone.astro';
import { getPortalStats, statPlus } from '../lib/portalStats';
import { COAGENT_NUMBER, coagentWaLink, CRM_STAFF_URL } from '../data/coagent';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/coagent/`;
const title = 'PropertyList CoAgent - the CRM you talk to on WhatsApp | PropertyList';
const description =
	'CoAgent is your CRM on WhatsApp. Send a voice note after a viewing and it writes the update for you to approve. Your voice is never kept, and nothing is saved until you reply YES.';

const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'en');
const plAgencies = statPlus(__ps.agencies, 'en');
const plListings = statPlus(__ps.listings, 'en');

const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=en';
const WA = coagentWaLink('Hi');
// A reminder for 9am Madrid time (07:00 UTC) on launch day, until the number exists.
const CAL = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent('Message PropertyList CoAgent')}&dates=20260915T070000Z/20260915T071500Z&details=${encodeURIComponent('The CoAgent number is on https://info.propertylist.es/coagent/?utm_source=calendar&utm_medium=reminder&utm_campaign=coagent-launch from 9am. Before you message it, be signed up with your WhatsApp number on your user. 20 free messages a month for every agent.')}`;

// Everything CoAgent does today, as the question an agent would actually send.
// Tap a question to see what comes back. Answers are the verified descriptions.
const moments = [
	{
		label: 'In the car',
		asks: [
			{ q: 'Where is my next viewing?', a: 'Your diary, leading with the address and the client’s phone number, because you are reading it in the car.' },
			{ q: 'What have I got tomorrow?', a: 'The whole day, in order, with the property and who you are meeting.' },
			{ q: 'What is Marta Ruiz’s number?', a: 'Her phone and email first, so your thumb is already on the call button.' },
			{ q: 'Brief me on the Bergs', a: 'Where they are up to, what they are looking for, and the last thing that happened, before you dial.' },
		],
	},
	{
		label: 'With a client beside you',
		asks: [
			{ q: 'What have we got in Marbella, three beds, up to two million?', a: 'Five listings from the shared MLS with prices and links. No client needed, so it works with someone sitting next to you.' },
			{ q: 'Tell me about PL99999', a: 'Price, bedrooms, size, location and the link for that one listing, whether it is yours or another agency’s.' },
			{ q: 'Which is the best value, PL5001, PL5002 or PL5003?', a: 'It ranks them against comparable homes for sale nearby, with the price per square metre, so you can tell a client which one is keenly priced and which is asking too much. Ask straight after a search and it compares those results.' },
			{ q: 'How many apartments are for sale in San Pedro?', a: 'The real number on the market there, the best matches, and a link to the full list in your CRM.' },
			{ q: 'Is PL99999 still available?', a: 'If the listing belongs to another agency, CoAgent offers to ask them for you. Reply YES and the enquiry goes to them through the MLS, and their answer comes back to you.' },
		],
	},
	{
		label: 'After the viewing',
		asks: [
			{ q: 'Add a note to Marta: she wants to see it again Saturday', a: 'It reads the note back in your own words and saves it to her file when you reply YES.' },
			{ q: 'Marta has made an offer', a: 'CoAgent moves her card to the right stage on your pipeline when you reply YES, the same as dragging it in the CRM. Marking a client won or lost stays in the CRM, where it asks for the details.' },
			{ q: 'Add Maria Lopez 6XX XXX XXX maria@example.com', a: 'Or share her contact card straight from your phone. CoAgent reads the name, number and email back and adds her to your CRM when you reply YES. If she is already there, it links her record instead of making a duplicate.' },
			{ photo: true, q: 'A photo of a client’s ID', a: 'Only the name, surnames and date of birth are read, and added as a new contact when you reply YES. The document number is never kept, and neither is the photo.' },
		],
	},
	{
		label: 'Winning the listing',
		asks: [
			{ q: 'Let’s list a property', a: 'CoAgent tells you what to send: the photos, then the price, where it is and the bedrooms, in your own words. No commands to learn.' },
			{ photo: true, q: 'Photos of a new listing', a: 'Send them straight from your camera roll, then tell CoAgent about the property, typed or as a voice note. It asks for anything missing, like the price, reads the listing back, and on YES writes the title, description and features. Reply PUBLISH and it goes to review, as it would from the CRM. Nothing goes live without that.' },
			{ photo: true, q: 'A photo of a Se Vende sign', a: 'CoAgent reads the phone number off the sign, with any name or price on it. Reply YES and the owner is saved as a contact in your CRM with a note of the sign and a follow-up to call them.' },
			{ q: 'What is Nueva Andalucía worth?', a: 'The middle asking price and the range across what is actually on the market there. If we do not hold enough stock in an area, it says so rather than guessing.' },
			{ q: 'What is PL99999 worth?', a: 'A market price estimate from notary-recorded sales in that town, with a range and a link to the public proof. Or describe the home instead: “a 120 m² apartment in Estepona”. It always tells you what the figure is based on.' },
			{ q: 'REPORT', a: 'After a market price estimate, reply REPORT for the full Property Intelligence Report, as a link you can send to the seller. Your first one is free. After that it costs credits, and it tells you how many and asks before spending anything.' },
			{ q: 'BROCHURE PL99999', a: 'A brochure of the listing with your own branding: a page your client can open, with today’s price and a way to enquire, plus the PDF. Brochures are free.' },
		],
	},
	{
		label: 'New leads',
		asks: [
			{ q: 'What are my latest leads?', a: 'Your five newest, with who enquired, about which listing and when: your own, or the whole agency’s if you are an admin, as in the CRM. Reply REPLY to answer the newest by email.' },
			{ q: 'REPLY', a: 'CoAgent writes an email to your latest lead in their own language, from what they asked. Reply YES and it goes out from you through the CRM, and their answer comes back to your email. Or just answer the new-lead alert.' },
		],
	},
];

const faqs = [
	{ q: 'What do I have to install?', a: 'Nothing. CoAgent works in WhatsApp, which you already use all day. Save the PropertyList number, make sure your mobile is on your CRM profile so it knows you are an agent rather than a client, and send it a voice note.' },
	{ q: 'Will it change my CRM automatically?', a: 'No. CoAgent proposes and waits. It shows you the client it matched and the changes it wants to make, field by field, and nothing is written until you reply YES. If it mishears, it costs you one word, not a wrong budget sitting quietly in a shared record.' },
	{ q: 'Are my voice notes recorded?', a: 'No. The audio is transcribed and discarded. The transcript is kept on the client record, where you can read exactly what the CRM was told.' },
	{ q: 'Does it work in Spanish?', a: 'Yes, and in German, French, Portuguese, Bulgarian and Greek. It replies in your own language and it copes with a note that switches language halfway through, which on this coast is most of them.' },
	{ q: 'Do I need to name a client every time?', a: 'No. Naming a client turns a voice note into CRM updates. Without one you can still ask for properties, your diary, a listing by reference or what an area is worth, which is what you want when a walk-in is standing next to you.' },
	{ q: 'Can it talk to other agencies for me?', a: 'Yes. Ask whether a listing from another agency is still available and CoAgent offers to send the enquiry. Reply YES and it goes through the MLS the same way one sent from the CRM screen does, so it lands in their normal workflow.' },
	{ q: 'What if CoAgent does not know my number?', a: 'It replies, in Spanish and English, with a link to create your free account and a link to the Staff page of your CRM, where you add your mobile to your profile. Put the country code in front if your number is not Spanish, then write to it again.' },
	{ q: 'What costs credits?', a: 'Messages are covered by your plan, and brochures are free. The market report after your first free one is paid in PropertyList credits, at the same price as in the CRM. CoAgent always tells you the price and waits for your YES before it spends anything.' },
	{ q: 'What does it cost?', a: 'Every agent gets 20 free messages a month, and approving with YES never counts toward them. The first 10 agents to message it have it free and unlimited until 1 November 2026; those places have gone. Unlimited is 50 credits a month per agent, paid from your PropertyList credits, and you can stop it renewing any time. If you have more than 3 agents to add, talk to us about a package. The MLS and the CRM core stay free, and creating your account costs nothing.' },
	{ q: 'What is not live yet?', a: 'Connecting your own WhatsApp number so client chats file themselves, a dedicated work line inside the PropertyList app, and the client brief appearing by itself on your caller screen. Everything else on this page works today.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Features', item: `${origin}/features/` },
		{ '@type': 'ListItem', position: 3, name: 'CoAgent', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList CoAgent',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android', url: canonical,
	description: 'An assistant for estate agents that works over WhatsApp: voice notes become CRM updates the agent approves, and questions about clients, listings, the diary and area prices are answered from the agency CRM and the shared MLS. Audio is never stored.',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	ogImage="https://info.propertylist.es/og/og-coagent-v3.jpg"
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/coagent/` },
		{ hreflang: 'de', href: `${origin}/de/coagent/` },
		{ hreflang: 'fr', href: `${origin}/fr/coagent/` },
		{ hreflang: 'sv', href: `${origin}/sv/coagent/` },
		{ hreflang: 'ru', href: `${origin}/ru/coagent/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="cx heroGrid">
			<div>
				<div class="eyebrow"><span class="dot"></span> CoAgent &middot; your CRM on WhatsApp</div>
				<h1>Stop typing up your CRM.<br /><span>Just talk to it.</span></h1>
				<p class="heroLead">
					Send a voice note after the viewing. Reply YES. <strong>The admin is done, and your evening is yours.</strong>
				</p>
				<div class="ctaRow">
					{WA ? (
						<a class="btnPrimary" href={WA} target="_blank" rel="noopener">Message CoAgent on WhatsApp</a>
					) : (
						<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Create your free account</a>
					)}
					<a class="btnGhost" href="#how">See how it works</a>
				</div>
				<p class="micro">20 free messages a month for every agent &middot; Nothing to install &middot; Your voice is never kept</p>
				{WA && <p class="member"><b>WhatsApp: <a href={WA} target="_blank" rel="noopener">{COAGENT_NUMBER}</a></b></p>}
				{WA ? (
					<p class="member">Already on PropertyList? <a href={CRM_STAFF_URL} target="_blank" rel="noopener">Add your WhatsApp number to your user</a> so CoAgent knows it is you.</p>
				) : (
					<p class="member">
						<b>The number is available from 9am on Tuesday 15 September.</b> Before you message it, make sure you are
						<a href={SIGNUP} target="_blank" rel="noopener">signed up</a> and your
						<a href={CRM_STAFF_URL} target="_blank" rel="noopener">WhatsApp number is added to your user</a>.
						<a class="calBtn" href={CAL} target="_blank" rel="noopener" style="display:table;margin-top:10px;padding:8px 14px;border-radius:10px;background:#0b1220;color:#fff;text-decoration:none;font-weight:800">Remind me at 9am Tuesday</a>
					</p>
				)}
			</div>
			<CoagentPhone lang="en" />
		</div>
	</section>

	<div class="strip">
		<div class="cx stripInner">
			<span>Behind it: <b>{plAgencies}</b> agencies</span>
			<span><b>{plAgents}</b> agents</span>
			<span><b>{plListings}</b> live listings</span>
			<span>Replies in <b>7</b> languages</span>
		</div>
	</div>

	<section class="band dark">
		<div class="cx">
			<div class="head center">
				<h2>Two ways tonight can go.</h2>
				<p>Nobody forgets on purpose. The day just moves faster than the admin.</p>
			</div>
			<div class="versus">
				<div class="vCol without">
					<div class="vHead">Without CoAgent</div>
					<ol>
						<li><b>18:40</b><span>Last viewing. Three promises, all in your head.</span></li>
						<li><b>21:30</b><span>Laptop open, typing up the day from memory.</span></li>
						<li><b>Thursday</b><span>“Did you ever send me that listing?”</span></li>
					</ol>
				</div>
				<div class="vCol with">
					<div class="vHead">With CoAgent</div>
					<ol>
						<li><b>18:41</b><span>A voice note from the car park.</span></li>
						<li><b>18:42</b><span>You reply YES. Note, requirement and reminder saved.</span></li>
						<li><b>21:30</b><span>You are not at the laptop.</span></li>
					</ol>
				</div>
			</div>
			<p class="punch">Your memory is excellent. <span>Until Thursday.</span></p>
		</div>
	</section>

	<section class="band soft" id="how">
		<div class="cx">
			<div class="head center">
				<div class="label">How it works</div>
				<h2>Talk. Check. Say YES.</h2>
			</div>
			<div class="grid3">
				<div class="demo">
					<span class="num">1</span>
					<h3>Talk</h3>
					<p>Like you would to a colleague.</p>
					<div class="mini">
						<div class="mb me">“Marta liked it. Open to three beds now, up to eight fifty. I said I’d send her the Cerquilla one Saturday.”</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">2</span>
					<h3>Check</h3>
					<p>See exactly what it heard.</p>
					<div class="mini">
						<div class="mb">
							<b>Marta Ruiz · buyer</b>
							<span class="kv"><i>Budget</i><em>€850k</em></span>
							<span class="kv"><i>Bedrooms</i><em>3</em></span>
							<span class="kv"><i>Reminder</i><em>Cerquilla, Saturday</em></span>
						</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">3</span>
					<h3>Say YES</h3>
					<p>Only then does anything change.</p>
					<div class="mini">
						<div class="mb">Reply <b>YES</b> to save it.</div>
						<div class="mb me short">YES</div>
						<div class="mb done">Saved. Saturday is in your calendar.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band" id="ask">
		<div class="cx">
			<div class="head center">
				<div class="label">What you can ask</div>
				<h2>Ask it like you would ask a colleague.</h2>
				<p>Tap any message to see what comes back.</p>
			</div>
			<div class="moments">
				{moments.map((m) => (
					<div class="moment">
						<div class="momentLabel">{m.label}</div>
						<div class="chips">
							{m.asks.map((item) => (
								<details class="chip">
									<summary>
										{item.photo && <span class="tag">Photo</span>}
										{item.photo ? item.q : `“${item.q}”`}
									</summary>
									<p>{item.a}</p>
								</details>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="band soft" id="matching">
		<div class="cx">
			<div class="matchBox">
				<div class="matchCopy">
					<div class="label">Built on the shared MLS</div>
					<h2>Don’t just remember the client. <span>Find their next home.</span></h2>
					<p>It searches the stock of {plAgencies} agencies, not only yours. If the right home is another agency’s, it asks them for you.</p>
					<ul class="checks">
						<li>The whole shared MLS, not just your listings</li>
						<li>Best value ranked on price per m²</li>
						<li>Market price estimates from notary-recorded sales, with the proof</li>
					</ul>
				</div>
				<div class="matchVisual" aria-hidden="true">
					<div class="resCard">
						<div class="resHead">
							<span>From the shared MLS</span>
							<em>3 beds &middot; Nueva Andalucía &middot; up to €850k</em>
						</div>
						<div class="res">
							<span class="resPh a"></span>
							<span class="resTxt"><b>PL5001 &middot; Apartment</b><i>3 beds &middot; Nueva Andalucía</i></span>
							<span class="resP">€845,000<small class="own">Your listing</small></span>
						</div>
						<div class="res">
							<span class="resPh b"></span>
							<span class="resTxt"><b>PL5002 &middot; Penthouse</b><i>3 beds &middot; Nueva Andalucía</i></span>
							<span class="resP">€830,000<small>Another agency</small></span>
						</div>
						<div class="res">
							<span class="resPh c"></span>
							<span class="resTxt"><b>PL5003 &middot; Townhouse</b><i>3 beds &middot; Aloha</i></span>
							<span class="resP">€799,000<small>Another agency</small></span>
						</div>
						<div class="resAsk">PL5002 belongs to another agency. Reply <b>YES</b> and I will ask if it is still available.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="cx">
			<div class="head center">
				<div class="label">Three promises</div>
				<h2>Don’t work for your CRM. <span>Let the CRM work for you.</span></h2>
			</div>
			<div class="grid3">
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-3.1A7 7 0 0 0 19 11z" /></svg>
					</span>
					<h3>Your voice is never kept</h3>
					<p>Transcribed, then thrown away. Only the text stays, on the client record.</p>
				</div>
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M9.5 16.2 5.3 12l-1.4 1.4 5.6 5.6L21 7.5l-1.4-1.4z" /></svg>
					</span>
					<h3>Nothing saved until YES</h3>
					<p>Say nothing and nothing happens. No record edited, no enquiry sent.</p>
				</div>
				<div class="tCard">
					<span class="tIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3z" /></svg>
					</span>
					<h3>No made-up answers</h3>
					<p>Everything comes from your CRM and the shared MLS. If it does not know, it says so.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="band soft" id="pricing">
		<div class="cx">
			<div class="head center">
				<div class="label">What it costs</div>
				<h2>Start free. Pay only for unlimited.</h2>
			</div>
			<div class="plans">
				<div class="plan">
					<div class="planWhen">Every agent</div>
					<div class="planPrice">20 a month</div>
					<div class="planDesc">free messages a month, every month. Replying YES never counts.</div>
				</div>
				<div class="plan featured">
					<div class="planBadge">Start here</div>
					<div class="planWhen">Try it on WhatsApp</div>
					<div class="planPrice">Say hi</div>
					<div class="planDesc">Nothing to install. Just say hi on WhatsApp. Tell us where it gets in the way, and it changes.</div>
					{WA ? (
						<a class="btnPrimary full" href={WA} target="_blank" rel="noopener">Message CoAgent now</a>
					) : (
						<div class="planSoon">Available from <b>9am, Tuesday 15 September</b>. Be <a href={SIGNUP} target="_blank" rel="noopener">signed up</a> with your <a href={CRM_STAFF_URL} target="_blank" rel="noopener">WhatsApp number on your user</a> first. <a href={CAL} target="_blank" rel="noopener">Remind me at 9am Tuesday</a></div>
					)}
				</div>
				<div class="plan">
					<div class="planWhen">Unlimited</div>
					<div class="planPrice">50 credits</div>
					<div class="planDesc">a month per agent. No contract, stop any time. More than 3 agents? Ask about a package.</div>
				</div>
			</div>
			<p class="fine">Brochures are free. The market report after your first free one costs credits, as in the CRM. It always asks first.</p>
		</div>
	</section>

	<section class="band">
		<div class="cx narrow">
			<div class="head center">
				<h2>Questions</h2>
			</div>
			<div class="faq">
				{faqs.map((f) => (
					<details>
						<summary data-track="coagent-faq-click" data-track-label={f.q}>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="band dark final">
		<div class="cx narrow center">
			<h2>It remembers every promise <span>you made.</span></h2>
			<p>Give it your next viewing. Feel what it is like to close the laptop early.</p>
			<div class="ctaRow center">
				{WA ? (
					<a class="btnPrimary" href={WA} target="_blank" rel="noopener">Message CoAgent on WhatsApp</a>
				) : (
					<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Create your free account</a>
				)}
			</div>
			<p class="micro light">
				{COAGENT_NUMBER ? (
					<><b>WhatsApp: {COAGENT_NUMBER}</b> &middot; Already a member? <a href={CRM_STAFF_URL} target="_blank" rel="noopener">Add your WhatsApp number to your user</a>.</>
				) : (
					<>The number is available from 9am on Tuesday 15 September. Before you message it, make sure you are signed up and your <a href={CRM_STAFF_URL} target="_blank" rel="noopener">WhatsApp number is added to your user</a>.</>
				)}
			</p>
		</div>
	</section>

	<div class="cx">
		<AgentInterestCta lang="en" page="/coagent/" />
	</div>
</Layout>

<style>
	.cx { width: min(1120px, calc(100% - 32px)); margin-inline: auto; }
	.cx.narrow { width: min(780px, calc(100% - 32px)); }
	.center { text-align: center; }
	h1, h2, h3 { letter-spacing: -0.035em; color: #0b1220; }
	h2 span { color: #00ae9a; }

	.hero { overflow: hidden; padding-block: 56px 72px; background: radial-gradient(900px 520px at 78% 30%, rgba(0, 174, 154, 0.16), transparent 62%), linear-gradient(180deg, #f7fbfa 0%, #fff 100%); }
	.heroGrid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 56px; align-items: center; }
