---
import Layout from '../layouts/Layout.astro';
import AgentInterestCta from '../components/AgentInterestCta.astro';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/coagent/`;
const title = 'PropertyList CoAgent (coming soon) - the CRM that writes itself after every call | PropertyList';
const description =
	'Coming soon: CoAgent will turn every client call and WhatsApp chat into CRM updates, follow-ups and ranked property matches, and brief you before you answer. Call audio never stored.';

const trust = [
	{ name: 'Audio is never stored', desc: 'Calls will be transcribed live and the audio discarded as it happens. The summary is kept; a recording never exists, so there is nothing to leak and nothing to hand over.' },
	{ name: 'You have the last word', desc: 'Nothing reaches the CRM until you approve it. CoAgent shows you exactly what will change, field by field, and a visible button stops transcription mid-call.' },
	{ name: 'Your private life stays private', desc: 'Only conversations with people in your agency CRM are captured. Family, friends, your plumber: never synced, never stored. You can exclude any chat, even with a client.' },
];

const faqs = [
	{ q: 'When will CoAgent arrive?', a: 'It is in build now and will roll out to PropertyList agents first, in stages: capture first, then connected WhatsApp, then the dedicated work line. Agents already on the platform will be first in the queue.' },
	{ q: 'Which way should I start?', a: 'Voice notes. There is nothing to set up, nothing to connect and nothing to learn - you talk for 30 seconds after a call and watch what comes back. Most agents will connect their WhatsApp once they have seen their CRM fill itself a few times, and the work line is there for whoever wants a separate business number on top.' },
	{ q: 'Will it write to my CRM automatically?', a: 'No. CoAgent proposes, you approve. It will show you exactly what is about to change - budget, areas, bedrooms, timeframe - field by field, and nothing is saved until you tap confirm. A wrong guess costs you one tap, not a corrupted record.' },
	{ q: 'Are my calls recorded?', a: 'No. Calls will be transcribed live and the audio discarded as it happens. The transcript and the summary are kept; a recording never exists. You will also be able to stop transcription mid-call with one visible button.' },
	{ q: 'What about my personal WhatsApp chats?', a: 'Only conversations with people in your agency CRM will be captured. Messages from anyone else are never captured and never stored. And you will be able to exclude any conversation you choose, even with a client.' },
	{ q: 'Do I have to change my number?', a: 'No. CoAgent starts with a voice note from your own phone, and connecting your own WhatsApp is optional. For agents who want a separate business line, a dedicated work number will be available - your personal number stays personal either way.' },
	{ q: 'What will it cost?', a: 'The MLS and the CRM core stay free. The CRM is not 100% free: moving a qualified buyer lead into the Buyer pipeline costs 1 credit, and your first 5 buyer leads are free. CoAgent plans and pricing will be announced at launch - and every paid CoAgent plan will include those pipeline lead credits, so while you subscribe, moving a buyer into your pipeline costs nothing extra. Creating your free account now costs nothing and puts you in the first wave.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Features', item: `${origin}/features/` },
		{ '@type': 'ListItem', position: 3, name: 'CoAgent', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList CoAgent',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android', url: canonical,
	description: 'Coming soon: an AI assistant for estate agents that turns every call and WhatsApp chat into CRM updates, follow-ups and ranked property matches, with a briefing before every call. Call audio is never stored.',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};
const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=en';
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	hideSearch
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/coagent/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="heroInner heroGrid">
			<div>
				<div class="kicker">CoAgent - Coming soon</div>
				<h1>CoAgent listens to your calls, reads your WhatsApp, and fills in the CRM for you.</h1>
				<p class="heroSub">The call ends. The write-up is already done.</p>
				<div class="whatIs">
					<div class="whatIsTitle">What it does</div>
					<ol>
						<li>You talk to a client, on the phone or on WhatsApp. CoAgent listens.</li>
						<li>You hang up. It saves the contact and writes up the call.</li>
						<li>They call back. Everything you need for that call is already on screen.</li>
						<li>It reminds you what you promised.</li>
					</ol>
				</div>
				<p class="lead">
					The admin that eats your evenings will write itself. The promise you made last Tuesday will be on screen before you
					dial. The buyer from three weeks ago will hear about the new listing from you first. CoAgent will turn every call
					and WhatsApp chat into CRM updates, follow-ups and ranked matches - you confirm, it files.
				</p>
				<div class="winRow" aria-label="What CoAgent gives back">
					<div class="win"><b>Evenings back</b><span>The after-call admin writes itself.</span></div>
					<div class="win"><b>Promises kept</b><span>What you owe each client, surfaced before you dial.</span></div>
					<div class="win"><b>Leads kept warm</b><span>New matches reach them from you first.</span></div>
				</div>
				<div class="ctaRow">
					<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Create your free account</a>
					<a class="btnSecondary" href="#how">See how it will work</a>
				</div>
				<div class="note">Coming soon. CoAgent arrives for PropertyList agents first - create your free account now and you are ready on day one.</div>
			</div>

			<div class="bfWrap" aria-hidden="true">
				<div class="bfTag">Before you answer</div>
				<div class="bfCard">
					<div class="bfHead">
						<span class="bfAvatar">MR</span>
						<span>
							<b>Marta Ruiz</b>
							<i>Buyer &middot; active &middot; calling now</i>
						</span>
						<span class="bfRing"></span>
					</div>
					<div class="bfReq">3-bed apartment &middot; Nueva Andaluc&iacute;a &middot; up to &euro;850k &middot; sea view</div>
					<div class="bfMeta">Last spoke 6 days ago &middot; viewed PL12345 twice</div>
					<div class="bfWarn">You said you would send her the Puerto Ban&uacute;s listing. Not sent yet.</div>
					<div class="bfFoot">Transcribed live &middot; audio never stored</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="how">
		<div class="sectionHead">
			<h2>When you would use it</h2>
			<p>This is the shape of a working day with CoAgent. Notice what you are not doing in any of them: typing.</p>
		</div>
		<div class="grid3 steps">
			<div class="card step">
				<div class="stepTime">09:41</div>
				<h3>Before you answer</h3>
				<p>The phone rings and the brief is already on screen: who it is, the budget, the areas, and the one thing you promised. You answer knowing more than the caller expects you to remember.</p>
			</div>
			<div class="card step">
				<div class="stepTime">09:58</div>
				<h3>When you hang up</h3>
				<p>The summary appears with every change laid out for a one-tap confirm: budget up to &euro;850k, San Pedro added, viewing Saturday. Two tasks created. Three matching listings ready to send on WhatsApp.</p>
			</div>
			<div class="card step">
				<div class="stepTime">3 weeks later</div>
				<h3>While you sell</h3>
				<p>A new listing matches her brief the day it goes live. CoAgent flags it to you first - she hears about it from you, not from a portal. That is what a pipeline that runs itself looks like.</p>
			</div>
		</div>
	</section>

	<section class="section" id="ways">
		<div class="sectionHead">
			<h2>How to start: three options, easiest first</h2>
			<p>CoAgent is not all-or-nothing. Start with a voice note and nothing to set up, connect your WhatsApp when you are ready, and add a dedicated work line if you want one. Each step captures more for you; none of them is required for the one before it.</p>
		</div>
		<div class="grid3">
			<div class="card way">
				<div class="wayNum">1</div>
				<h3>Start with a voice note</h3>
				<div class="gBox" aria-hidden="true">
					<div class="waRow me"><span class="waMic">&#9679;</span><span class="waBars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><span class="waTime">0:31</span></div>
					<div class="waRow bot">
						<b>Marta Ruiz updated</b>
						<i>Budget &euro;850k &middot; +San Pedro &middot; 2 tasks &middot; 3 matches ready</i>
					</div>
				</div>
				<p>Finish any call, open WhatsApp, hold the mic and talk for 30 seconds: "Spoke to Marta, budget up to 850, add San Pedro, viewing Saturday, I need to send her the Puerto Ban&uacute;s listing." The CRM update, the tasks and the matching properties come back in the same thread before you reach the car.</p>
				<p class="wayFor">For: every agent, from day one. Nothing to install, nothing to connect.</p>
			</div>
			<div class="card way">
				<div class="wayNum">2</div>
				<h3>Connect your WhatsApp</h3>
				<div class="gBox" aria-hidden="true">
					<div class="syncRow ok"><span class="syncDot"></span>Marta Ruiz &rarr; saved to CRM</div>
					<div class="syncRow ok"><span class="syncDot"></span>Thomas B. (buyer) &rarr; saved to CRM</div>
					<div class="syncRow no"><span class="syncDot"></span>Mum &rarr; not captured, never stored</div>
				</div>
				<p>Keep messaging clients exactly as you do today, from your own number, in the WhatsApp you already use. Every conversation with a CRM contact files itself - both directions, automatically. Messages from anyone who is not a client are never captured, never stored.</p>
				<p class="wayFor">For: agents who live in WhatsApp - which on this coast is everyone.</p>
			</div>
			<div class="card way">
				<div class="wayNum">3</div>
				<h3>Add a work line</h3>
				<div class="gBox" aria-hidden="true">
					<div class="simRow"><span class="simTag">Personal</span><span class="simNum">+34 6XX XX XX XX</span><i>stays yours, stays private</i></div>
					<div class="simRow work"><span class="simTag">Work</span><span class="simNum">+34 951 24 68 10</span><i>rings in the app &middot; every call written up</i></div>
				</div>
				<p>A real business number that lives in the PropertyList app, next to your personal SIM. Two numbers, one phone. Every call on it is transcribed live and written up, the legal notice plays itself, and if you miss it on data the call forwards to your mobile. The number belongs to your agency - so the clients on it do too.</p>
				<p class="wayFor">For: agents who want work and life separated, and agency owners who want the book to stay.</p>
			</div>
		</div>
	</section>

	<section class="section" id="functions">
		<div class="sectionHead">
			<h2>What CoAgent will do, function by function</h2>
			<p>Not another notes app. An assistant that remembers, files and follows up - so the only thing left in your hands is the part that pays: the conversation.</p>
		</div>

		<div class="featRow">
			<div class="card">
				<h3>The brief before every call</h3>
				<p>
					Who is calling, what they are looking for, their budget, when you last spoke and what happened - on screen in the two
					seconds before you answer. On a WhatsApp call you get the full card; on a normal mobile call, a short line on the
					caller screen. Either way, you never again say "remind me, which property was it?" to a serious buyer.
				</p>
				<p>
					And the line that matters most: <strong>what you promised and have not done.</strong> "You said you would send her the
					Puerto Ban&uacute;s listing." Shown privately to you, before you speak. Clients decide who to trust by whether you remember -
					CoAgent makes sure you always do.
				</p>
			</div>
			<div class="gCard" aria-hidden="true">
				<div class="gLabel">Incoming call</div>
				<div class="gMini">
					<b>Marta Ruiz</b>
					<span>3-bed &middot; Nueva Andaluc&iacute;a &middot; &euro;850k</span>
					<em>You said you would send her the Puerto Ban&uacute;s listing</em>
				</div>
			</div>
		</div>

		<div class="featRow rev">
			<div class="card">
				<h3>You approve everything before it is saved</h3>
				<p>
					After every call or voice note, CoAgent lays out exactly what it wants to change - budget, areas, bedrooms, timeframe -
					old value and new value, side by side. One tap confirms, one tap edits any field. Nothing touches your CRM until you
					say so.
				</p>
				<p>
					This matters because clients here switch between English, Spanish and four other languages mid-sentence - a hard
					job for any listener, human or AI. So CoAgent checks with you instead of guessing: if it ever mishears, it costs
					you one tap - not a wrong budget quietly sitting in a shared record.
				</p>
			</div>
			<div class="gCard" aria-hidden="true">
				<div class="gLabel">Confirm changes</div>
				<div class="gDiff">
					<div><span>Budget</span><span><s>&euro;800k</s> &rarr; <b>&euro;850k</b></span></div>
					<div><span>Areas</span><span><b>+ San Pedro</b></span></div>
					<div><span>Viewing</span><span><b>Sat 11:00</b></span></div>
					<div class="gBtns"><span>Edit</span><span class="ok">Confirm all</span></div>
				</div>
			</div>
		</div>

		<div class="featRow">
			<div class="card">
				<h3>It ends in properties, not paperwork</h3>
				<p>
					The moment the CRM is updated, CoAgent searches the shared MLS - 6,000+ listings - against what the client just told
					you, and hands back the best matches ranked. Send one on WhatsApp with a tap, while the conversation is still warm in
					both your minds.
				</p>
				<p>
					Notes get read later, if ever. A matching property sent within five minutes of hanging up is what turns a phone call
					into a viewing.
				</p>
			</div>
			<div class="gCard" aria-hidden="true">
				<div class="gLabel">Matches ready</div>
				<div class="gMatch"><b>PL18220</b><span>3 bed &middot; &euro;835,000</span><em>Send</em></div>
				<div class="gMatch"><b>R5401816</b><span>3 bed &middot; &euro;799,000</span><em>Send</em></div>
			</div>
		</div>

		<div class="featRow rev">
			<div class="card">
				<h3>A pipeline that keeps working after you stop</h3>
				<p>
					Every captured requirement becomes a living search. When a new listing hits the market that fits a client from three
					weeks ago, CoAgent flags it to you the day it goes live - so they hear it from you first, not from a portal alert.
					Follow-ups, viewing reminders and the promises you made all land in your tasks at the right moment.
				</p>
				<p>
					This is the difference between a CRM you feed and a CRM that feeds you.
				</p>
			</div>
			<div class="gCard" aria-hidden="true">
				<div class="gLabel">Nurture, running</div>
				<div class="gPipe">
					<span>New</span><span class="on">Qualified</span><span>Viewing</span><span>Offer</span>
				</div>
				<div class="gAlert">New listing matches Marta - day one</div>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="ctaInner">
			<h2>It remembers every promise you made</h2>
			<p>
				Your memory is excellent. Until Thursday. Every agent carries fifty open promises in their head, and the one that slips is always the one that mattered: the buyer
				who was ready, the vendor quietly testing whether you listen. CoAgent will carry all of them, and hand each one back at
				exactly the moment you need it.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="sectionHead">
			<h2>Your privacy: what is recorded and what is not</h2>
			<p>An assistant that hears your conversations has to earn its place. These three promises are design decisions, not settings.</p>
		</div>
		<div class="grid3">
			{
				trust.map((t) => (
					<div class="card accent">
						<h3>{t.name}</h3>
						<p>{t.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="grid2">
			<div class="card accent">
				<h2>It works in English, Spanish and your clients' languages</h2>
				<p>
					It speaks this coast. Clients here switch language mid-sentence, and CoAgent is being built for exactly that - English, Spanish and the
					other languages of the coast, in the same call. The names, the budgets and the areas still land in the right fields.
				</p>
			</div>
			<div class="card">
				<h2>No new app to learn</h2>
				<p>
					CoAgent is not another app to adopt: it lives inside the platform you already use. It will live inside PropertyList, where 1,200+ agents and 900+ agencies already
					work - matching against 6,000+ shared listings the moment a client tells you what they want.
				</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHead"><h2>Questions, answered</h2></div>
		<div class="faq">
			{
				faqs.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<section class="cta">
		<div class="ctaInner">
			<h2>Never walk into a call cold again.</h2>
			<p>CoAgent arrives for PropertyList agents first. Create your free account now - no card required - and be ready on day one, inside the free <a href="/features/">PropertyList platform</a>.</p>
			<div class="ctaRow">
				<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Create your free account</a>
			</div>
		</div>
	</section>

	<style>
		:global(:root) {
			--pl-accent: #00ae9a;
			--pl-accent-rgb: 0, 174, 154;
			--pl-ink: #0a6d61;
		}
		h1, h2, h3 { letter-spacing: -0.03em; }
		.hero { border-radius: 22px; padding: 16px; margin: 0 0 14px; border: 1px solid rgba(16, 24, 40, 0.08);
			background: radial-gradient(1200px 600px at 20% -10%, rgba(var(--pl-accent-rgb), 0.22), rgba(255, 255, 255, 0)), radial-gradient(900px 500px at 90% 10%, rgba(var(--pl-accent-rgb), 0.12), rgba(255, 255, 255, 0)); }
		.heroInner { background: rgba(255, 255, 255, 0.8); border: 1px solid rgba(16, 24, 40, 0.06); border-radius: 18px; padding: 22px; }
		.heroGrid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 24px; align-items: center; }
		.kicker { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(var(--pl-accent-rgb), 0.12); border: 1px solid rgba(var(--pl-accent-rgb), 0.22); color: var(--pl-ink); font-weight: 900; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
		h1 { margin: 14px 0 12px; line-height: 1.06; font-size: clamp(28px, 4.4vw, 42px); }
		.lead { margin: 0 0 16px; color: rgba(16, 24, 40, 0.75); max-width: 60ch; line-height: 1.62; }
		.note { color: rgba(16, 24, 40, 0.6); font-weight: 700; font-size: 12.5px; margin-top: 12px; }
		.whatIs { border: 1px solid rgba(0,174,154,0.28); background: rgba(0,174,154,0.06); border-radius: 14px; padding: 14px 16px; margin: 0 0 16px; }
		.whatIsTitle { font-size: 12px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: rgba(11,18,32,.55); margin-bottom: 8px; }
		.whatIs ol { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
		.whatIs li { color: rgba(16,24,40,.82); line-height: 1.5; font-size: 15.5px; }
		.heroSub { margin: -4px 0 12px; font-size: 17px; font-weight: 700; color: rgba(11,18,32,.6); letter-spacing: -.01em; }
		.winRow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0 0 16px; }
		.win { background: rgba(255, 255, 255, 0.75); border: 1px solid rgba(var(--pl-accent-rgb), 0.25); border-radius: 12px; padding: 10px 12px; }
		.win b { display: block; font-size: 13px; color: var(--pl-ink); }
		.win span { display: block; font-size: 12px; color: rgba(16, 24, 40, 0.65); line-height: 1.45; margin-top: 2px; }
		@media (max-width: 560px) { .winRow { grid-template-columns: minmax(0, 1fr); } }
		.ctaRow { display: flex; gap: 12px; flex-wrap: wrap; }
		.btnPrimary, .btnSecondary { display: inline-flex; align-items: center; justify-content: center; padding: 14px 22px; border-radius: 14px; text-decoration: none; font-weight: 900; font-size: 15px; }
		.btnPrimary { background: var(--pl-ink); color: #fff; border: 1px solid var(--pl-ink); }
		.btnPrimary:hover { background: #086055; }
		.btnSecondary { background: rgba(16, 24, 40, 0.05); border: 1px solid rgba(16, 24, 40, 0.12); color: var(--pl-ink); }
		.btnSecondary:hover { background: rgba(16, 24, 40, 0.08); }

		.bfWrap { position: relative; padding: 18px 6px 6px; }
		.bfTag { position: absolute; top: 0; left: 18px; z-index: 2; background: var(--pl-ink); color: #fff; border-radius: 999px; padding: 5px 12px; font-size: 11px; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; }
		.bfCard { background: #fff; border: 1px solid rgba(16, 24, 40, 0.1); border-radius: 16px; padding: 18px 16px 14px; box-shadow: 0 14px 36px rgba(16, 24, 40, 0.12); }
		.bfHead { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; position: relative; }
		.bfAvatar { width: 42px; height: 42px; border-radius: 50%; background: rgba(var(--pl-accent-rgb), 0.14); color: var(--pl-ink); display: inline-flex; align-items: center; justify-content: center; font-weight: 900; font-size: 14px; flex: none; }
		.bfHead b { display: block; font-size: 15.5px; color: #101828; }
		.bfHead i { display: block; font-style: normal; font-size: 12px; color: rgba(16, 24, 40, 0.55); }
		.bfRing { position: absolute; right: 2px; top: 50%; transform: translateY(-50%); width: 10px; height: 10px; border-radius: 50%; background: #16a34a; box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.18); }
		.bfReq { font-size: 13.5px; font-weight: 700; color: #101828; margin-bottom: 4px; line-height: 1.5; }
		.bfMeta { font-size: 12px; color: rgba(16, 24, 40, 0.55); margin-bottom: 10px; }
		.bfWarn { background: #fef6e7; border: 1px solid #f5d9a8; color: #8a5a10; border-radius: 10px; padding: 9px 11px; font-size: 12.5px; font-weight: 700; line-height: 1.45; margin-bottom: 10px; }
		.bfFoot { font-size: 11.5px; color: rgba(16, 24, 40, 0.5); text-align: center; border-top: 1px solid rgba(16, 24, 40, 0.07); padding-top: 9px; }

		.way { display: flex; flex-direction: column; }
		.wayNum { width: 30px; height: 30px; border-radius: 50%; background: var(--pl-ink); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 900; margin-bottom: 10px; }
