---
import Layout from '../layouts/Layout.astro';
import AgentInterestCta from '../components/AgentInterestCta.astro';
import CoagentPhone from '../components/CoagentPhone.astro';
import { getPortalStats, statPlus } from '../lib/portalStats';
import { COAGENT_NUMBER, coagentWaLink, CRM_STAFF_URL } from '../data/coagent';

const origin = 'https://info.propertylist.es';
const canonical = `${origin}/coagent/`;
const title = 'PropertyList CoAgent - the CRM you talk to on WhatsApp | PropertyList';
const description =
	'Send a voice note after a viewing and CoAgent writes up the CRM for you to approve. Ask it for properties, a client brief, your next viewing or what a home is worth, or send photos to start a listing, in the WhatsApp you already use. Audio is never stored and nothing is saved until you reply YES.';

const __ps = await getPortalStats();
const plAgents = statPlus(__ps.agents, 'en');
const plAgencies = statPlus(__ps.agencies, 'en');
const plListings = statPlus(__ps.listings, 'en');

const SIGNUP = 'https://agents.propertylist.es/new_agency/new?locale=en';
const WA = coagentWaLink();

// Every exchange CoAgent handles today, grouped by the moment of the day an agent
// needs it. The wording of each answer is the verified description of what shipped.
const moments = [
	{
		key: 'car',
		label: 'In the car',
		asks: [
			{ q: 'Where is my next viewing?', a: 'Your diary, leading with the address and the client’s phone number, because you are reading it in the car.' },
			{ q: 'What have I got tomorrow?', a: 'The whole day, in order, with the property and who you are meeting.' },
			{ q: 'What is Marta Ruiz’s number?', a: 'Her phone and email first, so your thumb is already on the call button.' },
			{ q: 'Brief me on the Bergs', a: 'Where they are up to, what they are looking for, and the last thing that happened, before you dial.' },
		],
	},
	{
		key: 'client',
		label: 'With a client',
		asks: [
			{ q: 'What have we got in Marbella, three beds, up to two million?', a: 'Five listings from the shared MLS with prices and links. No client needed, so it works with someone sitting next to you.' },
			{ q: 'Tell me about PL22234', a: 'Price, bedrooms, size, location and the link for that one listing, whether it is yours or another agency’s.' },
			{ q: 'Which is the best value, PL5001, PL5002 or PL5003?', a: 'It ranks them against comparable homes for sale nearby, with the price per square metre, so you can tell a client which one is keenly priced and which is asking too much. Ask straight after a search and it compares those results.' },
			{ photo: true, q: 'A photo of a tired room, with "renovate"', a: 'Mid-viewing, send the kitchen as it is and get it back renovated a minute later, to show your buyer what it could be. It costs the same credits as in the CRM, and only a render that comes out well is charged.' },
			{ q: 'How many apartments are for sale in San Pedro?', a: 'The real number on the market there, the best matches, and a link to the full list in your CRM.' },
			{ q: 'Is PL22234 still available?', a: 'If the listing belongs to another agency, CoAgent offers to ask them for you. Reply YES and the enquiry goes to them through the MLS, and their answer comes back to you.' },
		],
	},
	{
		key: 'after',
		label: 'After the viewing',
		asks: [
			{ q: 'Add a note to Marta: she wants to see it again Saturday', a: 'It reads the note back in your own words and saves it to her file when you reply YES.' },
			{ q: 'Marta has made an offer', a: 'CoAgent moves her card to the right stage on your pipeline when you reply YES, the same as dragging it in the CRM. Marking a client won or lost stays in the CRM, where it asks for the details.' },
			{ q: 'Add Maria Lopez 6XX XXX XXX maria@example.com', a: 'Or share her contact card straight from your phone. CoAgent reads the name, number and email back and adds her to your CRM when you reply YES. If she is already there, it links her record instead of making a duplicate.' },
			{ photo: true, q: 'A photo of a client’s ID', a: 'Only the name, surnames and date of birth are read, and added as a new contact when you reply YES. The document number is never kept, and neither is the photo.' },
		],
	},
	{
		key: 'listings',
		label: 'Winning listings',
		asks: [
			{ q: 'Let’s list a property', a: 'CoAgent tells you what to send: the photos, then the price, where it is and the bedrooms, in your own words. No commands to learn.' },
			{ photo: true, q: 'Photos of a new listing', a: 'Send them straight from your camera roll, then tell CoAgent about the property, typed or as a voice note. It asks for anything missing, like the price, reads the listing back, and on YES writes the title, description and features. Reply PUBLISH and it goes to review, as it would from the CRM. Nothing goes live without that.' },
			{ photo: true, q: 'A photo of a Se Vende sign', a: 'CoAgent reads the phone number off the sign, with any name or price on it. Reply YES and the owner is saved as a contact in your CRM with a note of the sign, ready for you to call.' },
			{ q: 'What is Nueva Andalucía worth?', a: 'The middle asking price and the range across what is actually on the market there. If we do not hold enough stock in an area, it says so rather than guessing.' },
			{ q: 'What is PL22234 worth?', a: 'A value from notary-recorded sales in that town, with a range and a link to the public proof. Or describe the home instead: “a 120 m² apartment in Estepona”. It always tells you what the figure is based on.' },
			{ q: 'REPORT', a: 'After a valuation, reply REPORT for the full Property Intelligence Report, as a link you can send to the seller. Your first one is free. After that it costs credits, and it tells you how many and asks before spending anything.' },
			{ q: 'BROCHURE PL22234', a: 'A brochure of the listing with your own branding: a page your client can open, with today’s price and a way to enquire, plus the PDF. It tells you the price in credits first, and a brochure you already made is sent again for free.' },
		],
	},
	{
		key: 'leads',
		label: 'New leads',
		asks: [
			{ q: 'What are my latest leads?', a: 'Your five newest, with who enquired, about which listing and when: your own, or the whole agency’s if you are an admin, as in the CRM. Reply REPLY to answer the newest by email.' },
			{ q: 'REPLY', a: 'CoAgent writes an email to your latest lead in their own language, from what they asked. Reply YES and it goes out from you through the CRM, and their answer comes back to your email. Or just answer the new-lead alert.' },
		],
	},
];

const trust = [
	{ name: 'Your voice is not kept', desc: 'The audio is transcribed and thrown away. Only the text survives, on the record it belongs to, where you can read it and correct it. There is no recording to leak and none to hand over.' },
	{ name: 'Nothing is saved until you say so', desc: 'CoAgent lays out what it wants to change, then waits. No client record is edited and no enquiry leaves for another agency until you reply YES. Say nothing and nothing happens.' },
	{ name: 'It answers from your data or not at all', desc: 'Every answer comes from your CRM and the shared MLS. Ask it something outside that and it says so plainly, instead of inventing a fact you might repeat to a client.' },
];

const soon = [
	{ name: 'Your own WhatsApp, connected', desc: 'Keep messaging clients from your own number and have those conversations file themselves, in both directions, with anyone who is not a client never captured. In design now.' },
	{ name: 'A dedicated work line', desc: 'A business number that lives in the PropertyList app beside your personal SIM, with calls written up the same way a voice note is. On the roadmap.' },
	{ name: 'The brief on your caller screen', desc: 'Today you can ask for a client brief any time. Having it appear by itself as the phone rings needs work inside the mobile app, and that is the next piece we build.' },
];

const faqs = [
	{ q: 'What do I have to install?', a: 'Nothing. CoAgent works in WhatsApp, which you already use all day. Save the PropertyList number, make sure your mobile is on your CRM profile so it knows you are an agent rather than a client, and send it a voice note.' },
	{ q: 'Will it change my CRM automatically?', a: 'No. CoAgent proposes and waits. It shows you the client it matched and the changes it wants to make, field by field, and nothing is written until you reply YES. If it mishears, it costs you one word, not a wrong budget sitting quietly in a shared record.' },
	{ q: 'Are my voice notes recorded?', a: 'No. The audio is transcribed and discarded. The transcript is kept on the client record, where you can read exactly what the CRM was told.' },
	{ q: 'Does it work in Spanish?', a: 'Yes, and in German, French, Portuguese, Bulgarian and Greek. It replies in your own language and it copes with a note that switches language halfway through, which on this coast is most of them.' },
	{ q: 'Do I need to name a client every time?', a: 'No. Naming a client turns a voice note into CRM updates. Without one you can still ask for properties, your diary, a listing by reference or what an area is worth, which is what you want when a walk-in is standing next to you.' },
	{ q: 'Can it talk to other agencies for me?', a: 'Yes. Ask whether a listing from another agency is still available and CoAgent offers to send the enquiry. Reply YES and it goes through the MLS the same way one sent from the CRM screen does, so it lands in their normal workflow.' },
	{ q: 'What if CoAgent does not know my number?', a: 'It replies, in Spanish and English, with a link to create your free account and a link to the Staff page of your CRM, where you add your mobile to your profile. Put the country code in front if your number is not Spanish, then write to it again.' },
	{ q: 'What costs credits?', a: 'Messages are covered by your plan. A brochure, the market report after your first free one, and a renovated room are paid in PropertyList credits, at the same price as in the CRM. CoAgent always tells you the price and waits for your YES before it spends anything, and a brochure or render that fails is never charged.' },
	{ q: 'What does it cost?', a: 'The first 10 agents to message CoAgent get a month free and unlimited, counted from their first message. Every agent gets 5 free messages a day, and approving with YES never counts toward them. Unlimited is 50 credits a month per agent, paid from your PropertyList credits, and you can stop it renewing any time. If you have more than 3 agents to add, talk to us about a package. The MLS and the CRM core stay free, and creating your account costs nothing.' },
];

const faqLd = {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
	'@context': 'https://schema.org', '@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
		{ '@type': 'ListItem', position: 2, name: 'Features', item: `${origin}/features/` },
		{ '@type': 'ListItem', position: 3, name: 'CoAgent', item: canonical },
	],
};
const softwareLd = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication',
	name: 'PropertyList CoAgent',
	applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android', url: canonical,
	description: 'An assistant for estate agents that works over WhatsApp: voice notes become CRM updates the agent approves, and questions about clients, listings, the diary and area prices are answered from the agency CRM and the shared MLS. Audio is never stored.',
	publisher: { '@type': 'Organization', name: 'PropertyList', url: 'https://propertylist.es/' },
};
---

<Layout
	lang="en"
	title={title}
	description={description}
	canonical={canonical}
	hideSearch
	fullBleed
	hreflangs={[
		{ hreflang: 'en', href: canonical },
		{ hreflang: 'es', href: `${origin}/es/coagent/` },
		{ hreflang: 'x-default', href: canonical },
	]}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />

	<section class="hero">
		<div class="cx heroGrid">
			<div class="heroCopy">
				<div class="eyebrow"><span class="dot"></span> CoAgent &middot; your CRM on WhatsApp</div>
				<h1>Stop typing up your CRM.<br /><span>Just talk to it.</span></h1>
				<p class="heroLead">
					<strong>CoAgent lives in the WhatsApp you already use.</strong> Walk out of a viewing, send a voice note the way you
					would to a colleague, and the write-up is waiting for you: the note, the new requirement, the follow-up you promised
					and the listings that now match. Nothing is saved until you reply YES.
				</p>
				<div class="ctaRow">
					{WA ? (
						<a class="btnPrimary" href={WA} target="_blank" rel="noopener">Message CoAgent on WhatsApp</a>
					) : (
						<a class="btnPrimary" href={SIGNUP} target="_blank" rel="noopener">Create your free account</a>
					)}
					<a class="btnGhost" href="#how">See how it works</a>
				</div>
				<p class="micro">5 free messages a day &middot; Nothing to install &middot; Audio never stored</p>
				{WA ? (
					<p class="member">
						Already on PropertyList? <a href={CRM_STAFF_URL} target="_blank" rel="noopener">Add your WhatsApp number to your user</a>
						so CoAgent knows it is you.
					</p>
				) : (
					<p class="member">
						<b>The CoAgent number is available from 9am on Tuesday 15 September.</b> Before you message it, make sure you are
						<a href={SIGNUP} target="_blank" rel="noopener">signed up</a> and your
						<a href={CRM_STAFF_URL} target="_blank" rel="noopener">WhatsApp number is added to your user</a>.
					</p>
				)}
			</div>
			<CoagentPhone lang="en" />
		</div>
	</section>

	<div class="strip">
		<div class="cx stripInner">
			<span>Behind it: <b>{plAgencies}</b> agencies</span>
			<span><b>{plAgents}</b> agents</span>
			<span><b>{plListings}</b> live listings</span>
			<span>Replies in <b>7</b> languages</span>
		</div>
	</div>

	<section class="band dark">
		<div class="cx">
			<div class="head center">
				<div class="label">The hour nobody bills for</div>
				<h2>Every “I will write it up later” is a promise at risk.</h2>
				<p>
					Nobody forgets on purpose. You take the call in the car, promise to send a listing, and by the time you reach a desk
					there are nine other things. The day moves faster than the admin, and a CRM only pays you back if it is current.
				</p>
			</div>
			<div class="versus">
				<div class="vCol without">
					<div class="vHead">Tonight, the usual way</div>
					<ol>
						<li><b>18:40</b><span>Last viewing ends. Three things you promised, all in your head.</span></li>
						<li><b>19:15</b><span>Two calls on the drive home. One more promise.</span></li>
						<li><b>21:30</b><span>Laptop open, writing up the day from memory.</span></li>
						<li><b>Thursday</b><span>“Did you ever send me that listing?”</span></li>
					</ol>
				</div>
				<div class="vCol with">
					<div class="vHead">Tonight, with CoAgent</div>
					<ol>
						<li><b>18:41</b><span>A voice note from the car park.</span></li>
						<li><b>18:42</b><span>Read what it heard. Reply YES.</span></li>
						<li><b>18:43</b><span>Note filed, requirement updated, Saturday reminder set.</span></li>
						<li><b>21:30</b><span>You are not at the laptop.</span></li>
					</ol>
				</div>
			</div>
			<p class="punch">Your memory is excellent. Until Thursday.</p>
		</div>
	</section>

	<section class="band soft" id="how">
		<div class="cx">
			<div class="head">
				<div class="label">How it works</div>
				<h2>You talk. CoAgent does the typing.</h2>
				<p>No forms, no commands to learn, and nothing changes behind your back.</p>
			</div>
			<div class="grid3">
				<div class="demo">
					<span class="num">1</span>
					<h3>Send the voice note</h3>
					<p>Straight after the viewing, exactly as you would tell a colleague.</p>
					<div class="mini">
						<div class="mb me">“Just saw the Nueva Andalucía apartment with Marta. She is open to three beds now, up to eight fifty, and I said I would send her the Cerquilla one on Saturday.”</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">2</span>
					<h3>Read what it heard</h3>
					<p>The client it matched, the changes it proposes, the reminder it will set and the listings that now match.</p>
					<div class="mini">
						<div class="mb">
							<b>Marta Ruiz · buyer</b>
							<span class="kv"><i>Budget</i><em>€800k to €850k</em></span>
							<span class="kv"><i>Bedrooms</i><em>3</em></span>
							<span class="kv"><i>Reminder</i><em>Cerquilla listing, Saturday</em></span>
						</div>
					</div>
				</div>
				<div class="demo">
					<span class="num">3</span>
					<h3>Reply YES</h3>
					<p>Only then does anything move. Say nothing and nothing happens.</p>
					<div class="mini">
						<div class="mb">Reply <b>YES</b> to save it. Nothing is written yet.</div>
						<div class="mb me short">YES</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band" id="ask">
		<div class="cx">
			<div class="head">
				<div class="label">Everything else you can ask it</div>
				<h2>Your whole working day, in one chat.</h2>
				<p>By voice or by typing, in your own words. When a question is outside what it holds, it tells you so instead of guessing.</p>
			</div>
			<div class="mTabs" role="tablist" data-mtabs>
				{moments.map((m, i) => (
					<button type="button" class={i === 0 ? 'mTab on' : 'mTab'} role="tab" data-mtab={m.key} aria-selected={i === 0 ? 'true' : 'false'}>
						{m.label} <small>{m.asks.length}</small>
					</button>
				))}
			</div>
			{moments.map((m) => (
				<div class="mPanel" data-mpanel={m.key}>
					<h3 class="mTitle">{m.label}</h3>
					<div class="grid2">
						{m.asks.map((item) => (
							<div class="ex">
								<div class="exQ">
									{item.photo && <span class="tag">Photo</span>}
									{item.photo ? item.q : `“${item.q}”`}
								</div>
								<div class="exA">{item.a}</div>
							</div>
						))}
					</div>
				</div>
			))}
		</div>
	</section>

	<section class="band soft" id="matching">
		<div class="cx">
			<div class="matchBox">
				<div class="matchCopy">
					<div class="label">Built on the shared MLS</div>
					<h2>Don’t just remember the client. Find their next home.</h2>
					<p>
						Behind CoAgent sits the MLS that {plAgencies} agencies share. Ask for three beds in Nueva Andalucía and it searches
						all of that stock, not only yours. When the right home belongs to another agency, it offers to ask them for you.
					</p>
					<ul class="checks">
						<li>Searches the shared MLS, not only your own listings</li>
						<li>Ranks “which is the best value?” on price per m² against comparable homes nearby</li>
						<li>Values from notary-recorded sales, with a link to the public proof</li>
						<li>Enquiries to other agencies go through the MLS, into their normal workflow</li>
					</ul>
				</div>
				<div class="matchVisual" aria-hidden="true">
					<div class="resCard">
						<div class="resHead">
							<span>From the shared MLS</span>
							<em>3 beds &middot; Nueva Andalucía &middot; up to €850k</em>
						</div>
						<div class="res">
							<span class="resPh a"></span>
							<span class="resTxt"><b>PL5001 &middot; Apartment</b><i>3 beds &middot; 2 baths &middot; Nueva Andalucía</i></span>
							<span class="resP">€845,000<small class="own">Your listing</small></span>
						</div>
						<div class="res">
							<span class="resPh b"></span>
							<span class="resTxt"><b>PL5002 &middot; Penthouse</b><i>3 beds &middot; 2 baths &middot; Nueva Andalucía</i></span>
							<span class="resP">€830,000<small>Another agency</small></span>
						</div>
						<div class="res">
							<span class="resPh c"></span>
							<span class="resTxt"><b>PL5003 &middot; Townhouse</b><i>3 beds &middot; 3 baths &middot; Aloha</i></span>
							<span class="resP">€799,000<small>Another agency</small></span>
						</div>
						<div class="resAsk">PL5002 belongs to another agency. Reply <b>YES</b> and I will ask if it is still available.</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="cx">
			<div class="head center">
				<div class="label">What is kept and what is not</div>
				<h2>An assistant that hears your day has to earn its place.</h2>
				<p>These are design decisions, not settings you have to find.</p>
			</div>
			<div class="grid3">
				{trust.map((t) => (
					<div class="tCard">
						<span class="tIcon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3zm-1.2 14.2-3.5-3.5 1.4-1.4 2.1 2.1 4.8-4.8 1.4 1.4-6.2 6.2z" /></svg>
						</span>
						<h3>{t.name}</h3>
						<p>{t.desc}</p>
					</div>
				))}
			</div>
			<div class="grid2 pair">
				<div class="tCard flat">
					<h3>It speaks this coast</h3>
					<p>Clients here switch between English and Spanish mid-sentence, and so do agents. CoAgent understands a note that changes language halfway through and replies in yours: English, Spanish, German, French, Portuguese, Bulgarian or Greek. The names, the budgets and the areas still land in the right fields.</p>
				</div>
				<div class="tCard flat">
					<h3>No new app to learn</h3>
					<p>It lives in WhatsApp, and behind it sits the platform where {plAgents} agents and {plAgencies} agencies already work, matching against {plListings} live listings the moment a client tells you what they want.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="band soft" id="pricing">
		<div class="cx">
			<div class="head center">
				<div class="label">What it costs</div>
				<h2>Start free. Pay only for unlimited.</h2>
				<p>No contract. Unlimited is paid in credits from the same wallet as everything else on PropertyList, and you can stop it renewing any time.</p>
			</div>
			<div class="plans">
				<div class="plan">
					<div class="planWhen">Every agent</div>
					<div class="planPrice">5 a day</div>
					<div class="planDesc">free messages, every day. Approving with YES never counts toward them.</div>
				</div>
				<div class="plan featured">
					<div class="planBadge">The first 10 agents</div>
					<div class="planWhen">Free and unlimited</div>
					<div class="planPrice">1 month</div>
					<div class="planDesc">The first ten agents to message CoAgent get a month free and unlimited, counted from their first message. In return, tell us where it gets in the way, and it changes.</div>
					{WA ? (
						<a class="btnPrimary full" href={WA} target="_blank" rel="noopener">Message CoAgent now</a>
					) : (
						<div class="planSoon">The number is available from 9am on Tuesday 15 September. Before you message it, make sure you are <a href={SIGNUP} target="_blank" rel="noopener">signed up</a> and your <a href={CRM_STAFF_URL} target="_blank" rel="noopener">WhatsApp number is added to your user</a>.</div>
					)}
				</div>
				<div class="plan">
					<div class="planWhen">Unlimited</div>
					<div class="planPrice">50 credits</div>
					<div class="planDesc">a month per agent, turned on from the Billing page or by replying SUBSCRIBE. More than 3 agents to add? Talk to us about a package.</div>
				</div>
			</div>
			<p class="fine">A brochure, the market report after your first free one, and a renovated room are paid in credits at the same price as in the CRM. CoAgent tells you the price and waits for your YES first.</p>
		</div>
	</section>

	<section class="band">
		<div class="cx">
			<div class="head">
				<div class="label">What we are building next</div>
				<h2>Everything above works today. These do not, yet.</h2>
				<p>We would rather say so here than let you find out later.</p>
			</div>
			<div class="grid3">
				{soon.map((s) => (
					<div class="tCard flat">
						<span class="soon">Not live yet</span>
						<h3>{s.name}</h3>
						<p>{s.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="band soft">
		<div class="cx narrow">
			<div class="head center">
				<div class="label">Questions</div>
