	.navAuthBtn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 10px 14px;
		border-radius: 999px;
		border: 1px solid transparent;
		background:
			linear-gradient(rgb(var(--accent-rgb)), rgb(var(--accent-rgb))) bottom / 100% 0% no-repeat,
			rgba(var(--accent-rgb), 0.12);
		color: rgba(11, 18, 32, 0.92);
		font-weight: 900;
		letter-spacing: -0.01em;
		font: inherit;
		cursor: pointer;
		white-space: nowrap;
		transition: color 0.16s ease, background-size 0.22s ease-in;
	}

	/* slowly rotating teal-to-gold ring */
	.navAuthBtn::before {
		content: '';
		position: absolute;
		inset: -2px;
		border-radius: 999px;
		padding: 2px;
		background: conic-gradient(
			from var(--plangle),
			rgba(0, 174, 154, 0.95),
			rgba(169, 138, 85, 0.85),
			rgba(0, 174, 154, 0.15),
			rgba(0, 174, 154, 0.95)
		);
		-webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
		mask-composite: exclude;
		animation: plAuthSpin 6s linear infinite;
		pointer-events: none;
	}

	@keyframes plAuthSpin {
		to {
			--plangle: 360deg;
		}
	}

	.navAuthBtn:hover {
		color: #fff;
		background-size: 100% 100%, auto;
		transition: color 0.2s ease 0.08s, background-size 0.3s cubic-bezier(0.33, 1, 0.5, 1);
	}

	.navAuthBtn:hover::before {
		animation-duration: 1.6s;
	}

	@media (prefers-reduced-motion: reduce) {
		.navAuthBtn::before {
			animation: none;
		}
		.navAuthBtn {
			transition: none;
		}
	}

	.navAuthBtn:focus-visible {
		outline: none;
		box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.22);
	}

