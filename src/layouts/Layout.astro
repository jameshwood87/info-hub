		<script is:inline>
			(() => {
				const openBtns = Array.from(document.querySelectorAll('[data-auth-open]'));
				const overlay = document.querySelector('[data-auth-overlay]');
				const closeBtn = document.querySelector('[data-auth-close]');
				if (!(overlay instanceof HTMLElement)) return;
				const modal = overlay.querySelector('.authModal');
				let lastActive = null;
				const storageKey = 'authModalDismissed';
				let lastUserOpenAt = 0;
				const userOpenWindowMs = 2000;

				const getDismissed = () => {
					try {
						return sessionStorage.getItem(storageKey) === '1';
					} catch {
						return false;
					}
				};

				const setDismissed = (next) => {
					try {
						sessionStorage.setItem(storageKey, next ? '1' : '0');
					} catch {}
				};

				const isUserOpening = () => Date.now() - lastUserOpenAt < userOpenWindowMs;

				const forceClosed = () => {
					overlay.setAttribute('data-open', '0');
					overlay.hidden = true;
					document.documentElement.classList.remove('modalLock');
				};

				const setOpen = (next, reason = '') => {
					if (next) {
						if (getDismissed()) return;
						if (reason !== 'user') return;
					}

					overlay.setAttribute('data-open', next ? '1' : '0');
					overlay.hidden = !next;
					document.documentElement.classList.toggle('modalLock', next);
					if (next) {
						lastActive = document.activeElement instanceof HTMLElement ? document.activeElement : null;
						const focusTarget =
							(modal instanceof HTMLElement && modal.querySelector('a,button,input,select,textarea,[tabindex]:not([tabindex="-1"])')) || modal;
						if (focusTarget instanceof HTMLElement) focusTarget.focus?.();
					} else {
						setDismissed(true);
						if (lastActive instanceof HTMLElement) lastActive.focus?.();
						lastActive = null;
					}
				};

				forceClosed();
				window.addEventListener?.('pageshow', (e) => {
					if (e?.persisted) forceClosed();
				});

				for (const b of openBtns) {
					if (b instanceof HTMLElement)
						b.addEventListener('click', (e) => {
							if (e && 'isTrusted' in e && !e.isTrusted) return;
							setDismissed(false);
							lastUserOpenAt = Date.now();
							setOpen(true, 'user');
						});
				}
				if (closeBtn instanceof HTMLElement) closeBtn.addEventListener('click', () => setOpen(false));
				document.addEventListener(
					'click',
					(e) => {
						const el = e.target;
						if (!(el instanceof Element)) return;
						const close = el.closest('[data-auth-close]');
						if (close instanceof HTMLElement) setOpen(false);
					},
					true,
				);
				overlay.addEventListener('click', (e) => {
					if (e.target === overlay) setOpen(false);
				});
				overlay.addEventListener(
					'click',
					(e) => {
						const el = e.target;
						if (!(el instanceof Element)) return;
						const a = el.closest('a');
						if (a instanceof HTMLAnchorElement) setOpen(false);
					},
					true,
				);
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') setOpen(false);
				});

				if (typeof MutationObserver !== 'undefined') {
					const obs = new MutationObserver(() => {
						const isOpen = overlay.getAttribute('data-open') === '1' && !overlay.hidden;
						if (isOpen && !isUserOpening()) forceClosed();
						if (document.documentElement.classList.contains('modalLock') && overlay.hidden) document.documentElement.classList.remove('modalLock');
					});
					obs.observe(overlay, { attributes: true, attributeFilter: ['hidden', 'data-open', 'style', 'class'] });
					obs.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
				}
			})();
		</script>
		<script is:inline>
			(() => {
				const safeGtag = (...args) => {
					try {
						if (typeof window.gtag === 'function') window.gtag(...args);
					} catch {}
				};
				const openChat = () => {
					const start = Date.now();
					const tryOpen = () => {
						const api = window.tidioChatApi;
						if (!api) return false;
						try {
							if (typeof api.show === 'function') api.show();
							if (typeof api.open === 'function') api.open();
							return true;
						} catch {
							return false;
						}
					};

					let bound = false;
					let messageTracked = false;
					const bindEvents = () => {
						if (bound) return;
						const api = window.tidioChatApi;
						if (!api || typeof api.on !== 'function') return;
						bound = true;
						try {
							api.on('open', () => {
								safeGtag('event', 'tidio_open', { location: 'content' });
							});
						} catch {}
						const onMessage = () => {
							if (messageTracked) return;
							messageTracked = true;
							safeGtag('event', 'tidio_message', { location: 'content' });
						};
						try {
							api.on('messageFromVisitor', onMessage);
						} catch {}
						try {
							api.on('conversationStart', onMessage);
						} catch {}
					};

					const ensure = () => {
						const api = window.tidioChatApi;
						if (api && typeof api.on === 'function') {
							try {
								api.on('ready', () => {
									bindEvents();
									tryOpen();
								});
							} catch {}
						}
					};

					ensure();
					bindEvents();
					if (tryOpen()) return;
					const t = window.setInterval(() => {
						ensure();
						bindEvents();
						if (tryOpen() || Date.now() - start > 8000) window.clearInterval(t);
					}, 200);
				};

				window.openTidioChat = openChat;

				document.addEventListener(
					'click',
					(e) => {
						const el = e.target;
						if (!(el instanceof Element)) return;
						const target = el.closest('[data-tidio-open="1"]');
						if (!(target instanceof HTMLElement)) return;
						safeGtag('event', 'tidio_ticket', { location: 'content' });
						if (target instanceof HTMLAnchorElement) {
							e.preventDefault();
							e.stopPropagation();
						}
						openChat();
					},
					true,
				);

				document.addEventListener(
					'keydown',
					(e) => {
						if (e.key !== 'Enter' && e.key !== ' ') return;
						const el = e.target;
						if (!(el instanceof Element)) return;
						const target = el.closest('[data-tidio-open="1"]');
						if (!(target instanceof HTMLElement)) return;
						e.preventDefault();
						safeGtag('event', 'tidio_ticket', { location: 'content' });
						openChat();
					},
					true,
				);

				try {
					const p = `${location.pathname}`.replace(/\/+$/, '/') || '/';
					if (p === '/docs/propertylist-mls-user-manual/support/mls-support/') {
						const norm = (s) => String(s || '').toLowerCase().replace(/\s+/g, ' ').trim();
						const makeClickable = (el) => {
							if (!(el instanceof HTMLElement)) return;
							el.dataset.tidioOpen = '1';
							el.setAttribute('role', 'link');
							el.setAttribute('tabindex', '0');
							el.classList.add('tidioTicketLink');
						};

						const candidates = Array.from(document.querySelectorAll('a,strong,span,b,em,p,div'));
						const exact = [];
						for (const el of candidates) {
							if (!(el instanceof HTMLElement)) continue;
							const t = norm(el.textContent || '');
							if (!t) continue;
							if (t === 'create a ticket here') exact.push(el);
						}
						if (exact.length) {
							for (const el of exact) makeClickable(el);
						} else {
							for (const el of candidates) {
								if (!(el instanceof HTMLElement)) continue;
								const t = norm(el.textContent || '');
								if (!t) continue;
								if (t.includes('create a ticket here')) makeClickable(el);
							}
						}
					}
				} catch {}
			})();
		</script>
	</body>
