---
type HreflangLink = { hreflang: string; href: string };

type Props = {
	lang?: string;
	title?: string;
	description?: string;
	canonical?: string;
	hreflangs?: HreflangLink[];
	robots?: string;
	ogImage?: string;
	ogType?: string;
	twitterCard?: 'summary' | 'summary_large_image';
	schema?: unknown;
	minimal?: boolean;
	existingUser?: boolean;
	fullBleed?: boolean;
	hideSearch?: boolean;
};

const {
	lang = 'en',
	title = 'PropertyList Info Hub',
	description,
	canonical,
	hreflangs = [],
	robots,
	ogImage,
	ogType,
	twitterCard,
	schema,
	minimal = false,
	existingUser = false,
	fullBleed = false,
	hideSearch = false,
} = Astro.props;

// Seasonal assets import
import { getSeasonalAssets } from "../lib/seasonalLogo";
import { getPortalStats, statPlus } from '../lib/portalStats';
import { canonicalAreaPath } from "../lib/areaProvince";

const __lps = await getPortalStats();
const { logo, og, icon } = getSeasonalAssets();

const stripInfoHubSuffix = (s: string) => String(s || '').replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '').trim();
const pageTitle = stripInfoHubSuffix(title) || 'PropertyList Info Hub';

const configuredSiteUrl = String(import.meta.env.PUBLIC_SITE_URL || '').trim();
const requestOrigin = Astro.url ? `${Astro.url.protocol}//${Astro.url.host}` : '';
const siteOrigin = configuredSiteUrl || requestOrigin;

const toAbsoluteUrl = (value: string | undefined | null) => {
	const raw = String(value || '').trim();
	if (!raw) return null;
	if (!siteOrigin) return raw;
	if (/^https?:\/\//i.test(raw)) return normalizeCanonical(raw) ?? raw;
	if (raw.startsWith('/')) return `${siteOrigin}${raw}`;
	return raw;
};

const normalizeCanonical = (value?: string) => {
	if (!value) return null;
	if (!siteOrigin) return value;
	try {
		const u = new URL(value);
		u.protocol = new URL(siteOrigin).protocol;
		u.host = new URL(siteOrigin).host;
		return u.toString();
	} catch {
		return value;
	}
};

const pathname = Astro.url?.pathname ?? '/';
const isAdminPath = pathname === '/admin' || pathname.startsWith('/admin/');
const isHomePath = pathname === '/' || pathname === '/es/';
const showSearch = pathname.startsWith('/docs') || pathname.startsWith('/es/docs') || pathname === '/search' || pathname === '/es/search';
const mapDocsToEnglish = (p: string) => {
	const path = String(p || '');
	if (!path.startsWith('/es/docs/')) return path;
	const withoutEs = path.replace(/^\/es\//, '/');
	const parts = withoutEs.split('/').filter(Boolean);
	const seg = parts[1] || '';
	const mapped =
		seg === 'propertylist-mls-manual-de-usuario'
			? 'propertylist-mls-user-manual'
			: seg === 'leyes-procedimientos'
				? 'laws-procedures'
				: seg === 'portal-publico'
					? 'public-portal'
					: seg === 'empezar'
						? 'getting-started'
						: seg;
	parts[1] = mapped;
	if (mapped === 'propertylist-mls-user-manual' && (parts[2] || '') === 'empezar') parts[2] = 'getting-started';
	return `/${parts.join('/')}/`;
};

const mapDocsToSpanish = (p: string) => {
	const path = String(p || '');
	if (!path.startsWith('/docs/')) return path;
	const parts = path.split('/').filter(Boolean);
	const seg = parts[1] || '';
	const mapped =
		seg === 'propertylist-mls-user-manual'
			? 'propertylist-mls-manual-de-usuario'
			: seg === 'laws-procedures'
				? 'leyes-procedimientos'
				: seg === 'public-portal'
					? 'portal-publico'
					: seg === 'getting-started'
						? 'empezar'
						: seg;
	parts[1] = mapped;
	if (mapped === 'propertylist-mls-manual-de-usuario' && (parts[2] || '') === 'getting-started') parts[2] = 'empezar';
	return `/es/${parts.join('/')}/`;
};

const mapPairs: Array<{ en: string; es: string }> = [
	{ en: '/about-us', es: '/es/sobre-nosotros/' },
	{ en: '/about-us/', es: '/es/sobre-nosotros/' },
	{ en: '/about-us/', es: '/es/sobre-nosotros' },
	{ en: '/what-we-offer/', es: '/es/lo-que-ofrecemos/' },
	{ en: '/what-is-my-property-worth/', es: '/es/cuanto-vale-mi-propiedad/' },
	{ en: '/xml-feed-import/', es: '/es/importar-feed-xml/' },
	{ en: '/landlord/', es: '/es/propietarios/' },
	{ en: '/free-mls/', es: '/es/mls-gratuito/' },
	{ en: '/blog/', es: '/es/blog/' },
	{ en: '/general-information/', es: '/es/informacion-general/' },
	{ en: '/community/', es: '/es/comunidad/' },
	{ en: '/laws/', es: '/es/leyes/' },
	{ en: '/neighbourhood/', es: '/es/barrios/' },
	{ en: '/features/', es: '/es/funciones/' },
	{ en: '/website-builder/', es: '/es/constructor-de-webs/' },
	{ en: '/rentals/', es: '/es/alquileres/' },
	{ en: '/holiday-rentals/', es: '/es/alquiler-vacacional/' },
	{ en: '/developers/', es: '/es/promotores/' },
	{ en: '/faq/', es: '/es/preguntas-frecuentes/' },
	{ en: '/verify-your-agency/', es: '/es/verifica-tu-agencia/' },
	{ en: '/pricing/', es: '/es/precios/' },
	{ en: '/referrals/', es: '/es/referidos/' },
	{ en: '/whats-on/', es: '/es/que-hacer/' },
	{ en: '/mobile-app/', es: '/es/app-movil/' },
	{ en: '/request-new-features/', es: '/es/solicitar-funciones/' },
	{ en: '/ai-property-search/', es: '/es/busqueda-ia/' },
	{ en: '/instant-listing/', es: '/es/listado-instantaneo/' },
	{ en: '/instant-renovation/', es: '/es/renovacion-instantanea/' },
	{ en: '/coagent/', es: '/es/coagent/' },
	{ en: '/instant-documents/', es: '/es/documentos-instantaneos/' },
	{ en: '/instant-content/', es: '/es/contenido-instantaneo/' },
	{ en: '/video-guides/', es: '/es/video-guias/' },
	{ en: '/property-intelligence-report/', es: '/es/informe-inteligencia-propiedad/' },
	{ en: '/costa-del-sol/', es: '/es/costa-del-sol/' },
	{ en: '/launch/', es: '/es/lanza-tu-agencia/' },
	{ en: '/free/', es: '/es/gratis/' },
	{ en: '/instant-brochure/', es: '/es/folleto-instantaneo/' },
	{ en: '/instant-video/', es: '/es/video-instantaneo/' },
	{ en: '/instant-images/', es: '/es/imagenes-instantaneas/' },
	{ en: '/map/', es: '/es/mapa/' },
	{ en: '/hours/', es: '/es/horas/' },
	{ en: '/budget/', es: '/es/presupuesto/' },
	{ en: '/360-walkthrough/', es: '/es/recorrido-360/' },
	{ en: '/what-we-do/', es: '/es/que-hacemos/' },
	{ en: '/search', es: '/es/search' },
];

const toEnglishSwitchPath = (p: string) => {
	const path = String(p || '');
	if (!path.startsWith('/es/')) return path;
	{ const _n = path.endsWith('/') ? path : path + '/'; if (_n === '/es/blog/como-evitar-estafas-inmobiliarias-en-espana/') return '/blog/how-to-avoid-property-scams-in-spain/'; }
	if (path.startsWith('/es/docs/')) return mapDocsToEnglish(path);
	if (path.startsWith('/es/barrios/')) {
		const parts = path.split('/').filter(Boolean);
		const slug = parts.length >= 3 ? parts[2] : '';
		return slug ? canonicalAreaPath(slug) : '/neighbourhood/';
	}
	const _np = path.endsWith('/') ? path : path + '/';
	for (const pair of mapPairs) {
		if (_np.startsWith(pair.es)) return `${pair.en}${_np.slice(pair.es.length)}`;
	}
	return path.replace(/^\/es\//, '/');
};

const toSpanishSwitchPath = (p: string) => {
	const path = String(p || '');
	if (path.startsWith('/es/')) return path;
	{ const _n = path.endsWith('/') ? path : path + '/'; if (_n === '/blog/how-to-avoid-property-scams-in-spain/') return '/es/blog/como-evitar-estafas-inmobiliarias-en-espana/'; }
	if (path.startsWith('/docs/')) return mapDocsToSpanish(path);
	if (path.startsWith('/neighbourhood/')) {
		const parts = path.split('/').filter(Boolean);
		const slug = parts.length >= 4 ? parts[3] : (parts.length === 2 && parts[1] !== 'andalucia' && parts[1] !== 'spain' ? parts[1] : '');
		return slug ? `/es/barrios/${slug}/` : '/es/barrios/';
	}
	const _np = path.endsWith('/') ? path : path + '/';
	for (const pair of mapPairs) {
		if (_np.startsWith(pair.en)) return `${pair.es}${_np.slice(pair.en.length)}`;
	}
	return `/es${path}`;
};

const enHreflang = (hreflangs || []).find((h) => h.hreflang === 'en')?.href;
const esHreflang = (hreflangs || []).find((h) => h.hreflang === 'es')?.href;
const deHreflang = (hreflangs || []).find((h) => h.hreflang === 'de')?.href;
const enPath = lang === 'de' ? (enHreflang ?? '/') : toEnglishSwitchPath(pathname);
const esPath = lang === 'de' ? (esHreflang ?? '/es/') : toSpanishSwitchPath(pathname);
const deSwitchHref = deHreflang ?? '/de/';

const searchQ = (Astro.url.searchParams.get('q') || '').trim();

const canonicalUrl = normalizeCanonical(canonical) ?? (siteOrigin && Astro.url ? `${siteOrigin}${Astro.url.pathname}` : null);
const hreflangLinks = hreflangs.map((h) => ({ ...h, href: normalizeCanonical(h.href) ?? h.href }));

const effectiveRobots = robots ? robots : isAdminPath ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const effectiveOgUrl = canonicalUrl ?? toAbsoluteUrl(Astro.url?.pathname ? `${siteOrigin}${Astro.url.pathname}` : null);
const effectiveOgImage = toAbsoluteUrl(ogImage) || `${siteOrigin}/og/og-brand.png`;

const effectiveOgType = String(ogType || '').trim() || 'website';
const effectiveTwitterCard: 'summary' | 'summary_large_image' = twitterCard
	? twitterCard
	: effectiveOgImage
		? 'summary_large_image'
		: 'summary';

const ogLocale = lang === 'de' ? 'de_DE' : lang === 'es' ? 'es_ES' : 'en_GB';
const ogLocaleAlternate = lang === 'es' ? 'en_GB' : 'es_ES';

const organizationLd = siteOrigin
	? {
			'@context': 'https://schema.org',
			'@type': 'Organization',
			name: 'PropertyList',
			url: 'https://propertylist.es/',
			logo: `${siteOrigin}${logo}`,
			description:
				'Spain\'s free Smart MLS, CRM and public property portal for estate agents - agent-to-agent collaboration, AI tools, and notary-verified market data.',
			sameAs: [
				'https://www.instagram.com/propertylist.es',
				'https://www.facebook.com/propertyList.es/',
			],
		}
	: null;

const websiteLd = siteOrigin
	? {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: 'PropertyList Info Hub',
			url: siteOrigin,
			potentialAction: {
				'@type': 'SearchAction',
				target: `${siteOrigin}/search/?q={search_term_string}`,
				'query-input': 'required name=search_term_string',
			},
		}
	: null;

const webpageLd = canonicalUrl
	? {
			'@context': 'https://schema.org',
			'@type': 'WebPage',
			name: pageTitle,
			description,
			url: canonicalUrl,
			inLanguage: lang === 'en' ? 'en-GB' : lang,
			isPartOf: siteOrigin ? { '@type': 'WebSite', url: siteOrigin, name: 'PropertyList Info Hub' } : undefined,
			publisher: organizationLd ? { '@type': 'Organization', name: 'PropertyList' } : undefined,
		}
	: null;

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const defaultSchemaList = [organizationLd, websiteLd, webpageLd].filter(Boolean);
const defaultLdJson = !isAdminPath ? JSON.stringify([...defaultSchemaList, ...extraSchemas]) : null;

const GA_MEASUREMENT_ID = (() => {
	const raw = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
	if (raw) return raw;
	return import.meta.env.DEV ? 'G-GJXF83J7WE' : '';
})();
const gaEnabled = !isAdminPath && /^G-[A-Z0-9]+$/i.test(GA_MEASUREMENT_ID);
const consentEnabled = gaEnabled;

const htmlLang = Astro.url.pathname.startsWith('/es/') ? 'es' : lang === 'en' ? 'en-GB' : lang;
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{isHomePath ? <meta name="msvalidate.01" content="857E5CCA77840A51978AD13A8D53D0B5" /> : null}
		<link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#00ae9a" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{description ? <meta name="description" content={description} /> : null}
		{effectiveRobots ? <meta name="robots" content={effectiveRobots} /> : null}
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
		{defaultLdJson ? <script type="application/ld+json" is:inline set:html={defaultLdJson} /> : null}
		{isAdminPath ? null : (
			<>
				<meta property="og:site_name" content="PropertyList Info Hub" />
				<meta property="og:locale" content={ogLocale} />
				<meta property="og:locale:alternate" content={ogLocaleAlternate} />
				<meta property="og:title" content={pageTitle} />
				{description ? <meta property="og:description" content={description} /> : null}
				{effectiveOgUrl ? <meta property="og:url" content={effectiveOgUrl} /> : null}
				<meta property="og:type" content={effectiveOgType} />
				{effectiveOgImage ? <meta property="og:image" content={effectiveOgImage} /> : null}
				{/* Scrapers need the dimensions declared or they fall back to another
				    image on the page rather than measure ours: WhatsApp was previewing
				    /hours/ with a cropped seasonal wordmark. Every card we generate is
				    1200x630, and so is the brand default. */}
				{effectiveOgImage ? <meta property="og:image:width" content="1200" /> : null}
				{effectiveOgImage ? <meta property="og:image:height" content="630" /> : null}
				{effectiveOgImage ? <meta property="og:image:type" content="image/png" /> : null}
				<meta name="twitter:card" content={effectiveTwitterCard} />
				<meta name="twitter:title" content={pageTitle} />
				{description ? <meta name="twitter:description" content={description} /> : null}
				{effectiveOgImage ? <meta name="twitter:image" content={effectiveOgImage} /> : null}
			</>
		)}
		{gaEnabled ? (
			<>
				<script
					is:inline
					set:html={`
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
var plGaDebug = false;
try { plGaDebug = /(?:\\?|&)ga_debug=1(?:&|$)/.test(String(location && location.search || '')); } catch(e) {}
gtag('consent', 'default', {
  ad_storage: 'denied',
  analytics_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  wait_for_update: 750
});
try {
  var v = localStorage.getItem('pl_ga_consent') || '';
  if (v === 'granted') {
    gtag('consent', 'update', {
      ad_storage: 'denied',
      analytics_storage: 'granted',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
  }
} catch(e) {}
gtag('js', new Date());
var plGaCfg = { send_page_view: true };
if (plGaDebug) plGaCfg.debug_mode = true;
gtag('config', '${GA_MEASUREMENT_ID.replace(/'/g, "\\'")}', plGaCfg);
`}
				/>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(GA_MEASUREMENT_ID)}`}></script>
			</>
		) : null}
		{/* Umami self-hosted analytics - cookieless, no persistent identifiers, first-party proxied */}
		{isAdminPath ? null : <script defer src="/pl-stats.js?v=1" data-website-id="8dca1470-b6ff-4dd5-9052-4ca9b8690135"></script>}
		{isAdminPath ? null : <script is:inline src="//code.tidio.co/4pmcnp7kmt1ew2g0x5rgmhiopejtxvv6.js" async></script>}
		{!isAdminPath ? (
			<script is:inline>
				(function(c,l,a,r,i,t,y){
					c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
					t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
					y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
				})(window, document, "clarity", "script", "w55lwt90on");
			</script>
		) : null}
		<slot name="head" />
		{hreflangLinks.map((h) => (
			<link rel="alternate" hreflang={h.hreflang} href={h.href} />
		))}
	</head>
	<body>
		<a class="skipLink" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
		{minimal ? null : (
			<>
				<header class="header">
					<div class="headerInner">
						<nav class="nav" aria-label="Primary">
							<div class="brand">
								<a class="brandLogoLink" href="https://info.propertylist.es/">
									<img
										class="brandLogo brandLogo--wide"
										src={logo}
										alt="PropertyList"
										width="497"
										height="160"
										loading="eager"
										decoding="async"
									/>
									<img
										class="brandLogo brandLogo--icon"
										src={icon}
										alt="PropertyList"
										width="200"
										height="200"
										loading="eager"
										decoding="async"
									/>
								</a>
							</div>
							<a class="brandText brandText--centered" href="https://propertylist.es/">{lang === 'de' ? 'Immobiliensuche' : lang === 'es' ? 'Buscar propiedades' : 'Property Search'}</a>
							<div class="navLinks">
								<div class="navDrop">
									<button class="navDropBtn" type="button" aria-haspopup="true" aria-expanded="false">
										{lang === 'de' ? 'Produkt' : lang === 'es' ? 'Producto' : 'Product'}
										<svg class="navDropChev" viewBox="0 0 16 16" width="13" height="13" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
									</button>
									<div class="navDropMenu navDropMenu--mega" role="menu">
										<div class="ndCols">
											<div class="ndCol">
												<div class="ndHead">{lang === 'de' ? 'Plattform' : lang === 'es' ? 'Plataforma' : 'Platform'}</div>
												<a role="menuitem" href={lang === 'es' ? '/es/que-hacemos/' : '/what-we-do/'}>{lang === 'de' ? 'Was wir machen' : lang === 'es' ? 'Qué hacemos' : 'What is PropertyList?'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/funciones/' : '/features/'}>{lang === 'de' ? 'Funktionen' : lang === 'es' ? 'Funciones' : 'Features'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/gratis/' : '/free/'}>{lang === 'de' ? 'Kostenlos - alles inklusive' : lang === 'es' ? 'Todo gratis' : "What's free"}</a>
												<a role="menuitem" href="https://agents.propertylist.es/">{lang === 'es' ? 'MLS (compartir propiedades)' : 'MLS (Property Sharing)'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/busqueda-ia/' : '/ai-property-search/'}>{lang === 'de' ? 'KI-Immobiliensuche' : lang === 'es' ? 'Búsqueda con IA' : 'AI Property Search'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/app-movil/' : '/mobile-app/'}>{lang === 'de' ? 'Mobile-App' : lang === 'es' ? 'App móvil' : 'Mobile App'}</a>
											</div>
											<div class="ndCol">
												<div class="ndHead">{lang === 'de' ? 'Agentur-Betrieb' : lang === 'es' ? 'Tu agencia al día' : 'Run your agency'}</div>
												<a role="menuitem" href={lang === 'es' ? '/es/pipelines/' : '/pipelines/'}>Pipelines</a>
												<a role="menuitem" href={lang === 'es' ? '/es/nurture/' : '/nurture/'}>Nurture</a>
												<a role="menuitem" href={lang === 'es' ? '/es/alquileres/' : '/rentals/'}>{lang === 'de' ? 'Mietobjekte' : lang === 'es' ? 'Alquileres' : 'Rentals'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/alquiler-vacacional/' : '/holiday-rentals/'}>{lang === 'es' ? 'Alquiler vacacional' : 'Holiday lets'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/constructor-de-webs/' : '/website-builder/'}>{lang === 'de' ? 'Website-Baukasten' : lang === 'es' ? 'Creador de webs' : 'Website Builder'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/informe-inteligencia-propiedad/' : '/property-intelligence-report/'}>{lang === 'de' ? 'Immobilien-Analysebericht' : lang === 'es' ? 'Informe de Inteligencia' : 'Property Intelligence Report'}</a>
											</div>
											<div class="ndCol">
												<div class="ndHead">{lang === 'de' ? 'Instant-KI-Tools' : lang === 'es' ? 'Herramientas Instant' : 'Instant AI tools'}</div>
												<a role="menuitem" href={lang === 'es' ? '/es/listado-instantaneo/' : '/instant-listing/'}>{lang === 'de' ? 'Instant Listing' : lang === 'es' ? 'Listado Instantáneo' : 'Instant Listing'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/contenido-instantaneo/' : '/instant-content/'}>{lang === 'de' ? 'Instant Content' : lang === 'es' ? 'Contenido Instantáneo' : 'Instant Content'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/folleto-instantaneo/' : '/instant-brochure/'}>{lang === 'de' ? 'Instant Brochure' : lang === 'es' ? 'Folleto Instantáneo' : 'Instant Brochure'}</a>
												<a role="menuitem" href={lang === 'es' ? '/es/imagenes-instantaneas/' : '/instant-images/'}>{lang === 'de' ? 'Instant Images' : lang === 'es' ? 'Imágenes Instantáneas' : 'Instant Images'}</a>
