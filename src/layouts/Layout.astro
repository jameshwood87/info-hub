---
type HreflangLink = { hreflang: string; href: string };

type Props = {
	lang?: string;
	title?: string;
	description?: string;
	canonical?: string;
	hreflangs?: HreflangLink[];
	robots?: string;
	ogImage?: string;
	ogType?: string;
	twitterCard?: 'summary' | 'summary_large_image';
	schema?: unknown;
	minimal?: boolean;
};

const {
	lang = 'en',
	title = 'PropertyList Info Hub',
	description,
	canonical,
	hreflangs = [],
	robots,
	ogImage,
	ogType,
	twitterCard,
	schema,
	minimal = false,
} = Astro.props;

const stripInfoHubSuffix = (s: string) => String(s || '').replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '').trim();
const pageTitle = stripInfoHubSuffix(title) || 'PropertyList Info Hub';

const configuredSiteUrl = String(import.meta.env.PUBLIC_SITE_URL || '').trim();
const requestOrigin = Astro.url ? `${Astro.url.protocol}//${Astro.url.host}` : '';
const siteOrigin = configuredSiteUrl || requestOrigin;

const toAbsoluteUrl = (value: string | undefined | null) => {
	const raw = String(value || '').trim();
	if (!raw) return null;
	if (!siteOrigin) return raw;
	if (/^https?:\/\//i.test(raw)) return normalizeCanonical(raw) ?? raw;
	if (raw.startsWith('/')) return `${siteOrigin}${raw}`;
	return raw;
};

const normalizeCanonical = (value?: string) => {
	if (!value) return null;
	if (!siteOrigin) return value;
	try {
		const u = new URL(value);
		u.protocol = new URL(siteOrigin).protocol;
		u.host = new URL(siteOrigin).host;
		return u.toString();
	} catch {
		return value;
	}
};

const pathname = Astro.url?.pathname ?? '/';
const isAdminPath = pathname === '/admin' || pathname.startsWith('/admin/');
const isHomePath = pathname === '/' || pathname === '/es/';
const mapDocsToEnglish = (p: string) => {
	const path = String(p || '');
	if (!path.startsWith('/es/docs/')) return path;
	const withoutEs = path.replace(/^\/es\//, '/');
	const parts = withoutEs.split('/').filter(Boolean);
	const seg = parts[1] || '';
	const mapped =
		seg === 'propertylist-mls-manual-de-usuario'
			? 'propertylist-mls-user-manual'
			: seg === 'leyes-procedimientos'
				? 'laws-procedures'
				: seg === 'portal-publico'
					? 'public-portal'
					: seg === 'empezar'
						? 'getting-started'
						: seg;
	parts[1] = mapped;
	return `/${parts.join('/')}/`;
};

const mapDocsToSpanish = (p: string) => {
	const path = String(p || '');
	if (!path.startsWith('/docs/')) return path;
	const parts = path.split('/').filter(Boolean);
	const seg = parts[1] || '';
	const mapped =
		seg === 'propertylist-mls-user-manual'
			? 'propertylist-mls-manual-de-usuario'
			: seg === 'laws-procedures'
				? 'leyes-procedimientos'
				: seg === 'public-portal'
					? 'portal-publico'
					: seg === 'getting-started'
						? 'empezar'
						: seg;
	parts[1] = mapped;
	return `/es/${parts.join('/')}/`;
};

const mapPairs: Array<{ en: string; es: string }> = [
	{ en: '/about-us', es: '/es/sobre-nosotros/' },
	{ en: '/about-us/', es: '/es/sobre-nosotros/' },
	{ en: '/about-us/', es: '/es/sobre-nosotros' },
	{ en: '/blog/', es: '/es/informacion-general/' },
	{ en: '/general-information/', es: '/es/informacion-general/' },
	{ en: '/community/', es: '/es/comunidad/' },
	{ en: '/laws/', es: '/es/leyes/' },
	{ en: '/neighbourhood/', es: '/es/barrios/' },
	{ en: '/mls/', es: '/es/mls/' },
	{ en: '/pricing/', es: '/es/pricing/' },
	{ en: '/search', es: '/es/search' },
];

const toEnglishSwitchPath = (p: string) => {
	const path = String(p || '');
	if (!path.startsWith('/es/')) return path;
	if (path.startsWith('/es/docs/')) return mapDocsToEnglish(path);
	for (const pair of mapPairs) {
		if (path.startsWith(pair.es)) return `${pair.en}${path.slice(pair.es.length)}`;
	}
	return path.replace(/^\/es\//, '/');
};

const toSpanishSwitchPath = (p: string) => {
	const path = String(p || '');
	if (path.startsWith('/es/')) return path;
	if (path.startsWith('/docs/')) return mapDocsToSpanish(path);
	for (const pair of mapPairs) {
		if (path.startsWith(pair.en)) return `${pair.es}${path.slice(pair.en.length)}`;
	}
	return `/es${path}`;
};

const enPath = toEnglishSwitchPath(pathname);
const esPath = toSpanishSwitchPath(pathname);

const searchQ = (Astro.url.searchParams.get('q') || '').trim();

const canonicalUrl = normalizeCanonical(canonical) ?? (siteOrigin && Astro.url ? `${siteOrigin}${Astro.url.pathname}` : null);
const hreflangLinks = hreflangs.map((h) => ({ ...h, href: normalizeCanonical(h.href) ?? h.href }));

const effectiveRobots = robots ? robots : isAdminPath ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const effectiveOgUrl = canonicalUrl ?? toAbsoluteUrl(Astro.url?.pathname ? `${siteOrigin}${Astro.url.pathname}` : null);
const effectiveOgType = String(ogType || '').trim() || 'website';
// Seasonal OG image selection based on date
const getSeasonalOgImage = () => {
	const now = new Date();
	const month = now.getMonth() + 1; // 1-12
	const day = now.getDate();
	// Christmas: Dec 1 - Jan 6
	if ((month === 12 && day >= 1) || (month === 1 && day <= 6)) return "/og/og-christmas.png";
	// St. Patrick's: Mar 15-18
	if (month === 3 && day >= 15 && day <= 18) return "/og/og-stpatricks.png";
	// Easter: approximate (late March to mid April)
	if (month === 3 && day >= 20) return "/og/og-easter.png";
	if (month === 4 && day <= 15) return "/og/og-easter.png";
	return "/og/og-default.png";
};
const defaultOgImage = siteOrigin ? `${siteOrigin}${getSeasonalOgImage()}` : null;
const effectiveOgImage = toAbsoluteUrl(ogImage) ?? defaultOgImage;
const effectiveTwitterCard: 'summary' | 'summary_large_image' = twitterCard
	? twitterCard
	: effectiveOgImage
		? 'summary_large_image'
		: 'summary';

const ogLocale = lang === 'es' ? 'es_ES' : 'en_GB';
const ogLocaleAlternate = lang === 'es' ? 'en_GB' : 'es_ES';

const organizationLd = siteOrigin
	? {
			'@context': 'https://schema.org',
			'@type': 'Organization',
			name: 'PropertyList',
			url: 'https://propertylist.es/',
			logo: `${siteOrigin}/logo-black.png`,
		}
	: null;

const websiteLd = siteOrigin
	? {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: 'PropertyList Info Hub',
			url: siteOrigin,
			potentialAction: {
				'@type': 'SearchAction',
				target: `${siteOrigin}/search?q={search_term_string}`,
				'query-input': 'required name=search_term_string',
			},
		}
	: null;

const webpageLd = canonicalUrl
	? {
			'@context': 'https://schema.org',
			'@type': 'WebPage',
			name: pageTitle,
			description,
			url: canonicalUrl,
			inLanguage: lang === 'en' ? 'en-GB' : lang,
			isPartOf: siteOrigin ? { '@type': 'WebSite', url: siteOrigin, name: 'PropertyList Info Hub' } : undefined,
			publisher: organizationLd ? { '@type': 'Organization', name: 'PropertyList' } : undefined,
		}
	: null;

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const defaultSchemaList = [organizationLd, websiteLd, webpageLd].filter(Boolean);
const defaultLdJson = !isAdminPath ? JSON.stringify([...defaultSchemaList, ...extraSchemas]) : null;

const GA_MEASUREMENT_ID = (() => {
	const raw = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
	if (raw) return raw;
	return import.meta.env.DEV ? 'G-GJXF83J7WE' : '';
})();
const gaEnabled = !isAdminPath && /^G-[A-Z0-9]+$/i.test(GA_MEASUREMENT_ID);
const consentEnabled = gaEnabled;

const htmlLang = Astro.url.pathname.startsWith('/es/') ? 'es' : lang === 'en' ? 'en-GB' : lang;
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{isHomePath ? <meta name="msvalidate.01" content="857E5CCA77840A51978AD13A8D53D0B5" /> : null}
		<link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#00ae9a" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{description ? <meta name="description" content={description} /> : null}
		{effectiveRobots ? <meta name="robots" content={effectiveRobots} /> : null}
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
		{defaultLdJson ? <script type="application/ld+json" is:inline set:html={defaultLdJson} /> : null}
		{isAdminPath ? null : (
			<>
				<meta property="og:site_name" content="PropertyList Info Hub" />
				<meta property="og:locale" content={ogLocale} />
				<meta property="og:locale:alternate" content={ogLocaleAlternate} />
				<meta property="og:title" content={pageTitle} />
				{description ? <meta property="og:description" content={description} /> : null}
				{effectiveOgUrl ? <meta property="og:url" content={effectiveOgUrl} /> : null}
				<meta property="og:type" content={effectiveOgType} />
				{effectiveOgImage ? <meta property="og:image" content={effectiveOgImage} /> : null}
				<meta name="twitter:card" content={effectiveTwitterCard} />
				<meta name="twitter:title" content={pageTitle} />
				{description ? <meta name="twitter:description" content={description} /> : null}
				{effectiveOgImage ? <meta name="twitter:image" content={effectiveOgImage} /> : null}
			</>
		)}
		{gaEnabled ? (
			<>
				<script
					is:inline
					set:html={`
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
var plGaDebug = false;
try { plGaDebug = /(?:\\?|&)ga_debug=1(?:&|$)/.test(String(location && location.search || '')); } catch(e) {}
gtag('consent', 'default', {
  ad_storage: 'denied',
  analytics_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  wait_for_update: 750
});
try {
  var v = localStorage.getItem('pl_ga_consent') || '';
  if (v === 'granted') {
    gtag('consent', 'update', {
      ad_storage: 'denied',
      analytics_storage: 'granted',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
  }
} catch(e) {}
gtag('js', new Date());
var plGaCfg = { send_page_view: true };
if (plGaDebug) plGaCfg.debug_mode = true;
gtag('config', '${GA_MEASUREMENT_ID.replace(/'/g, "\\'")}', plGaCfg);
`}
				/>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(GA_MEASUREMENT_ID)}`}></script>
			</>
		) : null}
		{isAdminPath ? null : <script is:inline src="//code.tidio.co/4pmcnp7kmt1ew2g0x5rgmhiopejtxvv6.js" async></script>}
		<slot name="head" />
		{hreflangLinks.map((h) => (
			<link rel="alternate" hreflang={h.hreflang} href={h.href} />
		))}
	</head>
	<body>
		<a class="skipLink" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
		{minimal ? null : (
			<>
				<header class="header">
					<nav class="nav" aria-label="Primary">
						<div class="brand">
							<a class="brandLogoLink" href="https://propertylist.es/">
								<img
									class="brandLogo"
									src="/logo-black.png"
									alt="PropertyList"
									width="200"
									height="40"
									loading="eager"
									decoding="async"
								/>
							</a>
							<a class="brandText" href={lang === 'es' ? '/es/' : '/'}>Info Hub</a>
						</div>
						<div class="navLinks">
							<a href={lang === 'es' ? '/es/docs/' : '/docs/'}>Docs</a>
							<a href={lang === 'es' ? '/es/informacion-general/' : '/blog/'}>{lang === 'es' ? 'Noticias' : 'Blog'}</a>
							<a href={lang === 'es' ? '/es/pricing/' : '/pricing/'}>{lang === 'es' ? 'Precios' : 'Pricing'}</a>
							<a href={lang === 'es' ? '/es/sobre-nosotros/' : '/about-us/'}>{lang === 'es' ? 'Sobre' : 'About'}</a>
						</div>
						<form class="navSearch" method="get" action={lang === 'es' ? '/es/search' : '/search'} role="search">
							<input
								class="navSearchInput"
								type="search"
								name="q"
								value={searchQ}
								placeholder={lang === 'es' ? 'Buscar en la documentación' : 'Search documentation'}
								aria-label={lang === 'es' ? 'Buscar' : 'Search'}
								autocomplete="off"
								spellcheck="false"
								data-header-search
								data-search-lang={lang === 'es' ? 'es' : 'en'}
								data-search-prefix={lang === 'es' ? '/es/docs/' : '/docs/'}
								data-search-page={lang === 'es' ? '/es/search' : '/search'}
								role="combobox"
								aria-autocomplete="list"
								aria-expanded="false"
								aria-controls="header-search-listbox"
							/>
							<button class="navSearchBtn" type="submit">
								{lang === 'es' ? 'Buscar' : 'Search'}
							</button>
							<div class="navSearchMenu" data-header-search-menu hidden></div>
						</form>
						<div class="navLang" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
							<a class:list={['navLangLink', lang === 'en' ? 'isActive' : null]} href={enPath} hreflang="en">
								EN
							</a>
							<a class:list={['navLangLink', lang === 'es' ? 'isActive' : null]} href={esPath} hreflang="es">
								ES
							</a>
						</div>
						<div class="navCtas">
							<button class="navAuthBtn" type="button" data-auth-open>
								{lang === 'es' ? 'Entrar / Crear cuenta' : 'Sign in / Sign up'}
							</button>
							<button class="navMenuBtn" type="button" data-mobile-menu-open aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}>
								<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M5 7h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
									<path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
									<path d="M5 17h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
								</svg>
							</button>
						</div>
					</nav>
				</header>
				<div class="mobileMenuOverlay" data-mobile-menu-overlay hidden>
					<div class="mobileMenuDrawer" role="dialog" aria-modal="true" aria-label={lang === 'es' ? 'Menú' : 'Menu'} tabindex="-1">
						<div class="mobileMenuHeader">
							<div class="mobileMenuTitle">{lang === 'es' ? 'Menú' : 'Menu'}</div>
							<button class="mobileMenuClose" type="button" data-mobile-menu-close aria-label={lang === 'es' ? 'Cerrar' : 'Close'}>
								{lang === 'es' ? 'Cerrar' : 'Close'}
							</button>
						</div>
						<nav class="mobileMenuLinks" aria-label={lang === 'es' ? 'Enlaces del menú' : 'Menu links'}>
							<button class="mobileMenuAuth" type="button" data-auth-open>
								{lang === 'es' ? 'Entrar / Crear cuenta' : 'Sign in / Sign up'}
							</button>
							<a href={lang === 'es' ? '/es/' : '/'}>{lang === 'es' ? 'Inicio' : 'Home'}</a>
							<a href={lang === 'es' ? '/es/docs/' : '/docs/'}>Docs</a>
							<a href={lang === 'es' ? '/es/informacion-general/' : '/blog/'}>{lang === 'es' ? 'Noticias' : 'Blog'}</a>
							<a href={lang === 'es' ? '/es/pricing/' : '/pricing/'}>{lang === 'es' ? 'Precios' : 'Pricing'}</a>
							<a href={lang === 'es' ? '/es/sobre-nosotros/' : '/about-us/'}>{lang === 'es' ? 'Sobre nosotros' : 'About us'}</a>
							<div class="mobileLang">
								<a class:list={['mobileLangLink', lang === 'en' ? 'isActive' : null]} href={enPath} hreflang="en">
									EN
								</a>
								<a class:list={['mobileLangLink', lang === 'es' ? 'isActive' : null]} href={esPath} hreflang="es">
									ES
								</a>
							</div>
						</nav>
					</div>
				</div>
				<div class="authOverlay" data-auth-overlay hidden>
					<div class="authModal" role="dialog" aria-modal="true" aria-label={lang === 'es' ? 'Entrar o crear cuenta' : 'Sign in or sign up'} tabindex="-1">
						<div class="authModalHead">
							<div class="authModalTitle">{lang === 'es' ? 'Entrar / Crear cuenta' : 'Sign in / Sign up'}</div>
							<button class="authModalClose" type="button" data-auth-close aria-label={lang === 'es' ? 'Cerrar' : 'Close'}>
								{lang === 'es' ? 'Cerrar' : 'Close'}
							</button>
						</div>
						<div class="authModalBody">
							<a class="authChoice" href="https://agents.propertylist.es/login">
								<div class="authChoiceTitle">{lang === 'es' ? 'Freelancer / Agencia inmobiliaria' : 'Freelancer / Estate Agency'}</div>
								<div class="authChoiceDesc">{lang === 'es' ? 'Acceso de agentes' : 'Agent login'}</div>
							</a>
							<a class="authChoice" href="https://developers.propertylist.es/login">
								<div class="authChoiceTitle">{lang === 'es' ? 'Developer' : 'Developer'}</div>
								<div class="authChoiceDesc">{lang === 'es' ? 'Acceso de developers' : 'Developer login'}</div>
							</a>
						</div>
					</div>
				</div>
			</>
		)}
		<main id="main" class="main">
			<slot />
		</main>
		{minimal ? null : (
			<footer class="footer">
				<div class="footerInner">
				<div class="footerLeft">
					<div class="footerBrand">PropertyList Info Hub</div>
					<div class="footerNote">
						{lang === 'es'
							? 'Guías y documentación para ayudar a agentes, agencias y propietarios.'
							: 'Guides and documentation to help agents, agencies, and property owners.'}
					</div>
				</div>
				<div class="footerLinks" aria-label="Footer">
					<a href={lang === 'es' ? '/es/docs/' : '/docs/'}>Docs</a>
					<a href={lang === 'es' ? '/es/faq/' : '/faq/'}>{lang === 'es' ? 'FAQ' : 'FAQ'}</a>
					<a href={lang === 'es' ? '/es/informacion-general/' : '/blog/'}>{lang === 'es' ? 'Noticias' : 'Blog'}</a>
					<a href={lang === 'es' ? '/es/pricing/' : '/pricing/'}>{lang === 'es' ? 'Precios' : 'Pricing'}</a>
					<a href={lang === 'es' ? '/es/sobre-nosotros/' : '/about-us/'}>{lang === 'es' ? 'Sobre nosotros' : 'About us'}</a>
					<a href="https://agents.propertylist.es/">Agents Log in</a>
					<a href="https://developers.propertylist.es/login">Developers Login</a>
					<a href={lang === 'es' ? '/es/docs/propertylist-mls-manual-de-usuario/privacy-policy/' : '/docs/propertylist-mls-user-manual/privacy-policy/'}>
						{lang === 'es' ? 'Política de privacidad' : 'Privacy Policy'}
					</a>
					<a href={lang === 'es' ? '/es/docs/propertylist-mls-manual-de-usuario/terms-conditions/' : '/docs/propertylist-mls-user-manual/terms-conditions/'}>
						{lang === 'es' ? 'Términos y condiciones' : 'Terms & Conditions'}
					</a>
					<a href="https://propertylist.es/">Search Properties</a>
				</div>
			</div>
			</footer>
		)}
		{consentEnabled ? (
			<div class="gaConsent" data-ga-consent hidden>
				<div class="gaConsentInner" role="region" aria-label="Cookies">
					<div class="gaConsentText">
						<strong>Cookies</strong>
						<div>We use analytics cookies to understand usage and improve the site.</div>
					</div>
					<div class="gaConsentActions">
						<button type="button" class="gaConsentBtn" data-ga-consent-accept>
							Accept
						</button>
						<button type="button" class="gaConsentBtn secondary" data-ga-consent-reject>
							Reject
						</button>
					</div>
				</div>
			</div>
		) : null}
		{gaEnabled ? (
			<script
				is:inline
				set:html={`
(function(){
  function safeGtag(){ try { if (typeof window.gtag === 'function') window.gtag.apply(null, arguments); } catch(e) {} }
  function safeText(s, max){
    var t = (s == null ? '' : String(s)).replace(/\\s+/g, ' ').trim();
    if (!t) return '';
    var n = Math.max(1, Number(max) || 120);
    if (t.length > n) t = t.slice(0, n).trim();
    return t;
  }
  function isEmailLike(s){ return /@/.test(s) || /\\b[^\\s@]+@[^\\s@]+\\.[^\\s@]+\\b/.test(s); }
  function isPhoneLike(s){ var d = String(s || '').replace(/[^0-9]/g, ''); return d.length >= 7; }
  function pageLocation(el){
    try {
      if (el && el.closest && el.closest('.header')) return 'header';
      if (el && el.closest && el.closest('.footer')) return 'footer';
    } catch(e) {}
    return 'content';
  }
  function isOutbound(href){ try { var u = new URL(href, window.location.href); return u.origin !== window.location.origin; } catch(e) { return false; } }
  function targetApp(url){
    try {
      var u = new URL(url);
      var host = u.hostname.toLowerCase();
      var path = u.pathname || '/';
      if (host === 'agents.propertylist.es') return 'agents';
      if (host === 'developers.propertylist.es') return 'developers';
      if (host === 'propertylist.es') return path.indexOf('/portal/') === 0 ? 'portal' : 'propertylist';
      return 'external';
    } catch(e) { return 'external'; }
  }
  function campaignFromPath(path){
    var p = String(path || '').replace(/\/+$/, '/') || '/';
    if (p.indexOf('/neighbourhood/') === 0 || p.indexOf('/es/barrios/') === 0) return 'neighbourhood';
    if (p.indexOf('/docs/') === 0 || p.indexOf('/es/docs/') === 0) return 'docs';
    if (p.indexOf('/blog/') === 0 || p.indexOf('/es/informacion-general/') === 0) return 'blog';
    if (p.indexOf('/pricing/') === 0 || p.indexOf('/es/pricing/') === 0) return 'pricing';
    if (p.indexOf('/search') === 0 || p.indexOf('/es/search') === 0) return 'search';
    return 'content';
  }
  function addUtm(url, loc){
    try {
