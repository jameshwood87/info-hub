---
type HreflangLink = { hreflang: string; href: string };

type Props = {
	lang?: string;
	title?: string;
	description?: string;
	canonical?: string;
	hreflangs?: HreflangLink[];
};

const {
	lang = 'en',
	title = 'PropertyList Info Hub',
	description,
	canonical,
	hreflangs = [],
} = Astro.props;

const pathname = Astro.url?.pathname ?? '/';
const enPath = pathname.startsWith('/es/') ? pathname.replace(/^\/es\//, '/') : pathname;
const esPath = pathname.startsWith('/es/') ? pathname : `/es${pathname}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#00ae9a" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description ? <meta name="description" content={description} /> : null}
		{canonical ? <link rel="canonical" href={canonical} /> : null}
		{hreflangs.map((h) => (
			<link rel="alternate" hreflang={h.hreflang} href={h.href} />
		))}
	</head>
	<body>
		<header class="header">
			<nav class="nav" aria-label="Primary">
				<a class="brand" href={lang === 'es' ? '/es/' : '/'}>
					<img
						class="brandLogo"
						src="/logo-black.png"
						alt="PropertyList"
						width="160"
						height="32"
						loading="eager"
						decoding="async"
					/>
					<span class="brandText">Info Hub</span>
				</a>
				<div class="navLinks">
					<a href={lang === 'es' ? '/es/docs/' : '/docs/'}>Docs</a>
					<a href={lang === 'es' ? '/es/mls/' : '/mls/'}>MLS</a>
					<a href={lang === 'es' ? '/es/leyes/' : '/laws/'}>Laws</a>
					<a href={lang === 'es' ? '/es/informacion-general/' : '/general-information/'}>News</a>
					<a href={lang === 'es' ? '/es/search' : '/search'}>Search</a>
				</div>
				<div class="navCtas">
					<a class="btn" href={lang === 'es' ? '/es/docs/' : '/docs/'}>Browse</a>
					<a class="lang" href={lang === 'es' ? enPath : esPath} aria-label={lang === 'es' ? 'Switch to English' : 'Cambiar a Español'}>
						{lang === 'es' ? 'EN' : 'ES'}
					</a>
				</div>
			</nav>
		</header>
		<main class="main">
			<slot />
		</main>
		<footer class="footer">
			<div class="footerInner">
				<div class="footerLeft">
					<div class="footerBrand">PropertyList Info Hub</div>
					<div class="footerNote">
						{lang === 'es'
							? 'Guías y documentación para ayudar a agentes, agencias y propietarios.'
							: 'Guides and documentation to help agents, agencies, and property owners.'}
					</div>
				</div>
				<div class="footerLinks" aria-label="Footer">
					<a href={lang === 'es' ? '/es/docs/' : '/docs/'}>Docs</a>
					<a href={lang === 'es' ? '/es/search' : '/search'}>Search</a>
					<a href={lang === 'es' ? '/es/informacion-general/' : '/general-information/'}>News</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	:global(:root) {
		--accent: #00ae9a;
		--accent-rgb: 0, 174, 154;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #f6f8fc;
		color: #0b1220;
		font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
	}

	.header {
		position: sticky;
		top: 0;
		background: rgba(246, 248, 252, 0.8);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(11, 18, 32, 0.08);
		z-index: 10;
	}

	.nav {
		max-width: 1120px;
		margin: 0 auto;
		padding: 12px 18px;
		display: flex;
		gap: 16px;
		align-items: center;
		justify-content: space-between;
	}

	.main {
		max-width: 1120px;
		margin: 0 auto;
		padding: 28px 18px 40px;
		min-height: calc(100vh - 240px);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 700;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.brandLogo {
		height: 30px;
		width: auto;
		display: block;
	}

	.brandText {
		font-weight: 900;
		letter-spacing: -0.02em;
		color: rgba(11, 18, 32, 0.82);
	}

	.navLinks {
		display: flex;
		gap: 14px;
		align-items: center;
		flex: 1;
		justify-content: center;
		color: rgba(11, 18, 32, 0.76);
		font-weight: 600;
	}

	.navCtas {
		display: flex;
		gap: 10px;
		align-items: center;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 10px 12px;
		background: var(--accent);
		color: #fff;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
	}

	.btn:hover {
		text-decoration: none;
		filter: brightness(0.95);
	}

	.lang {
		padding: 10px 12px;
		border-radius: 999px;
		border: 1px solid rgba(11, 18, 32, 0.12);
		background: rgba(255, 255, 255, 0.8);
		font-weight: 800;
		text-decoration: none;
	}

	.lang:hover {
		text-decoration: none;
		background: rgba(16, 24, 40, 0.04);
	}

	@media (max-width: 820px) {
		.navLinks {
			display: none;
		}
	}

	.footer {
		border-top: 1px solid rgba(11, 18, 32, 0.08);
		background: rgba(255, 255, 255, 0.65);
	}

	.footerInner {
		max-width: 1120px;
		margin: 0 auto;
		padding: 22px 18px;
		display: flex;
		gap: 18px;
		align-items: flex-start;
		justify-content: space-between;
	}

	.footerBrand {
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.footerNote {
		margin-top: 6px;
		color: rgba(11, 18, 32, 0.68);
		max-width: 520px;
		line-height: 1.5;
	}

	.footerLinks {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
		font-weight: 700;
		color: rgba(11, 18, 32, 0.72);
	}

	@media (max-width: 720px) {
		.footerInner {
			flex-direction: column;
		}
	}

	:global(article) {
		max-width: 780px;
		margin: 0 auto;
		background: rgba(255, 255, 255, 0.75);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 18px;
		padding: 18px;
	}

	:global(article h1) {
		margin: 0 0 10px;
		letter-spacing: -0.03em;
		line-height: 1.1;
		font-size: 34px;
	}

	:global(article h2) {
		margin: 24px 0 10px;
		letter-spacing: -0.02em;
	}

	:global(article p) {
		color: rgba(11, 18, 32, 0.78);
		line-height: 1.65;
	}

	:global(article img) {
		max-width: 100%;
		height: auto;
		border-radius: 14px;
	}

	:global(.link) {
		color: var(--accent);
		font-weight: 800;
		text-decoration: none;
	}

	:global(.link:hover) {
		text-decoration: underline;
	}
</style>
