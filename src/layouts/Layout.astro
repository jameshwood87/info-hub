		<script is:inline>
			(() => {
				const safeGtag = (...args) => {
					try {
						if (typeof window.gtag === 'function') window.gtag(...args);
					} catch {}
				};
				const openChat = () => {
					const start = Date.now();
					const tryOpen = () => {
						const api = window.tidioChatApi;
						if (!api) return false;
						try {
							if (typeof api.show === 'function') api.show();
							if (typeof api.open === 'function') api.open();
							return true;
						} catch {
							return false;
						}
					};

					let bound = false;
					let messageTracked = false;
					const bindEvents = () => {
						if (bound) return;
						const api = window.tidioChatApi;
						if (!api || typeof api.on !== 'function') return;
						bound = true;
						try {
							api.on('open', () => {
								safeGtag('event', 'tidio_open', { location: 'content' });
							});
						} catch {}
						const onMessage = () => {
							if (messageTracked) return;
							messageTracked = true;
							safeGtag('event', 'tidio_message', { location: 'content' });
						};
						try {
							api.on('messageFromVisitor', onMessage);
						} catch {}
						try {
							api.on('conversationStart', onMessage);
						} catch {}
					};

					const ensure = () => {
						const api = window.tidioChatApi;
						if (api && typeof api.on === 'function') {
							try {
								api.on('ready', () => {
									bindEvents();
									tryOpen();
								});
							} catch {}
						}
					};

					ensure();
					bindEvents();
					if (tryOpen()) return;
					const t = window.setInterval(() => {
						ensure();
						bindEvents();
						if (tryOpen() || Date.now() - start > 8000) window.clearInterval(t);
					}, 200);
				};

				window.openTidioChat = openChat;

				document.addEventListener(
					'click',
					(e) => {
						const el = e.target;
						if (!(el instanceof Element)) return;
						const target = el.closest('[data-tidio-open="1"]');
						if (!(target instanceof HTMLElement)) return;
						safeGtag('event', 'tidio_ticket', { location: 'content' });
						if (target instanceof HTMLAnchorElement) {
							e.preventDefault();
							e.stopPropagation();
						}
						openChat();
					},
					true,
				);

				document.addEventListener(
					'keydown',
					(e) => {
						if (e.key !== 'Enter' && e.key !== ' ') return;
						const el = e.target;
						if (!(el instanceof Element)) return;
						const target = el.closest('[data-tidio-open="1"]');
						if (!(target instanceof HTMLElement)) return;
						e.preventDefault();
						safeGtag('event', 'tidio_ticket', { location: 'content' });
						openChat();
					},
					true,
				);

				try {
					const p = `${location.pathname}`.replace(/\/+$/, '/') || '/';
					if (p === '/docs/propertylist-mls-user-manual/support/mls-support/') {
						const norm = (s) => String(s || '').toLowerCase().replace(/\s+/g, ' ').trim();
						const makeClickable = (el) => {
							if (!(el instanceof HTMLElement)) return;
							el.dataset.tidioOpen = '1';
							el.setAttribute('role', 'link');
							el.setAttribute('tabindex', '0');
							el.classList.add('tidioTicketLink');
						};

						const candidates = Array.from(document.querySelectorAll('a,strong,span,b,em,p,div'));
						const exact = [];
						for (const el of candidates) {
							if (!(el instanceof HTMLElement)) continue;
							const t = norm(el.textContent || '');
							if (!t) continue;
							if (t === 'create a ticket here') exact.push(el);
						}
						if (exact.length) {
							for (const el of exact) makeClickable(el);
						} else {
							for (const el of candidates) {
								if (!(el instanceof HTMLElement)) continue;
								const t = norm(el.textContent || '');
								if (!t) continue;
								if (t.includes('create a ticket here')) makeClickable(el);
							}
						}
					}
				} catch {}
			})();
		</script>
