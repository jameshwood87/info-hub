---
import Layout from '../../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../../lib/directus';
import background from '../../assets/background.svg';

const latestDocs = await listKbPagesByPrefix({ prefix: '/es/docs/', lang: 'es', limit: 5 });
const latestGeneral = await listKbPagesByPrefix({ prefix: '/es/informacion-general/', lang: 'es', limit: 8 });

const personaParam = Astro.url.searchParams.get('persona') || '';

const persona = (() => {
	if (personaParam === 'developers' || personaParam === 'developer') return 'developers';
	if (personaParam === 'services' || personaParam === 'service') return 'services';
	if (personaParam === 'agents' || personaParam === 'freelancer' || personaParam === 'agency') return 'agents';
	return 'agents';
})();

const hrefForPersona = (nextPersona: string) => {
	const params = new URLSearchParams();
	params.set('persona', nextPersona);
	return `/es/?${params.toString()}`;
};
---

<Layout
	lang="es"
	title="PropertyList Info Hub"
	description="Cómo usar PropertyList.es, funciones, precios y más."
	canonical="https://info.propertylist.es/es/"
>
	<section class="hero">
		<div class="heroBg" aria-hidden="true">
			<img src={background.src} alt="" width="1600" height="900" fetchpriority="high" />
		</div>
		<div class="heroInner">
			<a class="btnSecondary topCta" href="/es/docs/">Cómo usar PropertyList</a>
			<div class="heroCopy">
				<h1>¿Qué es PropertyList?</h1>
				<p class="lead">PropertyList es el primer Smart MLS, CRM y portal inmobiliario de Europa orientado a resultados.</p>
				<p class="lead">
					El MLS y el CRM son 100% gratis para siempre para agentes inmobiliarios. Sin suscripciones. Sin permanencias.
					Hay funciones opcionales de pago para quienes quieren más visibilidad, automatización y rendimiento.
				</p>

				<div class="metaRow">
					<div class="metaItem">
						<div class="metaKpi">5.700+</div>
						<div class="metaLabel">Listados activos</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">1.350+</div>
						<div class="metaLabel">Agentes activos</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Multi-idioma</div>
						<div class="metaLabel">Soporte</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Herramientas de IA</div>
						<div class="metaLabel">Extras</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Automatización</div>
						<div class="metaLabel">Flujos</div>
					</div>
				</div>

				<div class="pillRow" role="tablist" aria-label="Audiencia">
					<a
						class={`pill ${persona === 'agents' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'agents' ? 'true' : 'false'}
						data-persona="agents"
						href={hrefForPersona('agents')}
					>
						Agentes inmobiliarios
					</a>
					<a
						class={`pill ${persona === 'developers' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'developers' ? 'true' : 'false'}
						data-persona="developers"
						href={hrefForPersona('developers')}
					>
						Promotores
					</a>
					<a
						class={`pill ${persona === 'services' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'services' ? 'true' : 'false'}
						data-persona="services"
						href={hrefForPersona('services')}
					>
						Servicios inmobiliarios
					</a>
				</div>

				<div class="personaBox" aria-label="Por audiencia">
					<div class={`personaPanel ${persona === 'agents' ? 'isActive' : ''}`} data-persona-panel="agents">
						<div class="personaTitle">Para agentes inmobiliarios</div>
						<div class="personaSummary">
							Publica, comparte, colabora y gestiona leads—sin otra cuota mensual.
						</div>
						<div class="personaLinks">
							<a href="/es/docs/empezar/">Empezar</a>
							<a href="/es/mls/">Manual del MLS</a>
							<a href="/es/search">Buscar</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'developers' ? 'isActive' : ''}`} data-persona-panel="developers">
						<div class="personaTitle">Para promotores</div>
						<div class="personaSummary">Distribuye nuevas promociones a una red de agentes.</div>
						<div class="personaLinks">
							<a href="/es/docs/">Documentación</a>
							<a href="/es/search">Buscar</a>
							<a href="/es/informacion-general/">Noticias</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'services' ? 'isActive' : ''}`} data-persona-panel="services">
						<div class="personaTitle">Para servicios inmobiliarios</div>
						<div class="personaSummary">Conecta con agentes y gana visibilidad ante compradores y propietarios.</div>
						<div class="personaLinks">
							<a href="/es/informacion-general/">Información general</a>
							<a href="/es/docs/">Documentación</a>
							<a href="/es/search">Buscar</a>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2 class="offerTitle">Qué ofrecemos</h2>
		</div>
		<p class="sectionLead">
			Mantén el motor funcionando gratis — para siempre. PropertyList te ofrece un MLS + CRM totalmente funcional sin
			coste, para que puedas publicar propiedades, gestionar leads, coordinarte con tu equipo y cerrar operaciones sin
			otra cuota mensual.
		</p>
		<p class="sectionLead">
			Cuando quieras ir más rápido o destacar, utiliza nuestras herramientas opcionales activadas por créditos. Úsalas
			sólo cuando realmente te ayuden: automatizaciones que ahorran horas, impulsos de marketing que consiguen
			instrucciones y analíticas que te ayudan a valorar y presentar con confianza.
		</p>
		<div class="grid featureGrid">
			<div class="tile pricingTile">
				<div class="pricingMeta">
					<div class="pricingBadge isFree">Gratis</div>
				</div>
				<h3 class="pricingTitle">Qué obtienes gratis</h3>
				<ul class="featureList">
					<li>MLS (comparte propiedades ilimitadas)</li>
					<li>CRM</li>
					<li>Mensajería y solicitudes de visita</li>
					<li>Usuarios ilimitados</li>
					<li>Contactos ilimitados</li>
					<li>MicroSite (mini web de marca)</li>
					<li>Agencias verificadas</li>
					<li>Historial / timeline (contactos y propiedades)</li>
					<li>Acceso al grupo de WhatsApp (comunidad) (3.000+ miembros)</li>
					<li>Publicita en nuestras páginas y grupos de Facebook (40.000+ miembros)</li>
				</ul>
			</div>
			<div class="tile mutedTile pricingTile">
				<div class="pricingMeta">
					<div class="pricingBadge isSoon">Próximamente</div>
				</div>
				<h3 class="pricingTitle">Extras opcionales de pago</h3>
				<ul class="featureList">
					<li>Listados MLS destacados</li>
					<li>Listados privados</li>
					<li>Informe CMA</li>
					<li>Herramientas de IA</li>
					<li>Listados destacados en el portal público</li>
					<li>Leads directos abiertos (portal público)</li>
					<li>Agentes destacados</li>
					<li>Email directo de propiedades a clientes</li>
					<li>Publicaciones potenciadas en redes sociales</li>
					<li>Utilidades de IA</li>
					<li>Y mucho más próximamente</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Documentación y búsqueda</h2>
			<a class="link" href="/es/docs/">Ver todo</a>
		</div>
		<form class="searchBar" method="get" action="/es/search">
			<input name="q" placeholder="Buscar preguntas, funciones y flujos" />
			<button type="submit">Buscar</button>
		</form>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Explorar documentación</h2>
			<a class="link" href="/es/docs/">Ver todo</a>
		</div>
		<div class="grid">
			<a class="tile" href="/es/barrios/">
				<div class="tileIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M4.5 10.5 12 4.5l7.5 6v9.75c0 .69-.56 1.25-1.25 1.25H5.75c-.69 0-1.25-.56-1.25-1.25V10.5Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path
							d="M9 22v-6.75c0-.69.56-1.25 1.25-1.25h3.5c.69 0 1.25.56 1.25 1.25V22"
							stroke="currentColor"
							stroke-width="1.6"
						/>
					</svg>
				</div>
				<h3>Guías de barrios</h3>
				<p>Información de zonas y estilo de vida.</p>
			</a>
			<a class="tile" href="/es/mls/">
				<div class="tileIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M7 4.5h7l3 3v12.75c0 .69-.56 1.25-1.25 1.25H7.25C6.56 21.75 6 21.19 6 20.5V5.75C6 5.06 6.56 4.5 7.25 4.5Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path d="M14 4.5V8h3" stroke="currentColor" stroke-width="1.6" />
						<path d="M8.5 12h7" stroke="currentColor" stroke-width="1.6" />
						<path d="M8.5 15.5h6" stroke="currentColor" stroke-width="1.6" />
					</svg>
				</div>
				<h3>Manual del MLS</h3>
				<p>Flujos, listados, exportaciones e informes.</p>
			</a>
			<a class="tile" href="/es/leyes/">
				<div class="tileIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M12 3.75c3.2 2.47 5.5 2.47 8 2.75v8.5c0 3.9-3.1 6.6-8 8.25-4.9-1.65-8-4.35-8-8.25V6.5c2.5-.28 4.8-.28 8-2.75Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path d="M9 12h6" stroke="currentColor" stroke-width="1.6" />
						<path d="M12 9v6" stroke="currentColor" stroke-width="1.6" />
					</svg>
				</div>
				<h3>Leyes y procedimientos</h3>
				<p>Alquileres, impuestos, herencias y más.</p>
			</a>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Última documentación</h2>
			<a class="link" href="/es/docs/">Ver todo</a>
		</div>
		<div class="list">
			{latestDocs.length ? (
				latestDocs.map((p) => (
					<a class="row" href={p.path}>
						<div class="rowTitle">{p.title}</div>
						{p.description ? <div class="rowDesc">{p.description}</div> : null}
					</a>
				))
			) : (
				<div class="empty">Aún no hay páginas.</div>
			)}
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Información general</h2>
			<a class="link" href="/es/informacion-general/">Ver todo</a>
		</div>
		<div class="cards">
			{latestGeneral.length ? (
				latestGeneral.map((p) => (
					<a class="cardLink" href={p.path}>
						<h3>{p.title}</h3>
						{p.description ? <p>{p.description}</p> : null}
					</a>
				))
			) : (
				<div class="empty">Aún no hay artículos.</div>
			)}
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Sé parte de la comunidad</h2>
			<a class="link" href="/es/comunidad/">Haz una pregunta</a>
		</div>
		<div class="grid">
			<div class="tile mutedTile">
				<h3>Últimos temas del foro</h3>
				<p>Próximamente.</p>
			</div>
			<div class="tile mutedTile">
				<h3>Tutoriales en vídeo</h3>
				<p>Próximamente.</p>
			</div>
		</div>
	</section>
	<script is:inline>
		const pillRow = document.querySelector('.pillRow');
		const personaBox = document.querySelector('.personaBox');

		if (pillRow && personaBox) {
			const pills = Array.from(pillRow.querySelectorAll('[data-persona]'));
			const panels = Array.from(personaBox.querySelectorAll('[data-persona-panel]'));

			const normalizePersona = (value) => {
				if (value === 'developers' || value === 'developer') return 'developers';
				if (value === 'services' || value === 'service') return 'services';
				if (value === 'agents' || value === 'freelancer' || value === 'agency') return 'agents';
				return '';
			};

			const setPersona = (value, mode) => {
				const persona = normalizePersona(value) || 'agents';

				for (const pill of pills) {
					const isActive = pill.getAttribute('data-persona') === persona;
					pill.classList.toggle('isActive', isActive);
					pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
				}

				for (const panel of panels) {
					const isActive = panel.getAttribute('data-persona-panel') === persona;
					panel.classList.toggle('isActive', isActive);
				}

				const url = new URL(window.location.href);
				url.searchParams.set('persona', persona);
				if (mode === 'push') window.history.pushState(null, '', url.toString());
				else window.history.replaceState(null, '', url.toString());
			};

			const initialFromUrl = normalizePersona(new URL(window.location.href).searchParams.get('persona') || '');
			const activePill = pillRow.querySelector('.pill.isActive') || pillRow.querySelector('[data-persona]');
			const initialFromDom = normalizePersona(activePill ? activePill.getAttribute('data-persona') || '' : '');
			setPersona(initialFromUrl || initialFromDom, 'replace');

			for (const pill of pills) {
				pill.addEventListener('click', (e) => {
					e.preventDefault();
					setPersona(pill.getAttribute('data-persona') || '', 'push');
				});
			}

			window.addEventListener('popstate', () => {
				setPersona(new URL(window.location.href).searchParams.get('persona') || '', 'replace');
			});
		}
	</script>
</Layout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(246, 248, 252, 0.85));
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 18px;
		padding: 22px;
	}

	.heroBg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.9;
	}

	.heroBg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.1);
		filter: blur(60px) saturate(1.15);
	}

	.heroBg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(900px 420px at 5% 20%, rgba(var(--accent-rgb), 0.35), transparent 55%),
			radial-gradient(900px 420px at 100% 10%, rgba(34, 197, 94, 0.18), transparent 55%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(246, 248, 252, 0.92));
	}

	.heroInner {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
		align-items: start;
	}

	.topCta {
		position: absolute;
		top: 0;
		right: 0;
	}

	.heroCopy {
		padding: 8px;
	}

	.pillRow {
		display: flex;
		gap: 8px;
		padding: 6px;
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 999px;
		width: fit-content;
		margin: 14px auto 0;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 8px 10px;
		border-radius: 999px;
		font-weight: 800;
		color: rgba(11, 18, 32, 0.7);
		text-decoration: none;
		white-space: nowrap;
	}

	.pill.isActive {
		background: rgba(var(--accent-rgb), 0.12);
		color: rgba(11, 18, 32, 0.95);
	}

	.pill:hover {
		text-decoration: none;
		background: rgba(11, 18, 32, 0.04);
	}

	h1 {
		font-size: 42px;
		line-height: 1.05;
		margin: 14px 0 12px;
		letter-spacing: -0.03em;
	}

	.lead {
		font-size: 18px;
		line-height: 1.55;
		color: rgba(11, 18, 32, 0.72);
		margin: 0 0 18px;
	}

	.lead + .lead {
		margin-top: -10px;
	}

	.ctaRow {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.btnPrimary,
	.btnSecondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 11px 14px;
		border-radius: 12px;
		text-decoration: none;
		font-weight: 700;
	}

	.btnPrimary {
		background: var(--accent);
		color: #fff;
	}

	.btnPrimary:hover {
		text-decoration: none;
		filter: brightness(0.95);
	}

	.btnSecondary {
		background: rgba(16, 24, 40, 0.06);
		border: 1px solid rgba(16, 24, 40, 0.1);
	}

	.btnSecondary:hover {
		text-decoration: none;
		background: rgba(16, 24, 40, 0.08);
	}

	.metaRow {
		margin-top: 18px;
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		justify-content: center;
	}

	.metaItem {
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 14px;
		padding: 12px 14px;
		min-width: 160px;
	}

	.metaKpi {
		font-weight: 900;
		letter-spacing: -0.01em;
	}

	.metaLabel {
		margin-top: 2px;
		font-size: 13px;
		color: rgba(11, 18, 32, 0.65);
	}

	.personaBox {
		margin-top: 14px;
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 16px;
		padding: 12px;
	}

	.personaPanel {
		display: none;
	}

	.personaPanel.isActive {
		display: block;
	}

	.personaTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}

	.personaSummary {
		margin: -6px 0 12px;
		color: rgba(11, 18, 32, 0.7);
		line-height: 1.5;
	}

	.personaLinks {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
	}

	.personaLinks a {
		background: rgba(var(--accent-rgb), 0.08);
		border: 1px solid rgba(var(--accent-rgb), 0.18);
		border-radius: 14px;
		padding: 10px 12px;
		font-weight: 800;
		text-decoration: none;
	}

	.personaLinks a:hover {
		text-decoration: none;
		background: rgba(var(--accent-rgb), 0.12);
	}

	.card {
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 14px;
	}

	.card h3 {
		margin: 0 0 8px;
		font-size: 16px;
	}

	.card p {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
	}

	.card ul {
		margin: 0;
		padding-left: 18px;
		color: rgba(16, 24, 40, 0.72);
	}

	.card li {
		margin: 6px 0;
	}

	.persona {
		display: none;
	}

	.persona.isActive {
		display: block;
	}

	.section {
		margin-top: 22px;
	}

	.sectionHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 10px;
	}

	.sectionHeader h2 {
		margin: 0;
		font-size: 20px;
		letter-spacing: -0.01em;
	}

	.offerTitle {
		font-size: 28px;
		letter-spacing: -0.02em;
	}

	.sectionLead {
		margin: 0 0 12px;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.55;
	}

	.link {
		color: var(--accent);
		font-weight: 800;
		text-decoration: none;
	}

	.link:hover {
		text-decoration: underline;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.featureGrid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.featureList {
		margin: 0;
		padding-left: 0;
		color: rgba(16, 24, 40, 0.72);
		list-style: none;
		display: grid;
		gap: 8px;
	}

	.featureList li {
		margin: 0;
		position: relative;
		padding-left: 22px;
		line-height: 1.4;
	}

	.featureList li::before {
		content: '✓';
		position: absolute;
		left: 0;
		top: 0;
		color: var(--accent);
		font-weight: 900;
	}

	.mutedTile .featureList li::before {
		content: '+';
		color: rgba(16, 24, 40, 0.65);
	}

	.pricingTile {
		padding: 18px;
	}

	.pricingMeta {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 10px;
	}

	.pricingBadge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 6px 10px;
		border-radius: 999px;
