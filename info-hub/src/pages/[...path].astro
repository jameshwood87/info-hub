	const seg = parts[0];
	const mlsMap: Record<string, { title: string; desc: string; body?: string }> = {
		'getting-started': { title: 'Getting Started', desc: 'Set up your account, get the app, and learn the basics.' },
		'your-account': { title: 'Your Account', desc: 'Manage your profile, company details, and preferences.' },
		'listing-a-property': { title: 'Listing a Property', desc: 'Create, edit, and manage listings from start to finish.' },
		'microsite-share': { title: 'MicroSite - Share', desc: 'Share properties with links, microsites, and clients.' },
		'managing-listings': { title: 'Managing Listings', desc: 'Update status, edit listings, and track enquiries and activity.' },
		'marketing-and-promotion': {
			title: 'Marketing and Promotion',
			desc: 'Promote listings across MLS, portals, and social channels.',
