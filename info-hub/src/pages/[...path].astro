const page = legacyPageForPath(normalizedPath) ?? legacyMlsPageForPath(normalizedPath) ?? (await getKbPageByPath(normalizedPath));

if (!page) {
	return new Response('Not Found', { status: 404 });
}

const lang = page.language || 'en';
const title = page.seo_title || page.title;
const h1 = page.title;
const description = page.seo_description || page.description || undefined;
const canonical = `https://info.propertylist.es${page.path}`;
const hreflangs = [
	{ hreflang: 'en', href: `https://info.propertylist.es${page.path.replace(/^\/es\//, '/')}` },
	{ hreflang: 'es', href: `https://info.propertylist.es${page.path.startsWith('/es/') ? page.path : `/es${page.path}`}` },
];

const titleCase = (s: string) =>
	String(s || '')
		.replace(/[_-]+/g, ' ')
		.replace(/\b\w/g, (m) => m.toUpperCase());

const stripInfoHubSuffix = (s: string) => String(s || '').replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '').trim();

const labelForCrumb = (seg: string) => {
	const map: Record<string, string> = {
		docs: 'Docs',
		'propertylist-mls-user-manual': 'MLS & CRM User Manual',
		'mls-user-manual': 'MLS & CRM User Manual',
		'general-information': 'News',
		laws: 'Laws',
		'laws-procedures': 'Laws & Procedures',
		mls: 'MLS',
		neighbourhood: 'Neighbourhood',
		community: 'Community',
	};
	return map[seg] || titleCase(seg);
};

const stripTags = (html: string) => String(html || '').replace(/<[^>]+>/g, '');
const slugify = (s: string) =>
	stripTags(s)
		.toLowerCase()
		.normalize('NFKD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/&[a-z0-9#]+;/gi, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '')
		.slice(0, 80);

const cleanImportedBody = (html: string | null | undefined, path: string) => {
	let out = String(html || '');

	const isBlogLike = path.startsWith('/general-information/') || path.startsWith('/blog/');

	const pickFirstMatch = (re: RegExp) => {
		const m = out.match(re);
		return m ? m[1] || m[0] : null;
	};

	if (/<html\b/i.test(out) || /<body\b/i.test(out) || /<header\b/i.test(out) || /<nav\b/i.test(out)) {
		const article = pickFirstMatch(/<article\b[\s\S]*?<\/article>/i);
		if (article) out = article;
		else {
			const main = pickFirstMatch(/<main\b[\s\S]*?<\/main>/i);
			if (main) out = main;
		}
	}

	if (isBlogLike) {
		const entryContent = pickFirstMatch(/<div\b[^>]*class=["'][^"']*\bentry-content\b[^"']*["'][^>]*>([\s\S]*?)<\/div>/i);
		if (entryContent) out = entryContent;
		const postContent = pickFirstMatch(/<div\b[^>]*class=["'][^"']*\b(post-content|postContent|wp-block-post-content)\b[^"']*["'][^>]*>([\s\S]*?)<\/div>/i);
		if (postContent) out = postContent;
	}

	out = out
		.replace(/<script\b[\s\S]*?<\/script>/gi, '')
		.replace(/<style\b[\s\S]*?<\/style>/gi, '')
		.replace(/<(meta|link)\b[^>]*>/gi, '')
		.replace(/<(header|nav|footer|aside)\b[\s\S]*?<\/\1>/gi, '')
		.replace(/<form\b[\s\S]*?<\/form>/gi, '')
		.replace(/<div\b[^>]*class=["'][^"']*(sidebar|widget|comments-area|comment|comments|wp-block-comments)[^"']*["'][\s\S]*?<\/div>/gi, '')
		.replace(/<section\b[^>]*id=["']comments?["'][\s\S]*?<\/section>/gi, '');

	out = out
		.replace(
			/<(h[1-6]|p|div)\b[^>]*>\s*(Leave a Comment|Recent Posts|Categories|Archives|Search)\b[\s\S]*?<\/\1>/gi,
			'',
		)
		.replace(/Powered\s+By\s+PropertyList[\s\S]*?®/gi, '');

	out = out.replace(/\n{3,}/g, '\n\n').trim();

	return out;
};

const withHeadingIdsAndToc = (html: string | null | undefined) => {
	const body = String(html || '');
	const used = new Map<string, number>();
	const toc: Array<{ depth: 2 | 3; id: string; text: string }> = [];

	const withIds = body.replace(/<h([23])([^>]*)>([\s\S]*?)<\/h\1>/gi, (m, levelRaw, attrs, inner) => {
		const depth = (Number(levelRaw) as 2 | 3) || 2;
		const hasId = /\bid\s*=/.test(String(attrs || ''));
		const text = stripTags(inner).replace(/\s+/g, ' ').trim();
		const base = slugify(text) || `section-${toc.length + 1}`;
		const n = (used.get(base) || 0) + 1;
		used.set(base, n);
		const id = n === 1 ? base : `${base}-${n}`;
		toc.push({ depth, id, text });
		if (hasId) return m;
		return `<h${depth}${attrs} id="${id}">${inner}</h${depth}>`;
	});

	const withCallouts = withIds.replace(
		/<blockquote([^>]*)>\s*(<p[^>]*>\s*)?(<strong[^>]*>\s*)?(Tip|Note|Warning|Consejo|Nota|Advertencia)\s*:?\s*(<\/strong>\s*)?/gi,
		(_m, attrs, pOpen = '', strongOpen = '', kind, strongClose = '') => {
			const raw = String(kind || '').toLowerCase();
			const k = raw === 'consejo' ? 'tip' : raw === 'advertencia' ? 'warning' : raw === 'nota' ? 'note' : raw;
			const hasClass = /\bclass\s*=/.test(String(attrs || ''));
			const nextAttrs = hasClass
				? String(attrs).replace(/\bclass\s*=\s*(['"])([\s\S]*?)\1/i, (_m: string, q: string, v: string) => {
						const next = v.includes(k) ? v : `${v} ${k}`.trim();
						return ` class=${q}${next}${q}`;
					})
				: `${attrs} class="${k}"`;
			return `<blockquote${nextAttrs}>${pOpen}${strongOpen}${kind}${strongClose}`;
		},
	);

	return { html: withCallouts, toc };
};

const cleanedSourceBody = cleanImportedBody(page.body, page.path);
const { html: bodyHtml, toc } = withHeadingIdsAndToc(cleanedSourceBody);
const bodyHasH1 = /<h1\b/i.test(bodyHtml);
const cleanedBodyHtml = bodyHtml.replace(
	/<(p|h[1-6])\b[^>]*>\s*(?:<a\b[^>]*>\s*)?Managing Listings\s*-\s*Previous\s*Tracking property enquiries\/leads\s*(?:<\/a>\s*)?<\/\1>\s*/gi,
	'',
);

const renamedBodyHtml = cleanedBodyHtml
	.replace(/<h([23])([^>]*)>\s*MLS\s*User\s*Manual\s*<\/h\1>/gi, '<h$1$2>MLS &amp; CRM User Manual</h$1>')
	.replace(/<h([23])([^>]*)>\s*Propertylist\s*Mls\s*User\s*Manual\s*<\/h\1>/gi, '<h$1$2>MLS &amp; CRM User Manual</h$1>');

const crumbs = (() => {
	const parts = page.path.split('/').filter(Boolean);
	const acc: Array<{ href: string; label: string }> = [];
	let current = '';
	for (const seg of parts.slice(0, -1)) {
		current += `/${seg}`;
		acc.push({ href: `${current}/`, label: labelForCrumb(seg) });
	}
	return acc;
})();

const parentPrefix = page.path.replace(/[^/]+\/$/, '');
const siblings = await listKbPagesByPrefix({
	prefix: parentPrefix,
	lang: lang === 'es' ? 'es' : 'en',
	limit: 500,
});
const siblingSorted = [...siblings].sort((a, b) => a.path.localeCompare(b.path));
const currentIndex = siblingSorted.findIndex((p) => p.path === page.path);
const prev = currentIndex > 0 ? siblingSorted[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < siblingSorted.length - 1 ? siblingSorted[currentIndex + 1] : null;

const isDocs = page.path.startsWith('/docs/');
const docsPrefix = '/docs/';
const docsItems = isDocs ? await listKbPagesByPrefix({ prefix: docsPrefix, lang: 'en', limit: 2000 }) : [];
const currentManualRoot = (() => {
	if (!isDocs) return null;
	const rest = page.path.slice(docsPrefix.length);
	const seg = rest.split('/').filter(Boolean)[0] || null;
	return seg ? `${docsPrefix}${seg}/` : docsPrefix;
})();

type DocNode = {
	key: string;
	path: string;
	seg: string;
	title: string;
	children: DocNode[];
	hasPage: boolean;
};

const docsByPath = new Map(docsItems.map((p) => [p.path, p]));
const docsRoot: DocNode = { key: docsPrefix, path: docsPrefix, seg: '', title: 'Docs', children: [], hasPage: docsByPath.has(docsPrefix) };

const ensureDocChild = (parent: DocNode, seg: string, path: string) => {
	let node = parent.children.find((c) => c.key === path) || null;
	if (!node) {
		node = { key: path, path, seg, title: '', children: [], hasPage: false };
		parent.children.push(node);
	}
	return node;
};

for (const p of docsItems) {
	if (!p.path.startsWith(docsPrefix)) continue;
	const rest = p.path.slice(docsPrefix.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = docsPrefix;
	let parent = docsRoot;
	for (const seg of parts) {
		acc += `${seg}/`;
		parent = ensureDocChild(parent, seg, acc);
		const pageHit = docsByPath.get(acc);
		parent.hasPage = Boolean(pageHit);
		if (acc === '/docs/propertylist-mls-user-manual/') parent.title = 'MLS & CRM User Manual';
		else if (pageHit?.title) parent.title = stripInfoHubSuffix(pageHit.title);
	}
}

const fillDocTitles = (node: DocNode) => {
	if (!node.title) node.title = node.seg ? titleCase(node.seg) : 'Docs';
	for (const c of node.children) fillDocTitles(c);
};

fillDocTitles(docsRoot);

const sortDocTree = (node: DocNode) => {
	node.children.sort((a, b) => a.title.localeCompare(b.title));
	for (const c of node.children) sortDocTree(c);
};

sortDocTree(docsRoot);

const mlsManualPath = '/docs/propertylist-mls-user-manual/';
const manualOrderWeight = (node: DocNode): number => {
	const s = `${node.seg} ${node.title}`.toLowerCase();
	if (node.path === mlsManualPath) return 0;
	if (/\bgetting\b|\bstart\b|\bsetup\b|\bonboarding\b/.test(s)) return 10;
	if (/\bdashboard\b|\boverview\b|\bhome\b/.test(s)) return 20;
	if (/\bsearch\b|\bsearching\b|\bproperties\b/.test(s)) return 30;
	if (/\blistings?\b|\bproperty alerts?\b|\balerts?\b/.test(s)) return 40;
	if (/\bleads?\b|\benquir(y|ies)\b|\bpipeline\b|\bsales\b/.test(s)) return 50;
	if (/\bcontacts?\b|\bclients?\b/.test(s)) return 60;
	if (/\bcalendar\b|\bappointments?\b|\bviewings?\b|\btasks?\b/.test(s)) return 70;
	if (/\breports?\b|\bstatistics\b|\banalytics\b/.test(s)) return 80;
	if (/\brequests?\b/.test(s)) return 90;
	if (/\bsecurity\b|\bpermissions?\b|\busers?\b|\bverified\b|\bagency\b|\bcompany\b|\bstaff\b|\baccount\b/.test(s)) return 100;
	if (/\bai\b|\bautomation\b|\bintegrations?\b/.test(s)) return 110;
	if (/\btechnical\b|\bapi\b/.test(s)) return 120;
	if (/\bvideo\b|\btutorials?\b/.test(s)) return 130;
	if (/\badditional\b|\bresources?\b/.test(s)) return 140;
	return 500;
};

const openDocPaths = (() => {
	const s = new Set<string>();
	if (!isDocs) return s;
	const rest = page.path.slice(docsPrefix.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = docsPrefix;
	for (const seg of parts) {
		acc += `${seg}/`;
		s.add(acc);
	}
	return s;
})();

const escapeHtml = (s: string) =>
	String(s || '')
		.replaceAll('&', '&amp;')
		.replaceAll('<', '&lt;')
		.replaceAll('>', '&gt;')
		.replaceAll('"', '&quot;')
		.replaceAll("'", '&#39;');

const renderDocNavHtml = (nodes: DocNode[], depth = 0): string =>
	[...nodes]
		.sort((a, b) => {
			if (depth === 0 && currentManualRoot) {
				const aIsCurrent = a.path === currentManualRoot;
				const bIsCurrent = b.path === currentManualRoot;
				if (aIsCurrent !== bIsCurrent) return aIsCurrent ? -1 : 1;
			}
			const aInMls = a.path.startsWith(mlsManualPath);
			const bInMls = b.path.startsWith(mlsManualPath);
			if (depth === 1 && aInMls && bInMls) {
				const aw = manualOrderWeight(a);
				const bw = manualOrderWeight(b);
				if (aw !== bw) return aw - bw;
			}
			return a.title.localeCompare(b.title);
		})
		.map((n) => {
			const isCurrent = n.path === page.path;
			const isOpen = openDocPaths.has(n.path);
			const title = escapeHtml(n.title || '');
			const label = escapeHtml((n.title || '').toLowerCase());
			const href = escapeHtml(n.path);
			const pathAttr = escapeHtml(n.path.toLowerCase());
			const manualRootAttr = n.path === mlsManualPath ? ' data-manual-root="1"' : '';

			if (n.children.length) {
				const kids = renderDocNavHtml(n.children, depth + 1);
				const summaryInner = n.hasPage
					? `<a class="docNavSummaryLink" href="${href}">${title}</a>`
					: `<span class="docNavSummaryText">${title}</span>`;
				return `<li class="docNavNode" data-doc-nav-node="1" data-depth="${depth}" data-label="${label}" data-path="${pathAttr}"${manualRootAttr}><details class="docNavGroup" ${
					isOpen ? 'open' : ''
				} data-default-open="${isOpen ? '1' : '0'}"><summary class="docNavSummary${isCurrent ? ' active' : ''}">${summaryInner}</summary><ul class="docNavList">${kids}</ul></details></li>`;
			}

			if (n.hasPage) {
				return `<li class="docNavItem" data-doc-nav-node="1" data-depth="${depth}" data-label="${label}" data-path="${pathAttr}"${manualRootAttr}><a class="docNavLink${isCurrent ? ' active' : ''}" href="${href}">${title}</a></li>`;
			}

			return `<li class="docNavItem" data-doc-nav-node="1" data-depth="${depth}" data-label="${label}" data-path="${pathAttr}"${manualRootAttr}><span class="docNavLabel">${title}</span></li>`;
		})
		.join('');

const extractSteps = (html: string) => {
	const m = html.match(/<ol[^>]*>([\s\S]*?)<\/ol>/i);
	if (!m) return [];
	const olInner = m[1] || '';
	const steps: string[] = [];
	const liRe = /<li[^>]*>([\s\S]*?)<\/li>/gi;
	let hit: RegExpExecArray | null = null;
	while ((hit = liRe.exec(olInner))) {
		const text = stripTags(hit[1] || '').replace(/\s+/g, ' ').trim();
		if (text) steps.push(text);
		if (steps.length >= 10) break;
	}
	return steps;
};

const origin = 'https://info.propertylist.es';
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: `${origin}${lang === 'es' ? '/es/' : '/'}`,
		},
		...crumbs.map((c, i) => ({
			'@type': 'ListItem',
			position: i + 2,
			name: c.label,
			item: `${origin}${c.href}`,
		})),
		{
			'@type': 'ListItem',
			position: crumbs.length + 2,
			name: stripInfoHubSuffix(h1),
			item: canonical,
		},
	],
};

const articleLd = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: h1,
	description: description,
	inLanguage: lang === 'en' ? 'en-GB' : lang,
	mainEntityOfPage: canonical,
	url: canonical,
};

const stepTexts = extractSteps(bodyHtml);
const howToLd =
	stepTexts.length >= 2
		? {
				'@context': 'https://schema.org',
				'@type': 'HowTo',
				name: h1,
				description: description,
				inLanguage: lang === 'en' ? 'en-GB' : lang,
				step: stepTexts.map((t, i) => ({
					'@type': 'HowToStep',
					position: i + 1,
					name: t.length > 80 ? `${t.slice(0, 77)}...` : t,
					text: t,
				})),
			}
		: null;

const ldJson = JSON.stringify([breadcrumbLd, articleLd, ...(howToLd ? [howToLd] : [])]);
---

<Layout lang={lang} title={title} description={description} canonical={canonical} hreflangs={hreflangs}>
	<script type="application/ld+json" slot="head" is:inline set:html={ldJson} />
	<article class="doc">
		<header class="docHeader">
			<div class="docHeaderTop">
				<div class="docIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M7.5 3.75h9a1.75 1.75 0 0 1 1.75 1.75v13A1.75 1.75 0 0 1 16.5 20.25h-9A1.75 1.75 0 0 1 5.75 18.5v-13A1.75 1.75 0 0 1 7.5 3.75Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path d="M8.5 8h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						<path d="M8.5 12h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						<path d="M8.5 16h4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
					</svg>
				</div>
				<nav class="docCrumbs" aria-label="Breadcrumb">
					<a href={lang === 'es' ? '/es/' : '/'}>Home</a>
					{crumbs.map((c) => (
						<>
							<span class="docCrumbSep" aria-hidden="true">
								/
							</span>
							<a href={c.href}>{c.label}</a>
						</>
					))}
					<span class="docCrumbSep" aria-hidden="true">
						/
					</span>
					<span class="docCrumbCurrent">{stripInfoHubSuffix(h1)}</span>
				</nav>
				{isDocs ? (
					<button class="docBrowseBtn" type="button" data-doc-nav-open>
						Browse manual
					</button>
				) : null}
			</div>

			{!bodyHasH1 ? <h1 class="docTitle">{h1}</h1> : null}
			{!bodyHasH1 && page.description ? <p class="docLead">{page.description}</p> : null}
		</header>

		<div class:list={['docGrid', isDocs ? 'withNav' : null]}>
			{isDocs ? (
				<aside class="docNav" aria-label="Docs navigation" data-current-manual-root={currentManualRoot || ''}>
					<div class="docNavTitle">In this manual</div>
					<div class="docNavFilterRow">
						<label class="docNavFilterLabel" for="doc-nav-filter-desktop">
							Filter
						</label>
						<input
							id="doc-nav-filter-desktop"
							class="docNavFilterInput"
							type="search"
							autocomplete="off"
							spellcheck="false"
							placeholder="Filter this manual…"
							data-doc-nav-filter="desktop"
						/>
					</div>
					<ul class="docNavList">
						<Fragment set:html={renderDocNavHtml(docsRoot.children)} />
					</ul>
				</aside>
			) : null}

			<div class="docMain">
				<div class="docContent">{renamedBodyHtml ? <Fragment set:html={renamedBodyHtml} /> : null}</div>

				{prev || next ? (
					<footer class="docPager" aria-label="Page navigation">
						{prev ? (
							<a class="docPagerLink" href={prev.path}>
								<span class="docPagerKicker">Previous</span>
								<span class="docPagerTitle">{prev.title}</span>
							</a>
						) : (
							<span />
						)}
						{next ? (
							<a class="docPagerLink" href={next.path}>
								<span class="docPagerKicker">Next</span>
								<span class="docPagerTitle">{next.title}</span>
							</a>
						) : null}
					</footer>
				) : null}
			</div>

			{toc.filter((t) => t.depth === 2).length > 1 ? (
				<aside class="docToc" aria-label="On this page">
					<div class="docTocTitle">On this page</div>
					<ol class="docTocList">
						{toc
							.filter((t) => t.depth === 2)
							.slice(0, 12)
							.map((t) => (
								<li>
									<a href={`#${t.id}`}>{t.text}</a>
								</li>
							))}
					</ol>
				</aside>
			) : null}
		</div>
	</article>

	{isDocs ? (
		<div class="docNavOverlay" data-doc-nav-overlay hidden>
			<div class="docNavDrawer" role="dialog" aria-modal="true" aria-label="Browse manual">
				<div class="docNavDrawerHeader">
					<div class="docNavDrawerTitle">Browse manual</div>
					<button class="docNavDrawerClose" type="button" data-doc-nav-close aria-label="Close">
						Close
					</button>
				</div>
				<div class="docNavFilterRow">
					<label class="docNavFilterLabel" for="doc-nav-filter-mobile">
						Filter
					</label>
					<input
						id="doc-nav-filter-mobile"
						class="docNavFilterInput"
						type="search"
						autocomplete="off"
						spellcheck="false"
						placeholder="Filter this manual…"
						data-doc-nav-filter="mobile"
					/>
				</div>
				<nav class="docNavDrawerBody" aria-label="Docs navigation" data-current-manual-root={currentManualRoot || ''}>
					<ul class="docNavList">
						<Fragment set:html={renderDocNavHtml(docsRoot.children)} />
					</ul>
				</nav>
			</div>
		</div>
	) : null}
</Layout>

{isDocs ? (
	<script is:inline>
		{String.raw`(() => {
  const openBtn = document.querySelector('[data-doc-nav-open]');
  const overlay = document.querySelector('[data-doc-nav-overlay]');
  const drawer = overlay?.querySelector('.docNavDrawer');
  const closeBtn = overlay?.querySelector('[data-doc-nav-close]');
  const mobileMq = window.matchMedia('(max-width: 960px)');
  const desktopNav = document.querySelector('.docNav');
  const drawerBody = overlay?.querySelector('.docNavDrawerBody');
  const getInputs = () => Array.from(document.querySelectorAll('input[data-doc-nav-filter]')).filter((x) => x instanceof HTMLInputElement);

  const scrollToActive = (container) => {
    if (!(container instanceof HTMLElement)) return;
    if (container.scrollHeight <= container.clientHeight) return;
    const active =
      container.querySelector('.docNavLink.active') ||
      container.querySelector('.docNavSummary.active') ||
      container.querySelector('.docNavSummaryLink.active');
    if (!(active instanceof HTMLElement)) return;
    const c = container.getBoundingClientRect();
    const a = active.getBoundingClientRect();
    const delta = a.top - c.top - container.clientHeight * 0.35;
    container.scrollTop = Math.max(0, container.scrollTop + delta);
  };

  const STORAGE_KEY = 'docNavScrollTargetV1';
  const normalisePath = (href) => {
    try {
      const u = new URL(String(href || ''), window.location.origin);
      const p = u.pathname || '/';
      return p.endsWith('/') ? p : p + '/';
    } catch {
      return null;
    }
  };

  const scrollElementToTop = (container, el) => {
    if (!(container instanceof HTMLElement)) return;
    if (!(el instanceof HTMLElement)) return;
    const c = container.getBoundingClientRect();
    const a = el.getBoundingClientRect();
    const delta = a.top - c.top - 8;
    container.scrollTop = Math.max(0, container.scrollTop + delta);
  };

  const scrollToStoredTarget = (container) => {
    if (!(container instanceof HTMLElement)) return false;
    const target = sessionStorage.getItem(STORAGE_KEY);
    if (!target) return false;
    const current = normalisePath(window.location.pathname);
    if (!current || current !== target) return false;
    sessionStorage.removeItem(STORAGE_KEY);
    const links = Array.from(container.querySelectorAll('a.docNavLink, a.docNavSummaryLink'));
    const hit = links.find((a) => normalisePath(a.getAttribute('href')) === target);
    if (hit instanceof HTMLElement) {
      scrollElementToTop(container, hit);
      return true;
    }
    const active = container.querySelector('.docNavLink.active, .docNavSummary.active, .docNavSummaryLink.active');
    if (active instanceof HTMLElement) {
      scrollElementToTop(container, active);
      return true;
    }
    return false;
  };

  const ensureScrolledToActive = (container, tries = 0) => {
    if (!(container instanceof HTMLElement)) return;
    if (tries === 0 && scrollToStoredTarget(container)) return;
    scrollToActive(container);
    const active = container.querySelector('.docNavLink.active');
    if (active instanceof HTMLElement) {
      const c = container.getBoundingClientRect();
      const a = active.getBoundingClientRect();
      const visible = a.top >= c.top + 10 && a.bottom <= c.bottom - 10;
      if (visible) return;
    }
    if (tries >= 10) return;
    setTimeout(() => ensureScrolledToActive(container, tries + 1), 60);
  };

  const setOpen = (next) => {
    if (!(overlay instanceof HTMLElement)) return;
    const canOpen = mobileMq.matches;
    overlay.hidden = !(next && canOpen);
    document.documentElement.classList.toggle('docNavLock', next);
    if (next && drawer instanceof HTMLElement) drawer.focus?.();
    if (!next && openBtn instanceof HTMLElement) openBtn.focus?.();
    if (next && drawerBody instanceof HTMLElement) requestAnimationFrame(() => ensureScrolledToActive(drawerBody, 0));
  };

  setOpen(false);
  mobileMq.addEventListener?.('change', () => setOpen(false));

  if (desktopNav instanceof HTMLElement) {
    requestAnimationFrame(() => ensureScrolledToActive(desktopNav, 0));
    window.addEventListener('load', () => ensureScrolledToActive(desktopNav, 0), { once: true });
  }

  const restoreDefaults = (container) => {
    if (!(container instanceof HTMLElement)) return;
    const groups = Array.from(container.querySelectorAll('details.docNavGroup'));
    for (const d of groups) {
      const val = d.getAttribute('data-default-open') || '0';
      d.open = val === '1';
    }
  };

  const applyTo = (container, qRaw) => {
    if (!(container instanceof HTMLElement)) return;
    const nodes = Array.from(container.querySelectorAll('[data-doc-nav-node]'));
    const groups = Array.from(container.querySelectorAll('details.docNavGroup'));
    const manualRoot = (container.getAttribute('data-current-manual-root') || '').toLowerCase();
    const q = String(qRaw || '').trim().toLowerCase();
    if (!q) {
      for (const el of nodes) {
        el.hidden = false;
        if (el instanceof HTMLElement) el.style.removeProperty('display');
      }
      restoreDefaults(container);
      return;
    }

    for (const el of nodes) {
      const label = (el.getAttribute('data-label') || '').toLowerCase();
      const path = (el.getAttribute('data-path') || '').toLowerCase();
      const text = (el.textContent || '').toLowerCase();
      const withinManual = !manualRoot || path.startsWith(manualRoot);
      const matches = label.includes(q) || path.includes(q) || text.includes(q);
      const hide = !withinManual || !matches;
      el.hidden = hide;
      if (el instanceof HTMLElement) el.style.display = hide ? 'none' : '';
    }

    for (let i = nodes.length - 1; i >= 0; i--) {
      const el = nodes[i];
      const hasVisibleChild = Array.from(el.querySelectorAll('[data-doc-nav-node]')).some((c) => c !== el && !c.hidden);
      if (hasVisibleChild) el.hidden = false;
    }

    for (const d of groups) {
      const hasVisible = Array.from(d.querySelectorAll('[data-doc-nav-node]')).some((c) => !c.hidden);
      d.open = hasVisible;
    }
  };

  const scrollToFirstVisible = (container) => {
    if (!(container instanceof HTMLElement)) return;
    const link = Array.from(container.querySelectorAll('a.docNavLink, a.docNavSummaryLink')).find((a) => a instanceof HTMLElement && !a.closest('[hidden]'));
    if (!(link instanceof HTMLElement)) return;
    const c = container.getBoundingClientRect();
    const a = link.getBoundingClientRect();
    const delta = a.top - c.top - container.clientHeight * 0.25;
    container.scrollTop = Math.max(0, container.scrollTop + delta);
  };

  const onInput = (ev) => {
    const src = ev?.target;
    if (!(src instanceof HTMLInputElement)) return;
    if (!src.matches('input[data-doc-nav-filter]')) return;
    const inputs = getInputs();
    for (const other of inputs) {
      if (other instanceof HTMLInputElement && other !== src) other.value = src.value;
    }
    applyTo(desktopNav, src.value);
    applyTo(drawerBody, src.value);
    const mode = src.getAttribute('data-doc-nav-filter');
    const container = mode === 'mobile' ? drawerBody : desktopNav;
    requestAnimationFrame(() => scrollToFirstVisible(container));
  };

  document.addEventListener('input', onInput, true);
