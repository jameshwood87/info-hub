		'requests': { title: 'ReQuests', desc: 'Manage viewing and information requests from clients.' },
		'contacts': { title: 'Contacts', desc: 'Manage your client database and relationships.' },
		'documents': { title: 'Documents', desc: 'Upload, share, and manage documents for listings and clients.' },
		'sales-pipeline-tracking': { title: 'Sales Pipeline - Tracking', desc: 'Track deals from initial contact to completion.' },
		'calendar': { title: 'Calendar', desc: 'Manage appointments, viewings, and tasks.' },
		'new-developments': { title: 'New Developments', desc: 'Information for developers and new build listings.' },
		'credits': { title: 'Credits', desc: 'Understand and manage your credit balance.' },
		'verified-agency': { title: 'Verified Agency', desc: 'Get verified to build trust with clients and agents.' },
		'reports-and-statistics': { title: 'Reports & Statistics', desc: 'Create reports and track performance and trends.' },
		'security': { title: 'Security', desc: 'Keep accounts secure and manage access.' },
		'technical-documentation': { title: 'Technical Documentation', desc: 'Technical notes for integrations and advanced setup.' },
		'new-features-roadmap': { title: 'New Features & Roadmap', desc: 'What’s new and what’s coming next.' },
		'faq-mls-crm': { title: 'FAQ (MLS & CRM)', desc: 'Common questions, troubleshooting, and quick answers.' },
		'additional-resources': { title: 'Additional Resources', desc: 'Templates, checklists, and supporting materials.' },
	};

	const def = mlsMap[seg];
	if (!def) return null;

	// Basic placeholder for now, unless body is defined
	const body =
		def.body ||
		`
<h2>${def.title}</h2>
<p>${def.desc}</p>
<p>Detailed documentation for ${def.title} is coming soon.</p>
`;

	return {
		id: `legacy-mls-${seg}`,
		status: 'published',
		language: 'en',
		path,
