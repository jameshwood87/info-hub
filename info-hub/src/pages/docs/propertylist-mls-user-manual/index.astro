		margin: 0;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.contentsSub {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.55;
		max-width: 75ch;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		align-items: start;
	}

	.card {
		background: rgba(255, 255, 255, 0.82);
		border: 1px solid rgba(16, 24, 40, 0.08);
