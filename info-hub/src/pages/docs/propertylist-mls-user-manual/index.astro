---
import Layout from '../../../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../../../lib/directus';

const base = '/docs/propertylist-mls-user-manual/';
const items = await listKbPagesByPrefix({ prefix: base, lang: 'en', limit: 500 });

const topTasks = (() => {
	const picks: string[][] = [
		['/creating-a-new-listing', 'creating-a-new-listing'],
		['/import-properties', 'import-properties'],
		['/export-listings-xml', 'export-listings-xml'],
		['/portal-leads', 'portal-leads'],
		['/upload', 'upload'],
	];

	const pickByPathIncludes = (needles: string[]) => items.find((p) => needles.some((n) => p.path.includes(n))) || null;

	const chosen: typeof items = [];
	for (const needles of picks) {
		const hit = pickByPathIncludes(needles);
		if (hit && !chosen.some((c) => c.path === hit.path)) chosen.push(hit);
	}

	for (const item of items) {
		if (chosen.length >= 6) break;
		if (!chosen.some((c) => c.path === item.path)) chosen.push(item);
	}

	return chosen.slice(0, 6);
})();

const titleCase = (s: string) =>
	s
		.replace(/[_-]+/g, ' ')
		.replace(/\b\w/g, (m) => m.toUpperCase())
		.replace(/\bAnd\b/g, 'and');

const labelFor = (seg: string) => {
	const map: Record<string, string> = {
		'getting-started': 'Getting Started',
		'listing-a-property-what-to-know': 'Listing a Property (What to know)',
		'listing-a-property': 'Listing a Property',
		'microsite-share-properties-listings': 'MicroSite & sharing',
		'managing-listings': 'Managing Listings',
		'export-listings': 'Export Listings',
		'marketing-and-promotion': 'Marketing and Promotion',
		'tracking-listing-exposure': 'Tracking listing exposure',
		'searching-for-properties': 'Searching for Properties',
		'ai-ezd_ampersand-automation': 'AI & Automation',
		'mls-property-alerts': 'MLS Property Alerts',
		'managing-your-leads': 'Leads',
		'reports-and-statistics': 'Reports and Statistics',
		'security': 'Security',
		'technical-documentation': 'Technical Documentation',
		'new-features-roadmap': 'New Features & Roadmap',
		'faq-mls': 'FAQ (MLS & CRM)',
		'additional-resources': 'Additional Resources',
		'documents': 'Documents',
		'requests': 'ReQuests',
	};
	return map[seg] || titleCase(seg);
};

const segmentOrder = [
	'getting-started',
	'listing-a-property-what-to-know',
	'managing-listings',
	'export-listings',
	'marketing-and-promotion',
	'searching-for-properties',
	'managing-your-leads',
	'reports-and-statistics',
	'documents',
	'tracking-listing-exposure',
	'mls-property-alerts',
	'ai-ezd_ampersand-automation',
	'technical-documentation',
	'security',
	'faq-mls',
	'additional-resources',
	'new-features-roadmap',
];

const decodeHtmlEntities = (s: string) =>
	s
		.replaceAll('&amp;', '&')
		.replaceAll('&quot;', '"')
		.replaceAll('&#39;', "'")
		.replaceAll('&lt;', '<')
		.replaceAll('&gt;', '>')
		.replaceAll('&nbsp;', ' ');

const stripSuffix = (t: string) => t.replace(/\s*•\s*PropertyList Info Hub\s*$/i, '').trim();
const cleanTitle = (t: string) => decodeHtmlEntities(stripSuffix(t)).trim();

type Node = {
	key: string;
	path: string;
	seg: string;
	title: string;
	children: Node[];
};

const pagesByPath = new Map(items.map((p) => [p.path, p]));
const root: Node = { key: base, path: base, seg: '', title: '', children: [] };

const ensureChild = (parent: Node, seg: string, path: string) => {
	let node = parent.children.find((c) => c.key === path) || null;
	if (!node) {
		node = { key: path, path, seg, title: '', children: [] };
		parent.children.push(node);
	}
	return node;
};

for (const p of items) {
	if (!p.path.startsWith(base)) continue;
	const rest = p.path.slice(base.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = base;
	let parent = root;
	for (const seg of parts) {
		acc += `${seg}/`;
		parent = ensureChild(parent, seg, acc);
		const page = pagesByPath.get(acc);
		if (page?.title) parent.title = cleanTitle(page.title);
	}
}

const depthFromBase = (path: string) => path.slice(base.length).split('/').filter(Boolean).length;

const fillMissingTitles = (node: Node) => {
	if (!node.title && node.seg) node.title = depthFromBase(node.path) === 1 ? labelFor(node.seg) : titleCase(node.seg);
	for (const c of node.children) fillMissingTitles(c);
};

fillMissingTitles(root);

const rank = new Map(segmentOrder.map((s, i) => [s, i]));
const sortTree = (node: Node) => {
	node.children.sort((a, b) => {
		if (node === root) {
			const ar = rank.has(a.seg) ? (rank.get(a.seg) as number) : 9999;
			const br = rank.has(b.seg) ? (rank.get(b.seg) as number) : 9999;
			if (ar !== br) return ar - br;
		}
		return a.title.localeCompare(b.title);
	});
	for (const c of node.children) {
		sortTree(c);
	}
};

sortTree(root);

const escapeHtml = (s: string) =>
	s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');

const renderNodesHtml = (nodes: Node[]): string =>
	nodes
		.map((n) => {
			const label = escapeHtml((n.title || '').toLowerCase());
			const href = escapeHtml(n.path);
			const title = escapeHtml(n.title);
			const children = n.children.length ? `<ul>${renderNodesHtml(n.children)}</ul>` : '';
			return `<li class="node" data-node="1" data-label="${label}"><a href="${href}">${title}</a>${children}</li>`;
		})
		.join('');
---

<Layout
	lang="en"
	title="MLS & CRM User Manual • PropertyList Info Hub"
	description="MLS & CRM user manual for PropertyList: listings, leads, contacts, documents, XML import/export, and reporting."
	canonical="https://info.propertylist.es/docs/propertylist-mls-user-manual/"
>
	<section class="hero">
		<div class="heroInner">
			<div class="badge">User manual</div>
			<h1>MLS &amp; CRM USER MANUAL</h1>
			<p class="lead">
				Step-by-step guides for using PropertyList to manage listings, contacts, leads, documents, reports, and XML import/export.
				Use the filter to quickly find the exact workflow you need.
			</p>
			<div class="filterRow">
				<label class="filterLabel" for="doc-filter">Filter</label>
				<input id="doc-filter" class="filterInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search within this manual…" />
			</div>
		</div>
	</section>

	{topTasks.length ? (
		<section class="top">
			<h2>Popular tasks</h2>
			<div class="rows">
				{topTasks.map((p) => (
					<a class="row" href={p.path}>
						<div class="rowTitle">{cleanTitle(p.title)}</div>
						{p.description ? <div class="rowDesc">{p.description}</div> : null}
					</a>
				))}
			</div>
		</section>
	) : null}

	<section class="treeWrap" aria-label="Manual contents">
		{root.children.length ? <ul class="tree" set:html={renderNodesHtml(root.children)} /> : <div class="empty">No MLS docs yet.</div>}
	</section>
</Layout>

<style>
	.hero {
		background: radial-gradient(1200px 600px at 30% -10%, rgba(0, 174, 154, 0.18), rgba(255, 255, 255, 0));
		border-radius: 22px;
		padding: 18px;
		margin-bottom: 14px;
		border: 1px solid rgba(16, 24, 40, 0.08);
	}

	.heroInner {
		background: rgba(255, 255, 255, 0.75);
		border-radius: 18px;
		padding: 18px;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 800;
		font-size: 12px;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.04em;
		line-height: 1.06;
	}

	h2 {
		margin: 0 0 12px;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.lead {
		margin: 10px 0 0;
		color: rgba(16, 24, 40, 0.78);
		font-size: 16px;
		line-height: 1.55;
	}

	.filterRow {
		margin-top: 12px;
	}

	.filterLabel {
		display: block;
		font-size: 13px;
		color: rgba(16, 24, 40, 0.7);
		margin: 0 0 4px;
	}

	.filterInput {
		width: min(360px, 100%);
		border: 1px solid rgba(16, 24, 40, 0.18);
		border-radius: 8px;
		padding: 8px 10px;
		background: rgba(255, 255, 255, 0.9);
		margin: 0 0 12px;
	}

	.top {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
		margin: 14px 0;
	}

	.rows {
		display: grid;
		gap: 10px;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.row {
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 14px;
		padding: 12px 14px;
		text-decoration: none;
	}

	.row:hover {
		text-decoration: none;
		border-color: rgba(0, 174, 154, 0.35);
	}

	.rowTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		color: rgba(16, 24, 40, 0.92);
	}

	.rowDesc {
		margin-top: 6px;
		color: rgba(16, 24, 40, 0.7);
		font-size: 14px;
		line-height: 1.4;
	}

	.treeWrap {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.tree,
	.tree ul {
		margin: 0;
	}

	.tree {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.tree > .node {
		background: rgba(255, 255, 255, 0.82);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 16px;
		padding: 12px 12px;
	}

	.tree > .node > a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: rgba(16, 24, 40, 0.92);
		text-decoration: none;
		font-weight: 900;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.tree > .node > a:hover {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}

	.tree > .node > ul {
		list-style: none;
		padding: 10px 0 0 0;
		margin: 0;
		display: grid;
		gap: 6px;
	}

	.tree ul .node {
		position: relative;
		padding-left: 14px;
	}

	.tree ul .node::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: rgba(0, 174, 154, 0.85);
		position: absolute;
		left: 0;
		top: 0.7em;
	}

	.tree ul .node > a {
		color: rgba(16, 24, 40, 0.86);
		text-decoration: none;
		font-weight: 800;
	}

	.tree ul .node > a:hover {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}

	.tree ul ul {
		list-style: none;
		margin: 6px 0 0 0;
		padding-left: 14px;
		display: grid;
		gap: 6px;
		border-left: 1px solid rgba(16, 24, 40, 0.12);
	}

	.tree ul ul .node::before {
		background: rgba(16, 24, 40, 0.28);
	}

	.empty,
	.emptySmall {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	@media (max-width: 980px) {
		.rows {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.tree {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.rows {
			grid-template-columns: 1fr;
		}
	}
</style>

<script is:inline>
	(() => {
		const input = document.getElementById('doc-filter');
		if (!(input instanceof HTMLInputElement)) return;
		const nodes = Array.from(document.querySelectorAll('li[data-node]'));

		const apply = () => {
			const q = (input.value || '').trim().toLowerCase();
			if (!q) {
				for (const li of nodes) li.hidden = false;
				return;
			}

			for (const li of nodes) {
				const label = (li.getAttribute('data-label') || '').toLowerCase();
				li.hidden = !label.includes(q);
			}

			for (let i = nodes.length - 1; i >= 0; i--) {
				const li = nodes[i];
				const child = li.querySelector('ul');
				if (!child) continue;
				const hasVisibleChild = Array.from(child.querySelectorAll(':scope > li[data-node]')).some((c) => !c.hidden);
				if (hasVisibleChild) li.hidden = false;
			}
		};

		input.addEventListener('input', apply, { passive: true });
	})();
</script>
