		margin: 10px 0 0;
		color: rgba(16, 24, 40, 0.78);
		font-size: 16px;
		line-height: 1.55;
	}

	.filterRow {
		margin-top: 12px;
	}

	.filterLabel {
		display: block;
		font-size: 13px;
		color: rgba(16, 24, 40, 0.7);
		margin: 0 0 4px;
	}

	.filterInput {
		width: min(360px, 100%);
		border: 1px solid rgba(16, 24, 40, 0.18);
		border-radius: 8px;
		padding: 8px 10px;
		background: rgba(255, 255, 255, 0.9);
		margin: 0 0 12px;
