		gap: 10px;
	}

	.cardHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
	}

	.cardTitle {
		color: #00ae9a;
		text-decoration: none;
		font-weight: 900;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.cardTitle:visited {
		color: #00ae9a;
	}

	.cardTitle:hover {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}

	.cardMeta {
		font-size: 12px;
		font-weight: 900;
		color: rgba(16, 24, 40, 0.6);
		background: rgba(16, 24, 40, 0.05);
		border: 1px solid rgba(16, 24, 40, 0.08);
		padding: 4px 8px;
		border-radius: 999px;
		white-space: nowrap;
	}

	.cardDesc {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.5;
		font-weight: 650;
	}

	.list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 6px;
	}

	.listRow {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2px;
		padding: 8px 10px;
		border-radius: 12px;
		border: 1px solid rgba(16, 24, 40, 0.08);
		background: rgba(255, 255, 255, 0.9);
		text-decoration: none;
	}

	.listRow:hover {
		text-decoration: none;
		border-color: rgba(0, 174, 154, 0.35);
	}

	.listRowTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		color: rgba(16, 24, 40, 0.9);
	}

	.more {
		border-top: 1px solid rgba(16, 24, 40, 0.08);
		padding-top: 10px;
	}

	.moreSummary {
		cursor: pointer;
		font-weight: 900;
		color: rgba(16, 24, 40, 0.78);
	}

	.moreList {
		margin-top: 10px;
	}

	.empty,
	.emptySmall {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	@media (max-width: 980px) {
		.rows {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.rows {
			grid-template-columns: 1fr;
		}
