---
import Layout from '../../../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../../../lib/directus';

const base = '/docs/propertylist-mls-user-manual/';
const seedLegacyMlsListing = () => {
	const definitions = [
		{ seg: 'getting-started', title: 'Getting Started', desc: 'Set up your account, get the app, and learn the basics.' },
		{ seg: 'your-account', title: 'Your Account', desc: 'Manage your profile, company details, and preferences.' },
		{ seg: 'listing-a-property', title: 'Listing a Property', desc: 'Create, edit, and manage listings from start to finish.' },
		{ seg: 'microsite-share', title: 'MicroSite - Share', desc: 'Share properties with links, microsites, and clients.' },
		{ seg: 'managing-listings', title: 'Managing Listings', desc: 'Update status, edit listings, and track enquiries and activity.' },
		{ seg: 'marketing-and-promotion', title: 'Marketing and Promotion', desc: 'Promote listings across MLS, portals, and social channels.' },
		{ seg: 'tracking-listing-exposure', title: 'Tracking listing exposure', desc: 'Measure listing performance and visibility.' },
		{ seg: 'searching-for-properties', title: 'Searching for Properties', desc: 'Find listings fast with filters, saved searches, and alerts.' },
		{ seg: 'ai-and-automation', title: 'AI & Automation', desc: 'Automate workflows and use AI features where available.' },
		{ seg: 'mls-property-alerts', title: 'MLS Property Alerts', desc: 'Set up alerts to keep buyers and agents updated.' },
		{ seg: 'leads', title: 'LEADS', desc: 'Capture leads, qualify them, and follow up effectively.' },
		{ seg: 'requests', title: 'ReQuests', desc: 'Manage viewing and information requests from clients.' },
		{ seg: 'contacts', title: 'Contacts', desc: 'Manage your client database and relationships.' },
		{ seg: 'documents', title: 'Documents', desc: 'Upload, share, and manage documents for listings and clients.' },
		{ seg: 'sales-pipeline-tracking', title: 'Sales Pipeline - Tracking', desc: 'Track deals from initial contact to completion.' },
		{ seg: 'calendar', title: 'Calendar', desc: 'Manage appointments, viewings, and tasks.' },
		{ seg: 'new-developments', title: 'New Developments', desc: 'Information for developers and new build listings.' },
		{ seg: 'credits', title: 'Credits', desc: 'Understand and manage your credit balance.' },
		{ seg: 'verified-agency', title: 'Verified Agency', desc: 'Get verified to build trust with clients and agents.' },
		{ seg: 'reports-and-statistics', title: 'Reports & Statistics', desc: 'Create reports and track performance and trends.' },
		{ seg: 'security', title: 'Security', desc: 'Keep accounts secure and manage access.' },
		{ seg: 'technical-documentation', title: 'Technical Documentation', desc: 'Technical notes for integrations and advanced setup.' },
		{ seg: 'new-features-roadmap', title: 'New Features & Roadmap', desc: 'What’s new and what’s coming next.' },
		{ seg: 'faq-mls-crm', title: 'FAQ (MLS & CRM)', desc: 'Common questions, troubleshooting, and quick answers.' },
		{ seg: 'additional-resources', title: 'Additional Resources', desc: 'Templates, checklists, and supporting materials.' },
	];

	return definitions.map((d) => ({
		id: `legacy-mls-${d.seg}`,
		language: 'en',
		path: `/docs/propertylist-mls-user-manual/${d.seg}/`,
		title: d.title,
		description: d.desc,
	}));
};

const itemsRaw = [...(await listKbPagesByPrefix({ prefix: base, lang: 'en', limit: 500 })), ...seedLegacyMlsListing()];

const shouldHideFromManualIndex = (p: (typeof itemsRaw)[number]) => {
	const title = String(p.title || '')
		.replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '')
		.trim()
		.toLowerCase();
	const path = String(p.path || '').toLowerCase();

	if (title.includes('wp plugin (customisable)')) return true;
	if (title.includes('developers pre-sign up')) return true;
	if (path.includes('wp-plugin')) return true;
	if (path.includes('pre-sign')) return true;

	return false;
};

const items = itemsRaw.filter((p) => !shouldHideFromManualIndex(p));

const topTasks = (() => {
	const picks: string[][] = [
		['/creating-a-new-listing', 'creating-a-new-listing'],
		['/import-properties', 'import-properties'],
		['/export-listings-xml', 'export-listings-xml'],
		['/portal-leads', 'portal-leads'],
		['/upload', 'upload'],
	];

	const pickByPathIncludes = (needles: string[]) => items.find((p) => needles.some((n) => p.path.includes(n))) || null;

	const chosen: typeof items = [];
	for (const needles of picks) {
		const hit = pickByPathIncludes(needles);
		if (hit && !chosen.some((c) => c.path === hit.path)) chosen.push(hit);
	}

	for (const item of items) {
		if (chosen.length >= 6) break;
		if (!chosen.some((c) => c.path === item.path)) chosen.push(item);
	}

	return chosen.slice(0, 6);
})();

const titleCase = (s: string) =>
	s
		.replace(/[_-]+/g, ' ')
		.replace(/\b\w/g, (m) => m.toUpperCase())
		.replace(/\bAnd\b/g, 'and');

const labelFor = (seg: string) => {
	const map: Record<string, string> = {
		'getting-started': 'Getting Started',
		'listing-a-property-what-to-know': 'Listing a Property (What to know)',
		'listing-a-property': 'Listing a Property',
		'microsite-share-properties-listings': 'MicroSite & sharing',
		'managing-listings': 'Managing Listings',
		'export-listings': 'Export Listings',
		'marketing-and-promotion': 'Marketing and Promotion',
		'tracking-listing-exposure': 'Tracking listing exposure',
		'searching-for-properties': 'Searching for Properties',
		'ai-ezd_ampersand-automation': 'AI & Automation',
		'mls-property-alerts': 'MLS Property Alerts',
		'managing-your-leads': 'Leads',
		'reports-and-statistics': 'Reports and Statistics',
		'security': 'Security',
		'technical-documentation': 'Technical Documentation',
		'new-features-roadmap': 'New Features & Roadmap',
		'faq-mls': 'FAQ (MLS & CRM)',
		'additional-resources': 'Additional Resources',
		'documents': 'Documents',
		'requests': 'ReQuests',
	};
	return map[seg] || titleCase(seg);
};

const segmentOrder = [
	'getting-started',
	'listing-a-property-what-to-know',
	'managing-listings',
	'export-listings',
	'marketing-and-promotion',
	'searching-for-properties',
	'managing-your-leads',
	'reports-and-statistics',
	'documents',
	'tracking-listing-exposure',
	'mls-property-alerts',
	'ai-ezd_ampersand-automation',
	'technical-documentation',
	'security',
	'faq-mls',
	'additional-resources',
	'new-features-roadmap',
];

const decodeHtmlEntities = (s: string) =>
	s
		.replaceAll('&amp;', '&')
		.replaceAll('&quot;', '"')
		.replaceAll('&#39;', "'")
		.replaceAll('&lt;', '<')
		.replaceAll('&gt;', '>')
		.replaceAll('&nbsp;', ' ');

const stripSuffix = (t: string) => t.replace(/\s*•\s*PropertyList Info Hub\s*$/i, '').trim();
const cleanTitle = (t: string) => decodeHtmlEntities(stripSuffix(t)).trim();

const topTaskIcons = {
	listing:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 10.5 12 4.5l7.5 6v9.75c0 .69-.56 1.25-1.25 1.25H5.75c-.69 0-1.25-.56-1.25-1.25V10.5Z" stroke="currentColor" stroke-width="1.7" /><path d="M12 11v6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M9 14h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>',
	importIcon:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3.5v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M8.5 10.5 12 13.8l3.5-3.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><path d="M5.5 20.5h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>',
	exportIcon:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 20.5v-10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M8.5 13.5 12 10.2l3.5 3.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><path d="M5.5 3.5h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>',
	leads:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16.8 20.5c0-2.7-2-4.4-4.8-4.4s-4.8 1.7-4.8 4.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M12 13.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke="currentColor" stroke-width="1.7" /></svg>',
	upload:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.2 12.8 13 8a3.3 3.3 0 0 1 4.7 4.7l-6 6a5.3 5.3 0 0 1-7.5-7.5l6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>',
	defaultIcon:
		'<svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 4.5h7l3 3v12.75c0 .69-.56 1.25-1.25 1.25H7.25C6.56 21.75 6 21.19 6 20.5V5.75C6 5.06 6.56 4.5 7.25 4.5Z" stroke="currentColor" stroke-width="1.7" /><path d="M14 4.5V8h3" stroke="currentColor" stroke-width="1.7" /></svg>',
};

const iconForTopTask = (path: string) => {
	const p = String(path || '');
	if (p.includes('/creating-a-new-listing')) return topTaskIcons.listing;
	if (p.includes('/import-properties')) return topTaskIcons.importIcon;
	if (p.includes('/export-listings-xml') || p.includes('/export-listings')) return topTaskIcons.exportIcon;
	if (p.includes('/portal-leads') || p.includes('/leads')) return topTaskIcons.leads;
	if (p.includes('/upload') || p.includes('/documents')) return topTaskIcons.upload;
	return topTaskIcons.defaultIcon;
};

type Node = {
	key: string;
	path: string;
	seg: string;
	title: string;
	children: Node[];
};

const pagesByPath = new Map(items.map((p) => [p.path, p]));
const root: Node = { key: base, path: base, seg: '', title: '', children: [] };

const ensureChild = (parent: Node, seg: string, path: string) => {
	let node = parent.children.find((c) => c.key === path) || null;
	if (!node) {
		node = { key: path, path, seg, title: '', children: [] };
		parent.children.push(node);
	}
	return node;
};

for (const p of items) {
	if (!p.path.startsWith(base)) continue;
	const rest = p.path.slice(base.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = base;
	let parent = root;
	for (const seg of parts) {
		acc += `${seg}/`;
		parent = ensureChild(parent, seg, acc);
		const page = pagesByPath.get(acc);
		if (page?.title) parent.title = cleanTitle(page.title);
	}
}

const depthFromBase = (path: string) => path.slice(base.length).split('/').filter(Boolean).length;

const fillMissingTitles = (node: Node) => {
	if (!node.title && node.seg) node.title = depthFromBase(node.path) === 1 ? labelFor(node.seg) : titleCase(node.seg);
	for (const c of node.children) fillMissingTitles(c);
};

fillMissingTitles(root);

const rank = new Map(segmentOrder.map((s, i) => [s, i]));
const sortTree = (node: Node) => {
	node.children.sort((a, b) => {
		if (node === root) {
			const ar = rank.has(a.seg) ? (rank.get(a.seg) as number) : 9999;
			const br = rank.has(b.seg) ? (rank.get(b.seg) as number) : 9999;
			if (ar !== br) return ar - br;
		}
		return a.title.localeCompare(b.title);
	});
	for (const c of node.children) {
		sortTree(c);
	}
};

sortTree(root);

const segmentDescriptions: Record<string, string> = {
	'getting-started': 'Set up your account, get the app, and learn the basics.',
	'listing-a-property-what-to-know': 'Before you publish: compliance, preparation, and best practices.',
	'listing-a-property': 'Create, edit, and manage listings from start to finish.',
	'microsite-share-properties-listings': 'Share properties with links, microsites, and clients.',
	'managing-listings': 'Update status, edit listings, and track enquiries and activity.',
	'export-listings': 'Export listings to portals, websites, and MLS feeds.',
	'marketing-and-promotion': 'Promote listings across MLS, portals, and social channels.',
	'tracking-listing-exposure': 'Measure listing performance and visibility.',
	'searching-for-properties': 'Find listings fast with filters, saved searches, and alerts.',
	'ai-ezd_ampersand-automation': 'Automate workflows and use AI features where available.',
	'mls-property-alerts': 'Set up alerts to keep buyers and agents updated.',
	'managing-your-leads': 'Capture leads, qualify them, and follow up effectively.',
	'reports-and-statistics': 'Create reports and track performance and trends.',
	'security': 'Keep accounts secure and manage access.',
	'technical-documentation': 'Technical notes for integrations and advanced setup.',
	'new-features-roadmap': 'What’s new and what’s coming next.',
	'faq-mls': 'Common questions, troubleshooting, and quick answers.',
	'additional-resources': 'Templates, checklists, and supporting materials.',
	'documents': 'Upload, share, and manage documents for listings and clients.',
	'requests': 'Manage viewing and information requests from clients.',
};

type PageLink = { path: string; title: string };

const listDescendantPages = (node: Node): PageLink[] => {
	const out: PageLink[] = [];
	const visit = (n: Node) => {
		for (const c of n.children) {
			const page = pagesByPath.get(c.path);
			if (page?.title) out.push({ path: c.path, title: cleanTitle(page.title) });
			visit(c);
		}
	};
	visit(node);
	return out
		.filter((p) => p.path !== node.path)
		.sort((a, b) => a.title.localeCompare(b.title));
};
---

<Layout
	lang="en"
	title="MLS & CRM User Manual • PropertyList Info Hub"
	description="MLS & CRM user manual for PropertyList: listings, leads, contacts, documents, XML import/export, and reporting."
	canonical="https://info.propertylist.es/docs/propertylist-mls-user-manual/"
>
	<section class="hero">
		<div class="heroInner">
			<div class="badge">User manual</div>
			<h1>MLS &amp; CRM USER MANUAL</h1>
			<p class="lead">
				Step-by-step guides for using PropertyList to manage listings, contacts, leads, documents, reports, and XML import/export.
				Use the filter to quickly find the exact workflow you need.
			</p>
			<div class="filterRow">
				<label class="filterLabel" for="doc-filter">Filter</label>
				<input id="doc-filter" class="filterInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search within this manual…" />
			</div>
		</div>
	</section>

	{topTasks.length ? (
		<section class="top">
			<h2>Popular tasks</h2>
			<div class="rows">
				{topTasks.map((p) => (
					<a class="row" href={p.path}>
						<div class="rowIcon" aria-hidden="true" set:html={iconForTopTask(p.path)} />
						<div class="rowTitle">{cleanTitle(p.title)}</div>
					</a>
				))}
			</div>
		</section>
	) : null}

	<section class="contents" aria-label="Manual contents">
		<div class="contentsHeader">
			<h2 class="contentsTitle">Browse by topic</h2>
			<p class="contentsSub">Choose a topic, then pick a guide. Use the filter to search across all topics.</p>
		</div>
		{root.children.length ? (
			<div class="grid" data-grid="1">
				{root.children.map((seg) => {
					const pages = listDescendantPages(seg);
					const featured = pages.slice(0, 8);
					const remaining = pages.slice(8);
					const label = (seg.title || '').toLowerCase();
					const desc = segmentDescriptions[seg.seg] || 'Guides and workflows for this topic.';
					return (
						<section class="card" data-card="1" data-label={label}>
							<div class="cardHeader">
								<a class="cardTitle" href={seg.path}>
									{seg.title}
								</a>
								<span class="cardMeta">{pages.length} guides</span>
							</div>
							<p class="cardDesc">{desc}</p>
							{featured.length ? (
								<ul class="list">
									{featured.map((p) => (
										<li data-node="1" data-label={p.title.toLowerCase()}>
											<a class="listRow" href={p.path}>
												<span class="listRowTitle">{p.title}</span>
											</a>
										</li>
									))}
								</ul>
							) : (
								<div class="emptySmall">No guides yet.</div>
							)}
							{remaining.length ? (
								<details class="more" data-more="1">
									<summary class="moreSummary">Show all ({pages.length})</summary>
									<ul class="list moreList">
										{remaining.map((p) => (
											<li data-node="1" data-label={p.title.toLowerCase()}>
												<a class="listRow" href={p.path}>
													<span class="listRowTitle">{p.title}</span>
												</a>
											</li>
										))}
									</ul>
								</details>
							) : null}
						</section>
					);
				})}
			</div>
		) : (
			<div class="empty">No MLS docs yet.</div>
		)}
	</section>
</Layout>

<style>
	.hero {
		background: radial-gradient(1200px 600px at 30% -10%, rgba(0, 174, 154, 0.18), rgba(255, 255, 255, 0));
		border-radius: 22px;
		padding: 18px;
		margin-bottom: 14px;
		border: 1px solid rgba(16, 24, 40, 0.08);
	}

	.heroInner {
		background: rgba(255, 255, 255, 0.75);
		border-radius: 18px;
		padding: 18px;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(0, 174, 154, 0.12);
		border: 1px solid rgba(0, 174, 154, 0.22);
		color: rgba(16, 24, 40, 0.86);
		font-weight: 800;
		font-size: 12px;
