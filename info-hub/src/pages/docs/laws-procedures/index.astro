---
import Layout from '../../../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../../../lib/directus';

const base = '/docs/laws-procedures/';
const items = await listKbPagesByPrefix({ prefix: base, lang: 'en', limit: 500 });

const seedLegacyListing = () => {
	const seg = 'listing-a-property-what-to-know';
	const viewAllHref = `${base}${seg}/`;
	const exists = items.some((p) => p.path === viewAllHref || p.path.startsWith(viewAllHref));
	if (exists) return [];

	return [
		{
			id: 'legacy-laws-procedures-listing-a-property-what-to-know',
			language: 'en',
			path: viewAllHref,
			title: 'Listing a Property (What to know)',
			description: 'What to know before listing a property in Andalusia.',
		},
		{
			id: 'legacy-laws-procedures-listing-a-property-what-to-know-estate-agents',
			language: 'en',
			path: `${viewAllHref}estate-agents/`,
			title: 'Estate Agents',
			description: 'Guidance for agents listing on behalf of owners.',
		},
		{
			id: 'legacy-laws-procedures-listing-a-property-what-to-know-owners',
			language: 'en',
			path: `${viewAllHref}owners/`,
			title: 'Owners',
			description: 'What owners should prepare before publishing a listing.',
		},
	];
};

items.push(...seedLegacyListing());

const titleCase = (s: string) =>
	s
		.replace(/[_-]+/g, ' ')
		.replace(/\b\w/g, (m) => m.toUpperCase())
		.replace(/\bAnd\b/g, 'and');

const decodeHtmlEntities = (s: string) =>
	s
		.replaceAll('&amp;', '&')
		.replaceAll('&quot;', '"')
		.replaceAll('&#39;', "'")
		.replaceAll('&lt;', '<')
		.replaceAll('&gt;', '>')
		.replaceAll('&nbsp;', ' ');

const stripSuffix = (t: string) => t.replace(/\s*•\s*PropertyList Info Hub\s*$/i, '').trim();
const cleanTitle = (t: string) => decodeHtmlEntities(stripSuffix(t)).trim();

type Node = {
	key: string;
	path: string;
	seg: string;
	title: string;
	children: Node[];
};

const pagesByPath = new Map(items.map((p) => [p.path, p]));
const root: Node = { key: base, path: base, seg: '', title: '', children: [] };

const ensureChild = (parent: Node, seg: string, path: string) => {
	let node = parent.children.find((c) => c.key === path) || null;
	if (!node) {
		node = { key: path, path, seg, title: '', children: [] };
		parent.children.push(node);
	}
	return node;
};

for (const p of items) {
	if (!p.path.startsWith(base)) continue;
	const rest = p.path.slice(base.length);
	const parts = rest.split('/').filter(Boolean);
	let acc = base;
	let parent = root;
	for (const seg of parts) {
		acc += `${seg}/`;
		parent = ensureChild(parent, seg, acc);
		const page = pagesByPath.get(acc);
		if (page?.title) parent.title = cleanTitle(page.title);
	}
}

const fillMissingTitles = (node: Node) => {
	if (!node.title && node.seg) node.title = titleCase(node.seg);
	for (const c of node.children) fillMissingTitles(c);
};

fillMissingTitles(root);

const topOrder = [
	'listing-a-property-what-to-know',
	'buying-a-property',
	'selling-a-property',
	'renovating-a-property',
	'building-a-property',
	'renting-a-property',
	'traspaso-business-transfer',
	'property-taxes-in-andalucia',
	'inheritance-laws-in-andalucia',
	'property-insurance-in-andalucia',
];
const topRank = new Map(topOrder.map((s, i) => [s, i]));

const sortTree = (node: Node) => {
	node.children.sort((a, b) => {
		if (node === root) {
			const ar = topRank.has(a.seg) ? (topRank.get(a.seg) as number) : 9999;
			const br = topRank.has(b.seg) ? (topRank.get(b.seg) as number) : 9999;
			if (ar !== br) return ar - br;
		}
		return a.title.localeCompare(b.title);
	});
	for (const c of node.children) {
		sortTree(c);
	}
};

sortTree(root);

const escapeHtml = (s: string) =>
	s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');

const renderNodesHtml = (nodes: Node[]): string =>
	nodes
		.map((n) => {
			const label = escapeHtml((n.title || '').toLowerCase());
			const href = escapeHtml(n.path);
			const title = escapeHtml(n.title);
			const children = n.children.length ? `<ul>${renderNodesHtml(n.children)}</ul>` : '';
			return `<li class="node" data-node="1" data-label="${label}"><a href="${href}">${title}</a>${children}</li>`;
		})
		.join('');
---

<Layout
	lang="en"
	title="Laws & Procedures Docs • PropertyList Info Hub"
	description="Guides covering laws, procedures, taxes, rentals and property rules in Spain."
	canonical="https://info.propertylist.es/docs/laws-procedures/"
>
	<h1>LAWS &amp; PROCEDURES</h1>
	<label class="filterLabel" for="doc-filter">Filter</label>
	<input id="doc-filter" class="filterInput" type="search" autocomplete="off" spellcheck="false" />

	{root.children.length ? <ul class="tree" set:html={renderNodesHtml(root.children)} /> : <div class="empty">No docs yet.</div>}
</Layout>

<style>
	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.02em;
	}

	.filterLabel {
		display: block;
		font-size: 13px;
		color: rgba(16, 24, 40, 0.7);
		margin: 0 0 4px;
	}

	.filterInput {
		width: min(360px, 100%);
		border: 1px solid rgba(16, 24, 40, 0.18);
		border-radius: 8px;
		padding: 8px 10px;
		background: rgba(255, 255, 255, 0.9);
		margin: 0 0 12px;
	}

	.tree,
	.tree ul {
		list-style: disc;
		padding-left: 18px;
		margin: 0;
	}

	.tree > .node {
		margin-top: 6px;
	}

	.node a {
		color: #0b57d0;
		text-decoration: underline;
	}

	.node a:hover {
		text-decoration-thickness: 2px;
	}

	.empty {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}
</style>

<script is:inline>
	(() => {
		const input = document.getElementById('doc-filter');
		if (!(input instanceof HTMLInputElement)) return;
		const nodes = Array.from(document.querySelectorAll('li[data-node]'));

		const apply = () => {
			const q = (input.value || '').trim().toLowerCase();
			if (!q) {
				for (const li of nodes) li.hidden = false;
				return;
			}

			for (const li of nodes) {
				const label = (li.getAttribute('data-label') || '').toLowerCase();
				li.hidden = !label.includes(q);
			}

			for (let i = nodes.length - 1; i >= 0; i--) {
				const li = nodes[i];
				const child = li.querySelector('ul');
				if (!child) continue;
				const hasVisibleChild = Array.from(child.querySelectorAll(':scope > li[data-node]')).some((c) => !c.hidden);
				if (hasVisibleChild) li.hidden = false;
			}
		};

		input.addEventListener('input', apply, { passive: true });
	})();
</script>
