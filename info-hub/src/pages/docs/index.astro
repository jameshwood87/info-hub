---
import Layout from '../../layouts/Layout.astro';
import { listKbPagesByPrefix, type KbPageListItem } from '../../lib/directus';

const mlsAll = await listKbPagesByPrefix({ prefix: '/docs/propertylist-mls-user-manual/', lang: 'en', limit: 250 });
const lawsAll = await listKbPagesByPrefix({ prefix: '/docs/laws-procedures/', lang: 'en', limit: 250 });
const portalAll = await listKbPagesByPrefix({ prefix: '/docs/public-portal/', lang: 'en', limit: 250 });
const latestAll = await listKbPagesByPrefix({ prefix: '/docs/', lang: 'en', limit: 20 });

const excludeFromLatest = new Set([
	'/docs/',
	'/docs/propertylist-mls-user-manual/',
	'/docs/laws-procedures/',
	'/docs/public-portal/',
]);
const latestDocs = latestAll.filter((p) => !excludeFromLatest.has(p.path)).slice(0, 5);

const stripSuffix = (s: string) => s.replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '').trim();

const pickByPathIncludes = (items: KbPageListItem[], needles: string[]) =>
	items.find((p) => needles.some((n) => p.path.includes(n))) || null;

const pickTopTasks = (items: KbPageListItem[], picks: string[][], fallbackCount = 4) => {
	const chosen: KbPageListItem[] = [];
	for (const needles of picks) {
		const hit = pickByPathIncludes(items, needles);
		if (hit && !chosen.some((c) => c.path === hit.path)) chosen.push(hit);
	}
	for (const item of items) {
		if (chosen.length >= fallbackCount) break;
		if (!chosen.some((c) => c.path === item.path)) chosen.push(item);
	}
	return chosen.slice(0, fallbackCount);
};

const mlsTop = pickTopTasks(
	mlsAll,
	[
		['/import-properties', 'import-properties'],
		['/export-listings-xml', 'export-listings-xml'],
		['/portal-leads', 'portal-leads'],
		['/duplicate-properties', 'duplicate-properties'],
		['/upload-link-documents', 'upload-link-documents'],
	]
);

const lawsTop = pickTopTasks(
	lawsAll,
	[
		['/requirements-for-landlords', 'requirements-for-landlords'],
		['/taxes-for-landlords', 'taxes-for-landlords'],
		['/construction-standards', 'construction-standards'],
		['/inspections-and-compliance', 'inspections-and-compliance'],
	]
);

const portalTop = pickTopTasks(portalAll, [['/getting-started', 'getting-started']], 3);

const developerTop = [
	{ title: 'CRM (contacts, leads, workflows)', href: '/docs/developers/#crm' },
	{ title: 'How to list properties', href: '/docs/developers/#list-properties' },
	{ title: 'How to edit properties', href: '/docs/developers/#edit-properties' },
	{ title: 'How to feature properties', href: '/docs/developers/#feature-properties' },
];

const areaGuidesTop = [
	{ title: 'Area Guides (English)', href: '/neighbourhood/' },
	{ title: 'Guías de barrios (Español)', href: '/es/barrios/' },
	{ title: 'Search Area Guides', href: '/search?q=Area%20Guides' },
];

const paidToolsTop = [
	{ title: 'Pricing & credits', href: '/pricing/' },
	{ title: 'Featured MLS Listings', href: '/search?q=Featured%20MLS%20Listings' },
	{ title: 'Featured Public Portal Listings', href: '/search?q=Featured%20Public%20Portal%20Listings' },
	{ title: 'AI Tools', href: '/search?q=AI%20Tools' },
];
---

<Layout
	lang="en"
	title="Documentation • PropertyList Info Hub"
	description="Find the right documentation fast — MLS, Public Portal, laws and legal."
	canonical="https://info.propertylist.es/docs/"
>
	<h1>Documentation</h1>
	<p class="sub">Choose a section to get to the right answer quickly.</p>

	<div class="start">
		<div class="startTitle">Start with your role</div>
		<div class="chips">
			<a class="chip" href="/docs/propertylist-mls-user-manual/?role=estate-agents">Estate agent</a>
			<a class="chip" href="/docs/developers/">Developer</a>
			<a class="chip" href="/search?q=Property%20Services">Property Service</a>
			<a class="chip" href="/docs/public-portal/">Public</a>
		</div>
	</div>

	<div class="dropList" aria-label="Documentation sections">
		<details class="drop">
			<summary class="dropSummary">
				<div class="dropSummaryText">
					<div class="dropTitle">Public Portal Docs</div>
					<div class="dropSub">How to use the public portal — search, save, and enquire.</div>
				</div>
			</summary>
			<div class="dropBody">
				{portalTop.length ? (
					<div class="rows">
						{portalTop.map((p) => (
							<a class="row" href={p.path}>
								<div class="rowTitle">{stripSuffix(p.title)}</div>
								{p.description ? <div class="rowDesc">{p.description}</div> : null}
							</a>
						))}
					</div>
				) : (
					<div class="empty">Public portal documentation is coming soon.</div>
				)}
				<a class="viewAll" href="/docs/public-portal/">View All</a>
			</div>
		</details>

		<details class="drop">
			<summary class="dropSummary">
				<div class="dropSummaryText">
					<div class="dropTitle">MLS &amp; CRM Docs</div>
					<div class="dropSub">How to use the MLS and CRM. Split for estate agents and developers.</div>
				</div>
			</summary>
			<div class="dropBody">
				{mlsTop.length ? (
					<div class="rows">
						{mlsTop.map((p) => (
							<a class="row" href={p.path}>
								<div class="rowTitle">{stripSuffix(p.title)}</div>
								{p.description ? <div class="rowDesc">{p.description}</div> : null}
							</a>
						))}
					</div>
				) : (
					<div class="empty">No MLS documentation yet.</div>
				)}
				<a class="viewAll" href="/docs/propertylist-mls-user-manual/">View All</a>
			</div>
		</details>

		<details class="drop">
			<summary class="dropSummary">
				<div class="dropSummaryText">
					<div class="dropTitle">Laws &amp; Procedures Docs</div>
					<div class="dropSub">Buying, renting, taxes, and Spanish property procedures.</div>
				</div>
			</summary>
			<div class="dropBody">
				{lawsTop.length ? (
					<div class="rows">
						{lawsTop.map((p) => (
							<a class="row" href={p.path}>
								<div class="rowTitle">{stripSuffix(p.title)}</div>
								{p.description ? <div class="rowDesc">{p.description}</div> : null}
							</a>
						))}
					</div>
				) : (
					<div class="empty">No laws and procedures documentation yet.</div>
				)}
				<a class="viewAll" href="/docs/laws-procedures/">View All</a>
			</div>
		</details>

		<details class="drop">
			<summary class="dropSummary">
				<div class="dropSummaryText">
					<div class="dropTitle">Area Guides</div>
					<div class="dropSub">Neighbourhood guides and local area information.</div>
				</div>
			</summary>
			<div class="dropBody">
				<div class="rows">
					{areaGuidesTop.map((it) => (
						<a class="row" href={it.href}>
							<div class="rowTitle">{it.title}</div>
						</a>
					))}
				</div>
			</div>
		</details>

		<details class="drop">
			<summary class="dropSummary">
				<div class="dropSummaryText">
					<div class="dropTitle">Paid Tools</div>
					<div class="dropSub">Featured listings, credits, and AI tools.</div>
				</div>
			</summary>
			<div class="dropBody">
				<div class="rows">
					{paidToolsTop.map((it) => (
						<a class="row" href={it.href}>
							<div class="rowTitle">{it.title}</div>
						</a>
					))}
				</div>
			</div>
		</details>

		<details class="drop">
			<summary class="dropSummary">
				<div class="dropSummaryText">
					<div class="dropTitle">Developer Docs</div>
					<div class="dropSub">Integrations, CRM, listings, imports/exports, and upgrades.</div>
				</div>
			</summary>
			<div class="dropBody">
				<div class="rows">
					{developerTop.map((it) => (
						<a class="row" href={it.href}>
							<div class="rowTitle">{it.title}</div>
						</a>
					))}
				</div>
				<a class="viewAll" href="/docs/developers/">View All</a>
			</div>
		</details>
	</div>

	<section class="latest">
		<div class="latestHeader">
			<h2>Latest Docs</h2>
			<p class="latestSub">Recently updated documentation pages.</p>
		</div>
		{latestDocs.length ? (
			<div class="rows">
				{latestDocs.map((p) => (
					<a class="row" href={p.path}>
						<div class="rowTitle">{p.title}</div>
					</a>
				))}
			</div>
		) : (
			<div class="empty">No docs yet.</div>
		)}
	</section>
</Layout>

<style>
	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.03em;
	}

	.sub {
		margin: 0 0 18px;
		color: rgba(16, 24, 40, 0.7);
	}

	.start {
		border: 1px solid rgba(16, 24, 40, 0.08);
		background: rgba(255, 255, 255, 0.7);
		border-radius: 18px;
		padding: 14px;
		margin-bottom: 16px;
	}

	.startTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 12px;
		border-radius: 999px;
		border: 1px solid rgba(16, 24, 40, 0.12);
		background: rgba(255, 255, 255, 0.92);
		text-decoration: none;
		font-weight: 800;
		color: rgba(16, 24, 40, 0.86);
	}

	.chip:hover {
		border-color: rgba(var(--accent-rgb), 0.35);
	}

	.dropList {
		display: grid;
		gap: 12px;
	}

	.drop {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		overflow: hidden;
	}

	.dropSummary {
		list-style: none;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 14px;
		padding: 14px;
		cursor: pointer;
	}

	.dropSummary::-webkit-details-marker {
		display: none;
	}

	.dropTitle {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.01em;
		font-weight: 900;
		color: rgba(11, 18, 32, 0.92);
	}

	.dropSub {
		margin: 6px 0 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.4;
		font-size: 14px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.dropSummary::after {
		content: '›';
		flex: none;
		font-weight: 900;
		color: rgba(16, 24, 40, 0.55);
		transform: rotate(90deg);
		transition: transform 180ms ease, color 180ms ease;
		margin-top: 2px;
	}

	.drop[open] > .dropSummary::after {
		transform: rotate(-90deg);
		color: var(--accent);
	}

	.dropBody {
		border-top: 1px solid rgba(16, 24, 40, 0.08);
		padding: 14px;
	}

	.latest {
		margin-top: 14px;
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.latestHeader h2 {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.latestSub {
		margin: 8px 0 12px;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.4;
		font-size: 14px;
	}

	.viewAll {
		margin-top: 12px;
		font-weight: 900;
		color: var(--accent);
		text-decoration: none;
	}

	.viewAll:hover {
		text-decoration: underline;
	}

	.rows {
		display: grid;
		gap: 10px;
	}

	.row {
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 14px;
		padding: 12px 14px;
		text-decoration: none;
		color: rgba(11, 18, 32, 0.86);
	}

	.row:hover {
		text-decoration: none;
		border-color: rgba(var(--accent-rgb), 0.35);
	}

	.rowTitle {
		font-weight: 800;
		letter-spacing: -0.01em;
		color: rgba(11, 18, 32, 0.92);
	}

	.rowDesc {
		margin-top: 6px;
		color: rgba(16, 24, 40, 0.7);
		font-size: 14px;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.empty {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	@media (prefers-reduced-motion: reduce) {
		.dropSummary::after {
			transition: none;
		}
	}
</style>
