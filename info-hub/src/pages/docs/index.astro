---
import Layout from '../../layouts/Layout.astro';
import { listKbPagesByPrefix, type KbPageListItem } from '../../lib/directus';

const mlsAll = await listKbPagesByPrefix({ prefix: '/docs/propertylist-mls-user-manual/', lang: 'en', limit: 250 });
const lawsAll = await listKbPagesByPrefix({ prefix: '/docs/laws-procedures/', lang: 'en', limit: 250 });
const portalAll = await listKbPagesByPrefix({ prefix: '/docs/public-portal/', lang: 'en', limit: 250 });
const latestAll = await listKbPagesByPrefix({ prefix: '/docs/', lang: 'en', limit: 12 });

const excludePrefixes = ['/docs/propertylist-mls-user-manual/', '/docs/laws-procedures/', '/docs/public-portal/'];
const isExcluded = (path: string) => excludePrefixes.some((p) => path.startsWith(p));
const latestOther = latestAll.filter((p) => !isExcluded(p.path));

const stripSuffix = (s: string) => s.replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '').trim();

const pickByPathIncludes = (items: KbPageListItem[], needles: string[]) =>
	items.find((p) => needles.some((n) => p.path.includes(n))) || null;

const pickTopTasks = (items: KbPageListItem[], picks: string[][], fallbackCount = 4) => {
	const chosen: KbPageListItem[] = [];
	for (const needles of picks) {
		const hit = pickByPathIncludes(items, needles);
		if (hit && !chosen.some((c) => c.path === hit.path)) chosen.push(hit);
	}
	for (const item of items) {
		if (chosen.length >= fallbackCount) break;
		if (!chosen.some((c) => c.path === item.path)) chosen.push(item);
	}
	return chosen.slice(0, fallbackCount);
};

const mlsTop = pickTopTasks(
	mlsAll,
	[
		['/import-properties', 'import-properties'],
		['/export-listings-xml', 'export-listings-xml'],
		['/portal-leads', 'portal-leads'],
		['/duplicate-properties', 'duplicate-properties'],
		['/upload-link-documents', 'upload-link-documents'],
	]
);

const lawsTop = pickTopTasks(
	lawsAll,
	[
		['/requirements-for-landlords', 'requirements-for-landlords'],
		['/taxes-for-landlords', 'taxes-for-landlords'],
		['/construction-standards', 'construction-standards'],
		['/inspections-and-compliance', 'inspections-and-compliance'],
	]
);

const portalTop = pickTopTasks(portalAll, [['/getting-started', 'getting-started']], 3);
---

<Layout
	lang="en"
	title="Documentation • PropertyList Info Hub"
	description="Find the right documentation fast — MLS, Public Portal, laws and legal."
	canonical="https://info.propertylist.es/docs/"
>
	<h1>Documentation</h1>
	<p class="sub">Choose a section to get to the right answer quickly.</p>

	<div class="start">
		<div class="startTitle">Start with your role</div>
		<div class="chips">
			<a class="chip" href="/docs/propertylist-mls-user-manual/?role=estate-agents">Estate agent</a>
			<a class="chip" href="/docs/propertylist-mls-user-manual/?role=developers">Developer</a>
			<a class="chip" href="/docs/public-portal/">Public / buyer</a>
			<a class="chip" href="/docs/laws-procedures/?role=owner">Owner</a>
		</div>
	</div>

	<div class="grid">
		<section class="card">
			<div class="cardHeader">
				<div>
					<h2>MLS &amp; CRM Docs</h2>
					<p class="cardSub">How to use the MLS and CRM. Split for estate agents and developers.</p>
				</div>
			</div>
			<div class="cardBody">
				{mlsTop.length ? (
					<div class="rows">
						{mlsTop.map((p) => (
							<a class="row" href={p.path}>
								<div class="rowTitle">{stripSuffix(p.title)}</div>
								{p.description ? <div class="rowDesc">{p.description}</div> : null}
							</a>
						))}
					</div>
				) : (
					<div class="empty">No MLS documentation yet.</div>
				)}
			</div>
			<a class="viewAll" href="/docs/propertylist-mls-user-manual/">View All</a>
		</section>

		<section class="card">
			<div class="cardHeader">
				<div>
					<h2>Public Portal Docs</h2>
					<p class="cardSub">How to use the public portal — search, save, and enquire.</p>
				</div>
			</div>
			<div class="cardBody">
				{portalTop.length ? (
					<div class="rows">
						{portalTop.map((p) => (
							<a class="row" href={p.path}>
								<div class="rowTitle">{stripSuffix(p.title)}</div>
								{p.description ? <div class="rowDesc">{p.description}</div> : null}
							</a>
						))}
					</div>
				) : (
					<div class="empty">Public portal documentation is coming soon.</div>
				)}
			</div>
			<a class="viewAll" href="/docs/public-portal/">View All</a>
		</section>

		<section class="card">
			<div class="cardHeader">
				<div>
					<h2>Laws &amp; Procedures Docs</h2>
					<p class="cardSub">Buying, renting, taxes, and Spanish property procedures.</p>
				</div>
			</div>
			<div class="cardBody">
				{lawsTop.length ? (
					<div class="rows">
						{lawsTop.map((p) => (
							<a class="row" href={p.path}>
								<div class="rowTitle">{stripSuffix(p.title)}</div>
								{p.description ? <div class="rowDesc">{p.description}</div> : null}
							</a>
						))}
					</div>
				) : (
					<div class="empty">No laws and procedures documentation yet.</div>
				)}
			</div>
			<a class="viewAll" href="/docs/laws-procedures/">View All</a>
		</section>
	</div>

	<section class="latest">
		<div class="latestHeader">
			<h2>Latest updates</h2>
		</div>
		{latestOther.length ? (
			<div class="rows">
				{latestOther.map((p) => (
					<a class="row" href={p.path}>
						<div class="rowTitle">{p.title}</div>
					</a>
				))}
			</div>
		) : (
			<div class="empty">No updates yet.</div>
		)}
	</section>
</Layout>

<style>
	h1 {
		margin: 0 0 8px;
		letter-spacing: -0.03em;
	}

	.sub {
		margin: 0 0 18px;
		color: rgba(16, 24, 40, 0.7);
	}

	.start {
		border: 1px solid rgba(16, 24, 40, 0.08);
		background: rgba(255, 255, 255, 0.7);
		border-radius: 18px;
		padding: 14px;
		margin-bottom: 16px;
	}

	.startTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 12px;
		border-radius: 999px;
		border: 1px solid rgba(16, 24, 40, 0.12);
		background: rgba(255, 255, 255, 0.92);
		text-decoration: none;
		font-weight: 800;
		color: rgba(16, 24, 40, 0.86);
	}

	.chip:hover {
		border-color: rgba(var(--accent-rgb), 0.35);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
	}

	.card {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
		display: flex;
		flex-direction: column;
	}

	.cardHeader {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 12px;
	}

	.cardHeader h2 {
		margin: 0;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.cardSub {
		margin: 6px 0 0;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.4;
		font-size: 14px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.cardBody {
		flex: 1;
	}

	.viewAll {
		margin-top: 12px;
		font-weight: 900;
		color: var(--accent);
		text-decoration: none;
	}

	.viewAll:hover {
		text-decoration: underline;
	}

	.rows {
		display: grid;
		gap: 10px;
	}

	.row {
		background: #fff;
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 14px;
		padding: 12px 14px;
		text-decoration: none;
		color: rgba(11, 18, 32, 0.86);
	}

	.row:hover {
		text-decoration: none;
		border-color: rgba(var(--accent-rgb), 0.35);
	}

	.rowTitle {
		font-weight: 800;
		letter-spacing: -0.01em;
		color: rgba(11, 18, 32, 0.92);
	}

	.rowDesc {
		margin-top: 6px;
		color: rgba(16, 24, 40, 0.7);
		font-size: 14px;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.empty {
		padding: 14px;
		background: rgba(255, 255, 255, 0.6);
		border: 1px dashed rgba(16, 24, 40, 0.18);
		border-radius: 16px;
		color: rgba(16, 24, 40, 0.7);
	}

	.latest {
		margin-top: 16px;
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(16, 24, 40, 0.08);
		border-radius: 18px;
		padding: 14px;
	}

	.latestHeader h2 {
		margin: 0 0 12px;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
