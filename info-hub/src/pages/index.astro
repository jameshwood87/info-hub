---
import Layout from '../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../lib/directus';
import background from '../assets/background.svg';

const latestDocs = await listKbPagesByPrefix({ prefix: '/docs/', lang: 'en', limit: 8 });
const latestGeneral = await listKbPagesByPrefix({ prefix: '/general-information/', lang: 'en', limit: 8 });

const viewParam = Astro.url.searchParams.get('view') || '';
const personaParam = Astro.url.searchParams.get('persona') || '';

const view = viewParam === 'how-it-works' ? 'how-it-works' : 'what-is';
const persona =
	personaParam === 'agency' || personaParam === 'developer' || personaParam === 'service' ? personaParam : 'freelancer';

const hrefFor = (nextView: string, nextPersona: string) => {
	const params = new URLSearchParams();
	params.set('view', nextView);
	params.set('persona', nextPersona);
	return `/?${params.toString()}`;
};
---

<Layout
	lang="en"
	title="PropertyList Info Hub"
	description="How to use PropertyList.es, features, pricing and more."
	canonical="https://info.propertylist.es/"
>
	<section class="hero">
		<div class="heroBg" aria-hidden="true">
			<img src={background.src} alt="" width="1600" height="900" fetchpriority="high" />
		</div>
		<div class="heroInner">
			<div class="heroCopy">
				<div class="viewTabs" role="tablist" aria-label="Front page">
					<a
						class={`viewTab ${view === 'what-is' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={view === 'what-is' ? 'true' : 'false'}
						href={hrefFor('what-is', persona)}
						data-view="what-is"
					>
						What is PropertyList?
					</a>
					<a
						class={`viewTab ${view === 'how-it-works' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={view === 'how-it-works' ? 'true' : 'false'}
						href={hrefFor('how-it-works', persona)}
						data-view="how-it-works"
					>
						How PropertyList Works?
					</a>
				</div>

				<div class={`viewPanel ${view === 'what-is' ? 'isActive' : ''}`} data-view-panel="what-is" role="tabpanel">
					<h1>What is PropertyList?</h1>
					<p class="lead">
						PropertyList is a collaboration platform that helps real estate professionals share listings, reach a
						wider network, and turn enquiries into deals.
					</p>
					<div class="pillRow" role="tablist" aria-label="Audience">
						<a
							class={`pill ${persona === 'freelancer' ? 'isActive' : ''}`}
							role="tab"
							aria-selected={persona === 'freelancer' ? 'true' : 'false'}
							href={hrefFor('what-is', 'freelancer')}
							data-persona="freelancer"
						>
							Freelancer
						</a>
						<a
							class={`pill ${persona === 'agency' ? 'isActive' : ''}`}
							role="tab"
							aria-selected={persona === 'agency' ? 'true' : 'false'}
							href={hrefFor('what-is', 'agency')}
							data-persona="agency"
						>
							Agency
						</a>
						<a
							class={`pill ${persona === 'developer' ? 'isActive' : ''}`}
							role="tab"
							aria-selected={persona === 'developer' ? 'true' : 'false'}
							href={hrefFor('what-is', 'developer')}
							data-persona="developer"
						>
							Developer
						</a>
						<a
							class={`pill ${persona === 'service' ? 'isActive' : ''}`}
							role="tab"
							aria-selected={persona === 'service' ? 'true' : 'false'}
							href={hrefFor('what-is', 'service')}
							data-persona="service"
						>
							Property Service
						</a>
					</div>
					<div class="ctaRow">
						<a class="btnPrimary" href="/what-we-offer/">What we offer</a>
						<a class="btnSecondary" href="/docs/getting-started/">How to use PropertyList</a>
					</div>

					<div class="metaRow">
						<div class="metaItem">
							<div class="metaKpi">316+</div>
							<div class="metaLabel">Imported articles</div>
						</div>
						<div class="metaItem">
							<div class="metaKpi">EN/ES</div>
							<div class="metaLabel">Bilingual support</div>
						</div>
						<div class="metaItem">
							<div class="metaKpi">MLS</div>
							<div class="metaLabel">User manual</div>
						</div>
					</div>

					<div class="personaBox" aria-label="By audience">
						<div class={`personaPanel ${persona === 'freelancer' ? 'isActive' : ''}`} data-persona-panel="freelancer">
							<div class="personaTitle">For freelancers</div>
							<div class="personaSummary">Get exposure, collaborate with agencies, and stay organised.</div>
							<div class="personaLinks">
								<a href="/docs/getting-started/">Getting started</a>
								<a href="/mls/">MLS overview</a>
								<a href="/search">Search guides</a>
							</div>
						</div>
						<div class={`personaPanel ${persona === 'agency' ? 'isActive' : ''}`} data-persona-panel="agency">
							<div class="personaTitle">For agencies</div>
							<div class="personaSummary">Centralise listings, share instantly, and track performance.</div>
							<div class="personaLinks">
								<a href="/mls/">MLS user manual</a>
								<a href="/laws/">Laws &amp; procedures</a>
								<a href="/general-information/">Latest updates</a>
							</div>
						</div>
						<div class={`personaPanel ${persona === 'developer' ? 'isActive' : ''}`} data-persona-panel="developer">
							<div class="personaTitle">For developers</div>
							<div class="personaSummary">Distribute new developments to a network of agents.</div>
							<div class="personaLinks">
								<a href="/docs/">Documentation</a>
								<a href="/search">Search</a>
								<a href="/general-information/">Platform news</a>
							</div>
						</div>
						<div class={`personaPanel ${persona === 'service' ? 'isActive' : ''}`} data-persona-panel="service">
							<div class="personaTitle">For property services</div>
							<div class="personaSummary">Connect with agents and get discovered by active buyers and owners.</div>
							<div class="personaLinks">
								<a href="/general-information/">General information</a>
								<a href="/docs/">Documentation</a>
								<a href="/search">Search</a>
							</div>
						</div>
					</div>
				</div>

				<div
					class={`viewPanel ${view === 'how-it-works' ? 'isActive' : ''}`}
					data-view-panel="how-it-works"
					role="tabpanel"
				>
					<h1>How PropertyList Works</h1>
					<p class="lead">
						Get set up, publish listings, share to the network, and respond to enquiries fast. Use the
						documentation to learn features, workflows, and best practices.
					</p>
					<div class="pillRow" role="tablist" aria-label="Audience">
						<a
							class={`pill ${persona === 'freelancer' ? 'isActive' : ''}`}
							role="tab"
							aria-selected={persona === 'freelancer' ? 'true' : 'false'}
							href={hrefFor('how-it-works', 'freelancer')}
							data-persona="freelancer"
						>
							Freelancer
						</a>
						<a
							class={`pill ${persona === 'agency' ? 'isActive' : ''}`}
							role="tab"
							aria-selected={persona === 'agency' ? 'true' : 'false'}
							href={hrefFor('how-it-works', 'agency')}
							data-persona="agency"
						>
							Agency
						</a>
						<a
							class={`pill ${persona === 'developer' ? 'isActive' : ''}`}
							role="tab"
							aria-selected={persona === 'developer' ? 'true' : 'false'}
							href={hrefFor('how-it-works', 'developer')}
							data-persona="developer"
						>
							Developer
						</a>
						<a
							class={`pill ${persona === 'service' ? 'isActive' : ''}`}
							role="tab"
							aria-selected={persona === 'service' ? 'true' : 'false'}
							href={hrefFor('how-it-works', 'service')}
							data-persona="service"
						>
							Property Service
						</a>
					</div>
					<div class="ctaRow">
						<a class="btnPrimary" href="/docs/">Browse documentation</a>
						<a class="btnSecondary" href="/search">Search questions</a>
					</div>

					<div class="personaBox" aria-label="How it works by audience">
						<div class={`personaPanel ${persona === 'freelancer' ? 'isActive' : ''}`} data-persona-panel="freelancer">
							<div class="personaTitle">Freelancer flow</div>
							<div class="personaSummary">List → share → manage leads → close.</div>
							<div class="personaLinks">
								<a href="/docs/getting-started/">Setup</a>
								<a href="/mls/">Workflows</a>
								<a href="/search">Find answers</a>
							</div>
						</div>
						<div class={`personaPanel ${persona === 'agency' ? 'isActive' : ''}`} data-persona-panel="agency">
							<div class="personaTitle">Agency flow</div>
							<div class="personaSummary">Organise listings → distribute → track results.</div>
							<div class="personaLinks">
								<a href="/mls/">MLS manual</a>
								<a href="/docs/">Browse docs</a>
								<a href="/general-information/">Updates</a>
							</div>
						</div>
						<div class={`personaPanel ${persona === 'developer' ? 'isActive' : ''}`} data-persona-panel="developer">
							<div class="personaTitle">Developer flow</div>
							<div class="personaSummary">Publish development → reach agents → collect enquiries.</div>
							<div class="personaLinks">
								<a href="/docs/">Docs</a>
								<a href="/search">Search</a>
								<a href="/general-information/">Announcements</a>
							</div>
						</div>
						<div class={`personaPanel ${persona === 'service' ? 'isActive' : ''}`} data-persona-panel="service">
							<div class="personaTitle">Service provider flow</div>
							<div class="personaSummary">Create visibility → connect → win referrals.</div>
							<div class="personaLinks">
								<a href="/general-information/">General info</a>
								<a href="/docs/">Docs</a>
								<a href="/search">Search</a>
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<div class={`below ${view === 'what-is' ? 'isActive' : ''}`} data-below-panel="what-is">
		<section class="section">
			<div class="sectionHeader">
				<h2>What we offer</h2>
				<a class="link" href="/what-we-offer/">Learn more</a>
			</div>
			<p class="sectionLead">Meet PropertyList, the 1st free MLS for estate agents. Unlimited listings for free.</p>
			<div class="grid">
				<div class="tile">
					<h3>MLS (share unlimited properties)</h3>
					<p>Share listings across the network and keep inventory aligned.</p>
				</div>
				<div class="tile">
					<h3>CRM</h3>
					<p>Organise relationships and keep every deal moving.</p>
				</div>
				<div class="tile">
					<h3>Messaging &amp; request viewings</h3>
					<p>Respond to enquiries and coordinate viewings faster.</p>
				</div>
				<div class="tile">
					<h3>Unlimited users</h3>
					<p>Add your whole team without worrying about seats.</p>
				</div>
				<div class="tile">
					<h3>Unlimited contacts</h3>
					<p>Keep every buyer, owner, and lead in one place.</p>
				</div>
				<div class="tile">
					<h3>MicroSite (branded mini-website)</h3>
					<p>Present your listings with a lightweight branded web presence.</p>
				</div>
				<div class="tile">
					<h3>Verified agencies</h3>
					<p>Build trust with clear verification and professional profiles.</p>
				</div>
				<div class="tile">
					<h3>History timeline</h3>
					<p>Track activity and keep an audit trail of important actions.</p>
				</div>
			</div>
		</section>
	</div>

	<div class={`below ${view === 'how-it-works' ? 'isActive' : ''}`} data-below-panel="how-it-works">
		<section class="section">
			<div class="sectionHeader">
				<h2>Documentation &amp; Search</h2>
				<a class="link" href="/docs/">Browse all</a>
			</div>
			<form class="searchBar" method="get" action="/search">
				<input name="q" placeholder="Search questions, features, and workflows" />
				<button type="submit">Search</button>
			</form>
		</section>

		<section class="section">
			<div class="sectionHeader">
				<h2>Browse Documentation</h2>
				<a class="link" href="/docs/">View all</a>
			</div>
			<div class="grid">
				<a class="tile" href="/neighbourhood/">
					<div class="tileIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path
								d="M4.5 10.5 12 4.5l7.5 6v9.75c0 .69-.56 1.25-1.25 1.25H5.75c-.69 0-1.25-.56-1.25-1.25V10.5Z"
								stroke="currentColor"
								stroke-width="1.6"
							/>
							<path
								d="M9 22v-6.75c0-.69.56-1.25 1.25-1.25h3.5c.69 0 1.25.56 1.25 1.25V22"
								stroke="currentColor"
								stroke-width="1.6"
							/>
						</svg>
					</div>
					<h3>Neighbourhood Guides</h3>
					<p>Area overviews and local knowledge.</p>
				</a>
				<a class="tile" href="/mls/">
					<div class="tileIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path
								d="M7 4.5h7l3 3v12.75c0 .69-.56 1.25-1.25 1.25H7.25C6.56 21.75 6 21.19 6 20.5V5.75C6 5.06 6.56 4.5 7.25 4.5Z"
								stroke="currentColor"
								stroke-width="1.6"
							/>
							<path d="M14 4.5V8h3" stroke="currentColor" stroke-width="1.6" />
							<path d="M8.5 12h7" stroke="currentColor" stroke-width="1.6" />
							<path d="M8.5 15.5h6" stroke="currentColor" stroke-width="1.6" />
						</svg>
					</div>
					<h3>MLS User Manual</h3>
					<p>Workflows, listings, exports, and reports.</p>
				</a>
				<a class="tile" href="/laws/">
					<div class="tileIcon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path
								d="M12 3.75c3.2 2.47 5.5 2.47 8 2.75v8.5c0 3.9-3.1 6.6-8 8.25-4.9-1.65-8-4.35-8-8.25V6.5c2.5-.28 4.8-.28 8-2.75Z"
								stroke="currentColor"
								stroke-width="1.6"
							/>
							<path d="M9 12h6" stroke="currentColor" stroke-width="1.6" />
							<path d="M12 9v6" stroke="currentColor" stroke-width="1.6" />
						</svg>
					</div>
					<h3>Laws &amp; Procedures</h3>
					<p>Rentals, taxes, inheritance, and more.</p>
				</a>
			</div>
		</section>

		<section class="section">
			<div class="sectionHeader">
				<h2>Latest Documentation</h2>
				<a class="link" href="/docs/">View all</a>
			</div>
			<div class="list">
				{latestDocs.length ? (
					latestDocs.map((p) => (
						<a class="row" href={p.path}>
							<div class="rowTitle">{p.title}</div>
							{p.description ? <div class="rowDesc">{p.description}</div> : null}
						</a>
					))
				) : (
					<div class="empty">No documentation pages yet.</div>
				)}
			</div>
		</section>

		<section class="section">
			<div class="sectionHeader">
				<h2>General Information</h2>
				<a class="link" href="/general-information/">View all</a>
			</div>
			<div class="cards">
				{latestGeneral.length ? (
					latestGeneral.map((p) => (
						<a class="cardLink" href={p.path}>
							<h3>{p.title}</h3>
							{p.description ? <p>{p.description}</p> : null}
						</a>
					))
				) : (
					<div class="empty">No articles yet.</div>
				)}
			</div>
		</section>

		<section class="section">
			<div class="sectionHeader">
				<h2>Be a part of the community</h2>
				<a class="link" href="/community/">Ask a question</a>
			</div>
			<div class="grid">
				<div class="tile mutedTile">
					<h3>Latest Forum Topics</h3>
					<p>Coming soon.</p>
				</div>
				<div class="tile mutedTile">
					<h3>Video Tutorials</h3>
					<p>Coming soon.</p>
				</div>
			</div>
		</section>
	</div>

	<script>
		const viewTabs = Array.from(document.querySelectorAll('[data-view]'));
		const viewPanels = Array.from(document.querySelectorAll('[data-view-panel]'));
		const belowPanels = Array.from(document.querySelectorAll('[data-below-panel]'));
		const personaTabs = Array.from(document.querySelectorAll('[data-persona]'));

		function setUrl(nextView, nextPersona) {
			const url = new URL(window.location.href);
			url.searchParams.set('view', nextView);
			url.searchParams.set('persona', nextPersona);
			window.history.replaceState({}, '', url);
		}

		function setView(nextView) {
			for (const t of viewTabs) t.classList.toggle('isActive', t.dataset.view === nextView);
			for (const p of viewPanels) p.classList.toggle('isActive', p.dataset.viewPanel === nextView);
			for (const p of belowPanels) p.classList.toggle('isActive', p.dataset.belowPanel === nextView);
		}

		function setPersona(nextPersona) {
			for (const t of personaTabs) t.classList.toggle('isActive', t.dataset.persona === nextPersona);
			const activePanel = document.querySelector('[data-view-panel].isActive');
			const panels = activePanel ? Array.from(activePanel.querySelectorAll('[data-persona-panel]')) : [];
			for (const p of panels) p.classList.toggle('isActive', p.dataset.personaPanel === nextPersona);
		}

		function current() {
			const url = new URL(window.location.href);
			const view = url.searchParams.get('view') === 'how-it-works' ? 'how-it-works' : 'what-is';
			const persona = ['freelancer', 'agency', 'developer', 'service'].includes(url.searchParams.get('persona'))
				? url.searchParams.get('persona')
				: 'freelancer';
			return { view, persona };
		}

		const start = current();
		setView(start.view);
		setPersona(start.persona);
		setUrl(start.view, start.persona);

		for (const t of viewTabs) {
			t.addEventListener('click', (e) => {
				e.preventDefault();
				const nextView = t.dataset.view;
				const { persona } = current();
				setView(nextView);
				setPersona(persona);
				setUrl(nextView, persona);
			});
		}

		for (const t of personaTabs) {
			t.addEventListener('click', (e) => {
				e.preventDefault();
				const nextPersona = t.dataset.persona;
				const { view } = current();
				setPersona(nextPersona);
				setUrl(view, nextPersona);
			});
		}
	</script>
</Layout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(246, 248, 252, 0.85));
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 18px;
		padding: 22px;
	}

	.heroBg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.9;
	}

	.heroBg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.1);
		filter: blur(60px) saturate(1.15);
	}

	.heroBg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(900px 420px at 5% 20%, rgba(var(--accent-rgb), 0.35), transparent 55%),
			radial-gradient(900px 420px at 100% 10%, rgba(34, 197, 94, 0.18), transparent 55%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(246, 248, 252, 0.92));
	}

	.heroInner {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
		align-items: start;
	}

	.heroCopy {
		padding: 8px;
	}

	.viewTabs {
		display: flex;
		gap: 8px;
		padding: 6px;
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 999px;
		width: fit-content;
		margin: 0 auto;
	}

	.viewTab {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 9px 12px;
		border-radius: 999px;
		font-weight: 900;
		color: rgba(11, 18, 32, 0.7);
		text-decoration: none;
		white-space: nowrap;
	}

	.viewTab:hover {
		text-decoration: none;
		background: rgba(11, 18, 32, 0.04);
	}

	.viewTab.isActive {
		background: rgba(var(--accent-rgb), 0.14);
		color: rgba(11, 18, 32, 0.92);
	}

	.pillRow {
		display: inline-flex;
		gap: 8px;
		padding: 6px;
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 999px;
		margin-top: 12px;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 8px 10px;
		border-radius: 999px;
		cursor: pointer;
		font-weight: 800;
		color: rgba(11, 18, 32, 0.7);
		text-decoration: none;
		white-space: nowrap;
	}

	.pill.isActive {
		background: rgba(var(--accent-rgb), 0.12);
		color: rgba(11, 18, 32, 0.95);
	}

	.pill:hover {
		text-decoration: none;
		background: rgba(11, 18, 32, 0.04);
	}

	.viewPanel {
		display: none;
		margin-top: 14px;
	}

	.viewPanel.isActive {
		display: block;
	}

	h1 {
		font-size: 42px;
		line-height: 1.05;
		margin: 14px 0 12px;
		letter-spacing: -0.03em;
	}

	.lead {
		font-size: 18px;
		line-height: 1.55;
		color: rgba(11, 18, 32, 0.72);
		margin: 0 0 18px;
	}

	.ctaRow {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.btnPrimary,
	.btnSecondary {
		display: inline-flex;
