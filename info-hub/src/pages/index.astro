---
import Layout from '../layouts/Layout.astro';
import { listKbPagesByPrefix } from '../lib/directus';
import background from '../assets/background.svg';

const latestDocs = await listKbPagesByPrefix({ prefix: '/docs/', lang: 'en', limit: 5 });
const latestGeneral = await listKbPagesByPrefix({ prefix: '/general-information/', lang: 'en', limit: 8 });

const personaParam = Astro.url.searchParams.get('persona') || '';

const persona = (() => {
	if (personaParam === 'developers' || personaParam === 'developer') return 'developers';
	if (personaParam === 'services' || personaParam === 'service') return 'services';
	if (personaParam === 'agents' || personaParam === 'freelancer' || personaParam === 'agency') return 'agents';
	return 'agents';
})();

const hrefForPersona = (nextPersona: string) => {
	const params = new URLSearchParams();
	params.set('persona', nextPersona);
	return `/?${params.toString()}`;
};
---

<Layout
	lang="en"
	title="PropertyList Info Hub"
	description="How to use PropertyList.es, features, pricing and more."
	canonical="https://info.propertylist.es/"
>
	<section class="hero">
		<div class="heroBg" aria-hidden="true">
			<img src={background.src} alt="" width="1600" height="900" fetchpriority="high" />
		</div>
		<div class="heroInner">
			<a class="btnSecondary topCta" href="/docs/">How to use PropertyList</a>
			<div class="heroCopy">
				<h1>What is PropertyList?</h1>
				<p class="lead">PropertyList is Europe’s first results-driven Smart MLS, CRM &amp; Property Portal.</p>
				<p class="lead">
					The MLS and CRM are 100% free forever for estate agents. No subscriptions. No lock-ins. Optional paid features
					are available for those who want more visibility, automation, and performance.
				</p>

				<div class="metaRow">
					<div class="metaItem">
						<div class="metaKpi">5,700+</div>
						<div class="metaLabel">Active Listings</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">1,350+</div>
						<div class="metaLabel">Active Agents</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Multi-Language</div>
						<div class="metaLabel">Support</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">AI Tools</div>
						<div class="metaLabel">Upgrades</div>
					</div>
					<div class="metaItem">
						<div class="metaKpi">Automation</div>
						<div class="metaLabel">Workflows</div>
					</div>
				</div>

				<div class="pillRow" role="tablist" aria-label="Audience">
					<a
						class={`pill ${persona === 'agents' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'agents' ? 'true' : 'false'}
						data-persona="agents"
						href={hrefForPersona('agents')}
					>
						Estate Agents
					</a>
					<a
						class={`pill ${persona === 'developers' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'developers' ? 'true' : 'false'}
						data-persona="developers"
						href={hrefForPersona('developers')}
					>
						Developers
					</a>
					<a
						class={`pill ${persona === 'services' ? 'isActive' : ''}`}
						role="tab"
						aria-selected={persona === 'services' ? 'true' : 'false'}
						data-persona="services"
						href={hrefForPersona('services')}
					>
						Property Services
					</a>
				</div>

				<div class="personaBox" aria-label="By audience">
					<div class={`personaPanel ${persona === 'agents' ? 'isActive' : ''}`} data-persona-panel="agents">
						<div class="personaTitle">For estate agents</div>
						<div class="personaSummary">
							PropertyList is good for agents because it moves them from being Passive Listers (paying for storage) to Active
							Deal Makers (using tools &amp; AI to convert leads).
							<br />
							<br />
							It differs from other portals because it treats the MLS as a public utility—free to access and use—monetizing
							only the value-added services that actually generate revenue for the agent.
						</div>
						<div class="personaLinks">
							<a href="/docs/getting-started/">Getting started</a>
							<a href="/mls/">MLS user manual</a>
							<a href="/search">Search guides</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'developers' ? 'isActive' : ''}`} data-persona-panel="developers">
						<div class="personaTitle">For developers</div>
						<div class="personaSummary">
							PropertyList is good for Developers because it moves them from being Speculative Advertisers (burning budget on
							upfront exposure) to Strategic Distributors (instantly equipping 1,266 agents to sell their stock).
							<br />
							<br />
							It differs from other portals because it treats the development portfolio as shared inventory—free to list and
							update in real-time—monetizing only through the performance-based commissions paid when a unit is actually sold.
						</div>
						<div class="personaLinks">
							<a href="/docs/">Documentation</a>
							<a href="/search">Search</a>
							<a href="/general-information/">Platform news</a>
						</div>
					</div>
					<div class={`personaPanel ${persona === 'services' ? 'isActive' : ''}`} data-persona-panel="services">
						<div class="personaTitle">For property services</div>
						<div class="personaSummary">
							PropertyList is good for Property Services because it shifts you from being a Cold Advertiser (interrupting
							people with ads) to a Strategic Solution (appearing exactly when a transaction requires your help).
							<br />
							<br />
							It differs from standard directories because it uses Contextual AI to present your services only when a specific
							deal is happening—reducing spam for everyone and ensuring that every lead you pay for is attached to a deal.
						</div>
						<div class="personaLinks">
							<a href="/general-information/">General information</a>
							<a href="/docs/">Documentation</a>
							<a href="/search">Search</a>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2 class="offerTitle">What we offer</h2>
		</div>
		<p class="sectionLead">
			Keep the engine running for free — forever. PropertyList gives you a fully functional MLS + CRM at no cost, so you
			can list properties, manage leads, coordinate with your team, and close deals without another monthly bill.
		</p>
		<p class="sectionLead">
			When you want to move faster or stand out, tap our optional credit-activated power tools. Use them only when they
			actually help you: automated workflows that save hours, marketing boosts that win instructions, and analytics that
			help you price and pitch with confidence.
		</p>
		<div class="grid featureGrid">
			<div class="tile pricingTile">
				<div class="pricingMeta">
					<div class="pricingBadge isFree">Free</div>
				</div>
				<h3 class="pricingTitle">What you get for free</h3>
				<ul class="featureList">
					<li>MLS (share unlimited properties)</li>
					<li>CRM</li>
					<li>Messaging &amp; Request Viewings</li>
					<li>Unlimited Users</li>
					<li>Unlimited Contacts</li>
					<li>MicroSite (branded mini-website)</li>
					<li>Verified Agencies</li>
					<li>History Timeline (Contacts &amp; Properties)</li>
					<li>WhatsApp Community Group Access (3,000+ members)</li>
					<li>Advertise on our Facebook Pages &amp; Groups (40,000+ members)</li>
				</ul>
			</div>
			<div class="tile mutedTile pricingTile">
				<div class="pricingMeta">
					<div class="pricingBadge isSoon">Coming soon</div>
				</div>
				<h3 class="pricingTitle">Optional paid upgrades</h3>
				<ul class="featureList">
					<li>Featured MLS Listings</li>
					<li>Private Listings</li>
					<li>CMA Report</li>
					<li>AI Tools</li>
					<li>Featured Public Portal Listings</li>
					<li>Open Direct Leads (Public Portal)</li>
					<li>Featured Estate Agents</li>
					<li>Direct Client Property Email</li>
					<li>Social Media Boost Posts</li>
					<li>AI Utilities</li>
					<li>Much more coming soon</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Documentation &amp; Search</h2>
			<a class="link" href="/docs/">Browse all</a>
		</div>
		<form class="searchBar" method="get" action="/search">
			<input name="q" placeholder="Search questions, features, and workflows" />
			<button type="submit">Search</button>
		</form>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Browse Documentation</h2>
			<a class="link" href="/docs/">View all</a>
		</div>
		<div class="grid">
			<a class="tile" href="/neighbourhood/">
				<div class="tileIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M4.5 10.5 12 4.5l7.5 6v9.75c0 .69-.56 1.25-1.25 1.25H5.75c-.69 0-1.25-.56-1.25-1.25V10.5Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path
							d="M9 22v-6.75c0-.69.56-1.25 1.25-1.25h3.5c.69 0 1.25.56 1.25 1.25V22"
							stroke="currentColor"
							stroke-width="1.6"
						/>
					</svg>
				</div>
				<h3>Neighbourhood Guides</h3>
				<p>Area overviews and local knowledge.</p>
			</a>
			<a class="tile" href="/mls/">
				<div class="tileIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M7 4.5h7l3 3v12.75c0 .69-.56 1.25-1.25 1.25H7.25C6.56 21.75 6 21.19 6 20.5V5.75C6 5.06 6.56 4.5 7.25 4.5Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path d="M14 4.5V8h3" stroke="currentColor" stroke-width="1.6" />
						<path d="M8.5 12h7" stroke="currentColor" stroke-width="1.6" />
						<path d="M8.5 15.5h6" stroke="currentColor" stroke-width="1.6" />
					</svg>
				</div>
				<h3>MLS User Manual</h3>
				<p>Workflows, listings, exports, and reports.</p>
			</a>
			<a class="tile" href="/laws/">
				<div class="tileIcon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M12 3.75c3.2 2.47 5.5 2.47 8 2.75v8.5c0 3.9-3.1 6.6-8 8.25-4.9-1.65-8-4.35-8-8.25V6.5c2.5-.28 4.8-.28 8-2.75Z"
							stroke="currentColor"
							stroke-width="1.6"
						/>
						<path d="M9 12h6" stroke="currentColor" stroke-width="1.6" />
						<path d="M12 9v6" stroke="currentColor" stroke-width="1.6" />
					</svg>
				</div>
				<h3>Laws &amp; Procedures</h3>
				<p>Rentals, taxes, inheritance, and more.</p>
			</a>
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Latest Documentation</h2>
			<a class="link" href="/docs/">View all</a>
		</div>
		<div class="list">
			{latestDocs.length ? (
				latestDocs.map((p) => (
					<a class="row" href={p.path}>
						<div class="rowTitle">{p.title}</div>
						{p.description ? <div class="rowDesc">{p.description}</div> : null}
					</a>
				))
			) : (
				<div class="empty">No documentation pages yet.</div>
			)}
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>General Information</h2>
			<a class="link" href="/general-information/">View all</a>
		</div>
		<div class="cards">
			{latestGeneral.length ? (
				latestGeneral.map((p) => (
					<a class="cardLink" href={p.path}>
						<h3>{p.title}</h3>
						{p.description ? <p>{p.description}</p> : null}
					</a>
				))
			) : (
				<div class="empty">No articles yet.</div>
			)}
		</div>
	</section>

	<section class="section">
		<div class="sectionHeader">
			<h2>Be a part of the community</h2>
			<a class="link" href="/community/">Ask a question</a>
		</div>
		<div class="grid">
			<div class="tile mutedTile">
				<h3>Latest Forum Topics</h3>
				<p>Coming soon.</p>
			</div>
			<div class="tile mutedTile">
				<h3>Video Tutorials</h3>
				<p>Coming soon.</p>
			</div>
		</div>
	</section>
	<script is:inline>
		const pillRow = document.querySelector('.pillRow');
		const personaBox = document.querySelector('.personaBox');

		if (pillRow && personaBox) {
			const pills = Array.from(pillRow.querySelectorAll('[data-persona]'));
			const panels = Array.from(personaBox.querySelectorAll('[data-persona-panel]'));

			const normalizePersona = (value) => {
				if (value === 'developers' || value === 'developer') return 'developers';
				if (value === 'services' || value === 'service') return 'services';
				if (value === 'agents' || value === 'freelancer' || value === 'agency') return 'agents';
				return '';
			};

			const setPersona = (value, mode) => {
				const persona = normalizePersona(value) || 'agents';

				for (const pill of pills) {
					const isActive = pill.getAttribute('data-persona') === persona;
					pill.classList.toggle('isActive', isActive);
					pill.setAttribute('aria-selected', isActive ? 'true' : 'false');
				}

				for (const panel of panels) {
					const isActive = panel.getAttribute('data-persona-panel') === persona;
					panel.classList.toggle('isActive', isActive);
				}

				const url = new URL(window.location.href);
				url.searchParams.set('persona', persona);
				if (mode === 'push') window.history.pushState(null, '', url.toString());
				else window.history.replaceState(null, '', url.toString());
			};

			const initialFromUrl = normalizePersona(new URL(window.location.href).searchParams.get('persona') || '');
			const activePill = pillRow.querySelector('.pill.isActive') || pillRow.querySelector('[data-persona]');
			const initialFromDom = normalizePersona(activePill ? activePill.getAttribute('data-persona') || '' : '');
			setPersona(initialFromUrl || initialFromDom, 'replace');

			for (const pill of pills) {
				pill.addEventListener('click', (e) => {
					e.preventDefault();
					setPersona(pill.getAttribute('data-persona') || '', 'push');
				});
			}

			window.addEventListener('popstate', () => {
				setPersona(new URL(window.location.href).searchParams.get('persona') || '', 'replace');
			});
		}
	</script>
</Layout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(246, 248, 252, 0.85));
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 18px;
		padding: 22px;
	}

	.heroBg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.9;
	}

	.heroBg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.1);
		filter: blur(60px) saturate(1.15);
	}

	.heroBg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(900px 420px at 5% 20%, rgba(var(--accent-rgb), 0.35), transparent 55%),
			radial-gradient(900px 420px at 100% 10%, rgba(34, 197, 94, 0.18), transparent 55%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(246, 248, 252, 0.92));
	}

	.heroInner {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
		align-items: start;
	}

	.topCta {
		position: absolute;
		top: 0;
		right: 0;
	}

	.heroCopy {
		padding: 8px;
	}

	.pillRow {
		display: flex;
		gap: 8px;
		padding: 6px;
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 999px;
		width: fit-content;
		margin: 14px auto 0;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 8px 10px;
		border-radius: 999px;
		cursor: pointer;
		font-weight: 800;
		color: rgba(11, 18, 32, 0.7);
		text-decoration: none;
		white-space: nowrap;
	}

	.pill.isActive {
		background: rgba(var(--accent-rgb), 0.12);
		color: rgba(11, 18, 32, 0.95);
	}

	.pill:hover {
		text-decoration: none;
		background: rgba(11, 18, 32, 0.04);
	}

	h1 {
		font-size: 42px;
		line-height: 1.05;
		margin: 14px 0 12px;
		letter-spacing: -0.03em;
	}

	.lead {
		font-size: 18px;
		line-height: 1.55;
		color: rgba(11, 18, 32, 0.72);
		margin: 0 0 18px;
	}

	.lead + .lead {
		margin-top: -10px;
	}

	.ctaRow {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.btnPrimary,
	.btnSecondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 11px 14px;
		border-radius: 12px;
		text-decoration: none;
		font-weight: 700;
	}

	.btnPrimary {
		background: var(--accent);
		color: #fff;
	}

	.btnPrimary:hover {
		text-decoration: none;
		filter: brightness(0.95);
	}

	.btnSecondary {
		background: rgba(16, 24, 40, 0.06);
		border: 1px solid rgba(16, 24, 40, 0.1);
	}

	.btnSecondary:hover {
		text-decoration: none;
		background: rgba(16, 24, 40, 0.08);
	}

	.metaRow {
		margin-top: 18px;
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		justify-content: center;
	}

	.metaItem {
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 14px;
		padding: 12px 14px;
		min-width: 160px;
	}

	.metaKpi {
		font-weight: 900;
		letter-spacing: -0.01em;
	}

	.metaLabel {
		margin-top: 2px;
		font-size: 13px;
		color: rgba(11, 18, 32, 0.65);
	}

	.personaBox {
		margin-top: 14px;
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 16px;
		padding: 12px;
	}

	.personaPanel {
		display: none;
	}

	.personaPanel.isActive {
		display: block;
	}

	.personaTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
		margin-bottom: 10px;
	}

	.personaSummary {
		margin: -6px 0 12px;
		color: rgba(11, 18, 32, 0.7);
		line-height: 1.5;
	}

	.personaLinks {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
	}

	.personaLinks a {
		background: rgba(var(--accent-rgb), 0.08);
		border: 1px solid rgba(var(--accent-rgb), 0.18);
		border-radius: 14px;
		padding: 10px 12px;
		font-weight: 800;
		text-decoration: none;
	}

	.personaLinks a:hover {
		text-decoration: none;
		background: rgba(var(--accent-rgb), 0.12);
	}


	.card {
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(16, 24, 40, 0.08);
		padding: 14px;
	}

	.card h3 {
		margin: 0 0 8px;
		font-size: 16px;
	}

	.card p {
		margin: 0;
		color: rgba(16, 24, 40, 0.72);
	}

	.card ul {
		margin: 0;
		padding-left: 18px;
		color: rgba(16, 24, 40, 0.72);
	}

	.card li {
		margin: 6px 0;
	}

	.persona {
		display: none;
	}

	.persona.isActive {
		display: block;
	}

	.section {
		margin-top: 22px;
	}

	.sectionHeader {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 10px;
	}

	.sectionHeader h2 {
		margin: 0;
		font-size: 20px;
		letter-spacing: -0.01em;
	}

	.offerTitle {
		font-size: 28px;
		letter-spacing: -0.02em;
	}

	.sectionLead {
		margin: 0 0 12px;
		color: rgba(16, 24, 40, 0.72);
		line-height: 1.55;
	}

	.link {
		color: var(--accent);
		font-weight: 800;
		text-decoration: none;
	}

	.link:hover {
		text-decoration: underline;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.featureGrid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.featureList {
		margin: 0;
		padding-left: 0;
		color: rgba(16, 24, 40, 0.72);
		list-style: none;
		display: grid;
		gap: 8px;
	}

	@media (min-width: 980px) {
		.featureList {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.featureList li {
		margin: 0;
		position: relative;
		padding-left: 22px;
		line-height: 1.4;
	}

	.featureList li::before {
		content: '✓';
		position: absolute;
		left: 0;
		top: 0;
		color: var(--accent);
		font-weight: 900;
	}

	.mutedTile .featureList li::before {
		content: '+';
		color: rgba(16, 24, 40, 0.65);
	}

	.pricingTile {
		padding: 18px;
	}

	.pricingMeta {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 10px;
	}

	.pricingBadge {
		display: inline-flex;
		align-items: center;
