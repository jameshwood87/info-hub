t\t        </div>\r\n\t\t    </div>\r\n    </article>"
    },
    "/docs/propertylist-mls-user-manual/faq-mls/": {
      "body": "<h3 data-sourcepos=\"1:1-1:57\"><a style=\"text-align: var(--text-align); font-family: Nunito; font-size: 16px; letter-spacing: 0.15px;\" href=\"https://propertylist.es\" target=\"_blank\" rel=\"noopener\">Not signed up yet? Get a FREE account and connect with agents throughout Andalucía. Streamline collaboration and close more deals.</a></h3><p data-sourcepos=\"3:1-3:114\"><a href=\"https://propertylist.es/\"></a></p><div>"
