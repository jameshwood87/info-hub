---
type HreflangLink = { hreflang: string; href: string };

type Props = {
	lang?: string;
	title?: string;
	description?: string;
	canonical?: string;
	hreflangs?: HreflangLink[];
};

const {
	lang = 'en',
	title = 'PropertyList Info Hub',
	description,
	canonical,
	hreflangs = [],
} = Astro.props;

const stripInfoHubSuffix = (s: string) => String(s || '').replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '').trim();
const pageTitle = stripInfoHubSuffix(title) || 'PropertyList Info Hub';

const pathname = Astro.url?.pathname ?? '/';
const enPath = pathname.startsWith('/es/') ? pathname.replace(/^\/es\//, '/') : pathname;
const esPath = pathname.startsWith('/es/') ? pathname : `/es${pathname}`;

const searchQ = (Astro.url.searchParams.get('q') || '').trim();
---

<!doctype html>
<html lang={lang === 'en' ? 'en-GB' : lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#00ae9a" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{description ? <meta name="description" content={description} /> : null}
		{canonical ? <link rel="canonical" href={canonical} /> : null}
		<slot name="head" />
		{hreflangs.map((h) => (
			<link rel="alternate" hreflang={h.hreflang} href={h.href} />
		))}
	</head>
	<body>
		<header class="header">
			<nav class="nav" aria-label="Primary">
				<a class="brand" href={lang === 'es' ? '/es/' : '/'}>
					<img
						class="brandLogo"
						src="/logo-black.png"
						alt="PropertyList"
						width="200"
						height="40"
						loading="eager"
						decoding="async"
					/>
					<span class="brandText">Info Hub</span>
				</a>
				<div class="navLinks">
					<a href={lang === 'es' ? '/es/docs/' : '/docs/'}>Docs</a>
					<a href={lang === 'es' ? '/es/leyes/' : '/laws/'}>Laws</a>
					<a href={lang === 'es' ? '/es/informacion-general/' : '/general-information/'}>News</a>
					<a href="/pricing/">Pricing</a>
				</div>
				<form class="navSearch" method="get" action={lang === 'es' ? '/es/search' : '/search'} role="search">
					<input
						class="navSearchInput"
						type="search"
						name="q"
						value={searchQ}
						placeholder={lang === 'es' ? 'Buscar en la documentación' : 'Search documentation'}
						aria-label={lang === 'es' ? 'Buscar' : 'Search'}
						autocomplete="off"
						spellcheck="false"
						data-header-search
						data-search-lang={lang === 'es' ? 'es' : 'en'}
						data-search-prefix={lang === 'es' ? '/es/docs/' : '/docs/'}
						data-search-page={lang === 'es' ? '/es/search' : '/search'}
						role="combobox"
						aria-autocomplete="list"
						aria-expanded="false"
						aria-controls="header-search-listbox"
					/>
					<button class="navSearchBtn" type="submit">
						{lang === 'es' ? 'Buscar' : 'Search'}
					</button>
					<div class="navSearchMenu" data-header-search-menu hidden></div>
				</form>
				<div class="navCtas">
					<a class="lang" href={lang === 'es' ? enPath : esPath} aria-label={lang === 'es' ? 'Switch to English' : 'Cambiar a Español'}>
						{lang === 'es' ? 'EN' : 'ES'}
					</a>
				</div>
			</nav>
		</header>
		<main class="main">
			<slot />
		</main>
		<footer class="footer">
			<div class="footerInner">
				<div class="footerLeft">
					<div class="footerBrand">PropertyList Info Hub</div>
					<div class="footerNote">
						{lang === 'es'
							? 'Guías y documentación para ayudar a agentes, agencias y propietarios.'
							: 'Guides and documentation to help agents, agencies, and property owners.'}
					</div>
				</div>
				<div class="footerLinks" aria-label="Footer">
					<a href={lang === 'es' ? '/es/docs/' : '/docs/'}>Docs</a>
					<a href={lang === 'es' ? '/es/search' : '/search'}>Search</a>
					<a href={lang === 'es' ? '/es/informacion-general/' : '/general-information/'}>News</a>
					<a href="/pricing/">Pricing</a>
				</div>
			</div>
		</footer>
		<script is:inline>
			(() => {
				const input = document.querySelector('input[data-header-search]');
				const menu = document.querySelector('[data-header-search-menu]');
				if (!(input instanceof HTMLInputElement) || !(menu instanceof HTMLElement)) return;

				let activeIndex = -1;
				let currentOptions = [];
				let abort = null;
				let t = null;
				let open = false;
				const listboxId = 'header-search-listbox';
				menu.setAttribute('id', listboxId);
				menu.setAttribute('role', 'listbox');

				const norm = (s) =>
					(s || '')
						.toLowerCase()
						.normalize('NFKD')
						.replace(/[\u0300-\u036f]/g, '')
						.trim();

				const escapeHtml = (s) =>
					String(s || '')
						.replace(/&/g, '&amp;')
						.replace(/</g, '&lt;')
						.replace(/>/g, '&gt;')
						.replace(/"/g, '&quot;')
						.replace(/'/g, '&#039;');

				const stripSuffix = (s) => String(s || '').replace(/\s*(?:•|-)\s*PropertyList Info Hub\s*$/i, '').trim();

				const toSection = (path, lang) => {
					if (lang === 'es') {
						if (path.startsWith('/es/docs/propertylist-mls-manual-de-usuario/')) return 'MLS y CRM';
						if (path.startsWith('/es/docs/portal-publico/')) return 'Portal Público';
						if (path.startsWith('/es/docs/leyes-procedimientos/')) return 'Propietarios';
						return 'Docs';
					}
					if (path.startsWith('/docs/propertylist-mls-user-manual/')) return 'MLS & CRM';
					if (path.startsWith('/docs/public-portal/')) return 'Public Portal';
					if (path.startsWith('/docs/laws-procedures/')) return 'Owners';
					return 'Docs';
				};

				const toMeta = (path, prefix) => {
					const p = String(path || '');
					const base = prefix && p.startsWith(prefix) ? p.slice(prefix.length) : p.replace(/^\/+/, '');
					const parts = base.split('/').filter(Boolean);
					if (!parts.length) return '';
					const tail = parts.slice(0, 3).map((x) => x.replace(/[-_]+/g, ' '));
					return tail.join(' • ');
				};

				const highlight = (text, q) => {
					const t = stripSuffix(text || '');
					const tn = norm(t);
					const qn = norm(q);
					if (!qn) return escapeHtml(t);
					const idx = tn.indexOf(qn);
					if (idx < 0) return escapeHtml(t);
					const before = t.slice(0, idx);
					const hit = t.slice(idx, idx + qn.length);
					const after = t.slice(idx + qn.length);
					return `${escapeHtml(before)}<mark>${escapeHtml(hit)}</mark>${escapeHtml(after)}`;
				};

				const setOpen = (next) => {
					open = next;
					input.setAttribute('aria-expanded', open ? 'true' : 'false');
					menu.hidden = !open;
				};

				const render = (items, q) => {
					const lang = input.dataset.searchLang || 'en';
					const prefix = input.dataset.searchPrefix || '/docs/';
					const groups = new Map();
					for (const r of items.slice(0, 8)) {
						const section = toSection(r.path, lang);
						const list = groups.get(section) || [];
						list.push(r);
						groups.set(section, list);
					}

					const sections = ['MLS & CRM', 'MLS y CRM', 'Owners', 'Propietarios', 'Public Portal', 'Portal Público', 'Laws & Procedures', 'Docs'].filter(
						(s) => groups.has(s)
					);

					const options = [];
					let html = `<div class="navSearchMenuInner" role="presentation">`;

					for (const section of sections) {
						const list = groups.get(section) || [];
						if (!list.length) continue;
						html += `<div class="navSearchSection" role="presentation">`;
						html += `<div class="navSearchSectionTitle" role="presentation">${escapeHtml(section)}</div>`;
						for (const r of list) {
							const id = `hs-opt-${options.length}`;
							const meta = toMeta(r.path, prefix);
							options.push({ id, path: r.path });
							html +=
								`<a class="navSearchItem" id="${id}" role="option" aria-selected="false" data-i="${options.length - 1}" href="${escapeHtml(
									r.path
								)}">` +
								`<div class="navSearchItemTitle">${highlight(r.title, q)}</div>` +
								(meta ? `<div class="navSearchItemMeta">${escapeHtml(meta)}</div>` : '') +
								`</a>`;
						}
						html += `</div>`;
					}

					const qSafe = escapeHtml(q);
					const actionId = `hs-opt-${options.length}`;
					options.push({ id: actionId, path: `${input.dataset.searchPage}?q=${encodeURIComponent(q)}` });
					html +=
						`<a class="navSearchItem navSearchQuery" id="${actionId}" role="option" aria-selected="false" data-i="${options.length - 1}" href="${escapeHtml(
							input.dataset.searchPage
						)}?q=${encodeURIComponent(q)}">` +
						`${lang === 'es' ? 'Buscar' : 'Search'} “${qSafe}”` +
						`</a>`;
					html += `</div>`;

					currentOptions = options;
					activeIndex = -1;
					if (!options.length) {
						menu.innerHTML = '';
						setOpen(false);
						return;
					}
					menu.innerHTML = html;
					setOpen(true);
				};

				const score = (r, qn) => {
					const title = norm(r.title || '');
					const path = norm(r.path || '');
					let s = 0;
					if (title === qn) s += 100;
					if (title.startsWith(qn)) s += 40;
					if (title.includes(qn)) s += 20;
					if (path.includes(qn)) s += 5;
					return s;
				};

				const fetchSuggestions = async (q) => {
					const qn = norm(q);
					if (qn.length < 2) {
						menu.innerHTML = '';
						setOpen(false);
						return;
					}

					if (abort) abort.abort();
					abort = new AbortController();

					const lang = input.dataset.searchLang || 'en';
					const prefix = input.dataset.searchPrefix || '/docs/';
					const url = `/api/search.json?lang=${encodeURIComponent(lang)}&prefix=${encodeURIComponent(prefix)}&limit=20&q=${encodeURIComponent(q)}`;

					const res = await fetch(url, { signal: abort.signal });
					if (!res.ok) return;
					const json = await res.json();
					const raw = Array.isArray(json.results) ? json.results : [];

					const seen = new Set();
					const items = raw
						.filter((r) => r && typeof r.path === 'string' && typeof r.title === 'string')
						.filter((r) => {
							if (seen.has(r.path)) return false;
							seen.add(r.path);
							return true;
						})
						.map((r) => ({ path: r.path, title: r.title }))
						.sort((a, b) => score(b, qn) - score(a, qn));

					render(items, q);
				};

				const close = () => {
					setOpen(false);
					menu.innerHTML = '';
					activeIndex = -1;
					currentOptions = [];
					input.removeAttribute('aria-activedescendant');
				};

				const setActive = (next) => {
					activeIndex = next;
					const els = Array.from(menu.querySelectorAll('.navSearchItem'));
					els.forEach((el) => {
						const i = Number.parseInt(el.getAttribute('data-i') || '-1', 10);
						const isActive = i === activeIndex;
						el.classList.toggle('active', isActive);
						el.setAttribute('aria-selected', isActive ? 'true' : 'false');
					});
					const opt = currentOptions[activeIndex];
					if (opt && opt.id) input.setAttribute('aria-activedescendant', opt.id);
				};

				input.addEventListener('input', () => {
					const q = input.value.trim();
					if (t) window.clearTimeout(t);
					t = window.setTimeout(() => fetchSuggestions(q), 140);
				});

				input.addEventListener('keydown', (e) => {
					if (!open) return;
					const count = currentOptions.length;
					if (!count) return;

					if (e.key === 'Escape') {
						close();
						return;
					}

					if (e.key === 'ArrowDown') {
						e.preventDefault();
						setActive((activeIndex + 1 + count) % count);
						return;
					}

					if (e.key === 'ArrowUp') {
						e.preventDefault();
						setActive((activeIndex - 1 + count) % count);
						return;
					}

					if (e.key === 'Enter' && activeIndex >= 0) {
						e.preventDefault();
						const el = menu.querySelector(`.navSearchItem[data-i="${activeIndex}"]`);
						if (el instanceof HTMLAnchorElement) window.location.href = el.href;
					}
				});

				menu.addEventListener('mousedown', (e) => {
					const a = e.target instanceof Element ? e.target.closest('a') : null;
					if (a) close();
				});

				document.addEventListener('mousedown', (e) => {
					if (e.target instanceof Node && (menu.contains(e.target) || input.contains(e.target))) return;
					close();
				});

				input.addEventListener('focus', () => {
					const q = input.value.trim();
					if (q) fetchSuggestions(q);
				});
			})();
		</script>
	</body>
</html>

<style>
	:global(:root) {
		--accent: #00ae9a;
		--accent-rgb: 0, 174, 154;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #f6f8fc;
		color: #0b1220;
		font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
	}

	.header {
		position: sticky;
		top: 0;
		background: rgba(246, 248, 252, 0.8);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(11, 18, 32, 0.08);
		z-index: 10;
	}

	.nav {
		max-width: 1120px;
		margin: 0 auto;
		padding: 8px max(18px, env(safe-area-inset-right)) 8px max(18px, env(safe-area-inset-left));
		display: flex;
		gap: 16px;
		align-items: center;
		justify-content: space-between;
	}

	.main {
		max-width: 1120px;
		margin: 0 auto;
		padding: 28px max(18px, env(safe-area-inset-right)) 40px max(18px, env(safe-area-inset-left));
		min-height: calc(100vh - 240px);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 700;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.brandLogo {
		height: 70px;
		width: auto;
		display: block;
	}

	.brandText {
		font-weight: 900;
		letter-spacing: -0.02em;
		color: rgba(11, 18, 32, 0.82);
	}

	.navLinks {
		display: flex;
		gap: 14px;
		align-items: center;
		flex-shrink: 0;
		color: rgba(11, 18, 32, 0.76);
		font-weight: 600;
	}

	.navSearch {
		display: flex;
		align-items: center;
		gap: 10px;
		flex: 1;
		max-width: 460px;
		padding: 8px 10px 8px 14px;
		border-radius: 999px;
		border: 1px solid rgba(11, 18, 32, 0.12);
		background: rgba(255, 255, 255, 0.8);
		position: relative;
	}

	.navSearchInput {
		border: 0;
		background: transparent;
		outline: none;
		flex: 1;
		min-width: 0;
		font: inherit;
		color: rgba(11, 18, 32, 0.9);
	}

	.navSearchInput::placeholder {
		color: rgba(11, 18, 32, 0.5);
	}

	.navSearchBtn {
		border: 0;
		background: rgba(16, 24, 40, 0.04);
		color: rgba(11, 18, 32, 0.76);
		font-weight: 800;
		padding: 8px 12px;
		border-radius: 999px;
		cursor: pointer;
	}

	.navSearchBtn:hover {
		background: rgba(16, 24, 40, 0.07);
	}

	.navSearchMenu {
		position: absolute;
		left: 0;
		right: 0;
		top: calc(100% + 10px);
		background: rgba(255, 255, 255, 0.98);
		border: 1px solid rgba(11, 18, 32, 0.12);
		border-radius: 16px;
		box-shadow: 0 12px 40px rgba(11, 18, 32, 0.12);
		padding: 8px;
		z-index: 50;
	}

	.navSearchMenuInner {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.navSearchSectionTitle {
		padding: 6px 10px 2px;
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.02em;
		color: rgba(11, 18, 32, 0.55);
		text-transform: uppercase;
	}

	.navSearchItem {
		display: block;
		padding: 10px 12px;
		border-radius: 12px;
		color: rgba(11, 18, 32, 0.86);
		text-decoration: none;
	}

	.navSearchItemTitle {
		font-weight: 900;
		letter-spacing: -0.01em;
	}

	.navSearchItemMeta {
		margin-top: 4px;
		font-size: 13px;
		color: rgba(11, 18, 32, 0.6);
	}

	.navSearchItem mark {
		background: rgba(var(--accent-rgb), 0.14);
		color: rgba(11, 18, 32, 0.95);
		border-radius: 6px;
		padding: 0 4px;
	}

	.navSearchItem:hover,
	.navSearchItem.active {
		text-decoration: none;
		background: rgba(var(--accent-rgb), 0.1);
		color: rgba(11, 18, 32, 0.92);
	}

	.navSearchQuery {
		margin-top: 6px;
		border-top: 1px solid rgba(11, 18, 32, 0.08);
		color: var(--accent);
	}

	.navCtas {
		display: flex;
		gap: 10px;
		align-items: center;
	}

	.lang {
		padding: 10px 12px;
		border-radius: 999px;
		border: 1px solid rgba(11, 18, 32, 0.12);
		background: rgba(255, 255, 255, 0.8);
		font-weight: 800;
		text-decoration: none;
	}

	.lang:hover {
		text-decoration: none;
		background: rgba(16, 24, 40, 0.04);
	}

	@media (max-width: 820px) {
		.navLinks {
			display: none;
		}

		.navSearch {
			max-width: 520px;
		}
	}

	@media (max-width: 560px) {
		.nav {
			padding: 10px max(14px, env(safe-area-inset-right)) 10px max(14px, env(safe-area-inset-left));
			flex-wrap: wrap;
			gap: 10px;
		}

		.brand {
			flex: 1;
			min-width: 0;
		}

		.navCtas {
			flex-shrink: 0;
		}

		.navSearch {
			order: 3;
			flex-basis: 100%;
			max-width: none;
		}

		.btn,
		.lang {
			min-height: 44px;
		}
	}

	@media (max-width: 420px) {
		.brandLogo {
			height: 56px;
		}

		.brandText {
			display: none;
		}
	}

	:global(.smallLink) {
		color: var(--accent) !important;
	}

	:global(.miniRow:hover) {
		color: var(--accent) !important;
	}

	:global(.row:hover) {
		border-color: rgba(var(--accent-rgb), 0.35) !important;
	}

	:global(.card:hover) {
		border-color: rgba(var(--accent-rgb), 0.35) !important;
	}

	:global(.roleTab.active) {
		border-color: rgba(var(--accent-rgb), 0.35) !important;
	}

	.footer {
		border-top: 1px solid rgba(11, 18, 32, 0.08);
		background: rgba(255, 255, 255, 0.65);
	}

	.footerInner {
		max-width: 1120px;
		margin: 0 auto;
		padding: 22px max(18px, env(safe-area-inset-right)) 22px max(18px, env(safe-area-inset-left));
		display: flex;
		gap: 18px;
		align-items: flex-start;
		justify-content: space-between;
	}

	.footerBrand {
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.footerNote {
		margin-top: 6px;
		color: rgba(11, 18, 32, 0.68);
		max-width: 520px;
		line-height: 1.5;
	}

	.footerLinks {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
		font-weight: 700;
		color: rgba(11, 18, 32, 0.72);
	}

	@media (max-width: 720px) {
		.footerInner {
			flex-direction: column;
		}
	}

	:global(article) {
		max-width: 780px;
		margin: 0 auto;
		background: rgba(255, 255, 255, 0.75);
		border: 1px solid rgba(11, 18, 32, 0.08);
		border-radius: 18px;
		padding: 18px;
	}

	:global(article h1) {
		margin: 0 0 10px;
		letter-spacing: -0.03em;
		line-height: 1.1;
		font-size: 34px;
	}

	:global(article h2) {
		margin: 24px 0 10px;
		letter-spacing: -0.02em;
	}

	:global(article p) {
		color: rgba(11, 18, 32, 0.78);
		line-height: 1.65;
	}

	:global(article a),
	:global(article a:visited) {
		color: var(--accent);
		font-weight: 800;
		text-decoration: none;
	}

	:global(article a:hover) {
		text-decoration: underline;
	}

	:global(article a:focus-visible) {
		outline: 2px solid rgba(var(--accent-rgb), 0.35);
		outline-offset: 2px;
		border-radius: 6px;
	}

	:global(article img) {
		max-width: 100%;
		height: auto;
		border-radius: 14px;
	}

	:global(article.doc) {
		max-width: 1040px;
		margin: 0 auto;
		background: transparent;
		border: none;
		padding: 0;
	}

	:global(.docHeader) {
		background: rgba(255, 255, 255, 0.75);
