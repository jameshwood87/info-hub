ding.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Navegando por el panel de control del MLS</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8b4ccc1 elementor-widget elementor-widget-text-editor\" data-id=\"8b4ccc1\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"chat-history-scroll-container ng-tns-c3858428742-2 show-bottom-shadow ng-trigger ng-trigger-resetChat\"><div class=\"conversation-container ng-tns-c3858428742-2 narrow-container ng-star-inserted\"><div class=\"ng-tns-c2575049534-122\"><div class=\"response-container ng-tns-c978905454-123 response-container-has-multiple-responses\"><div class=\"presented-response-container ng-tns-c978905454-123\"><div class=\"response-container-content ng-tns-c978905454-123\"><div class=\"response-content ng-trigger ng-trigger-responsePopulation ng-tns-c978905454-123\"><div class=\"markdown markdown-main-panel\" dir=\"ltr\"><p data-sourcepos=\"5:1-5:36\">El panel de control del MLS es el centro de tu experiencia con el MLS. Te proporciona una visión general rápida de tu información importante, como próximas citas, actividad reciente e indicadores clave de rendimiento (KPI).</p></div></div></div></div></div></div></div></div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1df5dc5 elementor-widget elementor-widget-heading\" data-id=\"1df5dc5\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Panel de control - Próximamente</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ebabb86 elementor-widget elementor-widget-heading\" data-id=\"ebabb86\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Navegando por la interfaz del MLS</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-917510e elementor-widget__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"917510e\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"chat-history-scroll-container ng-tns-c3858428742-2 show-bottom-shadow ng-trigger ng-trigger-resetChat\"><div class=\"conversation-container ng-tns-c3858428742-2 narrow-container ng-star-inserted\"><div class=\"ng-tns-c2575049534-122\"><div class=\"response-container ng-tns-c978905454-123 response-container-has-multiple-responses\"><div class=\"presented-response-container ng-tns-c978905454-123\"><div class=\"response-container-content ng-tns-c978905454-123\"><div class=\"response-content ng-trigger ng-trigger-responsePopulation ng-tns-c978905454-123\"><div class=\"markdown markdown-main-panel\" dir=\"ltr\"><p data-sourcepos=\"50:1-50:187\">La interfaz del MLS está diseñada para ser fácil de usar y navegar. Aquí hay algunos consejos para navegar por la interfaz del MLS:</p><p data-sourcepos=\"52:1-52:57\"><strong>Aquí hay algunos consejos para navegar por la interfaz del MLS:</strong></p><ul data-sourcepos=\"54:1-58:0\"><li data-sourcepos=\"54:1-54:132\">Presta atención a los colores y las fuentes del sistema. Esto te ayudará a identificar elementos importantes, como enlaces y botones.</li><li data-sourcepos=\"55:1-55:119\">Usa el puntero del ratón para pasar el cursor sobre los elementos y ver las sugerencias de herramientas. Las sugerencias de herramientas proporcionan información adicional sobre los elementos. </li><li data-sourcepos=\"56:1-56:89\">Usa el teclado para navegar entre los elementos. Esto puede ser más rápido que usar el ratón.</li><li data-sourcepos=\"57:1-58:0\">Si estás perdido, utiliza la documentación de ayuda o contacta con el soporte del MLS para obtener asistencia.</li></ul><p><a href=\"https://agents.propertylist.es/\" target=\"_blank\" rel=\"noopener\">¿Listo para empezar? ¡Accede a tu panel de control del MLS y comienza a explorar!</a></p><p><a href=\"http://propertylist.es\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignnone wp-image-10180 size-full\" src=\"https://info.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive.jpg\" alt=\"PropertyList\" width=\"1734\" height=\"671\" srcset=\"https://info.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive.jpg 1734w, https://info.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-300x116.jpg 300w, https://info.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-1024x396.jpg 1024w, https://info.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-768x297.jpg 768w, https://info.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-20x8.jpg 20w, https://info.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-32x12.jpg 32w, https://info.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-1536x594.jpg 1536w, https://info.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-600x232.jpg 600w\" sizes=\"(max-width: 1734px) 100vw, 1734px\" /></a></p></div></div></div></div></div></div></div></div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\r\n\t\t\t</div>\r\n\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\r\n\t</div>\r\n\t    <div class=\"doc-btm\">\r\n                <div class=\"eazydocs-next-prev-wrap\">\r\n\t\t\t                <a class=\"next-prev-pager first\" href=\"https://info.propertylist.es/es/docs/propertylist-mls-manual-de-usuario/mls-manua