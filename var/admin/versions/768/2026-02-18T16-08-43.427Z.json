idget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"chat-history-scroll-container ng-tns-c3858428742-2 show-bottom-shadow ng-trigger ng-trigger-resetChat\"><div class=\"conversation-container ng-tns-c3858428742-2 narrow-container ng-star-inserted\"><div class=\"ng-tns-c2575049534-122\"><div class=\"response-container ng-tns-c978905454-123 response-container-has-multiple-responses\"><div class=\"presented-response-container ng-tns-c978905454-123\"><div class=\"response-container-content ng-tns-c978905454-123\"><div class=\"response-content ng-trigger ng-trigger-responsePopulation ng-tns-c978905454-123\"><div class=\"markdown markdown-main-panel\" dir=\"ltr\"><p data-sourcepos=\"5:1-5:36\">The MLS dashboard is the central hub of your MLS experience. It provides you with a quick overview of your important information, such as upcoming appointments, recent activity, and key performance indicators (KPIs).</p></div></div></div></div></div></div></div></div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1df5dc5 elementor-widget elementor-widget-heading\" data-id=\"1df5dc5\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">DASHBOARD - Coming Soon</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ebabb86 elementor-widget elementor-widget-heading\" data-id=\"ebabb86\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Navigating the MLS Interface</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-917510e elementor-widget__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"917510e\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"chat-history-scroll-container ng-tns-c3858428742-2 show-bottom-shadow ng-trigger ng-trigger-resetChat\"><div class=\"conversation-container ng-tns-c3858428742-2 narrow-container ng-star-inserted\"><div class=\"ng-tns-c2575049534-122\"><div class=\"response-container ng-tns-c978905454-123 response-container-has-multiple-responses\"><div class=\"presented-response-container ng-tns-c978905454-123\"><div class=\"response-container-content ng-tns-c978905454-123\"><div class=\"response-content ng-trigger ng-trigger-responsePopulation ng-tns-c978905454-123\"><div class=\"markdown markdown-main-panel\" dir=\"ltr\"><p data-sourcepos=\"50:1-50:187\">The MLS interface is designed to be user-friendly and easy to navigate.</p><p data-sourcepos=\"52:1-52:57\"><strong>Here are a few tips for navigating the MLS interface:</strong></p><ul data-sourcepos=\"54:1-58:0\"><li data-sourcepos=\"54:1-54:132\">Pay attention to the colours and fonts of the system. This will help you to identify important elements, such as links and buttons.</li><li data-sourcepos=\"55:1-55:119\">Use the mouse pointer to hover over elements to see tooltips. Tooltips provide additional information about elements. </li><li data-sourcepos=\"56:1-56:89\">Use the keyboard to navigate between elements. This can be faster than using the mouse.</li><li data-sourcepos=\"57:1-58:0\">If you are lost, use the help documentation or contact MLS support for assistance.</li></ul><p><a href=\"https://agents.propertylist.es/\" target=\"_blank\" rel=\"noopener\">Ready to dive in? Head to your MLS dashboard and start exploring!</a></p><p><a href=\"http://propertylist.es\"><img fetchpriority=\"high\" decoding=\"async\" class=\"alignnone wp-image-10180 size-full\" src=\"/assets/cbe06db8-cfbc-4875-a3c8-73f7fdc1de7f\" alt=\"PropertyList\" width=\"1734\" height=\"671\" srcset=\"/assets/cbe06db8-cfbc-4875-a3c8-73f7fdc1de7f 1734w, https://info-staging.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-300x116.jpg 300w, https://info-staging.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-1024x396.jpg 1024w, https://info-staging.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-768x297.jpg 768w, https://info-staging.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-20x8.jpg 20w, https://info-staging.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-32x12.jpg 32w, https://info-staging.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-1536x594.jpg 1536w, https://info-staging.propertylist.es/wp-content/uploads/2023/12/Screenshot_20231212_115722_Drive-600x232.jpg 600w\" sizes=\"(max-width: 1734px) 100vw, 1734px\" /></a></p></div></div></div></div></div></div></div></div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\r\n\t\t\t</div>\r\n\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\r\n\t</div>\r\n\t    <div class=\"doc-btm\">\r\n                <div class=\"eazydocs-next-prev-wrap\">\r\n\t\t\t                <a class=\"next-prev-pager first\" href=\"/docs/propertylist-mls-user-manual/your-account/creating-an-account/\">\r\n                    <span> Your Account - Previous </span>\r\n\t\t\t\t\tCreating an account                </a>\r\n\t\t\t                <a class=\"next-prev-pager second\" href=\"/docs/propertylist-mls-user-manual/your-account/mls-user-preferences/\">\r\n                    <span> Next - Your Account </span>\r\n\t\t\t\t\tPropertyList MLS user preferences                </a>\r\n\t\t\t        </div>\r\n\t\t    </div>\r\n    </article>","seo_title":"How do I navigate the MLS dashboard and interface • PropertyList Info Hub","seo_description":null}}