# PropertyList Outreach Scraper - Configuration
# Copy this file to .env and fill in your values

# ===========================================
# MAILCHIMP CONFIG
# ===========================================
MAILCHIMP_API_KEY=your_api_key_here
MAILCHIMP_SERVER_PREFIX=us22
MAILCHIMP_AUDIENCE_ID=df879596b3
MAILCHIMP_SEGMENT_ID=33229

# ===========================================
# PROPERTYLIST DATABASE (for dedup)
# ===========================================
# Path to PropertyList SQLite database
PROPERTYLIST_DB_PATH=/home/pingu/propertylist-db.sqlite

# ===========================================
# DISCORD WEBHOOKS
# ===========================================
# Main outreach channel (new agencies + digest)
DISCORD_OUTREACH_WEBHOOK=https://discord.com/api/webhooks/YOUR/WEBHOOK
# Error/logs channel (optional - can be same)
DISCORD_LOG_WEBHOOK=

# ===========================================
# SCRAPING CONFIG
# ===========================================
# Geographic targets (comma-separated regions)
SCRAPE_REGIONS=Andalusia,Madrid,Valencia,Cataluna,Baleares,Canarias
# Requests between scrapes (ms)
DELAY_MIN_MS=2000
DELAY_MAX_MS=5000
# Max new agencies per run (to avoid spam)
MAX_NEW_PER_RUN=10
# Concurrent browser pages
BROWSER_PAGES=3

# ===========================================
# SERVER CONFIG
# ===========================================
PORT=3210

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info